	               |	ОП.СкидкаВыплаченаяКлиенту,
	               |	ОП.Подразделение.НеОплачиватьКС КАК НеОплачиватьКС,
	               |	ОП.ВидСП,
	               |	ОП.ВознаграждениеМенеджера,
	               |	ОП.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	               |				КОГДА ОП.НачисленнаяСуммаВзноса = 0
	               |					ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	               |				ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	               |			КОНЕЦ - (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	               |			ТОГДА 0
	               |		ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	               |				КОГДА ОП.НачисленнаяСуммаВзноса = 0
	               |					ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	               |				ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	               |			КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	               |	КОНЕЦ * (100-ОП.ПроцентСКВ)/100 КАК СКВ,
	               |	ОП.СтраховойПолис.СК КАК СП_СК,
	               |	ОП.ВидСП КАК СП_ВидСП,
	               |	ОП.СтраховойПолис.СтраховойПродукт КАК СП_СтраховойПродукт,
	               |	ОП.СтраховойПолис.Страхователь КАК Страхователь,
	               |	ОП.СтраховойПолис.Дата КАК ДатаПолиса,
	               |	ОП.СтраховойПолис.Номер КАК НомерПолиса,
	               |	ОП.СтраховойПолис.НомерЗаявки КАК НомерЗаявки,
	               |	ОП.СтраховойПолис.БонусМенеджеру КАК БонусМенеджеру,
	               |	ОП.СтраховойПолис.СтраховаяПремия КАК ПолнаяПремия,
	               |	ОП.СтраховойПолис.Сделка КАК Сделка,
	               |	ОП.СтраховойПолис.Сделка.Дата КАК ДатаСделки,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(ЕСТЬNULL(ОП.СтраховойПолис.Сделка.БонусПроцент, 0)) = ТИП(ЧИСЛО)
	               |				ТОГДА ЕСТЬNULL(ОП.СтраховойПолис.Сделка.БонусПроцент, 0)
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ЧИСЛО) КАК БонусПроцент,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(ЕСТЬNULL(ОП.СтраховойПолис.Сделка.БонусПроцентРОП, 0)) = ТИП(ЧИСЛО)
	               |				ТОГДА ЕСТЬNULL(ОП.СтраховойПолис.Сделка.БонусПроцентРОП, 0)
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ЧИСЛО) КАК БонусПроцентРОП,
	               |	1 КАК ЕД
	               |ПОМЕСТИТЬ Оплаты
	               |ИЗ
	               |	Документ.уб_ОплатаПолисов КАК ОП
	               |ГДЕ
	               |	ОП.Агент = &Агент
	               |	И НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) = &ДатаСреза
	               |	И ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
	               |	И НЕ ОП.СтраховойПолис.Ссылка = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
	               |	И ОП.СтраховойПолис.ПометкаУдаления = ЛОЖЬ
	               |	И ОП.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ ОП.СтраховойПолис.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок
	               |;
