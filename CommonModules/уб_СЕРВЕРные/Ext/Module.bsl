		//
		itfProfile.FileFormat.ActualFormat = СтруктураПараметровИсходящегоФайла.КодФормата;
		ЗаполнитьЗначенияСвойств(itfProfile.FileFormat[СтрЗаменить(СтруктураПараметровИсходящегоФайла.ИмяФормата, ".", "")], СтруктураПараметровИсходящегоФайла);
		//
