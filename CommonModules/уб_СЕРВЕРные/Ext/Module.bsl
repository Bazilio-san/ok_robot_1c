Функция СобратьДанныеДляПродления(Полис) Экспорт
	Данные = Новый Структура;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_СтраховойПолис.Ссылка КАК Ссылка,
	               |	уб_СтраховойПолис.Страхователь КАК Страхователь,
	               |	уб_СтраховойПолис.ОбъектСтрахования КАК ОбъектСтрахования,
	               |	уб_СтраховойПолис.СК.Наименование КАК СК,
	               |	уб_СтраховойПолис.Заявка КАК Заявка,
	               |	ЕСТЬNULL(уб_СтраховойПолис.Заявка.Номер,"""") КАК ЗаявкаНомер,
	               |	уб_СтраховойПолис.Страхователь.Наименование КАК СтраховательНаименование,
	               |	уб_СтраховойПолис.Страхователь.ДатаРождения КАК СтраховательДатаРождения,
	               |	уб_СтраховойПолис.Агент.Наименование КАК Агент,
	               |	уб_СтраховойПолис.Агент КАК АгентСсылка,
	               |	уб_СтраховойПолис.Агент.tg_id КАК Агентtg_id,
	               |	уб_СтраховойПолис.СтраховойПродукт КАК СтраховойПродукт,
	               |	уб_СтраховойПолис.ДатаОкончания КАК ДатаОкончания,
	               |	уб_СтраховойПолис.Номер КАК Номер,
	               |	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия, """") КАК ДокументСерия,
	               |	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер, """") КАК ДокументНомер,
	               |	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи,ДатаВремя(1,1,1)) КАК ДатаВыдачиПаспорта,
	               |	ЕСТЬNULL(уб_ТранспортныеСредства.МаркаТС.Наименование, """") КАК МаркаТС,
	               |	ЕСТЬNULL(уб_ТранспортныеСредства.МодельТС.Наименование, """") КАК МодельТС,
	               |	ЕСТЬNULL(уб_ТранспортныеСредства.ИдентификационныйНомер, """") КАК ИдентификационныйНомер,
	               |	ЕСТЬNULL(уб_ТранспортныеСредства.РегистрационныйЗнак, """") КАК РегистрационныйЗнак,
	               |	ЕСТЬNULL(уб_ТранспортныеСредства.МощностьДвигателя, 0) КАК МощностьДвигателя,
	               |	ЕСТЬNULL(уб_СтраховойПолис.Агент.Преемник,"""") КАК АгентПреемник,
	               |	ЕСТЬNULL(уб_СтраховойПолис.Агент.Преемник.tg_id,"""") КАК АгентПреемникtg_id,
	               |	ЕСТЬNULL(уб_СтраховойПолис.Агент.Преемник.tg_name,"""") КАК АгентПреемникtg_name,
	               |	ЕСТЬNULL(уб_СтраховойПолис.Страхователь.ИНН,"""") КАК СтраховательИНН
	               |ИЗ
	               |	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних КАК ПаспортныеДанныеФизЛицСрезПоследних
	               |		ПО уб_СтраховойПолис.Страхователь = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
	               |		ПО уб_СтраховойПолис.ОбъектСтрахования = уб_ТранспортныеСредства.Объект
	               |ГДЕ
	               |	уб_СтраховойПолис.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Полис);
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные.Вставить("Полис",Полис);
		Данные.Вставить("ЗаявкаСсылка",Выборка.Заявка);
		Данные.Вставить("Заявка",      Выборка.ЗаявкаНомер);
		Данные.Вставить("СК",          Выборка.СК);
		Данные.Вставить("СтраховательСсылка",Выборка.Страхователь);
		Данные.Вставить("ОбъектСтрахования",Выборка.ОбъектСтрахования);
		
		Данные.Вставить("АгентСсылка",Выборка.АгентСсылка);
		ПаспортСтрока = Выборка.ДокументСерия+Выборка.ДокументНомер;
		УидСтрокиСтрахователь = "";
		Если ТипЗнч(Выборка.Страхователь) = Тип("СправочникСсылка.Контрагенты") Тогда
			Данные.Вставить("Страхователь",Новый Структура("ООО,Наименование,ИНН,УидСтрокиСтрахователь",Истина,Выборка.СтраховательНаименование,Выборка.СтраховательИНН,УидСтрокиСтрахователь));
		Иначе	
			Данные.Вставить("Страхователь",Новый Структура("ООО,ФИО,ДР,Паспорт,ДатаВыдачиПаспорта,УидСтрокиСтрахователь",ЛОЖЬ,Выборка.СтраховательНаименование,Выборка.СтраховательДатаРождения,ПаспортСтрока,Выборка.ДатаВыдачиПаспорта,УидСтрокиСтрахователь));
		КонецЕсли;	
		Если ЗначениеЗаполнено(Выборка.АгентПреемник) Тогда
			Данные.Вставить("Менеджер",?(ПустаяСтрока(Выборка.АгентПреемникtg_name),Строка(Выборка.Агент) ,Выборка.АгентПреемникtg_name ));
			Данные.Вставить("userid",  Выборка.АгентПреемникtg_id);
		Иначе	
			Данные.Вставить("Менеджер",Строка(Выборка.Агент));
			Данные.Вставить("userid",  Выборка.Агентtg_id);
		КонецЕсли;	
		
		ПолныйНомер = СтрЗаменить(СокрЛП(Выборка.Номер),"-","");
		ПолныйНомер = СтрЗаменить(ПолныйНомер,"'","");
		ЭтоСерия = Истина;
		Серия = "";
		Номер = ""; 
		Для Счетчик = 1 по СтрДлина(ПолныйНомер) Цикл
			ТекСимвол = Сред(ПолныйНомер,Счетчик,1);
			
			ЭтоСерия = ЭтоСерия = Истина и Найти("0123456789",ТекСимвол)=0;
			
			Если ЭтоСерия Тогда
				Серия = Серия+ТекСимвол;
			Иначе
				Номер = Номер+ТекСимвол;
			КонецЕсли;
		КонецЦикла;
		
		Данные.Вставить("Вид",           Строка(Выборка.СтраховойПродукт));
		Данные.Вставить("ДатаОкончания", Выборка.ДатаОкончания);
		Данные.Вставить("Серия",         Серия);
		Данные.Вставить("Номер",         Номер);
		Данные.Вставить("МаркаТС",       Выборка.МаркаТС);
		Данные.Вставить("МодельТС",      Выборка.МодельТС);
		Данные.Вставить("VIN",           Выборка.ИдентификационныйНомер);
		Данные.Вставить("ГосНомер",      Выборка.РегистрационныйЗнак);
		Данные.Вставить("Мощность",      Выборка.МощностьДвигателя);
		
	КонецЕсли;	
	
	ПроверитьДаннныеДляПродления(Данные);
	
	Возврат Данные
КонецФункции	

//2
Функция ПроверитьДаннныеДляПродления(Данные) Экспорт
	
	Данные.Вставить("ВозможенРасчет",Истина);
	Если Данные.Страхователь.ООО = ЛОЖЬ Тогда
		Если ЗначениеЗаполнено(Данные.Страхователь.ДР) = ЛОЖЬ Тогда
			Данные.Вставить("ВозможенРасчет",ЛОЖЬ);
			Данные.Вставить("ОшибкаВДР",Истина);
		КонецЕсли;	
		
		//Если ЗначениеЗаполнено(Данные.Страхователь.Паспорт) = ЛОЖЬ Тогда
		//	Данные.Вставить("ОшибкаВПаспорте",Истина);
		//КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.VIN) = ЛОЖЬ Тогда
		Данные.Вставить("ОшибкаVIN",Истина);
		Данные.Вставить("ВозможенРасчет",ЛОЖЬ);
	КонецЕсли;	
	
	Возврат ЛОЖЬ
КонецФункции	

//3
Функция ОтправитьРасчет(Данные) Экспорт 
	Полис = Данные.Полис;
	Данные.Удалить("Полис");
	Данные.Удалить("ЗаявкаСсылка");
	Данные.Удалить("СтраховательСсылка");
	Данные.Удалить("ОбъектСтрахования");
	Данные.Удалить("АгентСсылка");	
	
	Строка = уб_ВызовСервера.JSON(Данные);
	
	
	//https://osago.app/rest/1cprolongation
	ssl = Новый ЗащищенноеСоединениеOpenSSL;
	Соединение = Новый httpСоединение("osago.app",,,,,,ssl);
	httpЗапрос = новый httpЗапрос("/rest/1cprolongation");
	httpЗапрос.УстановитьТелоИзСтроки(Строка,КодировкаТекста.UTF8);
	httpЗапрос.Заголовки.Вставить("Content-Type","application/json; charset=UTF-8");
	
	Ответ = Соединение.ОтправитьДляОбработки(httpЗапрос);
	ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку();
	ДанныеОтвет = уб_ВызовСервера.JSONВСтруктуру(ОтветСтрокой);
	Статус = ДанныеОтвет.Получить("status");
	
	Если НЕ Статус = Неопределено  Тогда
		Если Статус = "error" или Ответ.КодСостояния <>200 Тогда
			Сообщить(ОтветСтрокой);
			url = ОтветСтрокой;
		Иначе	
			url = ДанныеОтвет.Получить("link");
			Сообщить(url);
		КонецЕсли;
		МЗ = РегистрыСведений.уб_ПредоставленныеДокументыСП.СоздатьМенеджерЗаписи();
		МЗ.Объект           = Полис;
		МЗ.ВидДокумента     = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(16);
		МЗ.ТипПодразделения = Перечисления.уб_ТипыПодразделений.ОУБСО;
		МЗ.Комментарий      = url;
		МЗ.Предоставлен     = Не Статус = "error";
		МЗ.Записать();
	КонецЕсли;
КонецФункции	

