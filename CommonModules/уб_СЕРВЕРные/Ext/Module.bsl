Функция ПроверкаПутиAdobeReader()
	
	ПутьAdobeReader = "";
	
	Если ПроверитьФайлНаСервере("C:\Program Files (x86)\Adobe\Acrobat Reader DC\Reader\AcroRd32.exe") Тогда 
		ПутьAdobeReader = "C:\Program Files (x86)\Adobe\Acrobat Reader DC\Reader\AcroRd32.exe";
	ИначеЕсли ПроверитьФайлНаСервере("C:\Program Files (x86)\Adobe\Reader 11.0\Reader") Тогда 
		ПутьAdobeReader = "C:\Program Files (x86)\Adobe\Reader 11.0\Reader\AcroRd32.exe";
	ИначеЕсли ПроверитьФайлНаСервере("C:\Program Files\Adobe\Reader 11.0\Reader") Тогда
		ПутьAdobeReader = "C:\Program Files\Adobe\Reader 11.0\Reader\AcroRd32.exe";
	ИначеЕсли ПроверитьФайлНаСервере("C:\Program Files (x86)\Adobe\Reader 10.0\Reader") Тогда
		ПутьAdobeReader = "C:\Program Files (x86)\Adobe\Reader 10.0\Reader\AcroRd32.exe";
	Иначе
		Если РольДоступна("уб_ЗП_ПолныйДоступ") Тогда
			Сообщить("Adobe Reader не найден");
		КонецЕсли;	
		ПутьAdobeReader = "C:\Program Files (x86)\Adobe\Reader 9.0\Reader\AcroRd32.exe";
	КонецЕсли;
	
	Возврат ПутьAdobeReader;
	
