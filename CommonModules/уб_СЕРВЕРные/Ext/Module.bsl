	               |	ОПЛАТЫ.Страхователь,
	               |	СУММА(ОПЛАТЫ.КВСумма) КАК КВСумма,
	               |	СУММА(ОПЛАТЫ.СКВ) КАК СКВ
	               |ПОМЕСТИТЬ АВТО_КС
	               |ИЗ
	               |	Оплаты КАК ОПЛАТЫ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОПЛАТЫ.Страхователь
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ОПЛАТЫ.КВСумма) > 41900
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(ВЫБОР
	               |			КОГДА АВТО_КС.СКВ ЕСТЬ NULL 
	               |				ТОГДА ОП.СКВ
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СКВ,
	               |	СУММА(ОП.СКВ) КАК СКВ_ПроверкаПлан,
	               |	СУММА(ВЫБОР
	               |			КОГДА АВТО_КС.СКВ ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			ИНАЧЕ ОП.СКВ
	               |		КОНЕЦ) КАК СКВ_КС,
	               |	СУММА(ВЫБОР
	               |			КОГДА ОП.НомерВзноса = 1
	               |					И (ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.НС)
	               |						ИЛИ ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Имущество))
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоФакт,
	               |	ОП.Агент,
	               |	СУММА(ОП.ВознаграждениеМенеджера) КАК ВознаграждениеМенеджера
	               |ПОМЕСТИТЬ Факт
	               |ИЗ
	               |	Оплаты КАК ОП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ АВТО_КС КАК АВТО_КС
	               |		ПО ОП.Страхователь = АВТО_КС.Страхователь
	               |			И (&ИспользуютсяКС = ИСТИНА)
	               |			И (ОП.НеОплачиватьКС = ЛОЖЬ)
	               |ГДЕ
	               |	ОП.ЭтоКрупнаяСделка = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОП.Агент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Планы.Агент КАК Агент,
	               |	Планы.ПроцентнаяСтавкаДоПлана КАК ПроцентДо,
	               |	Планы.ПроцентнаяСтавкаПослеПлана КАК ПроцентВыполнения,
	               |	ВЫБОР
	               |		КОГДА &Используется2БонусПланки = ИСТИНА
	               |			ТОГДА Планы.ПроцентнаяСтавкаОтПервойБонусПланки
	               |		ИНАЧЕ Планы.ПроцентнаяСтавкаПослеПлана
	               |	КОНЕЦ КАК ПроцентБП1,
	               |	Планы.ПроцентнаяСтавкаПослеСуперПлана КАК ПроцентБП2,
	               |	Планы.ФактПлан КАК План,
	               |	Планы.КоличествоПлан КАК КоличествоПлан,
	               |	Планы.БП1 КАК БП1,
	               |	Планы.БП2 КАК БП2,
	               |	Планы.Подразделение,
	               |	Планы.Схема,
	               |	ВЫБОР
	               |		КОГДА Планы.Схема = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПоСхемеСКВ
	               |ПОМЕСТИТЬ ПоказателиПлана
	               |ИЗ
	               |	Планы КАК Планы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ Планы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФАКТ.Агент,
	               |	ФАКТ.СКВ,
	               |	ФАКТ.ВознаграждениеМенеджера,
	               |	ФАКТ.СКВ_КС,
	               |	ПоказателиПлана.ПроцентДо,
	               |	ПоказателиПлана.ПроцентВыполнения,
	               |	ПоказателиПлана.ПроцентБП1,
	               |	ПоказателиПлана.ПроцентБП2,
	               |	ПоказателиПлана.План,
	               |	ПоказателиПлана.БП1,
	               |	ПоказателиПлана.БП2,
	               |	ВЫБОР
	               |		КОГДА ФАКТ.СКВ_ПроверкаПлан >= ПоказателиПлана.План
	               |				И (НЕ &ИспользуетсяКоличественныйПлан = ИСТИНА
	               |					ИЛИ ПоказателиПлана.КоличествоПлан = 0
	               |					ИЛИ ФАКТ.КоличествоФакт >= ПоказателиПлана.КоличествоПлан)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ВыполненПлан,
	               |	ВЫБОР
	               |		КОГДА &ИспользуетсяКоличественныйПлан = ИСТИНА
	               |				И НЕ ПоказателиПлана.КоличествоПлан = 0
	               |				И ФАКТ.КоличествоФакт >= ПоказателиПлана.КоличествоПлан
	               |			ТОГДА 5
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ДобавкаКПлану,
	               |	ВЫБОР
	               |		КОГДА ФАКТ.СКВ >= ПоказателиПлана.БП1
	               |				И (НЕ &ИспользуетсяКоличественныйПлан = ИСТИНА
	               |					ИЛИ ПоказателиПлана.КоличествоПлан = 0
	               |					ИЛИ ФАКТ.КоличествоФакт >= ПоказателиПлана.КоличествоПлан)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ВыполненаБП1,
	               |	ВЫБОР
	               |		КОГДА ФАКТ.СКВ >= ПоказателиПлана.БП2
	               |				И (НЕ &ИспользуетсяКоличественныйПлан = ИСТИНА
	               |					ИЛИ ПоказателиПлана.КоличествоПлан = 0
	               |					ИЛИ ФАКТ.КоличествоФакт >= ПоказателиПлана.КоличествоПлан)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ВыполненаБП2,
	               |	ПоказателиПлана.Подразделение,
	               |	ПоказателиПлана.ПоСхемеСКВ
	               |ПОМЕСТИТЬ Предварительная
	               |ИЗ
	               |	Факт КАК ФАКТ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоказателиПлана КАК ПоказателиПлана
	               |		ПО ФАКТ.Агент = ПоказателиПлана.Агент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ФАКТ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Предварительная.Агент,
	               |	Предварительная.СКВ,
	               |	Предварительная.СКВ_КС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА Предварительная.ПоСхемеСКВ
	               |					И Предварительная.ВыполненПлан = ИСТИНА
	               |				ТОГДА Предварительная.СКВ_КС * (Предварительная.ПроцентВыполнения + 5) / 100
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Бонус_КС,
	               |	Предварительная.ВознаграждениеМенеджера,
	               |	Предварительная.ПроцентДо + ВЫБОР
	               |		КОГДА Предварительная.ВыполненПлан = ЛОЖЬ
	               |			ТОГДА Предварительная.ДобавкаКПлану
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПроцентДо,
	               |	Предварительная.ПроцентВыполнения,
	               |	Предварительная.ПроцентБП1,
	               |	Предварительная.ПроцентБП2,
	               |	Предварительная.План,
	               |	Предварительная.БП1,
	               |	Предварительная.БП2,
	               |	Предварительная.ВыполненПлан,
	               |	Предварительная.ВыполненаБП1,
	               |	Предварительная.ВыполненаБП2,
	               |	ВЫБОР
	               |		КОГДА Предварительная.ВыполненПлан = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА Предварительная.ВыполненаБП1 = ИСТИНА
	               |						ТОГДА Предварительная.БП1
	               |					ИНАЧЕ Предварительная.СКВ
	               |				КОНЕЦ
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ДОБП1,
	               |	ВЫБОР
	               |		КОГДА Предварительная.ВыполненаБП1
	               |			ТОГДА ВЫБОР
	               |					КОГДА Предварительная.ВыполненаБП2
	               |						ТОГДА Предварительная.БП2 - Предварительная.БП1
	               |					ИНАЧЕ Предварительная.СКВ - Предварительная.БП1
	               |				КОНЕЦ
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ДОБП2,
	               |	ВЫБОР
	               |		КОГДА Предварительная.ВыполненаБП2
	               |			ТОГДА Предварительная.СКВ - Предварительная.БП2
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СвышеБП2,
	               |	Предварительная.Подразделение,
	               |	Предварительная.ПоСхемеСКВ
	               |ПОМЕСТИТЬ ОценкаСумм
	               |ИЗ
	               |	Предварительная КАК Предварительная
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ Предварительная
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Оплаты.Ссылка,
	               |	Оплаты.Агент
	               |ИЗ
	               |	Оплаты КАК Оплаты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АВТО_КС КАК АВТО_КС
	               |		ПО Оплаты.Страхователь = АВТО_КС.Страхователь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ОПЛАТЫ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОценкаСумм.Агент КАК Агент,
	               |	ОценкаСумм.СКВ + ВЫБОР
	               |		КОГДА ОценкаСумм.ВыполненПлан = ЛОЖЬ
	               |			ТОГДА ОценкаСумм.СКВ_КС
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СКВ,
	               |	ОценкаСумм.СКВ_КС,
	               |	ОценкаСумм.ВознаграждениеМенеджера,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ОценкаСумм.ПоСхемеСКВ
	               |				ТОГДА ВЫБОР
	               |						КОГДА ОценкаСумм.ВыполненПлан = ЛОЖЬ
	               |							ТОГДА (ОценкаСумм.СКВ + ОценкаСумм.СКВ_КС) * ОценкаСумм.ПроцентДо / 100
	               |						ИНАЧЕ ОценкаСумм.ДОБП1 * ОценкаСумм.ПроцентВыполнения / 100 + ОценкаСумм.ДОБП2 * ОценкаСумм.ПроцентБП1 / 100 + ОценкаСумм.СвышеБП2 * ОценкаСумм.ПроцентБП2 / 100
	               |					КОНЕЦ
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ЧИСЛО(17, 2)) КАК ЗП_СКВ,
	               |	ОценкаСумм.Бонус_КС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ОценкаСумм.ВыполненПлан = ЛОЖЬ
	               |				ТОГДА (ОценкаСумм.СКВ + ОценкаСумм.СКВ_КС) * ОценкаСумм.ПроцентДо / 100
	               |			ИНАЧЕ ОценкаСумм.ДОБП1 * ОценкаСумм.ПроцентВыполнения / 100
	               |		КОНЕЦ КАК ЧИСЛО(17, 2)) КАК БазоваяЗП,
	               |	ВЫРАЗИТЬ(ОценкаСумм.ДОБП2 * ОценкаСумм.ПроцентБП1 / 100 КАК ЧИСЛО(17, 2)) КАК ЗПБонус1,
	               |	ВЫРАЗИТЬ(ОценкаСумм.СвышеБП2 * ОценкаСумм.ПроцентБП2 / 100 КАК ЧИСЛО(17, 2)) КАК ЗПБонус2,
	               |	ОценкаСумм.ПроцентДо,
	               |	ОценкаСумм.ПроцентВыполнения,
	               |	ОценкаСумм.ПроцентБП1,
	               |	ОценкаСумм.ПроцентБП2,
	               |	ОценкаСумм.План,
	               |	ОценкаСумм.БП1,
	               |	ОценкаСумм.БП2,
	               |	ОценкаСумм.ВыполненПлан,
	               |	ОценкаСумм.ВыполненаБП1,
	               |	ОценкаСумм.ВыполненаБП2,
	               |	ОценкаСумм.ДОБП1,
	               |	ОценкаСумм.ДОБП2,
	               |	ОценкаСумм.СвышеБП2,
	               |	ОценкаСумм.Подразделение КАК Подразделение
	               |ИЗ
	               |	ОценкаСумм КАК ОценкаСумм
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОценкаСумм.Подразделение.Наименование,
	               |	ОценкаСумм.Агент.Наименование";
	Если Менеджер=Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ОП.Агент = &Агент"+Символы.ПС+Символы.Таб+"И ","");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ГДЕ"+Символы.ПС+Символы.Таб+"Сотрудники.Агент = &Агент","");
	КонецЕсли;
	ЗапросБыстрыйРасчетЗП.Текст = ТекстЗапроса;
	ЗапросБыстрыйРасчетЗП.УстановитьПараметр("Агент",Менеджер);
	ЗапросБыстрыйРасчетЗП.УстановитьПараметр("ДатаСреза",НачалоМесяца(Период));
	ЗапросБыстрыйРасчетЗП.УстановитьПараметр("ИспользуетсяКоличественныйПлан", Период>=Дата(2013, 8,1));//По НС и имуществу
	ЗапросБыстрыйРасчетЗП.УстановитьПараметр("Используется2БонусПланки",       Период>=Дата(2012,12,1));
	ЗапросБыстрыйРасчетЗП.УстановитьПараметр("ИспользуютсяКС",                 Период>=Дата(2012,10,1));//Крупные сделки
	
	Пакеты = ЗапросБыстрыйРасчетЗП.ВыполнитьПакет();
	ВсегоПакетов = Пакеты.Количество();
	КСПоМенеджерам = Пакеты[ВсегоПакетов-3].Выгрузить();
	ПоМенеджерам   = Пакеты[ВсегоПакетов-1].Выгрузить();
	
	ПоМенеджерам.Колонки.Добавить("СписокКС");
	Для каждого Строка Из ПоМенеджерам Цикл
		Строка.СписокКС = Новый Массив;
		Для Каждого Оплата Из КСПоМенеджерам.НайтиСтроки(Новый Структура ("Агент",Строка.Агент)) Цикл
			Строка.СписокКС.Добавить(Оплата.Ссылка);
		КонецЦикла;
	КонецЦикла;
	Возврат ПоМенеджерам;
КонецФункции	

