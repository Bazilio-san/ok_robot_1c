Функция ПроверитьФайлНаСервере(ИмяФайла, СтруктураФайла = Неопределено) Экспорт
	
	Файл = Новый Файл(ИмяФайла);
	СтруктураФайла = Новый Структура("Расширение, Размер", Неопределено, Неопределено);
	Если Файл.Существует() Тогда
		СтруктураФайла.Расширение = Файл.Расширение;
		Если Файл.Расширение <> "" Тогда//не папка
			СтруктураФайла.Размер = Файл.Размер();
		КонецЕсли;
		Файл = Неопределено;
		Возврат Истина;
	Иначе
		Файл = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
