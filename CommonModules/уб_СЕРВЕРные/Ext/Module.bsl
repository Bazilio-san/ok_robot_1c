Процедура ОтправитьСтатус (Заявка,Статус) Экспорт
	
	Если ТипЗнч(Заявка.НомерЗаявки) =  Тип ("Число") Тогда
		Сообщение = Новый Структура;
		Сообщение.Вставить("Заявка",Формат(Заявка.Номер,"ЧГ="));
		Сообщение.Вставить("НомерАМО",Формат(Заявка.НомерЗаявки,"ЧГ="));
		Префикс = Префикс();
		
		Сообщение.Вставить("ref",Префикс+ПолучитьНавигационнуюСсылку(Заявка));
		Сообщение.Вставить("Менеджер",Строка(Заявка.Менеджер));
		Сообщение.Вставить("userid",Строка(Заявка.Менеджер.tg_id));
		Сообщение.Вставить("Статус",Статус);
		
		
		СообщениеСтрокой = уб_СЕРВЕРные.JSON(Сообщение);
		
		//https://kupipolis.ru/amo/main/from_1c.php?change_lead=1
		ssl = Новый ЗащищенноеСоединениеOpenSSL;
		Соединение = Новый httpСоединение("kupipolis.ru",,,,,,ssl);
		httpЗапрос = новый httpЗапрос("amo/main/from_1c.php?change_lead=1");
		httpЗапрос.УстановитьТелоИзСтроки(СообщениеСтрокой,КодировкаТекста.UTF8);
		
		Попытка
			Ответ = Соединение.ОтправитьДляОбработки(httpЗапрос);
			Если РольДоступна("уб_ЗП_ПолныйДоступ") Тогда
				Сообщить(Ответ.ПолучитьТелоКакСтроку());
			КонецЕсли;	
		Исключение
			Сообщить("При отправке статуса в АМО: "+ОписаниеОшибки());
		КонецПопытки;	
	КонецЕсли;
КонецПроцедуры				

