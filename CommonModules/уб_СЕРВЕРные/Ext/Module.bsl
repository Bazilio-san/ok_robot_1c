
Процедура Пауза(ИнтервалОжидания) Экспорт
	
	ИмяФайла = "sleep.js";
	Если Не ФайлСуществует(КаталогВременныхФайлов(), ИмяФайла) Тогда
		Если ПравоДоступа("Вывод", Метаданные) Тогда
			Скрипт = Новый ТекстовыйДокумент();
			Скрипт.УстановитьТекст
			(
			"if (WScript.Arguments.Count()==0)
			|    WScript.Quit();
			|else
			|    if (isNaN(parseInt(WScript.Arguments(0))))
			|        WScript.Quit();
			|WScript.Sleep(WScript.Arguments(0));"
			);
			Путь = КаталогВременныхФайлов() + ИмяФайла;
			Скрипт.Записать(Путь, КодировкаТекста.ANSI);
		Иначе
			КаталогВнешнихКомпонент = ПараметрыСеанса.уб_Константы.КаталогВнешнихКомпонент;
			Если ТипЗнч(КаталогВнешнихКомпонент) = Тип("Строка") Тогда
				КаталогВнешнихКомпонент = СокрЛП(КаталогВнешнихКомпонент);
				Если Прав(КаталогВнешнихКомпонент, 1) <> "\" Тогда
					КаталогВнешнихКомпонент = КаталогВнешнихКомпонент + "\"
				КонецЕсли;
				Если ФайлСуществует(КаталогВнешнихКомпонент, ИмяФайла) Тогда
					Путь = КаталогВнешнихКомпонент + ИмяФайла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Путь = КаталогВременныхФайлов() + ИмяФайла;
	КонецЕсли;
	Если Путь <> Неопределено Тогда
		WshShell = Новый COMОбъект("WScript.Shell");
		WshShell.Run("WScript.exe """ + Путь + """ " + Формат(ИнтервалОжидания, "ЧГ=0"), 0, -1);
	КонецЕсли;
	
КонецПроцедуры // Пауза

///////////// КОНВЕРТАЦИЯ ФАЙЛОВ ////////////////

Процедура ВызовКонвертацииСервер(Параметры) Экспорт

	Отказ = Ложь;
	//Проверка корректности параметров
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = уб_СЛ.СтруктураПараметровКонвертацииФайловПоУмолчанию();
		ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Некорректный тип структуры параметров", Истина);
		Перейти ~НаВыход;
	КонецЕсли;	
	//Заполнение таблицы конвертации при необходимости
	ТаблицаФайловКоличество = Параметры.ТаблицаФайлов.Количество();
	Если ТаблицаФайловКоличество = 0 Тогда
		Если Не Параметры.СоздаватьТаблицуФайловПоЗаявке Или Параметры.СсылкаНаОбъект.Пустая() Тогда
			//не является ошибкой конвертации. Если нет строк, то и конвертация не требуется
			ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Пустая таблица файлов");
		Иначе
			ПолучитьТаблицуКонвертацииФайлов(Параметры);
			ТаблицаФайловКоличество = Параметры.ТаблицаФайлов.Количество();
		КонецЕсли;
	ИначеЕсли Параметры.ПроверкаИменФайловНаУИД Тогда
		// краткое имя входящего файла может
		// 1: отсутствовать. Тогда полное имя входящего файла должно быть заполнено корректно
		// 2: быть именем файла. Тогда отработает стандартным образом (полное имя входящего файла также должно быть заполнено корректно)
		// 3: быть УИД'ом регистра файлов к полису. Строка таблицы файлов приводится в нужный вид 
		//	(заполнение полного имени входящего файла требуется в случае, когда краткое имя - не УИД регистра
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("ИмяВходящегоФайла", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
		Для Каждого СтрокаТЗТаблицыФайлов Из Параметры.ТаблицаФайлов Цикл
			Если СтрЧислоВхождений(СтрокаТЗТаблицыФайлов.ИмяВходящегоФайла,"-")=4 Тогда //Не ПустаяСтрока(СтрокаТЗТаблицыФайлов.ИмяВходящегоФайла) Тогда
				СтрокаТЗ = ТЗ.Добавить();
				СтрокаТЗ.ИмяВходящегоФайла = СтрокаТЗТаблицыФайлов.ИмяВходящегоФайла;
			КонецЕсли;
		КонецЦикла;
		Если ТЗ.Количество() > 0 Тогда
			// требуется обработать ТЗ по регистру файлов к полисам
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Источник.ИмяВходящегоФайла КАК ИмяВходящегоФайла
			|ПОМЕСТИТЬ ВТ_Источник
			|ИЗ
			|	&Источник КАК Источник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Ф.УИД КАК УИД,
			|	Ф.Хранилище.Путь КАК ХранилищеПуть,
			|	Ф.ФайлИмя КАК ФайлИмя,
			|	Ф.ПутьКПапке КАК ПутьКПапке
			|ИЗ
			|	ВТ_Источник КАК ВТ_Источник
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК Ф
			|		ПО ВТ_Источник.ИмяВходящегоФайла = Ф.УИД");
			Запрос.УстановитьПараметр("Источник", ТЗ);
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					СтрокаТЗ = Параметры.ТаблицаФайлов.Найти(Выборка.УИД, "ИмяВходящегоФайла");
					Если СтрокаТЗ <> Неопределено Тогда
						СтрокаТЗ.ИмяВходящегоФайла 			= Выборка.ФайлИмя;
						СтрокаТЗ.ПолноеИмяВходящегоФайла 	= уб_СЛ.ПроверитьИмяКаталога(Выборка.ХранилищеПуть) + ?(ПустаяСтрока(Выборка.ПутьКПапке), "", уб_СЛ.ПроверитьИмяКаталога(Выборка.ПутьКПапке)) + Выборка.ФайлИмя;
						СтрокаТЗ.УИД						= Выборка.УИД; // вдруг потом пригодится еще
						Параметры.ЕстьНайденныеФайлы        = ИСТИНА;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	//При отсутствии предварительных ошибок
	Если Параметры.ТЗОшибок.Количество() = 0 И ТаблицаФайловКоличество > 0 Тогда
		//md5 = Обработки.уб_MD5.Создать();
		КаталогВременныхФайлов 	= КаталогВременныхФайлов();
		ТаблицаФайлов 			= Параметры.ТаблицаФайлов;
		Если ПустаяСтрока(Параметры.ПутьККаталогуИсходящихФайлов) Тогда
			Параметры.ПутьККаталогуИсходящихФайлов = КаталогВременныхФайлов;
		Иначе
			СоздатьКаталог(Параметры.ПутьККаталогуИсходящихФайлов);
		КонецЕсли;
		//Проверка кэшированных файлов
		Если Параметры.ПроверятьКэшНаНаличиеФайлов Тогда
			Отказ = Истина;
			Для Каждого СтрокаТЗ Из ТаблицаФайлов Цикл
				
				ЭтоРабочаяБаза = ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина;
				СтрокаТЗ.ТребуетсяКонвертация = ТребуетсяКонвертацияФайла(СтрокаТЗ.ПолноеИмяВходящегоФайла, Неопределено);
				мТребуетсяКонвертация = СтрокаТЗ.ТребуетсяКонвертация;
				Если НЕ ЭтоРабочаяБаза и мТребуетсяКонвертация = Истина тогда
					//отладочная инфа
					Сообщить("Отладочная информация:");
					Сообщить("Имя входящего файла: "+СтрокаТЗ.ПолноеИмяВходящегоФайла);
				КонецЕсли;
				//создаем хэш файла для уникальности
				мПолноеИмяВходящегоФайла = СтрокаТЗ.ПолноеИмяВходящегоФайла;
				GUID = ОбщегоНазначения.MD5Хэш(мПолноеИмяВходящегоФайла);//md5.РасчетХЭШ(мПолноеИмяВходящегоФайла);
				Маска = "tmp" + GUID + "*" + Параметры.РасширениеКартинки;
				МассивФайлов = НайтиФайлы(Параметры.ПутьККаталогуИсходящихФайлов, Маска);
				ФайлИмя = "tmp" + GUID + "(1)" + Параметры.РасширениеКартинки;
				Если ФайлСуществует(Параметры.ПутьККаталогуИсходящихФайлов, ФайлИмя) Тогда
					СтрокаТЗ.ПропуститьКонвертацию 		= Истина;
					СтрокаТЗ.Выполнено					= Истина;
					СтрокаТЗ.ИмяИсходящегоФайла			= ФайлИмя;
					СтрокаТЗ.ВходящийФайлНайден         = ИСТИНА;
					Параметры.ЕстьНайденныеФайлы        = ИСТИНА;
					//добавим в массив конвертации
					Для Каждого СтрФайл Из МассивФайлов Цикл 
						СтрокаТЗ.МассивКонвертации.Добавить(СтрФайл.ПолноеИмя);
					КонецЦикла;
				ИначеЕсли мТребуетсяКонвертация Тогда 
					Отказ = Ложь;
				Иначе //конвертация не требуется на всякий случай приравниваем исходящий и входящий файлы
					СтрокаТЗ.ПропуститьКонвертацию 		= Истина;
					СтрокаТЗ.Выполнено					= Истина;
					СтрокаТЗ.ИмяИсходящегоФайла			= СтрокаТЗ.ИмяВходящегоФайла;
					СтрокаТЗ.ПолноеИмяИсходящегоФайла   = СтрокаТЗ.ПолноеИмяВходящегоФайла;
					СтрокаТЗ.ВходящийФайлНайден         = ИСТИНА;
					Параметры.ЕстьНайденныеФайлы        = ИСТИНА;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Отказ Тогда
			//не выполняем никакой код, не требуется удаление очереди (результат конвертации неизвестен)
			Возврат
		КонецЕсли;
		//Последовательная проверка наличия файлов их имен
		Для Каждого СтрокаТЗ Из ТаблицаФайлов Цикл
			//Файл = Новый Файл(СтрокаТЗ.ПолноеИмяВходящегоФайла);
			Если ФайлСуществует(СтрЗаменить(СтрокаТЗ.ПолноеИмяВходящегоФайла, СтрокаТЗ.ИмяВходящегоФайла, ""), СтрокаТЗ.ИмяВходящегоФайла) Тогда
				Файл = Неопределено;
				СтрокаТЗ.ВходящийФайлНайден 	= Истина;
				Параметры.ЕстьНайденныеФайлы 	= Истина;
				ТипФайла = Неопределено;
				Если ТребуетсяКонвертацияФайла(СтрокаТЗ.ПолноеИмяВходящегоФайла, ТипФайла) Тогда
					//создаем хэш файла для уникальности
					мПолноеИмяВходящегоФайла = СтрокаТЗ.ПолноеИмяВходящегоФайла;
					GUID = ОбщегоНазначения.MD5Хэш(мПолноеИмяВходящегоФайла);//md5.РасчетХЭШ(мПолноеИмяВходящегоФайла);
					СтрокаТЗ.ТребуетсяКонвертация       = ИСТИНА;
					СтрокаТЗ.ПриложениеВходящегоФайла 	= ТипФайла;
					СтрокаТЗ.РасширениеКартинки			= Параметры.РасширениеКартинки;
					СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения = "tmp" + GUID;
					//проверка заполнения имен файлов
					Если ПустаяСтрока(СтрокаТЗ.ИмяИсходящегоФайла) И ПустаяСтрока(СтрокаТЗ.ПолноеИмяИсходящегоФайла) Тогда
						Если Параметры.ПутьККаталогуИсходящихФайлов = КаталогВременныхФайлов Тогда
							СтрокаТЗ.ПолноеИмяИсходящегоФайла = ПолучитьИмяВременногоФайла(Параметры.РасширениеКартинки);
							ИмяВременногоФайла = СтрЗаменить(СтрокаТЗ.ПолноеИмяИсходящегоФайла, КаталогВременныхФайлов, "");
							СтрокаТЗ.ИмяИсходящегоФайла = ИмяВременногоФайла;
						Иначе
							//такой случай не предусмотрен
							//ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Получение временного файла с путем к каталогу НЕ являющимся каталогом временных файлов", Истина);
						КонецЕсли;
					КонецЕсли;
					//не изображения, запускаемые через просмотр
					СтрокаТЗ.ОбновитьИмяФайлаДляСтраниц = Не СтрокаТЗ.ПропуститьКонвертацию;
					Если Не СтрокаТЗ.ПропуститьКонвертацию Тогда
						Параметры.ТребуетсяКонвертация = Истина;
					КонецЕсли;
				Иначе
					СтрокаТЗ.ОбновитьИмяФайлаДляСтраниц = ЛОЖЬ;//СтрокаТЗ.КолонкаВТабличнойЧасти <> "Образец" И Не СтрокаТЗ.ПропуститьКонвертацию И Параметры.ПутьККаталогуИсходящихФайлов <> КаталогВременныхФайлов;
					СтрокаТЗ.РасширениеКартинки = уб_СЛ.ОпределитьРасширениеФайла(СтрокаТЗ.ПолноеИмяВходящегоФайла);
					СтрокаТЗ.ИмяИсходящегоФайла = СтрокаТЗ.ИмяВходящегоФайла;
					СтрокаТЗ.ПолноеИмяИсходящегоФайла = СтрокаТЗ.ПолноеИмяВходящегоФайла;
				КонецЕсли;
				Если ПустаяСтрока(СтрокаТЗ.ИмяИсходящегоФайла) Тогда
					Если ПустаяСтрока(СтрокаТЗ.ПолноеИмяИсходящегоФайла) Тогда
						//файл не требует конвертации (его данные не заданы)
						Если Параметры.ПутьККаталогуИсходящихФайлов = КаталогВременныхФайлов Тогда
							СтрокаТЗ.ПолноеИмяИсходящегоФайла = ПолучитьИмяВременногоФайла(СтрокаТЗ.РасширениеКартинки);
						Иначе
							//такой случай не предусмотрен
							//ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Получение временного файла с путем к каталогу НЕ являющимся каталогом временных файлов", Истина);
						КонецЕсли;
					КонецЕсли;
					СтрокаТЗ.ИмяИсходящегоФайла = СтрЗаменить(СтрокаТЗ.ПолноеИмяИсходящегоФайла, Параметры.ПутьККаталогуИсходящихФайлов, "")
				ИначеЕсли ПустаяСтрока(СтрокаТЗ.ПолноеИмяИсходящегоФайла) Тогда
					СтрокаТЗ.ПолноеИмяИсходящегоФайла = Параметры.ПутьККаталогуИсходящихФайлов + СтрокаТЗ.ИмяИсходящегоФайла;
				КонецЕсли;
				//СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения = Лев(СтрокаТЗ.ИмяИсходящегоФайла, СтрДлина(СтрокаТЗ.ИмяИсходящегоФайла) - СтрДлина(СтрокаТЗ.РасширениеКартинки));
				Если СтрокаТЗ.ОбновитьИмяФайлаДляСтраниц Тогда
					СтрокаТЗ.ИмяИсходящегоФайла 		= СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения + "(1)" + СтрокаТЗ.РасширениеКартинки;
					СтрокаТЗ.ПолноеИмяИсходящегоФайла 	= Параметры.ПутьККаталогуИсходящихФайлов + СтрокаТЗ.ИмяИсходящегоФайла;
				КонецЕсли;
				Если Параметры.УдалитьСтарыеФайлы И Не СтрокаТЗ.ПропуститьКонвертацию Тогда
					УдалитьКонвертированныеФайлы(СтрокаТЗ, Параметры.ПутьККаталогуИсходящихФайлов);
				КонецЕсли;
			Иначе
				СтрокаТЗ.ВходящийФайлНайден = Ложь;
				ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Входящий файл " + СтрокаТЗ.ПолноеИмяВходящегоФайла + " не найден.", Истина);
			КонецЕсли;
		КонецЦикла;		
		//Вызов конвертации
		Если Параметры.ЕстьНайденныеФайлы Тогда
			Если Параметры.ТребуетсяКонвертация Тогда
				//вызов конвертации
				Если Параметры.ЧерезФоновоеЗадание и ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина Тогда
					Если Параметры.ИспользуетсяИмяФайлаСТаблицейФайлов И ПустаяСтрока(Параметры.ИмяФайлаСТаблицейФайлов) Тогда
						Параметры.ИмяФайлаСТаблицейФайлов = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
					КонецЕсли;
					ФоноваяКонвертацияФайлов(Параметры);
				Иначе
					уб_СЕРВЕРные.ВыполнитьКонвертациюФайлов(Параметры);
				КонецЕсли;				
			КонецЕсли;
			ОкончаниеКонвертацииСервер(Параметры);
		КонецЕсли;
	КонецЕсли;
	
~НаВыход
	:
	
	//Оповещение об ошибках конвертации
	Если Параметры.ТЗОшибок.Количество() > 0 Тогда
		Параметры.СтрокаОшибки = ТЗОшибокКонвертацииВСтроку(Параметры.ТЗОшибок, Параметры.СсылкаНаОбъект);
		Если Параметры.СделатьЗаписьВЖурналПриОшибке Тогда
			ЗаписьЖурналаРегистрации(
				"Ошибки конвертации файлов", 
				УровеньЖурналаРегистрации.Ошибка,
				Параметры.СсылкаНаОбъект,
				,
				Параметры.СтрокаОшибки
			);
		КонецЕсли;	
		Если Параметры.ВыполненаКонвертацияВсехФайлов Тогда
			МассивСтрок = Параметры.ТЗОшибок.НайтиСтроки(Новый Структура("Конвертация", Истина));
			Если МассивСтрок.Количество() > 0 Тогда
				Параметры.ВыполненаКонвертацияВсехФайлов = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	//Обработка регистра очереди
	Если Параметры.СсылкаНаОбъект = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.СсылкаНаОбъект.Пустая() Тогда
		Если Параметры.ВыполненаКонвертацияВсехФайлов Тогда
			МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект 		= Параметры.СсылкаНаОбъект;
			МенеджерЗаписи.ТипОчереди 	= Перечисления.уб_ТипыОчереди.Файлы;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Удалить();
			КонецЕсли;
		ИначеЕсли ТипЗнч(Параметры.СсылкаНаОбъект) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
			//Требуется проверка на тип объекта или достаточно наличия записи про нему?
			//	измерение Объект регистра Очередь типа Заявка на выезд
			//	СсылкаНаОбъект - любая ссылка:
			//	требуется проверка, искать все подряд не имеет смысла
			МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект 		= Параметры.СсылкаНаОбъект;
			МенеджерЗаписи.ТипОчереди 	= Перечисления.уб_ТипыОчереди.Файлы;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.КоличествоПопытокВыполнения = МенеджерЗаписи.КоличествоПопытокВыполнения + 1;
				Если МенеджерЗаписи.КоличествоПопытокВыполнения > 1
					И Параметры.ТЗОшибок.Количество() > 0
					И Параметры.ОтправлятьНаПочтуОшибки 
					Тогда
					ТемаСообщения = "Ошибки конвертации файлов по " + Параметры.СсылкаНаОбъект;
					ПараметрыСообщения = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
					ПараметрыСообщения.Получатели 	= ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
					ПараметрыСообщения.Тема			= ТемаСообщения;
					ПараметрыСообщения.Сообщение	= Параметры.СтрокаОшибки;
					уб_ОбменДанными.SendMail(ПараметрыСообщения);	
				КонецЕсли;
				МенеджерЗаписи.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьКонвертациюФайлов(Параметры) Экспорт
	
	НачалоРаботы = ТекущаяДата();
	МассивОшибокКонвертации = Новый Массив;	
	Принтер = ИнициализацияПрофиляПринтера(Параметры, МассивОшибокКонвертации);
	Если Принтер <> Неопределено Тогда
		Если Принтер.Status.State = 0 Тогда
			ТаблицаФайлов = Параметры.ТаблицаФайлов;
			//принтер готов к работе и есть файлы Excel и Word
			ОбработатьФайлыExcel(Параметры, Принтер, МассивОшибокКонвертации);
			ОбработатьФайлыWord(Параметры, 	Принтер, МассивОшибокКонвертации);
			ОбработатьФайлыPDF(Параметры, 	Принтер, МассивОшибокКонвертации);
			Если Не ПустаяСтрока(Параметры.ИмяФайлаСТаблицейФайлов) Тогда
				ПоместитьВоВременноеХранилище(ТаблицаФайлов, Параметры.ИмяФайлаСТаблицейФайлов);
			КонецЕсли;	
			// ожидание завершения работы виртуального принтера
			// следует ограничить время ожидания завершения работы
			Шаг	= Параметры.ШагОжиданияЗавершенияРаботыПринтера;
			СекундПрошло = ТекущаяДата() - НачалоРаботы;
			ЧислоПопыток = Цел((Макс(Параметры.ВремяОжиданияФоновогоЗадания - СекундПрошло, 0)) * 3 / 4 / Шаг);
			Счетчик = 0;
			// 1 раз принудительное ожидание, иначе возникают ошибки доступа к файлу
			Пока Принтер.Status.State <> 0 Или Счетчик = 0 Цикл
				Счетчик = Счетчик + 1;
				Если Счетчик > ЧислоПопыток Тогда
					МассивОшибокКонвертации.Добавить("Окончилось время ожидания окончания работы виртуального принтера через фоновое задание. Возможно не все картинки записаны на диск");
					Прервать;
				КонецЕсли;
				Пауза(Шаг * 1000);
			КонецЦикла;
		Иначе
			МассивОшибокКонвертации.Добавить("Принтер не готов / Код ошибки: " + Принтер.Status.State);
			//ST_READY	0	Виртуальный принтер готов к работе.
			//ST_RENDERING	1	Идет процесс рендеринга выходного файла.
			//ST_SAVING	2	Идет процесс сохранения выходного файла.
			//ST_POSTPRINT	3	Выполняется постпринт-процесс.
			//ST_PAUSED	4	Работа виртуального принтера приостановлена.
		КонецЕсли;
	КонецЕсли;
	Если МассивОшибокКонвертации.Количество() > 0 Тогда
		Если Параметры.ЧерезФоновоеЗадание Тогда
			Если Не ПустаяСтрока(Параметры.АдресВоВременномХранилищеДляТекстаОшибки) Тогда
				ПоместитьВоВременноеХранилище(МассивОшибокКонвертации, Параметры.АдресВоВременномХранилищеДляТекстаОшибки);
			КонецЕсли;
		Иначе
			Для Каждого ЭлементМассива Из МассивОшибокКонвертации Цикл
				СтрокаТЗОшибок = Параметры.ТЗОшибок.Добавить();
				СтрокаТЗОшибок.Текст 		= ЭлементМассива;
				СтрокаТЗОшибок.Конвертация  = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОкончаниеКонвертацииСервер(Параметры)

	//Получение результата конвертации при фоновом задании
	//проброс ошибок из фонового задания
	Если Параметры.ТребуетсяКонвертация 
		И Параметры.ЧерезФоновоеЗадание 
		И Не Параметры.ИстеклоВремяОжиданияФоновогоЗадания Тогда
		Если Не ПустаяСтрока(Параметры.ИмяФайлаСТаблицейФайлов) Тогда
			ТаблицаФайлов = ПолучитьИзВременногоХранилища(Параметры.ИмяФайлаСТаблицейФайлов);
			Если ТипЗнч(ТаблицаФайлов) = Тип("ТаблицаЗначений") Тогда
				Параметры.ТаблицаФайлов = ТаблицаФайлов
			Иначе
				ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Ошибка получения таблицы файлов из временного хранилища", Истина);
			КонецЕсли;
		КонецЕсли;
		//получение ошибок, возможно произошедших при конвертации
		Если Параметры.АдресВоВременномХранилищеДляТекстаОшибки = Неопределено Тогда
			//TODO через вызов из формы записи очереди пришли без адреса, используется процедура регламентного задания
		Иначе	
			МассивОшибокКонвертации = ПолучитьИзВременногоХранилища(Параметры.АдресВоВременномХранилищеДляТекстаОшибки);
			Если ТипЗнч(МассивОшибокКонвертации) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из МассивОшибокКонвертации Цикл
					СтрокаТЗОшибок = Параметры.ТЗОшибок.Добавить();
					СтрокаТЗОшибок.Текст 		= ЭлементМассива;
					СтрокаТЗОшибок.Конвертация  = Истина;
				КонецЦикла;
			Иначе
				ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Ошибка получения массива ошибок конвертации из временного хранилища", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ТаблицаФайлов = Параметры.ТаблицаФайлов;
	//Пост-обработка Файлов
	Для Каждого СтрокаТЗ Из ТаблицаФайлов Цикл		
		Если СтрокаТЗ.ВходящийФайлНайден Тогда
			ВыполненаПостОбработка = Ложь;
			//ТипФайла = Неопределено;
			//ТребуетсяКонвертацияФайла(СтрокаТЗ.ПолноеИмяВходящегоФайла, ТипФайла);
			//применяем фильтр к картинке, к пдф принудительно
			Если (Не СтрокаТЗ.ПропуститьКонвертацию И Не Параметры.ИстеклоВремяОжиданияФоновогоЗадания) Тогда
			//требуется выполнить постобработку, либо скопировать файл из входящего в исходящий, если постобработка по каким либо причинам не вызвана
				Если СтрокаТЗ.ТребуетсяКонвертация 
					Или (Параметры.ПринудительнаяПоследующаяОбработка И уб_СЛ.ВозможнаПостобработкаИзображенияПоРасширению(СтрокаТЗ.РасширениеКартинки)) Тогда
					ПрименитьФильтрыККартинке(Параметры, СтрокаТЗ);
					ВыполненаПостОбработка = Истина;
				Иначе
					//КопироватьФайл(СтрокаТЗ.ПолноеИмяВходящегоФайла, СтрокаТЗ.ПолноеИмяИсходящегоФайла);
				КонецЕсли;
			КонецЕсли;
			Если ВыполненаПостОбработка Тогда
				Файл = Новый Файл(СтрокаТЗ.ПолноеИмяИсходящегоФайла);
				СтрокаТЗ.Выполнено = Файл.Существует();
				Файл = Неопределено;
				Если Не СтрокаТЗ.Выполнено Тогда
					ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Не найден исходящий файл " + СтрокаТЗ.ПолноеИмяИсходящегоФайла, Истина);
				КонецЕсли;
			Иначе
				СтрокаТЗ.Выполнено = ОжидатьСозданиеФайла(СтрокаТЗ.ПолноеИмяИсходящегоФайла);
				Если Не СтрокаТЗ.Выполнено Тогда
					ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Не найден исходящий файл (поиск циклом) " + СтрокаТЗ.ПолноеИмяИсходящегоФайла, Истина);
				КонецЕсли;
			КонецЕсли;
		Иначе
			СтрокаТЗ.Выполнено = Ложь;
			ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Не найден исходящий файл " + СтрокаТЗ.ПолноеИмяИсходящегоФайла, Истина);
		КонецЕсли;
	КонецЦикла;
	//Помещение файлов картинок в хранилище
	Если ТаблицаФайлов.Количество() = 1 Тогда
		СтрокаТЗ = ТаблицаФайлов[0];
		Если СтрокаТЗ.ВходящийФайлНайден И Не ПустаяСтрока(СтрокаТЗ.АдресВХранилище) И СтрокаТЗ.Выполнено Тогда
			МассивКартинок = Новый Массив;
			Если СтрокаТЗ.ОбновитьИмяФайлаДляСтраниц Тогда
				Индекс = 0;
				Пока Индекс < Параметры.МаксимальноеКоличествоСтраниц Цикл
					//TODO паузу
					//Сделать аналогично ОжидатьСозданиеФайла, как вариант параметр от обратного, но обязательно с паузой и ограниченным циклом исполнения
					//Если будет ошибка копирования/либо очень долгое копирование, будет зацикливание
					//
					//	пауза перед получением картинки из временного файла
					//	максимальное число страниц = 100
					Индекс = Индекс + 1;
					ИмяФайла = Параметры.ПутьККаталогуИсходящихФайлов + СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения + "(" + Индекс + ")" + СтрокаТЗ.РасширениеКартинки;
					Файл = Новый Файл(ИмяФайла);
					Если Файл.Существует() Тогда
						ВременныйФайл = ПолучитьИмяВременногоФайла(СтрокаТЗ.РасширениеКартинки);
						КопироватьФайл(ИмяФайла, ВременныйФайл);
						// TODO ошибка совместного доступа к файлу (если без временного файла);
						Пауза(Параметры.ВремяОжиданияСозданияФайла1С);
						Картинка = Новый Картинка(ВременныйФайл);
						МассивКартинок.Добавить(Картинка.ПолучитьДвоичныеДанные());
						//добавим в массив конвертации
						СтрокаТЗ.МассивКонвертации.Добавить(ИмяФайла);
						Файл = Неопределено;
					Иначе
						Файл = Неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Картинка = Новый Картинка(СтрокаТЗ.ПолноеИмяИсходящегоФайла);
				МассивКартинок.Добавить(Картинка.ПолучитьДвоичныеДанные());
				//добавим в массив конвертации
				СтрокаТЗ.МассивКонвертации.Добавить(СтрокаТЗ.ПолноеИмяИсходящегоФайла);
			КонецЕсли;
			ПоместитьВоВременноеХранилище(МассивКартинок, СтрокаТЗ.АдресВХранилище);			
		КонецЕсли;
		МассивКартинок = Неопределено
	КонецЕсли;
	//также удаляются автоматически при завершении сеанса
	Если Параметры.УдалятьФайлыПослеКонвертации Тогда
		УдалитьКонвертированныеФайлы(СтрокаТЗ, Параметры.ПутьККаталогуИсходящихФайлов);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьФайлыWord(Параметры, Принтер, МассивОшибокКонвертации)

	ТаблицаФайлов = Параметры.ТаблицаФайлов;
	Отбор = Новый Структура;
	Отбор.Вставить("ПриложениеВходящегоФайла", 	"Word");
	Отбор.Вставить("ПропуститьКонвертацию",		Ложь);
	Отбор.Вставить("ВходящийФайлНайден",		Истина);
	СтрокиФайлов = ТаблицаФайлов.НайтиСтроки(Отбор);
	Если СтрокиФайлов.Количество() > 0 Тогда
		Попытка
			WordApp = Новый COMОбъект("Word.Application");
			WordApp.Visible 		= Ложь;
			WordApp.ActivePrinter 	= "Universal Document Converter";
			//WordApp.DisplayRecentFiles = Ложь;
			//WordApp.DisplayScrollBars = Ложь;
		Исключение
			МассивОшибокКонвертации.Добавить("Ошибка создания COM-объекта Word");
		КонецПопытки;
		Если WordApp <> Неопределено Тогда		
			ПечатьЗапущена = Ложь;
			Для Каждого СтрокаТЗ Из СтрокиФайлов Цикл
				Попытка
					//http://msdn.microsoft.com/en-us/library/office/bb216319(v=office.12).aspx
					Revert = Ложь;//Controls what happens if FileName is the name of an open document. True to discard any unsaved changes to the open document and reopen the file. False to activate the open document.
					//Контролирует, что происходит, если FileName это имя открытого документа. Истина, чтобы отменить все несохраненные изменения в открытом документе и открыть файл. Ложь - активировать открытый документ.					
					//OpenAndRepair = Истина;//True to repair the document to prevent document corruption.
					////Истина, чтобы восстановить документ, чтобы предотвратить повреждения документа.
					//
					//NoEncodingDialog = Истина;//True to skip displaying the Encoding dialog box that Word displays if the text encoding cannot be recognized. The default value is False.
					////Истина , чтобы пропустить отображения диалоговое окно Кодировка, если кодировка текста не может быть определена. Значение по умолчанию: Ложь.
					//WordFile = WordApp.Documents.Open(СтрокаТЗ.ПолноеИмяВходящегоФайла,Ложь,Истина,Ложь,,,Revert,,,,,,,OpenAndRepair,,NoEncodingDialog);
					WordFile = WordApp.Documents.Open(СтрокаТЗ.ПолноеИмяВходящегоФайла,Ложь,Истина,Ложь,,,Revert);
				Исключение
					МассивОшибокКонвертации.Добавить("Не удалось открыть файл " + СтрокаТЗ.КолонкаВТабличнойЧасти + " " + Строка(СтрокаТЗ.НомерСтрокиВДокументе) + ". Описание ошибки: " + ОписаниеОшибки());
					Продолжить;
				КонецПопытки;
				Попытка
					////WordApp.DisplayAutoCompleteTips = Ложь;
					//WordApp.DisplayScreenTips = Ложь;
					//WordApp.DisplayStatusBar = Ложь;				
					Принтер.Profile.OutputLocation.FileName = СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения + "(&[Page(0)])" + Параметры.РасширениеКартинки;				
					//WordFile.PrintOut(СтрокаТЗ.НомерСтраницыОт, СтрокаТЗ.НомерСтраницыДо, , , "Universal Document Converter");
					Если СтрокаТЗ.НомерСтраницыОт = 0 И СтрокаТЗ.НомерСтраницыДо = 0 Тогда
						WordFile.PrintOut(0);
					Иначе
						НомерСтраницыДо = ?(СтрокаТЗ.НомерСтраницыДо = 0, 999, СтрокаТЗ.НомерСтраницыДо);
						НомерСтраницыОт = ?(СтрокаТЗ.НомерСтраницыОт = 0, 1, СтрокаТЗ.НомерСтраницыОт);
						WordFile.PrintOut(0,,4,,,,,,Строка(НомерСтраницыОт) + "-" + Строка(НомерСтраницыДо));
					КонецЕсли;				
					Попытка
