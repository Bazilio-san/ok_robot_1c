//Возвращает первое свободное имя файла в папке (итерация цифрового суффикса) 
Функция ПолучитьИмяСледующегоФайла(ЛеваяЧасть, ПраваяЧасть, ПутьКПапке, МассивЗначений) Экспорт
	
	Счетчик = 1;
	Пока Истина Цикл
		ЕстьВМассиве = МассивЗначений.Найти(ЛеваяЧасть + Строка(Счетчик) + ПраваяЧасть) <> Неопределено;
		Если Не ЕстьВМассиве Тогда
			//Файл = Новый Файл(ПутьКПапке + ЛеваяЧасть + Строка(Счетчик) + ПраваяЧасть);
			//Если Не Файл.Существует() Тогда
			Если Не ФайлСуществует(ПутьКПапке, ЛеваяЧасть + Строка(Счетчик) + ПраваяЧасть) Тогда
				Возврат ЛеваяЧасть + Строка(Счетчик) + ПраваяЧасть;
			КонецЕсли;
		КонецЕсли;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
