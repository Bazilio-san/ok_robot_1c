Функция Карты(Сотрудник,ВыбКарта = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КошелькиСотрудники.Сотрудник КАК Сотрудник,
	               |	КошелькиСотрудники.Ссылка КАК Карта,
	               |	Кошельки.Наименование КАК Наименование,
	               |	Кошельки.Сотрудник КАК Владелец,
	               |	Кошельки.НомерТелефона КАК НомерТелефона,
	               |	Кошельки.НомерКарты КАК НомерКарты,
	               |	ВЫБОР
	               |		КОГДА КошелькиСотрудники.Ссылка = &ВыбКарта
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Приоритетная
	               |ИЗ
	               |	Справочник.Кошельки КАК Кошельки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кошельки.Сотрудники КАК КошелькиСотрудники
	               |		ПО (КошелькиСотрудники.Ссылка = Кошельки.Ссылка)
	               |ГДЕ
	               |	Кошельки.Актуальность
	               |	И Кошельки.ЭтоКартаСотрудника
	               |	И КошелькиСотрудники.Сотрудник = &Сотрудник
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритетная УБЫВ";
	Запрос.УстановитьПараметр("ВыбКарта",ВыбКарта);
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции	

Функция НомерДоговора(ВидБСО, ОрганизацияАгент, Дата = Неопределено) Экспорт

	Если Не (ЗначениеЗаполнено(ВидБСО) 
		И ЗначениеЗаполнено(ОрганизацияАгент) 
		И ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО")
		И ВидБСО.Тип = Перечисления.уб_ТипыБСО.Полис
		) Тогда
		Возврат ""
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПБ.Ссылка.Поставщик КАК Поставщик
	|ПОМЕСТИТЬ ВТ_Поставщик
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК ПБ
	|ГДЕ
	|	ПБ.ВидБСО = &ВидБСО
	|	И ПБ.Ссылка.ОрганизацияАгент = &ОрганизацияАгент
	|	И ПБ.Ссылка.Дата <= &Дата
	|	И ПБ.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДК.Наименование,
	|	ДК.ДатаЗаключенияДоговора,
	|	ДК.ВидСП КАК ВидСП
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Поставщик КАК ВТ_Поставщик
	|		ПО ДК.Владелец = ВТ_Поставщик.Поставщик
	|ГДЕ
	|	ДК.Организация = &ОрганизацияАгент
	|	И НЕ ДК.ПометкаУдаления
	|	И ДК.РасширениеНазвания <> ""---""
	|	И (ДК.ДатаОкончанияДействияДоговора = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора > &Дата)
	|	И ДК.ДатаЗаключенияДоговора < &Дата
	|	И ДК.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидСП УБЫВ");
	Запрос.УстановитьПараметр("ВидБСО",				ВидБСО);
	Запрос.УстановитьПараметр("ОрганизацияАгент",   ОрганизацияАгент);
	Запрос.УстановитьПараметр("Дата",				Дата);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = ""
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если ПустаяСтрока(Выборка.Наименование) Тогда
			Результат = "";
		Иначе
			Результат = Выборка.Наименование + ?(ЗначениеЗаполнено(Выборка.ДатаЗаключенияДоговора), " от " + Формат(Выборка.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy"), "");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции // НомерДоговора()

Функция ДоговорПоВидуБСО(ВидБСО, Знач Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПБ.Ссылка.Поставщик КАК Поставщик
	|ПОМЕСТИТЬ ВТ_Поставщик
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК ПБ
	|ГДЕ
	|	ПБ.Ссылка.Проведен
	|	И ПБ.ВидБСО = &ВидБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СП.ВидБСО,
	|	СП.Ссылка.Вид
	|ИЗ
	|	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК СП
	|ГДЕ
	|	НЕ СП.Ссылка.ПометкаУдаления
	|	И СП.ВидБСО = &ВидБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДК.Ссылка,
	|	ДК.Владелец КАК Владелец,
	|	ДК.ВидСП,
	|	ДК.ДатаЗаключенияДоговора,
	|	ДК.Наименование
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Поставщик КАК ВТ_Поставщик
	|		ПО ДК.Владелец = ВТ_Поставщик.Поставщик
	|ГДЕ
	|	(ДК.ДатаОкончанияДействияДоговора = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора > &Дата)
	|	И ДК.ДатаЗаключенияДоговора <= &Дата
	|	И ДК.РасширениеНазвания <> ""---""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДК.ВидСП
	|ИТОГИ ПО
	|	Владелец");
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("Дата",	Дата);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Результат = "";
	Если Выборка.Количество() = 1 Тогда
		ВыборкаВидСП = Пакет[1].Выбрать();
		Если ВыборкаВидСП.Количество() = 1 Тогда
			ВыборкаВидСП.Следующий();
			ТекущийВидСП = ВыборкаВидСП.Вид;
		КонецЕсли;
		Выборка.Следующий();
		Выборка = Выборка.Выбрать();
		Если ТекущийВидСП <> Неопределено Тогда
			//ищем по виду сп
			Пока Выборка.Следующий() Цикл
				Если Выборка.ВидСП = ТекущийВидСП Тогда
					Результат = Выборка.Наименование + ?(ЗначениеЗаполнено(Выборка.ДатаЗаключенияДоговора), " от " + Формат(Выборка.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy"), "");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Результат = "" Тогда
			//берем первый пустой
			Выборка.Сбросить();
			Если Выборка.Следующий() Тогда
				Результат = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат
	
КонецФункции


Функция ПроверкаДат(ДатаНачала,Аддендум) Экспорт 
	ДнейДо = ?(Аддендум,365,90);
	если (ДатаНачала > (ТекущаяДата()+65*3600*24))
		или (ДатаНачала < (ТекущаяДата()-ДнейДо*3600*24)) Тогда
		Возврат ЛОЖЬ;
	Иначе
		Возврат ИСТИНА;
	КонецЕсли;	
КонецФункции


Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт

   Массив = Новый Массив();
   СтруктураСтрокой = "";
   НужнаЗапятая = Ложь;
   Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
       Если НужнаЗапятая Тогда
           СтруктураСтрокой = СтруктураСтрокой + ",";
       КонецЕсли;
       СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
       НужнаЗапятая = Истина;
   КонецЦикла;
   Для Каждого Строка Из ТаблицаЗначений Цикл
       НоваяСтрока = Новый Структура(СтруктураСтрокой);
       ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
       Массив.Добавить(НоваяСтрока);
   КонецЦикла;
   Возврат Массив;

КонецФункции



