Процедура ДобавитьСтрокуТЗОшибокКонвертации(ТЗОшибок, Текст, Конвертация = Ложь)

	СтрокаТЗ = ТЗОшибок.Добавить();
	СтрокаТЗ.Текст 			= Текст;
	СтрокаТЗ.Конвертация  	= Конвертация;

КонецПроцедуры

Функция ТЗОшибокКонвертацииВСтроку(ТЗОшибок, СсылкаНаОбъект = Неопределено)
	
	СтрокаОшибки = "";
	Если ТЗОшибок.Количество() > 0 Тогда
		Если уб_кэшируемые.ДоступностьРоли("ПолныеПрава") ТОгда
			СтрокаОшибки = "Обнаруженные ошибки при конвертации" + ?(ЗначениеЗаполнено(СсылкаНаОбъект), " " + СсылкаНаОбъект, "") + ":";
			Для Каждого СтрокаТЗ Из ТЗОшибок Цикл
				СтрокаОшибки = СтрокаОшибки + "
				|" + СтрокаТЗ.Текст;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокаОшибки;

КонецФункции // МассивОшибокКонвертацииВСтроку()

Процедура ФоноваяКонвертацияФайлов(Параметры)

	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Параметры);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("уб_СЕРВЕРные.ВыполнитьКонвертациюФайлов", МассивПараметров);
	Попытка
		ФоновоеЗадание.ОжидатьЗавершения(Параметры.ВремяОжиданияФоновогоЗадания);
		ФоновоеЗадание.Отменить();
	Исключение
		ТекстСообщения = "Истекло время ожидания завершения фонового задания. " + ФоновоеЗадание.ИнформацияОбОшибке;
		ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, ТекстСообщения, Истина);
		Параметры.ИстеклоВремяОжиданияФоновогоЗадания = Истина;
		//частное оповещение на почту
		Если ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина И Не Параметры.ОтправлятьНаПочтуОшибки Тогда
			ТемаСообщения = "Истекло время ожидания завершения фонового задания. " + Параметры.СсылкаНаОбъект;
			ПараметрыСообщения = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
			ПараметрыСообщения.Получатели 	= ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
			ПараметрыСообщения.Тема			= ТемаСообщения;
			ПараметрыСообщения.Сообщение	= ТекстСообщения;
			уб_ОбменДанными.SendMail(ПараметрыСообщения);
		КонецЕсли;
	КонецПопытки;	

КонецПроцедуры

Процедура ПрименитьФильтрыККартинке(Параметры, СтрокаТЗ)
	
	ИмяВходящегоФайла = ?(СтрокаТЗ.ТребуетсяКонвертация, СтрокаТЗ.ПолноеИмяИсходящегоФайла, СтрокаТЗ.ПолноеИмяВходящегоФайла);
	// входящий файл должен существовать (при конвертации возможна задержка создания файла даже после завершения работы виртуального принтера)
	// ожидаем файл.
	ФайлСуществует = ОжидатьСозданиеФайла(ИмяВходящегоФайла);
	Если Не ФайлСуществует Тогда
		ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Не найден входящий файл для постобработки " + ИмяВходящегоФайла, Истина);
	КонецЕсли;
	ИмяИсходящегоФайла  = СтрокаТЗ.ПолноеИмяИсходящегоФайла;
	Счетчик = 2;
	Пока ФайлСуществует Цикл
		ТекстОшибки = "";
		Пауза(Цел(Параметры.ВремяОжиданияСозданияФайла1С / 2));
		ПовернутьКартинкуПоГоризонталиИУменьшениеРазмера(
			ИмяВходящегоФайла,
			ИмяИсходящегоФайла,
			Параметры.МаксимальныйРазмерКартинки,
			?(Параметры.ПовернутьКартинкуЕслиШиринаБольшеВысоты или СтрокаТЗ.ПовернутьКартинкуЕслиШиринаБольшеВысоты = Истина, Параметры.УголПоворота, 0),
			Параметры.ПроцентыОтШириныКартинки,
			ТекстОшибки
		);
		Если ТекстОшибки = "" Тогда
			ИмяФайла = Параметры.ПутьККаталогуИсходящихФайлов + СтрокаТЗ.НачальноеИмяИсходящегоФайлаБезРасширения + "(" + Счетчик + ")" + СтрокаТЗ.РасширениеКартинки;
			Файл = Новый Файл(ИмяФайла);
			Пауза(Цел(Параметры.ВремяОжиданияСозданияФайла1С / 2));
			Если Файл.Существует() Тогда
				ИмяВходящегоФайла 	= ИмяФайла;
				ИмяИсходящегоФайла  = ИмяФайла;
				Счетчик = Счетчик + 1;
			Иначе
				ФайлСуществует = Ложь;
			КонецЕсли;
		Иначе				
			ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, ТекстОшибки, Истина);
			ФайлСуществует = Ложь;
		КонецЕсли;
		Файл = Неопределено;
	КонецЦикла;
	Картинка 	= Неопределено;
	IP 			= Неопределено;
	
КонецПроцедуры

Функция ОжидатьСозданиеФайла(ИмяФайла, ЧислоПопыток = 3, ВремяОжидания = 400)

	Файл = Новый Файл(ИмяФайла);
	ФайлСуществует = Файл.Существует();
	Счетчик = 0;
	Пока Не ФайлСуществует И Счетчик < ЧислоПопыток Цикл
		Пауза(ВремяОжидания);
		ФайлСуществует = Файл.Существует();
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Файл = Неопределено;
	Возврат ФайлСуществует;

КонецФункции // ОжидатьСозданиеФайла()

Процедура ПолучитьТаблицуКонвертацииФайлов(Параметры)
	
	СоответствиеВидовДокументовИмениПоля = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СоответствиеВидовДокументовИмениПоля();
	СчетчикКартинок = Новый Структура;
	СчетчикКартинок.Вставить("Расчетчик", 		1);
	СчетчикКартинок.Вставить("ДопСоглашение",	1);
	СчетчикКартинок.Вставить("ДругиеДокументы",	1);
	//Запрос = Новый Запрос(
	//"ВЫБРАТЬ
	//|	З.Расчетчик,
	//|	З.ДопСоглашение
	//|ИЗ
	//|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК З
	//|ГДЕ
	//|	З.Ссылка = &Ссылка
	//|	И (З.Расчетчик <> """"
	//|			ИЛИ З.ДопСоглашение <> """")
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	З.НомерСтроки");
	//
	// строк "Расчетчик", "ДопСоглашение" и пр. потом уже не будет. Будет ТЧ и связь по уидам строк.
	// пока идентификация будет производится по значениям элемента справочника видов документов к полисам
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Вложенный.ЗначениеПоля КАК ЗначениеПоля,
	|	Вложенный.ВидДокумента КАК ВидДокумента,
	|	ЕСТЬNULL(Ф.УИД, """") КАК УИД,
	|	ЕСТЬNULL(Ф.ПутьКПапке, """") КАК ПутьКПапке,
	|	ЕСТЬNULL(Х.Путь, """") КАК ХранилищеПуть,
	|	ЕСТЬNULL(Ф.ФайлИмя, """") КАК ФайлИмя,
	|	ВЫБОР
	|		КОГДА Ф.УИД ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьЗапись,
	|	Вложенный.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	(ВЫБРАТЬ
	|		З.Расчетчик КАК ЗначениеПоля,
	|		ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.РасчетныйЛист) КАК ВидДокумента,
	|		З.НомерСтроки КАК НомерСтроки
	|	ИЗ
	|		Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК З
	|	ГДЕ
	|		З.Ссылка = &Ссылка
	|		И З.Расчетчик <> """"
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		З.ДопСоглашение,
	|		ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.ДопСоглашение),
	|		З.НомерСтроки
	|	ИЗ
	|		Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК З
	|	ГДЕ
	|		З.Ссылка = &Ссылка
	|		И З.ДопСоглашение <> """"
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		З.ДругиеДокументы,
	|		ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.Прочее),
	|		З.НомерСтроки
	|	ИЗ
	|		Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК З
	|	ГДЕ
	|		З.Ссылка = &Ссылка
	|		И З.ДругиеДокументы <> """") КАК Вложенный
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК Ф
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.уб_ХранилищаФайловБ2Б КАК Х
	|			ПО Ф.Хранилище = Х.Ссылка
	|		ПО Вложенный.ЗначениеПоля = Ф.УИД
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вложенный.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", Параметры.СсылкаНаОбъект);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			УИД = "";
			Если Выборка.ЕстьЗапись Тогда
				ИмяФайла 	= Выборка.ФайлИмя;
				УИД			= Выборка.УИД;
			Иначе
				ИмяФайла = Выборка.ЗначениеПоля;
			КонецЕсли;
			СчетчикСтрок = Выборка.НомерСтроки;
			Если Не ПустаяСтрока(ИмяФайла) Тогда
				ИмяПоля = СоответствиеВидовДокументовИмениПоля.Получить(Выборка.ВидДокумента); 
				ОбработатьВнешнийФайл(
					ИмяФайла, 
					ИмяПоля, 
					СчетчикКартинок[ИмяПоля], 
					Параметры, 
					Выборка.НомерСтроки,
					УИД
				);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Параметры.МассивНомеровСтрокТЧПечататьОбразцы.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВБ.ИмяФайлаОбразца
		|ИЗ
		|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК З
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.уб_ВидыБСО КАК ВБ
		|		ПО З.ВидБСО = ВБ.Ссылка
		|			И (ВБ.ИмяФайлаОбразца <> """")
		|ГДЕ
		|	З.Ссылка = &Ссылка
		|	И З.НомерСтроки В(&МассивНомеровСтрокТЧПечататьОбразцы)");
		Запрос.УстановитьПараметр("Ссылка", 								Параметры.СсылкаНаОбъект);
		Запрос.УстановитьПараметр("МассивНомеровСтрокТЧПечататьОбразцы",	Параметры.МассивНомеровСтрокТЧПечататьОбразцы);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			ПутьКХранилищу = уб_СЛ.ПроверитьИмяКаталога(Справочники.уб_ХранилищаФайловБ2Б.ОбразцыВидовБСО.Путь);
			Если Не ПустаяСтрока(ПутьКХранилищу) Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Счетчик = 0;
				Пока Выборка.Следующий() Цикл
					ТипФайла = Неопределено;
					Счетчик = Счетчик + 1;
					СтрокаТЗ = Параметры.ТаблицаФайлов.Добавить();
					СтрокаТЗ.КолонкаВТабличнойЧасти 	= "Образец";
					СтрокаТЗ.НомерСтрокиВДокументе		= Счетчик;
					СтрокаТЗ.ПолноеИмяВходящегоФайла    = ПутьКХранилищу + Выборка.ИмяФайлаОбразца;
					СтрокаТЗ.СтрокаВТабличнойЧасти		= "Образец" + Счетчик;
					// конвертация картинок не требуется
					СтрокаТЗ.Выполнено 			= Истина;
					СтрокаТЗ.РасширениеКартинки = уб_СЛ.ОпределитьРасширениеФайла(Выборка.ИмяФайлаОбразца);
					СтрокаТЗ.ПолноеИмяИсходящегоФайла = ПолучитьИмяВременногоФайла();
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьВнешнийФайл(Знач ИмяВходящегоФайла, Описание, Счетчик, Параметры, СчетчикСтрок, УИД = "")

	Перем ТипФайла;
	
	ИмяВходящегоФайла = СокрЛП(ИмяВходящегоФайла);
	СтрокаТЗ = Параметры.ТаблицаФайлов.Добавить();
	СтрокаТЗ.КолонкаВТабличнойЧасти 	= Описание;
	СтрокаТЗ.НомерСтрокиВДокументе 		= СчетчикСтрок;
	СтрокаТЗ.ПолноеИмяВходящегоФайла 	= Параметры.ПутьККаталогуВходящихФайлов + ИмяВходящегоФайла;
	Если ТребуетсяКонвертацияФайла(ИмяВходящегоФайла, ТипФайла) Тогда
		СтрокаТЗ.ПриложениеВходящегоФайла 	= ТипФайла;
		//СтрокаТЗ.ИмяИсходящегоФайла 		= Параметры.ПрефиксФайлаВКэше + СтрЗаменить(ИмяВходящегоФайла, ".", "_") + Параметры.РасширениеКартинки;
		СтрокаТЗ.РасширениеКартинки 		= Параметры.РасширениеКартинки;
	Иначе
		СтрокаТЗ.Выполнено = Истина;
		СтрокаТЗ.РасширениеКартинки = уб_СЛ.ОпределитьРасширениеФайла(ИмяВходящегоФайла);
		СтрокаТЗ.ИмяИсходящегоФайла = Параметры.ПрефиксФайлаВКэше + ИмяВходящегоФайла;
	КонецЕсли;
	//СтрокаТЗ.ИмяИсходящегоФайла 	= СтрЗаменить(СтрокаТЗ.ИмяИсходящегоФайла, Символ(160), "");
	СтрокаТЗ.НомерСтраницыОт 		= Параметры.НомерСтраницыОт;
	СтрокаТЗ.НомерСтраницыДо 		= Параметры.НомерСтраницыДо;	
	СтрокаТЗ.СтрокаВТабличнойЧасти 	= Описание + Строка(Счетчик);
	СтрокаТЗ.УИД					= УИД;
	СтрокаТЗ.ИмяВходящегоФайла      = ИмяВходящегоФайла;
	Счетчик = Счетчик + 1;	

КонецПроцедуры

Функция ТребуетсяКонвертацияФайла(Путь, ТипФайла)
	
	ПозицияXLS = Найти(Путь, ".xl");
	Если ПозицияXLS = 0 Тогда
		ПозицияDOC = Найти(Путь, ".doc");
		Если ПозицияDOC = 0 Тогда
			ПозицияDOC = Найти(Путь, ".dot");
			Если ПозицияDOC = 0 Тогда
				ПозицияDOC = Найти(Путь, ".rtf");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПозицияXLS <> 0 Тогда
		ТипФайла = "Excel";
		Возврат Истина;
	ИначеЕсли ПозицияDOC <> 0 Тогда
		ТипФайла = "Word";
		Возврат Истина;
	ИначеЕсли Найти(Путь, ".pdf")<>	0 Тогда
		ТипФайла = "PDF";
		Возврат Истина;
	Иначе
		ТипФайла = "";
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПовернутьКартинкуПоГоризонталиИУменьшениеРазмера(
	ИмяВходящегоФайла, 
	ИмяИсходящегоФайла,
	МаксимальныйРазмер 	= 0,
	УголПоворота		= 0,
	ПроцентыОтШирины	= 0,
	ТекстОшибки			= ""
	)
	
	Попытка
		Картинка = Новый COMОбъект("WIA.ImageFile");
	Исключение
		ТекстОшибки = "Ошибка при создании COM-объекта WIA.ImageFile";
		Возврат Ложь;
	КонецПопытки;
	Попытка
		Картинка.LoadFile(ИмяВходящегоФайла);
		ВыполнитьПоворот	= УголПоворота <> 0 И Картинка.Width - Картинка.Height > Картинка.Height * ПроцентыОтШирины / 100;
		УменьшитьРазмер		= МаксимальныйРазмер > 0 И (Картинка.Width > МаксимальныйРазмер Или Картинка.Height > МаксимальныйРазмер);
		Если ВыполнитьПоворот Или УменьшитьРазмер Тогда
			Попытка
				IP = Новый COMОбъект("WIA.ImageProcess");
			Исключение
				ТекстОшибки = "Ошибка при создании COM-объекта WIA.ImageProcess";
				Возврат Ложь;
			КонецПопытки;
			Счетчик = 1;
			Если УменьшитьРазмер Тогда
				IP.Filters.Add(IP.FilterInfos("Scale").FilterID);
				IP.Filters(Счетчик).Properties("MaximumWidth").Value 	= МаксимальныйРазмер;
				IP.Filters(Счетчик).Properties("MaximumHeight").Value 	= МаксимальныйРазмер;
				Счетчик = Счетчик + 1;
			КонецЕсли;
			Если ВыполнитьПоворот Тогда
				IP.Filters.Add(IP.FilterInfos("RotateFlip").FilterID);
				IP.Filters(Счетчик).Properties("RotationAngle").Value = УголПоворота;
			КонецЕсли;			
			img = IP.Apply(Картинка);
			IP = Неопределено;
			Если ИмяИсходящегоФайла = Неопределено Или ИмяВходящегоФайла = ИмяИсходящегоФайла Тогда
				ВременныйФайл = ПолучитьИмяВременногоФайла();
				img.SaveFile(ВременныйФайл);
				Картинка = Неопределено;
				ПереместитьФайл(ВременныйФайл, ИмяВходящегоФайла);
			Иначе
				Файл = Новый Файл(ИмяИсходящегоФайла);
				Если Файл.Существует() Тогда
					Файл = Неопределено;
					ВременныйФайл = ПолучитьИмяВременногоФайла();
					img.SaveFile(ВременныйФайл);
					Картинка = Неопределено;
					ПереместитьФайл(ВременныйФайл, ИмяИсходящегоФайла);
				Иначе
					img.SaveFile(ИмяИсходящегоФайла);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИмяВходящегоФайла <> ИмяИсходящегоФайла Тогда
			Файл = Новый Файл(ИмяИсходящегоФайла);
			Если Не Файл.Существует() Тогда
				Файл = Неопределено;
				КопироватьФайл(ИмяВходящегоФайла, ИмяИсходящегоФайла);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстОшибки = "Ошибка функции поворота картинки и уменьшения размера. Имя входящего файла: " + ИмяВходящегоФайла + ", имя исходящего файла: " + ИмяИсходящегоФайла + ", описание ошибки: " + ОписаниеОшибки();
		Картинка = Неопределено;
		IP = Неопределено;
		Возврат Ложь;
	КонецПопытки;
	Картинка = Неопределено;
	IP = Неопределено;
	Возврат Истина;
	
КонецФункции

Процедура ВыполнитьОбрезкуПолей(Параметры, СтрокаТЗ, ВремяПаузы = 100, КоличествоПауз = 30)
	
	Лево 		= СтрокаТЗ.ПолеСлева;
	Верх		= СтрокаТЗ.ПолеСверху;
	Право		= СтрокаТЗ.ПолеСправа;
	Низ			= СтрокаТЗ.ПолеСнизу;
	ИмяФайла    = СтрокаТЗ.ПолноеИмяИсходящегоФайла;
	Счетчик = 1;
	Выполнено = Ложь;
	Пока Не Выполнено Цикл
		Выполнено = Crop(Лево, Верх, Право, Низ, ИмяФайла);
		Если Не Выполнено Тогда
			Если Счетчик > КоличествоПауз Тогда
				ДобавитьСтрокуТЗОшибокКонвертации(Параметры.ТЗОшибок, "Ошибка выполнения обрезки полей", Истина);
				Выполнено = Истина;
			Иначе
				Пауза(ВремяПаузы);
			КонецЕсли;
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОжиданиеСтатусаПринтера(Принтер, МаксимумВремениОжидания)
	
	Старт = ТекущаяДата();
	Финиш = ТекущаяДата();
	Пока (Финиш - Старт) < МаксимумВремениОжидания Цикл
		Финиш = ТекущаяДата();
		Если Принтер.Status.State = 0 Тогда
			Прервать;
		КонецЕсли;
	Конеццикла;
	
КонецПроцедуры

Функция Crop(
	Лево,
	Верх,
	Право,
	Низ,
	ИмяВходящегоФайла, 
	Знач ИмяИсходящегоФайла = "" 
	)
	
	// функция не используется
	Если ИмяИсходящегоФайла = "" Тогда
		ИмяИсходящегоФайла = ИмяВходящегоФайла
	КонецЕсли;
	Попытка
		//http://msdn.microsoft.com/en-us/library/windows/desktop/ms630819(v=vs.85).aspx
		Картинка = Новый Comobject("WIA.ImageFile");
		Картинка.LoadFile(ИмяВходящегоФайла);		
		IP = Новый Comobject("WIA.ImageProcess");
		IP.Filters.Add(IP.FilterInfos("Crop").FilterID);
		IP.Filters(1).Properties("Left").Value   = Окр(Лево		* Картинка.HorizontalResolution	/ 25.4);
		IP.Filters(1).Properties("Top").Value    = Окр(Верх		* Картинка.VerticalResolution	/ 25.4);
		IP.Filters(1).Properties("Right").Value  = Окр(Право	* Картинка.HorizontalResolution	/ 25.4);
		IP.Filters(1).Properties("Bottom").Value = Окр(Низ		* Картинка.VerticalResolution	/ 25.4);		
		img = IP.Apply(Картинка);
		IP = Неопределено;
		Если ИмяВходящегоФайла = ИмяИсходящегоФайла Тогда
			Если Прав(ИмяВходящегоФайла, 3) = "(1)" Тогда
				ИмяВходящегоФайла = Лев(ИмяВходящегоФайла, СтрДлина(ИмяВходящегоФайла) - 3);
			КонецЕсли;
		КонецЕсли;
		Если ИмяИсходящегоФайла = Неопределено Или ИмяВходящегоФайла = ИмяИсходящегоФайла Тогда //TODO Или ИмяВходящегоФайла = ИмяИсходящегоФайла когда?
			ВременныйФайл = ПолучитьИмяВременногоФайла();
			img.SaveFile(ВременныйФайл);
			img = Неопределено;
			Картинка = Неопределено;
			//Sleep(1);
			ПереместитьФайл(ВременныйФайл, ИмяИсходящегоФайла);
		Иначе
			Файл = Новый Файл(ИмяИсходящегоФайла);
			Если Файл.Существует() Тогда
				Файл = Неопределено;
				ВременныйФайл = ПолучитьИмяВременногоФайла();
				img.SaveFile(ВременныйФайл);
				img = Неопределено;
				Картинка = Неопределено;
				ПереместитьФайл(ВременныйФайл, ИмяИсходящегоФайла);
			Иначе
				img.SaveFile(ИмяИсходящегоФайла);
				img = Неопределено;
				Картинка = Неопределено;
			КонецЕсли;
		КонецЕсли;
		Результат = Истина;
	Исключение
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

