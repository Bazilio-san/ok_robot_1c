Функция УбратьТолькоЧтениеФайла(ИмяФайлаИлиМассив, ПроверкаФайла = Истина) Экспорт

	Попытка
		FSO = Новый COMОбъект("Scripting.FileSystemObject");
	Исключение
	КонецПопытки;
	Если FSO <> Неопределено Тогда
		Результат = Истина;
		Если ТипЗнч(ИмяФайлаИлиМассив) = Тип("Строка") Тогда
			МассивИменФайлов = Новый Массив;
			МассивИменФайлов.Добавить(ИмяФайлаИлиМассив);
		Иначе
			МассивИменФайлов = ИмяФайлаИлиМассив;
		КонецЕсли;
	    Для Каждого ИмяФайла Из МассивИменФайлов Цикл
			Если ПроверкаФайла Тогда
				Файл = Новый Файл(ИмяФайла);
				ФайлСуществует = Файл.Существует();
			Иначе
				ФайлСуществует = Истина;
			КонецЕсли;
			Файл = Неопределено;
			Если ФайлСуществует Тогда
				Если ПроверкаФайла Тогда
					ФайлТолькоЧтение = Файл.ПолучитьТолькоЧтение()
				Иначе
					ФайлТолькоЧтение = Истина;
				КонецЕсли;
				Если ФайлТолькоЧтение Тогда
					Попытка
						File = FSO.GetFile(ИмяФайла);
						File.Attributes = File.Attributes - 1;				
					Исключение
						Результат = Ложь;
					КонецПопытки;
				Иначе
					Результат = Ложь;
				КонецЕсли;
			Иначе
				Результат = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	Возврат Результат;	

КонецФункции // УбратьТолькоЧтениеУФайла()

