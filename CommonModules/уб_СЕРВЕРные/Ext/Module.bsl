Функция ОбработатьUU(Данные) Экспорт
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Данные.Имя);
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Данные.УникальныйИдентификатор));
		Если ПользовательИБ = Неопределено Тогда
			ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
			ПользовательИБ.Имя = Данные.Имя;
			ПользовательИБ.УникальныйИдентификатор = Новый УникальныйИдентификатор(Данные.УникальныйИдентификатор);
		Иначе
			ПользовательИБ.Имя = Данные.Имя;	
		КонецЕсли;	
		
	КонецЕсли; 
	
	ПользовательИБ.АутентификацияOpenID      = Данные.АутентификацияOpenID;
	ПользовательИБ.АутентификацияОС          = Данные.АутентификацияОС;
	ПользовательИБ.АутентификацияСтандартная = Данные.АутентификацияСтандартная;
	ПользовательИБ.ЗапрещеноИзменятьПароль   = Данные.ЗапрещеноИзменятьПароль;
	ЗащитаОтОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий;
	ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Данные.ЗащитаОтОпасныхДействий;
	ПользовательИБ.ЗащитаОтОпасныхДействий   = ЗащитаОтОпасныхДействий;
	
	ПользовательИБ.ОсновнойИнтерфейс         = Метаданные.Интерфейсы.Найти( Данные.ОсновнойИнтерфейс);
	ПользовательИБ.СохраняемоеЗначениеПароля = Данные.СохраняемоеЗначениеПароля;
	ПользовательИБ.ПолноеИмя                 = Данные.ПолноеИмя;                    
	ПользовательИБ.ПользовательОС            = Данные.ПользовательОС;
	ПользовательИБ.Язык                      = Метаданные.Языки.Найти (Данные.Язык);
	ПользовательИБ.Роли.Очистить();
	Для каждого роль из Данные.Роли Цикл
		Попытка
			ПользовательИБ.Роли.Добавить(Метаданные.Роли.Найти(роль))
		Исключение
		КонецПопытки;	
	КонецЦикла; 
	ПользовательИБ.Записать();
	Возврат Ответ(200,"OK");
КонецФункции	
