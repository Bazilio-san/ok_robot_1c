Функция СинхронизацияФайловЗаявки(Параметры) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Ошибки ="";
	Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	уб_ФайлыКПолисам.ПутьКПапке,
		               |	уб_ФайлыКПолисам.Хранилище.Путь,
		               |	уб_ФайлыКПолисам.ФайлИмя,
		               |	уб_ФайлыКПолисам.Страхователь,
		               |	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО, """") КАК ВидБСО,
		               |	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.НомерСтроки,1) как НомерСтроки
		               |ИЗ
		               |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК СписокФайлов
		               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
		               |			ПО (уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка = &СтраховойПолис)
		               |				И (уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидСтроки = СписокФайлов.УидСтроки)
		               |		ПО (СписокФайлов.Ссылка = &СтраховойПолис)
		               |			И уб_ФайлыКПолисам.УИД = СписокФайлов.СсылкаСправочника
		               |ГДЕ
		               |	( НЕ СписокФайлов.СсылкаСправочника ЕСТЬ NULL )
		               |	И уб_ФайлыКПолисам.Архив = ЛОЖЬ";
		//Запрос.УстановитьПараметр("Файлы",
		//Параметры.Файлы);
		Запрос.УстановитьПараметр("СтраховойПолис",Параметры.Ссылка);
		//Запрос.УстановитьПараметр("УИД",Параметры.Ссылка.СписокФайлов.Выгрузить().ВыгрузитьКолонку("СсылкаСправочника"));
		
		
		
		ИмяПапки = КаталогДляЗаявки(Параметры);
		
		ВыборкаФайлы = Запрос.Выполнить().Выбрать();
		Если Параметры.Номер<=111023 Тогда
			Если ВыборкаФайлы.Количество()>0 Тогда
				Создатькаталог(ИмяПапки);
			КонецЕсли;	
		КонецЕсли;	
			
		Пока ВыборкаФайлы.Следующий() Цикл
			Если Параметры.Номер>111023 и Не ВыборкаФайлы.ВидБСО ="" Тогда
				КаталогДляЗаявки_ = ИмяПапки+"\"+уб_B2B.УбратьСимволы(ВыборкаФайлы.ВидБСО,"")+?(ВыборкаФайлы.НомерСтроки=1,"",ВыборкаФайлы.НомерСтроки);
			Иначе
				КаталогДляЗаявки_ = ИмяПапки;
			КонецЕсли;	
			Файл = Новый Файл(КаталогДляЗаявки_);
			Если НЕ Файл.Существует() Тогда
				СоздатьКаталог(КаталогДляЗаявки_);
			КонецЕсли;	
				
			ФайлДСП = КаталогДляЗаявки_+"\"+ВыборкаФайлы.ФайлИмя; 		
			ФайлХ = Новый Файл(ФайлДСП);
			Если ФайлХ.Существует() = Ложь Тогда
				ИмяВХранилище = ""+ВыборкаФайлы.ХранилищеПуть+"\"+ВыборкаФайлы.ПутьКПапке+"\"+ВыборкаФайлы.ФайлИмя;
				ФайлХ = Новый Файл(ИмяВХранилище);
				Если ФайлХ.Существует() = Истина Тогда
					Попытка
						КопироватьФайл(ИмяВХранилище,ФайлДСП);
					Исключение
						Ошибки = Ошибки+ ОписаниеОшибки()+Символы.ПС;
					КонецПопытки;	
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
		Если ПустаяСтрока(Ошибки) Тогда
			возврат Истина;
		Иначе
			Возврат Ошибки;
		КонецЕсли;	
	КонецФункции	
	
