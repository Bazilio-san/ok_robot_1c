Функция ВыгрузитьФайлыПоЗаявке(Заявка,пользователь) Экспорт
    УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СписокФайлов.Ссылка.Номер КАК Номер,
	               |	СписокФайлов.Ссылка.НомерЗаявки КАК НомерЗаявки,
	               |	СписокФайлов.Ссылка.Страхователь КАК Страхователь,
	               |	БСО.ВидБСО,
	               |	СписокФайлов.СсылкаСправочника,
	               |	СписокФайлов.УидСтроки,
	               |	уб_ФайлыКПолисам.ФайлИмя,
	               |	уб_ФайлыКПолисам.ПутьКПапке,
	               |	уб_ФайлыКПолисам.Хранилище.Путь КАК путь
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК СписокФайлов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	               |		ПО (уб_ФайлыКПолисам.УИД = СписокФайлов.СсылкаСправочника)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК БСО
	               |		ПО (БСО.УидСтроки = СписокФайлов.УидСтроки)
	               |ГДЕ
	               |	СписокФайлов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Заявка);	
	Выборка = Запрос.Выполнить().Выбрать();
	Всего = Выборка.Количество();
	//Директория ="D:\!1C\_выгрузка\";
	Директория = Пользователь.ПутьКОбщейПапке;
	Если ПустаяСтрока(Директория)  Тогда
		Сообщить("Не задан путь для сохранения у пользователя, обратитесь к администратору");
		Возврат 0;
	ИначеЕсли СуществуетФайл(Директория)  = Ложь Тогда	
		Сообщить("Отсутствует папка пользователя "+Директория +" или нет прав");
		Возврат 0;
	КонецЕсли;	
	Если Прав(Директория,1)<>"\" тогда
		Директория = Директория+"\";
	КонецЕсли;	
	Счетчик = 0;
	Суффикс ="";
	МассивСозданныхФайлов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик+1;
		#Если Клиент Тогда
			Состояние(""+Окр(100*Счетчик/Всего,2)+"%");
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
		//Старый путь
		ИмяФайла1 = Выборка.Путь+"\"+Выборка.ПутьКПапке+"\"+Выборка.ФайлИмя;
		//Если Суффикс = "" Тогда
			Суффикс =Формат(Выборка.Номер,"ЧГ=")+" - "+ уб_temp.УбратьСимволы(Выборка.Страхователь)+"\"+уб_temp.УбратьСимволы(Строка(Выборка.ВидБСО));
		//КонецЕсли;	
		СоздатьКаталог(Директория+Суффикс);
		//Новый путь
		ИмяФайла2 = Директория+Суффикс+"\"+Выборка.ФайлИмя;
		
		
		Если СуществуетФайл(ИмяФайла1) Тогда
			КопироватьФайл(ИмяФайла1,ИмяФайла2);
			МассивСозданныхФайлов.Добавить(ИмяФайла2);
		КонецЕсли;	
	КонецЦикла;
	Текст = Новый ТекстовыйДокумент();
	ИмяФайла = "D:\!1C\_выгрузка\CписокФайлов.txt";
	Если СуществуетФайл(ИмяФайла) Тогда
		Текст.Прочитать(ИмяФайла);
	КонецЕсли;	
	Для каждого Строка из МассивСозданныхФайлов Цикл
		Текст.ДобавитьСтроку(Строка);
	КонецЦикла;	
	Текст.Записать(ИмяФайла);
	Возврат Счетчик;
КонецФункции	

