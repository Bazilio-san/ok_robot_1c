//Произошла исключительная ситуация (WIA.ImageProcess.1): Неопознанная ошибка
Функция ВозможнаПостобработкаИзображенияПоРасширению(Знач Расширение) Экспорт

	Расширение = СокрЛП(НРег(Расширение));
	Если Лев(Расширение, 1) = "." Тогда
		Расширение = Сред(Расширение, 2);
	КонецЕсли;
	// проверяем на запрещенные
	МассивЗапрещенных = Новый Массив;
	МассивЗапрещенных.Добавить("ico");
	МассивЗапрещенных.Добавить("wmf");
	МассивЗапрещенных.Добавить("emf");
	Если МассивЗапрещенных.Найти(Расширение) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// проверяем на разрешенные
	МассивРазрешенных = Новый Массив;
	МассивРазрешенных.Добавить("bmp");
	МассивРазрешенных.Добавить("dib");
	МассивРазрешенных.Добавить("rle");
	МассивРазрешенных.Добавить("jpg");
	МассивРазрешенных.Добавить("jpeg");
	МассивРазрешенных.Добавить("jfif");
	МассивРазрешенных.Добавить("tif");
	МассивРазрешенных.Добавить("gif");
	МассивРазрешенных.Добавить("png");
	Если МассивРазрешенных.Найти(Расширение) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции // ВозможнаПостобработкаИзображенияПоРасширению()

Функция ОбработатьОчередь(Объект,ТипОчереди,Предупредить = Ложь) Экспорт
	Если ТипОчереди = Перечисления.уб_ТипыОчереди.Файлы Тогда
		Если уб_МодульРегламентныхЗаданий.ВыполнитьКонвертациюФайла(Объект) Тогда
			Модифицированность = Ложь;
			//Закрыть();
			#Если Клиент Тогда
			Если Предупредить Тогда
				Оповестить("ОбновитьФормуСпискаРегистраСведенийОчередь");
				Предупреждение("Конвертация файлов выполнена ["+Объект+"]", 2);
			КонецЕсли;	
		#КонецЕсли
		Возврат Истина;
		Иначе
			#Если Клиент Тогда
				Если Предупредить Тогда
					Предупреждение("Конвертация файлов не выполнена ["+Объект+"]");
				КонецЕсли;	
			#КонецЕсли
		КонецЕсли;
	Иначе
		уб_МодульРегламентныхЗаданий.уб_ОбработкаОчереди();
		#Если Клиент Тогда
			Оповестить("ОбновитьФормуСпискаРегистраСведенийОчередь");
		#КонецЕсли
	
		
	КонецЕсли;
КонецФункции	

