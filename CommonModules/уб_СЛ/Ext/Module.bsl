// Получает список страховых компаний, по заданной в константе группе СК
//
// Параметры
//  нет
//
// Возвращаемое значение
//  Список значений
//
Функция ПолучитьСписокСК(ДобавлятьТоп = 0, ПоказыватьНеактивные = Ложь) Экспорт 
	
	СписокСК = Новый СписокЗначений;
	Запрос = Новый Запрос;	
	Если ДобавлятьТоп > 0 Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Д.СК КАК Ссылка,
		|	Д.СК.Наименование КАК Наименование,
		|	КОЛИЧЕСТВО(*) КАК КОЛ
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО КАК Д
		|ГДЕ
		|	Д.Регистратор ССЫЛКА Документ.уб_СтраховойПолис
		|	И Д.Период МЕЖДУ &ДатаН И &ДатаК
		|	И Д.СК <> &СобственныйКонтрагент
		|	И НЕ Д.СК.ПометкаУдаления
		|	И НЕ Д.СК = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Д.СК,
		|	Д.СК.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	КОЛ УБЫВ";
	    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 1", "ПЕРВЫЕ " + ДобавлятьТоп);
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаН", 					ТекущаяДата() - 60 * 60 * 24 * 30);
		Запрос.УстановитьПараметр("ДатаК", 					ТекущаяДата());
		Запрос.УстановитьПараметр("СобственныйКонтрагент", 	ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокСК.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
		СписокСК.Добавить(Справочники.Контрагенты.ПустаяСсылка(), "===================");
	КонецЕсли;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование,
	|	К.ЭтоГруппа
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Родитель = &РодительСсылка
	|	И НЕ К.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";                          
	Запрос.УстановитьПараметр("РодительСсылка", ПараметрыСеанса.уб_Константы.уб_ГруппаСК);
	Выборка = Запрос.Выполнить().Выбрать();
	ГруппаНеАктивных = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ЭтоГруппа Тогда
			СписокСК.Добавить(Выборка.Ссылка, Выборка.Наименование);
		Иначе
			Если Выборка.Наименование = "НЕ АКТИВНЫЕ" Тогда
				ГруппаНеАктивных = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ПоказыватьНеактивные И ГруппаНеАктивных <> Неопределено Тогда
		СписокСК.Добавить(Справочники.Контрагенты.ПустаяСсылка(), "===== НЕ АКТИВНЫЕ ====");
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	К.Ссылка КАК Ссылка,
		|	К.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Родитель.Ссылка = &РодительСсылка
		|	И НЕ К.ЭтоГруппа
		|	И НЕ К.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
		Запрос.УстановитьПараметр("РодительСсылка", ГруппаНеАктивных);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокСК.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;
	Возврат СписокСК;
	
КонецФункции

Функция ПолучитьСписокОрганизаций() Экспорт 
	
	СписокСК = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст= "ВЫБРАТЬ
	              |	Организации.Ссылка
	              |ИЗ
	              |	Справочник.Организации КАК Организации
	              |ГДЕ
	              |	Организации.ПометкаУдаления = ЛОЖЬ
	              |	И (Организации.ДатаОкончанияДействия > &Дата
	              |			ИЛИ Организации.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Организации.Наименование";
	Запрос.УстановитьПараметр("Дата",ТекущаяДата());
	СписокСК.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат СписокСК;
	
КонецФункции



Функция ДайВыборкуДоговоровДляПоставщика(Поставщик
	, ОрганизацияАгент = 0
	, НаДату = Неопределено
	, ВключаяНеДействующиеОрганизации = Ложь
	, ВключаяНеДействующиеДоговора = Ложь
	, Предупреждать = Истина
	, Различные = Ложь
	) Экспорт 
	
	Если  НаДату = Неопределено Тогда
		НаДАту = ТекущаяДата();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ДоговорПриоритет = "";
	Упорядочить = "";
	Если НЕ Различные Тогда
		ДоговорПриоритет = " ДК.Ссылка КАК Договор,
	             |	ВЫБОР
	             |		КОГДА ДК.Ссылка = ДК.Владелец.ОсновнойДоговорКонтрагента
	             |			ТОГДА 1
	             |		ИНАЧЕ 0
	             |	КОНЕЦ КАК Приоритет,";
		Упорядочить = " УПОРЯДОЧИТЬ ПО
	               |	Приоритет УБЫВ,
	               |	ДК.ДатаЗаключенияДоговора УБЫВ,
	               |	ДК.ДатаОкончанияДействияДоговора";		 
	КонецЕсли;			   
		
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ " + ДоговорПриоритет +"
				   //|	ДК.Ссылка КАК Договор,
				   //|	ВЫБОР
				   //|		КОГДА ДК.Ссылка = ДК.Владелец.ОсновнойДоговорКонтрагента
				   //|			ТОГДА 1
				   //|		ИНАЧЕ 0
				   //|	КОНЕЦ КАК Приоритет,
				   |    ДК.Владелец как Контрагент,
	               |	ДК.Организация.Наименование КАК НаименованиеОрганизации,
	               |	ДК.Организация
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДК
	               |ГДЕ
	               |	(ДК.Владелец = &Поставщик ИЛИ ДК.Владелец.ГоловнойКонтрагент = &Поставщик)   //TODO Добавить вложенность
				   |	И (&ОрганизацияАгент=0 ИЛИ ДК.Организация = &ОрганизацияАгент)
				   |	И Не ДК.ПометкаУдаления
				   |	И ДК.ДатаЗаключенияДоговора <= &НаДату
	               |	И (ДК.ДатаОкончанияДействияДоговора >= &НаДату
	               |			ИЛИ ДК.ДатаОкончанияДействияДоговора ЕСТЬ NULL 
	               |			ИЛИ ДК.ДатаОкончанияДействияДоговора = &НульДАта
	               |			ИЛИ &ВключаяНеДействующиеДоговора)
	               |	И ((ДК.Организация.ДатаРегистрации <= &НаДату
	               |				ИЛИ ДК.Организация.ДатаРегистрации = &НульДАта
	               |				ИЛИ ДК.Организация.ДатаРегистрации ЕСТЬ NULL )
	               |				И (ДК.Организация.ДатаОкончанияДействия >= &НаДату
	               |					ИЛИ ДК.Организация.ДатаОкончанияДействия = &НульДАта
	               |					ИЛИ ДК.Организация.ДатаОкончанияДействия ЕСТЬ NULL )
	               |			ИЛИ &ВключаяНеДействующиеОрганизации) 
	               |" + Упорядочить;
				   //|УПОРЯДОЧИТЬ ПО
				   //|	Приоритет УБЫВ,
				   //|	ДК.ДатаЗаключенияДоговора УБЫВ,
				   //|	ДК.ДатаОкончанияДействияДоговора";
	
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("ОрганизацияАгент", ОрганизацияАгент);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("НульДАта", Дата("00010101000000"));
	Запрос.УстановитьПараметр("ВключаяНеДействующиеОрганизации", ВключаяНеДействующиеОрганизации);
	Запрос.УстановитьПараметр("ВключаяНеДействующиеДоговора", ВключаяНеДействующиеДоговора);

	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	#Если Клиент Тогда
		Попытка
			Если Выборка.Количество() = 0 и Предупреждать  Тогда
				Фрм = Поставщик.ПолучитьФорму();
				Если Предупреждать И НЕ Фрм.Открыта() Тогда
					Заг = "Необходимо указать данные договора!";
					СОО = "Не найден действующий договор с действующей организацией для поставщика " + Строка(Поставщик) + " на дату: " + НаДату + "
					|
					|Зайдите в справочник Контрагентов и внесите данные договора!
					|(дополнительно проверьте, не окончилось ли действие организации, с которой заключен договор)
					|
					|Открыть форму Контрагента-Поставщика для внесения изменений?";
					
					Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
					Если Ответ = КодВозвратаДиалога.Да Тогда
						Фрм.ЭлементыФормы.Панель.ТекущаяСтраница = Фрм.ЭлементыФормы.Панель.Страницы.СчетаИДоговоры;	
						Фрм.ОткрытьМодально();
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		Исключение
			//внешнее задание?
		КонецПопытки;
	#КонецЕсли		
	Возврат Выборка;
КонецФункции

// Получает список Организаций, действующих на дату
Функция ДайСписокОрганизаций(НаДату = Неопределено, Поставщик = Неопределено, ЕдинственнаяОрганизация = Неопределено, Предупреждать = Истина) Экспорт 
	Если ЗначениеНеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	СписокОрганизаций = Новый СписокЗначений;
	Если ЗначениеНеЗаполнено(Поставщик) Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	О.Ссылка,
		               |	О.Наименование
		               |ИЗ
		               |	Справочник.Организации КАК О
		               |ГДЕ
		               |	(О.ДатаРегистрации <= &НаДату
		               |			ИЛИ О.ДатаРегистрации = &Пусто
		               |			ИЛИ О.ДатаРегистрации ЕСТЬ NULL )
		               |	И (О.ДатаОкончанияДействия >= &НаДату
		               |			ИЛИ О.ДатаОкончанияДействия = &Пусто
		               |			ИЛИ О.ДатаОкончанияДействия ЕСТЬ NULL )";
							  
		Запрос.УстановитьПараметр("НаДату", НаДату);
		Запрос.УстановитьПараметр("Пусто", Дата("00010101000000"));
		
		Рез = Запрос.Выполнить();
		Выборка = Рез.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокОрганизаций.Добавить(Выборка.Ссылка,Выборка.Наименование);
		КонецЦикла;
		Возврат СписокОрганизаций;
	КонецЕсли;
	
	ВключаяНеДействующиеОрганизации = Ложь;
	ВключаяНеДействующиеДоговора = Ложь;
	
	//предупреждаем об отсутствии договоров только отдел БСО
	Если Предупреждать Тогда
		Предупреждать = ПараметрыСеанса.уб_ОсновноеПодразделение = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО
	КонецЕсли;
	Выборка = ДайВыборкуДоговоровДляПоставщика(Поставщик, ,НаДату, ВключаяНеДействующиеОрганизации, ВключаяНеДействующиеДоговора, Предупреждать, Истина);
	
	Если Выборка.Количество() = 0 Тогда
		ВключаяНеДействующиеОрганизации = Истина;
		Выборка = ДайВыборкуДоговоровДляПоставщика(Поставщик, , НаДату, ВключаяНеДействующиеОрганизации, ВключаяНеДействующиеДоговора, Ложь, Истина);
	КонецЕсли;
	
	Если Выборка.Количество() = 0 Тогда
		ВключаяНеДействующиеДоговора = Истина;
		Выборка = ДайВыборкуДоговоровДляПоставщика(Поставщик, , НаДату, ВключаяНеДействующиеОрганизации, ВключаяНеДействующиеДоговора, Ложь, Истина);
	КонецЕсли;
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		СписокОрганизаций.Добавить(Выборка.Организация,Выборка.НаименованиеОрганизации);
		ЕдинственнаяОрганизация = Выборка.Организация;
	ИначеЕсли Выборка.Количество() > 1 Тогда
		
		Пока Выборка.Следующий() Цикл
			СписокОрганизаций.Добавить(Выборка.Организация,Выборка.НаименованиеОрганизации);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокОрганизаций;
КонецФункции

Функция ПолучитьСписокВидовБСО(СК, НаДату = Неопределено, ДобавлятьТоп = 0, ТолькоПолисы = Ложь, ИсключатьНедействующие = Ложь) Экспорт 
	
	
	//НаДату - будет использоваться, когда введется параметр окончания действия БСО
	Если ЗначениеНеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	ОграничениеПоТипу = "";	
	ОграничениеПоТипу2 = "";	
	Если ТолькоПолисы Тогда
		СписокТиповПолисов = Новый СписокЗначений;
		СписокТиповПолисов.Добавить(Перечисления.уб_ТипыБСО.Полис);
		СписокТиповПолисов.Добавить(Перечисления.уб_ТипыБСО.ПолисОсаго);
		ОграничениеПоТипу = " И Д.ВидБСО.Тип В (&СписокТиповПолисов) ";	
		ОграничениеПоТипу2 = " И Т.Тип В (&СписокТиповПолисов) ";	
	КонецЕсли;
	
	ОграничениеДействия = "";
	Если ИсключатьНедействующие Тогда
	    ОграничениеДействия = " И (Т.ДатаОкончанияДействия = &ПустаяДата
	               |			ИЛИ Т.ДатаОкончанияДействия >= &ТекущаяДата) "
	КонецЕсли; 
	
	СписокВидовБСО = Новый СписокЗначений;
	
	Если СК.ВидыСп.Количество()>0 Тогда
		
		Для каждого СтрокаВида из СК.ВидыСп Цикл
			СписокВидовБСО.Добавить(СтрокаВида.ВидСП);
		КонецЦикла;	
		Возврат СписокВидовБСО;
	КонецЕсли;	
	
	Если ДобавлятьТоп > 0 Тогда
		Запрос = Новый Запрос;    
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + ДобавлятьТоп + "
		               |	Д.ВидБСО КАК Ссылка,
		               |	Д.ВидБСО.Наименование КАК Наименование,
		               |	КОЛИЧЕСТВО(*) КАК КОЛ
		               |ИЗ
		               |	РегистрСведений.уб_ДвиженияБСО КАК Д
		               |ГДЕ
		              // |	Д.ВидБСО.Владелец = &СК
					   |	Д.СК = &СК
		               |	И Д.СК <> &СобственныйКонтрагент
					   |	И Д.Регистратор ССЫЛКА Документ.уб_СтраховойПолис
		               |	И Д.Период МЕЖДУ &ДатаН И &ДатаК" + ОграничениеПоТипу + "
					   |СГРУППИРОВАТЬ ПО
		               |	Д.ВидБСО,
		               |	Д.ВидБСО.Наименование
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	КОЛ УБЫВ";
	                          
		Запрос.УстановитьПараметр("СК", СК);
		Запрос.УстановитьПараметр("ДатаН", ТекущаяДата() - 60*60*24*30);
		Запрос.УстановитьПараметр("ДатаК", ТекущаяДата());
		Запрос.УстановитьПараметр("СобственныйКонтрагент", ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент);
		Если ТолькоПолисы Тогда
			Запрос.УстановитьПараметр("СписокТиповПолисов", СписокТиповПолисов);
		КонецЕсли;
		
		
		Рез = Запрос.Выполнить();
		Выборка = Рез.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокВидовБСО.Добавить(Выборка.Ссылка,Выборка.Наименование);
		КонецЦикла;
		Если СписокВидовБСО.Количество() > 0 Тогда
			СписокВидовБСО.Добавить(Справочники.уб_ВидыБСО.ПустаяСсылка(),"===================");
		КонецЕсли;
	КонецЕсли;
	
	Для каждого Значение из Метаданные.Перечисления.уб_ВидыСтраховыхПродуктов.ЗначенияПеречисления Цикл
		НовоеЗначение = Перечисления.уб_ВидыСтраховыхПродуктов[Значение.Имя];
		Если СписокВидовБСО.НайтиПоЗначению(НовоеЗначение) = Неопределено Тогда
			СписокВидовБСО.Добавить(НовоеЗначение);
		КонецЕсли;	
	КонецЦикла;	
	Возврат СписокВидовБСО;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Т.Ссылка КАК Ссылка,
	               |	Т.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.уб_ВидыБСО КАК Т
	               |ГДЕ
	               |	Т.Владелец = &СК
	               |	И Т.ПометкаУдаления = ЛОЖЬ
	               |	               " + ОграничениеДействия + ОграничениеПоТипу2+" 
				   |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Запрос.УстановитьПараметр("СК", СК);
	Если ИсключатьНедействующие Тогда
	    Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
		Запрос.УстановитьПараметр("ТекущаяДата", НаДату);
	КонецЕсли; 
	Если ТолькоПолисы Тогда
		Запрос.УстановитьПараметр("СписокТиповПолисов", СписокТиповПолисов);
	КонецЕсли;
	Рез = Запрос.Выполнить();
	Выборка = Рез.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВидовБСО.Добавить(Выборка.Ссылка,Выборка.Наименование);
	КонецЦикла;
	Возврат СписокВидовБСО;
КонецФункции

Функция ПолучитьСписокСтрахПродуктов(СК, НаДату = Неопределено, ДопустимыйВидБСО = Неопределено, ИсключатьНедействующие = Истина) Экспорт 
	
	Возврат ПолучитьСписокВидовБСО(СК,НаДату);
	Если ЗначениеНеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СП.Ссылка
	               |ИЗ
	               |	Справочник.уб_СтраховыеПродукты КАК СП
	               |ГДЕ
	               |	СП.Владелец.Ссылка = &СК и ПометкаУдаления = ЛОЖЬ ";
	
	Запрос.УстановитьПараметр("СК", СК);
	
	Если ИсключатьНедействующие Тогда
	    ТекстЗапроса = ТекстЗапроса + " И (СП.ДатаОкончанияДействия = &ПустаяДата
	               |			ИЛИ СП.ДатаОкончанияДействия >= &ТекущаяДата) ";
		Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
		Запрос.УстановитьПараметр("ТекущаяДата", НаДату);
	КонецЕсли;
	
	Если НЕ ЗначениеНеЗаполнено(ДопустимыйВидБСО) Тогда
	    ТекстЗапроса = ТекстЗапроса + " И (СП.ВидыБСО.ВидБСО = &ДопустимыйВидБСО или СП.Наименование =&Наименование)";
		Запрос.УстановитьПараметр("ДопустимыйВидБСО", ДопустимыйВидБСО);
		Запрос.УстановитьПараметр("Наименование", ""+ДопустимыйВидБСО);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	СЗ = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СЗ.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат СЗ;
КонецФункции

