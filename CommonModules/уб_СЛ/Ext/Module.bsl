Функция ВывестиСтатистику(ПолеТД = Неопределено) Экспорт
	Если ПолеТД = Неопределено Тогда
		ПолеТД = Новый ТабличныйДокумент;
	КонецЕсли;	
	ДанныеРасшифровки = Неопределено;
	ПолеТД.Очистить();
	Отчет = Отчеты.уб_ПремииЗаПериод.Создать();
	СхемаКомпоновкиДанных = Отчет.СхемаКомпоновкиДанных;
	//Вариант = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("По формам оплаты");
	Вариант = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("Статистика кассы");
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Вариант.Настройки);
	Настройка = Отчет.КомпоновщикНастроек.Настройки;
	//Для каждого Параметр из Настройка.ПараметрыВывода.Элементы Цикл
	//	Если Строка(Параметр.Параметр) = "ВыводитьЗаголовок" или
	//		Строка(Параметр.Параметр) = "Выводитьзаголовок"
	//		Тогда
	//		Параметр.Использование = Ложь;
	//		Прервать;
	//	КонецЕсли;	
	//КонецЦикла;	
	Для каждого  Элемент из Настройка.ПараметрыВывода.Элементы Цикл
		Если Строка(Элемент.Параметр) = "ВыводитьЗаголовок"  Тогда
			Элемент.Использование = Истина;
			Элемент.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
			//Элемент.Использование = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		ИначеЕсли Строка(Элемент.Параметр) ="ВыводитьПараметрыДанных" Тогда
			Элемент.Использование = Истина;
			Элемент.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		ИначеЕсли Строка(Элемент.Параметр) ="ВыводитьОтбор" Тогда
			Элемент.Использование = Истина;
			Элемент.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		КонецЕсли;	
	КонецЦикла;	
	
	Параметр = Настройка.ПараметрыДанных.Элементы.Найти("ДатаНач");
	Параметр.Значение = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(),-6));
	Параметр = Настройка.ПараметрыДанных.Элементы.Найти("ДатаКон");
	Параметр.Значение = КонецМесяца(ТекущаяДата());
	
	//
	Менеджер = Параметрысеанса.уб_ТекущееФизЛицо;
	//Менеджер = Справочники.ФизическиеЛица.НайтиПоНаименованию("Слученков Дмитрий",Истина);
	
		ЭлементОтбора = Настройка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Ссылка.Агент");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование 	= Истина;
		//ЭлементОтбора.ПравоеЗначение 	= Справочники.ФизическиеЛица.ПустаяСсылка();
		ЭлементОтбора.Представление		= Менеджер;
		ЭлементОтбора.ПравоеЗначение	= Менеджер;

	Отчет.СкомпоноватьРезультат(ПолеТД,ДанныеРасшифровки);
    Возврат ПолеТД;
КонецФункции
