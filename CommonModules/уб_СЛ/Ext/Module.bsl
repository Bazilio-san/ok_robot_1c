Функция СконвертироватьОдинФайл(ПолноеИмяФайла) Экспорт
	
	
	
	ТЗКартинок = Новый ТаблицаЗначений;
	ТЗКартинок.Колонки.Добавить("Картинка", 	уб_temp.СозданиеОписанияТиповПоТипу(Тип("Картинка")));
	ТЗКартинок.Колонки.Добавить("Расширение",	Новый ОписаниеТипов("Строка"));
	ТЗКартинок.Колонки.Добавить("ПолноеИмяВходящегоФайла",	Новый ОписаниеТипов("Строка"));
	
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьКонвертациюФайлов<>Истина Тогда
		СтрокаТЗ = ТЗКартинок.Добавить();
		
		Если  ВозможнаПостобработкаИзображенияПоРасширению(уб_СЛ.ОпределитьРасширениеФайла(ПолноеИмяФайла)) Тогда
			Попытка
				СтрокаТЗ.Картинка	= Новый Картинка(ПолноеИмяФайла);	
			Исключение
				СтрокаТЗ.Картинка = Новый Картинка;
			КонецПопытки;
		Иначе
			СтрокаТЗ.Картинка = Новый Картинка;
		КонецЕсли;	
		Возврат  ТЗКартинок;
	КонецЕсли;	
	
	Параметры = уб_СЛ.ВызовКонвертацииКлиент(ПолноеИмяФайла, , ЛОЖЬ);
	
	
	
	ТаблицаФайлов = Параметры.ТаблицаФайлов;
	Для Каждого СтрТЗ Из ТаблицаФайлов цикл
		Если СтрТЗ.ТребуетсяКонвертация тогда
			МассивФайлов = СтрТЗ.МассивКонвертации;
			Для Каждого ЭлементМассива Из МассивФайлов Цикл
				СтрокаТЗ = ТЗКартинок.Добавить();
				СтрокаТЗ.Картинка	= Новый Картинка(ЭлементМассива);
				СтрокаТЗ.Расширение	= Параметры.РасширениеКартинки;
				СтрокаТЗ.ПолноеИмяВходящегоФайла = ЭлементМассива;
			КонецЦикла;
		Иначе
			СтрокаТЗ = ТЗКартинок.Добавить();
			Попытка
				СтрокаТЗ.Картинка	= Новый Картинка(СтрТЗ.ПолноеИмяВходящегоФайла);	
			Исключение
				СтрокаТЗ.Картинка = Новый Картинка;
			КонецПопытки;
			
			Если СтрТЗ.РасширениеКартинки = "" Тогда 
				СтрокаТЗ.Расширение = уб_СЛ.ОпределитьРасширениеФайла(СтрТЗ.ПолноеИмяВходящегоФайла);
			Иначе 
				СтрокаТЗ.Расширение	= СтрТЗ.РасширениеКартинки;
			КонецЕсли;
			СтрокаТЗ.ПолноеИмяВходящегоФайла = СтрТЗ.ПолноеИмяВходящегоФайла;
		КонецЕсли;
	КонецЦикла;
	Возврат  ТЗКартинок;
КонецФункции

	


