// Определяет, Является ли БСО - полисом
//
// Параметры
//  ВидБСО - ссылка на элемент справочника ВидыБСО
//
// Возвращаемое значение
//  Истина - БСО является полисом, Ложь - нет
//
Функция ОпределитьЭтоПолис(ВидБСО,Тип = Неопределено) Экспорт     //TODO Проверить, где вызывается , если возможно задействовать 2 параметр
	
	Если ВидБСО <> Неопределено Тогда
		П = Перечисления.уб_ТипыБСО;	
		Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
			Т = П.Полис;
		Иначе	
			Т = ?(Тип = Неопределено, ВидБСО.Тип, Тип);
		КонецЕсли;	
		
		Если 
			Т = П.Полис
			Или Т = П.ПолисОсаго
			Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

