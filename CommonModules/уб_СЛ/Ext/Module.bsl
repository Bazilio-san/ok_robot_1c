		КонецЕсли;	
		Если ЗначениеЗаполнено(СтруктураБСО.ОрганизацияАгент) Тогда
			//СтруктураОтбора.Вставить("ОрганизацияАгент", СтруктураБСО.ОрганизацияАгент);
			Запрос.УстановитьПараметр("ОрганизацияАгент",СтруктураБСО.ОрганизацияАгент);
		Иначе
			Запрос.УстановитьПараметр("ОрганизацияАгент",Неопределено);
		КонецЕсли;	
		
		//тзРег = РегистрыСведений.уб_ДвиженияБСО.СрезПоследних(СтруктураБСО.Период, СтруктураОтбора);
		НеИспользоватьБлокировкиБСО = ПараметрыСеанса.уб_Константы.уб_НеИспользоватьБлокировкиБСО = Истина;
		Запрос.Текст = "ВЫБРАТЬ
		|	уб_ДвиженияБСОСрезПоследних.*,
		|	ВЫБОР
		|		КОГДА &НеИспользоватьБлокировкиБСО = ИСТИНА
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ)
		|	КОНЕЦ КАК Блокировка,
		|	уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип как Тип,
		|	уб_ДвиженияБСОСрезПоследних.Агент.Представление как АгентПредставление,
		|	уб_ДвиженияБСОСрезПоследних.ВидБСО.ТипУчетаБСО как ТипУчетаБСО
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
		|			&НаМомент,
		|			ВидБСО = &ВидБСО
		|				И НомерБСО = &НомерБСО
		|				И СК = &СК
		|				И Подтверждено = &Подтверждено
		//|				И ВЫБОР
		//|					КОГДА &Поставщик = НЕОПРЕДЕЛЕНО
		//|						ТОГДА ИСТИНА
		//|					ИНАЧЕ Поставщик = &Поставщик
		//|				КОНЕЦ
		//|				И ВЫБОР
		//|					КОГДА &ОрганизацияАгент = НЕОПРЕДЕЛЕНО
		//|						ТОГДА ИСТИНА
		//|					ИНАЧЕ ОрганизацияАгент = &ОрганизацияАгент
		//|				КОНЕЦ
		|				) КАК уб_ДвиженияБСОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних(
		|				&НаМомент,
		|				ВидБСО = &ВидБСО
		|					И СК = &СК
		|					И НомерБСО = &НомерБСО) КАК уб_БлокировкаБСОСрезПоследних
		|		ПО уб_ДвиженияБСОСрезПоследних.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
		|			И уб_ДвиженияБСОСрезПоследних.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО
		|			И уб_ДвиженияБСОСрезПоследних.СК = уб_БлокировкаБСОСрезПоследних.СК
		|ГДЕ 
		|				ВЫБОР
		|					КОГДА &Поставщик = НЕОПРЕДЕЛЕНО
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ уб_ДвиженияБСОСрезПоследних.Поставщик = &Поставщик
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &ОрганизацияАгент = НЕОПРЕДЕЛЕНО
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент = &ОрганизацияАгент
		|				КОНЕЦ";
		
		Запрос.УстановитьПараметр("СК",СтруктураБСО.СК);
		Запрос.УстановитьПараметр("ВидБСО",СтруктураБСО.ВидБСО);
		Запрос.УстановитьПараметр("НомерБСО",СтруктураБСО.НомерБСО);
		Запрос.УстановитьПараметр("Подтверждено",Истина);
		//Запрос.УстановитьПараметр("ДокПроведен",Истина);
		Запрос.УстановитьПараметр("НаМомент",СтруктураБСО.Период);
		Запрос.УстановитьПараметр("НеИспользоватьБлокировкиБСО",НеИспользоватьБлокировкиБСО);
		тзРег = Запрос.Выполнить().Выгрузить();
		
		Если тзРег.Количество() < 1 Тогда
			СтруктураБСО.Существует = Ложь;
		Иначе
			тз = тзРег[0];
			ЗаполнитьЗначенияСвойств(СтруктураБСО,тз);
			СтруктураБСО.Существует = Истина;
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Если СтруктураБСО.Период = Неопределено Тогда
			СтруктураБСО.Период = Новый Граница(ТекущаяДата(), ВидГраницы.Исключая);
		КонецЕсли;							  
		Запрос.УстановитьПараметр("Период",		СтруктураБСО.Период);
		Запрос.УстановитьПараметр("СК",			СтруктураБСО.СК);
		Запрос.УстановитьПараметр("ВидБСО",		СтруктураБСО.ВидБСО);
		Запрос.УстановитьПараметр("НомерБСО",	СокрЛП(СтруктураБСО.НомерБСО));
		УсловиеГДЕ = "ИСТИНА";
		Если ЗначениеЗаполнено(СтруктураБСО.Поставщик) Тогда
			Запрос.УстановитьПараметр("Поставщик",СтруктураБСО.Поставщик);
			УсловиеГДЕ = УсловиеГДЕ + " И Поставщик = &Поставщик";
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтруктураБСО.ОрганизацияАгент) Тогда
			Запрос.УстановитьПараметр("ОрганизацияАгент", СтруктураБСО.ОрганизацияАгент);
			УсловиеГДЕ = УсловиеГДЕ + " И ОрганизацияАгент = &ОрганизацияАгент";
		КонецЕсли;	
		НеИспользоватьБлокировкиБСО = ПараметрыСеанса.уб_Константы.уб_НеИспользоватьБлокировкиБСО = Истина;
		Запрос.УстановитьПараметр("НеИспользоватьБлокировкиБСО", НеИспользоватьБлокировкиБСО);
		Текст = 
		"ВЫБРАТЬ
		|	Выбор Когда &НеИспользоватьБлокировкиБСО = Истина Тогда Ложь Иначе ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ) Конец КАК Блокировка,
		|	уб_ДвиженияБСОСрезПоследних.*,
		|	уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип КАК Тип,
		|	уб_ДвиженияБСОСрезПоследних.Агент.Представление КАК АгентПредставление,
		|	уб_ДвиженияБСОСрезПоследних.ВидБСО.ТипУчетаБСО КАК ТипУчетаБСО
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(&Период, (ВидБСО = &ВидБСО или ТИПЗНАЧЕНИЯ(&ВидБСО) = ТИП(Перечисление.уб_ВидыСтраховыхПродуктов)) И НомерБСО = &НомерБСО И СК = &СК И Подтверждено) КАК уб_ДвиженияБСОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних(
		|				&Период,
		|				(ВидБСО = &ВидБСО или ТИПЗНАЧЕНИЯ(&ВидБСО) = ТИП(Перечисление.уб_ВидыСтраховыхПродуктов))
		|					И СК = &СК
		|					И НомерБСО = &НомерБСО) КАК уб_БлокировкаБСОСрезПоследних
		|		ПО уб_ДвиженияБСОСрезПоследних.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
		|			И уб_ДвиженияБСОСрезПоследних.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО
		|			И уб_ДвиженияБСОСрезПоследних.СК = уб_БлокировкаБСОСрезПоследних.СК
		|ГДЕ &УсловиеГде
		|УПОРЯДОЧИТЬ ПО
		|	уб_ДвиженияБСОСрезПоследних.Период УБЫВ";	
		Текст = СтрЗаменить(Текст, "&УсловиеГде", УсловиеГДЕ);
		Запрос.Текст = Текст;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураБСО, Выборка);
			СтруктураБСО.Существует = Истина;
		Иначе
			СтруктураБСО.Существует = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

// Получает остатки количественных БСО по структуре
//
// Параметры
//  СтруктураОтбора - структура
//
// Возвращаемое значение
//  Таблица значений
//
Функция ПолучитьОстаткиБСО(СтруктураБСО) Экспорт  
	
	тПоставщик = СтруктураБСО.Поставщик;
	тОрганизацияАгент = СтруктураБСО.ОрганизацияАгент;
	тСК = СтруктураБСО.СК;
	тВидБСО = СтруктураБСО.ВидБСО;
	тАгент = СтруктураБСО.Агент;	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ ";
	Если ЗначениеЗаполнено(тПоставщик) Тогда
		ТекстЗапроса = ТекстЗапроса + " СП.Поставщик,";
		ТекстЗапроса = ТекстЗапроса + " СП.Поставщик.Представление Как ПоставщикПредставление,";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " NULL КАК Поставщик,";
		ТекстЗапроса = ТекстЗапроса + " NULL Как ПоставщикПредставление,";
	КонецЕсли;
	Если ЗначениеЗаполнено(тОрганизацияАгент) Тогда
		ТекстЗапроса = ТекстЗапроса + " СП.ОрганизацияАгент,";                
		ТекстЗапроса = ТекстЗапроса + " СП.ОрганизацияАгент.Представление Как ОрганизацияАгентПредставление,";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " NULL КАК ОрганизацияАгент,";
		ТекстЗапроса = ТекстЗапроса + " NULL КАК ОрганизацияАгентПредставление,";
	КонецЕсли;
	Если ЗначениеЗаполнено(тСК) Тогда
		ТекстЗапроса = ТекстЗапроса + " СП.СК,";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " NULL КАК СК,";
	КонецЕсли;
	Если ЗначениеЗаполнено(тВидБСО) Тогда
		ТекстЗапроса = ТекстЗапроса + " СП.ВидБСО,";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " NULL КАК ВидБСО,";
	КонецЕсли;
	Если ЗначениеЗаполнено(тАгент) Тогда
		ТекстЗапроса = ТекстЗапроса + " СП.Агент,";
		ТекстЗапроса = ТекстЗапроса + " СП.Агент.Представление Как АгентПредставление,";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " NULL КАК Агент,";
		ТекстЗапроса = ТекстЗапроса + " NULL КАК АгентПредставление,";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "	СП.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.уб_ОстаткиБСО.Остатки(&Период, ИСТИНА ";
	Запрос.УстановитьПараметр("Период", ?(СтруктураБСО.Период = Неопределено, ТекущаяДата(), СтруктураБСО.Период));
	Если ЗначениеЗаполнено(тПоставщик) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Поставщик = &Поставщик";
		Запрос.УстановитьПараметр("Поставщик", тПоставщик);
	КонецЕсли;
	Если ЗначениеЗаполнено(тОрганизацияАгент) Тогда
		ТекстЗапроса = ТекстЗапроса + " И ОрганизацияАгент = &ОрганизацияАгент";
		Запрос.УстановитьПараметр("ОрганизацияАгент", тОрганизацияАгент);
	КонецЕсли;
	Если ЗначениеЗаполнено(тСК) Тогда
		ТекстЗапроса = ТекстЗапроса + " И СК = &СК";
		Запрос.УстановитьПараметр("СК", тСК);
	КонецЕсли;
	Если ЗначениеЗаполнено(тВидБСО) Тогда
		ТекстЗапроса = ТекстЗапроса + " И ВидБСО = &ВидБСО";
		Запрос.УстановитьПараметр("ВидБСО", тВидБСО);
	КонецЕсли;
	Если ЗначениеЗАполнено(тАгент) Тогда
		ТекстЗапроса = ТекстЗапроса + "	И Агент = &Агент";
		Запрос.УстановитьПараметр("Агент", тАгент);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + " ) КАК СП";
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	тзРег = РезультатЗапроса.Выгрузить();
	Возврат тзРег;
	
КонецФункции//ПолучитьОстаткиБСО

Функция ДайНомерБСОДляКоличУчета(Номер) Экспорт
	
	Возврат "б/н " + ДайНомерПолисаБезПометкиАннулирования(Номер);
	
КонецФункции

Функция ДайНомерПолисаСУчетомСостояния(Знач Номер, СостояниеПолиса) Экспорт
	
	Номер = ДайНомерПолисаБезПометкиАннулирования(Номер);
	Возврат ?(Номер = "","",?(ПолисАннулирован(СостояниеПолиса),Номер + "'",Номер));
	
КонецФункции

Функция ПолисАннулирован(СостояниеПолиса) Экспорт
	
	Прч = Перечисления.уб_СостоянияПолиса;
	Возврат (СостояниеПолиса = Прч.АннулированВыписанНовый ИЛИ СостояниеПолиса = Прч.АннулированЗаменаБланка ИЛИ СостояниеПолиса = Прч.АннулированПолностью);
	
КонецФункции

Функция ПолисАннулированСЗаменой(СостояниеПолиса) Экспорт
	
	Прч = Перечисления.уб_СостоянияПолиса;
	Возврат (СостояниеПолиса = Прч.АннулированВыписанНовый ИЛИ СостояниеПолиса = Прч.АннулированЗаменаБланка);
	
КонецФункции

Функция СостояниеПолисаТребуетДатуАннулирования(СостояниеПолиса) Экспорт
	
	Прч = Перечисления.уб_СостоянияПолиса;
	Возврат (СостояниеПолиса = Прч.АннулированВыписанНовый 
	Или СостояниеПолиса = Прч.АннулированЗаменаБланка 
	Или СостояниеПолиса = Прч.АннулированПолностью
	Или СостояниеПолиса = Прч.ПрекращенДосрочно
	);
	
КонецФункции

Функция ДайНомерПолисаБезПометкиАннулирования(Номер) Экспорт
	
	Возврат СтрЗаменить(СокрЛП(Номер), "'", "");
	
КонецФункции

Функция ПолучитьСписокДопРасчетовСПоставщиком(ЭтоШтраф, СК) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДопРасчеты.Код,
	|	ДопРасчеты.Представление КАК Представление
	|ИЗ
	|	Справочник.уб_СтатьиДопРасчетовСПоставщиком КАК ДопРасчеты
	|ГДЕ
	|	ДопРасчеты.Владелец = &ВладелецСсылка
	|	И ДопРасчеты.ЭтоШтраф = &ЭтоШтраф
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДопРасчеты.Код
	|АВТОУПОРЯДОЧИВАНИЕ";                          
	Запрос.УстановитьПараметр("ВладелецСсылка", СК);
	Запрос.УстановитьПараметр("ЭтоШтраф", ЭтоШтраф);	
	СписокДопРасчетов = Новый СписокЗначений;	
	Рез = Запрос.Выполнить();
	Выборка = Рез.Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = Строка(Выборка.Код);
		Код = ?(Код = "","",Код);
		СписокДопРасчетов.Добавить(Код);
	КонецЦикла;
	Возврат СписокДопРасчетов;
	
КонецФункции

Функция ПоставщикПоИНН(ИНН, ОрганизацияАгент = 0) Экспорт
	
	Поставщик = ГоловнойКонтрагентПоИНН(ИНН);	
	ВыборкаДоговоры = уб_СЛ.ДайВыборкуДоговоровДляПоставщика(Поставщик,ОрганизацияАгент,, ЛОЖЬ, ЛОЖЬ, ЛОЖЬ, Истина);
	Пока ВыборкаДоговоры.Следующий() Цикл
		Если ВыборкаДоговоры.Количество()>1 Тогда
			Сообщить("Несколько действующих договоров для ОргАгента "+ОрганизацияАгент  + " поставщика "+Поставщик+" выбран Первый");
		КонецЕсли;	
		Поставщик = ВыборкаДоговоры.Контрагент;	
		Прервать;
	КонецЦикла;		
	Возврат Поставщик;
	
КонецФункции

Функция ГоловнойКонтрагентПоИНН(ИНН) Экспорт
	
	ФактИНН = СокрЛП(ИНН);		
	ПозСлеш = Найти(ФактИНН,"\");
	Если ПозСлеш > 0 Тогда
		ФактИНН = Лев(ФактИНН,ПозСлеш-1);
		ФактИНН = СокрП(ФактИНН);	
	Иначе	
		ПозСлеш = Найти(ФактИНН,"/");
		Если ПозСлеш > 0 Тогда
			ФактИНН = Лев(ФактИНН,ПозСлеш-1);
			ФактИНН = СокрП(ФактИНН);	
		КонецЕсли;	
	КонецЕсли;		
	Если ПустаяСтрока(ФактИНН) Тогда
		Возврат Справочники.Контрагенты.ПустаяСК;
	Иначе	
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.ГоловнойКонтрагент КАК Ссылка,
		|	Контрагенты.ГоловнойКонтрагент.КодБух
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ГоловнойКонтрагент = Контрагенты.Ссылка
		|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.ГоловнойКонтрагент.КодБух УБЫВ");
		Запрос.УстановитьПараметр("ИНН",ФактИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		колВыборка = Выборка.Количество();
		Если колВыборка = 0 Тогда
			Возврат Справочники.Контрагенты.ПустаяСК;
		Иначе
			#Если Клиент Тогда
				Если колВыборка>1 Тогда
					Сообщить("Несколько головных контрагентов с ИНН "+ФактИНН);
				КонецЕсли;	
			#КонецЕсли	
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции//ГоловнойКонтрагентПоИНН

Функция ПустаяСтруктураФильтров() Экспорт

	ОписаниеТипаБулево = ОбщегоНазначения.ПолучитьОписаниеТиповБулево();
	ТЗФильтров = Новый ТаблицаЗначений;
	//имя поля формы
	ТЗФильтров.Колонки.Добавить("ИмяПоля",			ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//данные поля формы
	ТЗФильтров.Колонки.Добавить("Данные",			ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//количество символов для начала обработки фильтра (только для быстрых фильтров)
	ТЗФильтров.Колонки.Добавить("ИндексЗапуска", 	ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(1));
	ТЗФильтров.Колонки.Добавить("ВидСравнения", 	ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(22));
	//в запрос передается параметр с %, также добавляется параметр переведенной строки
	ТЗФильтров.Колонки.Добавить("Подобно",			ОписаниеТипаБулево);
	//для предварительной обработки значения (например нужно в запросе проверять на число, а в быстром фильтре - строка)
	ТЗФильтров.Колонки.Добавить("ЧастныйКод",		ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(0));
	ТЗФильтров.Колонки.Добавить("ActiveX",			ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("ЕстьЗапрос", 		ОписаниеТипаБулево);
	//данный фильтр всегда обрабатывается независимо от заполнения
	ТЗФильтров.Колонки.Добавить("ЗаполненВсегда",	ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("ЕстьЧастныйКод",	ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("ЕстьУсловие",		ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("РазрешитьОтборПоЗначению0", ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("Состояние",		ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(20));
	ТЗФильтров.Колонки.Добавить("ВидЗначенияОтбора", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(10));
	//хранится немодифицированное значение поля
	ТЗФильтров.Колонки.Добавить("ИсхЗначение");
	//хранится модифицированное значение поля (меняющееся либо с помощью частного кода, либо СокрЛП дял строк
	ТЗФильтров.Колонки.Добавить("Значение");
	//
	ТЗФильтров.Колонки.Добавить("ЕстьСписокЗначений");
	ТЗФильтров.Колонки.Добавить("СписокЗначений");
	//в работе, пока не оптимизировано
	ТЗФильтров.Колонки.Добавить("ЕстьЧастныйЗапрос",ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("ЧастныйЗапрос");
	//данное поле не обрабатывается 
	ТЗФильтров.Колонки.Добавить("НеОбрабатывать",	ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("НеОбрабатыватьПоУсловию",	ОписаниеТипаБулево);
	ТЗФильтров.Колонки.Добавить("КодУсловия",	ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(1000));
	//
	ТЗФильтров.Колонки.Добавить("СтруктураДопНастроек");
	//
	//имя справочник для полнотекстового поиска
	ТЗФильтров.Колонки.Добавить("ИмяСправочника",	ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//имя списка значений в структуре настроек всплывающего списка
	ТЗФильтров.Колонки.Добавить("ИмяВСтруктуреПараметровВсплывающегоСписка", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//имя списка значений - владельцев в структуре настроек всплывающего списка
	ТЗФильтров.Колонки.Добавить("ИмяСпискаДляОтбораПоВладельцу", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//для ограничения вводимых в поле символов
	ТЗФильтров.Колонки.Добавить("ДопустимыеСимволы",			ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//для обработки события keydown, нажатие клавиши tab
	ТЗФильтров.Колонки.Добавить("ИмяСледующегоЭлементаВПорядкеОбхода",			ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	//для обработки события keydown, нажатие клавиш shift + tab
	ТЗФильтров.Колонки.Добавить("ИмяПредыдущегоЭлементаВПорядкеОбхода",			ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Запрос"));
	ТЗФильтров.Колонки.Добавить("Запрос", Новый ОписаниеТипов(Массив));
	// 
	СтруктураФильтров = Новый Структура;
	СтруктураФильтров.Вставить("ИмяСписка");
	СтруктураФильтров.Вставить("ТЗФильтров",    ТЗФильтров);
	СтруктураФильтров.Вставить("ФильтрПоВсем",	Истина);
	СтруктураФильтров.Вставить("СтруктураПараметровВсплывающегоСписка",	Неопределено);
	СтруктураФильтров.Вставить("ЭтоВставкаТекста", Ложь);
	СтруктураФильтров.Вставить("ВернутьФокусВПоле", Неопределено);
	
	//Имя поля, по которому нужно обновить отбор
	СтруктураФильтров.Вставить("АктуальноеИмяПоля",	Неопределено);
	
	//добавляем цвета фильтров в структуру
	
	Цвета = Новый Структура("ФонЗаполненногоФильтра, ФонНезаполненногоФильтра, СтраховкаНеСостоялась");
	
	ТЗЦветов = уб_КЭШируемые.ЦветаСправочникаЦветов(Цвета);
	ЕстьТЗЦветов = ТЗЦветов <> Неопределено;
	Если ЕстьТЗЦветов Тогда
		СтрокаТЗФонЗаполненногоФильтра		= ТЗЦветов.Найти("ФонЗаполненногоФильтра", "Имя");
		СтрокаТЗФонНезаполненногоФильтра  	= ТЗЦветов.Найти("ФонНезаполненногоФильтра", "Имя");
		СтрокаТЗПустойРезультатФильтра  	= ТЗЦветов.Найти("СтраховкаНеСостоялась", "Имя");
		
		Если СтрокаТЗФонНезаполненногоФильтра <> Неопределено И СтрокаТЗФонЗаполненногоФильтра <> Неопределено И СтрокаТЗПустойРезультатФильтра <> Неопределено Тогда
			Цвета = Новый Структура("ФонЗаполненногоФильтра, ФонНезаполненногоФильтра, ПустойРезультатФильтра", СтрокаТЗФонЗаполненногоФильтра, СтрокаТЗФонНезаполненногоФильтра, СтрокаТЗПустойРезультатФильтра);
			СтруктураФильтров.Вставить("Цвета", Цвета);
		КонецЕсли;
	КонецЕсли;
	//0 - не обрабатывается
	//1 - ожидание отложенной обработки
	//2 - выполнение обработки фильтра
	СтруктураФильтров.Вставить("СостояниеОбработки",0); 
	// для обработки фильтров при открытии формы выбора
	//СтруктураФильтров.Вставить("ЗапускатьПриОткрытии", Ложь);
	Возврат СтруктураФильтров

КонецФункции // ПустаяСтруктураФИльтров()

Процедура ЗаполнитьКолонкиОптимизации(ЭлементыФормы, ТЗФильтров) Экспорт

	Для Каждого СтрокаТЗ Из ТЗФильтров Цикл		
		эф = ЭлементыФормы.Найти(СтрокаТЗ.ИмяПоля);
		Если эф <> Неопределено И ТипЗнч(эф) = Тип("ActiveX") Тогда
			СтрокаТЗ.ActiveX = Истина;
		КонецЕсли;	
		СтрокаТЗ.ЕстьЗапрос 		= Не ПустаяСтрока(СтрокаТЗ.Запрос.Текст);
		СтрокаТЗ.ЕстьЧастныйКод 	= Не ПустаяСтрока(СтрокаТЗ.ЧастныйКод);
		СтрокаТЗ.ЕстьЧастныйЗапрос	= СтрокаТЗ.ЧастныйЗапрос <> Неопределено;
		СтрокаТЗ.Данные				= НРег(СокрЛП(СтрокаТЗ.Данные));
		СтрокаТЗ.ИмяПоля			= НРег(СокрЛП(СтрокаТЗ.ИмяПоля));
	КонецЦикла;

КонецПроцедуры

//используется для заполнения списка значений поля со списком состояний БСО (подбор БСО, отчет остатков БСО)
Процедура СписокВыбораСЗСостояний(СписокВыбора) Экспорт
	
	Прч = Перечисления.уб_СостоянияБСО;
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Прч.ПустойБланк);
	СЗ.Добавить(Прч.НеиспользованныйБланк);
	СписокВыбора.Добавить(СЗ, "Не заполненные");
	//
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Прч.Оформлен);
	СписокВыбора.Добавить(СЗ, "Оформленные");
	//
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Прч.ПустойБланк);
	СЗ.Добавить(Прч.НеиспользованныйБланк);
	СЗ.Добавить(Прч.НеПолностьюОформлен);
	СЗ.Добавить(Прч.НеполныйБланк);
	СЗ.Добавить(Прч.НеПравильноОформлен);
	СписокВыбора.Добавить(СЗ, "Не оформленные");
	//
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Прч.Испорчен);
	СЗ.Добавить(Прч.Украден);
	СЗ.Добавить(Прч.Уничтожен);
	СЗ.Добавить(Прч.Утрачен);
	СписокВыбора.Добавить(СЗ, "Утраченные");
	//
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Прч.НедействующийБланк);
	СписокВыбора.Добавить(СЗ, "Не действующие");
	//
	СЗ = Новый СписокЗначений;
	Для Каждого Перечисление Из Прч Цикл
		СЗ.Добавить(Перечисление)
	КонецЦикла;
	СЗ.Добавить(Прч.ПустаяСсылка());
	СписокВыбора.Добавить(СЗ, "Все состояния");

