// Определяет, ведется ли номерной учет
//
// Параметры
//  ВидБСО - ссылка на элемент справочника ВидыБСО
//
// Возвращаемое значение
//  Истина - ведется номерной учет, Ложь - нет
//
Функция ОпределитьВедетсяНомернойУчет(ВидБСО,ТУ = Неопределено) Экспорт  //TODO Проверить, где вызывается , если возможно задействовать 2 параметр
	
	П = Перечисления.уб_ТипыУчетаБСО;
	//ТУ = ?(ТУ = Неопределено,ВидБСО.ТипУчетаБСО,ТУ);
	Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
		Возврат Истина;
	ИначеЕсли ЗначениеЗаполнено(ВидБСО)  = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ВидБСО)  = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
		Если ТУ = Неопределено Тогда
			ТУ = ВидБСО.ТипУчетаБСО;
		КонецЕсли;	
		Если 
			ТУ = П.НомернойЕстьПолис
			ИЛИ ТУ = П.НомернойПолисСоответствуетНомеруБСО
			ИЛИ ТУ = П.НомернойНетПолиса
			ИЛИ ТУ = П.НомернойПолисИзСвободных
			ИЛИ ТУ = П.НомернойПолисВручную
			ИЛИ ТУ = П.УчетНеВедетсяПолисВручную
			
			//ИЛИ ТУ = П.но
			Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

//если учет номерной - Истина
//если количественный - Ложь
//иначе неопределено
//TODO перенести в кэшируемые?
Функция ОпределитьУчетБСОНомерной(ВидБСОИлиТип) Экспорт

	П 	= Перечисления.уб_ТипыУчетаБСО;
	ТУ  = ?(ТипЗнч(ВидБСОИлиТип) = Тип("СправочникСсылка.уб_ВидыБСО"), ВидБСОИлиТип.ТипУчетаБСО, ВидБСОИлиТип);
	Если ТУ = П.НомернойЕстьПолис
		Или ТУ = П.НомернойПолисСоответствуетНомеруБСО
		Или ТУ = П.НомернойНетПолиса
		Или ТУ = П.НомернойПолисИзСвободных
		Или ТУ = П.НомернойПолисВручную
		Тогда
		Возврат Истина
	ИначеЕсли ТУ = П.КоличественныйПолисИзСвободных
		Или ТУ = П.КоличественныйПолисВручную
		Или ТУ = П.КоличественныйНетПолиса
		Тогда
		Возврат Ложь
	КонецЕсли;

КонецФункции // ОпределитьУчетБСО()

