//
Процедура ПрочитатьСостояниеБСО(СтруктураБСО,Вариант = 2) Экспорт
	
	Если Вариант = 1 Тогда
		//СтруктураОтбора = Новый Структура("СК, ВидБСО, НомерБСО, Подтверждено, ДокПроведен" 
		//, СтруктураБСО.СК
