Функция ПроверитьИмяКаталога(Знач ИмяКаталога, СоздаватьКаталог = Ложь) Экспорт

	ИмяКаталога = СокрЛ(ИмяКаталога);
	Если ИмяКаталога <> "" И Прав(ИмяКаталога, 1) <> "\" Тогда
		Если СоздаватьКаталог Тогда
			СоздатьКаталог(ИмяКаталога);	
		КонецЕсли;
		ИмяКаталога = ИмяКаталога + "\"
	КонецЕсли;
	Возврат ИмяКаталога

КонецФункции // ПолныйПутьКФайлу()

Функция ОпределитьРасширениеФайла(Знач ИмяФайла, СТочкой = Истина, ПеревестиВНижнийРегистр = Истина) Экспорт
	
	ПрерватьЦикл = Ложь;
	Результат = "";
	ИмяФайла = СокрЛП(ИмяФайла);
	Длина = СтрДлина(ИмяФайла);
	Для Счетчик = 0 По Длина - 1 Цикл
		Символ = Сред(ИмяФайла, Длина - Счетчик, 1);
		Если Символ = "." Тогда
			ПрерватьЦикл = Истина;
			Если СТочкой Тогда
				Результат = Символ + Результат;
			КонецЕсли;
		КонецЕсли;
		Если ПрерватьЦикл Тогда
			Прервать;
		КонецЕсли;
		Результат = Символ + Результат;
	КонецЦикла;
	Если ПрерватьЦикл Тогда
		Если ПеревестиВНижнийРегистр Тогда
			Результат = НРег(Результат)
		КонецЕсли;
	Иначе
		Результат = "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

