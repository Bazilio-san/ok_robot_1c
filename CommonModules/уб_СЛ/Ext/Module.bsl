Функция ЭтоУниверсальноеБСОДляВидаСтраховогоПродукта(ВидБСО,ВидСП) Экспорт 
	Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Т.ВидСП
	               |ИЗ
	               |	Справочник.уб_ВидыБСО.ВидыСтраховыхПродуктовДляУниверсальногоБСО КАК Т
	               |ГДЕ
	               |	Т.Ссылка.УниверсальноеБСО = ИСТИНА
	               |	И Т.ВидСП = &ВидСП
	               |	И Т.Ссылка = &ВидБСО";
                          
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("ВидСП", ВидСП);
	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();
КонецФункции

Функция ОпределитьЭтоДокДвиженийНомерногоБСО(Док) Экспорт
	ЭтоДок = Неопределено;
	ОписаниеТиповДокументы = Документы.ТипВсеСсылки();
	
	Если Док <> Неопределено И ОписаниеТиповДокументы.СодержитТип(ТипЗнч(Док)) Тогда
		Двж = Док.Метаданные().Движения;
		МРС =  Метаданные.РегистрыСведений;
		ЭтоДок = Двж.Содержит(МРС.уб_ДвиженияБСО) ИЛИ Двж.Содержит(МРС.уб_СвободныеНомераПолисов);
	Иначе
		//Это - вообще не документ 	
		ЭтоДок = Ложь;
	КонецЕсли;
	
	Возврат ЭтоДок;
	
КонецФункции

