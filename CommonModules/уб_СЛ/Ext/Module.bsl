Функция СписокВидовСтраховыхПродуктов() Экспорт
	Результат = Новый Массив;
	Для каждого Значение из Метаданные.Перечисления.уб_ВидыСтраховыхПродуктов.ЗначенияПеречисления Цикл
		НовоеЗначение = Перечисления.уб_ВидыСтраховыхПродуктов[Значение.Имя];
		Результат.Добавить(НовоеЗначение);
	КонецЦикла;	
	Возврат Результат;
КонецФункции


Функция СписокДоступныхОрганизаций() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Разрешенные
	               |	Организации.Ссылка
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |ГДЕ
	               |	Организации.ЭтоГруппа = ЛОЖЬ
	               |	И (Организации.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ Организации.ДатаОкончанияДействия > &ТекущаяДата)
	               |	И Организации.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Организации.Наименование";
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

Функция СписокВидовСП(Поставщик,Организации) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Разрешенные
	               |	КонтрагентыВидыСП.ВидСП,
	               |	КонтрагентыВидыСП.Организация
	               |ИЗ
	               |	Справочник.Контрагенты.ВидыСП КАК КонтрагентыВидыСП
	               |ГДЕ
	               |	КонтрагентыВидыСП.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтрагентыВидыСП.ВидСП";
	Запрос.УстановитьПараметр("Ссылка",Поставщик);
	НастройкиСП = Запрос.Выполнить().Выгрузить();
	СписокВидовСП = Новый Массив;
	Если НастройкиСП.Количество() = 0 Тогда
		//Полный список
		Возврат СписокВидовСтраховыхПродуктов();
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Для каждого Настройка из НастройкиСП Цикл
		Если Настройка.Организация.Пустая() Тогда
			Если Список.НайтиПоЗначению(Настройка.ВидСП) = Неопределено Тогда
				Список.Добавить(Настройка.ВидСП,Строка(Настройка.ВидСП));
			КонецЕсли 
		ИначеЕсли НЕ Организации.Найти(Настройка.Организация) = Неопределено Тогда
			Если Список.НайтиПоЗначению(Настройка.ВидСП) = Неопределено Тогда
				Список.Добавить(Настройка.ВидСП,Строка(Настройка.ВидСП));
			КонецЕсли 
		КонецЕсли;	
	КонецЦикла;	
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();
КонецФункции	


