// Определяет, ведется ли количественный учет
//
// Параметры
//  ВидБСО - ссылка на элемент справочника ВидыБСО
//
// Возвращаемое значение
//  Истина - ведется количественный учет, Ложь - нет
//
Функция ОпределитьВедетсяКоличественныйУчет(ВидБСО,ТУ = Неопределено) Экспорт    //TODO Проверить, где вызывается , если возможно задействовать 2 параметр
	
	П = Перечисления.уб_ТипыУчетаБСО;
	//ТУ = ?(ТУ = Неопределено,ВидБСО.ТипУчетаБСО,ТУ);
	Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
