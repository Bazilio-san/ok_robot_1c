//
// Возвращаемое значение
//  Истина - используется учет свободных номеров, Ложь - нет
//
Функция ОпределитьИспользуютсяСвободныеНомераПолисов(ВидБСО,ТУ = Неопределено) Экспорт 
	П = Перечисления.уб_ТипыУчетаБСО;
	//ТУ = ?(ТУ = Неопределено,ВидБСО.ТипУчетаБСО,ТУ);
	Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
		ТУ = П.НомернойЕстьПолис;
	КонецЕсли;
	Если ТУ = Неопределено Тогда
		ТУ = ВидБСО.ТипУчетаБСО;
	КонецЕсли;
	Если 
			ТУ = П.НомернойПолисИзСвободных
		ИЛИ ТУ = П.КоличественныйПолисИзСвободных
		ИЛИ ТУ = П.УчетНеВедетсяПолисИзСвободных
    Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Определяет, используется ли для вида БСО номера полисов
//
// Параметры
//  ВидБСО - ссылка на элемент справочника ВидыБСО
//
// Возвращаемое значение
//  Истина - используется номер полиса, Ложь - нет
//
Функция ЕстьНомерПолиса(ВидБСО, Знач ТУ = Неопределено) Экспорт 
	
	Если ВидБСО <> Неопределено Тогда
		П 	= Перечисления.уб_ТипыУчетаБСО;
		Если ТипЗнч(ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
			ТУ = П.НомернойЕстьПолис;
		КонецЕсли;	
		Если ТУ = Неопределено Тогда
			ТУ = ВидБСО.ТипУчетаБСО;
		КонецЕсли;	
		
		Если ТУ = П.НомернойЕстьПолис
			Или ТУ = П.НомернойПолисСоответствуетНомеруБСО
			Или ТУ = П.НомернойПолисИзСвободных
			Или ТУ = П.НомернойПолисВручную
			Или ТУ = П.КоличественныйПолисИзСвободных
			Или ТУ = П.КоличественныйПолисВручную
			Или ТУ = П.УчетНеВедетсяПолисИзСвободных
			Или ТУ = П.УчетНеВедетсяПолисВручную
			Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

