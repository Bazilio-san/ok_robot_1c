	ТаблицаФайлов.Колонки.Добавить("ПолеСлева", 				Новый ОписаниеТипов("Число"));
	ТаблицаФайлов.Колонки.Добавить("ПолеСверху", 				Новый ОписаниеТипов("Число"));
	ТаблицаФайлов.Колонки.Добавить("ПолеСправа", 				Новый ОписаниеТипов("Число"));
	ТаблицаФайлов.Колонки.Добавить("ПолеСнизу", 				Новый ОписаниеТипов("Число"));
	ТаблицаФайлов.Колонки.Добавить("РасширениеКартинки", 		Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("НомерСтрокиВДокументе", 	Новый ОписаниеТипов("Число"));
	ТаблицаФайлов.Колонки.Добавить("КолонкаВТабличнойЧасти", 	Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("ПолноеИмяИсходящегоФайла",	Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("АдресВХранилище",			Новый ОписаниеТипов("Строка"));
	//файл на клиенте (к примеру открытие добавленного файла в текущей сессии формы ТЧ заявки)
	//требуется открытие на клиенте, или TODO параметр отправки на сервер для постобработки
	ТаблицаФайлов.Колонки.Добавить("ФайлНаКлиенте",	Новый ОписаниеТипов("Булево"));
	//конвертация требуется для файлов типа Word и Excel
	ТаблицаФайлов.Колонки.Добавить("ТребуетсяКонвертация", Новый ОписаниеТипов("Булево"));
	//признак будет ли добавляться (1) к имени исходящего файла
	ТаблицаФайлов.Колонки.Добавить("ОбновитьИмяФайлаДляСтраниц", Новый ОписаниеТипов("Булево"));
	//имя исходящего файла без нумерации страниц "(*)" и без расширения
	ТаблицаФайлов.Колонки.Добавить("НачальноеИмяИсходящегоФайлаБезРасширения", Новый ОписаниеТипов("Строка"));	
	// хранит УИД регистра файлов к полисам
	ТаблицаФайлов.Колонки.Добавить("УИД", Новый ОписаниеТипов("Строка"));
	//Индивидуальная настройка повоорта файла
	ТаблицаФайлов.Колонки.Добавить("ПовернутьКартинкуЕслиШиринаБольшеВысоты", Новый ОписаниеТипов("Булево"));
	// имя входящего файла. Пока используется только для хранения значения поля для последующей проверки запросом к регистру файлов к полисам
	ТаблицаФайлов.Колонки.Добавить("ИмяВходящегоФайла", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("МассивКонвертации", Новый ОписаниеТипов("Массив"));
	
	Возврат ТаблицаФайлов;

КонецФункции // ПустаяТаблицаФайловДляКонвертации()

//Постобработка, получение показ файлов
Процедура ОкончаниеКонвертацииКлиент(Параметры) Экспорт

	Если Параметры.ПоказыватьФайлы И Параметры.ЕстьНайденныеФайлы И Не Параметры.ИстеклоВремяОжиданияФОновогоЗадания Тогда
		ТаблицаФайлов = Параметры.ТаблицаФайлов;
		Если ТаблицаФайлов.Количество() = 1 Тогда
			СтрокаТЗ = ТаблицаФайлов[0];
			Если СтрокаТЗ.ВходящийФайлНайден И СтрокаТЗ.Выполнено Тогда
				МассивДвоичныхДанных = ПолучитьИзВременногоХранилища(СтрокаТЗ.АдресВХранилище);
				Если ТипЗнч(МассивДвоичныхДанных) = Тип("Массив") Тогда
					Если МассивДвоичныхДанных.Количество() > 0 Тогда
						РасширениеКартинок = уб_СЛ.ОпределитьРасширениеФайла(СтрокаТЗ.ПолноеИмяИсходящегоФайла, Ложь);
						ИмяФайла = СтрокаТЗ.ПолноеИмяВходящегоФайла;
						ТЗКартинок = Новый ТаблицаЗначений;
						ТЗКартинок.Колонки.Добавить("Картинка", 	уб_temp.СозданиеОписанияТиповПоТипу(Тип("Картинка")));
						ТЗКартинок.Колонки.Добавить("Расширение",	Новый ОписаниеТипов("Строка"));
						ТЗКартинок.Колонки.Добавить("ПолноеИмяВходящегоФайла",	Новый ОписаниеТипов("Строка"));
						Для Каждого ЭлементМассива Из МассивДвоичныхДанных Цикл
							СтрокаТЗ = ТЗКартинок.Добавить();
							СтрокаТЗ.Картинка	= Новый Картинка(ЭлементМассива);
							СтрокаТЗ.Расширение	= РасширениеКартинок;
							СтрокаТЗ.ПолноеИмяВходящегоФайла = ИмяФайла;
						КонецЦикла;
					Иначе
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Конвертация: МассивДвоичныхДанных.Количество() = 0, " + Параметры.СсылкаНаОбъект, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
						#Если Клиент Тогда
							Предупреждение("Ошибка конвертации");
						#КонецЕсли
					КонецЕсли;
				ИначеЕсли СтрокаТЗ.МассивКонвертации.Количество() > 0 тогда
					МассивДанных = СтрокаТЗ.МассивКонвертации;
					ТЗКартинок = Новый ТаблицаЗначений;
					ТЗКартинок.Колонки.Добавить("Картинка", 	уб_temp.СозданиеОписанияТиповПоТипу(Тип("Картинка")));
					ТЗКартинок.Колонки.Добавить("Расширение",	Новый ОписаниеТипов("Строка"));
					ТЗКартинок.Колонки.Добавить("ПолноеИмяВходящегоФайла",	Новый ОписаниеТипов("Строка"));
					Для Каждого ЭлементМассива Из МассивДанных Цикл
						СтрокаТЗ = ТЗКартинок.Добавить();
						СтрокаТЗ.Картинка	= Новый Картинка(ЭлементМассива);
						СтрокаТЗ.Расширение	= Параметры.РасширениеКартинки;
						СтрокаТЗ.ПолноеИмяВходящегоФайла = ЭлементМассива;
					КонецЦикла;
				Иначе					
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Конвертация: МассивДвоичных = Неопределено, " + Параметры.СсылкаНаОбъект, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
					#Если Клиент Тогда
						Предупреждение("Ошибка конвертации");
					#КонецЕсли
				КонецЕсли;
			КонецЕсли;
			Если ТЗКартинок <> Неопределено Тогда
				ПараметрыФормыПросмотра = Новый Структура;
				ПараметрыФормыПросмотра.Вставить("ОтображатьИмяФайла", Ложь);
				//TODO проверить будет ли открываться несколько форм, если несколько строк?
				Форма = ПолучитьОбщуюФорму("уб_ПросмотрКартинки");
				Попытка
					//<v8e:Comment>{ОбщийМодуль.уб_СЛ.Модуль(1386)}: Значение не является значением объектного типа (ПараметрыФормы)</v8e:Comment>
					Форма.ПараметрыФормы			= ПараметрыФормыПросмотра;
					Форма.ТЗКартинок				= ТЗКартинок;
					Форма.ОбщееРасширениеКартинок   = РасширениеКартинок;
					Форма.Открыть();
				Исключение
					//не ошибка конвертации - требуется понять почему не открывается форма
					//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СЛ.КонвертироватьИПоказатьКартинку(): " + ОписаниеОшибки() + ". Тип значения Форма: " + ТипЗнч(Форма));
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка открытия формы просмотра картинки");
				КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция СтруктураКонвертацииПоИмениФайла(Знач ПутьКФайлу, ПоказыватьФайлы = Истина) Экспорт

	ПутьКФайлу = СокрЛП(ПутьКФайлу);
	Если ПутьКФайлу <> "" Тогда
		Параметры = уб_СЛ.СтруктураПараметровКонвертацииФайловПоУмолчанию();
		Параметры.ПоказыватьФайлы 							= ПоказыватьФайлы;
		Параметры.ПутьККаталогуИсходящихФайлов 				= "";
		Параметры.ВремяОжиданияФоновогоЗадания  			= 20;
		Параметры.ТипСообщенияОшибок						= "Предупреждение";
		Параметры.НомерСтраницыОт							= 1;
		Параметры.НомерСтраницыДо							= 1;
		Параметры.ОбрезкаПолей								= 0;
		Параметры.ПовернутьКартинкуЕслиШиринаБольшеВысоты 	= Ложь;
		Параметры.УдалитьФайлыПослеКонвертации				= Истина;
		ТаблицаФайлов = Параметры.ТаблицаФайлов;
		СтрокаТЗ = Параметры.ТаблицаФайлов.Добавить();
		СтрокаТЗ.АдресВХранилище = ПоместитьВоВременноеХранилище(Новый Массив, Новый УникальныйИдентификатор);
		Если Найти(ПутьКФайлу, "\") <> 0 Тогда
			//файл на клиенте
			Параметры.ОбработатьНаКлиенте		= Истина;
			СтрокаТЗ.ПолноеИмяВходящегоФайла 	= ПутьКФайлу;
			СтрокаТЗ.ФайлНаКлиенте				= Истина;
		Иначе
			СтрокаТЗ.ПолноеИмяВходящегоФайла 	= ПроверитьИмяКаталога(Справочники.уб_ХранилищаФайловБ2Б.ФайлыКЗаявкам.Путь) + ПутьКФайлу;
		КонецЕсли;
		Возврат Параметры;
	КонецЕсли;

КонецФункции // СоздатьТаблицуКонвертацииПоИмениФайла()

Процедура ОтправитьФайлСКлиентаНаСервер(ФайлИсточник, ФайлПриемник = Неопределено, ВКаталогВременныхФайлов = Ложь, УдалитьФайлИсточник = Ложь) Экспорт
	
	Если ФайлПриемник = Неопределено Тогда
		КаталогВременныхФайлов = КаталогВременныхФайлов();
		ВременныйФайл = ПолучитьИмяВременногоФайла(уб_СЛ.ОпределитьРасширениеФайла(ФайлИсточник));
		ФайлПриемник = СтрЗаменить(ВременныйФайл, КаталогВременныхФайлов, "");
	КонецЕсли;
	Картинка = Новый Картинка(ФайлИсточник);
	ДвоичныеДанные = Картинка.ПолучитьДвоичныеДанные();
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	уб_СЕРВЕРные.СохранитьИзВременногоХранилищаНаСервер(АдресВоВременномХранилище, ФайлПриемник, ВКаталогВременныхФайлов);
	Если УдалитьФайлИсточник Тогда
		УдалитьФайлы(ФайлИсточник);
	КонецЕсли;
	
КонецПроцедуры

//TODO добавлять или нет Параметры параметром? В текущем виде не требуется
//Проверка файла, отправка на сервер, вызов конвертации с параметрами, вызов постобработки
Функция ВызовКонвертацииКлиент(Знач ПутьКФайлу, СсылкаНаОбъект = Неопределено, ПоказыватьФайлы = Неопределено) Экспорт

	ПутьКФайлу = СокрЛП(ПутьКФайлу);
	Если ПутьКФайлу <> "" Тогда
		Параметры = уб_СЛ.СтруктураПараметровКонвертацииФайловПоУмолчанию();
		Параметры.ПоказыватьФайлы 							= ПоказыватьФайлы;
		//Параметры.ПутьККаталогуИсходящихФайлов 				= "";
		Параметры.ПроверятьКэшНаНаличиеФайлов = Истина;
		Параметры.ВремяОжиданияФоновогоЗадания  			= 3;
		Параметры.ТипСообщенияОшибок						= "Сообщение";
		Параметры.НомерСтраницыОт							= 1;
		Параметры.НомерСтраницыДо							= 1;
		Параметры.ПовернутьКартинкуЕслиШиринаБольшеВысоты 	= Ложь;
		Параметры.УдалятьФайлыПослеКонвертации				= ЛОЖЬ;
		#Если Клиент Тогда
			уб_Клиент._УстановитьЗначение(Параметры,"ПоказыватьФайлы",	ПоказыватьФайлы);
			уб_Клиент._УстановитьЗначение(Параметры,"СсылкаНаОбъект", 	СсылкаНаОбъект);
		#Иначе	
			уб_вызовСервера._УстановитьЗначение(Параметры,"ПоказыватьФайлы",	ПоказыватьФайлы);
			уб_вызовСервера._УстановитьЗначение(Параметры,"СсылкаНаОбъект", 	СсылкаНаОбъект);
		#КонецЕсли	
		ТаблицаФайлов = Параметры.ТаблицаФайлов;
		СтрокаТЗ = Параметры.ТаблицаФайлов.Добавить();
		СтрокаТЗ.АдресВХранилище = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		//Если Найти(ПутьКФайлу, "\") <> 0 Тогда
		//	//файл на клиенте
		//	ПолныйПутьКФайлу = Неопределено;
		//	ОтправитьФайлСКлиентаНаСервер(ПутьКФайлу, ПолныйПутьКФайлу, Истина, Ложь);
		//	СтрокаТЗ.ПолноеИмяВходящегоФайла = ПолныйПутьКФайлу;
		//Иначе
		мФайл = Новый Файл(ПутьКФайлу);
		Если мФайл.Существует() тогда
			СтрокаТЗ.ПолноеИмяВходящегоФайла 	= мФайл.ПолноеИмя;
			СтрокаТЗ.ИмяВходящегоФайла			= мФайл.Имя;
		Иначе
			СтрокаТЗ.ИмяВходящегоФайла			= ПутьКФайлу;
		КонецЕсли;
		//КонецЕсли;
		уб_СЕРВЕРные.ВызовКонвертацииСервер(Параметры);
		ОкончаниеКонвертацииКлиент(Параметры);
		#Если Клиент Тогда
			Если Не ПустаяСтрока(Параметры.СтрокаОшибки) Тогда
				ТипСообщенияОшибок = Лев(НРег(СокрЛП(Параметры.ТипСообщенияОшибок)), 3);
				Если ТипСообщенияОшибок = "соо" Тогда
					Сообщить(Параметры.СтрокаОшибки);
				ИначеЕсли ТипСообщенияОшибок = "пре" Тогда
					Предупреждение(Параметры.СтрокаОшибки);
				КонецЕсли;
			КонецЕсли;
		#КонецЕсли
		Возврат Параметры;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

КонецФункции

