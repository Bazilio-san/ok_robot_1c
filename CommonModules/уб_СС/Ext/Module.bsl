// Процедуры установки доступности полей в таблицах оплат

Функция ОП_ПолучитьТзОплат(СтраховойПолисСсылка) Экспорт 
	//возвращает таблицу - список оплат, отсортированных по дате платежа
	//возвращает таблицу - список оплат, отсортированных по дате платежа
	ЗапросТЗОплат = Новый Запрос;
	ЗапросТЗОплат.Текст = "ВЫБРАТЬ
	|	уб_ОплатаПолисов.*, 
	|	уб_ОплатаПолисов.Дата КАК Период 
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|ГДЕ
	|	уб_ОплатаПолисов.СтраховойПолис = &СтраховойПолис
	// проверка на пустое значение Страхового Полиса
	|	И НЕ &Пустая
	//
	|    И НЕ уб_ОплатаПолисов.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	уб_ОплатаПолисов.Дата";
	ЗапросТЗОплат.УстановитьПараметр("СтраховойПолис", СтраховойПолисСсылка);
	// параметр на пустое значение Страхового полиса
	ЗапросТЗОплат.УстановитьПараметр("Пустая", 		СтраховойПолисСсылка.Пустая());
	//
	ТЗОплат = ЗапросТЗОплат.Выполнить().Выгрузить();
	Возврат ТЗОплат;
КонецФункции

Процедура ОП_Проверить(
	ТзОшибки,
	oОплатыСписок,
	Знач Оплата, 
	ПроверятьТолькоНомерКвитанции 	= Ложь, 
	ПроверятьТолькоКритические 		= Ложь, 
	КонтрольПоРСДвиженияБСО 		= Ложь, 
	ОстановитьсяПриОшибке 			= Ложь, 
	СтраховойПолис, 
	ОтключитьКонтрольНомеровБСО 	= Ложь, 
	Откуда 							= Неопределено
	) Экспорт
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	//Когда функция вызывается из события "ПриВыводеСтроки" ДанныеСтроки (тут Оплата)
	// могут быть двух типов: "Текущие данные списка" или "Регистр сведений менеджер записи: Оплаты полисов"
	//(первый вариант, очевидно, случается при первом открытии списка оплат и при уходе с него)
	// и в первом варианте недоступны невидимые реквизиты оплаты (в данном случае ВидБСО)
	Статус = СтатусСообщения.Важное;
	СОО = "";
	Если Оплата.СтраховойПолис.Пустая() Тогда
		ДобСОО(ТзОшибки,"В Оплате от " + Формат(Оплата.Дата,"ДФ=dd.MM.yyyy") + " не указан Страховой Полис.",oОплатыСписок,Статус,Откуда); 	
		Возврат;	
	КонецЕсли;
	СК = СтраховойПолис.СК;
	Если СтраховойПолис.СК.Пустая() Тогда
		СОО = "В Страховом Полисе не указана Страховая Компания.";
		Если Откуда = "СтраховойПолис" Тогда 	
			Стр = ТзОшибки.Добавить();
			Стр.Ошибка = СОО;
			Стр.Элемент = СК;
			Стр.Статус = СтатусСообщения.ОченьВажное;
		Иначе 	
			ДобСОО(ТзОшибки,СОО,oОплатыСписок,Статус,Откуда); 	
		КонецЕсли;
		Возврат;	
	КонецЕсли;
	
	СтруктураВидБСО = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СК);
	ВидБСОТипаКвА7 = СтруктураВидБСО.ВидБСО;
	ТипУчетаБСО = СтруктураВидБСО.ТипУчетаБСО;
	
	ПустойВидБСО = Справочники.уб_ВидыБСО.ПустаяСсылка();
	ИДобщ = "Ошибка. Оплата № " + Строка(Оплата.НомерВзноса) + " по полису № " + СокрЛП(Оплата.СтраховойПолис.Номер) + ": ";
	НаДатуОплаты = "на дату " + Формат(Оплата.Дата,"ДФ=dd.MM.yyyy") + "";	
	Если Откуда = "ОтчетАгента" Тогда
		СОО1 = ИДобщ;
	ИначеЕсли Откуда = "СтраховойПолис" Тогда 	
		СОО1 = "Ошибка. Оплата № " + Строка(Оплата.НомерВзноса) + ": ";
	ИначеЕсли Откуда = "РегистрОплат" Тогда 	
		СОО1 = ИДобщ;
	Иначе
		СОО1 = ИДобщ;
	КонецЕсли; 	
	Если Оплата.Агент = Неопределено Или Оплата.Агент.Пустая() Тогда
		ДобСОО(ТзОшибки,СОО1 + "Не указан Агент.",oОплатыСписок,Статус,Откуда); 	
		Если ОстановитьсяПриОшибке Тогда 
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	КонтролироватьНаличиеБСО = ПараметрыСеанса.уб_Константы.уб_КонтролироватьНаличиеБСО = Истина;
	Если НЕ ОтключитьКонтрольНомеровБСО И Оплата.ЕстьКвитанция Тогда
		Если уб_СЛ.ОпределитьВедетсяНомернойУчет(ВидБСОТипаКвА7, ТипУчетаБСО) Тогда 
			sКвитанция = СокрЛП(Оплата.НомерКвитанции);
			Если sКвитанция = "" Тогда
				Если СистемаНаправлениеПлатежа Тогда
					Если Оплата.ЕстьКвитанция Тогда
						ДобСОО(ТзОшибки,"Не указан номер квитанции", oОплатыСписок, Статус, Откуда);
						Если ОстановитьсяПриОшибке Тогда 
							Возврат
						КонецЕсли;
					КонецЕсли;
				Иначе
					Если Оплата.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Тогда 
						ДобСОО(ТзОшибки,"Не указан номер квитанции при оплате через кассу.",oОплатыСписок,Статус,Откуда);
						Если ОстановитьсяПриОшибке Тогда 
							Возврат; 
						КонецЕсли;
					КонецЕсли;		
				КонецЕсли;
			Иначе
				Если КонтрольПоРСДвиженияБСО Тогда
					//Проверяем, есть ли вообще такое БСО
					СтруктураБСО = ССПрочитСостБСО(СК, ВидБСОТипаКвА7, sКвитанция, Оплата.ДатаПроведенияБСО);
					Если СтруктураБСО.Существует Тогда
						Если КонтролироватьНаличиеБСО И СтруктураБСО.Агент <> Оплата.Агент  И СтруктураБСО.Агент <> Оплата.Курьер Тогда
							ДобСОО(ТзОшибки,СОО1 + НаДатуОплаты + " квитанция № " + sКвитанция + 
							" принадлежит физлицу " + СтруктураБСО.Агент.Наименование + 
							" (т.е. не числится ни на Агенте, ни на Курьере).",oОплатыСписок,Статус,Откуда);
							Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
						КонецЕсли;
						Если СтруктураБСО.Поставщик <> СтраховойПолис.Поставщик Тогда
							ДобСОО(ТзОшибки,СОО1 + "Квитанция № " + sКвитанция + 
							" получена от Поставщика: '" + СтруктураБСО.Поставщик.Наименование + 
							"' (Страховой полис получен от поставщика: '" + СтраховойПолис.Поставщик.Наименование + "'). Квитанция д/б того же поставщика, что и страховой полис."
							,oОплатыСписок
							,СтатусСообщения.Внимание
							,Откуда);
							Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
						КонецЕсли;
						Если СтруктураБСО.ОрганизацияАгент <> СтраховойПолис.ОрганизацияАгент Тогда
							ДобСОО(ТзОшибки,СОО1 + "Квитанция № " + sКвитанция + 
							" поступала в Организацию-Агента: '" + СтруктураБСО.ОрганизацияАгент.Наименование + 
							"' (Страховой полис поступал в ОргАгента: '" + СтраховойПолис.Поставщик.Наименование + "'). Квитанция и полис должны поступать в одну и туже Организацию-Агента."
							,oОплатыСписок
							,СтатусСообщения.Внимание
							,Откуда);
							Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
						КонецЕсли;
						ИнфоОДвижениях = "    ";
						Если уб_СС.ЕстьДвиженияБСОзаПериод(СК, ВидБСОТипаКвА7, sКвитанция, Оплата.ДатаПроведенияБСО, Неопределено, ИнфоОДвижениях) Тогда
							Сообщить("Для квитанции № " + sКвитанция + " из оплаты № " + Строка(Оплата.НомерВзноса) + " обнаружены движения БСО после даты оплаты:" + ИнфоОДвижениях);
						КонецЕсли; //Есть движения БСО квитанции за период после оплаты
					Иначе
						Если КонтролироватьНаличиеБСО Тогда
							СОО_ = СОО1 + НаДатуОплаты + " Отсутствует квитанция с номером " + sКвитанция + 
							" среди БСО для СК `" + Строка(СК.Наименование) + "`.";
							ДобСОО(ТзОшибки,СОО_,oОплатыСписок,Статус,Откуда);
							Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
						Иначе	
							Сообщить(СОО_,Статус);	
						КонецЕсли;
					КонецЕсли;					
				КонецЕсли; //КонтрольПоРСДвиженияБСО				
			КонецЕсли;									
			Если Откуда = "СтраховойПолис" Тогда 	
				Если ОП_ПроверитьНаДублиНомерКвитанции(Оплата.Ссылка, СОО)  Тогда 
					ДобСОО(ТзОшибки,СОО,oОплатыСписок,Статус,Откуда); 	
					Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
				КонецЕсли;
			КонецЕсли;					
		КонецЕсли; //Проверка ведется номерной учет					
		Если ПроверятьТолькоНомерКвитанции Тогда
			Возврат;	
		КонецЕсли;		
	КонецЕсли; // НЕ ОтключитьКонтрольНомеровБСО		
	Если Оплата.Дата = Дата(1,1,1) Тогда
		ДобСОО(ТзОшибки,СОО1 + "Не указана Дата оплаты.",oОплатыСписок,Статус,Откуда); 	
		Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
	КонецЕсли;
	Если Оплата.Агент = Неопределено Или Оплата.Агент.Пустая() Тогда
		ДобСОО(ТзОшибки,СОО1 + "Не указан Агент.",oОплатыСписок,Статус,Откуда); 	
		Если ОстановитьсяПриОшибке Тогда Возврат КонецЕсли;
	КонецЕсли;
	Если ПроверятьТолькоКритические Тогда
		Возврат;	
	КонецЕсли;
	Статус = СтатусСообщения.Внимание;
	Если Оплата.НачисленнаяСуммаВзноса = 0 Тогда
		ДобСОО(ТзОшибки,СОО1 + "Не указана Сумма Взноса.",oОплатыСписок,Статус,Откуда); 	
		Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
	КонецЕсли;
	РасчетПоАВ = Оплата.ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ;
	Если НЕ РасчетПоАВ И Оплата.ВидРасчетаСАгентом <> Перечисления.уб_ВидыРасчетовСАгентом.ПоСхеме Тогда
		ДобСОО(ТзОшибки,СОО1 + "Не указан Вид Расчета С Агентом.",oОплатыСписок,Статус,Откуда); 	
		Возврат;	
	КонецЕсли;
	Если РасчетПоАВ Тогда
		Статус = СтатусСообщения.Информация;
		//Если Не Оплата.НеМенятьАВ Тогда
		//	Если Оплата.АВилиСкидкаСумма = 0 Тогда
		//		ДобСОО(ТзОшибки,СОО1 + "Сумма Агентского Вознаграждения равна 0. Если так и должно быть, установите флажок 'Не Менять АВ'",oОплатыСписок,Статус,Откуда); 	
		//		Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
		//	КонецЕсли;
		//	Если Оплата.АВилиСкидкаПроцент = 0 Тогда
		//		ДобСОО(ТзОшибки,СОО1 + "Процент Агентского Вознаграждения равен 0. Если так и должно быть, установите флажок 'Не Менять АВ'",oОплатыСписок,Статус,Откуда); 	
		//		Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
		//	КонецЕсли;
		//КонецЕсли;		
		Если Не СистемаНаправлениеПлатежа Тогда
			Если (Оплата.ФормаОплаты <> Перечисления.уб_ФормыОплаты.Касса) И Оплата.ОплаченоФакт = 0 Тогда 
				ДобСОО(ТзОшибки,СОО1 + "Не указана Сумма фактической оплаты клиентом.",oОплатыСписок,Статус,Откуда); 	
				Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Оплата.ОплаченоФакт = 0 Тогда
			ДобСОО(ТзОшибки,СОО1 + "Не указана Сумма фактической оплаты клиентом.",oОплатыСписок,Статус,Откуда); 	
			Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не СистемаНаправлениеПлатежа Тогда
		Если Оплата.ФормаОплаты.Пустая() Тогда
			ДобСОО(ТзОшибки,СОО1 + "Не заполнено поле `Форма оплаты`.",oОплатыСписок,Статус,Откуда);
			Если ОстановитьсяПриОшибке Тогда Возврат; КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//TODO собирать все ошибки, как в ТЗ ошибок
Функция ОП_ПроверитьБыстро(
	Знач Оплата, 
	СОО 					= "", 
	КонтрольПоРСДвиженияБСО = Ложь, 
	КонтрольНаличияНаАгенте = Ложь, 
	ДанныеПоПолисуСОплатой	= Ложь,
	Знач Разделитель ="; ") Экспорт
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	Если ТипЗнч(Оплата) = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.СтраховойПолис,
		|	уб_ОплатаПолисов.СК,
		|	уб_ОплатаПолисов.НачисленнаяСуммаВзноса,
		|	уб_ОплатаПолисов.ВидРасчетаСАгентом,
		|	уб_ОплатаПолисов.ФормаОплаты,
		|	уб_ОплатаПолисов.ОплаченоФакт,
		|	уб_ОплатаПолисов.ЕстьКвитанция,
		|	уб_ОплатаПолисов.НомерКвитанции,
		|	уб_ОплатаПолисов.ДатаПроведенияБСО,
		|	уб_ОплатаПолисов.Агент,
		|	уб_ОплатаПолисов.Курьер,
		|	уб_ОплатаПолисов.Поставщик,
		|	уб_ОплатаПолисов.ОрганизацияАгент,
		|	уб_ОплатаПолисов.Ссылка
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	уб_ОплатаПолисов.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Оплата);
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			СОО = СОО+"Ссылки оплаты нет в базе"+Разделитель;
			Возврат Ложь;
		КонецЕсли;
		Оплата = Результат.Выбрать();
		Оплата.Следующий();
	КонецЕсли;
	Если ДанныеПоПолисуСОплатой = Истина Тогда
		СП 		= Оплата;
		Префикс	= "СтраховойПолис";
	Иначе	
		СП 		= Оплата.СтраховойПолис;
		Префикс	= "";
	КонецЕсли;	
	СК = Оплата.СК;
	бПолисДействует = НЕ уб_СЛ.ПолисАннулирован(СП[Префикс + "СостояниеПолиса"]);	                                                     
	Если Не ЗначениеЗаполнено(СК) Тогда 
		СОО = СОО+"Не заполнен реквизит СК."+Разделитель;
		Возврат Ложь; 
	КонецЕсли;
	Если Оплата.НачисленнаяСуммаВзноса = 0 И бПолисДействует Тогда 
		СОО = СОО+"Не заполнена сумма взноса."+Разделитель;
		Возврат Ложь; 
	КонецЕсли;
	Если Оплата.НачисленнаяСуммаВзноса <> 0 И Не бПолисДействует Тогда
		//СОО = "Начислена сумма взноса по аннулированному полису.";
		СОО = СОО+"В аннулированном полисе начисленная сумма взноса может быть только в случае расторжения с удержанием части суммы."+Разделитель;
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Оплата.ВидРасчетаСАгентом) Тогда 
		СОО = СОО+"Не указан вид расчета с агентом."+Разделитель;
		Возврат Ложь; 
	КонецЕсли;
	Если Не СистемаНаправлениеПлатежа Тогда
		Если Не ЗначениеЗаполнено(Оплата.ФормаОплаты) Тогда 
			СОО = СОО+"Не указана форма оплаты."+Разделитель;
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;
	Если Оплата.ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда
		// при расчете "ПО АВ":
		//должно быть не нулевым АВ (за исключением особых каких-то случаев, которые сопровождаются фиксацией АВ)
		//////////////////////////////////////////////////////////
		//По новой системе аннулирования оплат это частый случай - закомментировано
		//////////////////////////////////////////////////////////
		//Если Не Выборка.НеМенятьАВ Тогда
		//	Если Выборка.АВилиСкидкаСумма = 0 Тогда 
		//		СОО = "Сумма АВ (при расчете по АВ) равна 0. Если так и должно быть, установите флажок 'Не Менять АВ'.";
		//		Возврат Ложь; 
		//	КонецЕсли;
		//	Если Выборка.АВилиСкидкаПроцент = 0 Тогда 
		//		СОО = "Процент АВ (при расчете по АВ) равна 0. Если так и должно быть, установите флажок 'Не Менять АВ'.";
		//		Возврат Ложь; 
		//	КонецЕсли;
		//КонецЕсли;
		//При расчетрах НЕ через кассу, д.б. указана сума, переведенная по безналу
		Если Не СистемаНаправлениеПлатежа Тогда
			Если Оплата.ФормаОплаты <> Перечисления.уб_ФормыОплаты.Касса И Оплата.ОплаченоФакт = 0 И бПолисДействует Тогда
				СОО = СОО+"При расчетрах НЕ через кассу, д.б. указана сума, переведенная по безналу."+Разделитель;
				Возврат Ложь; 
			КонецЕсли;
		КонецЕсли;
	Иначе
		// при расчете "ПО Схеме" д.б. указана сума, факт. оплаченная клиентом
		Если Оплата.ОплаченоФакт = 0 И бПолисДействует Тогда
			СОО = СОО+"При расчете ""ПО Схеме"" д.б. указана сумма, фактически оплаченная клиентом."+Разделитель;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	// Проверяем Квитанцию, если в полисе НЕ установлен Ручной Ввод Номеров, то
	Если СП[Префикс + "ОтключитьКонтрольНомеровБСО"] Или Не Оплата.ЕстьКвитанция Тогда
		Возврат Истина;
	КонецЕсли;
	sКвитанция = СокрЛП(Оплата.НомерКвитанции);
	Если СистемаНаправлениеПлатежа Тогда
		Если ПустаяСтрока(sКвитанция) И Не Оплата.ЕстьКвитанция Тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если ПустаяСтрока(sКвитанция) И Оплата.ФормаОплаты <> Перечисления.уб_ФормыОплаты.Касса Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	СтруктураВидБСО = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СК);
	ВидБСОТипаКвА7 = СтруктураВидБСО.ВидБСО;
	ТипУчетаБСО = СтруктураВидБСО.ТипУчетаБСО;
	//Если не ведется номерной учет по квитанциям для данной СК, то не проверяем дальше
	Если Не уб_СЛ.ОпределитьВедетсяНомернойУчет(ВидБСОТипаКвА7, ТипУчетаБСО) Тогда
		СОО = СОО+"БСО не номерного учета."+Разделитель;
		Возврат Истина;
	КонецЕсли;
	//При оплате через кассу должнен быть указан номер квитанции
	Если СистемаНаправлениеПлатежа Тогда
		Если Оплата.ЕстьКвитанция И ПустаяСтрока(sКвитанция) Тогда
			СОО = СОО + "Не указан номер квитанции." + Разделитель;
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если Оплата.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса И ПустаяСтрока(sКвитанция) Тогда
			СОО = СОО+"Не указан номер квитанции при оплате через кассу."+Разделитель;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если КонтрольПоРСДвиженияБСО Тогда
		//Проверяем, есть ли вообще такое БСО
		СтруктураБСО = уб_СЛ.ПолучитьСтруктуруБСО();
		СтруктураБСО.Период 	= Оплата.ДатаПроведенияБСО;
		СтруктураБСО.СК 		= СК;
		СтруктураБСО.ВидБСО 	= ВидБСОТипаКвА7;
		СтруктураБСО.НомерБСО 	= sКвитанция;
		//СтруктураБСО.ОрганизацияАгент = ОрганизацияАгент;
		уб_СЛ.ПрочитатьСостояниеБСО(СтруктураБСО);
		Если Не СтруктураБСО.Существует Тогда
			СОО = СОО+Разделитель+"БСО не существует для данной СК.";
			Возврат Ложь;
		КонецЕсли;
		Если КонтрольНаличияНаАгенте И СтруктураБСО.Агент <> Оплата.Агент И СтруктураБСО.Агент <> Оплата.Курьер Тогда
			СОО = СОО+Разделитель+"Квитанция не числится ни на Агенте ни на Курьере.";
			Возврат Ложь;
		КонецЕсли;	
		Если СтруктураБСО.Поставщик <> СП[Префикс + "Поставщик"] Тогда 
			СОО = СОО+"Поставщик в полисе не соответствует поставщику квитанции."+Разделитель;
			Возврат Ложь; 
		КонецЕсли;	
		Если СтруктураБСО.ОрганизацияАгент <> СП[Префикс + "ОрганизацияАгент"] Тогда 
			СОО = СОО+"Орг-Агент в полисе не соответствует Орг-Агенту в квитанции."+Разделитель;
			Возврат Ложь; 
		КонецЕсли;	
	КонецЕсли; //КонтрольПоРСДвиженияБСО	
	//Поверяем номер квитанции на наличие дублей при проверке в страховом полисе
	Если ДанныеПоПолисуСОплатой Тогда
		Если ЗначениеЗаполнено(Оплата.ОплатаДубль) Тогда
			СОО = СОО+"Дублирование номера квитанции " + Оплата.НомерКвитанции + " в оплате Sys № " + Оплата.НомерДубля + Разделитель; 	
			Возврат Ложь; 
		КонецЕсли;	
	Иначе	
		Если ОП_ПроверитьНаДублиНомерКвитанции(Оплата, СОО, Разделитель)  Тогда 
			Возврат Ложь; 
		КонецЕсли;
	КонецЕсли;	
	Возврат Истина;	
	
КонецФункции

Функция ОП_ПроверитьНаДублиНомерКвитанции(Знач Оплата, СОО = "",Знач Разделитель="; ") Экспорт
	
	//Проверяем наличие дублей
	ЗапросДублиНомерКвитанции = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//			   |	ВН.Ссылка,
	//			   |	ВН.НомерСтроки,
	//			   |	ВН.Дата КАК Дата,
	//			   |	ВН.НомерКвитанции,
	//			   |	ВН.Номер
	//			   |ИЗ
	//			   |	(ВЫБРАТЬ
	//			   |		О.Ссылка КАК Ссылка,
	//			   |		КОЛИЧЕСТВО(О1.Ссылка) КАК НомерСтроки,
	//			   |		О.Дата КАК Дата,
	//			   |		О.НомерКвитанции КАК НомерКвитанции,
	//			   |		О.Номер КАК Номер
	//			   |	ИЗ
	//			   |		Документ.уб_ОплатаПолисов КАК О
	//			   |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК О1
	//			   |			ПО О.Дата >= О1.Дата
	//			   |	ГДЕ
	//			   |		О.СтраховойПолис = &СтраховойПолис
	//			   |		И О1.СтраховойПолис = &СтраховойПолис
	//			   |	    И НЕ О.ПометкаУдаления
	//			   |	    И НЕ О1.ПометкаУдаления
	//			   |	СГРУППИРОВАТЬ ПО
	//			   |		О.Ссылка,
	//			   |		О.Дата,
	//			   |		О.НомерКвитанции) КАК ВН
	//			   |ГДЕ
	//			   |	ИСТИНА
	//			   |	И ВН.НомерКвитанции = &НомерКвитанции
	//			   |	И ВН.Ссылка <> &Ссылка
	//			   |
	//			   |УПОРЯДОЧИТЬ ПО
	//			   |	Дата";
	ЗапросДублиНомерКвитанции.Текст = 
	"ВЫБРАТЬ
	|	О.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(О1.Ссылка) КАК НомерСтроки,
	|	О.Дата КАК Дата,
	|	О.НомерКвитанции КАК НомерКвитанции,
	|	О.Номер КАК Номер
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК О1
	|		ПО О.Дата >= О1.Дата
	|			И О.СтраховойПолис = О1.СтраховойПолис
	|ГДЕ
	|	О.СтраховойПолис = &СтраховойПолис
	|	И О.НомерКвитанции = &НомерКвитанции
	|	И О.ЕстьКвитанция = Истина
	|	И О1.ЕстьКвитанция = Истина
	|	И НЕ О.ПометкаУдаления
	|	И НЕ О1.ПометкаУдаления
	|	И О.Ссылка <> &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Ссылка,
	|	О.Дата,
	|	О.НомерКвитанции,
	|	О.Номер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	ЗапросДублиНомерКвитанции.УстановитьПараметр("СтраховойПолис", Оплата.СтраховойПолис);
	ЗапросДублиНомерКвитанции.УстановитьПараметр("Ссылка", 		Оплата.Ссылка);
	ЗапросДублиНомерКвитанции.УстановитьПараметр("НомерКвитанции", Оплата.НомерКвитанции);
	Выборка = ЗапросДублиНомерКвитанции.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ПустаяСтрока(Выборка.НомерКвитанции) Тогда
			СОО = СОО+"Дублирование номера квитанции " + Выборка.НомерКвитанции + " в оплате № " + 
			Выборка.НомерСтроки + " (Sys № документа оплаты: " + Выборка.Номер + ")"+Разделитель; 	
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;	
	
КонецФункции

Функция ОП_ПроверитьТекущую(
	оОплатыСписок
	, СообщатьОбОшибках = Истина
	, Откуда
	, ТипСообщения = 1
	, Форма = Неопределено
	) Экспорт
	
	ТекСтрока = оОплатыСписок.ТекущаяСтрока;   
	Если ТекСтрока = Неопределено Тогда
		ТекСтрока = оОплатыСписок.ТекущиеДанные;   
	КонецЕсли;
	Если ТекСтрока = Неопределено Тогда
		Возврат Истина;   
	КонецЕсли;
	
	оСтраховойПолис = ТекСтрока.СтраховойПолис;   
	
	ТзОшибки = СоздатьТаблицуОшибок();
	
	ОП_Проверить( 			ТзОшибки
	, оОплатыСписок
	, ТекСтрока
	, Ложь
	, Ложь
	, Истина
	, Ложь
	, оСтраховойПолис
	, оСтраховойПолис.ОтключитьКонтрольНомеровБСО
	, Откуда
	);
	
	Если ТзОшибки.Количество() <> 0 Тогда
		Если СообщатьОбОшибках Тогда
			Если ТипСообщения = 0 Тогда
				ОткрытьСообщениеОбОшибках(ТзОшибки, Форма);
			Иначе
				СообщитьСОО(ТзОшибки);
			КонецЕсли;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	#Если Клиент Тогда
		Предупреждение("Оплата ОК!",10,"Проверка оплаты");
	#Иначе
		Сообщить("Оплата ОК! Проверка оплаты");
	#КонецЕсли
	Возврат Истина;
	
КонецФункции

Функция ОП_ПолучитьСтатус(Оплата, СОО = "", ДанныеПоПолисуСОплатой = Ложь, Разделитель ="; ") Экспорт
	
	ОплатаОК = ОП_ПроверитьБыстро(Оплата, СОО, Истина, Ложь, ДанныеПоПолисуСОплатой,Разделитель);
	Возврат ?(Оплата.ОтчетАгента.Проведен,?(ОплатаОК,1,3),?(ОплатаОК,0,2));
	
КонецФункции

Функция ОП_ПолучитьСтатусКвитанции(Оплата) Экспорт
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	sКвитанция = СокрЛП(Оплата.НомерКвитанции);
	Если НЕ Оплата.ЕстьКвитанция Тогда
		Возврат 0; 
	КонецЕсли;
	Если sКвитанция = "" Тогда
		Если СистемаНаправлениеПлатежа Тогда
			Возврат ?(Оплата.ЕстьКвитанция, 1, 0); 
		Иначе
			Возврат ?(Оплата.ФормаОплаты <> Перечисления.уб_ФормыОплаты.Касса, 0, 1);
		КонецЕсли;
	КонецЕсли;
	Возврат ?(ЕстьДвиженияКвитанцииИзОплаты(Оплата),2,0);
	
КонецФункции

Процедура ОП_УстановитьВидимостьКолонокПоРолям(oОплатыСписок) Экспорт
	
	Если РольДоступна("уб_МенеджерНаТочке") Тогда
		СкрытьКолонку(oОплатыСписок, "КВСумма");
		СкрытьКолонку(oОплатыСписок, "КВПроцент");
		СкрытьКолонку(oОплатыСписок, "НеМенятьКВ");
		СкрытьКолонку(oОплатыСписок, "ВознаграждениеМенеджера");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОП_УстановитьОтборПоРеквизиту(Форма, ИмяРеквизитаСписка, ИмяРеквизита, ЗначениеРеквизита, СкрыватьКолонку = Истина) Экспорт
