Функция ДайМЗКвитовкиОплат(УИДСтроки, ОплатаСсылка) Экспорт
	ВыборкаРС = РегистрыСведений.уб_КвитовкаОплат.Выбрать(Новый Структура("УИДСтрокиТЧ",УИДстроки));
	МЗ = Неопределено;
	МЗНайден = Ложь;
	Пока ВыборкаРС.Следующий() Цикл
		Если ОплатаСсылка <> ВыборкаРС.ОплатаПолиса Тогда
			Продолжить;	
		КонецЕсли;
		Если НЕ МЗНайден Тогда
			МЗ = ВыборкаРС.ПолучитьМенеджерЗаписи();	
			МЗНайден = Истина;
		Иначе	
			//В регистре должна быть только одна запись для УИДстроки и Оплаты
			ВыборкаРС.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
	КонецЦикла;
	Возврат МЗ;
КонецФункции

Функция Получить_группу_связанных_квитовок(УИДСтрокиТЧ, ТолькоУникальныеУИДыВМассиве = Истина) Экспорт
	//Получаем перечень связанных квитовок для переданного УИДСтрокиТЧ
	//УИДСтрокиТЧ -> Оплаты -> Приемки ->  Оплаты -> УИДы Строк ТЧ
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УИДСтрокиТЧ", УИДСтрокиТЧ);
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.УИДСтрокиТЧ КАК УИДСтрокиТЧ,
	|	К.ОплатаПолиса
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|ГДЕ
	|	К.ОплатаПолиса В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				К2.ОплатаПолиса
	|			ИЗ
	|				РегистрСведений.уб_КвитовкаОплат КАК К2
	|			ГДЕ
	|				К2.УИДСтрокиТЧ В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						К3.УИДСтрокиТЧ КАК УИДСтрокиТЧ
	|					ИЗ
	|						РегистрСведений.уб_КвитовкаОплат КАК К3
	|					ГДЕ
	|						К3.ОплатаПолиса В
	|							(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|								К4.ОплатаПолиса
	|							ИЗ
	|								РегистрСведений.уб_КвитовкаОплат КАК К4
	|							ГДЕ
	|								К4.УИДСтрокиТЧ = &УИДСтрокиТЧ)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	УИДСтрокиТЧ";
	
	Если ТолькоУникальныеУИДыВМассиве Тогда
		// TODO Это нигде не используется
		Запрос.Текст = СтрЗаменить(ТекстЗапроса,"К.ОплатаПолиса","1 КАК МестоЗамены");
		ТЗКвитовок = Запрос.Выполнить().Выгрузить();
		ТЗКвитовок.Свернуть("УИДСтрокиТЧ"); //TODO есть же различные в запросе
		МассивУИДов = ТЗКвитовок.ВыгрузитьКолонку("УИДСтрокиТЧ"); //TODO отправляется массив
		Возврат МассивУИДов;
	Иначе
		Запрос.Текст = ТекстЗапроса;
		ТЗКвитовок = Запрос.Выполнить().Выгрузить();
		Возврат ТЗКвитовок;
	КонецЕсли;
	
КонецФункции

Функция ОбновитьУИДГруппыКвитовок(Параметр, Источник = Неопределено, Оповещать = Истина) Экспорт
	//В качестве параметра может быть передан как отдельный УИДСтрокиТЧ, так и массив с УИД-ами	
	//В первом случае создаем массив искуственно с одной записью
	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		МассивКвитовок0 = Новый Массив();
		МассивКвитовок0.Добавить(Параметр);
	ИначеЕсли ТипЗнч(Параметр) = Тип("Массив") Тогда
		МассивКвитовок0 = Параметр;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	//Анализируем ветки связей М-М и создаем уникальные группы в Соответствии
	СоотвГрупп = Новый Соответствие();
	
	Для Каждого УИДСтроки из МассивКвитовок0 Цикл
		ТЗКвитовок = Получить_группу_связанных_квитовок(УИДСтроки, Ложь);
		Если ТЗКвитовок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ТЗКвитовок[0].УИДСтрокиТЧ;
		
		Элемент = СоотвГрупп.Получить(Ключ);
		Если Элемент = Неопределено Тогда
			СоотвГрупп.Вставить(Ключ, ТЗКвитовок);
		КонецЕсли;
	КонецЦикла;
	
	
	Для каждого Элемент из СоотвГрупп Цикл 
		ТЗКвитовок = Элемент.Значение;
		УИДГруппы = Элемент.Ключ;
		бМногиеКоМногим = ТЗКвитовок.Количество() > 1;	
		
		Для Каждого Стр из ТЗКвитовок Цикл
			МЗ = РегистрыСведений.уб_КвитовкаОплат.СоздатьМенеджерЗаписи();
			
			МЗ.УИДСтрокиТЧ = Стр.УИДСтрокиТЧ;
			МЗ.ОплатаПолиса = Стр.ОплатаПолиса;
			
			МЗ.Прочитать();
			
			Если МЗ.Выбран() Тогда
				
				МЗ.УИДГруппы = УИДГруппы;
				МЗ.МногиеКоМногим = бМногиеКоМногим;
				Попытка
					МЗ.Записать();
					Если Оповещать Тогда
						СтруктураИзменяемойКвитовки = ОбщегоНазначения.ПолучитьСтруктуруИзЗаписиРегистраСведений("уб_КвитовкаОплат", МЗ);
						#Если Клиент Тогда
							Оповестить("ПослеИзмененияКвитовки", СтруктураИзменяемойКвитовки, Источник);
						#КонецЕсли
					КонецЕсли;
				Исключение
					Сообщить("Ошибка при записи группы квитовки оплат. Описание ошибки: 
					|	" + ОписаниеОшибки(),СтатусСообщения.ОченьВажное);
					Возврат Ложь;
				КонецПопытки;
			Иначе	
				Сообщить("Не удалось найти МЗ для УИДСтрокиТЧ: " + Стр.УИДСтрокиТЧ + " и Оплаты: " + Строка(Стр.ОплатаПолиса)); 
			КонецЕсли;
		КонецЦикла; // ТЗКвитовок
	КонецЦикла; //	СоотвГрупп
	
	Возврат Истина;
КонецФункции

Функция ДобавитьКвитовкуОплат(УИДСтроки, ПриемкаСсылка, ОплатаСсылка, Источник = Неопределено) Экспорт
	МЗ = ДайМЗКвитовкиОплат(УИДСтроки, ОплатаСсылка);
	Если МЗ = Неопределено Тогда
		МЗ = РегистрыСведений.уб_КвитовкаОплат.СоздатьМенеджерЗаписи();	
	КонецЕсли;
	
	МЗ.УИДСтрокиТЧ = УИДстроки;	
	МЗ.ОплатаПолиса = ОплатаСсылка;	
	МЗ.ДатаКвитовки = ТекущаяДата();	
	МЗ.ПриемОплаты = ПриемкаСсылка;	
	
	Попытка
		МЗ.Записать();
		Если ОбновитьУИДГруппыКвитовок(УИДстроки, Источник) Тогда
			СтруктураДобавляемойКвитовки = ОбщегоНазначения.ПолучитьСтруктуруИзЗаписиРегистраСведений("уб_КвитовкаОплат", МЗ);
			#Если Клиент Тогда
				Оповестить("ПослеИзмененияКвитовки", СтруктураДобавляемойКвитовки, Источник);
			#КонецЕсли
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		Сообщить("Ошибка при записи квитовки оплат
		|Описание ошибки: 
		|	" + ОписаниеОшибки(),СтатусСообщения.ОченьВажное);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция УдалитьКвитовкуПоМЗ(МЗ, Источник = Неопределено) Экспорт
	Если МЗ = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		УИДСтрокиТЧ = МЗ.УИДСтрокиТЧ;
		СтруктураУдаляемлойКвитовки = ОбщегоНазначения.ПолучитьСтруктуруИзЗаписиРегистраСведений("уб_КвитовкаОплат", МЗ);
		ТЗКвитовок = Получить_группу_связанных_квитовок(УИДСтрокиТЧ, Ложь);
		
		МЗ.Удалить();
		
		//Обновляем значения группы квитовок
		ТЗКвитовок2 = ТЗКвитовок.Скопировать();
		ТЗКвитовок2.Свернуть("УИДСтрокиТЧ");
		МассивКвитовок = ТЗКвитовок2.ВыгрузитьКолонку("УИДСтрокиТЧ");
		
		Если ОбновитьУИДГруппыКвитовок(МассивКвитовок, Источник, Ложь) Тогда
			Для Каждого Стр из ТЗКвитовок Цикл
				
				МЗ = РегистрыСведений.уб_КвитовкаОплат.СоздатьМенеджерЗаписи();
				МЗ.УИДСтрокиТЧ = Стр.УИДСтрокиТЧ;
				МЗ.ОплатаПолиса = Стр.ОплатаПолиса;
				МЗ.Прочитать();
				Если МЗ.Выбран() Тогда
					СтруктураУдаляемлойКвитовки = ОбщегоНазначения.ПолучитьСтруктуруИзЗаписиРегистраСведений("уб_КвитовкаОплат", МЗ);
					#Если Клиент Тогда
						Оповестить("ПослеИзмененияКвитовки", СтруктураУдаляемлойКвитовки, Источник);
					#КонецЕсли
				КонецЕсли;	
				
			КонецЦикла;		
			
			Возврат Истина;
		КонецЕсли;
	Исключение
		Сообщить("Не удалось удалить квитовку оплат: № Приемки: " + МЗ.ПриемОплаты.Номер + ", УИДСтроки: " 
		+ МЗ.УИДСтрокиТЧ + ", № Оплаты: " +  + МЗ.ОплатаПолиса.Номер + ". " + ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;	
	
	Возврат Ложь;
КонецФункции

Функция УдалитьКвитовки(УИДСтрокиТЧ = Неопределено, ОплатаСсылка = Неопределено, ПриемкаСсылка = Неопределено, Источник = Неопределено) Экспорт
	Если УИДСтрокиТЧ = Неопределено Тогда
		Если НЕ ЗначениеНеЗаполнено(ОплатаСсылка) Тогда
			//Удаление всех квитовок для Оплаты	
			СтруктураВыборки = Новый Структура("ОплатаПолиса", ОплатаСсылка);	
		ИначеЕсли НЕ ЗначениеНеЗаполнено(ПриемкаСсылка) Тогда
			//Удаление всех квитовок для документа Приемки	
			СтруктураВыборки = Новый Структура("ПриемОплаты", ПриемкаСсылка);	
		Иначе
			// не передано ни одного значимого аргумента
			Возврат Ложь;
		КонецЕсли;
	Иначе	
		//Если ОплатаСсылка <> Неопределено, то это - удаление конкретной квитовки (для конкретных строки приемки и Оплаты)	
		//и далее потребуется проверять все записи выборки на соответствие ОплатаСсылка = ВыборкаРС.ОплатаПолиса
		
		//Если ОплатаСсылка = Неопределено
		//то это - удаление всех квитовок для строки приемки 
		СтруктураВыборки = Новый Структура("УИДСтрокиТЧ", УИДСтрокиТЧ);	
	КонецЕсли;
	
	ВыборкаРС = РегистрыСведений.уб_КвитовкаОплат.Выбрать(СтруктураВыборки); 
	Пока ВыборкаРС.Следующий() Цикл
		Если ОплатаСсылка <> Неопределено И ОплатаСсылка <> ВыборкаРС.ОплатаПолиса Тогда
			Продолжить;	
		КонецЕсли;
		МЗ = ВыборкаРС.ПолучитьМенеджерЗаписи();	
		Если НЕ УдалитьКвитовкуПоМЗ(МЗ, Источник) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

//
Функция ПолучитьУИДГруппыКвитовки(Параметр) Экспорт
	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		ТекстУсловия = " К.УИДСтрокиТЧ = &Параметр";
	ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		ТекстУсловия = "К.ОплатаПолиса = &Параметр";
	Иначе
		Возврат ЛОЖЬ;
	КонецЕсли;
	ЗапросУИДГруппыКвитовки = Новый Запрос;
	ЗапросУИДГруппыКвитовки.УстановитьПараметр("Параметр", Параметр);
	ЗапросУИДГруппыКвитовки.Текст = "ВЫБРАТЬ
	|	К.УИДГруппы
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|ГДЕ " + ТекстУсловия;
	Выборка = ЗапросУИДГруппыКвитовки.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	УИДГруппы = Выборка.УИДГруппы;
	
	Возврат  УИДГруппы;
	
КонецФункции	

Функция ПолучитьСквитованныеПриемки(УИДГруппы,ОбъектПриемкиИлиОплаты) Экспорт
	
	//Признак сквитованности приемок и оплат: приемка1+приемка2+приемка3 = оплата1+оплата2  (5+5+(-2) = 0+8)
	
	//Алгоритм:
	//Для переданного УИДСтрокиТЧ ищем УИДгруппы.
	//	Если УИДгруппы есть, то это квитовка многие-ко-многим
	//	   по группе ней находим все приемки и все оплаты. Суммируем суммы, сравниваем.
	//	Если УИДгруппы нет, то это квитовка 1-к-1. Сравниваем сумму по строке приемки и в оплате. 
	//	
	//	Для каждой найденной оплаты найти все привязанные приемки
	
	//Если аргумент ОбновлятьФлаг_НетКвитовкиПоСуммамОплат_ВпрочихПриемках = ИСТИНА
	//То для всех найденных несквитованных оплат ищутся все строки приемок и затем все 
	// документы приемок, в которых они входят. Для всех них устанавливается флаг НетКвитовкиПоСуммамОплат 
	
	//Находим список связанных приемок
	ЗапросСквитованныеПриемки = Новый Запрос;
	ЗапросСквитованныеПриемки.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	П.Ссылка КАК ПриемОплаты,
	|	К.УИДСтрокиТЧ КАК УИДСтрокиТЧ,
	|	П.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК П
	|		ПО К.УИДСтрокиТЧ = П.УИДСтроки
	|ГДЕ
	|	К.УИДГруппы = &УИДГруппы";
	ЗапросСквитованныеПриемки.УстановитьПараметр("УИДГруппы", УИДГруппы);
	Рез = ЗапросСквитованныеПриемки.Выполнить();
	тзНесквитованныхПриемокДляОбновления = Рез.Выгрузить();
	//В этот момент мы имеем выборку из базы, но если сумма изменена, а документ не записан, то суммы там не актуальны.
	//А вызов происходит в процедуре "перед записью"
	//Поэтому надо актуализировать суммы в ТЗ:
	Если ТипЗнч(ОбъектПриемкиИлиОплаты) = Тип("ДокументОбъект.уб_ПриемкаОплат") Тогда
		Для каждого Стр Из ОбъектПриемкиИлиОплаты.Полисы Цикл
			НайденнаяСтрока = тзНесквитованныхПриемокДляОбновления.Найти(Стр.УИДСтроки, "УИДСтрокиТЧ");
			Если НайденнаяСтрока <> Неопределено Тогда
				НайденнаяСтрока.Сумма = Стр.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат тзНесквитованныхПриемокДляОбновления;
КонецФункции	

Функция ПолучитьСквитованныеОплаты(УИДГруппы,ОбъектОплаты = Неопределено)  Экспорт
	ЗапросСквитованныеОплаты = Новый Запрос;
	ЗапросСквитованныеОплаты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.ОплатаПолиса.Ссылка КАК ОплатаПолиса,
	|	К.ОплатаПолиса.ОплаченоФакт КАК СуммаОплаты,
	//|	ВЫБОР
	//|		КОГДА К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам
	//|			ТОГДА 0
	//|		ИНАЧЕ К.ОплатаПолиса.АВилиСкидкаСумма
	//|	КОНЕЦ
	|К.ОплатаПолиса.АВилиСкидкаСумма КАК АВилиСкидкаСумма,
	|	ВЫБОР
	|		КОГДА К.ОплатаПолиса.НачисленнаяСуммаВзноса=0 //---Отключено---//К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам
	|			ТОГДА 0
	|		ИНАЧЕ К.ОплатаПолиса.КВСумма
	|	КОНЕЦ КАК КВСумма,
	|	ВЫБОР
	|		КОГДА К.ОплатаПолиса.НачисленнаяСуммаВзноса=0 //---Отключено---//К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам
	|			ТОГДА 0
	|		ИНАЧЕ К.ОплатаПолиса.КВСуммаДляАгента
	|	КОНЕЦ КАК КВСуммаДляАгента,
	|	К.ОплатаПолиса.ВознаграждениеМенеджера КАК ВознаграждениеМенеджера,
	|	К.ОплатаПолиса.ВидРасчетаСАгентом КАК ВидРасчетаСАгентом,
	|   К.ОплатаПолиса.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзносаВкл,
	//Если не включается в отчет, то и сумму не включаем в начисления ,
	//пока отключаем такой механизм
	//|	ВЫБОР
	//|		КОГДА К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам
	//|			ТОГДА 0
	//|		ИНАЧЕ К.ОплатаПолиса.НачисленнаяСуммаВзноса
	//|	КОНЕЦ КАК НачисленнаяСуммаВзносаВкл,
	|	К.ОплатаПолиса.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
	|	К.ОплатаПолиса.СуммаДоп КАК СуммаДоп,
	|	ВЫБОР КОГДА К.ОплатаПолиса.ВидРасчетаСАгентом = ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ) Тогда 0 иначе  К.ОплатаПолиса.СкидкаВыплаченаяКлиенту конец КАК СкидкаВыплаченаяКлиенту,
	|	К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам КАК НеВключатьВОтчетыПоставщикам,
	|   К.ОплатаПолиса.ОтчетПоставщику КАК ОтчетПоставщику,
	|   Выбор КОГДА К.ОплатаПолиса = &ОбъектОплаты Тогда ИСТИНА
	|   Иначе ЛОЖЬ Конец ЭтоТекущаяОплата
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|ГДЕ
	|	К.УИДГруппы = &УИДГруппы
	|Упорядочить ПО ЭтоТекущаяОплата УБЫВ";
	ЗапросСквитованныеОплаты.УстановитьПараметр("УИДГруппы",УИДГруппы);
	ЗапросСквитованныеОплаты.УстановитьПараметр("ОбъектОплаты",ОбъектОплаты.ССылка);
	Рез = ЗапросСквитованныеОплаты.Выполнить();
	тзОплат = Рез.Выгрузить();
	Если НЕ ОбъектОплаты = Неопределено Тогда
		ОбновитьДанныеОплатыВКвитовке(тзОплат, ОбъектОплаты);
	КонецЕсли;	
	Возврат тзОплат; 
КонецФункции	

Функция КвитовкаПоСуммам(
	Параметр, 
	тзНесквитованныхПриемокДляОбновления 	= Неопределено, 
	СуммаПоПриемкам 						= Неопределено, 
	СуммаПоОплатам 							= Неопределено, 
	ОбъектПриемкиИлиОплаты 					= Неопределено,
	//Если заданы тзОплат,тзПриемок,УИДГруппы, то они не перезаполняются  - проверяется только квитовка сумм
	тзОплат 								= Неопределено,
	тзПриемок 								= Неопределено,
	УИДГруппы = Неопределено) Экспорт
	
	Если УИДГруппы = Неопределено Тогда
		УИДГруппы = ПолучитьУИДГруппыКвитовки(Параметр);
	КонецЕсли;
	СуммаПоПриемкам = 0; //TODO проверить возможна ли ошибка при незаданных при обработке результата функции
	СуммаПоОплатам  = 0; //TODO проверить возможна ли ошибка при незаданных при обработке результата функции
	Если УИДГруппы = ЛОЖЬ Тогда
		Если тзОплат = Неопределено Тогда
			тзОплат = ПустаяТЗОплат();
		КонецЕсли;
		Возврат ЛОЖЬ;
	КонецЕсли;	
	
	//Для переданной строки проверяет, совпадают ли суммы всех ПРИЕМОК ОПЛАТ и ОПЛАТ ПОЛИСОВ,
	//которые по цепочке связаны с данной строкой приемки
	//Например:
	//					   
	//приемка1 <----| <------|      Приняли деньги, часть суммы = 5р (полная сумма - 10р)
	//              |        |
	//	        оплата1      |      Внесли оплату на 10р, связали с приемкой1
	//              |        |
	//приемка2 <----| <------|      Приняли еще 5р, подвязали к оплате1
	//	                     |
	//	        оплата2----->|      Переписали полис, в оплата1 - изменили сумму на 0р, 
	//	                     |      в новом полисе создали оплату2 на 8р (новая премия) и привязали к приемке1 и приемке2
	//приемка3 (-2р)    <----|      Создали приемку на -2р (Возврат денег клиенту) и связали с оплатой 2
	
	//В итоге, получаем связи:
	//приемка1 - оплата1
	//приемка1 - оплата2
	//приемка2 - оплата1
	//приемка2 - оплата2
	//приемка3 - оплата2
	//
	Если тзПриемок = Неопределено Тогда
		тзПриемок = ПолучитьСквитованныеПриемки(УИДГруппы,ОбъектПриемкиИлиОплаты);
	КонецЕсли;	
	Если тзПриемок.Количество()= 0 Тогда
		Если тзОплат = Неопределено Тогда
			тзОплат = ПустаяТЗОплат();
		КонецЕсли;
		Возврат ЛОЖЬ;
	КонецЕсли;	
	//Находим список связанных оплат 
	Если тзОплат = Неопределено Тогда
		тзОплат = ПолучитьСквитованныеОплаты(УИДГруппы,ОбъектПриемкиИлиОплаты)
	КонецЕсли;	
	Если тзОплат.Количество()= 0 Тогда
		Возврат ЛОЖЬ;
	Конецесли;	
	
	СуммаПоПриемкам = тзПриемок.Итог("Сумма");
	
	СуммаПоОплатам = тзОплат.Итог("СуммаОплаты");//-тзОплат.Итог("СкидкаВыплаченаяКлиенту");
	
	Если СуммаПоПриемкам = СуммаПоОплатам Тогда
		//Очистим таблицу значений, что бы не обновлялись приемки оплат 
		тзНесквитованныхПриемокДляОбновления = Новый ТаблицаЗначений;
		Возврат Истина;
	Иначе
		тзНесквитованныхПриемокДляОбновления = тзПриемок.Скопировать();
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ОбновитьДанныеОплатыВКвитовке(тзОплат,ОбъектОплаты) Экспорт
	Если ТипЗнч(ОбъектОплаты) = Тип("ДокументОбъект.уб_ОплатаПолисов") Тогда
		//Дополнение актуальными данными из объекта
		НайденнаяСтрока = тзОплат.Найти(ОбъектОплаты.Ссылка, "ОплатаПолиса");
		Если НайденнаяСтрока <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ОбъектОплаты);
			//Не совпадающие по именам или требуется корректировка
			НайденнаяСтрока.СуммаОплаты                  = ОбъектОплаты.ОплаченоФакт;
			НайденнаяСтрока.АВилиСкидкаСумма             = ?(ОбъектОплаты.НачисленнаяСуммаВзноса=0,0,ОбъектОплаты.АВилиСкидкаСумма); 
			НайденнаяСтрока.КВСумма                      = ?(ОбъектОплаты.НачисленнаяСуммаВзноса=0,0,ОбъектОплаты.КВСумма);
			НайденнаяСтрока.КВСуммаДляАгента             = ?(ОбъектОплаты.НачисленнаяСуммаВзноса=0,0,ОбъектОплаты.КВСуммаДляАгента); 
			НайденнаяСтрока.НачисленнаяСуммаВзносаВкл    = ОбъектОплаты.НачисленнаяСуммаВзноса;//Пока отключено?(ОбъектПриемкиИлиОплаты.НеВключатьВОтчетыПоставщикам,0,ОбъектПриемкиИлиОплаты.НачисленнаяСуммаВзноса);
			НайденнаяСтрока.СкидкаВыплаченаяКлиенту      = ?(ОбъектОплаты.ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ,0,ОбъектОплаты.СкидкаВыплаченаяКлиенту);
			
			
			//НайденнаяСтрока.ВознаграждениеМенеджера      = ОбъектОплаты.ВознаграждениеМенеджера; 
			//НайденнаяСтрока.ВидРасчетаСАгентом           = ОбъектОплаты.ВидРасчетаСАгентом; 
			//НайденнаяСтрока.НачисленнаяСуммаВзноса       = ОбъектОплаты.НачисленнаяСуммаВзноса;
			//НайденнаяСтрока.СуммаДоп       				 = ОбъектОплаты.СуммаДоп;
			//НайденнаяСтрока.СкидкаВыплаченаяКлиенту      = ОбъектОплаты.СкидкаВыплаченаяКлиенту;
			//НайденнаяСтрока.НеВключатьВОтчетыПоставщикам = ОбъектОплаты.НеВключатьВОтчетыПоставщикам;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПустаяТЗОплат()
	тзОплат = Новый ТаблицаЗначений;
	тзОплат.Колонки.Добавить("ОплатаПолиса");
	тзОплат.Колонки.Добавить("СуммаОплаты");
	тзОплат.Колонки.Добавить("АВилиСкидкаСумма");
	тзОплат.Колонки.Добавить("КВСумма");
	тзОплат.Колонки.Добавить("КВСуммаДляАгента");
	тзОплат.Колонки.Добавить("ВознаграждениеМенеджера");
	тзОплат.Колонки.Добавить("ВидРасчетаСАгентом");
	тзОплат.Колонки.Добавить("НачисленнаяСуммаВзноса");
	тзОплат.Колонки.Добавить("НачисленнаяСуммаВзносаВкл");//Начислено по включенным в отчет
	тзОплат.Колонки.Добавить("СуммаДоп");
	тзОплат.Колонки.Добавить("СкидкаВыплаченаяКлиенту");
	тзОплат.Колонки.Добавить("НеВключатьВОтчетыПоставщикам");
	тзОплат.Колонки.Добавить("ОтчетПоставщику");
	Возврат тзОплат;
КонецФункции

	
