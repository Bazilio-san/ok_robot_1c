Функция ПолучитьБСОТипаКвА7дляСтраховогоПродукта(оСтраховойПродукт) Экспорт
	
	оБСО = Новый Структура("Существует, ВидБСО, ТипБСО, Обязательно, НазначениеБСО, ТипУчетаБСО, НомернойУчет", Ложь); 
	Если ЗначениеНеЗаполнено(оСтраховойПродукт) Тогда
		Возврат оБСО;
	КонецЕсли;
	Если ТипЗнч(оСтраховойПродукт) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
		типКвА7 = Перечисления.уб_ТипыБСО.КвитанцияА7;
		Для Каждого ОВ из оСтраховойПродукт.ВидыБСО Цикл
			Если ОВ.ВидБСО.Тип = типКвА7 Тогда
				оБСО.Существует = Истина;
				оБСО.ВидБСО = ОВ.ВидБСО;
				оБСО.ТипБСО = типКвА7;
				оБСО.Обязательно = ОВ.Обязательно;
				оБСО.НазначениеБСО = ОВ.НазначениеБСО;
				оБСО.ТипУчетаБСО = ОВ.ВидБСО.ТипУчетаБСО;
				оБСО.НомернойУчет = Истина; //уб_СЛ.ОпределитьВедетсяНомернойУчет(ОВ.ВидБСО);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат оБСО;
КонецФункции

