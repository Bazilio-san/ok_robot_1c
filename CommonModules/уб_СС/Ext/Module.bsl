Функция ПолучитьФИНОтветственного() Экспорт
	ОсновнаяОрганизация  = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОсновнаяОрганизация");
	
	ОЛ = ОбщегоНазначения.ОтветственныеЛица(ОсновнаяОрганизация,ТекущаяДата());
	
	Если НЕ ЗначениеНеЗаполнено(ОЛ.ФинОтветственный) Тогда
		Возврат ОЛ.ФинОтветственный;	
	Иначе
		Возврат ОЛ.ГлавныйБухгалтер;	
	КонецЕсли;
	
КонецФункции

Функция РискВходитВСтраховойПродукт(СтраховойПродукт, Риск) Экспорт 
	Для Каждого ОР из СтраховойПродукт.ТипыОбъектовИРиски Цикл
		Если Риск = ОР.Риск Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ВидБСОВходитВСтраховойПродукт(СтраховойПродукт, ВидБСО) Экспорт 
	Для Каждого ОВ из СтраховойПродукт.ВидыБСО Цикл
		Если ВидБСО = ОВ.ВидБСО Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

//Истина, если Подразделение является самим или дочерним Подразделению Верх
Функция ПодразделениеВходитВПодразделениеВерх(ПодразделениеВерх,Подразделение) Экспорт
	Если ЗначениеНеЗаполнено(ПодразделениеВерх) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеНеЗаполнено(Подразделение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПодразделениеВерх = Подразделение Тогда
		Возврат Истина;
	Иначе
		Возврат ПодразделениеВходитВПодразделениеВерх(ПодразделениеВерх,Подразделение.Родитель);
	КонецЕсли;
КонецФункции

Функция АгентИзПодразделенияПользователя(оПользователь,Агент) Экспорт 
	
	ПодразделениеПользователя = ПолучитьПодразделениеАгента(оПользователь.ФизЛицо);
	Если ЗначениеНеЗАполнено(ПодразделениеПользователя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПодразделениеАгента = ПолучитьПодразделениеАгента(Агент);
	Если ЗначениеНеЗАполнено(ПодразделениеАгента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПодразделениеВходитВПодразделениеВерх(ПодразделениеПользователя,ПодразделениеАгента);
КонецФункции

