Функция ПроверкиНомерныхДвижений(
	СтрокаТЗ, 
	СтрокаРС, 
	Отказ, 
	ИнфоЗапись,
	Пересортица 		= Ложь,
	ПроверкаПоложения 	= Истина,
	Заголовок,
	СооХвост,
	НеКонтролироватьНаличиеБСОПриПроведении = Ложь,
	ТЗОшибок,
	СтруктураПараметров,
	НомерСтроки) Экспорт
	
	ТипЗнчСсылка = ТипЗнч(СтруктураПараметров.Ссылка);
	ЭтоПеремещениеБСО = Ложь;
	ЭтоПередачаБСОПоставщику = Ложь;
	ЭтоВозвратБСООтПоставщика = Ложь;
	ЭтоСписаниеБСО = Ложь;
	ЭтоИнвентаризацияБСО = Ложь;
	ЭтоВводНачальныхОстатковБСО = Ложь;
	ЭтоЗаявка = Ложь;
	
	Если ТипЗнчСсылка = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
		ЭтоПеремещениеБСО = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_ПередачаБСОПоставщику") Тогда
		ЭтоПередачаБСОПоставщику = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_ВозвратБСОотПоставщика") Тогда
		ЭтоВозвратБСООтПоставщика = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_СписаниеБСО") Тогда
		ЭтоСписаниеБСО = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_ИнвентаризацияБСО") Тогда
		ЭтоИнвентаризацияБСО = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_ВводНачальныхОстатковБСО") Тогда
		ЭтоВводНачальныхОстатковБСО = Истина;
	ИначеЕсли ТипЗнчСсылка = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
		ЭтоЗаявка = Истина;	
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НесоответствиеПоставщиков", Ложь);
	Результат.Вставить("НесоответствиеОргАгентов",	Ложь);
	Результат.Вставить("НеверноеПоложение",			Ложь);
	Результат.Вставить("ОшибкаКонтроляОстатков",	Ложь);
	КонтролироватьНаличиеБСО = НЕ ПараметрыСеанса.уб_Константы.уб_КонтролироватьНаличиеБСО = ЛОЖЬ И Не НеКонтролироватьНаличиеБСОПриПроведении;
	СООхвостПересортица = " Проведение разрешено, поскольку установлен флаг ""Пересортица""";
	СОО = "БСО № '" + СтрокаТЗ.НомерБСО + "' [" + СтрокаТЗ.ВидБСО + "], СК: '" + СтрокаТЗ.СК + "'";
	Если Не ИнфоЗапись Тогда
		//контроль БСО
		Если СтрокаРС <> Неопределено Тогда
			//контроль поставщика и оргагента 
			Если Не ЭтоИнвентаризацияБСО Тогда
				Если СтрокаРС.Поставщик <> СтрокаТЗ.Поставщик Тогда
					СОО = СОО + " поступало от поставщика '" + СтрокаРС.Поставщик.Наименование + "'. В документе указан другой поставщик: '" + СтрокаТЗ.Поставщик.Наименование + "'.";
					Если Пересортица Тогда
						Сообщить(СОО + СООхвостПересортица);
					Иначе
						//ОбщегоНазначения.ОшибкаПриПроведении(СОО + СООхвост, Отказ, Заголовок);
						СтрокаОшибки 			= ТЗОшибок.Добавить();
						СтрокаОшибки.Ошибка 	= СОО + СООхвост;
						СтрокаОшибки.Строка		= НомерСтроки - 1;
						СтрокаОшибки.Элемент	= "БСО";
						Отказ = Истина;
						Результат.НесоответствиеПоставщиков = Истина;
					КонецЕсли;
				КонецЕсли;
				Если СтрокаРС.ОрганизацияАгент <> СтрокаТЗ.ОрганизацияАгент Тогда
					СОО = СОО + " поступало в ОргАгент '" + СтрокаРС.ОрганизацияАгент.Наименование +"'. В документе указан другой ОргАгент: '" + СтрокаТЗ.ОрганизацияАгент.Наименование + "'.";
					Если Пересортица Тогда
						Сообщить(СОО + СООхвостПересортица);	
					Иначе
						//ОбщегоНазначения.ОшибкаПриПроведении(СОО + СООхвост, Отказ, Заголовок);
						СтрокаОшибки 			= ТЗОшибок.Добавить();					
						СтрокаОшибки.Ошибка 	= СОО + СООхвост;
						СтрокаОшибки.Строка		= НомерСтроки - 1;
						СтрокаОшибки.Элемент	= "БСО";
						Отказ = Истина;
						Результат.НесоответствиеОргАгентов = Истина;
					КонецЕсли;
				КонецЕсли;
				Если ЭтоПеремещениеБСО И НЕ ИнфоЗапись И КонтролироватьНаличиеБСО //Тогда
					И СтрокаРС.Агент <> СтрокаТЗ.АгентОтправитель //Тогда
					И НЕ ПеремещениеРазрешено(СтруктураПараметров.Дата, СтрокаТЗ.АгентОтправитель, СтрокаРС.Агент, СтруктураПараметров.ПодразделениеОт, СтруктураПараметров.ПодразделениеКуда, СтрокаРС.Регистратор, СтрокаРС.АгентОтправитель) Тогда
					СОО = СОО + " нет в наличии у агента '" + Строка(СтрокаТЗ.АгентОтправитель) + "'. (числится на '" + Строка(СтрокаРС.Агент) + "')." 
					+ СООхвост;
					//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
					СтрокаОшибки 			= ТЗОшибок.Добавить();
					СтрокаОшибки.Ошибка 	= СОО;
					СтрокаОшибки.Строка		= НомерСтроки - 1;
					СтрокаОшибки.Элемент	= "БСО";
					//Возврат;
					//	КонецЕсли;
					//КонецЕсли;
				КонецЕсли;
			Иначе//если инвентаризация
				ЕстьВНаличие = ИнфоЗапись;
			КонецЕсли;
			
			Если Не ИнфоЗапись И ПроверкаПоложения И КонтролироватьНаличиеБСО
				И (Не ЭтоПеремещениеБСО И Не ЭтоВозвратБСООтПоставщика И СтрокаРС.ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ПереданВСК Или
				ЭтоСписаниеБСО И Перечисления.уб_ПоложенияБСО.Списан = СтрокаРС.ПоложениеБСО Или
				ЭтоПеремещениеБСО И Не уб_СтраховойБрокер.ПоложениеЕстьВНаличие(СтрокаРС.ПоложениеБСО) Или
				ЭтоВозвратБСООтПоставщика И СтрокаРС.ПоложениеБСО <> Перечисления.уб_ПоложенияБСО.ПереданВСК) Тогда
				ЗафиксироватьОшибку = Истина;
				Если ЭтоПередачаБСОПоставщику И СтрокаТЗ.СостояниеБСО = Перечисления.уб_СостоянияБСО.Испорчен Тогда
					//возможна ситуация, когда:
					//1) полис оформлен
					//2) полис аннулирован
					//3) полис передан в СК как оформленный (неверная последовательность действий 2 и 3)
					//4) это движение передает полис как испорченный
					//нужно разрешить проведение
					Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	ИСТИНА КАК ЕстьДвижение
					|ИЗ
					|	РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
					|ГДЕ
					|	уб_ДвиженияБСО.ВидБСО = &ВидБСО
					|	И уб_ДвиженияБСО.НомерБСО = &НомерБСО
					|	И НЕ уб_ДвиженияБСО.Подтверждено
					|	И уб_ДвиженияБСО.КодОперации = &КодОперации
					|	И уб_ДвиженияБСО.Период <= &Период"
					);
					Запрос.УстановитьПараметр("Период",			СтруктураПараметров.Дата);//СтруктураПараметров.ДатаСреза
					Запрос.УстановитьПараметр("ВидБСО", 		СтрокаТЗ.ВидБСО);
					Запрос.УстановитьПараметр("НомерБСО",   	СтрокаТЗ.НомерБСО);
					Запрос.УстановитьПараметр("КодОперации",    Перечисления.уб_КодыОперацийБСО.АннулированиеПолиса);
					РезультатЗапроса = Запрос.Выполнить();
					Если Не РезультатЗапроса.Пустой() Тогда
						Сообщить("Проведение испорченных бланков после аннулирования разрешено");
						ЗафиксироватьОшибку = Ложь;
					КонецЕсли;
				КонецЕсли;
				Если ЭтоПеремещениеБСО И СтрокаРС.СостояниеБСО = Перечисления.уб_СостоянияБСО.НеПолностьюОформлен и СтрокаРС.Заявка = СтруктураПараметров.Ссылка.СозданНаОсновании  Тогда 
					ЗафиксироватьОшибку = Ложь;
				КонецЕсли;
				
				Если ЗафиксироватьОшибку Тогда
					СОО = СОО + " имеет состояние: '" + Строка(СтрокаРС.СостояниеБСО) + "', положение: '" + Строка(СтрокаРС.ПоложениеБСО) + "'.";
					//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
					СтрокаОшибки 			= ТЗОшибок.Добавить();
					СтрокаОшибки.Ошибка 	= СОО;
					СтрокаОшибки.Строка		= НомерСтроки - 1;
					СтрокаОшибки.Элемент	= "БСО";
					//Отказ = (ЭтоЗаявка = ЛОжь);
					Результат.НеверноеПоложение = Истина;
				КонецЕсли;
			ИначеЕсли ЭтоИнвентаризацияБСО Тогда
				ЕстьВНаличие = Истина;//для инвентаризации
			КонецЕсли;
			Если ЭтоИнвентаризацияБСО Тогда
				Если КонтролироватьНаличиеБСО И НЕ ЕстьВНаличие Тогда
					СтрокаСообщения = "БСО с номером `" + СтрокаТЗ.НомерБСО + "` нет в наличии. Передача невозможна!";
					СтрокаОшибки 			= ТЗОшибок.Добавить();
					СтрокаОшибки.Ошибка 	= СОО;
					СтрокаОшибки.Строка		= НомерСтроки - 1;
					СтрокаОшибки.Элемент	= "БСО";
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ЭтоВводНачальныхОстатковБСО Тогда
				Если уб_СЛ.НомерПолисаЗаполняетсяПриПоступлении(СтрокаТЗ.ВидБСО) Тогда
					Если ЗначениеНеЗаполнено(СтрокаТЗ.НомерПолиса) Тогда
						СтрокаСообщения = "Для выбранного вида БСО должно быть заполнено поле НомерПолиса. Строка " + Строка(НомерСтроки);
						//ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
						СтрокаОшибки 			= ТЗОшибок.Добавить();
						СтрокаОшибки.Ошибка 	= СтрокаСообщения;
						СтрокаОшибки.Строка		= НомерСтроки - 1;
						СтрокаОшибки.Элемент	= "БСО";
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли КонтролироватьНаличиеБСО И ЭтоИнвентаризацияБСО Тогда
				СОО = СОО + " не поступало!" + СООхвост;
				//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
				СтрокаОшибки 			= ТЗОшибок.Добавить();
				СтрокаОшибки.Ошибка 	= СОО;
				СтрокаОшибки.Строка		= НомерСтроки - 1;
				СтрокаОшибки.Элемент	= "БСО";
				Отказ = Истина;
				Результат.ОшибкаКонтроляОстатков = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ПеремещениеРазрешено(Дата, Агент, Владелец, ПодрПередающего, ПодрПринимающего, послРегистратор, послАгентОтправитель, ПодрВладельца=Неопределено) Экспорт
	
	Если Агент = Владелец Тогда
		Возврат Истина;	
	КонецЕсли;	
	Если ПодрВладельца = Неопределено Тогда
		ПодрВладельца = уб_СС.ПолучитьПодразделениеАгента(Владелец, Дата);
	КонецЕсли;
	Если Агент = ПодрВладельца Тогда
		//БСО передается от лица подразделения, в которое входит агент-владелец 
		Возврат Истина;	
	КонецЕсли;
	Если (ПодрВладельца = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО И ПодрПередающего = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО) Тогда
		//Владелец В ОУБСО и Передающий в ОУБСО. 
		//Т.е. выдача от лица ОУБСО и при этом бланк числится на сотруднике ОУБСО 
		//или выдача от лица сотрудника ОУБСО и при этом бланк числится на ОУБСО 
		Возврат Истина;	
	КонецЕсли;
	тзнРег = ТипЗнч(послРегистратор);
	Полис_ИЛИ_ПриемкаОплат = (Тип("ДокументСсылка.уб_СтраховойПолис") = тзнРег) ИЛИ (Тип("ДокументСсылка.уб_ПриемкаОплат") = тзнРег);
	Владелец_В_ОУБСО_и_Принимающий_в_ОУБСО = (ПодрВладельца = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО И ПодрПринимающего = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО);
	Если Владелец_В_ОУБСО_и_Принимающий_в_ОУБСО И Полис_ИЛИ_ПриемкаОплат Тогда
		//После проведения из полиса или приемки оплат БСО числится на ОУБСО (Владелец = ОУБСО)
		//Если после оформления полиса мы формируем акт передачи (оформленного) БСО с агента на ОУБСО или сотрудника ОУБСО,
		// то такое перемещение - допустимо
		Возврат Истина;	
	КонецЕсли;	
	ОтправительСовпадает = (послАгентОтправитель = Агент);
	Если ОтправительСовпадает И Полис_ИЛИ_ПриемкаОплат Тогда
		//Аналогично предыдущему случаю, при проведении полиса или приемки оплат отправителем является некий агент
		//(а БСО поступает в ОУБСО)
		//Если после оформления полиса мы формируем акт передачи с того же агента, 
		// то такое перемещение - допустимо
		Возврат Истина;	
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Процедура ПроверкиКоличественныхДвижений(Отказ, Количество, Поставщик, ОргАгент, ВидБСО, Агент, НомерСтроки, Заголовок, СООХвост, ТЗОшибок) Экспорт
	
	//движения количественного учета
	Если Количество = 0 Тогда
		СОО = Строка(ВидБСО) + ": не указано количество для БСО с количественным типом учета. Укажите количество! [строка "+Строка(НомерСтроки)+"] "
		+ СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();					
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	ИначеЕсли Не ЗначениеЗаполнено(Поставщик) Тогда
		СОО = Строка(ВидБСО) + ": не указан Поставщик для БСО с количественным типом учета. Укажите Поставщика!" + СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();					
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	ИначеЕсли Не ЗначениеЗаполнено(ОргАгент) Тогда
		СОО = Строка(ВидБСО) + ": не указана Организация-Агент для БСО с количественным типом учета. Укажите Организацию-Агента!" + СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();					
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	ИначеЕсли Не ЗначениеЗаполнено(Агент) Тогда
		СОО = Строка(ВидБСО) + ": не указан Агент для БСО с количественным типом учета. Укажите Агента!" + СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();					
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДвижениеПоРегистрам(Движения, ТаблицаНомерныхБСО, ТаблицаКоличественныхБСО) Экспорт
	
	Движения.уб_ДвиженияБСО.Очистить();
	Движения.уб_ОстаткиБСО.Очистить();
	Для Каждого СтрокаТЗ Из ТаблицаНомерныхБСО Цикл
		Движение = Движения.уб_ДвиженияБСО.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаТЗ);
	КонецЦикла;
	Для Каждого СтрокаТЗ Из ТаблицаКоличественныхБСО Цикл
		Движение = Движения.уб_ОстаткиБСО.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаТЗ);
	КонецЦикла;
	Движения.уб_ДвиженияБСО.Записать();
	Движения.уб_ОстаткиБСО.Записать();
	
КонецПроцедуры

Функция ПолучитьВыборкуРС(ВыборкаТЧ, Период, Номерной, Отказ, Заголовок, СООХвост, ТЗОшибок) Экспорт
	
	Если Не ПустаяСтрока(ВыборкаТЧ.НомерБСО) Тогда
		Номерной = Истина;
		Возврат ПоследняяЗаписьРегистраДвижений(Период, ВыборкаТЧ.СК, ВыборкаТЧ.ВидБСО, СокрЛП(ВыборкаТЧ.НомерБСО));
	ИначеЕсли ВыборкаТЧ.НомернойУчет Тогда
		СОО = "Не указан номер БСО для [" + Строка(ВыборкаТЧ.ВидБСО) + "] СК: '" + Строка(ВыборкаТЧ.СК) + "', строка " + СокрЛП(ВыборкаТЧ.НомерСтроки) + " " + СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= ВыборкаТЧ.НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	КонецЕсли;
	
КонецФункции // ПолучитьВыборкуРС()

Функция ПолучитьВыборкуРН(СтруктураОтбора, ВыборкаТЧ, Отказ, Заголовок, СООХвост, НеКонтролироватьНаличиеБСОПриПроведении = Ложь, ТЗОшибок) Экспорт
	
	тзРег = уб_СЛ.ПолучитьОстаткиБСО(СтруктураОтбора);
	КолВНаличие = 0;
	ЗаписьРег = Неопределено;
	Если тзРег.Количество() > 0 Тогда
		Результат = тзРег[0];
		КолВНаличие = Результат.Количество;
	КонецЕсли;
	КонтролироватьНаличиеБСО = НЕ ПараметрыСеанса.уб_Константы.уб_КонтролироватьНаличиеБСО = ЛОЖЬ И Не НеКонтролироватьНаличиеБСОПриПроведении;
	Если КонтролироватьНаличиеБСО И ВыборкаТЧ.Количество > КолВНаличие Тогда
		СОО = Строка(ВыборкаТЧ.ВидБСО) + ": требуется передать " + Строка(ВыборкаТЧ.Количество) + "шт, имеется в наличии " + Строка(КолВНаличие) + "шт." + СООхвост;
		//ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
		СтрокаТЗ 			= ТЗОшибок.Добавить();
		СтрокаТЗ.Ошибка 	= СОО;
		СтрокаТЗ.Строка		= ВыборкаТЧ.НомерСтроки - 1;
		СтрокаТЗ.Элемент	= "БСО";
		Отказ = Истина;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // ПолучитьВыборкуРН()

//возвращает булево или структуру значений является ли переданное физлицо руководителем
//РукИлиЗам = "Рук", "Зам", "Все"
Функция СотрудникЯвляетсяРуководителем(
	Знач Сотрудник 		= Неопределено,
	Знач Дата			= Неопределено,
	Знач ТипРезультата 	= "Булево",
	Знач РукИлиЗам		= "Все",
	ПоПодразделению		= Неопределено,
	ВключаяВыбывших     = Ложь
	) Экспорт

	ТекущееФизЛицо = Истина;
	Если Сотрудник = Неопределено Тогда
		Сотрудник = ПараметрыСеанса.уб_ТекущееФизЛицо;
	ИначеЕсли Сотрудник <> ПараметрыСеанса.уб_ТекущееФизЛицо Тогда
		ТекущееФизЛицо = Ложь;
	КонецЕсли;
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата()
	КонецЕсли;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	РП.Подразделение,
	|	РП.Подразделение.Владелец КАК Организация,
	|	РП.Заместитель
	|ИЗ
	|	РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Дата, ИСТИНА И &УсловиеВТ) КАК РП
	|ГДЕ
	|	РП.Сотрудник = &Сотрудник
	|	И &УсловиеУхода";
	Запрос.УстановитьПараметр("Дата", 		Дата);
	Запрос.УстановитьПараметр("Сотрудник",	Сотрудник);
	УсловиеУхода = ?(ВключаяВыбывших, "ИСТИНА", "НЕ РП.Уход");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеУхода", УсловиеУхода);
	СтрокаЗамены = "";
	РукИлиЗам = НРег(РукИлиЗам);
	Если РукИлиЗам = "все" Тогда
		СтрокаЗамены = "ИСТИНА"
	ИначеЕсли РукИлиЗам = "рук" Тогда
		СтрокаЗамены = "НЕ Заместитель"
	Иначе
		СтрокаЗамены = "Заместитель"
	КонецЕсли;
	Если ПоПодразделению <> Неопределено Тогда
		Если СтрокаЗамены <> "" Тогда
			СтрокаЗамены = СтрокаЗамены + " И ";
		КонецЕсли;
		СтрокаЗамены = СтрокаЗамены + "Подразделение = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение", ПоПодразделению);
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВТ", СтрокаЗамены);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	ТипРезультата = НРег(ТипРезультата);
	Если ТипРезультата = "булево" Тогда
		//возвращаем является ли сотрудник руководителей любого подразделения
		Результат = Не РезультатЗапроса.Пустой()
	ИначеЕсли ТипРезультата = "тз" Тогда
		//возвращает выгрузку запроса
		Результат = РезультатЗапроса.Выгрузить()
	Иначе
		//возвращает структуру с ключами:
		//Результат - сам факт руководства
		//Организация - организация, в которой сотрудник является руководителем, если их несколько, берется настройка пользователя ОсновнаяОрганизация
		//Подразделение - подразделение, в котором сотрудник является руководителем, если их несколько, берется настройка пользователя ОсновноеПодразделение
		Результат = Новый Структура;
		Результат.Вставить("ЯвляетсяРуководителем", Ложь);
		Результат.Вставить("Организация");
		Результат.Вставить("Подразделение");
		Результат.Вставить("Заместитель");
		Выборка = РезультатЗапроса.Выбрать();
		Организация 	= Неопределено;
		Подразделение 	= Неопределено;
		Заместитель		= Неопределено;
		ОрганизацияВыбрана 		= Ложь;
		ПодразделениеВыбрано 	= Ложь;
		ЗаместительВыбрано		= Ложь;
		Если Выборка.Количество() > 1 Тогда
			Если ТекущееФизЛицо Тогда
				ТекОрганизация = ПараметрыСеанса.уб_ОсновнаяОрганизация;
				ТекПодразделение = ПараметрыСеанса.уб_ОсновноеПодразделение;
			Иначе
				ТекОрганизация = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Сотрудник, "ОсновнаяОрганизация");
				ТекПодразделение = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Сотрудник, "ОсновноеПодразделение");
			КонецЕсли;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			Если Не ОрганизацияВыбрана Тогда
				Если Организация = Неопределено Тогда
					Организация = Выборка.Организация
				ИначеЕсли Организация <> Выборка.Организация Тогда
					//сотрудник является руководителем в нескольких организациях - получает основную организацию из настроек
					Организация = ТекОрганизация;
					ОрганизацияВыбрана = Истина;
					Если ПодразделениеВыбрано Тогда
						Прервать
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если Не ПодразделениеВыбрано Тогда
				Если Подразделение = Неопределено Тогда
					Подразделение = Выборка.Подразделение
				ИначеЕсли Подразделение <> Выборка.Подразделение Тогда
					//сотрудник является руководителем в нескольких организациях - получает основную организацию из настроек
					Подразделение = ТекПодразделение;
					ПодразделениеВыбрано = Истина;
					Если ОрганизацияВыбрана Тогда
						Прервать
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если Не ЗаместительВыбрано Тогда
				Если Выборка.Организация = ТекОрганизация И Выборка.Подразделение = ТекПодразделение Тогда
					Заместитель = Выборка.Заместитель;
					ЗаместительВыбрано = Истина;
				ИначеЕсли Заместитель = Неопределено Тогда
					Заместитель = Выборка.Заместитель;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Организация <> Подразделение Тогда
			Результат.ЯвляетсяРуководителем = Истина;
			Результат.Организация   		= Организация;
			Результат.Подразделение 		= Подразделение;
			Результат.Заместитель			= Заместитель;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ФизЛицоЯвляетсяРуководителем()

Функция РуководительПодразделения(
	Знач Подразделение 	= Неопределено,
	Знач Дата			= Неопределено,
	Знач ТипРезультата	= "ФизЛицо",
	Знач РукИлиЗам		= "Рук",
	ПоСотруднику		= Неопределено,
	ВключаяВыбывших     = Ложь
	) Экспорт

	Если Подразделение = Неопределено Тогда
		Подразделение = ПараметрыСеанса.уб_ОсновноеПодразделение
	КонецЕсли;
	Если Дата = Неопределено Тогда
		Дата = КонецДня(ТекущаяДата())
	КонецЕсли;
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РП.Сотрудник,
	|	РП.Заместитель КАК Заместитель,
	|	РП.ПолучаетВознаграждениеЗаРуководство
	|ИЗ
	|	РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(
	|			&Дата,
	|			Подразделение = &Подразделение
	|				И &УсловиеВТ) КАК РП
	|ГДЕ
	|	&УсловиеГде
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заместитель";
	Запрос.УстановитьПараметр("Подразделение", 	Подразделение);
	Запрос.УстановитьПараметр("Дата",			Дата);
	СтрокаЗамены = ?(ВключаяВыбывших, "ИСТИНА", "НЕ РП.Уход");
	Если ПоСотруднику <> Неопределено Тогда
		СтрокаЗамены = СтрокаЗамены + " И РП.Сотрудник = &Сотрудник";
		Запрос.УстановитьПараметр("Сотрудник", ПоСотруднику);
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде", СтрокаЗамены);
	РукИлиЗам = НРег(РукИлиЗам);
	Если РукИлиЗам = "все" Тогда
		СтрокаЗамены = "ИСТИНА"
	ИначеЕсли РукИлиЗам = "рук" Тогда
		СтрокаЗамены = "НЕ Заместитель"
	Иначе
		СтрокаЗамены = "Заместитель"
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВТ", СтрокаЗамены);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	ТипРезультата = НРег(ТипРезультата);
	Если ТипРезультата = "физлицо" Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Сотрудник
		Иначе
			Результат = Справочники.ФизическиеЛица.ПустаяСсылка()
		КонецЕсли;
	ИначеЕсли ТипРезультата = "тз" Тогда
		Результат = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	Возврат Результат;

КонецФункции // РуководительПодразделения()

Функция ПодчиненныеРуководителя(
	Знач Сотрудник	= Неопределено, 
	Знач Дата 		= Неопределено,
	Параметры		= Неопределено
	) Экспорт
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Сотрудник = ПараметрыСеанса.уб_ТекущееФизЛицо
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = КонецДня(ТекущаяДата());
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Параметры = СтруктураПараметровФункцииПодчиненныеРуководителяПоУмолчанию()
	КонецЕсли;
	ЗапросПодчиненныеРуководителя = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЗапросПодчиненныеРуководителя.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПодчиненныеРуководителя.УстановитьПараметр("ПодразделениеГдеРуководитель",уб_Кэшируемые.ПодразделениеГдеРуководитель(Сотрудник,Дата));
	ТекстЗапроса = 
	"Выбрать 
	|	РП.Подразделение КАК Подразделение,
	|	РП.Организация КАК Организация,
	|	РП.Заместитель КАК Заместитель
	|ПОМЕСТИТЬ ПодразделениеГдеРуководитель
	|  из &ПодразделениеГдеРуководитель как РП
	//"ВЫБРАТЬ
	//|	РП.Подразделение КАК Подразделение,
	//|	РП.Подразделение.Владелец КАК Организация,
	//|	РП.Заместитель КАК Заместитель
	//|ПОМЕСТИТЬ ПодразделениеГдеРуководитель
	//|ИЗ
	//|	РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Дата, ) КАК РП
	//|ГДЕ
	//|	НЕ РП.Уход
	//|	И (РП.Сотрудник = &Сотрудник
	//|			ИЛИ РП.Подразделение В ИЕРАРХИИ
	//|					(ВЫБРАТЬ
	//|						РП.Подразделение КАК Подразделение
	//|					ИЗ
	//|						РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Дата, ) КАК РП
	//|					ГДЕ
	//|						НЕ РП.Уход
	//|						И РП.Сотрудник = &Сотрудник)
	//|				И РП.Заместитель = ЛОЖЬ)
	//|
	//|ОБЪЕДИНИТЬ
	//|
	//|ВЫБРАТЬ
	//|	ПодразделенияОрганизаций.Ссылка,
	//|	ПодразделенияОрганизаций.Владелец,
	//|	ЛОЖЬ
	//|ИЗ
	//|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	//|ГДЕ
	//|	ПодразделенияОрганизаций.Ссылка В ИЕРАРХИИ
	//|			(ВЫБРАТЬ
	//|				РП.Подразделение КАК Подразделение
	//|			ИЗ
	//|				РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Дата, ) КАК РП
	//|			ГДЕ
	//|				НЕ РП.Уход
	//|				И РП.Сотрудник = &Сотрудник
	//|				И РП.Заместитель = ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДФ.Агент КАК Сотрудник,
	|	ДФ.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ПГР.Заместитель = ЛОЖЬ
	|			ТОГДА &Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеРуководитель,
	|	ВЫБОР
	|		КОГДА ПГР.Заместитель = ИСТИНА
	|			ТОГДА &Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеЗаместитель,
	|	ПГР.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ДФ.Агент = &Сотрудник
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Руководитель,
	|	ПГР.Заместитель КАК Заместитель,
	|	ДФ.Выбытие КАК Выбытие,
	|	ДФ.Агент.Наименование КАК СотрудникСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ДФ.Подразделение) КАК ПодразделениеСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ПГР.Организация) КАК ОрганизацияСтрока,
	|	ДФ.Подразделение.ТипПодразделения,
	|	ДФ.Подразделение.НеПроверятьЛичныеЗаявки КАК НеПроверятьЛичныеЗаявки,
	|	ДФ.Подразделение.НеПроверятьСкидки КАК НеПроверятьСкидки,
	|	ДФ.Подразделение.НеОплачиваютВыезд КАК НеОплачиваютВыезд,
	|	ДФ.Подразделение.НеОплачиватьКС,
	|	ДФ.Подразделение.НеПроверятьСрочность КАК НеПроверятьСрочность,
	|	ДФ.Подразделение.НеНуженАндеррайтингЗаявок КАК НеНуженАндеррайтингЗаявок,
	|	ДФ.Подразделение.БезОтделаКонтроля КАК БезОтделаКонтроля,	
	|	ДФ.Агент.ИспытательныйСрок КАК ИспытательныйСрок,
	|	ДФ.Агент.ВзаиморасчетыПрекращены КАК ВзаиморасчетыПрекращены
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), 1 = 1) КАК ДФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПодразделениеГдеРуководитель КАК ПГР
	|		ПО ДФ.Подразделение = ПГР.Подразделение
	|ГДЕ
	|	НЕ ДФ.Выбытие
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДФ.Агент,
	|	ДФ.Подразделение,
	|	ВЫБОР
	|		КОГДА ПГР.Заместитель = ЛОЖЬ
	|			ТОГДА &Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПГР.Заместитель = ИСТИНА
	|			ТОГДА &Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	КОНЕЦ,
	|	ПГР.Организация,
	|	ВЫБОР
	|		КОГДА ДФ.Агент = &Сотрудник
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ПГР.Заместитель,
	|	ДФ.Выбытие,
	|	ДФ.Агент.Наименование,
	|	ПРЕДСТАВЛЕНИЕ(ДФ.Подразделение),
	|	ПРЕДСТАВЛЕНИЕ(ПГР.Организация),
	|	ДФ.Подразделение.ТипПодразделения,
	|	ДФ.Подразделение.НеПроверятьЛичныеЗаявки,
	|	ДФ.Подразделение.НеПроверятьСкидки,
	|	ДФ.Подразделение.НеОплачиваютВыезд,
	|	ДФ.Подразделение.НеОплачиватьКС,
	|	ДФ.Подразделение.НеПроверятьСрочность,
	|	ДФ.Подразделение.НеНуженАндеррайтингЗаявок,
	|	ДФ.Подразделение.БезОтделаКонтроля КАК БезОтделаКонтроля,	
	|	ДФ.Агент.ИспытательныйСрок,
	|	ДФ.Агент.ВзаиморасчетыПрекращены
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), 1 = 1) КАК ДФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПодразделениеГдеРуководитель КАК ПГР
	|		ПО ДФ.Подразделение = ПГР.Подразделение
	|ГДЕ
	|	НЕ ДФ.Выбытие";
	Если Параметры.ДополнитьСотрудником Тогда
		ТекстЗапроса = ТекстЗапроса + " Объединить "+"ВЫБРАТЬ
		                                             |	ДФ.Агент,
		                                             |	ДФ.Подразделение,
		                                             |	ВЫБОР
		                                             |		КОГДА ПодразделениеСотрудника.Сотрудник ЕСТЬ NULL 
		                                             |			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		                                             |		ИНАЧЕ ПодразделениеСотрудника.Сотрудник
		                                             |	КОНЕЦ КАК Поле1,
		                                             |	ВЫБОР
		                                             |		КОГДА ПодразделениеСотрудника2.Сотрудник ЕСТЬ NULL 
		                                             |			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		                                             |		ИНАЧЕ ПодразделениеСотрудника2.Сотрудник
		                                             |	КОНЕЦ КАК Поле2,
		                                             |	ДФ.Подразделение.Владелец,
		                                             |	ВЫБОР
		                                             |		КОГДА ПодразделениеСотрудника.Сотрудник = &Сотрудник
		                                             |			ТОГДА ИСТИНА
		                                             |		ИНАЧЕ ЛОЖЬ
		                                             |	КОНЕЦ КАК Поле3,
		                                             |	ВЫБОР
		                                             |		КОГДА ПодразделениеСотрудника2.Сотрудник = &Сотрудник
		                                             |			ТОГДА ИСТИНА
		                                             |		ИНАЧЕ ЛОЖЬ
		                                             |	КОНЕЦ КАК Поле4,
		                                             |	ЛОЖЬ КАК Выбытие,
		                                             |	ДФ.Агент.Наименование,
		                                             |	ПРЕДСТАВЛЕНИЕ(ДФ.Подразделение),
		                                             |	ПРЕДСТАВЛЕНИЕ(ДФ.Подразделение.Владелец),
		                                             |	ДФ.Подразделение.ТипПодразделения,
		                                             |	ДФ.Подразделение.НеПроверятьЛичныеЗаявки КАК НеПроверятьЛичныеЗаявки,
