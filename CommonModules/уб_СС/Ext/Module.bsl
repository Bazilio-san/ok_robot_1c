Функция ПолучитьПользователяПоАгенту(КонтрагентИлиФизЛицо) Экспорт 
	Если ТипЗнч(КонтрагентИлиФизЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		//Запрос ускорит дальнейшее получение реквизитов ссылки
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	Пользователи.Ссылка,
		|	Пользователи.ВерсияДанных,
		|	Пользователи.ПометкаУдаления,
		|	Пользователи.Предопределенный,
		|	Пользователи.Родитель,
		|	Пользователи.ЭтоГруппа,
		|	Пользователи.Код,
		|	Пользователи.Наименование,
		|	Пользователи.ФизЛицо,
		|	Пользователи.Профиль,
		|	Пользователи.Автор,
		|	Пользователи.ДатаСоздания,
		|	Пользователи.Модификатор,
		|	Пользователи.ДатаИзменения,
		|	Пользователи.Представление
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ФизЛицо = &ФизЛицо");
		Запрос.УстановитьПараметр("ФизЛицо",КонтрагентИлиФизЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка;
		КонецЕсли;	
		//	Возврат Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",КонтрагентИлиФизЛицо);		
		//48: реквизита пользователь нет у контрагентов	
		//ИначеЕсли ТипЗнч(КонтрагентИлиФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда	
		//	Если НЕ ЗначениеНеЗаполнено(КонтрагентИлиФизЛицо.Пользователь) Тогда
		//		Возврат КонтрагентИлиФизЛицо.Пользователь;
		//	КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

