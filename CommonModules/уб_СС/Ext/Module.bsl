Функция ГенерироватьУИД(Оплаты, УИД) Экспорт
	
	ТекУИД = "";
	ПредУИД = "";
	Число = 0;
	Число2 = 0;
	ГСЧ = Новый ГенераторСлучайныхЧисел(255);
	Число2 = ГСЧ.СлучайноеЧисло(0, 100000);
	НовыйПароль = "";
	Пока СтрДлина(НовыйПароль) < 26 Цикл
		Число = ГСЧ.СлучайноеЧисло(48, 122);
		Если  ((Число>=48) И (Число<=57)) или ((Число>=97) И (Число<=122)) Тогда
			НовыйПароль = НовыйПароль+Символ(Число);
		КонецЕсли;
	КонецЦикла;
	
	УИД = Строка(Формат(Оплаты.Период, "ДФ=""ддММггггЧЧммсс"""))+Строка(НовыйПароль)+Строка(Формат(Число2, "ЧГ=0"));
	Возврат УИД;	
КонецФункции	

//Определяет, выполнялись ли движения Квитанции регистратором СП (страховым полисом)
Функция ЕстьДвиженияКвитанцииИзОплаты(Оплата) Экспорт
	СП = Оплата.СтраховойПолис;
	Если ЗначениеНеЗаполнено(СП) Тогда
		Возврат Ложь;	
	КонецЕсли;
	Если НЕ СП.Проведен Тогда
		Возврат Ложь;	
	КонецЕсли;
	Возврат ЕстьДвиженияКвитанцииПоЭтомуСП(Оплата.НомерКвитанции, СП);
КонецФункции

Функция ЕстьДвиженияКвитанцииПоЭтомуСП(НомерКвитанции, СП) Экспорт
	ЗапросЕстьДвиженияКвитанции = Новый Запрос;
	ЗапросЕстьДвиженияКвитанции.Текст = "ВЫБРАТЬ
	               |	Д.Период
	               |ИЗ
	               |	РегистрСведений.уб_ДвиженияБСО КАК Д
	               |ГДЕ
	               |	Д.НомерБСО = &НомерБСО
	               |	И Д.Подтверждено
				   |	И Д.КодОперации = Значение(Перечисление.уб_КодыОперацийБСО.ОформлениеКвитанции)
				   |	И Д.Регистратор = &Регистратор
				   |	И Д.Активность";
	
	ЗапросЕстьДвиженияКвитанции.УстановитьПараметр("НомерБСО", НомерКвитанции);
	ЗапросЕстьДвиженияКвитанции.УстановитьПараметр("Регистратор", СП);
	
	Результат = ЗапросЕстьДвиженияКвитанции.Выполнить();
	Возврат (НЕ Результат.Пустой());
КонецФункции

Функция ЕстьДвиженияКвитанцииПоДругомуСП(НомерКвитанции, СП, НайденныйСП = Неопределено) Экспорт
	ЗапросДвиженияКвитанцииПоДругомуПолису = Новый Запрос;
	ЗапросДвиженияКвитанцииПоДругомуПолису.Текст = "ВЫБРАТЬ
	|	Д.Период,
	|	Д.Регистратор.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК Д
	|ГДЕ
	|	Д.КодОперации = Значение(Перечисление.уб_КодыОперацийБСО.ОформлениеКвитанции)
	|	И Д.НомерБСО = &НомерБСО
	|	И Д.Подтверждено
	|	И Д.Активность
	|	И Д.Регистратор <> &Регистратор
	|	И Д.Регистратор ССЫЛКА Документ.уб_СтраховойПолис";
	
	ЗапросДвиженияКвитанцииПоДругомуПолису.УстановитьПараметр("НомерБСО", НомерКвитанции);
	ЗапросДвиженияКвитанцииПоДругомуПолису.УстановитьПараметр("Регистратор", СП);
	
	Результат = ЗапросДвиженияКвитанцииПоДругомуПолису.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	НайденныйСП = Выборка.Ссылка;
	Возврат Истина;
КонецФункции

Функция ЕстьДвиженияКвитанцииПоЛюбомуСП(НомерКвитанции, СП = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Д.Период,
	|	Д.Регистратор.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК Д
	|ГДЕ
	|	Д.КодОперации = Значение(Перечисление.уб_КодыОперацийБСО.ОформлениеКвитанции)
	|	И Д.НомерБСО = &НомерБСО
	|	И Д.Подтверждено
	|	И Д.Активность
	|	И Д.Регистратор ССЫЛКА Документ.уб_СтраховойПолис";
	
	Запрос.УстановитьПараметр("НомерБСО", НомерКвитанции);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	СП = Выборка.Ссылка;
	Возврат Истина;
КонецФункции

// Определяет наличие движений любого номерного БСО за период
Функция ЕстьДвиженияБСОзаПериод(СК, ВидБСО, НомерБСО, ВремяС, ВремяПО = Неопределено, ИнфоОДвижениях = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Д.Период КАК Период,
	|	Д.Регистратор,
	|	Д.СК,
	|	Д.ВидБСО,
	|	Д.НомерБСО,
	|	Д.НомерПолиса,
	|	Д.ГодПолиса,
	|	Д.ПоложениеБСО,
	|	Д.СостояниеБСО,
	|	Д.СтраховойПолис,
	|	Д.КодОперации,
	|	Д.ОрганизацияАгент,
	|	Д.Агент
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК Д
	|ГДЕ
	|	Д.ВидБСО = &ВидБСО
	|	И Д.НомерБСО = &НомерБСО
	|	И Д.Подтверждено
	|	И Д.Активность
	|	И Д.Период МЕЖДУ &ВремяС И &ВремяПО
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("СК", СК);
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО", СокрЛП(НомерБСО));
	Запрос.УстановитьПараметр("ВремяС", ВремяС);
	ВремяПО = ?(ВремяПО = Неопределено,ТекущаяДата(),ВремяПО);
	Запрос.УстановитьПараметр("ВремяПО", ВремяПО);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ИнфоОДвижениях = "";
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Если ИнфоОДвижениях = Неопределено Тогда
		Отступ = "";
		Сообщать = Истина; 	
	Иначе
		Сообщать = Ложь; 	
		Отступ = ИнфоОДвижениях;
	КонецЕсли; 
	
	ИнфоОДвижениях = "";
	Пока Выборка.Следующий() Цикл
		ИнфоОДвижениях = ИнфоОДвижениях + (?(ИнфоОДвижениях = "","","
		|")) + Отступ + "Движение БСО [" + Строка(Выборка.ВидБСО) 
		+ " Положение: " + Строка(Выборка.ПоложениеБСО)
		+ ", Состояние: " + Строка(Выборка.СостояниеБСО) 
		+ "] № " + НомерБСО + " | Документ: [" 
		+ Строка(Выборка.Регистратор) + "] | Агент: " + Строка(Выборка.Агент);
		Если Сообщать Тогда
			Сообщить(ИнфоОДвижениях);
			ИнфоОДвижениях = "";
		КонецЕсли; 
	КонецЦикла;
	ИнфоОДвижениях = "
	|" + ИнфоОДвижениях; 
	Возврат Истина;
КонецФункции

Функция ПолучитьВидБСОПолисаПоСтраховомуПродукту(оСтраховойПродукт) Экспорт
	Если ТипЗНЧ(оСтраховойПродукт) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
		Если оСтраховойПродукт.Вид = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО или оСтраховойПродукт.Вид = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО Тогда
			типБСО = Перечисления.уб_ТипыБСО.ПолисОсаго;
		Иначе
			типБСО = Перечисления.уб_ТипыБСО.Полис;
		КонецЕсли;	
		
		Для Каждого ОВ из оСтраховойПродукт.ВидыБСО Цикл
			Если ОВ.ВидБСО.Тип = типБСО Тогда
				Возврат ОВ.ВидБСО;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗНЧ(оСтраховойПродукт) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
		Возврат оСтраховойПродукт;
	КонецЕсли;
	Возврат Справочники.уб_ВидыБСО.ПустаяСсылка();
КонецФункции

//Получает Уник. ИД таблицы значений длиной 255 символов
Функция ПолучитьКлючИЗТЗ(ТЗ) Экспорт
	ИД = "";
	для каждого Кол из ТЗ.колонки Цикл
		КолИмя = Кол.Имя;
		предЗнчПоля = "";
		Сч = 0;
		Для Каждого Стрк ИЗ ТЗ Цикл
			ЗнчПоля = Стрк[КолИмя]; 
			Если ЗнчПоля <> предЗнчПоля Тогда
				ИД = ИД + ЗнчПоля;
				предЗнчПоля = ЗнчПоля;
			Иначе 
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
		ИД = ИД + Сч;
	КонецЦикла;
	Ключ = Лев(ИД,210);
	Остат = Сред(ИД,101);
	ДлинаИД = СтрДлина(Остат);
	CRC = 0;
	Для к=1 по ДлинаИД цикл  
		код = КодСимвола(Сред(Остат,к,1));
		CRC = CRC + код;
		Если CRC > 10000 Тогда
			Ключ = Ключ + Формат(CRC,"ЧГ=");
			CRC = 0;
		КонецЕсли;
	КонецЦикла;    
	Возврат Лев(Ключ + Формат(CRC,"ЧГ="),255);
КонецФункции

//Получает таблицу значений и формирует модальный диалог для ыбора нужного КВ из списка
Функция ЗапросНаВыборКВ(ТЗ,Заголов) Экспорт
	ФормаВыбора = ПолучитьОбщуюФорму("уб_ПростойПодбор");
	ТП = ФормаВыбора.ТаблицаПодбора;
	
	ТП.Колонки.Очистить();
	Для Каждого кол из ТЗ.колонки Цикл
		колИмя = кол.Имя;
		ПоставщикЕсть = Ложь;
		//Если в табл. значений ТЗ колонка содержит значение, 
		//то в ТП будет добавлена одноименная колонка
		// (при условии, чо она есть среди имен, перечисленных ниже. К примеру, колонка "Организация добавлена не будет")
		Для Каждого стрТЗ из ТЗ Цикл
			Если НЕ ЗначениеНеЗаполнено(стрТЗ[колИмя]) Тогда
				Если колИмя = "Процент" Тогда
					ТП.Колонки.Вставить(0,"Процент",,"КВ, %",6);
				ИначеЕсли колИмя = "Условие" Тогда 
					ТП.Колонки.Добавить("Условие",,"Условие",27);
				ИначеЕсли колИмя = "СтраховойПродукт" Тогда 
					ТП.Колонки.Добавить("СтраховойПродукт",,"С.Продукт",27);
				ИначеЕсли колИмя = "ВидСП" Тогда 
					ТП.Колонки.Добавить("ВидСП",,"Вид",12);
				ИначеЕсли колИмя = "Риск" Тогда 
					ТП.Колонки.Добавить("Риск",,"Риск",27);
				ИначеЕсли колИмя = "СК" Тогда
					ТП.Колонки.Добавить("СК",,"СК",20);
				ИначеЕсли колИмя = "ПроцентДляОтчета" Тогда
					ТП.Колонки.Добавить("ПроцентДляОтчета",,"%КВ Для Отчета",1);
				ИначеЕсли колИмя = "Поставщик" Тогда 
					ТП.Колонки.Добавить("Поставщик",,"Поставщик",15);
				КонецЕсли;
				Прервать;
			Иначе
				Если колИмя = "Поставщик" И Не ПоставщикЕсть Тогда 
					ТП.Колонки.Добавить("Поставщик",,"Поставщик",15);
					ПоставщикЕсть = Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ФормаВыбора.ЭлементыФормы.ТаблицаПодбора.СоздатьКолонки();
	
	
	//Заполняем созданнуб таблицу (ТП) значениями из (ТЗ)
	Для Каждого стрТЗ из ТЗ Цикл
		новСтрТП = ТП.Добавить();
		Для Каждого кол из ТП.колонки Цикл
			новСтрТП[кол.Имя] = стрТЗ[кол.Имя];
		КонецЦикла;
	КонецЦикла;
	
	ФормаВыбора.РежимВыбора = Истина;
	ФормаВыбора.МножественныйВыбор = Ложь;
	ФормаВыбора.ЗакрыватьПриВыборе = Истина;
	#Если Клиент Тогда	
		ФормаВыбора.ЭлементыФормы.ТаблицаПодбора.РежимВыделения = РежимВыделенияТабличногоПоля.Одиночный;
	#КонецЕсли	
	ФормаВыбора.ЭлементыФормы.ТаблицаПодбора.РежимВыбора = Истина;
	ФормаВыбора.Заголовок = Заголов;
	ФормаВыбора.ОткрытьМодально();
	Выбранное = ФормаВыбора.Выбранное;
	Если Выбранное = Неопределено Тогда
		Возврат Неопределено;	
	ИначеЕсли Выбранное.Количество() > 0 Тогда
		Возврат Выбранное[0];
	Иначе
		Возврат Неопределено;	
	КонецЕсли;
	
КонецФункции

Функция АвтовыборКВпоВЫбранномуРанееАВ(ТЗКВ,ВыбраннаяСтрокаАВ) Экспорт
	СтруктураПоиска = Новый Структура();
	
	ТЗАВ = ВыбраннаяСтрокаАВ.Владелец();
	Для Каждого кол из ТЗАВ.колонки Цикл
		колИмя = кол.Имя;
		Если колИмя <> "Условие"
			И колИмя <> "СтраховойПродукт"
			И колИмя <> "ВидСП"
			И колИмя <> "Риск"
			И колИмя <> "Поставщик"
			И колИмя <> "СК"
			Тогда
			Продолжить;
		КонецЕсли;
		Если ТЗКВ.Колонки.Найти(колИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтруктураПоиска.Вставить(колИмя,ВыбраннаяСтрокаАВ[колИмя]);
	КонецЦикла;
	НайденныеСтроки = ТЗКВ.НайтиСтроки(СтруктураПоиска);	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0];
	Иначе
		Возврат ТЗКВ[0];	
	КонецЕсли;
КонецФункции

//ДатаНачалоЭтоНачалоМесяца - устанавливает датой начала поиска по менеджеру документов - начало месяца, иначе - начало дня последнего дня месяца
Функция ПолучитьДокументДляАвтоматическойЗаписи(ДокДата, ДокументМенеджер, ИмяТабличнойЧасти, МаксКоличСтрокВДокументе, БратьПроведенные = Истина, ЭтоДвижениеНомераПолиса = Ложь) Экспорт
	
	//Ищем документ, датированный концом месяца документа перемещения
	//Если не находим, создаем новый	
	ДатаКонца = КонецМесяца(ДокДата); 
	//если это движение номера полиса тогда ДатаНачала - начало месяца, иначе - начало последнего дня месяца
	ЭтоДвижениеНомераПолиса = ТипЗнч(ДокументМенеджер) = Тип("ДокументМенеджер.уб_ДвиженияНомераПолиса");
	ДатаНачала = ?(ЭтоДвижениеНомераПолиса, НачалоМесяца(ДокДата), ДатаКонца - 60*60*24 + 1);
	НовыйНомер = 0;
	НоваяДата = ДатаКонца - 60*60*24 + 1;
	ДоК = Неопределено;
	Выборка = ДокументМенеджер.Выбрать(ДатаНачала, ДатаКонца,,"Дата УБЫВ");
	Пока Выборка.Следующий() Цикл
		ДоК = Выборка.ПолучитьОбъект();
		Если ДоК[ИмяТабличнойЧасти].Количество() > МаксКоличСтрокВДокументе ИЛИ (БратьПроведенные И НЕ ДоК.Проведен) Тогда			
			НоваяДата = Дата(ДоК.Дата) + 60;
			НовыйНомер = Док.Номер + 1;
			ДоК = Неопределено;			
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Если ДоК = Неопределено Тогда
		ДоК = ДокументМенеджер.СоздатьДокумент();
		ДоК.Дата = НоваяДата; 
		Если ЭтоДвижениеНомераПолиса Тогда
			Док.Комментарий = "Создан автоматически при выдаче свободных номеров."
		Иначе
			ДоК.Номер = ?(НовыйНомер > 0,НовыйНомер,(Год(ДатаКонца)-2000)*100000 + Месяц(ДатаКонца)*1000 ); 
		КонецЕсли;
		ДоК.ДатаСоздания = ТекущаяДата(); 
		ДоК.ДатаИзменения = ТекущаяДата(); 
		ДоК.Автор = ПараметрыСеанса.ТекущийПользователь; 
		ДоК.Модификатор = ПараметрыСеанса.ТекущийПользователь; 
	КонецЕсли;
	Возврат ДоК;
	
КонецФункции

Функция ПолучитьДокументДвиженияНомераПолиса(ДокДата) Экспорт
	//Ищем документ Компенсации, датированный концом месяца документа перемещения
	//Если не находим, создаем новый
	Возврат ПолучитьДокументДляАвтоматическойЗаписи(ДокДата, Документы.уб_ДвиженияНомераПолиса, "СНП", 50);
КонецФункции

//Добавление компенсации
Функция ПроверкаУникальностиКомпенсации(СтруктураКомпенсации) Экспорт 
	одинДень = 60*60*24;
	
	Если СтруктураКомпенсации.Агент = СтруктураКомпенсации.АгентКуда
		И  СтруктураКомпенсации.Поставщик = СтруктураКомпенсации.ПоставщикКуда 
		И  СтруктураКомпенсации.ОрганизацияАгент = СтруктураКомпенсации.ОрганизацияАгентКуда 
		Тогда
		с1 = "для перемещения БСО [" + Строка(СтруктураКомпенсации.ВидБСО) + " № " + СтруктураКомпенсации.НомерБСО +
		" с аг. " + Строка(СтруктураКомпенсации.Агент) + " на " + Строка(СтруктураКомпенсации.АгентКуда) +
		"]";
		Сообщить("Отклонено: Совпадают агенты, поставщик и оргагент `с` и `на кого` " + с1);
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Д.Период КАК Период,
	|	Д.Регистратор,
	|	Д.СК,
	|	Д.ВидБСО,
	|	Д.НомерБСО,
	|	Д.Поставщик,
	|	Д.ОрганизацияАгент,
	//|	Д.ДокПроведен,
	//|	Д.Активность Как ДокПроведен,
	|	Д.Активность Как Активность,
	|	Д.Подтверждено,
	|	Д.АгентОтправитель,
	|	Д.Агент
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК Д
	|ГДЕ
	|   Д.ВидБСО = &ВидБСО
	|	И Д.НомерБСО = &НомерБСО
	//|	Д.СК = &СК
	|	И Д.Поставщик = &Поставщик
	|	И Д.ОрганизацияАгент = &ОрганизацияАгент
	|	И Д.Подтверждено
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	//TODO Требуется проверка на активность?
	
	Запрос.УстановитьПараметр("СК", СтруктураКомпенсации.СК);
	Запрос.УстановитьПараметр("ВидБСО", СтруктураКомпенсации.ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО", СтруктураКомпенсации.НомерБСО);
	Запрос.УстановитьПараметр("Поставщик", СтруктураКомпенсации.Поставщик);
	Запрос.УстановитьПараметр("ОрганизацияАгент", СтруктураКомпенсации.ОрганизацияАгент);
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		с1 = "для перемещения БСО [СК '" + СтруктураКомпенсации.СК + "', '" + Строка(СтруктураКомпенсации.ВидБСО) + "' № '" + СтруктураКомпенсации.НомерБСО +
		"' от '" + Строка(СтруктураКомпенсации.ДатаПеремещения) +  "'] с аг. '" + Строка(СтруктураКомпенсации.Агент) + "' на '" + Строка(СтруктураКомпенсации.АгентКуда) +
		"' в док-те: " + строка(Выборка.Регистратор) + " ";
		
		//Проверяем на присутствие аналогичной записи со значениями измерений
		Если Выборка.Период = СтруктураКомпенсации.ДатаПеремещения Тогда
			Сообщить("Отклонено: Найдено движение с такими же ключевыми значениями " + с1, СтатусСообщения.Внимание);
			Возврат Ложь;
		КонецЕсли;
		
		Дельта = Выборка.Период - СтруктураКомпенсации.ДатаПеремещения;
		Если Дельта < 0 Тогда Дельта = Дельта * -1 КонецЕсли;
		
		//Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.уб_КомпенсацияДвиженийБСО") Тогда
		Если Выборка.АгентОтправитель = СтруктураКомпенсации.Агент 
			И Выборка.Агент = СтруктураКомпенсации.АгентКуда
			Тогда
			
			Если Дельта < одинДень Тогда
				Сообщить("Отклонено: Найдена компенсация-дубль (разница менее 24ч) " + с1, СтатусСообщения.Внимание);
				Возврат Ложь;
			ИначеЕсли Дельта < одинДень*7 Тогда
				Сообщить("Найдена аналогичная компенсация (от 1 до 7 дней разницы) " + с1, СтатусСообщения.Информация);
			ИначеЕсли Дельта < одинДень*30 Тогда
				Сообщить("Найдена аналогичная компенсация (от 7 до 30 дней разницы) " + с1, СтатусСообщения.Информация);
			Иначе
				Сообщить("Найдена аналогичная компенсация (> 30 дней разницы) " + с1, СтатусСообщения.Информация);
			КонецЕсли;
		КонецЕсли;
		//КонецЕсли;
		
	КонецЦикла;
	Возврат Истина;	
КонецФункции

Процедура ДобавитьЗаписьВДокументКомпенсацияПеремещений(ДоК,СтруктураКомпенсации) Экспорт
	
	ТабДок = ДоК.БСО.Добавить();
	
	ТабДок.Подтверждено = Истина;
	ТабДок.ДатаПеремещения = СтруктураКомпенсации.ДатаПеремещения;
	ТабДок.Поставщик = СтруктураКомпенсации.Поставщик;
	ТабДок.ПоставщикКуда = СтруктураКомпенсации.ПоставщикКуда;
	ТабДок.ОрганизацияАгент = СтруктураКомпенсации.ОрганизацияАгент;
	ТабДок.ОрганизацияАгентКуда = СтруктураКомпенсации.ОрганизацияАгентКуда;
	ТабДок.СК = СтруктураКомпенсации.СК;
	ТабДок.ВидБСО = СтруктураКомпенсации.ВидБСО;
	ТабДок.НомерБСО = СтруктураКомпенсации.НомерБСО;
	ТабДок.Количество = СтруктураКомпенсации.Количество;
	ТабДок.СостояниеБСО = СтруктураКомпенсации.СостояниеБСО;
	ТабДок.Агент = СтруктураКомпенсации.Агент;
	ТабДок.АгентКуда = СтруктураКомпенсации.АгентКуда;
	ТабДок.ДопустимоТолькоРучноеИсправление = Ложь;
	
КонецПроцедуры

Функция ДобавитьКомпенсацию(Массив_СтруктураКомпенсации) Экспорт
	
	НачатьТранзакцию();
	ДоК = ПолучитьДокументДляАвтоматическойЗаписи(Массив_СтруктураКомпенсации[0].ДатаПеремещения,Документы.уб_КомпенсацияДвиженийБСО,"БСО",50);
	
	ЗаписыватьДокумент = Ложь;
	Для Каждого СтруктураКомпенсации из Массив_СтруктураКомпенсации Цикл
		Если ПроверкаУникальностиКомпенсации(СтруктураКомпенсации) Тогда
			ДобавитьЗаписьВДокументКомпенсацияПеремещений(ДоК,СтруктураКомпенсации);
			ЗаписыватьДокумент = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗаписыватьДокумент Тогда
		Сообщить("Отсутствуют компенсации прошедшие проверку.", СтатусСообщения.Информация);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ДоК.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		Сообщить("Ошибка! " + ДоК +  " - Не удалось провести компенсацию.", СтатусСообщения.ОченьВажное);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Фрм = ДоК.Ссылка.ПолучитьФорму();
	Если Фрм.Открыта() Тогда
		Фрм.ЭтотОбъект.Прочитать();
		Фрм.Обновить();
	КонецЕсли;
	
КонецФункции

