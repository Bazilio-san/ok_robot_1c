//TODO переделать в запрос
Функция ПолучитьПодразделениеАгента(оАгент, Знач НаДату = Неопределено, ВозвращатьПустое = Ложь, Уволен = Ложь) Экспорт
	
	Уволен = Ложь;	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();	
	КонецЕсли;
	
	// Если агент не передан, то возвращает основное подразделение по учету БСО
	Если Не ЗначениеЗаполнено(оАгент) Тогда
		Если ВозвращатьПустое Тогда
			ПустоеП = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
			Возврат ПустоеП;
		Иначе
			Возврат ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
		КонецЕсли;
	КонецЕсли;
	ТипАгента = ТипЗнч(оАгент);
	//Если тип агента - Контрагент, то возвращаем подразделение агентской сети
	Если ТипАгента = Тип("СправочникСсылка.ФизическиеЛица") Тогда
	ИначеЕсли ТипАгента = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети;
	ИначеЕсли ТипАгента = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		Возврат оАгент;
	КонецЕсли;
	//Ищем подразделение в регистре сведений уб_ДвижениеФизлицПоПодразделениям
	Отбор = Новый Структура("Агент",оАгент);
	ВыбПодразделений = РегистрыСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(НаДату,Отбор);
	Если ВыбПодразделений.Количество() > 0 Тогда
		Уволен = ВыбПодразделений[0].Выбытие;
		Возврат ВыбПодразделений[0].Подразделение;
	КонецЕсли; 
	Если оАгент.ЭтоГруппа Тогда
		Если ВозвращатьПустое Тогда
			ПустоеП = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
			Возврат ПустоеП;
		Иначе
			Попытка
				Возврат ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
			Исключение
				ПустоеП = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
				Возврат ПустоеП;
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;	
	// Далее - старый код
	оАгентРодитель = оАгент.Родитель;
	Если оАгентРодитель.ЭлементыГруппыЕстьСотрудники И Не оАгент.ПометкаУдаления Тогда
		#Если Клиент Тогда
			Сообщить("Внимание! Сотрудник " + Строка(оАгент) + " находится в группах сотрудников, но не закреплен за подразделением!. Исправьте, либо переместите в уволенные.")
		#КонецЕсли
	КонецЕсли;
	МОЛпоБСО = уб_КЭШируемые.ПолучитьМОЛпоБСО(ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО);
	Если оАгент = МОЛпоБСО Тогда
		Попытка
			Возврат ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
		Исключение
			ПустоеП = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
			Возврат ПустоеП;
		КонецПопытки;	
	КонецЕсли;
	//оПользователь = ПолучитьПользователяПоАгенту(оАгент);
	//Если НЕ ЗначениеНеЗаполнено(оПользователь) Тогда
	//	оОснПодр = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(оПользователь, "ОсновноеПодразделениеОрганизации");
	//Иначе
	//	
	//КонецЕсли;
	Если ВозвращатьПустое Тогда
		ПустоеП = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
		Возврат ПустоеП;
	КонецЕсли;
	//Для физлица не задан пользователь
	//Пробуем выяснить подразделение по группе
	Если оАгентРодитель = ПараметрыСеанса.уб_Константы.уб_ГруппаАгентовФизЛиц Тогда
		оОснПодр = ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети;
	ИначеЕсли оАгентРодитель = ПараметрыСеанса.уб_Константы.уб_ГруппаСотрудниковКурьеров Тогда
		оОснПодр = ПараметрыСеанса.уб_Константы.уб_ПодразделениеСВС;
	ИначеЕсли оАгентРодитель = ПараметрыСеанса.уб_Константы.уб_ГруппаСотрудников Тогда
		оОснПодр = ПараметрыСеанса.уб_Константы.уб_ПодразделениеОтделаПродаж;
	Иначе
		Возврат ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
	КонецЕсли;
	Возврат оОснПодр;
	
КонецФункции

Функция ПолучитьСписокСотрудниковАктуальныхВМесяце(ДатаИзМесяца = Неопределено,ПодразделениеСотрудника = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаИзМесяца) Тогда
		ДатаИзМесяца = ТекущаяДата();	
	КонецЕсли;
	СписокСотрудниковАктуальныхВЭтомМесяце = Новый СписокЗначений;
	
	Если НЕ ПодразделениеСотрудника = Неопределено Тогда
		тз = уб_КЭШируемые.ПолучитьСписокСотрудниковАктуальныхВМесяце(НачалоМесяца(ДатаИзМесяца),Истина);
		Для каждого СтрокаТЗ из тз Цикл
			Если СтрокаТЗ.Подразделение = ПодразделениеСотрудника или СтрокаТЗ.Подразделение.ПринадлежитЭлементу(ПодразделениеСотрудника) Тогда
				СписокСотрудниковАктуальныхВЭтомМесяце.Добавить(СтрокаТЗ.Агент);
			КонецЕсли;	
		КонецЦикла;	
	Иначе
		СписокСотрудниковАктуальныхВЭтомМесяце.ЗагрузитьЗначения(уб_КЭШируемые.ПолучитьСписокСотрудниковАктуальныхВМесяце(НачалоМесяца(ДатаИзМесяца)));
	КонецЕсли;	

	
	Возврат СписокСотрудниковАктуальныхВЭтомМесяце;
	
КонецФункции

Функция ИнфоДляАгента(оАгент, НаДату = Неопределено, Разделитель = "/") Экспорт
	
	оПодразделение = Неопределено;
	Если НЕ ЗначениеЗаполнено(оАгент) Тогда
		Возврат "";
	Иначе	
		ТипАгента = ТипЗнч(оАгент);
		Уволен = Ложь;
		Если ТипАгента = Тип("СправочникСсылка.Контрагенты") Тогда
			оПодразделение = ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети;
			//Инфо = оПодразделение.Наименование + РЗД + оПодразделение.Владелец.Наименование;
		ИначеЕсли ТипЗнч(оАгент) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
			оПодразделение = оАгент; 
			//Инфо = оПодразделение.Владелец.Наименование;
			//Возврат Инфо;
		Иначе
			Если НаДату = Неопределено Тогда
				НаДату = ТекущаяДата();	
			КонецЕсли;
			оПодразделение = ПолучитьПодразделениеАгента(оАгент, НаДату, Истина, Уволен);
			Если ЗначениеНеЗаполнено(оПодразделение) Тогда
				Возврат "?";
			КонецЕсли;
		КонецЕсли;
		Если Разделитель = "," Тогда
			РЗД = ", ";	
		Иначе	
			РЗД = " " + Разделитель + " ";
		КонецЕсли;
		Инфо = уб_КЭШируемые.ПолучитьИнформациюОПодразделении(оПодразделение,РЗД)+//оПодразделение.Наименование + РЗД + оПодразделение.Владелец.Наименование +  
		?(Уволен, РЗД + "[УВОЛЕН]", "");
		Возврат Инфо;	    
	КонецЕсли;
КонецФункции

