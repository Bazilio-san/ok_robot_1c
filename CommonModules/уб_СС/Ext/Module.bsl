Процедура ЗаполнитьИнфСтроку(Форма) Экспорт
	
	Попытка
		Объект = Форма.ЭтотОбъект;
		ЭтоСсылка = Истина;
	Исключение
		Объект = Форма.РегистрСведенийМенеджерЗаписи;
		ЭтоСсылка = Ложь;
	КонецПопытки;
	
	//Если дата не задана возвращаем [?]
	Создан			 = "Создан: "	+ ?(ЗначениеЗаполнено(Объект.ДатаСоздания),		Формат(Объект.ДатаСоздания,	"ДФ='dd/MM/yy'"),		   "[?]");
	Изменен			 = "Изменен: "	+ ?(ЗначениеЗаполнено(Объект.ДатаИзменения),	Формат(Объект.ДатаИзменения,"ДФ='dd/MM/yy'"),	       "[?]");
	СозданПодсказка	 = "Создан: "	+ ?(ЗначениеЗаполнено(Объект.ДатаСоздания),		Формат(Объект.ДатаСоздания,	"ДФ='dd/MM/yy HH:mm'"),    "[?]");
	ИзмененПодсказка = "Изменен: "	+ ?(ЗначениеЗаполнено(Объект.ДатаИзменения),	Формат(Объект.ДатаИзменения,"ДФ='dd/MM/yy HH:mm:ss'"), "[?]");
	//Заполняем автора и модификатора
	Если ЗначениеЗаполнено(Объект.Автор) Тогда
		Автор			= уб_Кэшируемые.ФИОФизлицаСтрокой(Объект.Автор);//ФИОФизлицаСтрокой(Объект.Автор, , , , Истина);
		//ИначеЕсли ЗначениеЗаполнено(Объект.Автор) Тогда
		//	Автор			= ОбщегоНазначения.ФИО_ФизЛица(Объект.Автор.Наименование);
	Иначе
		Автор			= "[Неопределено]";
	КонецЕсли;
	
	Если Объект.Автор = Объект.Модификатор Тогда
		Модификатор = Автор;
	ИначеЕсли ЗначениеЗаполнено(Объект.Модификатор) Тогда
		Модификатор		= уб_Кэшируемые.ФИОФизлицаСтрокой(Объект.Модификатор);//ФИОФизлицаСтрокой(Объект.Модификатор, , , , Истина);
		//ИначеЕсли ЗначениеЗаполнено(Объект.Модификатор) Тогда
		//	Модификатор		= ОбщегоНазначения.ФИО_ФизЛица(Объект.Модификатор.Наименование);
	Иначе
		Модификатор		= "[Неопределено]";
	КонецЕсли;
	
	//Заполняем информационную строку
	ЭлементНадписьАвтор = Форма.ЭлементыФормы.Найти("НадписьАвтор");
	Если ЭлементНадписьАвтор <> Неопределено Тогда
		Форма.фИнфСтрока = Создан + ", " + Автор + "; " + Изменен + ", " + Модификатор;
		ЭлементНадписьАвтор.Подсказка = СозданПодсказка + ", " + Автор + "; " + ИзмененПодсказка + ", " + Модификатор;
		//тест. При изменении ширины поля снова срабатывают привязки, изза чего надпись в событии "ПриОткрытии" формы "сползает" вверх
		#Если ТолстыйКлиент Тогда
			УстановитьЗначение(ЭлементНадписьАвтор.Ширина, 390);
		#КонецЕсли
	Иначе
		Форма.фИнфСтрока = СозданПодсказка + ", " + Автор + "; " + ИзмененПодсказка + ", " + Модификатор;
	КонецЕсли;
	Если ЭтоСсылка тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			уб_temp.ЕстьСобытиеВхода(ИСТИНА);
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				журналСобытий = Справочники.журналСобытий.СоздатьЭлемент();
				журналСобытий.Дата = ТекущаяДата();
				журналСобытий.Событие = Справочники.ВидСобытия.Открытие;
				журналСобытий.Пользователь = ПараметрыСеанса.ТекущийПользователь;
				журналСобытий.Информация = "Открытие или запись ссылки";
				журналСобытий.Объект = Объект.Ссылка;
				журналСобытий.Записать();
			Исключение
			КонецПопытки;
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Функция ИспользуетсяОбщийРеквизит(Имя,МетаОбъект) Экспорт
	мдРеквизита = Метаданные.ОбщиеРеквизиты [Имя];
	ТипИспользования = мдРеквизита.Состав.Найти(МетаОбъект).Использование;
	ИспользованиеОбщегоРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита;
	Используется = (ТипИспользования	= ИспользованиеОбщегоРеквизита.Использовать) 
	 ИЛИ (ТипИспользования	= ИспользованиеОбщегоРеквизита.Авто И мдРеквизита.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать);
	Возврат  Используется
КонецФункции	
//ПроверкаМодифицированности - Ложь при отсутствии в Объекте данных о
//модифицированности, требуется ручная проверка на модифицированность при вызове процедуры
Процедура ОтметитьФактМодификации(Объект, ПроверкаМодифицированности = Истина) Экспорт 
	
	Попытка
		//Если стоит флаг загрузка, не отмечаем факт модификации
		Если Объект.ОбменДанными.Загрузка Тогда
			Возврат;
		КонецЕсли;
	Исключение
		//
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("У объекта нет обмена данными "+ТипЗнч(Объект), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"));
	КонецПопытки;
	Попытка
		Рекв = Метаданные.ОбщиеРеквизиты.Автор;
		МетаОбъекта = Объект.Метаданные();
		естьАвтор = ИспользуетсяОбщийРеквизит("Автор",МетаОбъекта);
		естьДатаСоздания = ИспользуетсяОбщийРеквизит("ДатаСоздания",МетаОбъекта);
		естьМодификатор = ИспользуетсяОбщийРеквизит("Модификатор",МетаОбъекта);
		естьДатаИзменения = ИспользуетсяОбщийРеквизит("ДатаИзменения",МетаОбъекта);
		Если естьАвтор  И (Объект.ЭтоНовый() ИЛИ Объект.Автор.Пустая() ИЛИ (естьДатаСоздания и Объект.ДатаСоздания = Дата(1,1,1))) Тогда
			Объект.Автор 			= ПараметрыСеанса.ТекущийПользователь;
			Если естьДатаСоздания Тогда
				Объект.ДатаСоздания = ТекущаяДата();
			КонецЕсли;	
			Если естьМодификатор Тогда
				Объект.Модификатор	= Объект.Автор;
			КонецЕсли;	
			Если естьДатаИзменения Тогда
				Объект.ДатаИзменения = Объект.ДатаСоздания;
			КонецЕсли;	
		ИначеЕсли естьМодификатор и ПроверкаМодифицированности Тогда
			Если Объект.Модифицированность() Тогда
				Если Объект.Модификатор <> ПараметрыСеанса.ТекущийПользователь Тогда
					Объект.Модификатор = ПараметрыСеанса.ТекущийПользователь;
				КонецЕсли;
				Если естьДатаИзменения Тогда
					Объект.ДатаИзменения = ТекущаяДата();
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Если естьМодификатор Тогда
				Объект.Модификатор = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;	
			Если естьДатаИзменения Тогда
				Объект.ДатаИзменения = ТекущаяДата();
			КонецЕсли;	
		КонецЕсли;
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось проставить модификацию "+ТипЗнч(Объект)+" "+ОписаниеОшибки());
	КонецПопытки;
	//уб_temp.СоздатьЛогПользователя(Строка(ТипЗнч(Объект)), Истина);
	
КонецПроцедуры

//при открытии регистра сведений для обработки автора, модификатора. МЗ - менеджер записи регистра
Процедура ЗаполнитьИнфоОМодификацииДляРС(МЗ, Модифицированность = Ложь) Экспорт 
	
	Если Модифицированность Тогда
		Если МЗ.Автор.Пустая() Или МЗ.ДатаСоздания = Дата(1,1,1) Тогда
			МЗ.Автор 			= ПараметрыСеанса.ТекущийПользователь;
			МЗ.ДатаСоздания     = ТекущаяДата();
			МЗ.Модификатор		= МЗ.Автор;
			МЗ.ДатаИзменения	= МЗ.ДатаСоздания;
		Иначе
			МЗ.Модификатор 		= ПараметрыСеанса.ТекущийПользователь;
			МЗ.ДатаИзменения	= ТекущаяДата();
		КонецЕсли;
	ИначеЕсли МЗ.Автор.Пустая() Или МЗ.Модификатор.Пустая() Или МЗ.ДатаСоздания = Дата(1,1,1) Или МЗ.ДатаИзменения = Дата(1,1,1) Тогда
		МЗ.Автор 			= ПараметрыСеанса.ТекущийПользователь;
		МЗ.ДатаСоздания 	= ТекущаяДата();
		МЗ.ДатаИзменения 	= МЗ.ДатаСоздания;
		МЗ.Модификатор 		= МЗ.Автор;
	КонецЕсли;
	
КонецПроцедуры

