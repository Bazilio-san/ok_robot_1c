	Если СкрыватьКолонку Тогда
		//Если НЕ эСписок.Колонки.Найти(ИмяРеквизита) = Неопределено Тогда
			СкрытьКолонку(эСписок, ИмяРеквизита);
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ОП_ВозможноРедактирование(Оплата, Параметры = Неопределено) Экспорт
	
	Инфо = "";
	Параметры = Новый Структура;
	Параметры.Вставить("Полис", 						Ложь);
	Параметры.Вставить("ОплаченныйОтчетПоставщику",   	Ложь);
	Параметры.Вставить("СогласованныйОтчетПоставщику",	Ложь);
	Параметры.Вставить("ОтчетПоставщику",				Ложь);
	Параметры.Вставить("ДатаМониторинга",				Ложь);
	Параметры.Вставить("ЭтоНовый",						Оплата.Ссылка.Пустая());
	Параметры.Вставить("КВЗаблокировано",				Ложь);
	НетПрав = Не (ПравоДоступа("Изменение", Оплата.Метаданные()) И уб_КЭШируемые.ДоступностьРоли("ПолныеПрава"));
	Параметры.Вставить("НетПрав", НетПрав);
	//TODO уйти от получения номера через точку
//	ЗаголовокФормы = ?(Параметры.ЭтоНовый, " - НОВАЯ. ", " № " + Строка(Оплата.Номер) + ". ") + "Оплата полиса " + ?(СокрЛП(Оплата.СтраховойПолис.Номер) = "",""," № " + СокрЛП(Оплата.СтраховойПолис.Номер) + ". ");
	Если Не (НетПрав Или Параметры.ЭтоНовый) Тогда
		//|	ВЫБОР
		//|		КОГДА уб_СтраховойПолис.ПометкаУдаления
		//|				ИЛИ &СтраховойПолис = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
		//|			ТОГДА ИСТИНА
		//|		ИНАЧЕ ЛОЖЬ
		//|	КОНЕЦ КАК БлокировкаПолисом, // почему нельзя менять оплату, когда полис помечен на удаление ?
		ЗапросВозможноРедактирование = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Взаиморасчет.Ссылка КАК ЕстьПеречислениеСсылка
		|ПОМЕСТИТЬ ЕстьПеречисление
		|ИЗ
		|	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК Взаиморасчет
		|ГДЕ
		|	Взаиморасчет.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщику)
		|	И НЕ &ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
		|	И Взаиморасчет.ОтчетПоставщику = &ОтчетПоставщику
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уб_ОплатаПолисов.Ссылка,
		|	ЛОЖЬ КАК БлокировкаПолисом,
		|	ВЫБОР
		|		КОГДА ЕстьПеречисление.ЕстьПеречислениеСсылка ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Заблокирован,
		|	ВЫБОР
		|		КОГДА уб_ОтчетПоставщику.Проведен
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК БлокировкаОтчетомПоставщику,
		|	ВЫБОР
		|		КОГДА уб_ОтчетПоставщику.ДатаСогласования <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СогласованныйОтчетПоставщику
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		|		ПО (уб_СтраховойПолис.Ссылка = &СтраховойПолис)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ОтчетПоставщику КАК уб_ОтчетПоставщику
		|			ЛЕВОЕ СОЕДИНЕНИЕ ЕстьПеречисление КАК ЕстьПеречисление
		|			ПО (ИСТИНА)
		|		ПО (уб_ОтчетПоставщику.Ссылка = &ОтчетПоставщику)
		|ГДЕ
		|	уб_ОплатаПолисов.Ссылка = &Ссылка");
		ЗапросВозможноРедактирование.УстановитьПараметр("Ссылка", 			Оплата.Ссылка);
		ЗапросВозможноРедактирование.УстановитьПараметр("ОтчетПоставщику", 	Оплата.ОтчетПоставщику);
		ЗапросВозможноРедактирование.УстановитьПараметр("ОтчетАгента", 		Оплата.ОтчетАгента);
		ЗапросВозможноРедактирование.УстановитьПараметр("СтраховойПолис", 	Оплата.СтраховойПолис);
		Выборка = ЗапросВозможноРедактирование.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.БлокировкаПолисом Тогда
				Параметры.Полис = Истина;
				Инфо = ?(Инфо = "",""," / ") + "Полис";	
			КонецЕсли;				
			Если Выборка.Заблокирован Тогда
				Параметры.ОплаченныйОтчетПоставщику = Истина;
				ИнфоПоОтчету = "Оплаченный";
				//Инфо = Инфо + ?(ПустаяСтрока(Инфо), "", " / ") + "Оплаченный Отчет Поставщику";
			КонецЕсли;
			Если Выборка.СогласованныйОтчетПоставщику Тогда
				Параметры.СогласованныйОтчетПоставщику = Истина;
				ИнфоПоОтчету = ?(ИнфоПоОтчету = Неопределено, "Согласованный", ИнфоПоОтчету + ", Согласованный");
				ДопТекстСогласования = ?(уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("ПравоПравкиСогласованных",ЛОЖЬ) = ИСТИНА,""," (нельзя менять КВ)");//?(уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ"), "", " (нельзя менять КВ)");
				Параметры.КВЗаблокировано = Не (//уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ") ИЛИ 
				уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("ПравоПравкиСогласованных",ЛОЖЬ) = ИСТИНА);
			КонецЕсли;
			Если Выборка.БлокировкаОтчетомПоставщику Тогда
				Параметры.ОтчетПоставщику = Истина;
			КонецЕсли;
			Если ИнфоПоОтчету = Неопределено Тогда
				Если Параметры.ОтчетПоставщику Тогда
					Инфо = Инфо + ?(Инфо = "", "", " / ") + "Отчет Поставщику";	
				КонецЕсли;
			Иначе
				Инфо = Инфо + ?(Инфо = "", "", " / ") + ИнфоПоОтчету + " Отчет Поставщику" + ДопТекстСогласования;
			КонецЕсли;
			Если НЕ уб_СтраховойБрокер.МожноИспользоватьДатуМониторинга(Оплата.ДатаМониторинга) Тогда
				Параметры.ДатаМониторинга = Истина;
				Инфо = Инфо + ?(Инфо = "",""," / ") + "Дата мониторинга";	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Инфо <> "" Тогда
		Инфо = "[БЛОКИРАТОРЫ: " + Инфо + "]"; 
	КонецЕсли;
	Результат = Истина;
	Если Параметры.Полис Тогда
		Результат = Ложь
	ИначеЕсли Параметры.ОплаченныйОтчетПоставщику Тогда
		СтруктураБлокировкиОтчета = уб_temp.СтруктураБлокировкиДокумента(Оплата.Ссылка);
		Если СтруктураБлокировкиОтчета.Заблокирован Тогда
			Результат = Ложь
		КонецЕсли;
	КонецЕсли;
	Параметры.Вставить("ВозможноРедактирование", Результат);
	Если Не Результат Тогда
		Инфо = "Только просмотр. " + Инфо
	КонецЕсли;
	Параметры.Вставить("ЗаголовокФормы", Инфо);
	Возврат Результат;
	
КонецФункции

