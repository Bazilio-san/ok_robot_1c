Функция ДайДоговорМеждуПоставщикомИОргАгентом(Поставщик, ОрганизацияАгент, НаДату = Неопределено, Предупреждать = Ложь, ВидСП = Неопределено) Экспорт 
	
	лПустойДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Если ЗначениеНеЗаполнено(Поставщик) ИЛИ ЗначениеНеЗаполнено(ОрганизацияАгент) Тогда
		Возврат лПустойДоговор;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();	
	КонецЕсли;
	
	ЗапросДоговорСПоставщиком = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ДК.Ссылка,
	|	ВЫБОР
	//|		КОГДА ДК.Ссылка = &ОсновнойДоговор
	|		КОГДА ДК.Владелец = ДК.Владелец.ОсновнойДоговорКонтрагента
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Приоритет,
	|	ДК.ВидСП КАК ВидСП
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|ГДЕ
	|	ДК.Владелец = &Поставщик
	|	И ДК.Организация = &ОрганизацияАгент
	|	И НЕ ДК.ПометкаУдаления
	|	И ДК.ДатаЗаключенияДоговора <= &НаДату
	|	И (ДК.ДатаОкончанияДействияДоговора >= &НаДату
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора ЕСТЬ NULL 
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора = &НульДАта)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ,
	|	ДК.ДатаЗаключенияДоговора УБЫВ,
	|	ДК.ДатаОкончанияДействияДоговора";
	
	ЗапросДоговорСПоставщиком.УстановитьПараметр("Поставщик", 			Поставщик);
	//Запрос.УстановитьПараметр("ОсновнойДоговор", 	Поставщик.ОсновнойДоговорКонтрагента);
	ЗапросДоговорСПоставщиком.УстановитьПараметр("ОрганизацияАгент", 	ОрганизацияАгент);
	ЗапросДоговорСПоставщиком.УстановитьПараметр("НаДату", 			НаДату);
	ЗапросДоговорСПоставщиком.УстановитьПараметр("НульДАта", 			Дата("00010101000000"));
	
	ЗапросДоговорСПоставщиком.Текст = ТекстЗапроса;
	Результат = ЗапросДоговорСПоставщиком.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		//#Если Клиент Тогда
		//	Если Предупреждать Тогда
		//		Фрм = Поставщик.ПолучитьФорму();
		//		Если Фрм.Открыта() Тогда
		//			Возврат лПустойДоговор;		
		//		КОнецЕсли;	
		//		Заг = "Необходимо указать данные договора!";
		//		СОО = "Не найден действующий договор между 
		//		|Поставщиком: " + Строка(Поставщик) + "
		//		|и ОргАгентом: " + Строка(ОрганизацияАгент) + "
		//		|на дату: " + НаДату + "
		//		|
		//		|Зайдите в справочник Контрагентов и внесите данные договора!
		//		|
		//		|Открыть форму Контрагента-Поставщика для внесения изменений?";
		//		Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
		//		Если Ответ = КодВозвратаДиалога.Да Тогда
		//			Фрм.ЭлементыФормы.Панель.ТекущаяСтраница = Фрм.ЭлементыФормы.Панель.Страницы.СчетаИДоговоры;	
		//			Фрм.ОткрытьМодально();
		//		КонецЕсли;
		//	КонецЕсли;
		//#КонецЕсли			
		Возврат лПустойДоговор;	
	КонецЕсли;
	
	Если ТипЗНЧ(ВидСП) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") И НЕ ВидСП.Пустая() Тогда
		//Обходим результат первый раз, ищем соответствие по ВидуСП
		Для Каждого СтрокаТЗ Из Результат Цикл
			Если СтрокаТЗ.ВидСП = ВидСП Тогда
				Возврат СтрокаТЗ.Ссылка
			КонецЕсли;
		КонецЦикла;
		
		//Обходим результат второй раз, если значение ВидСП заполнено, ищем договора с незаполнеными ВидСП
		Для Каждого СтрокаТЗ Из Результат Цикл
			Если СтрокаТЗ.ВидСП.Пустая() Тогда
				Возврат СтрокаТЗ.Ссылка
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Если ничего не нашли, берем первый по приоритету
	Возврат Результат[0].Ссылка;
	
КонецФункции

Функция ОпределитьЭтоРасчетСУдержаниемКВ_ПоДоговору(Договор, Предупреждать = Истина) Экспорт 
	
	ЗапросЭтоРасчетСудержаниемКВ = Новый Запрос(
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.ВидВзаиморасчетов,
	|	ДоговорыКонтрагентов.ДатаЗаключенияДоговора,
	|	ДоговорыКонтрагентов.Владелец,
	|	ДоговорыКонтрагентов.Организация,
	|	ДоговорыКонтрагентов.Наименование
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Ссылка");
	ЗапросЭтоРасчетСудержаниемКВ.УстановитьПараметр("Ссылка", Договор);
	Выборка = ЗапросЭтоРасчетСудержаниемКВ.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ВидВзаиморасчетов = ПараметрыСеанса.уб_Константы.ВидВзаиморасчетовБезУдержанияКВ Тогда
			Результат = Ложь
		Иначе
			Если Не ЗначениеЗаполнено(Выборка.ВидВзаиморасчетов) И Предупреждать Тогда
				Заг = "Необходимо указать Вид Взаиморасчетов по договору!";
				СОО = "Не указан Вид Взаиморасчетов по договору № " + Выборка.Наименование + " от " 
				+ Формат(Выборка.ДатаЗаключенияДоговора, "ДФ='dd.MM.yyyy'") + "г. между 
				|Поставщиком: " + Выборка.Владелец + "
				|и ОргАгентом: " + Выборка.Организация + "
				|
				|Зайдите в справочник Контрагентов на закладку 'Счета и Договоры' и 
				|
				|в соответствующем договоре укажите вид взаиморасчетов!
				|
				|Открыть форму Договора для внесения изменений?";
				#Если Клиент Тогда
					Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
					Если Ответ = КодВозвратаДиалога.Да Тогда
						Фрм = Договор.ПолучитьОбъект().ПолучитьФорму();
						Фрм.Открыть();
						Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.ВидВзаиморасчетов;
					КонецЕсли;
				#КонецЕсли
			КонецЕсли;
			//TODO т.е. истина если мы даже выберем другое...
			Результат = Истина
		КонецЕсли;
	Иначе
		//По умолчанию - работаем с удержанием КВ
		Результат = Истина
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ОпределитьЭтоРасчетСУдержаниемКВ(Поставщик, ОрганизацияАгент, НаДату = Неопределено, Предупреждать = Истина,ВидСП = Неопределено) Экспорт 
	
	Договор = ДайДоговорМеждуПоставщикомИОргАгентом(Поставщик, ОрганизацияАгент, НаДату, Предупреждать,ВидСП);
	Возврат ОпределитьЭтоРасчетСУдержаниемКВ_ПоДоговору(Договор, Предупреждать);
	
КонецФункции

Функция ДайНомерБСОПоСП(оСП, ВидБСО = Неопределено, БСО2 = Неопределено) Экспорт
	
	ВидБСО = Справочники.уб_ВидыБСО.ПустаяСсылка();	
	Если БСО2 = Неопределено Тогда
		БСО = оСП.БСО;
		ЕстьКолонкаТип = Ложь;
		ЕстьКолонкаТипУчетаБСО = Ложь;
	Иначе
		БСО = ?(ТипЗнч(БСО2) = Тип("ТаблицаЗначений"), БСО2, БСО2.Выгрузить());
		ЕстьКолонкаТип = БСО.Колонки.Найти("ВидБСОТип") <> Неопределено;
		ЕстьКолонкаТипУчетаБСО = БСО.Колонки.Найти("ВидБСОТипУчетаБСО") <> Неопределено;
	КонецЕсли;
	Для Каждого СтрокаТЧ из БСО Цикл
		ТекВидБСО = СтрокаТЧ.ВидБСО;
		ТекВидБСОТип = ?(ЕстьКолонкаТип,СтрокаТЧ.ВидБСОТип,Неопределено);
		ТекВидБСОТипУчетаБСО = ?(ЕстьКолонкаТипУчетаБСО,СтрокаТЧ.ВидБСОТипУчетаБСО,Неопределено);
		Если уб_СЛ.ОпределитьЭтоПолис(ТекВидБСО,ТекВидБСОТип) И уб_СЛ.ЕстьНомерПолиса(ТекВидБСО,ТекВидБСОТипУчетаБСО) И Не ПустаяСтрока(СтрокаТЧ.НомерБСО) Тогда
			ВидБСО = ТекВидБСО;
			Возврат СтрокаТЧ.НомерБСО;				
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Функция БСОПоРегистратору(Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.текст = "ВЫБРАТЬ
	               |	уб_ДвиженияБСО.Период,
	               |	уб_ДвиженияБСО.Регистратор,
	               |	уб_ДвиженияБСО.НомерСтроки,
	               |	уб_ДвиженияБСО.Активность,
	               |	уб_ДвиженияБСО.ВидБСО,
	               |	уб_ДвиженияБСО.НомерБСО,
	               |	уб_ДвиженияБСО.СК,
	               |	уб_ДвиженияБСО.АгентОтправитель,
	               |	уб_ДвиженияБСО.Агент,
	               |	уб_ДвиженияБСО.ПоложениеБСО,
	               |	уб_ДвиженияБСО.СостояниеБСО,
	               |	уб_ДвиженияБСО.НомерПолиса,
	               |	уб_ДвиженияБСО.ГодПолиса,
	               |	уб_ДвиженияБСО.СтраховойПолис,
	               |	уб_ДвиженияБСО.НаОснованииБумажногоДокумента,
	               |	уб_ДвиженияБСО.ДатаВозврата,
	               |	уб_ДвиженияБСО.Заявка,
	               |	уб_ДвиженияБСО.Подтверждено,
	               |	уб_ДвиженияБСО.Поставщик,
	               |	уб_ДвиженияБСО.ОрганизацияАгент,
	               |	уб_ДвиженияБСО.СтраховаяПремия,
	               |	уб_ДвиженияБСО.Актуальная,
	               |	уб_ДвиженияБСО.ДопНомерБСО,
	               |	уб_ДвиженияБСО.КодОперации,
	               |	уб_ДвиженияБСО.Комментарий,
	               |	уб_ДвиженияБСО.ВидБСО.Тип,
	               |	уб_ДвиженияБСО.ВидБСО.ТипУчетаБСО
	               |ИЗ
	               |	РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	               |ГДЕ
	               |	уб_ДвиженияБСО.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор",Ссылка);			   
	БСО = Запрос.Выполнить().Выгрузить();
	Возврат БСО;
КонецФункции	

Процедура ОбновитьДокументВФорме(ДокументСсылка) Экспорт
	
	//Обновляет данные в открытой форме документа
	Если ЗначениеНеЗаполнено(ДокументСсылка) Тогда
		Возврат;	
	КонецЕсли;
	Фрм = ДокументСсылка.ПолучитьФорму();
	Если Фрм.Открыта() Тогда
		Попытка
			Фрм.ЭтотОбъект.Прочитать();
			Фрм.Обновить();
			Фрм.ПриОткрытии(); //Этот метод дб проэкспортирован в форме
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

//Для справочника уб_КВ
Процедура ПриИзмененииПроцентаКВ(Объект) Экспорт
	//Если Объект.Процент = Неопределено Тогда
	//	Объект.Процент = 0;
	//	Объект.ПроцентДляОтчета = 0;
	//	Возврат;	
	//КонецЕсли;
	
	Если ТипЗнч(Объект.Процент) <> Тип("Число") ИЛИ ТипЗнч(Объект.ПроцентДляОтчета) <> Тип("Число") Тогда
		Объект.ПроцентДляОтчета = Объект.Процент;
		Возврат;	
	КонецЕсли;
	
	Если Объект.ПроцентДляОтчета = 0 Тогда
		Если Объект.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО или Объект.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО Тогда
			Объект.ПроцентДляОтчета = Мин(10,Объект.Процент);
		Иначе
			Объект.ПроцентДляОтчета = Объект.Процент;
		КонецЕсли;
	ИначеЕсли Объект.ПроцентДляОтчета > Объект.Процент Тогда	
		Объект.ПроцентДляОтчета = Объект.Процент;
	КонецЕсли;
КонецПроцедуры

Функция ДайСписокПоставщиковДляСправочникаКВ() Экспорт
	СписокПоставщиков = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.Поставщик.Ссылка КАК ПоставщикСсылка,
	|	К.Поставщик.Наименование КАК ПоставщикНаименование,
	|	К.Поставщик.Родитель КАК ПоставщикРодитель,
	|	К.Поставщик.Родитель.Наименование КАК ПоставщикРодительНаименование,
	|	ВЫБОР
	|		КОГДА К.Поставщик.Родитель.Наименование <> ""НЕ АКТИВНЫЕ""
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Активность
	|ИЗ
	|	Справочник.уб_КВ КАК К
	|
	|УПОРЯДОЧИТЬ ПО
	|	Активность УБЫВ,
	|	ПоставщикРодительНаименование,
	|	ПоставщикНаименование";
	Рез = Запрос.Выполнить();
	Выборка = Рез.Выбрать();
	РодительНаименование = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если РодительНаименование <> Неопределено и РодительНаименование <> Выборка.ПоставщикРодительНаименование Тогда
			СписокПоставщиков.Добавить(Справочники.Контрагенты.ПустаяСсылка(),"===================");
		КонецЕсли;
		СписокПоставщиков.Добавить(Выборка.ПоставщикСсылка,Выборка.ПоставщикНаименование);
		РодительНаименование = Выборка.ПоставщикРодительНаименование;
	КонецЦикла;
	Возврат СписокПоставщиков;
КонецФункции

Процедура НачалоВыбораКВ(ФормаВладелец, Элемент, СтандартнаяОбработка) Экспорт
	#Если Клиент Тогда
		СтандартнаяОбработка = Ложь;
		
		СтароеЗначение = Элемент.Значение;
		ТипСтЗн = ТипЗнч(СтароеЗначение);
		Процент = ?(ТипСтЗн = Тип("Число"),СтароеЗначение,0);
		
		Список = Новый СписокЗначений;
		ЭлНом = Список.Добавить(Процент,"Процент",,БиблиотекаКартинок.уб_Процент);
		ЭлКрд = Список.Добавить(Перечисления.уб_ВидыКВ.Кредитное,"Кредитное КВ",,БиблиотекаКартинок.уб_КредитноеКВ);
		ЭлементПоУмолчанию = ?(ТипСтЗн = Тип("ПеречислениеСсылка.уб_ВидыКВ"),ЭлКрд,ЭлНом);
		ВыбранныйЭлемент = Список.ВыбратьЭлемент("Выберите вид значения КВ",ЭлементПоУмолчанию);
		
		ВыбранноеЗначение = ?(ВыбранныйЭлемент = Неопределено, СтароеЗначение, ВыбранныйЭлемент.Значение);
		
		Элемент.Значение = ВыбранноеЗначение;
		ВыбранПроцент = ТипЗнч(ВыбранноеЗначение) = Тип("Число");
		
		Элемент.РедактированиеТекста = ВыбранПроцент;
	#КонецЕсли
КонецПроцедуры

//Удаляет пустые колонки из ТаблицыЗначени или ДереваЗначений (ТЗ)
//В СписокНеудаляемыхКололнок передается перечень имен колонок через запятую, которые не нужно удалять  
Процедура УдалитьПустыеКолонки(ТЗ, СписокНеудаляемыхКололнок = "") Экспорт
	//Удаляем из таблицы колонки с пустыми значениями
	Колонки = ТЗ.Колонки;
	КоличествоКолонок = Колонки.Количество();
	
	СписокНеудаляемыхКололнок = "," + СтрЗаменить(СписокНеудаляемыхКололнок, " ", "") +  ",";
	Для Сч = 1 По КоличествоКолонок Цикл
		Кол = Колонки[КоличествоКолонок - Сч];
		ИмяКолонки = Кол.Имя;
		
		Если Найти(НРег(СписокНеудаляемыхКололнок), "," + НРег(ИмяКолонки) + ",") > 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		ВКолонкеЕстьЗначения = Ложь;
		Для Каждого Стр из ТЗ Цикл
			Если НЕ ЗначениеНеЗаполнено(Стр[ИмяКолонки]) Тогда
				ВКолонкеЕстьЗначения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ВКолонкеЕстьЗначения Тогда
			Колонки.Удалить(Кол);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

