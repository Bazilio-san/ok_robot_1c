// Получает значение параметра по названию на дату из регистра уб_ПараметрыДоговоровИОтчетов
//
// Параметры
//  Дата - тип: дата - Дата на которую надо найти значение параметра
//  Наименование  - тип: строка - наименование параметра из отчета
//                 
// Возвращаемое значение:
//   Строка - Значение параметра на дату
//
Функция ПолучитьЗначениеПараметра(ДатаПараметра, Параметр) Экспорт 
	
	Отбор = Новый Структура("Наименование", Параметр);
	ВыборкаПараметра = РегистрыСведений.уб_ПараметрыДоговоровИОтчетов.СрезПоследних(ДатаПараметра, Отбор);
	Если ВыборкаПараметра.Количество()>0 Тогда
		ЗначениеПараметра = ВыборкаПараметра[0].Значение;
	Иначе	
		ЗначениеПараметра = "";
	КонецЕсли; 
	
	Возврат ЗначениеПараметра;
КонецФункции // ПолучитьЗначениеПараметра()

//получает состояние БСО на определенную дату
//ТипУчетаБСО - Неопределено: ищет по всем, "кол" - только по количественным
Функция ПрочитатьТекущееСостояниеБСОПоСтрокеТЧ(СтруктураПараметров) Экспорт
	
	ПериодПовторнойПроверкиСостоянияБСО = ПараметрыСеанса.уб_Константы.ПериодПовторнойПроверкиСостоянияБСО;
	Если ТипЗнч(ПериодПовторнойПроверкиСостоянияБСО) <> Тип("Число") Тогда
		ПериодПовторнойПроверкиСостоянияБСО = 60;//Время устаревания данных (секунд)
	КонецЕсли;
	ЗначениеПараметра 	= Неопределено;	
	ТекСтрока 			= СтруктураПараметров.ТекСтрока;
	НаДату				= СтруктураПараметров.НаДату;
	ТекСостояниеБСО 	= ?(СтруктураПараметров.Свойство("ТекСостояниеБСО", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	тсАгент 			= ?(СтруктураПараметров.Свойство("тсАгент", 			ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	тсПоставщик 		= ?(СтруктураПараметров.Свойство("тсПоставщик", 		ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	тсОрганизацияАгент 	= ?(СтруктураПараметров.Свойство("тсОрганизацияАгент", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	хВидГраницы 		= ?(СтруктураПараметров.Свойство("хВидГраницы", 		ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ТипУчетаБСО 		= ?(СтруктураПараметров.Свойство("ТипУчетаБСО", 		ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ИсключитьОформленные = ?(СтруктураПараметров.Свойство("ИсключитьОформленные", ЗначениеПараметра), ЗначениеПараметра, Ложь);
	ДанныеПолиса		= ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(СтруктураПараметров, "ДанныеПолиса", Истина);
	ДанныеЗаявки		= ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(СтруктураПараметров, "ДанныеЗаявки", Истина);
	ПолучатьПодразделениеОтправителя = ?(СтруктураПараметров.Свойство("ПолучатьПодразделениеОтправителя", ЗначениеПараметра),ЗначениеПараметра,Ложь);
	//для номерного и количественного учета
	тсСК = ТекСтрока.СК;
	тсВидБСО = ТекСтрока.ВидБСО;
	Если хВидГраницы = Неопределено Тогда
		хВидГраницы = ВидГраницы.Исключая;
	КонецЕсли;
	НаМомент = Новый Граница(НаДату,хВидГраницы);
	СтруктураБСО = Новый Структура("Существует, НомернойУчет, КоличественныйУчет, Количество, Поставщик, ОрганизацияАгент, СостояниеБСО, ПоложениеБСО, АгентОтправитель, Владелец, ДатаВозврата, НомерПолиса, сСостояниеБСО, сПоложениеБСО, сВладелец, сДатаВозврата, сОрганизацияАгент, сПоставщик, СК, ВидБСО, НомерБСО, Регистратор, НаМомент, СтраховойПолис,Заявка, Блокировка, ВремяЗапроса"
	, Ложь,        Ложь,              Ложь,          0);
	СтруктураБСО.Вставить("НомерЗаявки");
	СтруктураБСО.Вставить("ДатаОформленияПолиса");
	СтруктураБСО.Вставить("Страхователь");
	СтруктураБСО.Вставить("СтраховойПродукт");
	СтруктураБСО.Вставить("ДатаНачалаДействияПолиса");
	СтруктураБСО.Вставить("ДатаОкончанияДействияПолиса");
	СтруктураБСО.Вставить("Менеджер");
	СтруктураБСО.Вставить("Курьер");
	СтруктураБСО.Вставить("ПодразделениеОтправитель");
	тсТипУчетаБСО = Неопределено;
	Если ТипУчетаБСО <> "кол" Тогда
		sНеНайден = "<не найден>";
		тсНомБСО = СокрЛП(ТекСтрока.НомерБСО);
		Если тсНомБСО = СокрЛП(уб_СЛ.ДайНомерБСОДляКоличУчета("")) Тогда
			тсНомБСО = "";
		КонецЕсли;
		УказанНомерБСО = тсНомБСО <> "";
		Если ТекСостояниеБСО <> Неопределено Тогда
			мСостояниеБСО = Неопределено;
			Ключ = уб_temp.УбратьНедопустимыеСимволыДляСтрок("k" + тсНомБСО 
			//+ ?(ЗначениеЗаполнено(тсВидБСО) и ТипЗнч(тсВидБСО) = Тип(""),тсВидБСО.УникальныйИдентификатор(),"")
			+ ?(ЗначениеЗаполнено(тсСК),тсСК.УникальныйИдентификатор(),"")
			+ ?(ЗначениеЗаполнено(тсПоставщик),тсПоставщик.УникальныйИдентификатор(),"")
			+ ?(ЗначениеЗаполнено(тсОрганизацияАгент),тсОрганизацияАгент.УникальныйИдентификатор(),""));
			Если ТекСостояниеБСО.Свойство(Ключ, мСостояниеБСО) 
				И ТипЗнч(мСостояниеБСО) = Тип("Структура") 
				И мСостояниеБСО.Свойство("ВремяЗапроса")
				И ТипЗнч(мСостояниеБСО.ВремяЗапроса) = Тип("Дата")
				И (ТекущаяДата() - мСостояниеБСО.ВремяЗапроса < ПериодПовторнойПроверкиСостоянияБСО) Тогда
				Возврат мСостояниеБСО;
			КонецЕсли;
		КонецЕсли;
		//Если указан непустой номер БСО, то пробуем найти БСО в регистре Движений БСО
		Если УказанНомерБСО Тогда					
			ЗапросСостояниеБСО = Новый Запрос;
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	уб_ДвиженияБСОСрезПоследних.Период,
			|	уб_ДвиженияБСОСрезПоследних.Регистратор,
			|	уб_ДвиженияБСОСрезПоследних.НомерСтроки,
			|	уб_ДвиженияБСОСрезПоследних.Активность,
			|	уб_ДвиженияБСОСрезПоследних.СК,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО,
			|	уб_ДвиженияБСОСрезПоследних.НомерБСО,
			|	уб_ДвиженияБСОСрезПоследних.Поставщик,
			|	уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент,
			|	уб_ДвиженияБСОСрезПоследних.Подтверждено,
			//|	уб_ДвиженияБСОСрезПоследних.ДокПроведен,
			//|	уб_ДвиженияБСОСрезПоследних.Активность Как ДокПроведен,
			|	уб_ДвиженияБСОСрезПоследних.АгентОтправитель,
			|	уб_ДвиженияБСОСрезПоследних.Агент,
			|	уб_ДвиженияБСОСрезПоследних.ПоложениеБСО,
			|	уб_ДвиженияБСОСрезПоследних.СостояниеБСО,
			|	уб_ДвиженияБСОСрезПоследних.НомерПолиса,
			|	уб_ДвиженияБСОСрезПоследних.ГодПолиса,
			|	уб_ДвиженияБСОСрезПоследних.СтраховойПолис,
			|	уб_ДвиженияБСОСрезПоследних.НаОснованииБумажногоДокумента,
			|	уб_ДвиженияБСОСрезПоследних.ДатаВозврата,
			|	уб_ДвиженияБСОСрезПоследних.Заявка,
			|	уб_ДвиженияБСОСрезПоследних.КодОперации,
			|	уб_ДвиженияБСОСрезПоследних.Комментарий,
			|	ПРЕДСТАВЛЕНИЕ(уб_ДвиженияБСОСрезПоследних.СостояниеБСО) КАК СостояниеБСОПредставление,
			|	ПРЕДСТАВЛЕНИЕ(уб_ДвиженияБСОСрезПоследних.ПоложениеБСО) КАК ПоложениеБСОПредставление,
			|	уб_ДвиженияБСОСрезПоследних.Поставщик.Представление,
			|	уб_ДвиженияБСОСрезПоследних.Агент.Представление,
			|	уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент.Представление,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип КАК Тип,
			|	987 КАК ДопПоля,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО.ТипУчетаБСО КАК ТипУчетаБСО
			|ИЗ
			|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
			|			&НаМомент,
			|			ВидБСО = &ВидБСО
			|				И НомерБСО = &НомерБСО
			|				И Подтверждено = &Подтверждено
			|               И 1 = 1) КАК уб_ДвиженияБСОСрезПоследних";			
			ДопПоля = "";
			ДопСоединения = "";
			Если ПолучатьПодразделениеОтправителя = Истина Тогда
				ДопПоля = ДопПоля + "ПодразделениеСрез.Подразделение КАК ПодразделениеОтправитель, ";
				ДопСоединения = ДопСоединения+" 
				|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&НаМомент) КАК ПодразделениеСрез 
				|   ПО ПодразделениеСрез.Агент = уб_ДвиженияБСОСрезПоследних.Агент "
			КонецЕсли;
			Если ДанныеЗаявки Тогда
				ДопПоля = ДопПоля + "
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.Заявка.НомерЗаявки, НЕОПРЕДЕЛЕНО) КАК НомерЗаявки,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.Заявка.Менеджер, НЕОПРЕДЕЛЕНО) КАК Менеджер,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.Заявка.Курьер, НЕОПРЕДЕЛЕНО) КАК Курьер,"
			КонецЕсли;
			Если ДанныеПолиса Тогда
				ДопПоля = ДопПоля + "
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.СтраховойПолис.Дата, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаОформленияПолиса,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.СтраховойПолис.Страхователь, НЕОПРЕДЕЛЕНО) КАК Страхователь,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.СтраховойПолис.СтраховойПродукт, НЕОПРЕДЕЛЕНО) КАК СтраховойПродукт,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.СтраховойПолис.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаНачалаДействияПолиса,
				|	ЕСТЬNULL(уб_ДвиженияБСОСрезПоследних.СтраховойПолис.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаОкончанияДействияПолиса,"
			КонецЕсли;
			ЕстьБлокировка = НЕ ПараметрыСеанса.уб_Константы.уб_НеИспользоватьБлокировкиБСО = Истина;
			Если ЕстьБлокировка Тогда
				ДопПоля = ДопПоля + "
				|   ВЫБОР
				|		КОГДА &НеИспользоватьБлокировкиБСО = ИСТИНА
				|			ТОГДА ЛОЖЬ
				|		ИНАЧЕ ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ)
				|	КОНЕЦ КАК Блокировка, ";
				ДопСоединения = ДопСоединения + " 
				|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних(
				|				&НаМомент,
				|				ВидБСО = &ВидБСО
				|					И НомерБСО = &НомерБСО) КАК уб_БлокировкаБСОСрезПоследних
				|		ПО уб_ДвиженияБСОСрезПоследних.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
				|			И уб_ДвиженияБСОСрезПоследних.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО ";
			КонецЕсли;		
			Если ДопПоля <> "" Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "987 КАК ДопПоля,", ДопПоля);
			КонецЕсли;
			Если ДопСоединения <> "" Тогда
				ТекстЗапроса = ТекстЗапроса+ДопСоединения;
			КонецЕсли;	
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И 1 = 1", ?(ИсключитьОформленные=Истина,"И НЕ СостояниеБСО = Значение(Перечисление.уб_СостоянияБСО.Оформлен)",""));
			ЗапросСостояниеБСО.Текст = ТекстЗапроса+ "
			|Упорядочить ПО уб_ДвиженияБСОСрезПоследних.Период УБЫВ";
			ЗапросСостояниеБСО.УстановитьПараметр("СК",							тсСК);
			ЗапросСостояниеБСО.УстановитьПараметр("ВидБСО",						тсВидБСО);
			ЗапросСостояниеБСО.УстановитьПараметр("НомерБСО",					тсНомБСО);
			ЗапросСостояниеБСО.УстановитьПараметр("Подтверждено",				Истина);
			//Запрос.УстановитьПараметр("ДокПроведен",				Истина);
			ЗапросСостояниеБСО.УстановитьПараметр("НаМомент",					НаМомент);
			ЗапросСостояниеБСО.УстановитьПараметр("НеИспользоватьБлокировкиБСО",НЕ ЕстьБлокировка);
			Выборка = ЗапросСостояниеБСО.Выполнить().Выбрать();            
			//ВсегоЗаписей = Выборка.Количество();
			Если Выборка.Следующий() Тогда
				тсТипУчетаБСО = Выборка.ТипУчетаБСО;
				СтруктураБСО.ВремяЗапроса 				= ТекущаяДата();
				СтруктураБСО.НаМомент 					= НаМомент;
				СтруктураБСО.Существует 				= Истина;
				СтруктураБСО.СК 						= Выборка.СК;
				СтруктураБСО.ВидБСО 					= тсВидБСО;
				СтруктураБСО.НомерБСО 					= тсНомБСО;
				СтруктураБСО.Поставщик 	   				= Выборка.Поставщик;
				СтруктураБСО.ОрганизацияАгент 			= Выборка.ОрганизацияАгент;
				СтруктураБСО.СостояниеБСО 	   			= Выборка.СостояниеБСО;
				СтруктураБСО.ПоложениеБСО 	   			= Выборка.ПоложениеБСО;
				СтруктураБСО.АгентОтправитель 			= Выборка.АгентОтправитель;
				СтруктураБСО.Владелец 		   			= Выборка.Агент;
				СтруктураБСО.НомернойУчет 	    		= уб_СЛ.ОпределитьВедетсяНомернойУчет(тсВидБСО,	тсТипУчетаБСО);
				СтруктураБСО.КоличественныйУчет 		= уб_СЛ.ОпределитьВедетсяКоличественныйУчет(тсВидБСО, тсТипУчетаБСО);
				СтруктураБСО.Количество		    		= 1;
				СтруктураБСО.ДатаВозврата 				= Выборка.ДатаВозврата;
				СтруктураБСО.НомерПолиса 				= Выборка.НомерПолиса;
				СтруктураБСО.Регистратор 				= Выборка.Регистратор;
				СтруктураБСО.СтраховойПолис 			= Выборка.СтраховойПолис;
				СтруктураБСО.Заявка 					= Выборка.Заявка;
				СтруктураБСО.сСостояниеБСО 				= ?(СтруктураБСО.СостояниеБСО 		= Неопределено, ?(СтруктураБСО.Существует,"???",sНеНайден), Выборка.СостояниеБСОПредставление);
				СтруктураБСО.сПоложениеБСО 				= ?(СтруктураБСО.ПоложениеБСО 		= Неопределено, ?(СтруктураБСО.Существует,"???",sНеНайден), Выборка.ПоложениеБСОПредставление);
				СтруктураБСО.сВладелец 					= ?(СтруктураБСО.Владелец 			= Неопределено,	?(СтруктураБСО.Существует,"--->",sНеНайден),Выборка.АгентПредставление);
				СтруктураБСО.сДатаВозврата 				= ?(СтруктураБСО.ДатаВозврата 		= Неопределено,	"", ?(СтруктураБСО.ДатаВозврата = Дата("00010101000000"), "- - -",Строка(СтруктураБСО.ДатаВозврата)));
				СтруктураБСО.сОрганизацияАгент 			= ?(СтруктураБСО.ОрганизацияАгент 	= Неопределено,	?(СтруктураБСО.Существует,"",sНеНайден),Выборка.ОрганизацияАгентПредставление);
				СтруктураБСО.сПоставщик 				= ?(СтруктураБСО.Поставщик 			= Неопределено,	?(СтруктураБСО.Существует,"",sНеНайден),Выборка.ПоставщикПредставление);
				СтруктураБСО.Блокировка 				= ?(ЕстьБлокировка, Выборка.Блокировка, Ложь);
				Если ДанныеЗаявки Тогда
					СтруктураБСО.НомерЗаявки	= Выборка.НомерЗаявки;
					СтруктураБСО.Менеджер		= Выборка.Менеджер;
					СтруктураБСО.Курьер			= Выборка.Курьер;
				КонецЕсли;
				Если ДанныеПолиса Тогда					
					СтруктураБСО.ДатаОформленияПолиса   	= Выборка.ДатаОформленияПолиса;
					СтруктураБСО.Страхователь				= Выборка.Страхователь;
					СтруктураБСО.ДатаНачалаДействияПолиса	= Выборка.ДатаНачалаДействияПолиса;
					СтруктураБСО.ДатаОкончанияДействияПолиса= Выборка.ДатаОкончанияДействияПолиса;
				КонецЕсли;
				Если ПолучатьПодразделениеОтправителя = Истина Тогда
					СтруктураБСО.ПодразделениеОтправитель = Выборка.ПодразделениеОтправитель;
				КонецЕсли;	
				Если ТекСостояниеБСО <> Неопределено Тогда
					Попытка
						ТекСостояниеБСО.Вставить(Ключ, СтруктураБСО);
					Исключение
					Конецпопытки	
				КонецЕсли;
				СтруктураПараметров.Вставить("ТекСостояниеБСО",ТекСостояниеБСО);				
				Возврат СтруктураБСО;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Указан
	// либо пустой номер БСО
	// либо Непустой, но не найден в регистре Движений БСО
	// либо ТипУчетаБСО = "кол"
	Если уб_СЛ.ОпределитьВедетсяКоличественныйУчет(тсВидБСО,тсТипУчетаБСО) Тогда
		СтруктураОтбора = Новый Структура("Период, Поставщик, ОрганизацияАгент, СК, ВидБСО, Агент"
		,НаМомент
		,тсПоставщик
		,тсОрганизацияАгент
		,тсСК
		,тсВидБСО
		,тсАгент
		);
		тзРег = уб_СЛ.ПолучитьОстаткиБСО(СтруктураОтбора);
		Если тзРег.Количество() > 0 Тогда
			тз = тзРег[0];
			СтруктураБСО.Поставщик 	= тз.Поставщик;
			СтруктураБСО.ОрганизацияАгент 		= тз.ОрганизацияАгент;
			СтруктураБСО.СостояниеБСО 	= "Остаток: " + тз.Количество;
			СтруктураБСО.ПоложениеБСО 	= "на руках";
			//СтруктураБСО.АгентОтправитель 		= Неопределено;
			СтруктураБСО.Владелец 		= тз.Агент;
			СтруктураБСО.Количество 	= тз.Количество;
			//СтруктураБСО.Регистратор 	= Неопределено;
			СтруктураБСО.сВладелец 		= ?(СтруктураБСО.Владелец = Неопределено,"-=-=-",тз.АгентПредставление);
			СтруктураБСО.сОрганизацияАгент 		= ?(СтруктураБСО.ОрганизацияАгент = Неопределено,"-=-=-",тз.ОрганизацияАгентПредставление);
			СтруктураБСО.сПоставщик 	= ?(СтруктураБСО.Поставщик = Неопределено,"-=-=-",тз.ПоставщикПредставление);
		Иначе
			СтруктураБСО.Поставщик 	= Неопределено;
			СтруктураБСО.сПоставщик 	= "-=-=-";
			СтруктураБСО.ОрганизацияАгент 		= Неопределено;
			СтруктураБСО.сОрганизацияАгент 		= "-=-=-";
			СтруктураБСО.СостояниеБСО 	= "Остаток: 0";
			СтруктураБСО.ПоложениеБСО 	= "";
			СтруктураБСО.Владелец 		= тсАгент;
			СтруктураБСО.сВладелец 		= ?(СтруктураБСО.Владелец = Неопределено,"-=-=-",Строка(тсАгент));//-
			СтруктураБСО.Количество 	= 0;
		КонецЕсли;
		СтруктураБСО.ВремяЗапроса 	= ТекущаяДата();
		СтруктураБСО.НаМомент 		= НаМомент;
		СтруктураБСО.Существует 	= Истина;
		СтруктураБСО.НомернойУчет 	= Ложь;
		СтруктураБСО.КоличественныйУчет 	= Истина;
		СтруктураБСО.ДатаВозврата 	= Неопределено;
		СтруктураБСО.сСостояниеБСО 	= Строка(СтруктураБСО.СостояниеБСО);//-
		СтруктураБСО.сПоложениеБСО 	= Строка(СтруктураБСО.ПоложениеБСО);//-
		СтруктураБСО.сДатаВозврата 	= "";
		//Возвращаем либо заполненное, либо пустое соответствие
		Если ТекСостояниеБСО <> Неопределено Тогда
			ТекСостояниеБСО.Вставить(Ключ, СтруктураБСО);
		КонецЕсли;
	ИначеЕсли уб_СЛ.ОпределитьВедетсяНомернойУчет(тсВидБСО,тсТипУчетаБСО) Тогда
		//Возвращаем пустое соответствие
		СтруктураБСО.НаМомент 				= НаМомент;
		СтруктураБСО.Существует 			= Ложь;
		СтруктураБСО.СК 					= тсСК;
		СтруктураБСО.ВидБСО 				= тсВидБСО;
		СтруктураБСО.НомерБСО 				= тсНомБСО;
		СтруктураБСО.НомернойУчет 			= Истина;
		СтруктураБСО.КоличественныйУчет 	= Ложь;
		СтруктураБСО.сСостояниеБСО 			= sНеНайден;
		СтруктураБСО.сПоложениеБСО 			= sНеНайден;
		СтруктураБСО.сВладелец 				= sНеНайден;
		СтруктураБСО.сДатаВозврата 			= "";
		СтруктураБСО.сОрганизацияАгент 		= sНеНайден;
		СтруктураБСО.сПоставщик 			= sНеНайден;
		СтруктураБСО.ВремяЗапроса 			= ТекущаяДата();
	ИначеЕсли уб_СЛ.ОпределитьУчетНеВедется(тсВидБСО,тсТипУчетаБСО) Тогда
		СтруктураБСО.НаМомент 				= НаМомент;
		СтруктураБСО.Существует 			= Ложь;
		СтруктураБСО.НомернойУчет 			= Ложь;
		СтруктураБСО.КоличественныйУчет 	= Ложь;
		СтруктураБСО.сСостояниеБСО 			= "[учет не ведется]";
		СтруктураБСО.сПоложениеБСО 			= "";
		СтруктураБСО.сВладелец 				= "";
		СтруктураБСО.сДатаВозврата 			= "";
		СтруктураБСО.сОрганизацияАгент 		= "";
		СтруктураБСО.сПоставщик 			= "";
		СтруктураБСО.ВремяЗапроса 			= ТекущаяДата();
	КонецЕсли;
	СтруктураПараметров.Вставить("ТекСостояниеБСО",ТекСостояниеБСО);	
	Возврат СтруктураБСО;
	
КонецФункции

