Функция ПрочитатьФИОФизЛица(ФизЛицо, Падеж = Неопределено) Экспорт
	ФИОСрез = РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(,Новый Структура("ФизЛицо",ФизЛицо));
	Если ПустаяСтрока(ФИОСрез.Фамилия + ФИОСрез.Имя + ФИОСрез.Отчество) Тогда
		ФИОСрез = РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(,Новый Структура("ФизЛицо",ФизЛицо));
	КонецЕсли;
	Возврат (ФИОСрез.Фамилия + " " + ФИОСрез.Имя + " " + ФИОСрез.Отчество);
КонецФункции

Функция ССПрочитСостБСО(СК, ВидБСО, НомерБСО, дПериод = Неопределено, Поставщик = Неопределено, ОрганизацияАгент = Неопределено) Экспорт
	
	
	СтруктураБСО = уб_СЛ.ПолучитьСтруктуруБСО();
	
	СтруктураБСО.СК 				= СК;
	СтруктураБСО.ВидБСО 			= ВидБСО;
	СтруктураБСО.НомерБСО 			= НомерБСО;
	
	СтруктураБСО.Период = ?(дПериод = Неопределено, ТекущаяДата(), дПериод);
	СтруктураБСО.Поставщик = Поставщик;
	СтруктураБСО.ОрганизацияАгент 	= ОрганизацияАгент;
	
	уб_СЛ.ПрочитатьСостояниеБСО(СтруктураБСО);
	
	Возврат  СтруктураБСО;
КонецФункции

