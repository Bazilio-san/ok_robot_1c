// неактуальна. Используется только в неактуальной процедуре НачалоВыбораАгента
Процедура НачалоВыбораПоразделения(
	ФормаВладелец, 
	Элемент, 
	Группа = Неопределено, 
	Фильтровать = Ложь,
	ЗаголовокФормы = Неопределено
	) Экспорт
	
	Справ =	Справочники.ПодразделенияОрганизаций;
	
	Форм = Справ.ПолучитьФормуВыбора("ФормаВыбораДляБСО",ФормаВладелец);
	
	Если ЗаголовокФормы <> Неопределено Тогда
		Форм.Заголовок = ЗаголовокФормы;
	КонецЕсли;
	
	эСС = Форм.ЭлементыФормы.СправочникСписок;
	
	Если Элемент.Значение <> Справ.ПустаяСсылка() И Элемент.Значение <> Неопределено Тогда
		Форм.НачальноеЗначениеВыбора = Элемент.Значение;
		Форм.ПараметрТекущаяСтрока = Элемент.Значение; 
	КонецЕсли;
	
	Если ЗначениеНеЗаполнено(эСС.ТекущаяСтрока) И НЕ ЗначениеНеЗаполнено(Группа) Тогда
		эСС.ТекущаяСтрока = Группа;
	КонецЕсли;
	
	Если Фильтровать Тогда
		эСС.НастройкаОтбора.Ссылка.Доступность = Истина;
		СОС = Форм.СправочникСписок.Отбор.Ссылка;
		СОС.Использование = Истина;
		СОС.ВидСравнения = ВидСравнения.ВИерархии;
		СОС.Значение = Группа;
		//эСС.РодительВерхнегоУровня = Группа;
	КонецЕсли;
	
	ТекСтрока = Форм.ОткрытьМодально();
	//После закрытия...
	Если ТекСтрока <> Неопределено Тогда
		Форм.ОповеститьОВыборе(ТекСтрока);
		Элемент.Значение = ТекСтрока.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

