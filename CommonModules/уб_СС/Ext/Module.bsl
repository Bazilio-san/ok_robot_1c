
//Для запуска кода в режиме отладки
Функция Ду(Код, П = Неопределено, П1 = Неопределено,  П2 = Неопределено, П3 = Неопределено, П4 = Неопределено)  Экспорт
	
	Перем Р;
	Попытка
		Выполнить(Код)
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.Ду() ошибка кода программы. Код:
		|" + Код, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина)
	КонецПопытки;
	Возврат Р;
	
КонецФункции

//Для изменения значений переменных в режиме отладки
Функция Присвоить(А,Б) Экспорт
	А=Б; Возврат А;
КонецФункции	  

Процедура ДобСОО(ТзОшибки, СОО, oОплатыСписок = Неопределено, Статус = Неопределено, Откуда = Неопределено) Экспорт
	//SS Добавление СОО об Оплате
	Стр = ТзОшибки.Добавить();
	Стр.Ошибка = СОО;
	Стр.Элемент = oОплатыСписок;
	Стр.Строка = Неопределено;
	
	Если Откуда = "ОтчетАгента" Тогда
		Стр.Панель = Неопределено;
		Стр.Страница = Неопределено;
		
	ИначеЕсли Откуда = "СтраховойПолис" Тогда 	
		Стр.Панель = "ОсновнаяПанель";
		Стр.Страница = "Оплаты";
		
	ИначеЕсли Откуда = "РегистрОплат" Тогда 	
		Стр.Панель = Неопределено;
		Стр.Страница = Неопределено;
		
	Иначе
		Стр.Панель = Неопределено;
		Стр.Страница = Неопределено;
		
	КонецЕсли; 	
	
	Стр.Статус = ?(Статус = Неопределено,СтатусСообщения.Обычное,Статус);
КонецПроцедуры

// Получает пользователя по физлицу
//
// Параметры
//  Физлицо - ссылка на элемент справочника физлица
//
// Возвращаемое значение
//  Ссылка на элемент справочника Пользователи или Неопределено
//
Функция ПолучПользователяПоФизЛицу(оФизЛицо) Экспорт
	оПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", оФизЛицо);
	Если НЕ ЗначениеНеЗаполнено(оПользователь) Тогда
		Возврат оПользователь;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

