//Получение Подразделения с назначенным МОЛ по БСО для переданного подразделения
// начиная с переданного подразделения
// по иерархии подразделений вверх, ищем такое, у которого одновременно 
// указано "Учет БСО" и установлен МОЛ по БСО
//
&НаСервере
Функция ПолучитьПодразделениеМОЛпоБСО(Подразделение) Экспорт
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Подразделение.УчетБСО И ЗначениеЗаполнено(Подразделение.МОЛпоБСО) Тогда
		Возврат Подразделение;
	Иначе
		Возврат ПолучитьПодразделениеМОЛпоБСО(Подразделение.Родитель);
	КонецЕсли;
КонецФункции

