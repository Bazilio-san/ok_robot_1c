Процедура НачалоВыбораСтрахователя(ФормаВладелец, Элемент,ВыборТипаЭлемента = Ложь) Экспорт
	
	#Если Клиент Тогда	
		Если ВыборТипаЭлемента = Ложь И ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			НачалоВыбораСтрахователяФизЛица(ФормаВладелец, Элемент);
		ИначеЕсли ВыборТипаЭлемента = Ложь И ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			НачалоВыбораСтрахователяЮрЛица(ФормаВладелец, Элемент);
		Иначе
			СписокСправочников = Новый СписокЗначений;
			ЭлементПоУмолчанию = СписокСправочников.Добавить(Справочники.ФизическиеЛица,"Физическое Лицо",,БиблиотекаКартинок.ЗначокФизическоеЛицо16);
			СписокСправочников.Добавить(Справочники.Контрагенты,"Юридическое Лицо",,БиблиотекаКартинок.ЗначокКонтрагент16);
			//ВыбранныйЭлемент = СписокСправочников.ВыбратьЭлемент("Выберите тип страхователя",ЭлементПоУмолчанию);
			//ВыбранныйЭлемент = ФормаВладелец.ВыбратьИзМеню(СписокСправочников,Элемент);
			ВыбранныйЭлемент = ФормаВладелец.ВыбратьИзСписка(СписокСправочников,Элемент);
			Если ВыбранныйЭлемент = Неопределено Тогда
				Возврат;
			КонецЕсли;
			Если ВыбранныйЭлемент.Значение = Справочники.ФизическиеЛица Тогда
				НачалоВыбораСтрахователяФизЛица(ФормаВладелец, Элемент);
			ИначеЕсли ВыбранныйЭлемент.Значение = Справочники.Контрагенты Тогда
				НачалоВыбораСтрахователяЮрЛица(ФормаВладелец, Элемент);
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры
