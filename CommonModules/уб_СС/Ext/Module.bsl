		ТЗПодразделений = Новый ТаблицаЗначений;
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.ПодразделенияОрганизаций"));
		ТЗПодразделений.Колонки.Добавить("Подразделение", 		Новый ОписаниеТипов(Массив));
		ТЗПодразделений.Колонки.Добавить("ПодразделениеСтрока", ОписаниеТипаСтрока50);
		ТЗПодразделений.Колонки.Добавить("Заместитель",			ОписаниеТипаБулево);
		Структура.Вставить("ТЗПодразделений",			ТЗПодразделений);
	Иначе
		Структура.Вставить("ТЗПодразделений", Новый Массив);
		Структура.Вставить("СтруктураТЗПодразделений", Новый Структура("Подразделение,ПодразделениеСтрока,Заместитель"));
	КонецЕсли;
	Структура.Вставить("СписокПодразделений",		Новый СписокЗначений);
	Структура.Вставить("СписокОрганизаций",			Новый СписокЗначений);
	Структура.Вставить("Сотрудник",					Справочники.ФизическиеЛица.ПустаяСсылка());
	Структура.Вставить("ПодразделениеСотрудника",	Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
	Структура.Вставить("РуководительСотрудника",	Справочники.ФизическиеЛица.ПустаяСсылка());
	Структура.Вставить("ЗаместительРуководителяСотрудника",	Справочники.ФизическиеЛица.ПустаяСсылка());
	Структура.Вставить("ТребуетсяПроверкаЛичныхЗаявок",	ЛОЖЬ);
	Структура.Вставить("ТребуетсяПроверкаСкидок",	    ЛОЖЬ);
	Структура.Вставить("НеПроверятьСрочность",	    ЛОЖЬ);
	Структура.Вставить("НеОплачиваютВыезд",	    ЛОЖЬ);
	Структура.Вставить("НеНуженАндеррайтингЗаявок",	    ЛОЖЬ);
	Структура.Вставить("БезОтделаКонтроля",	    Ложь);
	
	Структура.Вставить("ИспытательныйСрок",	Ложь);
	Структура.Вставить("ВзаиморасчетыПрекращены ",	Ложь);
	Структура.Вставить("ОрганизацияСотрудника",		Справочники.Организации.ПустаяСсылка());
	Структура.Вставить("ЭтоРуководитель",			Ложь);
	//используется, чтобы закэшировать данные в функции ДоступКДанным(), к какому подразделению относится документ
	//по физлицам доступа
	Структура.Вставить("ПодразделенияПоДокументу", 	Новый СписокЗначений);
	СтруктураПоДокументу = Новый Структура;
	СтруктураПоДокументу.Вставить("РукИлиЗам", 	Ложь);
	СтруктураПоДокументу.Вставить("Рук", 		Ложь);
	СтруктураПоДокументу.Вставить("Зам",        Ложь);
	Структура.Вставить("СтруктураПоДокументу", СтруктураПоДокументу);
	Возврат Структура;

КонецФункции // СтруктураПараметров()

// процедуры НачалоВыбора

Процедура НачалоВыбора(
	Владелец,
	СтандартнаяОбработка	= Неопределено,
	Знач НастройкиМеню		= "",
	Параметры 				= Неопределено
	) Экспорт

	Перем Группа, Менеджер, Заголовок, ИерархическийПросмотр, ИмяОбъекта, РезультатФормыВыбора, Фильтровать;
	
	ТипЗнчВладелец = ТипЗнч(Владелец);
	ТипЗнчВладелецПолеВвода = ТипЗнчВладелец = Тип("ПолеВвода") Или ТипЗнчВладелец = Тип("ПолеВыбора"); 
	ТипДругоеПоле = ТипЗнчВладелец = Тип("ПолеФормы") ;
	Если Не (ТипЗнчВладелецПолеВвода или ТипДругоеПоле ) Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.НачалоВыбора(): поле-владелец некорректного типа: " + ТипЗнч(Владелец), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
		СтандартнаяОбработка = Истина;
		Возврат;
	КонецЕсли;
	Заголовок 	= "";
	Фильтровать = Ложь;
	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыНачалаВыбора();
	КонецЕсли;
	Если ТипДругоеПоле Тогда
		Если Параметры.ОтображениеМеню.ФизическиеЛица = Истина Тогда
			Значение    = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
			ТипЗначения = Тип("СправочникСсылка.ФизическиеЛица");
		Иначе//Если Параметры.ОтображениеМеню.Контрагенты = Истина Тогда	
			Если Параметры.Свойство("Значение") Тогда
				Значение = Параметры.Значение;
			Иначе	
				Значение = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
			КонецЕсли;	
			ТипЗначения = Тип("СправочникСсылка.Контрагенты");
		КонецЕсли;
	Иначе	
		Значение 	= Владелец.Значение;
		ТипЗначения = Владелец.ТипЗначения;
	КонецЕсли;	
	Заголовок	= "";
	ОткрыватьБезМеню = Ложь;
	ОтображениеМеню = Параметры.ОтображениеМеню;
	Если Не ПустаяСтрока(НастройкиМеню) Тогда
		НастройкиМеню = НРег(СокрЛП(НастройкиМеню));
		Массив = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(НастройкиМеню, ",");
		Счетчик = 0;
		Для Каждого ЭлементМассива Из Массив Цикл
			Счетчик = Счетчик + 1;
			ЭлементМассива = СокрЛП(ЭлементМассива);
			Если Счетчик = 1 И ЭлементМассива = "все" Тогда
				Параметры.ВыборИзМеню = Истина;
				Для Каждого КлючИЗначение Из ОтображениеМеню Цикл
					ОтображениеМеню[КлючИЗначение.Ключ] = Истина;
				КонецЦикла;
			Иначе
				МассивУсловия = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ЭлементМассива, " ");
				УсловиеНе = Ложь;
				Для Каждого ЭлементМассиваУсловия Из МассивУсловия Цикл
					ЭлементМассиваУсловия = СокрЛП(ЭлементМассиваУсловия);
					Если ЭлементМассиваУсловия = "не" Тогда
						УсловиеНе = Не УсловиеНе
					Иначе
						Если ОтображениеМеню.Свойство(ЭлементМассиваУсловия) Тогда
							Параметры.ВыборИзМеню = Истина;
							ОтображениеМеню[ЭлементМассиваУсловия] = Не УсловиеНе;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого КлючИЗначение Из ОтображениеМеню Цикл
			Если ОтображениеМеню[КлючИЗначение.Ключ] Тогда
				Параметры.ВыборИзМеню = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) И Не Параметры.ВыборТипа Тогда
		ОткрыватьБезМеню = Истина;
		НачальноеЗначениеВыбора = Значение;
	ИначеЕсли Параметры.ВыборИзМеню и ОтображениеМеню.Количество() = 1  Тогда	
		ОткрыватьБезМеню = Истина;
		НачальноеЗначениеВыбора = Значение;
	ИначеЕсли Параметры.ВыборИзМеню Тогда
		// выводим меню для составного типа
		Меню = Новый СписокЗначений;
		Если Параметры.ЗадействоватьОграничениеТипа И ТипЗнчВладелецПолеВвода Тогда
			// у поля выбора нет ограничения типа
			ОграничениеТипа = Владелец.ОграничениеТипа;
		КонецЕсли;
		Если ОграничениеТипа = Неопределено Тогда
			ЕстьОграничениеТипа = Ложь;
		Иначе
			ЕстьОграничениеТипа = ОграничениеТипа.Типы().Количество() > 0;
		КонецЕсли;
		// TODO может сделать разделитель между элементами меню по типу значения?
		// или TODO сортировать элементы как они были раньше?				
		Если Параметры.МенюПоТипам.Свойство("ФизическиеЛица") и Параметры.МенюПоТипам.ФизическиеЛица = Неопределено Тогда
			Если ТипЗнчВладелецПолеВвода Тогда
				Тип = Тип("СправочникСсылка.ФизическиеЛица");
				ЕстьТипФизическиеЛица = (ТипЗначения.СодержитТип(Тип("Строка")) и НЕ Прав(Владелец.Имя,2)="СК" ) или (ТипЗначения.СодержитТип(Тип) И (Не ЕстьОграничениеТипа Или ОграничениеТипа.СодержитТип(Тип))) ;
			Иначе
				// у полей выбора только произвольный тип значения. Требуется обязательно прописывать вручную доступные типы
				// с помощью параметра МенюПоТипам (или брать возможные типы из списка значений)
				ЕстьТипФизическиеЛица = Истина;
			КонецЕсли;
		Иначе
			ЕстьТипФизическиеЛица = Параметры.МенюПоТипам.ФизическиеЛица;
		КонецЕсли;
		Если Параметры.МенюПоТипам.Свойство("Пользователи") и Параметры.МенюПоТипам.Пользователи = Неопределено Тогда
			Если ТипЗнчВладелецПолеВвода Тогда
				Тип = Тип("СправочникСсылка.Пользователи");
				ЕстьТипПользователи = ТипЗначения.СодержитТип(Тип) И (Не ЕстьОграничениеТипа Или ОграничениеТипа.СодержитТип(Тип));
			Иначе
				ЕстьТипПользователи = Истина;
			КонецЕсли;
		Иначе
			ЕстьТипПользователи = Параметры.МенюПоТипам.Пользователи;
		КонецЕсли;
		Если Параметры.МенюПоТипам.Свойство("ПодразделенияОрганизаций") и Параметры.МенюПоТипам.ПодразделенияОрганизаций = Неопределено Тогда
			Если ТипЗнчВладелецПолеВвода Тогда
				Тип = Тип("СправочникСсылка.ПодразделенияОрганизаций");
				ЕстьТипПодразделения = ТипЗначения.СодержитТип(Тип) И (Не ЕстьОграничениеТипа Или ОграничениеТипа.СодержитТип(Тип));
			Иначе
				ЕстьТипПодразделения = Истина;
			КонецЕсли;
		Иначе
			ЕстьТипПодразделения = Параметры.МенюПоТипам.ПодразделенияОрганизаций
		КонецЕсли;
		Если Параметры.МенюПоТипам.Свойство("Контрагенты") и  Параметры.МенюПоТипам.Контрагенты = Неопределено Тогда
			Если ТипЗнчВладелецПолеВвода Тогда
				Тип = Тип("СправочникСсылка.Контрагенты");
				ЕстьТипКонтрагенты = (ТипЗначения.СодержитТип(Тип("Строка")) и Прав(Владелец.Имя,2)="СК") или (ТипЗначения.СодержитТип(Тип) И (Не ЕстьОграничениеТипа Или ОграничениеТипа.СодержитТип(Тип)));
			Иначе
				ЕстьТипКонтрагенты = Истина;
			КонецЕсли;
		Иначе
			ЕстьТипКонтрагенты = Параметры.МенюПоТипам.Контрагенты;
		КонецЕсли;
		Если ЕстьТипФизическиеЛица Тогда
			Если ОтображениеМеню.ФизическиеЛица Тогда
				ЭлементПоУмолчанию = Меню.Добавить("ФизическиеЛица", "Физическое Лицо",, БиблиотекаКартинок.ЗначокФизическоеЛицо16);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьТипПользователи Тогда
			Если ОтображениеМеню.Пользователи Тогда
				СтрокаСЗ = Меню.Добавить("Пользователи", "Пользователь",, БиблиотекаКартинок.Пользователь);
				Если ЭлементПоУмолчанию = Неопределено Тогда
					ЭлементПоУмолчанию = СтрокаСЗ;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьТипФизическиеЛица Тогда
			Если ОтображениеМеню.МолПоБСО Тогда
				Меню.Добавить("МОЛпоБСО", "Ответственный ОУ БСО",, БиблиотекаКартинок.уб_ОтветственныйБСО);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьТипПодразделения Тогда
			Если ОтображениеМеню.ОУБСО Тогда
				Меню.Добавить("ОУБСО", "ОУ БСО",, БиблиотекаКартинок.уб_Подразделения);
			КонецЕсли;	
		КонецЕсли;
		Если ЕстьТипКонтрагенты Тогда
			Если ОтображениеМеню.Контрагенты Тогда
				СтрокаСЗ = Меню.Добавить("Контрагенты", "Юридическое Лицо",, БиблиотекаКартинок.ЗначокКонтрагент16);
				Если ЭлементПоУмолчанию = Неопределено Тогда
					ЭлементПоУмолчанию = СтрокаСЗ;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьТипПодразделения Тогда
			Если ОтображениеМеню.ПодразделенияОрганизаций Тогда
				СтрокаСЗ = Меню.Добавить("ПодразделенияОрганизаций", "Подразделение",, БиблиотекаКартинок.уб_Подразделения);
				Если ЭлементПоУмолчанию = Неопределено Тогда
					ЭлементПоУмолчанию = СтрокаСЗ;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьТипФизическиеЛица Тогда
			Если ОтображениеМеню.СотрудникиБСО Тогда
				Меню.Добавить("СотрудникиБСО", "Сотрудники отдела БСО");
			КонецЕсли;
			Если ОтображениеМеню.Менеджеры Тогда
				Меню.Добавить("Менеджеры", "Менеджеры");
			КонецЕсли;
			Если ОтображениеМеню.Курьеры Тогда
				Меню.Добавить("Курьеры", "Курьеры");
			КонецЕсли;	
		КонецЕсли;
		МенюКоличество = Меню.Количество();
		Если МенюКоличество = 0 Тогда
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.НачалоВыбора(): в меню выбора нет ни одного элемента. Имя поля: " + Владелец.Имя, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
			СтандартнаяОбработка = Истина;
			Возврат;
		Иначе
			Если МенюКоличество = 1 Тогда
				ВыбранныйЭлемент = Меню[0];
			Иначе
				ВыбранныйЭлемент = Меню.ВыбратьЭлемент("Выберите тип", ЭлементПоУмолчанию);
				Если ВыбранныйЭлемент = Неопределено Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
			ВыбранныйЭлементЗначение = ВыбранныйЭлемент.Значение;
			// получение заголовка формы по значению меню
			Если Параметры.ЗаголовкиФорм <> Неопределено Тогда
				Если Параметры.ЗаголовкиФорм.Свойство(ВыбранныйЭлементЗначение) Тогда
					Заголовок = Параметры.ЗаголовкиФорм[ВыбранныйЭлементЗначение];
				ИначеЕсли Параметры.ЗаголовкиФорм.Свойство("ПоУмолчанию") Тогда
					Заголовок = Параметры.ЗаголовкиФорм.ПоУмолчанию
				КонецЕсли;
			КонецЕсли;
			Если ВыбранныйЭлементЗначение = "ФизическиеЛица" Тогда
				ИерархическийПросмотр   = Параметры.ИерархическийПросмотр[ВыбранныйЭлементЗначение];
				ИмяОбъекта				= ВыбранныйЭлементЗначение;
			ИначеЕсли ВыбранныйЭлемент.Значение = "Контрагенты" Тогда 		
				ИерархическийПросмотр	= Параметры.ИерархическийПросмотр[ВыбранныйЭлементЗначение];
				ИмяОбъекта				= ВыбранныйЭлементЗначение;
			ИначеЕсли ВыбранныйЭлемент.Значение = "ПодразделенияОрганизаций" Тогда 		
				ИмяОбъекта 	= ВыбранныйЭлементЗначение;
				Фильтровать = Истина;
			ИначеЕсли ВыбранныйЭлемент.Значение = "Пользователи" Тогда
				ИерархическийПросмотр	= Параметры.ИерархическийПросмотр[ВыбранныйЭлементЗначение];
				ИмяОбъекта				= ВыбранныйЭлементЗначение;
			ИначеЕсли ВыбранныйЭлемент.Значение = "МОЛпоБСО" Тогда 
				ИмяОбъекта = "ФизическиеЛица";
				РезультатФормыВыбора = уб_КЭШируемые.ПолучитьМОЛпоБСО(ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО);
			ИначеЕсли ВыбранныйЭлемент.Значение = "ОУБСО" Тогда 
				ИмяОбъекта = "ПодразделенияОрганизаций";
				РезультатФормыВыбора = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;		
				Если ТипЗнч(РезультатФормыВыбора) <> Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Некорректный тип у предопределенного элемента справочника констант уб_ОсновноеПодразделениеПоУчетуБСО", ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
					СтандартнаяОбработка = Истина;
					Возврат;
				КонецЕсли;
			ИначеЕсли ВыбранныйЭлемент.Значение = "СотрудникиБСО" Тогда
				ИмяОбъекта = "ФизическиеЛица";
				ИерархическийПросмотр	= Параметры.ИерархическийПросмотр[ИмяОбъекта];
				Группа = Справочники.ФизическиеЛица.ОУБСО;
			ИначеЕсли ВыбранныйЭлемент.Значение = "Курьеры" Тогда
				ИмяОбъекта = "ФизическиеЛица";
				ИерархическийПросмотр = Параметры.ИерархическийПросмотр[ИмяОбъекта];
				Группа = Справочники.ФизическиеЛица.Курьеры;
			ИначеЕсли ВыбранныйЭлемент.Значение = "Менеджеры" Тогда
				ИмяОбъекта = "ФизическиеЛица";
				ИерархическийПросмотр = Параметры.ИерархическийПросмотр[ИмяОбъекта];
				Группа = Справочники.ФизическиеЛица.Агенты;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Значение = Неопределено Тогда
		// нет меню, составной тип, не ясно что выбирать
		СтандартнаяОбработка = Истина;
		Возврат;
	Иначе
		ОткрыватьБезМеню = Истина;
	КонецЕсли;
	Если ОткрыватьБезМеню Тогда
		// открываем конкретный справочник
		ИмяОбъекта = ИмяОбъектаПоСсылке(Значение);
		Если ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
			Попытка
			Если Параметры.ЗаголовкиФорм.Свойство(ИмяОбъекта) И Не ПустаяСтрока(Параметры.ЗаголовкиФорм[ИмяОбъекта]) Тогда
				Заголовок = Параметры.ЗаголовкиФорм[ИмяОбъекта];
			ИначеЕсли Не ПустаяСтрока(Параметры.ЗаголовкиФорм.ПоУмолчанию) Тогда
				Заголовок = Параметры.ЗаголовкиФорм.ПоУмолчанию
			КонецЕсли;
		Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если ИмяОбъекта = "" Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.НачалоВыбора(): не получено имя объекта, имя поля: " + Владелец.Имя, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
		СтандартнаяОбработка = Истина;
		Возврат;
	Иначе
		Менеджер = Справочники[ИмяОбъекта];
	КонецЕсли;
	// принудительные безусловные параметры
	Если Не ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
		Заголовок = Параметры.ЗаголовокФормы;
	КонецЕсли;
	Если Параметры.Группа <> Неопределено Тогда
		Группа = Параметры.Группа
	КонецЕсли;
	Если Параметры.Фильтровать <> Неопределено Тогда
		Фильтровать = Параметры.Фильтровать
	КонецЕсли;
	Если Параметры.ИмяФормыВыбора <> Неопределено Тогда
		ИмяФормы = Параметры.ИмяФормыВыбора;
	Иначе
		// при Неопределено открывается стандартная форма выбора
		ИмяФормы = Параметры.ИменаФормВыбора[ИмяОбъекта];
	КонецЕсли;
	//
	Если Параметры.ПараметрВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы Тогда
		Форма = Менеджер.ПолучитьФормуВыбораГруппы(ИмяФормы, Владелец);
	Иначе
		Форма = Менеджер.ПолучитьФормуВыбора(ИмяФормы, Владелец);
		Если ТипЗнч(Владелец) = ТИп("ПолеВвода") и ЗначениеЗаполнено(Владелец.Значение) Тогда
			Попытка
				Форма.ТекущийЭлементСписка =  Владелец.Значение;
				Форма.Элементы.Список.ТекущаяСтрока = Владелец.Значение;
			Исключение	
			КонецПопытки;	
		КонецЕсли;	
	КонецЕсли;
	Если Форма = Неопределено Тогда
		// возможно, недостаточно прав
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.НачалоВыбора(): ошибка инициализации формы выбора объекта " + ИмяОбъекта + ". ТекущийПользователь: " + ПараметрыСеанса.ТекущийПользователь + ?(ИмяФормы = Неопределено, "", ", Имя формы: " + ИмяФормы), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
		СтандартнаяОбработка = Истина;
		Возврат;
	КонецЕсли;
	Если РезультатФормыВыбора = Неопределено Тогда
		Если ТипДругоеПоле или ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
			//ОтборПоКонтрагенту = Новый Структура("Родитель,ПометкаУдаления", Параметры.Группа,ЛОЖЬ);
			//ПараметрыФормы = Новый Структура("Отбор", ОтборПоКонтрагенту);
			//ПараметрыФормы.Вставить("Отбор",ОтборПоКонтрагенту);
			Список = Форма.Список;
			Если ЗначениеЗаполнено(Параметры.Группа) Тогда
				Форма.Элементы.Список.ТекущийРодитель = Параметры.Группа;
				//Форма.Элементы.Список.
				Форма.Элементы.Список.Отображение = ОтображениеТаблицы.Список;
				уб_сс.УстановитьЭлементОтбораДинамическогоСписка(Список, "Родитель", Параметры.Группа, ВидСравненияКомпоновкиДанных.ВИерархии,,Истина);
			КонецЕсли;	
			уб_сс.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПометкаУдаления", ЛОЖЬ, ВидСравненияКомпоновкиДанных.Равно,,Истина);
			уб_сс.УстановитьЭлементОтбораДинамическогоСписка(Список, "ЭтоГруппа", ЛОЖЬ, ВидСравненияКомпоновкиДанных.Равно,,Истина);
		Иначе	
			// подгатавливаем форму выбора к открытию
			эфСправочникСписок = Форма.ЭлементыФормы.Найти("СправочникСписок");
			Если эфСправочникСписок = Неопределено Тогда
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не найден элемент формы справочник список у формы выбора объекта " + ИмяОбъекта, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
				СтандартнаяОбработка = Истина;
				Возврат; 
			КонецЕсли;
			Если ИерархическийПросмотр <> Неопределено Тогда
				эфСправочникСписок.ИерархическийПросмотр = ИерархическийПросмотр;
			КонецЕсли;
			Если Группа = Неопределено Тогда
				Группа = Параметры.ГруппыПоУмолчанию[ИмяОбъекта];
			КонецЕсли;
			Если Группа <> Неопределено Тогда			
				Если Фильтровать Тогда
					эфСправочникДерево = Форма.ЭлементыФормы.Найти("СправочникДерево");
					//Если эфСправочникДерево = Неопределено Тогда
					// отсутствие этого элемента формы не критично
					//ТекстОшибки = "Не найдены элементы формы: СправочникДерево " + ?(эфСправочникСписок = Неопределено, ", СправочникСписок ", "") + " у формы выбора объекта " + ИмяОбъекта;
					эфСправочникСписок.НастройкаОтбора.Ссылка.Доступность = Истина;
					ОтборСсылка = эфСправочникСписок.Значение.Отбор.Ссылка;
					ОтборСсылка.Использование 	= Истина;
					ОтборСсылка.ВидСравнения 	= ВидСравнения.ВИерархии;
					ОтборСсылка.Значение		= Группа;
					Если эфСправочникДерево <> Неопределено Тогда
						эфСправочникДерево.НастройкаОтбора.Ссылка.Доступность = Истина;
						ОтборСсылка = эфСправочникДерево.Значение.Отбор.Ссылка;
						ОтборСсылка.Использование 	= Истина;
						ОтборСсылка.ВидСравнения 	= ВидСравнения.ВИерархии;
						ОтборСсылка.Значение		= Группа;
					КонецЕсли;
				КонецЕсли;
				эфРодительВерхнегоУровня = Форма.ЭлементыФормы.Найти("РодительВерхнегоУровня");
				Если эфРодительВерхнегоУровня <> Неопределено Тогда
					эфРодительВерхнегоУровня.Значение = Группа;
				КонецЕсли;
				эфСправочникСписок.РодительВерхнегоУровня = Группа;
			КонецЕсли;
			//TODO если группа не совпадает с начальным значением выбора?
			Если НачальноеЗначениеВыбора <> Неопределено Тогда
				Форма.НачальноеЗначениеВыбора = НачальноеЗначениеВыбора;
			КонецЕсли;
		КонецЕсли;
		
		Если Форма.Открыта() Тогда
			Форма.Активизировать();
		Иначе
			Если Не ПустаяСтрока(Заголовок) Тогда
				Форма.Заголовок = Заголовок;
			КонецЕсли;
			Если ТипДругоеПоле Тогда
				СтандартнаяОбработка = Ложь;
				Форма.Открыть();
				//ОткрытьФорму(Форма.ИмяФормы,ПараметрыФормы,Владелец,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе	
				Попытка
					Форма.ПараметрВыборГруппИЭлементов = Параметры.ПараметрВыборГруппИЭлементов;
					
					Если Параметры.Свойство("СтрокаПоиска") Тогда
						Форма.ЭлементыФормы.эуПоискНаименование.Value = Параметры.СтрокаПоиска;
					КонецЕсли;	
				Исключение
				КонецПопытки;
				Попытка
					Форма.Открыть()
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка открытия формы выбора объекта " + ИмяОбъекта, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
					СтандартнаяОбработка = Истина;
					Возврат;
				КонецПопытки
			КонецЕсли;	
				
			
		КонецЕсли;
	Иначе
		// результат есть, оповещаем о выборе
		Форма.ОповеститьОВыборе(РезультатФормыВыбора);
	КонецЕсли;

КонецПроцедуры

Процедура ВыборАгента(
	Владелец, 
	СтандартнаяОбработка 	= Неопределено,
	Знач НастройкиМеню		= "",
	Параметры				= Неопределено
	) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыНачалаВыбора();
	КонецЕсли;
	// заголовки форм
	Если ПустаяСтрока(Параметры.ЗаголовкиФорм.ПоУмолчанию) Тогда
		Параметры.ЗаголовкиФорм.ПоУмолчанию = "Форма выбора Агента";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовкиФорм.ФизическиеЛица) Тогда
		Параметры.ЗаголовкиФорм.ФизическиеЛица = "Форма выбора Агента - физического лица";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовкиФорм.Контрагенты) Тогда
		Параметры.ЗаголовкиФорм.Контрагенты = "Форма выбора Контрагента (в качестве Агента)";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовкиФорм.ПодразделенияОрганизаций) Тогда
		Параметры.ЗаголовкиФорм.ПодразделенияОрганизаций = "Форма выбора Подразделения (в качестве Агента)";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ИменаФормВыбора.ПодразделенияОрганизаций) Тогда
		// используется нестандартная форма выбора
		// TODO привести к одной форме
		Параметры.ИменаФормВыбора.ПодразделенияОрганизаций = "ФормаВыбораДляБСО";
	КонецЕсли;
	Если Параметры.ГруппыПоУмолчанию.ФизическиеЛица = Неопределено Тогда
		Группа = ПараметрыСеанса.уб_Константы.уб_ГруппаСотрудников;
		Если ТипЗнч(Группа) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Параметры.ГруппыПоУмолчанию.ФизическиеЛица = Группа;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.ГруппыПоУмолчанию.Контрагенты = Неопределено Тогда
		Группа = ПараметрыСеанса.уб_Константы.уб_ГруппаАгентовЮрЛиц;
		Если ТипЗнч(Группа) = Тип("СправочникСсылка.Контрагенты") Тогда
			Параметры.ГруппыПоУмолчанию.Контрагенты = Группа;
		КонецЕсли;
	КонецЕсли;
	НачалоВыбора(Владелец, СтандартнаяОбработка, НастройкиМеню, Параметры);

КонецПроцедуры

