Процедура НачалоВыбораИзСправочника(
	ФормаВладелец, 
	Элемент, 
	Группа = Неопределено, 
	Фильтровать = Ложь,
	ЗаголовокФормы = Неопределено,
	Справ,
	ИерархическийПросмотр = Истина,
	ВыборГрупп = Ложь
	) Экспорт
	
	Форм = Справ.ПолучитьФормуВыбора(,ФормаВладелец);
	//в форме выбора физлиц есть оповещение о выборе, однако в коде уб_СС оно тоже есть. Во избежание повторных вызовов
	//в реквизит формы выборы нужен параметр НеОповещатьОВыборе = Истина
	//однако реквизит не помогает - в любом случае форма выбора отправляет событие обработка выбора
	//1) автоматически стандартной обработкой СправочникВыбор
	//2) в этой процедуре
	//оставляем только 1ый вариант
	ОповещатьОВыборе = Истина;
	Если Справ = Справочники.ФизическиеЛица Тогда
		ОповещатьОВыборе = Ложь;
	КонецЕсли;
	Если ЗаголовокФормы <> Неопределено Тогда
		Форм.Заголовок = ЗаголовокФормы;
	КонецЕсли;
	Если Элемент.Значение <> Справ.ПустаяСсылка() И Элемент.Значение <> Неопределено Тогда
		Форм.НачальноеЗначениеВыбора = Элемент.Значение;
	КонецЕсли;
	эСД = Форм.ЭлементыФормы.СправочникДерево;
	эСС = Форм.ЭлементыФормы.СправочникСписок;
	эСС.ИерархическийПросмотр = ИерархическийПросмотр;
	//Если Не ЗначениеЗаполнено(эСД.ТекущаяСтрока) И ЗначениеЗаполнено(Группа) Тогда
	//	эСД.ТекущаяСтрока = Группа;
	//КонецЕсли;	
	Если Фильтровать Тогда
		эСД.НастройкаОтбора.Ссылка.Доступность = Истина;
		СОС = Форм.СправочникДерево.Отбор.Ссылка;
		СОС.Использование = Истина;
		СОС.ВидСравнения = ВидСравнения.Равно;
		СОС.Значение = Группа;
		эСС.РодительВерхнегоУровня = Группа;
	КонецЕсли;
	
	ЭлементРодителяВерхнегоУровня = Форм.ЭлементыФормы.Найти("РодительВерхнегоУровня");
	Если ЭлементРодителяВерхнегоУровня <> Неопределено Тогда
		ЭлементРодителяВерхнегоУровня.Значение = Группа;
	КонецЕсли;
	
	Если Не Форм.Открыта() Тогда
		Попытка
			ТекСтрока = Неопределено;
			ТекСтрока = Форм.ОткрытьМодально();
			//Форм.Открыть();
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_СС.НачалоВыбораИзСправочника(): ошибка ТекСтрока = Форм.ОткрытьМодально(). ТипЗнч(Форма) = " + ТипЗнч(Форм) + ", Справочник: " + Справ + "Описание ошибки: " + ОписаниеОшибки(), "НеСообщать", Истина);
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка открытия формы справочника " + Справ);
		КонецПопытки;
		//После закрытия...
		Если ТекСтрока <> Неопределено И (ВыборГрупп = Истина Или (ВыборГрупп = Ложь И Не ТекСтрока.ЭтоГруппа)) Тогда
			Если ОповещатьОВыборе Тогда
				Форм.ОповеститьОВыборе(ТекСтрока)
			КонецЕсли;
			Элемент.Значение = ТекСтрока.Ссылка;
		КонецЕсли;
	Иначе
		//TODO непонятно, какого типа форма открыта - модальная или нет, и с какими данными и каким владельцем. Нужно отладить
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Форма выбора уже открыта! Закройте текущую форму");
		Форм.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктураОтображенияВыбораИзСпискаНачалоВыбораПоУмолчанию()

	Структура = Новый Структура;
	Структура.Вставить("МОЛпоБСО", 						Ложь);
	Структура.Вставить("Подразделения", 				Истина);
	Структура.Вставить("ОсновноеПодразделениеУчетаБСО", Ложь);
	Структура.Вставить("СотрудникиБСО", 				Ложь);
	Структура.Вставить("Менеджеры", 					Ложь);
	Структура.Вставить("Курьеры", 						Ложь);
	Структура.Вставить("Контрагенты",					Ложь);
	Возврат Структура;

КонецФункции // СтруктураОтображенияВыбораИзСпискаНачалоВыбора()

//Структура - структура настроек для различных форм выбора
#Если Клиент Тогда
Процедура НачалоВыбораАгента(
	ФормаВладелец, 
	Элемент, 
	ОтоброжатьМОЛпоБСО 						= Ложь, 
	ОтображатьПодразделения 				= Истина, 
	ОтображатьОсновноеПодразделениеУчетаБСО = Ложь, 
	Структура 								= Неопределено,
	ОтображатьСотрудниковБСО 				= Ложь,
	ОтображатьМенеджеров 					= Ложь,
	ОтображатьКурьеров 						= Ложь
	) Экспорт
		
	ОтображатьКонтрагентов = Истина;
	//обрабатываем настройки открытия различных форм выбора из структуры
	Если Структура <> Неопределено Тогда
		ИерархическийПросмотрФизЛиц = ?(Структура.Свойство("ФизЛицо"), 	Структура.ФизЛицо.ИерархическийПросмотр, Истина);
		ИерархическийПросмотрЮрЛиц	= ?(Структура.Свойство("ЮрЛицо"),	Структура.ЮрЛицо.ИерархическийПросмотр, Истина);
	Иначе
		ИерархическийПросмотрФизЛиц = Истина;
		ИерархическийПросмотрЮрЛиц	= Истина;
	КонецЕсли;
	Если ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда		
		Если ОтоброжатьМОЛпоБСО И Элемент.Значение = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			ОтображатьКонтрагентов = Ложь;	
			ОтображатьПодразделения = Ложь;	
		Иначе	
			НачалоВыбораАгентаФизЛица(ФормаВладелец, Элемент, ИерархическийПросмотрФизЛиц);
			Возврат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда 		
		НачалоВыбораАгентаЮрЛица(ФормаВладелец, Элемент, ИерархическийПросмотрЮрЛиц);
		Возврат;
	ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда 		
		//НачалоВыбораАгентаПодразделения(ФормаВладелец, Элемент);
		Группа = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
		НачалоВыбораПоразделения(ФормаВладелец, Элемент, Группа, Истина, "Выбор Подразделения (в качестве Агента)");
		Возврат;
	КонецЕсли;		
	СписокСправочников = Новый СписокЗначений;
	ЭлементПоУмолчанию = СписокСправочников.Добавить(Справочники.ФизическиеЛица,"Физическое Лицо",,БиблиотекаКартинок.ЗначокФизическоеЛицо16);
	Если ОтоброжатьМОЛпоБСО Тогда
		СписокСправочников.Добавить("МОЛпоБСО","Ответственный ОУ БСО",,БиблиотекаКартинок.уб_ОтветственныйБСО);
	КонецЕсли;
	Если ОтображатьОсновноеПодразделениеУчетаБСО Тогда
		СписокСправочников.Добавить("ОУБСО","ОУ БСО",,БиблиотекаКартинок.уб_Подразделения);
	КонецЕсли;
	Если ОтображатьКонтрагентов Тогда
		СписокСправочников.Добавить(Справочники.Контрагенты,"Юридическое Лицо",,БиблиотекаКартинок.ЗначокКонтрагент16);
	КонецЕсли;
	Если ОтображатьПодразделения Тогда
		СписокСправочников.Добавить(Справочники.ПодразделенияОрганизаций,"Подразделение",,БиблиотекаКартинок.уб_Подразделения);
	КонецЕсли;
	Если ОтображатьСотрудниковБСО Тогда
		СписокСправочников.Добавить("СотрудникиБСО", "Сотрудники отдела БСО");
	КонецЕсли;
	Если ОтображатьМенеджеров Тогда
		СписокСправочников.Добавить("Менеджеры", "Менеджеры");
	КонецЕсли;
	Если ОтображатьКурьеров Тогда
		СписокСправочников.Добавить("Курьеры", 	 "Выездные специалисты");
	КонецЕсли;
	ВыбранныйЭлемент = СписокСправочников.ВыбратьЭлемент("Выберите тип Агента",ЭлементПоУмолчанию);
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйЭлемент.Значение = Справочники.ФизическиеЛица Тогда		
		НачалоВыбораАгентаФизЛица(ФормаВладелец, Элемент, ИерархическийПросмотрФизЛиц);		
	ИначеЕсли ВыбранныйЭлемент.Значение = Справочники.Контрагенты Тогда 		
		НачалоВыбораАгентаЮрЛица(ФормаВладелец, Элемент, ИерархическийПросмотрЮрЛиц);		
	ИначеЕсли ВыбранныйЭлемент.Значение = Справочники.ПодразделенияОрганизаций Тогда 		
		//НачалоВыбораАгентаПодразделения(ФормаВладелец, Элемент);
		Группа = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
		НачалоВыбораПоразделения(ФормаВладелец, Элемент, Группа, Истина, "Выбор Подразделения (в качестве Агента)");
	ИначеЕсли ВыбранныйЭлемент.Значение = "МОЛпоБСО" Тогда 
		МОЛпоБСО = уб_КЭШируемые.ПолучитьМОЛпоБСО(ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО);
		Элемент.Значение = МОЛпоБСО;		
	ИначеЕсли ВыбранныйЭлемент.Значение = "ОУБСО" Тогда 
		Элемент.Значение = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;		
	ИначеЕсли ВыбранныйЭлемент.Значение = "СотрудникиБСО" Тогда
		//РодительВерхнегоУровня = Справочники.ФизическиеЛица.НайтиПоНаименованию("ОУ БСО");
		РодительВерхнегоУровня = Справочники.ФизическиеЛица.ОУБСО;
	ИначеЕсли ВыбранныйЭлемент.Значение = "Курьеры" Тогда
		РодительВерхнегоУровня = Справочники.ФизическиеЛица.Курьеры
	ИначеЕсли ВыбранныйЭлемент.Значение = "Менеджеры" Тогда
		РодительВерхнегоУровня = Справочники.ФизическиеЛица.Агенты
	КонецЕсли;
	Если РодительВерхнегоУровня <> Неопределено Тогда
		Форма = Справочники.ФизическиеЛица.ПолучитьФормуВыбора(,Элемент);
		Форма.ЭлементыФормы.СправочникСписок.РодительВерхнегоУровня = РодительВерхнегоУровня;
		ЭлементРодительВерхнегоУровня = Форма.ЭлементыФормы.Найти("РодительВерхнегоУровня");
		Если ЭлементРодительВерхнегоУровня <> Неопределено Тогда
			ЭлементРодительВерхнегоУровня.Значение = РодительВерхнегоУровня;
		КонецЕсли;
		Форма.Открыть();
	КонецЕсли;		
	
КонецПроцедуры
#КонецЕсли	

