		КонецЕсли;
	КонецЕсли;
	Если Параметры.ГруппыПоУмолчанию.Контрагенты = Неопределено Тогда
		Группа = Справочники.Контрагенты.ПустаяСсылка();//ПараметрыСеанса.уб_Константы.уб_ГруппаСтрахователейЮрЛиц;
		//Если ТипЗнч(Группа) = Тип("СправочникСсылка.Контрагенты") Тогда
		//	Параметры.ГруппыПоУмолчанию.Контрагенты	= Группа;
		//КонецЕсли;
	КонецЕсли;
	НачалоВыбора(Владелец, СтандартнаяОбработка, НастройкиМеню, Параметры);

КонецПроцедуры

Процедура ВыборКурьера(
	Владелец, 
	СтандартнаяОбработка	= Неопределено,
	Знач НастройкиМеню		= "",
	Параметры				= Неопределено
	) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыНачалаВыбора();
		Параметры.ОтображениеМеню.Контрагенты              = Ложь;
		Параметры.ОтображениеМеню.ПодразделенияОрганизаций = Ложь;
		Параметры.ОтображениеМеню.Пользователи             = Ложь;
		Параметры.ИмяФормыВыбора =  "ФормаВыбораУправляемая";
		Параметры.Группа = Справочники.ФизическиеЛица.Курьеры;
		Параметры.ИерархическийПросмотр.ФизическиеЛица = ЛожЬ;
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
		Параметры.ЗаголовокФормы = "Форма выбора курьера";
	КонецЕсли;
	Если Параметры.Группа = Неопределено Тогда
		Группа = ПараметрыСеанса.уб_Константы.уб_ГруппаСотрудниковКурьеров;
		Если ТипЗнч(Группа) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Параметры.Группа = Справочники.ФизическиеЛица.Курьеры;
		КонецЕсли;
	КонецЕсли;
	НачалоВыбора(Владелец, СтандартнаяОбработка, НастройкиМеню, Параметры);

КонецПроцедуры

Процедура ВыборСотрудника(
	Владелец,
	СтандартнаяОбработка	= Неопределено,
	Знач НастройкиМеню		= "",
	Параметры				= Неопределено
	) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыНачалаВыбора();
		Параметры.ОтображениеМеню.Контрагенты              = Ложь;
		Параметры.ОтображениеМеню.ПодразделенияОрганизаций = Ложь;
		Параметры.ОтображениеМеню.Пользователи             = Ложь;
		Параметры.ИмяФормыВыбора =  "ФормаВыбораУправляемая";
		Параметры.Группа = Справочники.ФизическиеЛица.Сотрудники;
		Параметры.ИерархическийПросмотр.ФизическиеЛица = ЛожЬ;
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
		Параметры.ЗаголовокФормы = "Форма выбора сотрудника";
	КонецЕсли;
	
	Если Параметры.ГруппыПоУмолчанию.ФизическиеЛица = Неопределено Тогда
		Группа = ПараметрыСеанса.уб_Константы.уб_ГруппаСотрудников;
		Если ТипЗнч(Группа) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Параметры.ГруппыПоУмолчанию.ФизическиеЛица = Группа;
		КонецЕсли;
	КонецЕсли;
	
	НачалоВыбора(Владелец, СтандартнаяОбработка, НастройкиМеню, Параметры);
	
КонецПроцедуры

Процедура ВыборПоставщика(
	Владелец,
	СтандартнаяОбработка	= Неопределено,
	Знач НастройкиМеню		= "",
	Параметры				= Неопределено
	) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыНачалаВыбора();
	КонецЕсли;
	Если Параметры.Группа = Неопределено Тогда
		Группа = ПараметрыСеанса.уб_Константы.уб_ГруппаСК;
		Если ТипЗнч(Группа) = Тип("СправочникСсылка.Контрагенты") Тогда
			Параметры.Группа = Группа;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Параметры.ЗаголовокФормы) Тогда
		Параметры.ЗаголовокФормы = "Форма выбора поставщика"; // для выбора ск и поставщика открывается одна группа СК
	КонецЕсли;
	НачалоВыбора(Владелец, СтандартнаяОбработка, НастройкиМеню, Параметры);

КонецПроцедуры

Функция ПараметрыНачалаВыбора() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ТипВыбора", "");
	// принудительный заголовок формы, безусловно
	Параметры.Вставить("ЗаголовокФормы", "");
	// принудительная группа формы, безусловно
	Параметры.Вставить("Группа");
	// расчетный показатель, будет ли использоваться (не параметр!)
	Параметры.Вставить("ВыборИзМеню",  Ложь);
	// структура, определяющая типы поля для частног8о формирования подменю
	// к примеру, поле типа строка, и частная обработка выбора, требуется включить подменю физических лиц
	// если Неопределено каждое из значений, то рассчитывается автоматически (по умолчанию)
	Структура = Новый Структура;
	Структура.Вставить("ФизическиеЛица");
	Структура.Вставить("Контрагенты");
	Структура.Вставить("ПодразделенияОрганизаций");
	Структура.Вставить("Пользователи");
	Параметры.Вставить("МенюПоТипам", Структура);
	// принудительный выбор типа, даже если значение заполнено
	Параметры.Вставить("ВыборТипа", Ложь);
	// принудительное имя формы выбора. Составного типа: строка и ОбъектМетаданных.Форма
	Параметры.Вставить("ИмяФормыВыбора");
	// будет ли установлен отбор в иерархии либо нет. Если булево, то принудительно устанавливается, иначе расчетный показатель
	Параметры.Вставить("Фильтровать");
	// структура формирования меню. Истина только для самих справочников (можно отключать), также и добавлять настроенные ниже
	// можно заполнять при помощи данной структуры параметров, так и строкой вызова любой функции начала выбора,
	// например "МолПоБСО, не Контрагенты"
	Структура = Новый Структура;
	Структура.Вставить("Контрагенты",				Истина);
	Структура.Вставить("ФизическиеЛица",			Истина);
	Структура.Вставить("ПодразделенияОрганизаций", 	Истина);
	Структура.Вставить("Пользователи",				Истина);
	Структура.Вставить("МОЛпоБСО", 					Ложь);
	Структура.Вставить("ОУБСО",						Ложь);
	Структура.Вставить("СотрудникиБСО", 			Ложь);
	Структура.Вставить("Менеджеры",					Ложь);
	Структура.Вставить("Курьеры", 					Ложь);	
	Параметры.Вставить("ОтображениеМеню", 			Структура);
	// выбор групп и элементов. По умолчанию - только элементы
	Параметры.Вставить("ПараметрВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	// проверять ограничение типа элемента либо нет
	Параметры.Вставить("ЗадействоватьОграничениеТипа", Истина);
	// настройка иерархического просмотра в разрезе различных справочников
	Структура = Новый Структура;
	Структура.Вставить("ФизическиеЛица", 		Истина);
	Структура.Вставить("Контрагенты",			Истина);
	Структура.Вставить("Пользователи",			Истина);
	Параметры.Вставить("ИерархическийПросмотр", Структура);
	// Группы верхнего уровня по умолчанию
	Структура = Новый Структура;
	Структура.Вставить("ФизическиеЛица");
	Структура.Вставить("Контрагенты");
	Структура.Вставить("ПодразделенияОрганизаций");
	Структура.Вставить("Пользователи");
	Параметры.Вставить("ГруппыПоУмолчанию", Структура);
	// Заголовки форм выбора. "" для расчета, или для не использования.
	Структура = Новый Структура;
	Структура.Вставить("ПоУмолчанию", 				""); // используется если не найден конкретный заголовок для типа справочника
	Структура.Вставить("ФизическиеЛица",    		"");
	Структура.Вставить("ПодразделенияОрганизаций",  "");
	Структура.Вставить("Контрагенты",				"");
	Структура.Вставить("Пользователи",				"");
	Параметры.Вставить("ЗаголовкиФорм", Структура);
	// имена форм. Если заполнены, тогда устанавливаются формы выбора не по умолчанию
	Структура = Новый Структура;
	Структура.Вставить("ФизическиеЛица");
	Структура.Вставить("ПодразделенияОрганизаций");
	Структура.Вставить("Контрагенты");
	Структура.Вставить("Пользователи");
	Структура.Вставить("СтрокаПоиска","");
	Параметры.Вставить("ИменаФормВыбора", Структура);
	Возврат Параметры;

КонецФункции // ПараметрыПоТипуНачалаВыбора()

