Функция ФИОФизлицаСтрокой(Знач ФизЛицо, НаДату = Неопределено, ФИОКратко = Истина, Падеж = Неопределено, ВыводитьОшибки = Истина) Экспорт
	
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат "";
	Иначе
		ТипЗнчФизЛицо = ТипЗнч(ФизЛицо);
		ЗапросФИОСрез = Новый Запрос;
		Если ТипЗнчФизлицо = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ЗапросФИОСрез.Текст = 
			"ВЫБРАТЬ
			|	ФизическиеЛица.Ссылка,
			|	ФизическиеЛица.Пол,
			|	ФизическиеЛица.Наименование,
			|	ФизическиеЛица.Код
			|ПОМЕСТИТЬ ВТ_ФизЛицо
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизическиеЛица
			|ГДЕ
			|	ФизическиеЛица.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ФизическиеЛица.Ссылка,
			|	ФизическиеЛица.Пол,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Фамилия, """") КАК Фамилия,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Имя, """") КАК Имя,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Отчество, """") КАК Отчество,
			|	ФизическиеЛица.Наименование,
			|	ФизическиеЛица.Код
			|ИЗ
			|	ВТ_ФизЛицо КАК ФизическиеЛица
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних(&НаДату, ФизЛицо = &Ссылка) КАК ФИОФизЛицСрезПоследних
			|		ПО ФизическиеЛица.Ссылка = ФИОФизЛицСрезПоследних.ФизЛицо";
		ИначеЕсли ТипЗнчФизЛицо = Тип("СправочникСсылка.Пользователи") Тогда
			ЗапросФИОСрез.Текст = 
			"ВЫБРАТЬ
			|	Пользователи.Наименование КАК НаименованиеПользователя,
			|	Пользователи.ФизЛицо
			|ПОМЕСТИТЬ ВТ_Пользователь
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Пользователь.ФизЛицо КАК Ссылка,
			|	ЕСТЬNULL(ФизическиеЛица.Наименование, ВТ_Пользователь.НаименованиеПользователя) КАК Наименование,
			|	ФизическиеЛица.Пол КАК Пол,
			|	ФизическиеЛица.Код КАК Код,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Фамилия, """") КАК Фамилия,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Имя, """") КАК Имя,
			|	ЕСТЬNULL(ФИОФизЛицСрезПоследних.Отчество, """") КАК Отчество
			|ИЗ
			|	ВТ_Пользователь КАК ВТ_Пользователь
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
			|		ПО ВТ_Пользователь.ФизЛицо = ФизическиеЛица.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних(
			|				&НаДату,
			|				ФизЛицо В
			|					(ВЫБРАТЬ
			|						Т.ФизЛицо
			|					ИЗ
			|						ВТ_Пользователь КАК Т)) КАК ФИОФизЛицСрезПоследних
			|		ПО ВТ_Пользователь.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо";
		ИначеЕсли ТипЗнчФизЛицо = Тип("СправочникСсылка.КонтактныеЛица") Тогда
			ЗапросФИОСрез.Текст =
			"ВЫБРАТЬ
			|	КЛ.Ссылка,
			|	КЛ.Наименование,
			|	КЛ.Пол,
			|	КЛ.Код,
			|	КЛ.Фамилия,
			|	КЛ.Имя,
			|	КЛ.Отчество
			|ИЗ
			|	Справочник.КонтактныеЛица КАК КЛ
			|ГДЕ
			|	КЛ.Ссылка = &Ссылка";
		Иначе
			//передан неверный параметр. Done - откуда передается? Передавались Контактные лица
			Возврат Физлицо;
		КонецЕсли;
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	ЗапросФИОСрез.УстановитьПараметр("Ссылка", ФизЛицо);
	ЗапросФИОСрез.УстановитьПараметр("НаДату", НаДату);
	ФИОСрез = ЗапросФИОСрез.Выполнить().Выбрать();
	ФИОСрез.Следующий();
	//ФИОСрез 	= РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(НаДату ,Новый Структура("ФизЛицо", ФизЛицо));
	Фамилия		= ФИОСрез.Фамилия;
	Имя			= ФИОСрез.Имя;
	Отчество	= ФИОСрез.Отчество;
	Если ПустаяСтрока(Фамилия + Имя + Отчество) Тогда
		ФамилияИмяОтчество = СокрЛП(ФИОСрез.Наименование);
	Иначе
		ФамилияИмяОтчество = "";//TODO Почему? Тип параметра ФизЛицо передан неверный
	КонецЕсли;
	//Если ВыводитьОшибки И Не ЗначениеЗаполнено(ФИОСрез.Пол) Тогда
	//	Если ЗначениеЗаполнено(ФИОСрез.Код) Тогда
	//		ТекстСообщения = "Не указан пол физлица '" + ФИОСрез.Наименование + "' (Код = '" + ФИОСрез.Код + "'). Функция склонения может работать неправильно!";
	//	Иначе
	//		ТекстСообщения = "Не указано физлицо пользователя '" + ФИОСрез.Наименование + "'. Функция склонения может работать неправильно!";
	//	КонецЕсли;
	//	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ТекстСообщения,
	//	"Сообщить",
	//	Истина,
	//	УровеньЖурналаРегистрации.Информация,
	//	//ФизЛицо.Метаданные()
	//	,
	//	ФизЛицо);
	//КонецЕсли;
	Возврат ФункцииРасширения.ФИО_Склонение(ФамилияИмяОтчество, Фамилия, Имя, Отчество, ФИОСрез.Пол, Падеж, ФИОКратко);
	
КонецФункции

Функция ПредыдущаяЗаписьРегистраДвижений(
	Период,
	СК,
	ВидБСО,
	НомерБСО,
	ИнфоЗапись
	) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| 	*
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
	|			&Период,
	|			ВидБСО = &ВидБСО 
	|				И НомерБСО = &НомерБСО
	|				И 1 = 1) КАК ДБ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДБ.Период УБЫВ";
	Запрос.УстановитьПараметр("Период", 	Период);
	Запрос.УстановитьПараметр("ВидБСО", 	ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО",   НомерБСО);
	Если Не ИнфоЗапись Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "1 = 1", "Подтверждено ");
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос.Выполнить();
	
КонецФункции // ПредыдущаяЗаписьРегистраДвижений()

Процедура ДвижениеБСОПоРегистрам2(
	Объект, 
	Отказ,
	Заголовок 			= "",
	СтруктураКонтроля 	= Неопределено) Экспорт
	
	ОбъектМетаданные= Объект.Метаданные();
	ИмяОбъекта		= ОбъектМетаданные.Имя;
	ЭтоВозврат		= ИмяОбъекта = "уб_ВозвратБСОотПоставщика";
	ЭтоПередача 	= ИмяОбъекта = "уб_ПередачаБСОПоставщику";
	ЭтоПолиция		= ИмяОбъекта = "уб_ЗаявлениеВПолицию";
	ЭтоУтрата		= ИмяОбъекта = "уб_ЗаявлениеОбУтрате";
	ЭтоСМИ			= ИмяОбъекта = "уб_ОбъявлениеВСМИобУтратеБСО";
	ЭтоСписание		= ИмяОбъекта = "уб_СписаниеБСО";
	ЭтоУведомление	= ИмяОбъекта = "уб_УведомлениеПоставщикаОбУтратеБСО";
	БСО 			= Объект.БСО;
	Период 			= Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая);
	Проведен    	= Объект.Проведен;
	КоличествоПодтвержденных 	= 0;
	ЕстьДвиженияНомерных		= Ложь;
	ЕстьДвиженияКоличественных	= Ложь;
	//получаем структуру контроля для настройки необходимых проверок
	Если СтруктураКонтроля = Неопределено Тогда
		СтруктураКонтроля = СтруктураКонтроляДвиженийБСО();
		СтруктураКонтроля.НаличиеБСО 		= Истина;
		СтруктураКонтроля.Поставщик			= ЭтоВозврат Или ЭтоПередача;
		СтруктураКонтроля.ОрганизацияАгент	= ЭтоВозврат Или ЭтоПередача;
		СтруктураКонтроля.Агент				= Ложь;
		СтруктураКонтроля.ПоложениеБСО		= Не ЭтоПередача;
	КонецЕсли;
	//получаем есть или нет определенные колонки таблицы БСО и заполняем соответствие
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ОбъектМетаданные.ТабличныеЧасти.БСО.Реквизиты Цикл
		МассивКолонок.Добавить(Колонка.Имя)
	КонецЦикла;
	сооНаличияРеквизита = Новый Соответствие;
	сооНаличияРеквизита.Вставить("СК", 			МассивКолонок.Найти("СК")				<> Неопределено);
	сооНаличияРеквизита.Вставить("Поставщик", 	МассивКолонок.Найти("Поставщик")		<> Неопределено);
	сооНаличияРеквизита.Вставить("ОргАгент", 	МассивКолонок.Найти("ОрганизацияАгент")	<> Неопределено);
	сооНаличияРеквизита.Вставить("Подтверждено",МассивКолонок.Найти("Подтверждено")		<> Неопределено);
	сооНаличияРеквизита.Вставить("Агент",		МассивКолонок.Найти("Агент")			<> Неопределено);
	сооНаличияРеквизита.Вставить("НомерПолиса",	МассивКолонок.Найти("НомерПолиса")		<> Неопределено);
	сооНаличияРеквизита.Вставить("Комментарий",	МассивКолонок.Найти("Комментарий")		<> Неопределено);
	Пересортица = ?(ОбщегоНазначения.ЕстьРеквизит("Пересортица", Объект) И ТипЗнч(Объект.Пересортица) = Тип("Булево"), Объект.Пересортица, Ложь);
	ИспользуетсяКолУчет	= ЭтоПередача Или ЭтоСписание;
	//сообщения
	СООхвостПересортица = " Проведение разрешено, поскольку установлен флаг ""Пересортица""";
	//частные случаи объектов
	пПлж = Перечисления.уб_ПоложенияБСО;
	пСст = Перечисления.уб_СостоянияБСО;
	пКод = Перечисления.уб_КодыОперацийБСО;
	Период = Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая);
	//внецикловые значения реквизитов
	//
	Дата = Объект.Дата;
	//код операции и ПоложениеБСО
	Если ЭтоПередача Тогда
		КодОперации 	= пКод.ПередачаБСОПоставщику;
		ПоложениеБСО	= пПлж.ПереданВСК;
	ИначеЕсли ЭтоСписание Тогда
		КодОперации 	= пКод.СписаниеБСО;
		ТипПоУмолчанию	= Объект.ТипСписанияПоУмолчанию;
		ТипСписанияТЧ	= "ТипСписания";
	ИначеЕсли ЭтоВозврат Тогда
		КодОперации 	= пКод.ВозвратБСОотПоставщика;
		СостояниеБСО	= пСст.НеПравильноОформлен;
		ПоложениеБСО	= пПлж.ВозвращенИзСК;
	ИначеЕсли ЭтоУтрата Тогда
		КодОперации 	= пКод.ОбъявлениеВСМИОбУтратеБСО;
		ТипПоУмолчанию	= Объект.ТипУтратыПоУмолчанию;
		ТипСписанияТЧ	= "ТипУтраты";
	ИначеЕсли ЭтоПолиция Тогда
		КодОперации		= пКод.ОбъявлениеВСМИОбУтратеБСО;
		СостояниеБСО	= пСст.Украден;
	ИначеЕсли ЭтоУведомление Тогда
		КодОперации 	= пКод.ЗаявлениеАгентаОбУтратеБСО;
		ТипПоУмолчанию	= Объект.ТипУтратыПоУмолчанию;
		ТипСписанияТЧ	= "ТипУтраты";
	ИначеЕсли ЭтоСМИ Тогда
		КодОперации 	= пКод.ОбъявлениеВСМИОбУтратеБСО;
		СостояниеБСО 	= пСст.Утрачен
	КонецЕсли;
	Если ТипПоУмолчанию <> Неопределено Тогда 
		Если ТипПоУмолчанию = "Испорчен" Тогда
			СостояниеПоУмолчанию = пСст.Испорчен;	
		ИначеЕсли ТипПоУмолчанию = "Украден" Тогда
			СостояниеПоУмолчанию = пСст.Украден;	
		ИначеЕсли ТипПоУмолчанию = "Уничтожен" Тогда
			СостояниеПоУмолчанию = пСст.Уничтожен;	
		ИначеЕсли ТипПоУмолчанию = "Оформлен, отдан Клиенту" Тогда
			СостояниеПоУмолчанию = пСст.Оформлен;	
		ИначеЕсли ТипПоУмолчанию = "Оформлен, отдан Банку" Тогда
			СостояниеПоУмолчанию = пСст.Оформлен;	
		Иначе //Если ТипСписанияПоУмолчанию = "Утрачен" Тогда
			СостояниеПоУмолчанию = пСст.Утрачен;	
		КонецЕсли;
	КонецЕсли;
	//ЦИКЛ
	//
	Для Каждого СтрокаТЧ Из БСО Цикл
		ВидБСО			= СтрокаТЧ.ВидБСО;
		НомернойУчет 	= уб_СЛ.ОпределитьУчетБСОНомерной(ВидБСО);
		Если НомернойУчет = Неопределено Тогда
			Продолжить
		КонецЕсли;
		НомерБСО		= СокрЛП(СтрокаТЧ.НомерБСО);
		СК 				= ?(сооНаличияРеквизита.Получить("СК"), 			СтрокаТЧ.СК,				Объект.СК);
		Поставщик		= ?(сооНаличияРеквизита.Получить("Поставщик"), 		СтрокаТЧ.Поставщик,			Объект.Поставщик);
		ОргАгент		= ?(сооНаличияРеквизита.Получить("ОргАгент"), 		СтрокаТЧ.ОрганизацияАгент,	Объект.ОрганизацияАгент);
		Подтверждено	= ?(сооНаличияРеквизита.Получить("Подтверждено"), 	СтрокаТЧ.Подтверждено, 		Истина); //по умолчанию истина
		//Агент - для некоторых документов нужно брать из шапки даже прин наличии реквизита в ТЧ
		Если ЭтоПередача Или ЭтоСписание Тогда
			Агент = Неопределено
		ИначеЕсли ЭтоУведомление Или ЭтоСМИ Тогда
			Агент = Объект.Ответственный
		ИначеЕсли ЭтоПолиция Или ЭтоУтрата Тогда
			Агент = Объект.Агент
		Иначе
			Агент = ?(сооНаличияРеквизита.Получить("Агент"), СтрокаТЧ.Агент, Объект.Агент)
		КонецЕсли;
		//АгентОтправитель
		Если ЭтоВозврат Тогда
			АгентОтправитель = Неопределено
		ИначеЕсли ЭтоУведомление Или ЭтоСписание Или ЭтоСМИ Тогда
			АгентОтправитель = Объект.Ответственный
		ИначеЕсли ЭтоПолиция Или ЭтоУтрата Тогда
			АгентОтправитель = Объект.Агент
		Иначе
			АгентОтправитель = ?(сооНаличияРеквизита.Получить("Агент"), СтрокаТЧ.Агент, Объект.Агент)
		КонецЕсли;
		//ПоложениеБСО
		ИнфоЗапись	= Не (Подтверждено И Проведен);
		СООхвост	= " Перемещение невозможно! (строка № " + Строка(СтрокаТЧ.НомерСтроки) + ")";
		Если Подтверждено Тогда
			КоличествоПодтвержденных = КоличествоПодтвержденных + 1
		КонецЕсли;
		Если Не ПустаяСтрока(НомерБСО) Тогда
			Результат = ПоследняяЗаписьРегистраДвижений(Период, СК, ВидБСО, НомерБСО);
			Если Не Результат.Пустой() Тогда
				ВыборкаРС = Результат.Выбрать();
				ВыборкаРС.Следующий();
				Если Не НомернойУчет Тогда
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Только для журнала. Количественное БСО в регистре движений - проверить. " + Объект.Ссылка + " " + СК + " " + ВидБСО + " " + НомерБСО, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина)
				КонецЕсли;
				НомернойУчет = Истина;
			КонецЕсли;
		ИначеЕсли НомернойУчет Тогда
			СОО = "Не указан номер БСО для [" + Строка(ВидБСО) + "] СК: '" + Строка(СК) + "', строка " + Строка(СтрокаТЧ.НомерСтроки)+" " 
			+ СООхвост;
			ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
			Возврат;
		КонецЕсли;
		ЕстьИнфоОБСО = ВыборкаРС <> Неопределено;
		КонтролироватьОстатки = ПараметрыСеанса.уб_Константы.уб_КонтролироватьНаличиеБСО И (Не ЭтоСписание //Или (ЭтоСписание И Не Объект.НеКонтролироватьНаличиеБСОПриПроведении)
		);
		Если НомернойУчет Тогда
			СОО = "БСО № '" + Строка(НомерБСО) + "' [" + Строка(ВидБСО) + "], СК: '" + Строка(СК) + "'";
			Если Не ИнфоЗапись Тогда
				//контроль БСО
				Если ЕстьИнфоОБСО Тогда
					//контроль поставщика, оргагента и агента. 
					Если СтруктураКонтроля.Поставщик И ВыборкаРС.Поставщик <> Поставщик Тогда
						СОО = СОО + " поступало от поставщика '" + ВыборкаРС.Поставщик.Наименование + "'. В документе указан другой поставщик: '" + Поставщик.Наименование + "'.";
						Если Пересортица Тогда
							Сообщить(СОО + СООхвостПересортица);	
						Иначе
							ОбщегоНазначения.ОшибкаПриПроведении(СОО + СООхвост, Отказ, Заголовок);
							Возврат;
						КонецЕсли;
					КонецЕсли;
					Если СтруктураКонтроля.ОрганизацияАгент И ВыборкаРС.ОрганизацияАгент <> ОргАгент Тогда
						СОО = СОО + " поступало в ОргАгент '" + ВыборкаРС.ОрганизацияАгент.Наименование +"'. В документе указан другой ОргАгент: '" + ОргАгент.Наименование + "'.";
						Если Пересортица Тогда
							Сообщить(СОО + СООхвостПересортица);	
						Иначе
							ОбщегоНазначения.ОшибкаПриПроведении(СОО + СООхвост, Отказ, Заголовок);
							Возврат;
						КонецЕсли;
					КонецЕсли;
					Если СтруктураКонтроля.Агент И ВыборкаРС.Агент <> Агент Тогда
						СОО = СОО + " поступало в Агент '" + ВыборкаРС.ОрганизацияАгент.Наименование + "'. В документе указан другой Агент: '" + Агент.Наименование + "'.";
						Если Пересортица Тогда
							Сообщить(СОО + СООхвостПересортица);	
						Иначе
							ОбщегоНазначения.ОшибкаПриПроведении(СОО + СООхвост, Отказ, Заголовок);
							Возврат;
						КонецЕсли;
					КонецЕсли;
					//TODO контроль положения
					Если СтруктураКонтроля.ПоложениеБСО Тогда
						Если ЭтоВозврат Тогда
							Если ВыборкаРС.ПоложениеБСО <> Перечисления.уб_ПоложенияБСО.ПереданВСК Тогда
								СОО = СОО + " не передавался Поставщику ранее. Текущее положение: '" + Строка(ВыборкаРС.ПоложениеБСО) + "'"	+ СООхвост;
								ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
								Возврат;
							КонецЕсли;
						ИначеЕсли ЭтоСписание Тогда
							Если ВыборкаРС.ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ПереданВСК 
								Или ВыборкаРС.ПоложениеБСО = Перечисления.уб_ПоложенияБСО.Списан
								Тогда
								СОО = СОО + " имеет состояние: '" + Строка(ВыборкаРС.СостояниеБСО) + "', положение: '" + Строка(ВыборкаРС.ПоложениеБСО) + "'." + СООхвост;
								ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
								Возврат;
							КонецЕсли;
						Иначе
							//стандартная проверка
							Если ВыборкаРС.ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ПереданВСК Тогда
								СОО = СОО + " имеет состояние: '" + Строка(ВыборкаРС.СостояниеБСО) + "', положение: '" + Строка(ВыборкаРС.ПоложениеБСО) + "'.";
								ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
								Возврат;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Иначе
					//контроль остатков
					Если СтруктураКонтроля.НаличиеБСО И КонтролироватьОстатки Тогда
						СОО = СОО + " не поступало!" + СООхвост;
						ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
						Возврат;
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;
			Движение = Объект.Движения.уб_ДвиженияБСО.Добавить();
			Движение.Период 	= Дата;
			Движение.СК			= СК;
			Движение.ВидБСО 	= ВидБСО;
			Движение.НомерБСО   = НомерБСО;
			Если ЕстьИнфоОБСО Тогда
				Движение.Поставщик 			= ВыборкаРС.Поставщик;
				Движение.ОрганизацияАгент 	= ВыборкаРС.ОрганизацияАгент;				
				Движение.НомерПолиса		= ВыборкаРС.НомерПолиса;
				Движение.ГодПолиса			= ВыборкаРС.ГодПолиса;
				Движение.СтраховойПолис		= ВыборкаРС.СтраховойПолис;
				Движение.ДопНомерБСО		= ВыборкаРС.ДопНомерБСО;
				
				//при возврате блокировка - ложь и заявки нет
				Если Не ЭтоВозврат Тогда
					//Движение.Блокировка	= ВыборкаРС.Блокировка;
					Движение.Заявка		= ВыборкаРС.Заявка;
				КонецЕсли;
				Если СтрокаТЧ.Количество = 1 Тогда
					СтрокаТЧ.Количество = 0;	
				КонецЕсли;
			Иначе
				Движение.Поставщик			= Поставщик;
				Движение.ОрганизацияАгент 	= ОргАгент;
				Если сооНаличияРеквизита.Получить("НомерПолиса") Тогда
					Движение.НомерПолиса = СтрокаТЧ.НомерПолиса
				КонецЕсли;
			КонецЕсли;
			//TODO у возврата всегда строка подтверждена
			Движение.Подтверждено   	= Подтверждено;
			//Движение.ДокПроведен 		= Проведен;
			Движение.Активность 		= Проведен;
			Движение.Агент 				= Агент;
			Движение.АгентОтправитель 	= АгентОтправитель;
			Движение.НаОснованииБумажногоДокумента 	= Объект.НаОсновеБумажногоДокумента;
			Если сооНаличияРеквизита.Получить("Комментарий") Тогда
				Движение.Комментарий = СтрокаТЧ.Комментарий
			КонецЕсли;
			Движение.КодОперации = КодОперации;
			//частные случаи состояния БСО
			Если ЭтоПередача Тогда
				Если СтрокаТЧ.СостояниеБСО.Пустая() Тогда
					Если ЕстьИнфоОБСО Тогда
						//т.е. если тип передачи утраченных а в строке пусто, то возьмутся последние данные из регистра?
						СостояниеБСО = ВыборкаРС.СостояниеБСО
					КонецЕсли;
				Иначе
					СостояниеБСО = СтрокаТЧ.СостояниеБСО
				КонецЕсли;
			ИначеЕсли ЭтоСписание Или ЭтоУтрата Или ЭтоУведомление Тогда
				Если СтрокаТЧ[ТипСписанияТЧ] = "Испорчен" Тогда
					СостояниеБСО	= пСст.Испорчен;
				ИначеЕсли СтрокаТЧ[ТипСписанияТЧ] = "Украден" Тогда
					СостояниеБСО	= пСст.Украден;
				ИначеЕсли СтрокаТЧ[ТипСписанияТЧ] = "Уничтожен" Тогда
					СостояниеБСО	= пСст.Уничтожен;
				ИначеЕсли СтрокаТЧ[ТипСписанияТЧ] = "Утрачен" Тогда
					СостояниеБСО	= пСст.Утрачен;
				ИначеЕсли СтрокаТЧ[ТипСписанияТЧ] = "Оформлен, отдан Клиенту" Тогда
					СостояниеБСО	= пСст.Оформлен;
				ИначеЕсли СтрокаТЧ[ТипСписанияТЧ] = "Оформлен, отдан Банку" Тогда
					СостояниеБСО	= пСст.Оформлен;
				Иначе
					СостояниеБСО	= СостояниеПоУмолчанию;
				КонецЕсли;
			КонецЕсли;
			//частный случай положения БСО для списания
			Если ЭтоСписание Тогда
				Если СтрокаТЧ.ТипСписания = "Испорчен" Тогда
					ПоложениеБСО	= пПлж.Списан;
				ИначеЕсли СтрокаТЧ.ТипСписания = "Украден" Тогда
					ПоложениеБСО	= пПлж.Списан;
				ИначеЕсли СтрокаТЧ.ТипСписания = "Уничтожен" Тогда
					ПоложениеБСО	= пПлж.Списан;
				ИначеЕсли СтрокаТЧ.ТипСписания = "Утрачен" Тогда
					ПоложениеБСО	= пПлж.Списан;
				ИначеЕсли СтрокаТЧ.ТипСписания = "Оформлен, отдан Клиенту" Тогда
					ПоложениеБСО	= пПлж.ОтданКлиенту;
				ИначеЕсли СтрокаТЧ.ТипСписания = "Оформлен, отдан Банку" Тогда
					ПоложениеБСО	= пПлж.ОтданБанку;
				Иначе
					//TODO а если банк??
					ПоложениеБСО	= пПлж.Списан;
				КонецЕсли;	
			КонецЕсли;
			Движение.СостояниеБСО   = СостояниеБСО;
			Движение.ПоложениеБСО	= ПоложениеБСО;
			ЕстьДвиженияНомерных = Истина;
		Иначе
			Если Не ИспользуетсяКолУчет Тогда
				СтрокаТЧ.Подтверждено 		= Ложь;
				КоличествоПодтвержденных 	= КоличествоПодтвержденных - 1;
				Сообщить("Найдено БСО количественного учета, с которого снято подтверждение: " + СОО);
			ИначеЕсли Не Инфозапись Тогда
				//движения количественного учета
				Если СтрокаТЧ.Количество = 0 Тогда
					СОО = Строка(ВидБСО) + ": не указано количество для БСО с количественным типом учета. Укажите количество! [строка "+Строка(СтрокаТЧ.НомерСтроки)+"] "
					+ СООхвост;
					ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
					Возврат;
				КонецЕсли;
				Если ЭтоСписание Тогда
					Если Не ЗначениеЗаполнено(Поставщик) Тогда
						СОО = Строка(ВидБСО) + ": не указан Поставщик для БСО с количественным типом учета. Укажите Поставщика!" + СООхвост;
						ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
						Возврат;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(ОргАгент) Тогда
						СОО = Строка(ВидБСО) + ": не указана Организация-Агент для БСО с количественным типом учета. Укажите Организацию-Агента!" + СООхвост;
						ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
						Возврат;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Агент) Тогда
						СОО = Строка(ВидБСО) + ": не указан Агент для БСО с количественным типом учета. Укажите Агента!" + СООхвост;
						ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
						Возврат;
					КонецЕсли;
				КонецЕсли;
				// проверим остатки
				СтруктураОтбора = Новый Структура("Период, Поставщик, ОрганизацияАгент, СК, ВидБСО, Агент"
				,Период
				,Поставщик
				,ОргАгент
				,СК
				,ВидБСО
				,Агент
				);
				тзРег = уб_СЛ.ПолучитьОстаткиБСО(СтруктураОтбора);
				КолВНаличие = 0;
				ЗаписьРег = Неопределено;
				Если тзРег.Количество() > 0 Тогда
					ЗаписьРег = тзРег[0];
					КолВНаличие = ЗаписьРег.Количество;
				КонецЕсли;
				Если СтруктураКонтроля.НаличиеБСО И КонтролироватьОстатки И СтрокаТЧ.Количество > КолВНаличие Тогда
					СОО = Строка(ВидБСО) + ": требуется передать " + Строка(СтрокаТЧ.Количество) + "шт, имеется в наличии " + Строка(КолВНаличие) + "шт."
					+ СООхвост;
					ОбщегоНазначения.ОшибкаПриПроведении(СОО, Отказ, Заголовок);
					Возврат;
				КонецЕсли; 
				Движение = Объект.Движения.уб_ОстаткиБСО.Добавить();
				Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
				Движение.Период 		= Объект.Дата;
				// измерения
				Если ЗаписьРег <> Неопределено Тогда
					Движение.Поставщик			= ЗаписьРег.Поставщик;
					Движение.ОрганизацияАгент 	= ЗаписьРег.ОрганизацияАгент;
				Иначе
					Движение.Поставщик 			= Поставщик;
					Движение.ОрганизацияАгент 	= ОргАгент;
				КонецЕсли;
				Движение.СК 	= СК;
				Движение.ВидБСО	= ВидБСО;
				Если ЭтоПередача Тогда
					Движение.Агент = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО
				Иначе
					Движение.Агент = Агент
				КонецЕсли;
				// ресурсы
				Движение.Количество	= СтрокаТЧ.Количество;
				// реквизиты
				Если ЭтоСписание Тогда
					Движение.СостояниеБСО = ?(СтрокаТЧ.ТипСписания.Пустая(), ТипПоУмолчанию, СтрокаТЧ.ТипСписания);
				КонецЕсли;
				Движение.КодОперации = КодОперации;
				ЕстьДвиженияКоличественных = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Проведен И КоличествоПодтвержденных < 1 Тогда
		Если НЕ ЗначениеНеЗаполнено(Заголовок) Тогда
			Сообщить(Заголовок);
			Заголовок = "";
		КонецЕсли;
		Сообщить("Движения не сделаны. Не обнаружено ни одной подтвержденной строки передачи БСО в СК.");
	КонецЕсли;	
	Если ЕстьДвиженияНомерных Тогда
		Объект.Движения.уб_ДвиженияБСО.Записать()
	КонецЕсли;
	Если ЕстьДвиженияКоличественных Тогда
		Объект.Движения.уб_ОстаткиБСО.Записать()
	КонецЕсли;
	
КонецПроцедуры

//НаличиеБСО 	- для всех
//Поставщик		- для всех
//ОргАгент		- для всех
//Агент			- нигде
//ПоложениеБСО	- ВозвратБСО
