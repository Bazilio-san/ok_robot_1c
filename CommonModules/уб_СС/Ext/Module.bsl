	Возврат Новый Структура("НаличиеБСО, Поставщик, ОрганизацияАгент, Агент, ПоложениеБСО");
	
КонецФункции // СтруктураКонтроляДвиженийБСО()

Функция ПоследняяЗаписьРегистраДвижений(Период, СК, ВидБСО, НомерБСО) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Выбор Когда &НеИспользоватьБлокировкиБСО = Истина Тогда Ложь Иначе ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ) Конец КАК Блокировка,
	| 	*
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
	|			&Период,
	|           	ВидБСО = &ВидБСО
	|				И НомерБСО = &НомерБСО
	|				И Подтверждено
	|				) КАК ДБ
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних(
	|				&Период,
	|				ВидБСО = &ВидБСО
	|					И НомерБСО = &НомерБСО) КАК уб_БлокировкаБСОСрезПоследних
	|		ПО ДБ.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
	|			И ДБ.СК = уб_БлокировкаБСОСрезПоследних.СК
	|			И ДБ.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДБ.Период УБЫВ");
	Запрос.УстановитьПараметр("Период", 	Период);
	Запрос.УстановитьПараметр("ВидБСО", 	ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО",   НомерБСО);
	Запрос.УстановитьПараметр("НеИспользоватьБлокировкиБСО",ПараметрыСеанса.уб_Константы.уб_НеИспользоватьБлокировкиБСО);
	//берем всегда только НЕ инфо записи
	//Если (ЭтоПолиция Или ЭтоУтрата Или ЭтоСМИ Или ЭтоУведомление) Или Не ИнфоЗапись Тогда
	//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "1 = 1", "Подтверждено И ДокПроведен")
	//КонецЕсли;
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка;
	КонецЕсли;
	
КонецФункции // ТаблицаПоРегистру()

