Процедура НачалоВыбораНомераЗаявки(Форма, Элемент, СтандартнаяОбработка,Изменилось = ЛОЖЬ) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Попытка
		СтароеЗначение = Элемент.Значение;
		Ссылка = Форма.Ссылка;
		УправляемаяФорма = ЛОЖЬ;
	Исключение
		УправляемаяФорма = Истина;
		СтароеЗначение = Форма.Объект.НомерЗаявки;
		Ссылка         = Форма.Объект.Ссылка;
	КонецПопытки;	
	ТипСтЗн = ТипЗнч(СтароеЗначение);
	Если ТипСтЗн = Тип("Число") Тогда
		НомерЗаявки = СтароеЗначение;
	Иначе
		НомерЗаявки = 0;
	КонецЕсли;
	Список = Новый СписокЗначений;
	ЭлНом = Список.Добавить(НомерЗаявки,							"Номер заявки в БАЗЕ");
	ЭлЛич = Список.Добавить(Перечисления.уб_ВидыЗаявок.Личная,		"Личная страховка");
	ЭлЛич = Список.Добавить(Перечисления.уб_ВидыЗаявок.Агентская,	"Внешний агент");
	//Список.Добавить(Перечисления.уб_ВидыЗаявок.КоробочнаяПродажа,	"Кросс-продажа коробочного продукта");
	ЭлементПоУмолчанию = ?(ТипСтЗн = Тип("ПеречислениеСсылка.уб_ВидыЗаявок"), ЭлЛич, ЭлНом);
	ВыбранныйЭлемент = Форма.ВыбратьИзменю(Список,Элемент);
	ВыбранноеЗначение = ?(ВыбранныйЭлемент = Неопределено, СтароеЗначение, ВыбранныйЭлемент.Значение);
	Если УправляемаяФорма = ЛОЖЬ Тогда
		Элемент.Значение = ВыбранноеЗначение;
	Иначе
		Форма.Объект.НомерЗаявки = ВыбранноеЗначение;
	КонецЕсли;	
	Элемент.РедактированиеТекста = ТипЗнч(ВыбранноеЗначение) = Тип("Число");
	Изменилось = НЕ ВыбранноеЗначение = СтароеЗначение;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда
		Форма.УстСостоянияПолейПриИзменении();
	//ИначеЕсли ТипЗнч(Форма.Ссылка) = Тип("ДокументСсылка.") Тогда
	
	КонецЕсли;
	
КонецПроцедуры

Процедура НачалоВыбораСхемыРасчета(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	уб_РасчетЗарплатыМенеджерамОП.Ссылка
	|ИЗ
	|	ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП КАК уб_РасчетЗарплатыМенеджерамОП
	|ГДЕ
	|	уб_РасчетЗарплатыМенеджерамОП.Используется
	|
	|УПОРЯДОЧИТЬ ПО
	|	уб_РасчетЗарплатыМенеджерамОП.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();					  
	ДанныеВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		ДанныеВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	ВыбЭлемент = Форма.ВыбратьИзМеню(ДанныеВыбора, Элемент);
	Если ВыбЭлемент = Неопределено  Тогда
		Элемент.Значение = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.БезРасчета;
	Иначе
		Элемент.Значение = ВыбЭлемент.Значение;
	КонецЕсли;
	
КонецПроцедуры

