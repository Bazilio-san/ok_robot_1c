Функция ПредупредитьОПоставщикеЕслиСКбезДоговора_Общая(СК,ДатаДок, Предупреждать = Истина) Экспорт 
	Если ЗначениеНеЗаполнено(СК) Тогда
		Возврат СК;	
	КонецЕсли;
	Если СК.Родитель <> ПараметрыСеанса.уб_Константы.уб_ГруппаСК Тогда
		Возврат СК;	
	КонецЕсли;
	ДатаПроверки = ?(ЗначениеНеЗаполнено(ДатаДок),ТекущаяДата(),ДатаДок);
	
	Дог = СК.ОсновнойДоговорКонтрагента;
	Если НЕ ЗначениеНеЗаполнено(Дог) Тогда
		Если (ЗначениеНеЗаполнено(Дог.ДатаОкончанияДействияДоговора)
			ИЛИ ДатаПроверки < Дог.ДатаОкончанияДействияДоговора)
			И Дог.ДатаЗаключенияДоговора < ДатаПроверки
			Тогда
			Возврат СК;	
		КонецЕсли;
	КонецЕсли;
	Если Предупреждать Тогда
		#Если Клиент Тогда
			Предупреждение("В выбранной страховой компанией нет
			|дейстующего договора на дату документа
			|
			|Укажите поставщика!",15,"Необходимо выбрать поставщика!");		
		#Иначе
			Сообщить("В выбранной страховой компанией нет
			|дейстующего договора на дату документа
			|
			|Укажите поставщика! Необходимо выбрать поставщика!");
		#КонецЕсли
		
		
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецФункции

Процедура ПредупредитьОПоставщикеЕслиСКбезДоговора(ФормаДокумента) Экспорт 
	ФормаДокумента.Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	ФормаДокумента.Поставщик = ПредупредитьОПоставщикеЕслиСКбезДоговора_Общая(ФормаДокумента.СК, ФормаДокумента.Дата);
	Если ФормаДокумента.СК <> ФормаДокумента.Поставщик 
		И НЕ ФормаДокумента.ЭлементыФормы.Поставщик.АвтовыборНезаполненного Тогда
		ФормаДокумента.ТекущийЭлемент = ФормаДокумента.ЭлементыФормы.Поставщик;
	КонецЕсли;
КонецПроцедуры

