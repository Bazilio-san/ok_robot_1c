Процедура ОбработатьОшибкиРасчетаПродления(Данные) Экспорт
	Если Данные.Свойство("ОшибкаВПаспорте") Тогда
		Сообщить("Ошибка в паспорте");
	КонецЕсли;
	
	Если Данные.Свойство("ОшибкаVIN") Тогда
		Сообщить("Ошибка vin");
		ПоказатьЗначение(,Данные.ОбъектСтрахования);
	КонецЕсли;
	
	Если Данные.Свойство("ОшибкаВДР") Тогда
		Сообщить("Ошибка в дате рождения");
		ПоказатьЗначение(,Данные.СтраховательСсылка);
	Иначе	
		Если Данные.Свойство("ОшибкаВПаспорте") Тогда
			ПоказатьЗначение(,Данные.СтраховательСсылка);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры
#КонецОбласти


Процедура ДобавитьОтбор(Настройки,ПараметрыОтбора) Экспорт
	ОтборНайден = Ложь;
	Для каждого ТекОтбор из Настройки.Отбор.Элементы Цикл
		Если ПараметрыОтбора.ЛевоеЗначение = ТекОтбор.ЛевоеЗначение Тогда
			ОтборНайден = Истина;
			ЭлементОтбора = ТекОтбор;
		КонецЕсли;	
	КонецЦикла;	
	Если ОтборНайден = ЛОЖЬ Тогда
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	ЭлементОтбора.ЛевоеЗначение		= ПараметрыОтбора.ЛевоеЗначение;
	ЭлементОтбора.ВидСравнения 		= ПараметрыОтбора.ВидСравнения;
	ЭлементОтбора.Использование 	= Истина;
	//ЭлементОтбора.ПравоеЗначение 	= Справочники.ФизическиеЛица.ПустаяСсылка();
	ЭлементОтбора.Представление		= ПараметрыОтбора.ПравоеЗначение;
	ЭлементОтбора.ПравоеЗначение	= ПараметрыОтбора.ПравоеЗначение;

КонецПроцедуры	
