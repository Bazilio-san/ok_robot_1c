Процедура ДобавитьВидОплаты(СтрокаВидОплаты,ЭлВидОплаты,СуммаВзноса)
	ЭлВидОплаты.Добавить(СтрокаВидОплаты,ПосчитатьПроцент(СуммаВзноса,СтрокаВидОплаты));
КонецПроцедуры	


Функция ПосчитатьПроцент(СуммаВзноса,Представление, КакЧисло = Ложь)
	Процент = 0;
	
	Если Представление = "СБП  (2.4%)" Тогда
		Процент = 2.4;
	ИначеЕсли Представление = "Терминал (3%)" Тогда
		Процент = 3.0;
	ИначеЕсли Представление = "На карту (0%)" Тогда
		Процент = 0.0;	
	ИначеЕсли Представление = "По ссылке в КПП (3%)" Тогда
		Процент = 3.0;	
	ИначеЕсли Представление = "В страховую -3%(потерянная сумма)" Тогда
		Процент = 3.0;		
		
	КонецЕсли;	
	
	ВремПремия = Окр(СуммаВзноса* Процент/100,2);
	Если КакЧисло Тогда
		Возврат ВремПремия
	Иначе
		Возврат ""+Представление+"     ("+Формат(ВремПремия,"ЧН=")+" руб.)";  
	КонецЕсли;	
КонецФункции	

Процедура ЗаполнитьФормуОплатыИКошелек(ВидОплаты,_ЭтотОбъект,ПодразделениеМенеджера,ДокументМенеджер) Экспорт
	
	Если ВидОплаты = "На р\с в КПП (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Безнал");
	ИначеЕсли ВидОплаты = "Наличными (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Касса");
	ИначеЕсли ВидОплаты = "В кредит (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ВКредит");	
	ИначеЕсли ВидОплаты = "На карту (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");		
	ИначеЕсли ВидОплаты = "СБП  (2.4%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");			
	ИначеЕсли ВидОплаты = "По ссылке в КПП (3%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПоСсылкеБрокеру");			
	ИначеЕсли ВидОплаты = "В страховую -3%(потерянная сумма)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Поставщику");				
	ИначеЕсли ВидОплаты = "Терминал (3%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Терминал");
	ИначеЕсли ВидОплаты = "По QR коду (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПоQR");
	
	ИначеЕсли Найти(ВидОплаты,"На карту")=1	Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");		
		Для каждого СтрокаКарты из уб_ВызовСервера.ПолучитьДействующиеКартыПодразделения(ПодразделениеМенеджера,ДокументМенеджер) Цикл
			Если Найти(ВидОплаты,""+СтрокаКарты.Карта)>0 Тогда
				_ЭтотОбъект.Кошелек = СтрокаКарты.Карта;
				прервать;
			КонецЕсли;		
		КонецЦикла;
	ИначеЕсли ПустаяСтрока(ВидОплаты) Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

