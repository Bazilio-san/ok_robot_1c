	//уб_temp.ЗаполнитьФормыОплаты(Элементы.ВидОплаты.СписокВыбора); требует проверки
	ЭлВидОплаты = Элемент.СписокВыбора;
	ЭлВидОплаты.Очистить();
	ДобавитьВидОплаты("Наличными (0%)",ЭлВидОплаты,СуммаВзноса);
