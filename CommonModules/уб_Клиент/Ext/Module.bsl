Процедура ПечатьПоКнопке (Форма,Кнопка,Параметры = неопределено) Экспорт
	
	ДеревоМакетов 		= Форма.ПечатныеФормы;
	Объект				= Форма.Объект;
	//ТекстКнопки			= Кнопка.Текст;
	ЭлементыФормы		= Форма.Элементы;
	ИмяКнопки			= Кнопка.Имя;
	СохранятьПФВФайл    = ?(ЭлементыФормы.Найти("СохранятьПФВФайл") <> Неопределено, ЭлементыФормы.СохранятьПФВФайл, Ложь);
	Если Не Форма = Неопределено Тогда
		Если Не ПроверитьМодифицированностьВФорме(Объект,Форма) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ИмяФормы = СтрЗаменить(Кнопка.Имя,"ВыполнитьКомандуПечати_","");
	
	СтрокиКнопки = Форма.ПечатныеФормы.НайтиСтроки(Новый Структура("КодПФ",ИмяФормы));
	Если СтрокиКнопки.Количество() = 0 Тогда
		Возврат
	КонецЕсли;	
	СтрокаКнопки  = СтрокиКнопки[0];
	//СтрокаКнопки = ДеревоМакетов.Строки.Найти(ТекстКнопки, "Текст");
	Если СтрокаКнопки = Неопределено Тогда
		Предупреждение("Печать не доступна. Изменился набор реквизитов!");
		//Возврат;		
	КонецЕсли;
	Расшифровка = Неопределено;
	//Попытка
	//	Расшифровка = СтрокаКнопки.Расшифровка
	//Исключение
	//	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("ПечатьПоДополнительнойКнопке(): Описание ошибки: " + ОписаниеОшибки() + ", ПФ: " + Кнопка.Имя, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
	//КонецПопытки;
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		НаПринтер = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(уб_ВызовСервера.ТекущийПользователь(), "ПечатьДокументовБезПредварительногоПросмотра") = Истина;
		ТабДокумент = уб_ВызовСервера.НапечататьВнешнююФорму(Объект.Ссылка, Расшифровка, Параметры);
		//ЭтоДокумент = Метаданные.Документы.Содержит(Объект.Метаданные());
		//TODO заполнить второй и третий параметры аналогично строке ниже
		//НапечататьДокумент(ТабДокумент, 0, Форма.НаПринтер, ?(ЭтоДокумент, ОбщегоНазначения.СформироватьЗаголовокДокумента(Объект), Строка(Объект)), Объект.Ссылка, Расшифровка);
		//УниверсальныеМеханизмы.НапечататьДокумент(ТабДокумент,,, ?(ЭтоДокумент, ОбщегоНазначения.СформироватьЗаголовокДокумента(Объект), Строка(Объект)), Объект.Ссылка, Расшифровка);
		Если ТипЗнч(ТабДокумент) = Тип("ТабличныйДокумент") Тогда
			ТабДокумент.Показать(Расшифровка.Наименование)
		КонецЕсли;
	ИначеЕсли Лев(ИмяКнопки, 2) = "ПФ" Или Лев(ИмяКнопки, 2) = "СА" Тогда
		Контекст = уб_ПФ.ИнициализироватьКонтекстПечати();
		//чкн
		Если НЕ Параметры = Неопределено И ТипЗнч(Параметры) = Тип("Массив") Тогда 
			Контекст.МассивОбъектов = Параметры;
		КонецЕсли;
		//чкн
		Контекст.СохранятьПФВФайл   = СохранятьПФВФайл;
		Контекст.ИмяОбъекта 		= Объект.Метаданные().Имя;
		Контекст.ЭтоПФСубагент		= Лев(ИмяКнопки, 2) = "СА";
		Если Контекст.ЭтоПФСубагент Тогда
			Контекст.ПроцентСубагента 	= Объект.ПроцентСубагента;
			Контекст.Субагент			= Объект.Субагент;
		КонецЕсли;
		Если ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(Параметры, "ЭтоИсторияОП", Истина) Тогда
			Контекст.ЭтоИсторияОП = Истина;
			Контекст.ОплатыСписок = Параметры.ОплатыСписок;
		Иначе
			Контекст.ЭтоИсторияОП = Ложь
		КонецЕсли;
		Код = Сред(ИмяКнопки, 3);
		СсылкаПФ = уб_ВызовСервера.НайтиПоКоду("Справочники","уб_ПечатныеФормы",Код);
		Если СсылкаПФ <> Неопределено И Не СсылкаПФ.Пустая() Тогда
			Контекст.СсылкаПФ = СсылкаПФ;
			//Контекст.ОбъектПФ = СсылкаПФ.ПолучитьОбъект();
			Контекст.СтруктураОбъектаПФ = уб_ПФ.ПолучитьСтруктуруОбъектаПФИзСсылки(СсылкаПФ);
		КонецЕсли;
		уб_ПФ.Печать(Контекст, Объект, ИмяКнопки)
	Иначе
		//это макеты конфигуратора
		Адрес = уб_ВызовСервера.ПечатьВнутреннихМакетов(Форма.Объект.Ссылка,Кнопка.Имя,Параметры);
		
		ТабличныйДокумент = ПолучитьИзВременногоХранилища(Адрес);
		
		ПоказатьТабличныйДокумент(ТабличныйДокумент); 
		
	КонецЕсли;

Конецпроцедуры	


Функция ПроверитьМодифицированностьВФорме(Объект, Форма) Экспорт

	Результат = Ложь;
	Если Форма.Модифицированность Тогда
		Проведен    = Объект.Проведен;
		СтрПроведен = ?(Проведен, " и провести","");		
		Ответ = Вопрос("Документ изменен. Для печати его необходимо записать "+ СтрПроведен +".
		               |Записать" + СтрПроведен + "?",
		               РежимДиалогаВопрос.ОКОтмена, , 
		               КодВозвратаДиалога.Отмена,
		               "Документ изменен");
		Если Ответ = КодВозвратаДиалога.ОК Тогда
			Попытка
				Результат = Форма.ЗаписатьВФорме();
			Исключение
				Предупреждение("Операция не выполнена!");
				Результат = Ложь;
			КонецПопытки;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	Иначе
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
                             
КонецФункции // ПроверитьМодифицированность()




