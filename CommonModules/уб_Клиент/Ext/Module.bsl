Функция ДиалогДобавленияФайла(Документ,УникальныйИдентификаторФормы,Знач СтруктураЗаполнения  = Неопределено)   Экспорт
	Если СтруктураЗаполнения = Неопределено Тогда
		СтруктураЗаполнения = Новый Структура;
		
	КонецЕсли;	
	
	Если СтруктураЗаполнения.Свойство("ВидДокумента") = Ложь Тогда
		СтруктураЗаполнения.Вставить("ВидДокумента",ПредопределенноеЗначение("Справочник.уб_ВидыДокументовКПолисам.ПустаяСсылка"));
	КонецЕсли;	
	
	СтруктураЗаполнения.Вставить("СтраховойПолис",Документ);
	
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.МножественныйВыбор = Истина;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файлы'; en = 'Select file'");
   	ПараметрыДиалога.Фильтр = уб_temp.ПолучитьФильтрФайлов();
	
    ЗавершениеОбратныйВызов = Новый ОписаниеОповещения("ЗавершениеПомещениеФайлаНаСервер", ЭтотОбъект,СтруктураЗаполнения);
	//ПрогрессОбратныйВызов = Новый ОписаниеОповещения("ПрогрессОбратныйВызов", ЭтотОбъект);
	//ПередНачаломОбратныйВызов = Новый ОписаниеОповещения("ПередНачаломОбратныйВызов", ЭтотОбъект);
    НачатьПомещениеФайловНаСервер(ЗавершениеОбратныйВызов,,,,УникальныйИдентификаторФормы);

КонецФункции


Процедура НачалоВыбораНомераЗаявки(Форма, Элемент, СтандартнаяОбработка,Изменилось = ЛОЖЬ) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Попытка
		СтароеЗначение = Элемент.Значение;
		Ссылка = Форма.Ссылка;
		УправляемаяФорма = ЛОЖЬ;
	Исключение
		УправляемаяФорма = Истина;
		СтароеЗначение = Форма.Объект.НомерЗаявки;
		Ссылка         = Форма.Объект.Ссылка;
	КонецПопытки;	
	ТипСтЗн = ТипЗнч(СтароеЗначение);
	Если ТипСтЗн = Тип("Число") Тогда
		НомерЗаявки = СтароеЗначение;
	Иначе
		НомерЗаявки = 0;
	КонецЕсли;
	Список = Новый СписокЗначений;
	ЭлНом = Список.Добавить(НомерЗаявки,							"Номер заявки в БАЗЕ");
	ЭлЛич = Список.Добавить(ПредопределенноеЗначение("Перечисление.уб_ВидыЗаявок.Личная"),		"Личная страховка");
	ЭлЛич = Список.Добавить(ПредопределенноеЗначение("Перечисление.уб_ВидыЗаявок.Агентская"),	"Внешний агент");
	//Список.Добавить(Перечисления.уб_ВидыЗаявок.КоробочнаяПродажа,	"Кросс-продажа коробочного продукта");
	ЭлементПоУмолчанию = ?(ТипСтЗн = Тип("ПеречислениеСсылка.уб_ВидыЗаявок"), ЭлЛич, ЭлНом);
	Если УправляемаяФорма = ЛОЖЬ Тогда
		
		ВыбранныйЭлемент = Форма.ВыбратьИзменю(Список,Элемент);
		ВыбранноеЗначение = ?(ВыбранныйЭлемент = Неопределено, СтароеЗначение, ВыбранныйЭлемент.Значение);
		Если УправляемаяФорма = ЛОЖЬ Тогда
			Элемент.Значение = ВыбранноеЗначение;
		Иначе
			Форма.Объект.НомерЗаявки = ВыбранноеЗначение;
		КонецЕсли;	
		Элемент.РедактированиеТекста = ТипЗнч(ВыбранноеЗначение) = Тип("Число");
		Изменилось = НЕ ВыбранноеЗначение = СтароеЗначение;
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда
			Форма.УстСостоянияПолейПриИзменении();
			//ИначеЕсли ТипЗнч(Форма.Ссылка) = Тип("ДокументСсылка.") Тогда
			
		КонецЕсли;
	Иначе
		Форма.ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ПриВыбореНомераЗаявки",Форма),Список);
	КонецЕсли;
КонецПроцедуры

