					  ?(ПустаяСтрока(Выборка.ПутьКПапке),"",Выборка.ПутьКПапке+"\")+Выборка.Имя;
		НоваяСтрока.ПолноеИмя = ПутьКФайлу;
		
		
	КонецЦикла;
	//Формирование дерева
	Если ПараметрыОбновления.ВидГруппировки = 0  Тогда
