Процедура ПриНажатииФлажкаРазмещения(Элемент, Колонка, Документ, СтруктураЗаполнения = Неопределено) Экспорт
	Отбор = Новый Структура;
	Отбор.Вставить("СсылкаСправочника",);
	Если НЕ СтруктураЗаполнения = Неопределено Тогда
		Попытка
			Для каждого Зн из СтруктураЗаполнения Цикл
				Отбор.Вставить(Зн.Ключ,Зн.Значение);		
			КонецЦикла;		
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	Если ТекущаяСтрока.СсылкаСправочника = Неопределено Тогда
		ТекущаяСтрока[Колонка.Имя] = Ложь;
		Возврат;	
	КонецЕсли;	
	
	какСправочник = ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА;
	Если Колонка.Имя = "Размещен" И ТекущаяСтрока <> Неопределено Тогда
		Если ТекущаяСтрока.Размещен тогда
			НоваяСтрока = Документ.СписокФайлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.ДатаПубликации = ТекущаяДата();
			ТекущаяСтрока.ДатаПубликации = НоваяСтрока.ДатаПубликации;
			
			Если какСправочник Тогда
				Если НоваяСтрока.СсылкаСправочника.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					НоваяСтрока.Опубликован = ИСТИНА;
					ТекущаяСтрока.Опубликован = НоваяСтрока.Опубликован;
				КонецЕсли;
				НоваяСтрока.Размещен = ИСТИНА;
				мСпрФайл = НоваяСтрока.СсылкаСправочника.ПолучитьОбъект();
				мСпрФайл.Опубликован = НоваяСтрока.Опубликован;
				Попытка
					мСпрФайл.Записать();
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
			Если НЕ СтруктураЗаполнения = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураЗаполнения);
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);
			ТекущаяСтрока.ДатаПубликации = Дата(0001,01,01);
			Массив = Документ.СписокФайлов.НайтиСтроки(Отбор);
			Если Массив.Количество()>0 тогда
				Документ.СписокФайлов.Удалить(Массив[0]);
			КонецЕсли;
			Если какСправочник = Ложь Тогда
				Набор = РегистрыСведений.уб_ФайлыКПолисам.СоздатьНаборЗаписей();
				Набор.Отбор.УИД.Установить(ТекущаяСтрока.СсылкаСправочника);
				Набор.Прочитать();
				Если Набор.Количество() = 1 Тогда
					Для каждого МЗ Из Набор  Цикл
						МЗ.Размещен = Ложь;
					КонецЦикла;
					Набор.Записать();
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли Колонка.Имя = "Опубликован" Тогда
		ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);
		Массив = Документ.СписокФайлов.НайтиСтроки(Отбор);
		Если Массив.Количество()>0 тогда
			Строка = Массив[0];
			Строка.Опубликован = ТекущаяСтрока.Опубликован;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


Процедура ПриВыводеСтроки(ОформлениеСтроки,ДанныеСтроки,ПараметрыВывода = Неопределено) Экспорт
	Если ЗначениеЗаполнено(ДанныеСтроки.СсылкаСправочника) Тогда 
		//Если ДанныеСтроки.СсылкаСправочника.Страхователь = ИнойСтрахователь Тогда 
		//	ОформлениеСтроки.ЦветТекста = WebЦвета.ТемноФиолетовый;
		//КонецЕсли;
		
		Если ДанныеСтроки.Размещен Тогда
			ОформлениеСтроки.Шрифт = Новый Шрифт(,,Истина);
		КонецЕсли;
		Если НЕ ПараметрыВывода = Неопределено Тогда
			Если ПараметрыВывода.Свойство("СтраховойПолисНомер") = Ложь Тогда
				ПараметрыВывода.Вставить("СтраховойПолисНомер","");
			КонецЕсли;
			Если ПараметрыВывода.Свойство("ВидГруппировки") = Ложь Тогда
				ПараметрыВывода.Вставить("ВидГруппировки",0);
			КонецЕсли;
			ЭтотПолис = ПустаяСтрока(ДанныеСтроки.СтраховойПолисНомер) или ДанныеСтроки.СтраховойПолисНомер=ПараметрыВывода.СтраховойПолисНомер;
			ОформлениеСтроки.Ячейки.Имя.УстановитьТекст(ДанныеСтроки.Имя + ?(ЭтотПолис,"", " ("+СокрЛП(ДанныеСтроки.СтраховойПолисНомер)+")"));	
			Если Не ЭтотПолис Тогда
				Если НЕ ДанныеСтроки.Размещен Тогда //Неразмещенные из других документов не показываем
					ОформлениеСтроки.ЦветТекста = Новый Цвет (90,90,90);
				КонецЕсли;
			Иначе
				Если ПараметрыВывода.ВидГруппировки = 1 и ДанныеСтроки.Уровень()=0 Тогда //Полис
					ОформлениеСтроки.Шрифт = Новый Шрифт(,,Истина);
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;	
	Иначе
		//Выводится родитель группировки
		Если НЕ ПараметрыВывода = Неопределено Тогда
			Если ПараметрыВывода.Свойство("ВидГруппировки") = Ложь Тогда
				ПараметрыВывода.Вставить("ВидГруппировки",0);
			КонецЕсли;
			ЭтотПолис = ПустаяСтрока(ДанныеСтроки.СтраховойПолисНомер) или ДанныеСтроки.СтраховойПолисНомер=ПараметрыВывода.СтраховойПолисНомер;
			Если ЭтотПолис Тогда
				Если ПараметрыВывода.ВидГруппировки = 1 и ДанныеСтроки.Уровень()=0 Тогда //Полис
					ОформлениеСтроки.Шрифт = Новый Шрифт(,,Истина);
				КонецЕсли;	
			КонецЕсли;
			//ОформлениеСтроки.ЦветФона = Новый Цвет(245,242,221);
			ОформлениеСтроки.ЦветФона = Новый Цвет(204,192,133);
			ОформлениеСтроки.Шрифт  = Новый Шрифт(ОформлениеСтроки.Шрифт,,10);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

	   
	
Функция ГенерацияСпискаФайлов(какДерево =  Ложь) Экспорт
	Если какДерево =  Истина Тогда 
		СписокФайлов = Новый ДеревоЗначений;
	Иначе	
		СписокФайлов = Новый ТаблицаЗначений;
	КонецЕсли;	
	
	СписокФайлов.Колонки.Добавить("Размещен");
	СписокФайлов.Колонки.Добавить("Имя");
	СписокФайлов.Колонки.Добавить("ДатаПубликации");
	СписокФайлов.Колонки.Добавить("Опубликован");
	СписокФайлов.Колонки.Добавить("СсылкаСправочника");	
	СписокФайлов.Колонки.Добавить("ПолноеИмя");
	СписокФайлов.Колонки.Добавить("СтраховательИной");
	СписокФайлов.Колонки.Добавить("ОбъектСтрахования");
	СписокФайлов.Колонки.Добавить("ВидФайлаB2B");
	СписокФайлов.Колонки.Добавить("СтраховойПолис");
	СписокФайлов.Колонки.Добавить("СтраховойПолисНомер");
	//
	СписокФайлов.Колонки.Добавить("ВидДокумента",Новый ОписаниеТипов("СправочникСсылка.уб_ВидыДокументовКПолисам"));
	СписокФайлов.Колонки.Добавить("Архив");
	Возврат СписокФайлов;
КонецФункции

Функция СинхронизацияПубликации(СписокФайлов) Экспорт
	какСправочник = ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА;
	Если какСправочник = Ложь Тогда
		Для каждого ТекущаяСтрока из СписокФайлов Цикл
			Набор = РегистрыСведений.уб_ФайлыКПолисам.СоздатьНаборЗаписей();
			Набор.Отбор.УИД.Установить(ТекущаяСтрока.СсылкаСправочника);
			Набор.Прочитать();
			Если Набор.Количество() = 1 Тогда
				//Если файл в документе есть, то должен быть опубликован в регистре
				Для каждого МЗ Из Набор  Цикл
					Если Не МЗ.Размещен = Истина Тогда
						МЗ.Размещен = Истина;
						Набор.Записать();
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
КонецФункции	

Функция ДоступностьДействийМеню(Меню) экспорт
	
	Доступные = "ДобавитьФайл, ПроверитьПутьКФайлам, ПечатьДокументов, Действие, Действие1, "
	+?(уб_Кэшируемые.ДоступностьРоли("ПолныеПрава"),"СкопироватьПутьКФайлуВБуферОбмена,СкопироватьПутьККаталогуВБуферОбмена,","")
	+?(уб_Кэшируемые.ДоступностьРоли("уб_МенеджерНаТочке,уб_СотрудникОтделаБСО"),"СохранитьКак,","")
	+?(уб_Кэшируемые.ДоступностьРоли("ПолныеПрава"),"СохранитьКак,УдалитьФайл,Скопировать,","")
	+?(уб_Кэшируемые.ДоступностьРоли("ПолныеПрава")и ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА, "МенюФайловОткрытьСправочник,","");
	Для каждого Действие Из Меню Цикл
		Попытка
			Доступность = Найти(Доступные,Действие.Имя+",")>0;	
			Действие.Доступность = Доступность;		
		Исключение
		КонецПопытки;
		
	КонецЦикла;
КонецФункции

Функция ВидыДокументовКПолисам()  Экспорт
	Запрос = Новый Запрос;
	Запрос.текст = "ВЫБРАТЬ
	               |	виды.Ссылка
	               |ИЗ
	               |	Справочник.уб_ВидыДокументовКПолисам КАК виды
	               |ГДЕ
	               |	виды.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ виды.Наименование ПОДОБНО ""я%""
	               |	И виды.НеИспользуется = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	виды.Наименование";
	Сз = Новый СписокЗначений;
	Сз.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат СЗ;
КонецФункции	


