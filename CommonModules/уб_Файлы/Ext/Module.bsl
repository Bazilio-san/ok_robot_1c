	                              |			И (&ПоказыватьДСП = ИСТИНА
	                              |				ИЛИ (уб_ФайлыКПолисам.Размещен = ИСТИНА
	                              |					ИЛИ НЕ(уб_ФайлыКПолисам.ВидФайлаB2B = ЗНАЧЕНИЕ(Перечисление.уб_ВидыФайловB2B.ДСП)
	                              |							И уб_ФайлыКПолисам.СтраховойПолис <> &Ссылка)))
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                              |			СписокФайлов.СсылкаСправочника КАК СсылкаСправочника,
	                              |			СписокФайлов.ДатаПубликации КАК ДатаПубликации,
	                              |			СписокФайлов.Размещен КАК Размещен,
	                              |			СписокФайлов.Опубликован КАК Опубликован
	                              |		ИЗ
	                              |			Документ.уб_СтраховойПолис.СписокФайлов КАК СписокФайлов
	                              |		ГДЕ
	                              |			СписокФайлов.Ссылка = &Ссылка
	                              |			И 1 = 1) КАК ПолисДатаРазм
	                              |		ПО ЗаписьСправочник.УИД = ПолисДатаРазм.СсылкаСправочника
	                              |
	                              |СГРУППИРОВАТЬ ПО
	                              |	уб_ФайлыКПолисам.УИД,
	                              |	уб_ФайлыКПолисам.ВидФайлаB2B,
	                              |	уб_ФайлыКПолисам.ФайлИмя,
	                              |	уб_ФайлыКПолисам.Хранилище.Путь,
	                              |	уб_ФайлыКПолисам.ПутьКПапке,
	                              |	уб_ФайлыКПолисам.Страхователь,
	                              |	уб_ФайлыКПолисам.Размещен,
								  |	уб_ФайлыКПолисам.Архив,
	                              |	уб_ФайлыКПолисам.СтраховойПолис,
	                              |	ЗаписьСправочник.ОбъектСтрахования,
	                              |	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Номер, """"),
	                              |	ЕСТЬNULL(ПолисДатаРазм.ДатаПубликации, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)),
	                              |	ВЫБОР
	                              |		КОГДА ЗаписьСправочник.ОбъектСтрахования = &ОбъектСтрахования
	                              |			ТОГДА ИСТИНА
	                              |		ИНАЧЕ ЛОЖЬ
	                              |	КОНЕЦ,
	                              |	ВЫБОР
	                              |		КОГДА &ВсеОбъекты = ИСТИНА
	                              |				ИЛИ уб_ФайлыКПолисам.ВидДокумента.НеСвязанСОбъектомСтрахования = ИСТИНА
	                              |			ТОГДА ИСТИНА
	                              |		ИНАЧЕ ВЫБОР
	                              |				КОГДА ЗаписьСправочник.ОбъектСтрахования = &ОбъектСтрахования
	                              |					ТОГДА ИСТИНА
	                              |				ИНАЧЕ ЛОЖЬ
	                              |			КОНЕЦ
	                              |	КОНЕЦ,
	                              |	уб_ФайлыКПолисам.ВидДокумента
								  |Упорядочить по Выбор Когда уб_ФайлыКПолисам.ВидДокумента = Значение(Справочник.уб_ВидыДокументовКПолисам.ПустаяСсылка) Тогда Ложь Иначе Истина Конец УБЫВ,ЕСТЬNULL(ПолисДатаРазм.ДатаПубликации, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) убыв";
								  
	ЗапросФайлов.Текст = СтрЗаменить(ЗапросФайлов.Текст,"Документ.уб_СтраховойПолис.СписокФайлов","Документ."+ВидДокумента+".СписокФайлов");
