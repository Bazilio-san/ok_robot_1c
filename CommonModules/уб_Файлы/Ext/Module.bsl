 
//Событие выбор в форме списка
Процедура ВыборВСписке(ВыбраннаяСтрока,СтандартнаяОбработка,Форма,ИмяКолонки = "") Экспорт
	СтандартнаяОбработка = ЛОЖЬ;
	Если ИмяКолонки = "СтраховойПолисНомер" и ЗначениеЗаполнено(ВыбраннаяСтрока.СтраховойПолис) Тогда
		//
		Попытка
			ВыбраннаяСтрока.СтраховойПолис.ПолучитьФорму().Открыть();	
		Исключение
		КонецПопытки;
		
	Иначе
		Если НЕ ВыбраннаяСтрока.ПолноеИмя = Неопределено тогда
			уб_СЛ.ОповещениеФормыПросмотра(ВыбраннаяСтрока.ПолноеИмя, Форма, Форма);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ОбработкаВыбораДляСписка(ВыбранноеЗначение,эуСписокФайлов) Экспорт
	// Вставить содержимое обработчика.
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Предупреждение("Не выбран полис");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	УстановитьПривилегированныйРежим(Истина);
	
	обПолис = ВыбранноеЗначение.ПолучитьОбъект();
	ВыделенныеСтроки = эуСписокФайлов.ВыделенныеСтроки;
	Для Каждого Строка Из ВыделенныеСтроки Цикл 
		СтрокаФайлов = обПолис.СписокФайлов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФайлов, Строка);
		СтрокаФайлов.Размещен = ИСТИНА;
		СтрокаФайлов.Опубликован = СтрокаФайлов.СсылкаСправочника.Опубликован;
		СтрокаФайлов.ДатаПубликации = ТекущаяДата();
	КонецЦикла;
	
	КоличествоФайловКПолису = обПолис.ПолучитьКоличествоФайловКПолису();
	
	Если КоличествоФайловКПолису = обПолис.КоличествоФайловB2B Тогда
	Иначе
		обПолис.КоличествоФайловB2B =  КоличествоФайловКПолису;
	КонецЕсли;
	
	//запись при открытой форме приводит к несоответствию объекта версии конфы
	обПолис.ОбменДанными.Загрузка = Истина;
	обПолис.Записать();
	обПолис.ОбменДанными.Загрузка = ЛОЖЬ;
	
	Предупреждение("Файл(ы) скопированы в полис", 3);
	
	ЗафиксироватьТранзакцию();
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры


//мСписокФайлов-ТаблицаЗначений,СписокФайлов - ТЧ документа, эуСписокФайлов - табличное поле
Процедура ОбновитьСписок(пСписокФайлов,Документ,эуСписокФайлов,эуИнфо,ПараметрыОбновления = Неопределено,ВидДокумента = "уб_СтраховойПолис",ТекстОтборПоТЧ="1 = 1") Экспорт
	
	Если ПараметрыОбновления=Неопределено Тогда
		ПараметрыОбновления = Новый Структура;
		ПараметрыОбновления.Вставить("ПоказыватьВсе",Истина);
		ПараметрыОбновления.Вставить("ИнойСтрахователь",Неопределено);
		ПараметрыОбновления.Вставить("ПоказыватьДСП",Ложь);
		ПараметрыОбновления.Вставить("ВидГруппировки",0);
		ПараметрыОбновления.Вставить("ОбъектСтрахования",Неопределено);
		ПараметрыОбновления.Вставить("ВсеОбъекты",Истина);
		ПараметрыОбновления.Вставить("ФильтроватьВиды",Ложь);
		ПараметрыОбновления.Вставить("ВсеПоСтрахователю",Истина);
		ПараметрыОбновления.Вставить("ФильтроватьАрхив",Истина);
		
	Иначе
		//Дополнение отсутствующих
		Если ПараметрыОбновления.Свойство("ПоказыватьВсе") = Ложь Тогда
			ПараметрыОбновления.Вставить("ПоказыватьВсе",Истина);
		КонецЕсли;	
		Если ПараметрыОбновления.Свойство("ИнойСтрахователь") = Ложь Тогда
			ПараметрыОбновления.Вставить("ИнойСтрахователь",Неопределено);
		КонецЕсли;		
		Если ПараметрыОбновления.Свойство("ПоказыватьДСП") = Ложь Тогда
			ПараметрыОбновления.Вставить("ПоказыватьДСП",Ложь);
		КонецЕсли;		
		Если ПараметрыОбновления.Свойство("ВидГруппировки") = Ложь Тогда
			ПараметрыОбновления.Вставить("ВидГруппировки",0);
		КонецЕсли;		
		Если ПараметрыОбновления.Свойство("ОбъектСтрахования") = Ложь Тогда
			ПараметрыОбновления.Вставить("ОбъектСтрахования",Неопределено);
		КонецЕсли;
		Если ПараметрыОбновления.Свойство("ВсеОбъекты") = Ложь Тогда
			ПараметрыОбновления.Вставить("ВсеОбъекты", Истина);
		КонецЕсли;
		Если ПараметрыОбновления.Свойство("ФильтроватьВиды") = Ложь Тогда
			ПараметрыОбновления.Вставить("ФильтроватьВиды", Ложь);
		КонецЕсли;
		
		Если ПараметрыОбновления.Свойство("ВсеПоСтрахователю") = Ложь Тогда
			ПараметрыОбновления.Вставить("ВсеПоСтрахователю",Истина);
		КонецЕсли;
		
		Если ПараметрыОбновления.Свойство("ФильтроватьАрхив") = Ложь Тогда
			ПараметрыОбновления.Вставить("ФильтроватьАрхив",Истина);
		КонецЕсли;	
		
	КонецЕсли;
	
	тзСписокФайлов = ГенерацияСпискаФайлов();
	
	какСправочник = ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА;
	
	СписокФайлов  = Документ.СписокФайлов;
	Ссылка        = Документ.Ссылка;
	Страхователь  = Документ.Страхователь; 
	Попытка
		ОбъектСтрахования = Документ.ОбъектСтрахования	
	Исключение
		ОбъектСтрахования = Справочники.уб_ОбъектыСтрахования.ПустаяСсылка();
	КонецПопытки;
	
	Если НЕ эуСписокФайлов.ТекущаяСтрока = Неопределено тогда
		мПозиционирование = эуСписокФайлов.ТекущаяСтрока.СсылкаСправочника;
	Иначе
		мПозиционирование = Неопределено;
	КонецЕсли;
	ПозиционированиеСтрока = Неопределено;
	
	мСтрахователь = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ПараметрыОбновления.ИнойСтрахователь) Тогда 
		мСтрахователь.Добавить(ПараметрыОбновления.ИнойСтрахователь);
	КонецЕсли;
	
	мПусто = Новый СписокЗначений;
	мПусто.Добавить(Справочники.ФизическиеЛица.ПустаяСсылка());
	мПусто.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	мПусто.Добавить(Неопределено);
	
	Отбор = Новый Структура;
	Отбор.Вставить("СсылкаСправочника",); 
	Если ТекстОтборПоТЧ="1 = 1" Тогда
	Иначе
		Если Найти(ТекстОтборПоТЧ,"УидСтроки")>0 Тогда
			Отбор.Вставить("УидСтроки",Сред(ТекстОтборПоТЧ,Найти(ТекстОтборПоТЧ,"=""")+2,36)); 
		КонецЕсли;	
	КонецЕсли;	
	Текст = "";
	ЗапросФайлов = Новый Запрос;
	
	//TODO реализовать по другому
	//Если ПоказыватьВсе = Истина тогда					
	//	ТекстПоОбъекту = "ВЫБОР
	//	|КОГДА уб_ФайлыКПолисам.ВидДокумента.НеСвязанСОбъектомСтрахования
	//	|	ТОГДА ИСТИНА
	//	|ИНАЧЕ уб_ФайлыКПолисам.ОбъектСтрахования = &ОбъектСтрахования
	//	|КОНЕЦ";
	//	ЗапросФайлов.УстановитьПараметр("ОбъектСтрахования", ОбъектСтрахования);
	//	эуИнфоЗаголовок = "Отбор по Объекту страхования";
	//Иначе 
		ТекстПоОбъекту = "2 = 2";
		эуИнфоЗаголовок = "Нет отбора по Объекту страхования";		
	//КонецЕсли;
	
	Если не эуИнфо = Неопределено Тогда
		эуИнфо.Заголовок = эуИнфоЗаголовок;
	КонецЕсли;
	
	Если какСправочник Тогда
		ВТ = "ВЫБРАТЬ
		     |	СписокФайлов.СсылкаСправочника КАК УИД,
		     |	ВЫБОР
		     |		КОГДА СписокФайлов.СсылкаСправочника.ОбъектСтрахования ЕСТЬ NULL 
		     |			ТОГДА ВЫБОР
		     |					КОГДА НЕ СписокФайлов.Ссылка ССЫЛКА Документ.уб_СтраховойПолис
		     |						ТОГДА ЗНАЧЕНИЕ(Справочник.уб_ОбъектыСтрахования.ПустаяСсылка)
		     |					ИНАЧЕ СписокФайлов.Ссылка.ОбъектСтрахования
		     |				КОНЕЦ
		     |		ИНАЧЕ СписокФайлов.СсылкаСправочника.ОбъектСтрахования
		     |	КОНЕЦ КАК ОбъектСтрахования
		     |ПОМЕСТИТЬ ВТ_Файлы
		     |ИЗ
		     |	Документ.уб_СтраховойПолис.СписокФайлов КАК СписокФайлов
		     |ГДЕ
		     |	СписокФайлов.Ссылка = &Ссылка
		     |	И 1 = 1
		     |
		     |ОБЪЕДИНИТЬ ВСЕ
		     |
		     |ВЫБРАТЬ
		     |	уб_ФайлыКПолисам.Ссылка,
		     |	уб_ФайлыКПолисам.ОбъектСтрахования
		     |ИЗ
		     |	Справочник.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		     |ГДЕ
		     |	уб_ФайлыКПолисам.Архив = ЛОЖЬ
		     |	И уб_ФайлыКПолисам.Страхователь В(&Страхователь)
		     |	И НЕ уб_ФайлыКПолисам.Страхователь В (&ПустойСправочник)
		     |	И 2 = 2
		     |
		     |ОБЪЕДИНИТЬ ВСЕ
		     |
		     |ВЫБРАТЬ
		     |	уб_ФайлыКПолисам.Ссылка,
		     |	уб_ФайлыКПолисам.ОбъектСтрахования
		     |ИЗ
		     |	Справочник.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		     |ГДЕ
		     |	уб_ФайлыКПолисам.Страхователь В(&ИнойСтрахователь)
		     |	И ВЫБОР
		     |			КОГДА &ФильтроватьАрхив = ИСТИНА
		     |					И уб_ФайлыКПолисам.Архив = ИСТИНА
		     |				ТОГДА ЛОЖЬ
		     |			ИНАЧЕ ИСТИНА
		     |		КОНЕЦ
		     |	И НЕ уб_ФайлыКПолисам.Страхователь В (&ПустойСправочник)"
		 Иначе
			 
		ВТ = "ВЫБРАТЬ
		     |	СписокФайлов.СсылкаСправочника КАК УИД,
		     |	ВЫБОР
		     |		КОГДА СписокФайлов.СсылкаСправочника.ОбъектСтрахования ЕСТЬ NULL 
		     |			ТОГДА ВЫБОР
		     |					КОГДА ТИПЗНАЧЕНИЯ(СписокФайлов.Ссылка) = ТИП(Документ.уб_СтраховойПолис)
		     |						ТОГДА СписокФайлов.Ссылка.ОбъектСтрахования
			 |					КОГДА 8 = 9
			 |		                ТОГДА 989
		     |					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.уб_ОбъектыСтрахования.ПустаяСсылка)
		     |				КОНЕЦ
		     |		ИНАЧЕ СписокФайлов.СсылкаСправочника.ОбъектСтрахования
		     |	КОНЕЦ КАК ОбъектСтрахования
		     |ПОМЕСТИТЬ ВТ_Файлы
		     |ИЗ
		     |	Документ.уб_СтраховойПолис.СписокФайлов КАК СписокФайлов
		     |ГДЕ
		     |	СписокФайлов.Ссылка = &Ссылка
		     |	И 1 = 1
		     |
			 |ОБЪЕДИНИТЬ ВСЕ
		     |
		     |ВЫБРАТЬ
		     |	уб_ФайлыКПолисам.УИД,
		     |	ВЫБОР
		     |		КОГДА уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования ЕСТЬ NULL 
		     |			ТОГДА ЗНАЧЕНИЕ(Справочник.уб_ОбъектыСтрахования.ПустаяСсылка)
		     |		ИНАЧЕ уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования
		     |	КОНЕЦ
		     |ИЗ
		     |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		     |ГДЕ
		     |	
		     |	 уб_ФайлыКПолисам.УИД В (&УИДЫ)
		     |	И 5 = 5
		     |ОБЪЕДИНИТЬ ВСЕ
		     |
		     |ВЫБРАТЬ
		     |	уб_ФайлыКПолисам.УИД,
		     |	ВЫБОР
		     |		КОГДА уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования ЕСТЬ NULL 
		     |			ТОГДА ЗНАЧЕНИЕ(Справочник.уб_ОбъектыСтрахования.ПустаяСсылка)
		     |		ИНАЧЕ уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования
		     |	КОНЕЦ
		     |ИЗ
		     |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		     |ГДЕ
		     |	ВЫБОР
		     |			КОГДА &ФильтроватьАрхив = ИСТИНА
		     |					И уб_ФайлыКПолисам.Архив = ИСТИНА
		     |				ТОГДА ЛОЖЬ
		     |			ИНАЧЕ ИСТИНА
		     |		КОНЕЦ
		     |	И уб_ФайлыКПолисам.Страхователь В(&Страхователь)
		     |	И НЕ уб_ФайлыКПолисам.Страхователь В (&ПустойСправочник)
		     |	И 2 = 2
		     |
		     |ОБЪЕДИНИТЬ ВСЕ
		     |
		     |ВЫБРАТЬ
		     |	уб_ФайлыКПолисам.УИД,
		     |	ВЫБОР
		     |		КОГДА уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования ЕСТЬ NULL 
		     |			ТОГДА ЗНАЧЕНИЕ(Справочник.уб_ОбъектыСтрахования.ПустаяСсылка)
		     |		ИНАЧЕ уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования
		     |	КОНЕЦ
		     |ИЗ
		     |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		     |ГДЕ
		     |	уб_ФайлыКПолисам.Страхователь В(&ИнойСтрахователь)
		     |	И ВЫБОР
		     |			КОГДА &ФильтроватьАрхив = ИСТИНА
		     |					И уб_ФайлыКПолисам.Архив = ИСТИНА
		     |				ТОГДА ЛОЖЬ
		     |			ИНАЧЕ ИСТИНА
		     |		КОНЕЦ
		     |	И НЕ уб_ФайлыКПолисам.Страхователь В (&ПустойСправочник)"
		 КонецЕсли;
	ЗапросФайлов.УстановитьПараметр("ФильтроватьАрхив",ПараметрыОбновления.ФильтроватьАрхив);
	
	Если Найти(ТекстОтборПоТЧ,"УидСтроки")>0 Тогда
		//чтобы включить вновь добавленные, но еще не записанные		
		ЗапросФайлов.УстановитьПараметр("УИДЫ",Документ.СписокФайлов.Выгрузить(Новый Структура("УидСтроки",Отбор.УидСтроки)).ВыгрузитьКолонку("СсылкаСправочника"));
	Иначе
		ЗапросФайлов.УстановитьПараметр("УИДЫ",Новый Массив);
	КонецЕсли;	
		
	
	ЗапросФайлов.Текст = ВТ+" ; "+"ВЫБРАТЬ
	                              |	уб_ФайлыКПолисам.УИД КАК СсылкаСправочника,
	                              |	ЕСТЬNULL(ПолисДатаРазм.ДатаПубликации, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаПубликации,
	                              |	уб_ФайлыКПолисам.ВидФайлаB2B КАК ВидФайлаB2B,
	                              |	уб_ФайлыКПолисам.ФайлИмя КАК Имя,
	                              |	уб_ФайлыКПолисам.Хранилище.Путь КАК ХранилищеПуть,
	                              |	уб_ФайлыКПолисам.ПутьКПапке КАК ПутьКПапке,
	                              |	уб_ФайлыКПолисам.Страхователь КАК Страхователь,
	                              |	уб_ФайлыКПолисам.Размещен КАК Опубликован,
								  |	уб_ФайлыКПолисам.Архив КАК Архив,
	                              |	уб_ФайлыКПолисам.СтраховойПолис КАК СтраховойПолис,
	                              |	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Номер, """") КАК СтраховойПолисНомер,
	                              |	ВЫБОР
	                              |		КОГДА ЗаписьСправочник.ОбъектСтрахования = &ОбъектСтрахования
	                              |			ТОГДА ИСТИНА
	                              |		ИНАЧЕ ЛОЖЬ
	                              |	КОНЕЦ КАК ЭтотОбъект,
	                              |	ЗаписьСправочник.ОбъектСтрахования,
	                              |	ВЫБОР
	                              |		КОГДА &ВсеОбъекты = ИСТИНА
	                              |				ИЛИ уб_ФайлыКПолисам.ВидДокумента.НеСвязанСОбъектомСтрахования = ИСТИНА
	                              |			ТОГДА ИСТИНА
	                              |		ИНАЧЕ ВЫБОР
	                              |				КОГДА ЗаписьСправочник.ОбъектСтрахования = &ОбъектСтрахования
	                              |					ТОГДА ИСТИНА
	                              |				ИНАЧЕ ЛОЖЬ
	                              |			КОНЕЦ
	                              |	КОНЕЦ КАК УсловноЭтотОбъект,
	                              |	уб_ФайлыКПолисам.ВидДокумента
	                              |ИЗ
	                              |	(ВЫБРАТЬ
								  |    ВТ_Файлы.УИД КАК УИД,
								  |    МАКСИМУМ(ВТ_Файлы.ОбъектСтрахования) КАК ОбъектСтрахования
								  |  ИЗ
								  |	   ВТ_Файлы КАК ВТ_Файлы
								  |
								  |СГРУППИРОВАТЬ ПО
