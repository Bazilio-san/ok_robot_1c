				ТЧСтрокаДокумента.Размещен = ИСТИНА;
				ТЧСтрокаДокумента.СсылкаСправочника = Выборка.СсылкаСправочника;
				ТЧСтрокаДокумента.Опубликован = Выборка.Опубликован;
				//Попытка
				//	ТЧСтрокаДокумента.Архив = Выборка.Архив;				
				//Исключение
				//КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОбновления.ПоказыватьВсе = Ложь и УжеРазмещен = Ложь Тогда
