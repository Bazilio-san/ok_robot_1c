	ФильтроватьВиды = ПараметрыОбновления.ФильтроватьВиды<>Ложь;
	
	АвтоРазмещение = ТипЗнч(Ссылка) = Тип("ДокументСсылка.уб_СтраховойПолис");  
	Выборка = ЗапросФайлов.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, Выборка);
		Массив = СписокФайлов.НайтиСтроки(Отбор);
		
		УжеРазмещен = Массив.Количество()>0;
		Если УжеРазмещен = Ложь и ФильтроватьВиды = Истина Тогда
			Если ПараметрыОбновления.ФильтроватьВиды.Найти(Выборка.ВидДокумента) = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
