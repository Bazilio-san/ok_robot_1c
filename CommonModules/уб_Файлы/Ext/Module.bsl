	ЗапросФайлов.УстановитьПараметр("ВсеОбъекты", ПараметрыОбновления.ВсеОбъекты);
	ЗапросФайлов.УстановитьПараметр("ОбъектСтрахования", ПараметрыОбновления.ОбъектСтрахования);
