Процедура Уведомление(Сообщение,КогоУведомить,Заявка,ВЗаголовок ="") Экспорт
	//	ЗаписатьОшибкуИСообщить(Сообщение);
	МЗ =  РегистрыСведений.уб_Чат_Сообщения.СоздатьМенеджерЗаписи();
	МЗ.Отправитель = ПараметрыСеанса.ТекущийПользователь;
	//
	ЗаполнитьПолучателяПоЗаявке(МЗ,КогоУведомить,Заявка);
	
	МЗ.ИДСообщения = Строка(Новый УникальныйИдентификатор);
	МЗ.Заголовок = "" + СтрЗаменить(Заявка.Номер,Символ(160),"")+" "+ВЗаголовок;
	МЗ.Сообщение = Сообщение;
	МЗ.Период = ТекущаяДата();
	МЗ.Вложения = СформироватьХранилищеТЗПОСсылке (Заявка);
	МЗ.ЕстьВложения = Истина;
	МЗ.НеОтображатьНаWeb = Истина;
	Если НЕ ЗначениеЗаполнено(МЗ.Получатель) И СокрЛП(МЗ.ИмяКанала)="" Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не получилось определить получателя для заявки: "+Заявка+" "+КогоУведомить);
	Иначе	
		МЗ.Записать();
	КонецЕсли;	
	
	//МЗ2 = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьМенеджерЗаписи();
	//МЗ2.Период = МЗ.Период;
	//МЗ2.ИДСообщения = МЗ.ИДСообщения;
	//МЗ2.Пользователь = МЗ.Получатель;
	//МЗ2.Отправитель = МЗ.Отправитель;
	//МЗ2.Записать();
	ОповеститьДляСервера("Консоль","Создано уведомление для «"+КогоУведомить+"» с текстом «"+Сообщение+"»");
КонецПроцедуры	

Функция СформироватьХранилищеТЗПОСсылке(Ссылка)
	
	ТЗ = Новый ТаблицаЗначений;
	
	ТЗ.Колонки.Добавить("Ссылка");
	ТЗ.Колонки.Добавить("ТипСсылки");
	
	НСтрока = ТЗ.Добавить();
	НСтрока.Ссылка 		= Ссылка;
	НСтрока.ТипСсылки 	= Строка(ТипЗнч(Ссылка));
	
	Хранилище = Новый ХранилищеЗначения(ЗначениеВСтрокуВнутр(ТЗ));
	
	Возврат Хранилище;
	
КонецФункции

Функция ВернутьСсылкуИзХранилища(Хранилище) Экспорт
	
	ЗначениеВнутр  = Хранилище.Получить();
	
	Результат = Неопределено;
	
	ТЗ = ЗначениеИзСтрокиВнутр(ЗначениеВнутр);
	
	Если ЗначениеВнутр = Неопределено Тогда
	Иначе
		Если ТипЗнч(ТЗ) = Тип("ТаблицаЗначений") Тогда
			Если ТЗ.Количество()>0 Тогда
				Результат =  ТЗ[0].Ссылка;
			КонецЕсли;	
		Конецесли;	
	Конецесли;	
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьПолучателяПоЗаявке(МЗ,КогоУведомить,Заявка)
	МЗ.ИмяКанала = КогоУведомить; 
	МЗ.Получатель = Справочники.Пользователи.ПустаяСсылка();
	Если КогоУведомить = "Менеджер" ИЛИ КогоУведомить = "ВажноМенеджер" Тогда
		МЗ.Получатель = ПолучитьПользователяДляФизическогоЛица(Заявка.Менеджер);
	ИначеЕсли КогоУведомить = "Курьер" ИЛИ КогоУведомить = "ВажноКурьер" Тогда
		Если Заявка.Самовыезд Тогда
			МЗ.Получатель = ПолучитьПользователяДляФизическогоЛица(Заявка.Менеджер);
		Иначе
			МЗ.Получатель = ПолучитьПользователяДляФизическогоЛица(Заявка.Курьер);
		КонецЕсли;	
	ИначеЕсли КогоУведомить = "РСВС" ИЛИ КогоУведомить = "ВажноРСВС" Тогда	
		МЗ.Получатель = ПолучитьПользователяДляФизическогоЛица(ПолучитьРуководителяСВС(Заявка.Курьер));
	Конецесли;	
КонецПроцедуры	

Функция ПолучитьПользователяДляФизическогоЛица(ФизЛицо) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизЛицо = &ФизЛицо");
	Запрос.УстановитьПараметр("ФизЛицо",ФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции	

// Только для "Управление брокером"
// Функция пытается выйти на самый ранний документ структуры
Функция ПолучитьИзначальныйДокумент (ТекущийДокумент, ТипТекущего = Неопределено)   Экспорт
	
	Если ТипТекущего = Неопределено Тогда
		ТипТекущего = ТипЗНЧ (ТекущийДокумент);
	КонецЕсли;	
	Если ТипТекущего = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтруктураПодчиненности.Ссылка
		|ИЗ
		|	КритерийОтбора.СтруктураПодчиненности(&ОплатаПолиса) КАК СтруктураПодчиненности
		|ГДЕ
		|	СтруктураПодчиненности.Ссылка ССЫЛКА Документ.уб_ПриемкаОплат");
		Запрос.УстановитьПараметр("ОплатаПолиса",ТекущийДокумент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			//Возврат Выборка.Ссылка;
			///РЕКУРСИЯ///
			Возврат ПолучитьИзначальныйДокумент(Выборка.Ссылка);
		КонецЕсли;	
	ИначеЕсли ТипТекущего = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтруктураПодчиненности.Ссылка
		|ИЗ
		|	КритерийОтбора.СтруктураПодчиненности(&СП) КАК СтруктураПодчиненности
		|ГДЕ
		|	СтруктураПодчиненности.Ссылка ССЫЛКА Документ.уб_ОплатаПолисов");
		Запрос.УстановитьПараметр("СП",ТекущийДокумент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество()>= 1 Тогда
			Выборка.Следующий();
			///РЕКУРСИЯ///
			Возврат ПолучитьИзначальныйДокумент(Выборка.Ссылка);
		КонецЕсли;		
	ИначеЕсли ТипТекущего = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда	
		ТекущийДокументСозданНаОсновании = ТекущийДокумент.СозданНаосновании;
		Если ЗначениеЗаполнено(ТекущийДокументСозданНаОсновании) Тогда
			//
			///РЕКУРСИЯ///
			Возврат ПолучитьИзначальныйДокумент(ТекущийДокументСозданНаОсновании);
		КонецЕсли;	
	ИначеЕсли ТипТекущего = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда	
		ТекущийДокументСозданНаОсновании = ТекущийДокумент.СозданНаосновании;
		Если ЗначениеЗаполнено(ТекущийДокументСозданНаосновании) Тогда
			//
			///РЕКУРСИЯ///
			Возврат ПолучитьИзначальныйДокумент(ТекущийДокументСозданНаОсновании);
		КонецЕсли;
	ИначеЕсли ТипТекущего = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда	
		ТекущийДокументСозданНаОсновании = ТекущийДокумент.СозданНаосновании;
		Если ЗначениеЗаполнено(ТекущийДокументСозданНаосновании) Тогда
			//
			///РЕКУРСИЯ///
			Возврат ПолучитьИзначальныйДокумент(ТекущийДокументСозданНаОсновании);
		КонецЕсли;
	КонецЕсли;
	Возврат ТекущийДокумент;
	
КонецФункции	

//В зависимости от доступных ролей, руководства отделом, работы в опред. подразделении определяет Роль 
Функция ПолучитьРольПользователяДляЗаявок(СтаршегоКакМенеджера = Истина, КакМассив = Ложь, ЭтоРуководитель = Неопределено) Экспорт
	
	Перем Параметры;
	
	Если КакМассив Тогда
		МассивРолей = Новый Массив;
		Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.УправлениеСтатусамиЗаявок, Ложь) Тогда
			//Руководители
			МассивРолей.Добавить("ПолныеПрава");
		КонецЕсли;
		Если ПараметрыСеанса.уб_ЭтоМенеджер Тогда
			МассивРолей.Добавить("Менеджер");//добавляем базовую роль
			Если ЭтоРуководитель = Неопределено Тогда
				уб_СС.ПодчиненныеРуководителя(,, Параметры);
				ЭтоРуководитель = Параметры.ЭтоРуководитель
			Иначе
				
			КонецЕсли;
			//
			Если ЭтоРуководитель Тогда
				МассивРолей.Добавить("СтаршийМенеджер");
			КонецЕсли;
		КонецЕсли;
		
		Если уб_Кэшируемые.СписокКонтролеров(Истина).Найти(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено Тогда
			МассивРолей.Добавить("Контроль");
		КонецЕсли;
		
		Если ПолучитьРуководителейСВС().Найти(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.КураторВыездных, Ложь) Тогда
			МассивРолей.Добавить("РСВС");
		КонецЕсли;
		
		Если Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокОператоров().Найти(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено Тогда
			МассивРолей.Добавить("Печать");
		ИначеЕсли уб_КЭШируемые.ДоступностьРоли("уб_СотрудникОтделаБСО") 
			И Не уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.НеОткрыватьСтатусыПриЗапуске, Ложь) 
			Тогда
			//Если уб_СС.ПолучитьПодразделениеАгента(ПараметрыСеанса.уб_ТекущееФизЛицо) = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО Тогда
			МассивРолей.Добавить("сБСО"); 	
			МассивРолей.Добавить("Кассир");
			МассивРолей.Добавить("ФинОтветственный");
		КонецЕсли;
		
		
		ПарСВС = уб_РасчетыСМенеджерами.ПараметрыСВС(ПараметрыСеанса.уб_ТекущееФизЛицо,ТекущаяДата());
		Если ПарСВС.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВС или ПарСВС.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя Тогда
			МассивРолей.Добавить("Курьер");	
		КонецЕсли;
		// бухгалтерии тоже требуется доступ в области БСО. Отображается для тех, у кого при запуске 1с запускаются статусы (теперь андеррайтерам не будут доступны статусы)
				
		Результат = МассивРолей;
	Иначе	
		Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.УправлениеСтатусамиЗаявок, Ложь) Тогда
			//Руководители
			Результат = "ПолныеПрава"
		ИначеЕсли уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.КураторВыездных, Ложь) Тогда
			Результат = "РСВС"
			//нет роли "Курьер"	
			//ИначеЕсли РольДоступна("уб_Курьер") Тогда
			//	Возврат "Курьер"	
		ИначеЕсли ПараметрыСеанса.уб_ЭтоМенеджер Тогда
			Если СтаршегоКакМенеджера Тогда
				Результат = "Менеджер"
			Иначе
				уб_СС.ПодчиненныеРуководителя(,, Параметры);
				Результат = ?(Параметры.ЭтоРуководитель, "СтаршийМенеджер", "Менеджер");
			КонецЕсли;
			//ИначеЕсли ПараметрыСеанса.уб_ТекущееФизЛицо = ПолучитьРуководителяСВС() Тогда
		ИначеЕсли Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокОператоров().Найти(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено Тогда
			Результат = "Печать"; 	
		ИначеЕсли уб_СС.ПолучитьПодразделениеАгента(ПараметрыСеанса.уб_ТекущееФизЛицо) = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО Тогда
			Результат = "сБСО" 	
			//ИначеЕсли уб_КЭШируемые.ДоступностьРоли("уб_Кассир") Тогда
			//	Результат = "Кассир"	
			//ИначеЕсли уб_КЭШируемые.ДоступностьРоли("уб_ФинансовыйАналитик, ПолныеПрава, уб_Бухгалтер") Тогда
			//	Результат = "ФинОтветственный"		
		Иначе
			Результат = "НеИзвестнаяРоль"	
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

//Получение руководителя СВС
Функция ПолучитьРуководителяСВС(Курьер) Экспорт
	
	//Возврат уб_СтраховойБрокер.ПолучитьРуководителяПодразделения(, ПараметрыСеанса.уб_Константы.уб_ПодразделениеСВС).Сотрудник;
	//Возврат уб_СС.РуководительПодразделения(ПараметрыСеанса.уб_Константы.уб_ПодразделениеСВС);
	Параметры = уб_СС.СтруктураПараметровФункцииПодчиненныеРуководителяПоУмолчанию();
	Параметры.ВключаяВыбывших		= Истина;
	//Параметры.ТолькоТочкиПродаж		= Истина;
	//Курьер = Справочники.ФизическиеЛица.НайтиПоНаименованию("Валяев Алексей");
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(Курьер);
	Параметры.СотрудникиПоДокументу = СЗ;
	уб_СС.ПодчиненныеРуководителя(Курьер,, Параметры);
	Возврат Параметры.РуководительСотрудника;
	
КонецФункции	

Функция ПолучитьРуководителейСВС() Экспорт
	
	//Возврат уб_СтраховойБрокер.ПолучитьРуководителяПодразделения(, ПараметрыСеанса.уб_Константы.уб_ПодразделениеСВС).Сотрудник;
	Массив = Новый Массив;
	Для каждого Подразделение из ПолучитьПодразделенияВС() Цикл
		рук = уб_СС.РуководительПодразделения(Подразделение);
