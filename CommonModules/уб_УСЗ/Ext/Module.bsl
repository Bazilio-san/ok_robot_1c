//Функция получает таблицу сообщений каналов Важно%
Функция ПолучитьВажныеСообщения ()
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_Чат_НепрочитанныеСообщенияСрезПоследних.Период,
	|	уб_Чат_НепрочитанныеСообщенияСрезПоследних.ИДСообщения,
	|	уб_Чат_НепрочитанныеСообщенияСрезПоследних.Пользователь,
	|	уб_Чат_НепрочитанныеСообщенияСрезПоследних.Отправитель,
	|	уб_Чат_СообщенияСрезПоследних.Заголовок,
	|	уб_Чат_СообщенияСрезПоследних.Сообщение,
	|	уб_Чат_СообщенияСрезПоследних.ЕстьВложения,
	|	уб_Чат_СообщенияСрезПоследних.Вложения,
	|	уб_Чат_СообщенияСрезПоследних.ИмяКанала
	|ИЗ
	|	РегистрСведений.уб_Чат_НепрочитанныеСообщения.СрезПоследних КАК уб_Чат_НепрочитанныеСообщенияСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_Чат_Сообщения.СрезПоследних КАК уб_Чат_СообщенияСрезПоследних
	|		ПО уб_Чат_НепрочитанныеСообщенияСрезПоследних.ИДСообщения = уб_Чат_СообщенияСрезПоследних.ИДСообщения
	|ГДЕ
	|	уб_Чат_СообщенияСрезПоследних.ИмяКанала ПОДОБНО ""Важно%""");
	ТаблицаВажных = Запрос.Выполнить().Выгрузить();						  
	ТаблицаВажных.Колонки.Добавить("Заявка");
	ТаблицаВажных.Колонки.Добавить("Учтена");
	Для каждого СтрокаТЗ из ТаблицаВажных Цикл
		СтрокаТЗ.Заявка  = ВернутьСсылкуИзХранилища(СтрокаТЗ.Вложения);
		СтрокаТЗ.Учтена = Ложь;
	КонецЦикла;	
	Возврат ТаблицаВажных;
	
КонецФункции	

//Процедура проверяет отсутствие сообщения по заявке в канале и выводит его
Процедура УведомлениеСПроверкой(
	Сообщение, 
	КогоУведомить, 
	Заявка, 
	Знач ТаблицаСообщений, 
	ВЗаголовок = ""
	)
	
	СтруктураПоиска = Новый Структура("ИмяКанала, Заявка", КогоУведомить, Заявка);
	МассивСтрок =  ТаблицаСообщений.НайтиСтроки(СтруктураПоиска);
	ВсегоСтрок = МассивСтрок.Количество();
	Если ВсегоСтрок = 0 Тогда
		//По данной заявке уведомлений нет, отправляем
		Уведомление(Сообщение, КогоУведомить, Заявка, ВЗаголовок);
	Иначе
		Для Счетчик = 0 по ВсегоСтрок - 1 Цикл
			текСтрока = МассивСтрок[Счетчик];
			текСтрока.Учтена = Истина;
		КонецЦикла	
	Конецесли;
	
КонецПроцедуры	

