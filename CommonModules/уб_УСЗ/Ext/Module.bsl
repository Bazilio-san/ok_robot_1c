		Попытка
			ЗначениеКолонки = ВыбраннаяСтрока[ИмяКолонки];
			ТипЗначения = ТипЗнч(ЗначениеКолонки);
			Если НЕ ТипЗначения  = Тип("Число") 
				И НЕ ТипЗначения = Тип("Строка") 
				И НЕ ТипЗначения = Тип("Дата") 
				И НЕ ТипЗначения = Тип("Булево") 
				И НЕ Метаданные.Документы.Найти(ЗначениеКолонки.Метаданные().Имя) = Неопределено Тогда				
				ЗначениеКолонки.ПолучитьФорму().Открыть();
				СтандартнаяОбработка = Ложь;
			КонецЕсли;	
		Исключение
			Возврат;
		КонецПопытки;
	#КонецЕсли
	
Конецпроцедуры	

//по любой таблице, имеющей ВидБСО и НомерБСО, определяет связанные заявки с флагом Требуется возврат БСО или нет
//выполняется раза в три дольше чем функция по отдельной заявке ПолучитьТаблицуБСОПоЗаявке
Функция ТребуетсяВозвратБСОПоСсылке(Ссылка, ТипРезультата = "тз", Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = СтруктураПараметровДляТребуетсяВозвратБСО(ТипЗнч(Ссылка));
	КонецЕсли;
	ТипРезультата = Лев(НРег(СокрЛП(ТипРезультата)), 3);
	Запрос = Новый Запрос;
	ТекстЗапроса =
	//"ВЫБРАТЬ
	//|	МАКСИМУМ(ДБ.Период) КАК Период
	//|ПОМЕСТИТЬ ВТ_ПериодРегистратора
	//|ИЗ
	//|	РегистрСведений.уб_ДвиженияБСО КАК ДБ
	//|ГДЕ
	//|	ДБ.Регистратор = &Ссылка
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	"ВЫБРАТЬ
	|	Источник.ВидБСО КАК ВидБСО,
	|	Источник.НомерБСО КАК НомерБСО,
	|	&ТекстДляЗаявки КАК Заявка
	|ПОМЕСТИТЬ ВТ_Документ
	|ИЗ
	|	&Источник КАК Источник
	|ГДЕ
	|	Источник.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДБ.Заявка КАК Заявка
	|ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	ВТ_Документ КАК ВТ_Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО КАК ДБ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				МАКСИМУМ(ДБ.Период) КАК Период
	|			ИЗ
	|				РегистрСведений.уб_ДвиженияБСО КАК ДБ
	|			ГДЕ
	|				ДБ.Регистратор = &Ссылка) КАК ВТ_ПериодРегистратора
	|			ПО (ИСТИНА)
	|		ПО ВТ_Документ.ВидБСО = ДБ.ВидБСО
	|			И ВТ_Документ.НомерБСО = ДБ.НомерБСО
	|			И (ДБ.Заявка <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка))
	|			И (ВТ_ПериодРегистратора.Период >= ДБ.Период)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Документ.Заявка
	|ИЗ
	|	ВТ_Документ КАК ВТ_Документ
	|ГДЕ
	|	ВТ_Документ.Заявка <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДБ.СК,
	|	ДБ.ВидБСО,
	|	ДБ.НомерБСО,
	|	ДБ.Заявка
	|ПОМЕСТИТЬ СписокДвижений
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО КАК ДБ
	|		ПО (ДБ.Заявка = ВТ_Заявки.Заявка)
	|ГДЕ
	|	ДБ.Подтверждено
	|	И ДБ.Активность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОБ.СК,
	|	ОБ.ВидБСО,
	|	ОБ.Заявка
	|ПОМЕСТИТЬ СписокОстатков
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.уб_ОстаткиБСО КАК ОБ
	|		ПО (ОБ.Заявка = ВТ_Заявки.Заявка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ОБ.Регистратор) КАК Регистратор,
	|	ОБ.СК,
	|	ОБ.ВидБСО
	|ПОМЕСТИТЬ ПослДвижение
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.уб_ОстаткиБСО КАК ОБ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокОстатков КАК СписокОстатков
	|			ПО ОБ.СК = СписокОстатков.СК
	|				И ОБ.ВидБСО = СписокОстатков.ВидБСО
	|		ПО (ОБ.Заявка = ВТ_Заявки.Заявка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОБ.СК,
	|	ОБ.ВидБСО,
	|	ОБ.Заявка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДБ.Заявка,
	|	ВЫБОР
	|		КОГДА ДБ.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданНаТочку)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяВозвратБСО,
	|	ДБ.ВидБСО,
	|	ДБ.НомерБСО
	|ПОМЕСТИТЬ ВТ_Срез
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО.СрезПоследних(, Подтверждено) КАК ДБ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокДвижений КАК Список
	|			ПО ДБ.ВидБСО = Список.ВидБСО
	|				И ДБ.НомерБСО = Список.НомерБСО
	|				И ДБ.СК = Список.СК
	|		ПО ВТ_Заявки.Заявка = ДБ.Заявка
	|ГДЕ
	|	&УсловиеГдеДвиженияБСО
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОБ.Заявка,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА ОБ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА ОБ.Количество
	|				ИНАЧЕ -ОБ.Количество
	|			КОНЕЦ = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ОБ.ВидБСО,
	|	""""
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.уб_ОстаткиБСО КАК ОБ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПослДвижение КАК ПослДвижение
	|			ПО ОБ.Регистратор = ПослДвижение.Регистратор
	|		ПО ВТ_Заявки.Заявка = ОБ.Заявка
	|ГДЕ
	|	&УсловиеГдеОстаткиБСО";
	Если Параметры.ПолучитьТаблицуБСО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_Срез", "");
	Иначе
		ТекстЗапроса = ТекстЗапроса + " 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Заявки.Заявка КАК Заявка,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВТ_Срез.Заявка ЕСТЬ NULL 
		|				ИЛИ НЕ ВТ_Срез.ТребуетсяВозвратБСО
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ) КАК ТребуетсяВозвратБСО
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Срез КАК ВТ_Срез
		|		ПО ВТ_Заявки.Заявка = ВТ_Срез.Заявка
		|
		|СГРУППИРОВАТЬ ПО 
		|	ВТ_Заявки.Заявка";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Источник", 		Параметры.Источник);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстДляЗаявки",	Параметры.ТекстДляЗаявки);
	УсловиеГдеДвиженияБСО 	= ?(Параметры.ПоВсемСтатусам, "ИСТИНА", "ДБ.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданНаТочку)");
	УсловиеГдеОстаткиБСО	= ?(Параметры.ПоВсемСтатусам, "ИСТИНА", 
	"ВЫБОР
	|			КОГДА ОБ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОБ.Количество
	|			ИНАЧЕ -ОБ.Количество
	|		КОНЕЦ = 0");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГдеДвиженияБСО",	УсловиеГдеДвиженияБСО);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГдеОстаткиБСО",	УсловиеГдеОстаткиБСО);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если Параметры.Установить И Не Параметры.ПолучитьТаблицуБСО Тогда
		СписокОбработанныхЗаявок = Новый СписокЗначений;
		Роль = уб_УСЗ.ПолучитьРольПользователяДляЗаявок();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если уб_УСЗ.ВыполнитьДействиеПоЗаявке(
				Выборка.Заявка,
				,
				"ПроверитьБСО",
				,
				Роль,
				,
				Выборка.ТребуетсяВозвратБСО
				)
				Тогда
				СписокОбработанныхЗаявок.Добавить(Выборка.Заявка);
			КонецЕсли;
		КонецЦикла;
		#Если Клиент Тогда
		Если СписокОбработанныхЗаявок.Количество() > 0 Тогда
			Оповестить("уб_СтатусыЗаявокОбновитьСписки", СписокОбработанныхЗаявок, Параметры.ИмяОбъекта)
		КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	Если Параметры.ПолучитьТаблицуБСО Тогда
		Параметры.ТаблицаБСО = РезультатЗапроса.Выгрузить();
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("Заявка");
		Результат.Колонки.Добавить("ТребуетсяВозвратБСО");
		Для Каждого СтрокаТЗ Из Параметры.ТаблицаБСО Цикл
			Если ЗначениеЗаполнено(СтрокаТЗ.Заявка) Тогда
				СтрокаТЗРез = Результат.Найти(СтрокаТЗ.Заявка);
				Если СтрокаТЗРез = Неопределено Тогда
					СтрокаТЗРез = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТЗРез, СтрокаТЗ);
				ИначеЕсли Не СтрокаТЗРез.ТребуетсяВозвратБСО Тогда
					ЗаполнитьЗначенияСвойств(СтрокаТЗРез, СтрокаТЗ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипРезультата = "тз" Тогда
		Результат = РезультатЗапроса.Выгрузить();
	ИначеЕсли ТипРезультата = "рез" Тогда
		Результат = РезультатЗапроса;
	ИначеЕсли ТипРезультата = "выб" Тогда
		Результат = РезультатЗапроса.Выбрать();
	ИначеЕсли ТипРезультата = "соо" Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Результат = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Заявка, Выборка.ТребуетсяВозвратБСО);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ТребуетсяВозвратБСОПоСсылке()

Функция СтруктураПараметровДляТребуетсяВозвратБСО(ТипЗнч) Экспорт

	Структура = Новый Структура;
	Структура.Вставить("Источник",				"");
	Структура.Вставить("ТекстДляЗаявки",		"NULL");
	Структура.Вставить("Установить",			Истина);
	Структура.Вставить("ИмяОбъекта",			"");
	Структура.Вставить("ПоВсемСтатусам",		Ложь);
	Структура.Вставить("ПолучитьТаблицуБСО",	Ложь);
	Структура.Вставить("ТаблицаБСО",			Новый ТаблицаЗначений);
	Если ТипЗнч = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
		Структура.ИмяОбъекта		= "Документ.уб_ПеремещениеБСО";
		Структура.Источник			= Структура.ИмяОбъекта + ".БСО";
		Структура.ТекстДляЗаявки 	= "Источник.ЗаявкаКуда";
		Структура.Установить		= Ложь;
	ИначеЕсли ТипЗнч = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
		Структура.ИмяОбъекта		= "Документ.уб_СтраховойПолис";
		Структура.Источник			= Структура.ИмяОбъекта + ".БСО";
		Структура.ТекстДляЗаявки	= "Источник.Ссылка.Заявка";
	ИначеЕсли ТипЗнч = Тип("ДокументСсылка.уб_УведомлениеПоставщикаОбУтратеБСО") Тогда
		Структура.ИмяОбъекта		= "Документ.уб_УведомлениеПоставщикаОбУтратеБСО";
		Структура.Источник			= Структура.ИмяОбъекта + ".БСО";
	ИначеЕсли ТипЗнч = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда
		Структура.ИмяОбъекта		= "Документ.уб_ПриемкаОплат";
		Структура.Источник			= Структура.ИмяОбъекта + ".Полисы";
		Структура.ТекстДляЗаявки	= "Источник.Заявка";
		Структура.ПоВсемСтатусам	= Истина;
		//для приемки требуется проверка по видам и номерам БСО
		Структура.ПолучитьТаблицуБСО = Истина;
		Структура.Установить		= Ложь;
	КонецЕсли;
	Возврат Структура;

КонецФункции // СтруктураПараметровДляТребуетсяВозвратБСО()


Функция ЗапросПоБСО(Заявка)
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.СК,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидСП,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.СтраховаяПремия,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ИтогСтраховаяПремия,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ИтогПредоставленнаяСкидка,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ФормаОплаты,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидРодителя,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидСтроки,
	                |	ВЫБОР
	                |		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидРодителя = """"  или уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидРодителя=уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидСтроки
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК ЭтоКорень,
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ОрганизацияАгент
	                |ИЗ
	                |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
	                |ГДЕ
	                |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка = &Ссылка
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЭтоКорень УБЫВ";
	 Запрос.УстановитьПараметр("Ссылка",Заявка);
	 Возврат Запрос.Выполнить().Выгрузить();
 КонецФункции	
 Функция ЗапросПоБСОВМассив(Заявка) Экспорт
	Возврат уб_СЕРВЕРные.ТаблицаЗначенийВМассив(ЗапросПоБСО(Заявка));
КонецФункции	

//неактуальна, замена ТребуетсяВозвратБСОПоСсылке()
//Процедура ПроверитьНеобходимостьВозвратаПоСвязаннымЗаявкам(Ссылка) Экспорт
//	
//	Попытка
//		ТипСсылки = ТипЗнч(Ссылка);
