//Процедура проверяет заявки запросом к временной таблице в переданном запросе, на соответствие 
//временным и другим показателям, добавляет уведомления в таблицы «Важно» заинтересованным лицам

Процедура ЗапуститьПроверку() Экспорт
	
	ПроверитьЗаявки();
	
КонецПроцедуры	

Процедура ПроверитьЗаявки(Запрос = Неопределено) Экспорт
	//
	Если Запрос = Неопределено Тогда
		//Производим основной запрос
		Запрос = Новый Запрос();
		Запрос.Текст = ПолучитьТекстОсновногоЗапроса();					  
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Выполнить();
	КонецЕсли;	
	
	//Выполняем подзапрос
	Запрос.Текст = "Выбрать * из СтатусыЗаявок ГДЕ НЕ ((СтатусыЗаявок.СтатусЗаявки = Значение(Перечисление.уб_СтатусыЗаявок.ДеньгиВКомпании)ИЛИ СтатусыЗаявок.СтатусЗаявки = Значение(Перечисление.уб_СтатусыЗаявок.ЗаявкаОтработана)) И НЕ СтатусыЗаявок.ТребуетсяВозвратБСО=ИСТИНА) ";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Статусы  = Перечисления.уб_СтатусыЗаявок;
	//ОповеститьДляСервера("Консоль","Получено "+выборка.Количество()+" заявок для проверки.");
	ТаблицаВажныхСообщений = ПолучитьВажныеСообщения();
	ДатаПроверки = ТекущаяДата();
	Пока Выборка.Следующий() Цикл
		Разница = ДатаПроверки - Выборка.Период;
		РазницаВЧасах = Окр(Разница/3600,1);
		РазницаВДнях = Окр(РазницаВЧасах/24,1);
		Заявка = Выборка.Заявка;
		Если Выборка.СтатусЗаявки  = Статусы.СтраховкаСостоялась Тогда
			//получитьПредыдущий
			ПредСтатус = ВернутьСтатусЗаявки (Выборка.Заявка,Выборка.Период-1);
			КонтрольныйПериод = 24;
			Представление = "Комплект документов не сдан после заключения страховки!";
			Если ПредСтатус = Статусы.КомплектНаХраненииВБухгалтерии Тогда
				КонтрольныйПериод = 1;
				Представление = "Комплект документов не сдан после получения с хранения.";
			КонецЕсли;	
			Если РазницаВЧасах >= КонтрольныйПериод Тогда
				УведомлениеСПроверкой(Представление,"ВажноРСВС",Заявка,ТаблицаВажныхСообщений,"Не сданы деньги"+"#"+Выборка.Период);
				Если (РазницаВЧасах - КонтрольныйПериод)>=24 Тогда
					//Второй уровень информирования
					УведомлениеСПроверкой(Представление,"ВажноМенеджер",Заявка,ТаблицаВажныхСообщений,"Не сданы деньги"+"#"+Выборка.Период);
					УведомлениеСПроверкой(Представление,"ВажноПолныеПрава",Заявка,ТаблицаВажныхСообщений,"Не сданы деньги"+"#"+Выборка.Период);
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли Выборка.СтатусЗаявки  = Статусы.СтраховкаНеСостоялась Тогда	
			//получитьПредыдущий
			ПредСтатус = ВернутьСтатусЗаявки (Выборка.Заявка,Выборка.Период-1);
			КонтрольныйПериод = 24;
			Представление = "Не все БСО сданы по несостоявшейся страховке";
			Если ПредСтатус = Статусы.КомплектНаХраненииВБухгалтерии Тогда
				КонтрольныйПериод = 1;
				Представление = "Комплект документов не сдан после получения с хранения.";
			КонецЕсли;	
			Если РазницаВЧасах >= КонтрольныйПериод Тогда
				УведомлениеСПроверкой(Представление,"ВажноРСВС",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
				Если (РазницаВЧасах - КонтрольныйПериод)>=24 Тогда
					//Второй уровень информирования
					УведомлениеСПроверкой(Представление,"ВажноМенеджер",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
					УведомлениеСПроверкой(Представление,"ВажноПолныеПрава",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли Выборка.СтатусЗаявки  = Статусы.КомплектНаХраненииВБухгалтерии Тогда		
			//
			Если РазницаВДнях >= 7  Тогда
				УведомлениеСПроверкой("Истек срок хранения комплекта документов!","ВажноФинОтветственный",Заявка,ТаблицаВажныхСообщений,"На хранении 7 дней"+"#"+Выборка.Период);
				УведомлениеСПроверкой("Истек срок хранения комплекта документов!","ВажноРСВС",Заявка,ТаблицаВажныхСообщений,"На хранении 7 дней"+"#"+Выборка.Период);
				Если РазницаВДнях >= 8 Тогда
					//Второй уровень информирования
					УведомлениеСПроверкой("Истек срок хранения комплекта документов!","ВажноПолныеПрава",Заявка,ТаблицаВажныхСообщений,"На хранении 7 дней"+"#"+Выборка.Период);
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли Выборка.СтатусЗаявки  = Статусы.КомплектИДеньгиУКассира Тогда			
			//Скомпоновать все заявки по одному отчету кассира?
			Если РазницаВЧасах >= 24 Тогда
				УведомлениеСПроверкой("Не проверен отчет кассира!","ВажноФинОтветственный",Заявка,ТаблицаВажныхСообщений,"Проверка отчета кассира"+"#"+Выборка.Период);
				Если РазницаВЧасах >= 48 Тогда
					//Второй уровень информирования
					УведомлениеСПроверкой("Не проверен отчет кассира!","ВажноПолныеПрава",Заявка,ТаблицаВажныхСообщений,"Проверка отчета кассира"+"#"+Выборка.Период);
				КонецЕсли;	
			КонецЕсли;	
			
		ИначеЕсли (Выборка.СтатусЗаявки  = Статусы.ДеньгиВКомпании ИЛИ Выборка.СтатусЗаявки  = Статусы.ЗаявкаОтработана) И Выборка.ТребуетсяВозвратБСО=ИСТИНА Тогда			
			Если РазницаВЧасах >= 24 Тогда
				УведомлениеСПроверкой("Не все БСО сдано!","ВажносБСО",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
			КонецЕсли;	
		ИначеЕсли Выборка.ТребуетсяВозвратБСО=ИСТИНА Тогда
			Если РазницаВЧасах >= 24 Тогда
				УведомлениеСПроверкой("Не сдано БСО! Превышен срок нахождения в данном статусе: "+Выборка.СтатусЗаявки+" !","ВажносБСО",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
				Если РазницаВЧасах >= 48 Тогда
					//Второй уровень информирования
					УведомлениеСПроверкой("Не сдано БСО! Превышен срок нахождения в данном статусе: "+Выборка.СтатусЗаявки+" !","ВажноПолныеПрава",Заявка,ТаблицаВажныхСообщений,"Не сдано БСО"+"#"+Выборка.Период);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	//Оставшиеся удаляются из непрочитанных
	Для каждого СтрокаТЗ из ТаблицаВажныхСообщений Цикл
		Если Не СтрокаТЗ.учтена Тогда
			НачатьТранзакцию();
			
			НЗ = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();	
			НЗ.Отбор.ИДСообщения.Установить(СтрокаТЗ.ИДСообщения);
			Попытка
				НЗ.Очистить();
				НЗ.Записать();
			Исключение
				ОтменитьТранзакцию();
				//Возможно заблокирована/удалена пользователем попытаемся при следующей проверке
				Продолжить;
			КонецПопытки;	
			//Выборка = РегистрыСведений.уб_Чат_Сообщения.Выбрать (,,Новый Структура("ИДСообщения",СтрокаТЗ.ИДСообщения));
			//Пока Выборка.Следующий() Цикл
			//	МЗ = Выборка.ПолучитьМенеджерЗаписи();
			//	МЗ.ДатаОбновления = ТекущаяДата();
			//	МЗ.Записать();
			//КонецЦикла;	
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;	
	КонецЦикла;	
	//Уведомление("Важный тест","ВажноРСВС",Заявка);
	//Заявка = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка();
	//Уведомление("Важный тест","ВажносБСО",Заявка);
КонецПроцедуры	

