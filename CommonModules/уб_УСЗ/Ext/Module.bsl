Функция ПолучитьПодразделенияВС(ТипПодразделения = Неопределено,КакСтруктура = Ложь) Экспорт
	ТипыПодразделений =  Новый Массив;
	Если ТипПодразделения = Неопределено Тогда
		ТипыПодразделений.Добавить(Перечисления.уб_ТипПодразделения.СлужбаВС);
		ТипыПодразделений.Добавить(Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя);
	Иначе
		ТипыПодразделений.Добавить(ТипПодразделения);
	КонецЕсли;	
	
    Возврат  ПолучитьПодразделениеПоТипам(ТипыПодразделений,КакСтруктура)
	
КонецФункции	

Функция ПолучитьПодразделениеПоТипам(Типы,КакСтруктура=Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПодразделенияОрганизаций.Ссылка,
	               |	ПодразделенияОрганизаций.ТипПодразделения
	               |ИЗ
	               |	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	               |ГДЕ
	               |	ПодразделенияОрганизаций.ТипПодразделения В(&ТипыПодразделений)
	               |	И ПодразделенияОрганизаций.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПодразделенияОрганизаций.Наименование";
	Запрос.УстановитьПараметр("ТипыПодразделений",Типы);
	Если КакСтруктура Тогда
		Результат = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("Ссылка,ТипПодразделения",Выборка.Ссылка,Выборка.ТипПодразделения));	
		КонецЦикла;	
	Иначе	
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;	
	Возврат Результат;
КонецФункции	
	

//Проверка доступности действия для роли
