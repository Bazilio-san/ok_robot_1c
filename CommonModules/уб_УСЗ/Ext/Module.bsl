Функция ДействиеКлиентское(Действие) Экспорт
	Если Действие = "ПоказатьТаблицуБСО"
		ИЛИ Действие = "ВнестиИзменения"
		ИЛИ Действие = "СтруктураПодчиненности"
		ИЛИ Действие = "ПоказатьТаблицуБСО"
		ИЛИ Действие = "ИсторияЗаявки"
		ИЛИ Действие = "СоздатьПриемкуОплат"
		//ИЛИ Действие = "ПроверитьПеремещения"
		ИЛИ Действие = "СоздатьПеремещениеБСО"
		Тогда
		Возврат Истина
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	

//пока неактуальна
Функция СоответствиеДействийИСтатусов() Экспорт

	Пер = Перечисления.уб_СтатусыЗаявок;
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("УстановитьСтатус_БСОНаРукахУКурьера", 	Пер.БСОНаРукахУКурьера);
	Соответствие.Вставить("УстановитьСтатус_ДеньгиВКомпании",		Пер.ДеньгиВКомпании);

КонецФункции // СоответствиеДействийИСтатусов()

//порядок отправляется в форму документа заявки
Функция ВернутьСтатусЗаявки(Заявка, ДатаСреза = Неопределено,Структура  = Неопределено) Экспорт 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СЗ.Заявка,
	|	СЗ.Статус,
	|	СЗ.Период КАК ДатаСтатуса,
	|	СЗ.Статус.Порядок КАК СтатусПорядок
	|ИЗ
	|	РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних(&ДатаСреза, Заявка = &Заявка) КАК СЗ");
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Если ДатаСреза = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДатаСреза","");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Статус;
		Структура = Новый Структура;
		Структура.Вставить("Заявка",Выборка.Заявка);
		Структура.Вставить("Статус",Выборка.Статус);
		Структура.Вставить("ДатаСтатуса",Выборка.ДатаСтатуса);
		Структура.Вставить("СтатусПорядок",Выборка.СтатусПорядок);
	Иначе	
		Результат = Перечисления.уб_СтатусыЗаявок.ПустаяСсылка();
		Структура = Новый Структура;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции	

