//Преобразование 
Функция ПредставлениеКонтрольнойДаты(Разница) Экспорт
	
	РазницаДней = Цел(Разница / (60 * 60 * 24));
	ЦелыхДней 	= Цел(РазницаДней);
	ПредставлениеКонтрольнойДаты ="";
	Если РазницаДней > 5 Тогда
		ПредставлениеКонтрольнойДаты = "" + ЦелыхДней+" дн ";
	Иначе
		РазницаЧасов = Цел(Разница / (60 * 60));
		Если РазницаЧасов >= 1 Тогда
			РазницаЧасов = Цел(РазницаЧасов) - ЦелыхДней * 24;
			ПредставлениеКонтрольнойДаты = "" + ?(ЦелыхДней=0,"",""+ЦелыхДней +" дн. ")+?(РазницаЧасов<9," "+РазницаЧасов,РазницаЧасов)+" ч";
		Иначе	
			//Минуты
			РазницаМинут = Цел(Разница/60);
			ПредставлениеКонтрольнойДаты = "" + РазницаМинут+" мин.";
		КонецЕсли;
	Конецесли;	
	Возврат ПредставлениеКонтрольнойДаты;
	
КонецФункции	

Функция ЕстьПеремещениеПоЗаявке(Заявка, ПроверятьСостав = Истина, Список = Неопределено) Экспорт
	
	//пустые заявки не нужны, пусть берутся только с данными
	Запрос = Новый Запрос;
	Если ПроверятьСостав и ТипЗнч(Заявка) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	П.Ссылка
		|ИЗ
		|	Документ.уб_ПеремещениеБСО.БСО КАК П
		|ГДЕ
		|	П.ЗаявкаКуда = &СозданНаОсновании
		|	И НЕ П.Ссылка.ПометкаУдаления";
	Иначе	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	П.Ссылка
		|ИЗ
		|	Документ.уб_ПеремещениеБСО КАК П
		|ГДЕ
		|	П.СозданНаОсновании = &СозданНаОсновании
		|	И НЕ П.ПометкаУдаления";
	КонецЕсли;
	Запрос.УстановитьПараметр("СозданНаОсновании", Заявка);
	Результат = Запрос.Выполнить();
	Список = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Не Результат.Пустой();
	
КонецФункции	

