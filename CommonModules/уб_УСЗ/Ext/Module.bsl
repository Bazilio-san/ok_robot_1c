	//
	//ПолныеПрава,Менеджер,РСВС,Курьер,сБСО,Кассир,ФинОтветственный,НеИзвестнаяРоль
	Доступно = Ложь;
	Если Роль = "ПолныеПрава" Тогда
		Доступно =  Истина;
	Иначе
		Если Роль = "Менеджер" Тогда
			Доступные = "
				|ВнестиИзменения,
				//	|УстановитьПредыдущийСтатус,
				|УстановитьСтатус_ЗапросНаУдаление,
				//|УстановитьСтатус_НазначениеКурьера,
				//|УстановитьСтатус_СогласованиеСКлиентом,
				//|УстановитьСтатус_СогласованиеСКлиентом_Доработка,
				//|УстановитьСтатус_СтраховкаНеСостоялась,
				//|УстановитьСтатус_СтраховкаСостоялась,
				//|УстановитьСтатус_ЗаявкаОтработана,
				|УстановитьСтатус_ФормированиеКомплектаБСО,
