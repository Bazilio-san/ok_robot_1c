	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	МАКСИМУМ(уб_ОстаткиБСО.Регистратор) КАК Регистратор,
	//|	уб_ОстаткиБСО.СК,
	//|	уб_ОстаткиБСО.ВидБСО
	//|ПОМЕСТИТЬ ПослДвижение
	//|ИЗ
	//|	РегистрНакопления.уб_ОстаткиБСО КАК уб_ОстаткиБСО
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокОстатков КАК СписокОстатков
	//|		ПО уб_ОстаткиБСО.СК = СписокОстатков.СК
	//|			И уб_ОстаткиБСО.ВидБСО = СписокОстатков.ВидБСО
	//|ГДЕ
	//|	уб_ОстаткиБСО.Заявка = &Заявка
	//|
	//|СГРУППИРОВАТЬ ПО
	//|	уб_ОстаткиБСО.СК,
	//|	уб_ОстаткиБСО.ВидБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	уб_ДвиженияБСОСрезПоследних.Период КАК Период,
	|	уб_ДвиженияБСОСрезПоследних.СК КАК СК,
	|	уб_ДвиженияБСОСрезПоследних.ВидБСО КАК ВидБСО,
	|	уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип КАК ТипБСО,
	|	уб_ДвиженияБСОСрезПоследних.НомерБСО КАК НомерБСО,
	|	уб_ДвиженияБСОСрезПоследних.Агент КАК Агент,
	|	уб_ДвиженияБСОСрезПоследних.ПоложениеБСО КАК ПоложениеБСО,
	|	уб_ДвиженияБСОСрезПоследних.СостояниеБСО КАК СостояниеБСО,
	|	1 КАК Количество,
	|	уб_ДвиженияБСОСрезПоследних.Заявка,
	|	уб_ДвиженияБСОСрезПоследних.Заявка.Номер КАК ЗаявкаНомер
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
	|			,
	|			Подтверждено
	|				) КАК уб_ДвиженияБСОСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокДвижений КАК Список
	|		ПО уб_ДвиженияБСОСрезПоследних.ВидБСО = Список.ВидБСО 
	|			И уб_ДвиженияБСОСрезПоследних.НомерБСО = Список.НомерБСО
	|			И уб_ДвиженияБСОСрезПоследних.СК = Список.СК
	|ГДЕ
	|	&УсловиеНомерных";
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	уб_ОстаткиБСО.Период,
	//|	уб_ОстаткиБСО.СК,
	//|	уб_ОстаткиБСО.ВидБСО,
	//|	уб_ОстаткиБСО.ВидБСО.Тип КАК ТипБСО,
	//|	"""",
	//|	уб_ОстаткиБСО.Агент,
	//|	NULL,
	//|	уб_ОстаткиБСО.СостояниеБСО,
	//|	ВЫБОР
	//|		КОГДА уб_ОстаткиБСО.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	//|			ТОГДА уб_ОстаткиБСО.Количество
	//|		ИНАЧЕ -уб_ОстаткиБСО.Количество
	//|	КОНЕЦ,
	//|	уб_ОстаткиБСО.Заявка,
	//|	уб_ОстаткиБСО.Заявка.Номер
	//|ИЗ
	//|	РегистрНакопления.уб_ОстаткиБСО КАК уб_ОстаткиБСО
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПослДвижение КАК ПослДвижение
	//|		ПО уб_ОстаткиБСО.Регистратор = ПослДвижение.Регистратор
	//|ГДЕ
	//|	&УсловиеКоличественных";	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	УсловиеНомерных 		= "";
	УсловиеКоличественных   = "";
	Если Не ПоВсемЗаявкам Тогда
		УсловиеНомерных 		= "уб_ДвиженияБСОСрезПоследних.Заявка = &Заявка";
		УсловиеКоличественных   = "уб_ОстаткиБСО.Заявка = &Заявка";
	КонецЕсли;
	Если Не ПоВсемСтатусам Тогда
		Если УсловиеНомерных <> "" Тогда
			УсловиеНомерных = УсловиеНомерных + " И "
		КонецЕсли;
		УсловиеНомерных = УсловиеНомерных + "уб_ДвиженияБСОСрезПоследних.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданНаТочку)";
		Если УсловиеКоличественных <> "" Тогда
			УсловиеКоличественных = УсловиеКоличественных + " И "
		КонецЕсли;
		УсловиеКоличественных = УсловиеКоличественных + "ВЫБОР
		|		КОГДА уб_ОстаткиБСО.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА уб_ОстаткиБСО.Количество
		|		ИНАЧЕ - уб_ОстаткиБСО.Количество
		|	КОНЕЦ = 0"
	КонецЕсли;
	Если УсловиеНомерных = "" Тогда
		УсловиеНомерных = "ИСТИНА"
	КонецЕсли;
	Если УсловиеКоличественных = "" Тогда
		УсловиеКоличественных = "ИСТИНА"
	КонецЕсли;
	
	//Собственного контрагента исключаем ВСЕГДА (далее функционально?)
	УсловиеНомерных  = УсловиеНомерных + "  и НЕ уб_ДвиженияБСОСрезПоследних.СК=&Служебная ";// И НЕ (уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип=&Карточки) ";
	
	Запрос.УстановитьПараметр("Служебная", ПараметрыСеанса.уб_константы.уб_СобственныйКонтрагент);
	//Запрос.УстановитьПараметр("Карточки", Перечисления.уб_ТипыБСО.Карточка);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНомерных", 		УсловиеНомерных);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеКоличественных",  УсловиеКоличественных);
	Запрос.Текст = ТекстЗапроса;
	
	Данные = Запрос.Выполнить().Выгрузить();
	Если ПоместитьВХранилище = Истина Тогда
		Возврат ПоместитьВоВременноеХранилище(Данные,Новый УникальныйИдентификатор);
	Иначе
		Возврат Данные;
	КонецЕсли	
		
	
	
КонецФункции

//Функция возвращает массив из созданных на основании перемещений и созданных на основании этих перемещений перемещений 
//(без рекурсии)
Функция ВернутьСвязанныеСЗаявкойПеремещения(Заявка,Создать = Ложь,МассивПеремещений = Неопределено) Экспорт
	
	Если МассивПеремещений = Неопределено Тогда
		МассивПеремещений = Новый Массив;
	КонецЕсли;	
	
	ЕстьПеремещениеПоЗаявке(Заявка,, МассивПеремещений);
	Если МассивПеремещений.Количество()=0  и Создать = Истина 
		//и Заявка.Самовыезд = Ложь
		Тогда
		
		Попытка
			Перемещение = Документы.уб_ПеремещениеБСО.СоздатьДокумент();
			Если ТипЗнч(Заявка) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
				Для каждого СтрокаЗ из  Заявка.БСо Цикл
					ТекНомерБСО = ?(ЗначениеЗаполнено(СтрокаЗ.НомерБСО),СтрокаЗ.НомерБСО,СтрокаЗ.ДопНомерБСО);
					Если ЗначениеЗаполнено(ТекНомерБСО) Тогда
						СтрокаБСО = Перемещение.БСО.Добавить();
						СтрокаБСО.СК = СтрокаЗ.СК;
						СтрокаБСО.ВидБСО = СтрокаЗ.ВидБСО;
						СтрокаБСО.НомерБСО =ТекНомерБСО;
						СтрокаБСО.Подтверждено = Истина;
						Данные= ДанныеПоБланку(СтрокаБСО.ВидБСО,ТекНомерБСО);
						СтрокаБСО.Поставщик        = Данные.Поставщик;
						СтрокаБСО.ОрганизацияАгент = Данные.ОрганизацияАгент;
						СтрокаБСО.ЗаявкаОт   = Заявка;
						СтрокаБСО.ЗаявкаКуда = Заявка;
						СтрокаБСО.Количество = 1;
						СтрокаБСО.СостояниеБСО = Перечисления.уб_СостоянияБСО.Оформлен;
						//Поставщик
						Если Перемещение.Дата = Дата(1,1,1) Тогда
							Перемещение.Дата = СтрокаЗ.ДатаДвиженияБСО+1
						КонецЕсли;	
					КонецЕсли; 
				КонецЦикла; 
				Перемещение.Агент = Справочники.ПодразделенияОрганизаций.НайтиПоКоду("000000003");
				Перемещение.АгентКуда = ?(Заявка.Самовыезд,Заявка.Менеджер,Заявка.Курьер);
				Перемещение.Направление = 1;
			ИначеЕсли ТипЗнч(Заявка) = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
				тБСО = Заявка.БСО.Выгрузить();
				тБСО.ЗаполнитьЗначения(Перечисления.уб_СостоянияБСО.Испорчен,"СостояниеБСО");
				Перемещение.БСО.Загрузить(тБСО);
				
				Перемещение.АгентКуда = Заявка.Агент;
				Перемещение.Агент     = Заявка.АгентКуда;
				Перемещение.Направление =-1
			КонецЕсли;
			Если Перемещение.БСО.Количество()>0 Тогда
				Если Перемещение.Дата = Дата(1,1,1) Тогда
					Перемещение.Дата = Заявка.Дата+1;
				КонецЕсли;
				Перемещение.Автор = ПараметрыСеанса.уб_ТекущееФизЛицо;
				Перемещение.ДатаСоздания = ТекущаяДата();
				Перемещение.Модификатор = Перемещение.Автор;
				Перемещение.ДатаИзменения = Перемещение.ДатаСоздания;
				
				//Перемещение.Выдал  = Заявка.Курьер;
				Перемещение.СозданНаОсновании = Заявка;
				
				Перемещение.Комментарий = "При установке статуса";
				Перемещение.Направление = 1;
				Попытка
					Перемещение.Записать(РежимЗаписиДокумента.Запись);
					МассивПеремещений.Добавить(Перемещение.Ссылка);
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки	
				
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;	
	Возврат МассивПеремещений;
	//старый код
	//Если ТолькоНаОсновании Тогда
	//	Запрос  = Новый Запрос("ВЫБРАТЬ
	//	|	уб_ПеремещениеБСО.Ссылка,
	//	|	уб_ПеремещениеБСО.Агент,
	//	|	уб_ПеремещениеБСО.АгентКуда
	//	|ИЗ
	//	|	Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
	//	|ГДЕ
	//	|	уб_ПеремещениеБСО.СозданНаОсновании = &Заявка");
	//Иначе	
	//	Запрос  = Новый Запрос("ВЫБРАТЬ
	//	|	ЕСТЬNULL(уб_ПеремещениеБСО1.Ссылка, уб_ПеремещениеБСО.Ссылка) КАК Ссылка,
	//	|	ВЫБОР
	//	|		КОГДА уб_ПеремещениеБСО1.Ссылка ЕСТЬ NULL 
	//	|			ТОГДА уб_ПеремещениеБСО.Агент
	//	|		ИНАЧЕ уб_ПеремещениеБСО1.Агент
	//	|	КОНЕЦ КАК Агент,
	//	|	ВЫБОР
	//	|		КОГДА уб_ПеремещениеБСО1.Ссылка ЕСТЬ NULL 
	//	|			ТОГДА уб_ПеремещениеБСО.АгентКуда
	//	|		ИНАЧЕ уб_ПеремещениеБСО1.АгентКуда
	//	|	КОНЕЦ КАК АгентКуда
	//	|ИЗ
	//	|	Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
	//	|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО1
	//	|		ПО уб_ПеремещениеБСО.СозданНаОсновании = уб_ПеремещениеБСО1.Ссылка
	//	|ГДЕ
	//	|	уб_ПеремещениеБСО.СозданНаОсновании = &Заявка");
	//Конецесли;					   
	//Запрос.УстановитьПараметр("Заявка",Заявка);						   
	//Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

Функция ДанныеПоБланку(ВидБСО,НомерБСО)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
			|	уб_ДвиженияБСОСрезПоследних.Период,
			|	уб_ДвиженияБСОСрезПоследних.Регистратор,
			|	уб_ДвиженияБСОСрезПоследних.НомерСтроки,
			|	уб_ДвиженияБСОСрезПоследних.Активность,
			|	уб_ДвиженияБСОСрезПоследних.СК,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО,
			|	уб_ДвиженияБСОСрезПоследних.НомерБСО,
			|	уб_ДвиженияБСОСрезПоследних.Поставщик,
			|	уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент,
			|	уб_ДвиженияБСОСрезПоследних.Подтверждено,
			//|	уб_ДвиженияБСОСрезПоследних.ДокПроведен,
			//|	уб_ДвиженияБСОСрезПоследних.Активность Как ДокПроведен,
			|	уб_ДвиженияБСОСрезПоследних.АгентОтправитель,
			|	уб_ДвиженияБСОСрезПоследних.Агент,
			|	уб_ДвиженияБСОСрезПоследних.ПоложениеБСО,
			|	уб_ДвиженияБСОСрезПоследних.СостояниеБСО,
			|	уб_ДвиженияБСОСрезПоследних.НомерПолиса,
			|	уб_ДвиженияБСОСрезПоследних.ГодПолиса,
			|	уб_ДвиженияБСОСрезПоследних.СтраховойПолис,
			|	уб_ДвиженияБСОСрезПоследних.НаОснованииБумажногоДокумента,
			|	уб_ДвиженияБСОСрезПоследних.ДатаВозврата,
			|	уб_ДвиженияБСОСрезПоследних.Заявка,
			|	уб_ДвиженияБСОСрезПоследних.КодОперации,
			|	уб_ДвиженияБСОСрезПоследних.Комментарий,
			|	ПРЕДСТАВЛЕНИЕ(уб_ДвиженияБСОСрезПоследних.СостояниеБСО) КАК СостояниеБСОПредставление,
			|	ПРЕДСТАВЛЕНИЕ(уб_ДвиженияБСОСрезПоследних.ПоложениеБСО) КАК ПоложениеБСОПредставление,
			|	уб_ДвиженияБСОСрезПоследних.Поставщик.Представление,
			|	уб_ДвиженияБСОСрезПоследних.Агент.Представление,
			|	уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент.Представление,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО.Тип КАК Тип,
			|	987 КАК ДопПоля,
			|	уб_ДвиженияБСОСрезПоследних.ВидБСО.ТипУчетаБСО КАК ТипУчетаБСО
			|ИЗ
			|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
			|			,
			|			ВидБСО = &ВидБСО
			|				И НомерБСО = &НомерБСО
			|				И Подтверждено = Истина
			|               И 1 = 1) КАК уб_ДвиженияБСОСрезПоследних";
			СтруктураОтвета = Новый Структура("ОрганизацияАгент,Поставщик",справочники.Организации.ПустаяСсылка(),Справочники.Контрагенты.ПустаяСсылка());
			Запрос.УстановитьПараметр("ВидБСО",ВидБСО);
			Запрос.УстановитьПараметр("НомерБСО",НомерБСО);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
			    ЗаполнитьЗначенияСвойств(СтруктураОтвета,Выборка);
				
			КонецЕсли;	
			Возврат СтруктураОтвета
	КонецФункции

