Функция ПроверитьПеремещения(Заявка,ТекСтатус,Создать = ЛОЖЬ) Экспорт
	ФлЕстьОшибки = Ложь;
	//Если ПравоДоступа("Проведение", Метаданные.Документы.уб_ПеремещениеБСО) Тогда
	Если ТекСтатус= Перечисления.уб_СтатусыЗаявок.НазначениеКурьера
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.ЗаявкаВПечати	
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.БСОНаРукахУКурьера	
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.КурьерНаВыезде	
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.КурьерПрибылПоАдресу
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.СтраховкаСостоялась
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.СтраховкаНеСостоялась
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.ЗаявкаОтработана 
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.КомплектИДеньгиУКассира	
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.КомплектНаХраненииВБухгалтерии	
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.ДеньгиВКомпании
		или ТекСтатус= Перечисления.уб_СтатусыЗаявок.ЗапросНаУдаление	Тогда
		ДолжноБытьПроведено = Истина;
	Иначе
		ДолжноБытьПроведено = ЛОЖЬ;
	КонецЕсли;
	
	ДолженБытьКурьер = ?(Заявка.Самовыезд,Заявка.Менеджер,Заявка.Курьер);
	
	Если Найти("000000000,000081966,000081967,000081969,000081970",ДолженБытьКурьер.Код)>0 Тогда
		//Это пустой или не выбранный
		ДолжноБытьПроведено = ЛОЖЬ;
	КонецЕсли;	
	
	СоздаемПеремещение = ДолжноБытьПроведено;
	МассивПеремещений = Новый Массив;
	МассивПеремещений  = ВернутьСвязанныеСЗаявкойПеремещения(Заявка,СоздаемПеремещение,МассивПеремещений);
	
		
	ВсегоПеремещений = МассивПеремещений.Количество();
	
	Для Счетчик = 1 по ВсегоПеремещений Цикл
		СсылкаПеремещения = МассивПеремещений[Счетчик - 1];
		
		Если СсылкаПеремещения.Проведен <> ДолжноБытьПроведено
			или СсылкаПеремещения.АгентКуда<>ДолженБытьКурьер
			Тогда
			Об = СсылкаПеремещения.ПолучитьОбъект();
			Об.АгентКуда=ДолженБытьКурьер;
			Попытка
				Об.Записать(?(ДолжноБытьПроведено,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.ОтменаПроведения));
				#Если Клиент Тогда
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(?(ДолжноБытьПроведено,"Проведено","Отмена проведения")+" перемещение: " + СсылкаПеремещения);
				#КонецЕсли
				ОповеститьДляСервера("Консоль","Проведение перемещения № " + Об.Номер);
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка установки статуса по причине " + РасшифроватьПричину(ОписаниеОшибки()), "Сообщить");
				ОповеститьДляСервера("Консоль","Ошибка при проведении перемещения № " + Об.Номер);
				ФлЕстьОшибки = Истина;
				Прервать;
			КонецПопытки;	
		КонецЕсли;	
		
		Если ТекСтатус = Перечисления.уб_СтатусыЗаявок.СтраховкаНеСостоялась Тогда
			МассивПеремещений2 = Новый Массив;
			МассивПеремещений2  = ВернутьСвязанныеСЗаявкойПеремещения(СсылкаПеремещения,СоздаемПеремещение,МассивПеремещений2);
			Для СчетчикВозврат = 1 по МассивПеремещений2.Количество() Цикл
				СсылкаВозврат = МассивПеремещений2[СчетчикВозврат - 1];
				Если СсылкаПеремещения.Проведен <> СсылкаВозврат.Проведен
					или СсылкаПеремещения.АгентКуда<>СсылкаВозврат.Агент
					Тогда
					ОбВозврат = СсылкаВозврат.ПолучитьОбъект();
					ОбВозврат.Агент=СсылкаПеремещения.АгентКуда;
					Попытка
						ОбВозврат.Записать(?(ДолжноБытьПроведено и СсылкаПеремещения.Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.ОтменаПроведения));
						#Если Клиент Тогда
							уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(?(ДолжноБытьПроведено,"Проведено","Отмена проведения")+" перемещение: " + СсылкаВозврат);
						#КонецЕсли
						ОповеститьДляСервера("Консоль","Проведение перемещения № " + ОбВозврат.Номер);
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка установки статуса по причине " + РасшифроватьПричину(ОписаниеОшибки()), "Сообщить");
						ОповеститьДляСервера("Консоль","Ошибка при проведении перемещения № " + ОбВозврат.Номер);
						ФлЕстьОшибки = Истина;
						Прервать;
					КонецПопытки;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
		
	КонецЦикла;
	
	
	
		
	
	//КонецЕсли;
	Возврат ФлЕстьОшибки = ЛОЖЬ;
КонецФункции 		
