Функция УстановитьСтатусЗаявки(
	Заявка, 
	Статус, 
	Комментарий 		= "", 
	Доработка 			= Ложь, 
	ДатаСтатуса 		= Неопределено, 
	ТребуетсяВозвратБСО = Неопределено
	) Экспорт
	
	//Если ТребуетсяВозвратБСО = Неопределено Тогда
	//	ТребуетсяВозвратБСО = ПолучитьТаблицуБСОПоЗаявке(Заявка).Количество() > 0;
	//Конецесли;	
	УстановленТребуетсяВозвратБСО = Не ТребуетсяВозвратБСО = Неопределено;
	Если ДатаСтатуса = Неопределено Тогда
		ДатаСтатуса = ТекущаяДата();
	КонецЕсли;
	ДатаЗаписи = ТекущаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СЗ.Автор,
	|	СЗ.ДатаСоздания,
	|	СЗ.Статус,
	|	СЗ.ТребуетсяВозвратБСО,
	|	СЗ.Заявка.Номер КАК ЗаявкаНомер,
	|	СЗ.Заявка.Курьер КАК Курьер,
	|	СЗ.Заявка.Самовыезд КАК Самовыезд,
	|	СЗ.Заявка.Менеджер КАК Менеджер
	|ИЗ
	|	РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних(&Период, Заявка = &Заявка) КАК СЗ");
	Запрос.УстановитьПараметр("Период", ДатаСтатуса);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Статус  =  Статус Тогда
			Возврат Истина
		КонецЕсли;	
		Записывать = Выборка.Статус <> Статус ;//Или Выборка.ТребуетсяВозвратБСО <> ТребуетсяВозвратБСО;
		Если Записывать Тогда
			ЭтоКурьер = (Выборка.Самовыезд=Ложь и ПараметрыСеанса.уб_ТекущееФизЛицо = Выборка.Курьер и НЕ уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")  и НЕ ПараметрыСеанса.уб_ТекущееФизЛицо = Выборка.Менеджер);
			Если ЭтоКурьер Тогда
				Записывать = Ложь;
			Иначе	
				Автор			= ?(Выборка.Автор.Пустая(), 			ПараметрыСеанса.ТекущийПользователь, 	Выборка.Автор);
				ДатаСоздания 	= ?(Выборка.ДатаСоздания = Дата(1,1,1), ДатаЗаписи,								Выборка.ДатаСоздания);
				ЗаявкаНомер		= Выборка.ЗаявкаНомер;
			КонецЕсли;	
		КонецЕсли;
		Если ТребуетсяВозвратБСО = Неопределено Тогда
			ТребуетсяВозвратБСО = Выборка.ТребуетсяВозвратБСО;
		КонецЕсли;	
	Иначе
		Записывать 		= Истина;
		Автор           = ПараметрыСеанса.ТекущийПользователь;
		ДатаСоздания	= ДатаЗаписи;
	КонецЕсли;
	Если Записывать Тогда
		МЗ = РегистрыСведений.уб_ИсторияСтатусовЗаявок.СоздатьМенеджерЗаписи();
		МЗ.Период 				= ДатаСтатуса;
		МЗ.Заявка 				= Заявка;
		МЗ.Статус 				= Статус;
		МЗ.ТребуетсяВозвратБСО 	= ТребуетсяВозвратБСО;
		МЗ.Доработка 			= Доработка;
		МЗ.Комментарий 			= Комментарий;
		МЗ.Модификатор			= ПараметрыСеанса.ТекущийПользователь;
		МЗ.ДатаИзменения		= ДатаЗаписи;
		МЗ.Автор				= Автор;
		МЗ.ДатаСоздания			= ДатаСоздания;
		Попытка
			МЗ.Записать();
			#Если Клиент Тогда
				Если ЗаявкаНомер = Неопределено Тогда
					ЗаявкаНомер = Заявка.Номер;
				КонецЕсли;
				ОповеститьДляСервера("Консоль", "Установлен статус «" + Статус + "»" + " для № " + ЗаявкаНомер);
				Оповестить("ОбновитьСтатусВЗаявке", Заявка);
			#КонецЕсли
			Результат = Истина;
			уб_Серверные.ОтправитьСтатус (Заявка,Строка(Статус));
		Исключение
			ОповеститьДляСервера("Консоль", "Ошибка при установке статуса «" + Статус + "»");
			Результат = Ложь;
		КонецПопытки;
		Если Результат Тогда
			//уб_Очередь = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
			//уб_Очередь.Объект = Заявка;
			//уб_Очередь.ТипОчереди = Перечисления.уб_ТипыОчереди.ПроверкаПеремещений;
			//уб_Очередь.Параметр = ""+Статус;
			//уб_Очередь.КоличествоПопытокВыполнения = 0;
			//уб_Очередь.Записать();
			
			//Если НЕ УстановленТребуетсяВозвратБСО = Истина Тогда
			//	уб_Очередь = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
			//	уб_Очередь.Объект = Заявка;
			//	уб_Очередь.ТипОчереди = Перечисления.уб_ТипыОчереди.ТребуетсяВозвратБСО;
			//	//уб_Очередь.Параметр = ""+Статус;
			//	уб_Очередь.Записать();
			//Иначе	
			//КонецЕсли;
		КонецЕсли;	
	Иначе
		//ничего не изменено
		Результат = Ложь;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции	

