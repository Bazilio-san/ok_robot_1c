			СтрокаЗаявки.ДатаСтатуса = СтрокаЗаявки.ДатаСтатуса + 1;
		Конецесли;	
		//Попытка
		//	МЗ = РегистрыСведений.уб_ИсторияСтатусовЗаявок.СоздатьМенеджерЗаписи();
		//	МЗ.Период = СтрокаЗаявки.ДатаСтатуса;
		//	МЗ.Заявка = Заявка;
		//	МЗ.Статус = ТекСтатус;
		//	МЗ.ТребуетсяВозвратБСО = НЕ СтрокаЗаявки.ПоложениеБСО = "Вернулось с точки";
		//	МЗ.Комментарий ="Автопростановка";
		//	МЗ.Записать();
		//Исключение
		//КонецПопытки;	
		УстановитьСтатусЗаявки(Заявка, текСтатус, "Автопростановка", Ложь, СтрокаЗаявки.ДатаСтатуса, Не СтрокаЗаявки.ПоложениеБСО = "Вернулось с точки");
	КонецЕсли;
	
КонецФункции	

Функция ОпределитьСтатуcЗаявки(Заявка, СтрокаЗаявки, СписокСотрудниковБСО) Экспорт
	
	ТекСтатус = Перечисления.уб_СтатусыЗаявок.ПустаяСсылка();
	ФлЕстьСданноеБСО = Ложь;
	Если НЕ СтрокаЗаявки.Проведен Тогда
		Если СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление Тогда
			ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление;
		ИначеЕсли СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена Тогда	
			ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена;
		Иначе
			ТекСтатус  = Перечисления.уб_СтатусыЗаявок.СогласованиеСКлиентом;
		КонецЕсли;	
	ИначеЕсли НЕ СтрокаЗаявки.Подтверждена И НЕ СтрокаЗаявки.Самовыезд Тогда
		Если СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление Тогда
			ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление;
		ИначеЕсли СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена Тогда	
			ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена;
		Иначе
			ТекСтатус  = Перечисления.уб_СтатусыЗаявок.НазначениеКурьера;
		КонецЕсли;	
	Иначе
		//Раскручивание структуры подчиненности
		МассивПеремещений = КритерииОтбора.СтруктураПодчиненности.Найти(СтрокаЗаявки.Ссылка);
		ВсегоВМассиве = МассивПеремещений.Количество();
		Если ВсегоВМассиве = 0 Тогда
			//Нет  перемещений  - дальше нечего раскручивать
			//Проверим статус удаления
			Если СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление Тогда
				ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление;
			ИначеЕсли СтрокаЗаявки.Статус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена Тогда	
				ТекСтатус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена;
			Иначе
				ТекСтатус = Перечисления.уб_СтатусыЗаявок.ФормированиеКомплектаБСО;//"Формирование комплекта БСО";
			КонецЕсли;	
			СтрокаЗаявки.СтатусЗаявки = ТекСтатус;
			Возврат ТекСтатус;
		Иначе
			Если ВсегоВМассиве = 1 Тогда
				ПеремещениеБСО = МассивПеремещений[0];
			Иначе
				//Несколько перемещений
				ПеремещениеБСО = МассивПеремещений[0];
			КонецЕсли;	
			флПроведено = Ложь;
			ЗапросПерем = Новый Запрос("ВЫБРАТЬ
			|	МАКСИМУМ(уб_ПеремещениеБСО.Проведен) КАК Проведен,
			|	МАКСИМУМ(уб_ПеремещениеБСО.Дата) КАК ДатаСтатуса
			|ИЗ
			|	Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
			|ГДЕ
			|	уб_ПеремещениеБСО.Ссылка В(&Ссылка)");
			ЗапросПерем.УстановитьПараметр("Ссылка",МассивПеремещений);
			Выборка = ЗапросПерем.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				флПроведено = Выборка.Проведен;
				СтрокаЗаявки.ДатаСтатуса = Выборка.ДатаСтатуса;
			КонецЕсли;	
			Если НЕ флПроведено Тогда
				//Ни один из документов по БСО не проведен, далее нечего раскручивать
				ТекСтатус = Перечисления.уб_СтатусыЗаявок.ФормированиеКомплектаБСО;//КомплектДокументацииПодготовлен;//"Комплект документации подготовлен";
				СтрокаЗаявки.СтатусЗаявки = ТекСтатус;
				Возврат ТекСтатус;
			Иначе
				//
				//Если ВсегоВМассиве>1 Тогда
				//Проверим не было ли возвратов среди этих перемещений
				ТаблицаВыданногоБСОПОЗаявке = Новый ТаблицаЗначений;
				ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("СК");
				ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("ВидБСО");
				ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("НомерБСО");
				ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("Количество");
				Для СчетчикПеремещений = 0 по ВсегоВМассиве-1 Цикл
					ТекДокумент = МассивПеремещений[СчетчикПеремещений];
					Если НЕ СписокСотрудниковБСО[ТекДокумент.Агент] = Неопределено //.Найти(ТекДокумент.Агент) = Неопределено 
						И СписокСотрудниковБСО[ТекДокумент.АгентКуда] = Неопределено Тогда//И СписокСотрудниковБСО.Найти(ТекДокумент.АгентКуда) = Неопределено Тогда
						//Это Выдача из отдела БСО
						Для каждого СтрокаПеремещения из  ТекДокумент.БСО Цикл
							СтрокаБСО = ТаблицаВыданногоБСОПОЗаявке.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаБСО,СтрокаПеремещения);
							СтрокаБСО.Количество = ?(СтрокаПеремещения.Количество=0,1,СтрокаПеремещения.Количество);
						КонецЦикла;	
					ИначеЕсли СписокСотрудниковБСО[ТекДокумент.Агент] = Неопределено //.Найти(ТекДокумент.Агент) = Неопределено 
						И НЕ СписокСотрудниковБСО[ТекДокумент.АгентКуда] = Неопределено Тогда//И НЕ СписокСотрудниковБСО.Найти(ТекДокумент.АгентКуда) = Неопределено Тогда	
						//Это Возврат в отдел БСО
						Для каждого СтрокаПеремещения из  ТекДокумент.БСО Цикл
							СтрокаБСО = ТаблицаВыданногоБСОПОЗаявке.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаБСО,СтрокаПеремещения);
							СтрокаБСО.Количество = ?(СтрокаПеремещения.Количество = 0, -1, -СтрокаПеремещения.Количество);
						КонецЦикла;	
					ИначеЕсли НЕ СписокСотрудниковБСО[ТекДокумент.Агент] = Неопределено //.Найти(ТекДокумент.Агент) = Неопределено 
						И НЕ СписокСотрудниковБСО[ТекДокумент.АгентКуда] = Неопределено Тогда//И НЕ СписокСотрудниковБСО.Найти(ТекДокумент.АгентКуда) = Неопределено Тогда	
						//Отдел БСО Между собой
					Иначе
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Неведомое перемещение "+ТекДокумент.Агент+"/"+ТекДокумент.АгентКуда);
					КонецЕсли;	
					
				КонецЦикла;	
				Если ТаблицаВыданногоБСОПОЗаявке.Количество()>0 Тогда
					ТаблицаВыданногоБСОПОЗаявке.Свернуть("СК,ВидБСО,НомерБСО","Количество");
					ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("ПоложениеБСО");
					ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("СостояниеБСО");
					ТаблицаВыданногоБСОПОЗаявке.Колонки.Добавить("Агент");
					флЕстьОстатокБСО = Ложь;
					ФлЕстьСданноеБСО = Ложь;
					ФлБСОНаточке     = Ложь;
					Для каждого СтрокаБСО из ТаблицаВыданногоБСОПОЗаявке Цикл
						Если СтрокаБСО.Количество >0 Тогда
							флЕстьОстатокБСО = Истина;
							Срез = РегистрыСведений.уб_ДвиженияБСО.СрезПоследних(,Новый Структура("ВидБСО,НомерБСО", СтрокаБСО.ВидБСО, СтрокаБСО.НомерБСО));
							Если Срез.Количество()>0 Тогда
								Подсрез = Срез[0];
								Если Подсрез.ПоложениеБСО =  Перечисления.уб_ПоложенияБСО.ПереданНаТочку Тогда
									ФлБСОНаточке = Истина;
								КонецЕсли;	
								
								Если Подсрез.СостояниеБСО = Перечисления.уб_СостоянияБСО.Испорчен Тогда
									флЕстьОстатокБСО = Ложь;
								КонецЕсли;	
								СтрокаБСО.СостояниеБСО = Подсрез.СостояниеБСО;
								СтрокаБСО.ПоложениеБСО = Подсрез.ПоложениеБСО;
								СтрокаБСО.Агент  = Подсрез.Агент;
							КонецЕсли;	
						ИначеЕсли СтрокаБСО.Количество = 0 Тогда 
							ФлЕстьСданноеБСО = Истина;
						КонецЕсли;	
					КонецЦикла;	
					Если НЕ флЕстьОстатокБСО Тогда
						//все БСО вернули
						//ТекСтатус = Перечисления.уб_СтатусыЗаявок.БСОВозвращено;//"Курьер вернул БСО";				
						ТекСтатус = Перечисления.уб_СтатусыЗаявок.СтраховкаНеСостоялась;//"Курьер вернул БСО";				
						СтрокаЗаявки.СтатусЗаявки = ТекСтатус;
						СтрокаЗаявки.ПоложениеБСО = "Вернулось с точки";
						Возврат ТекСтатус;
					Иначе
						Если ФлБСОНаточке Тогда
							СтрокаЗаявки.ПоложениеБСО = "Передан на точку";
						Иначе	
							СтрокаЗаявки.ПоложениеБСО = "Вернулось с точки";
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			СтрокаЗаявки.ТаблицаБСО = ТаблицаВыданногоБСОПОЗаявке; 
			//КонецЕсли;	
			ТекСтатус = Перечисления.уб_СтатусыЗаявок.БСОНаРукахУКурьера;//"БСО на руках у курьера";
			//Ищем приемки
			//Заменить на запрос
			ЗапросПриемки = Новый Запрос ("ВЫБРАТЬ
			|	уб_ПриемкаОплат.ОтчетКассира,
			|	уб_ПриемкаОплат.ОтчетКассира.Проведен,
			|	уб_ПриемкаОплат.ОтчетКассира.ПометкаУдаления КАК ОКУдален,
			|	уб_ПриемкаОплат.ОтчетКассира.Подтверждено КАК ОКПодтвержден,
			|	уб_ПриемкаОплат.Ссылка,
			|	уб_ПриемкаОплат.Дата
			|ИЗ
			|	Документ.уб_ПриемкаОплат КАК уб_ПриемкаОплат
			|ГДЕ
			|	уб_ПриемкаОплат.СозданНаОсновании В(&СозданНаОсновании)");
			ЗапросПриемки.УстановитьПараметр("СозданНаОсновании", МассивПеремещений);
			//СводныйМассивПриемок = Новый Массив;
			//Для СчетчикПеремещений = 1 по  ВсегоВМассиве Цикл
			//	ТекПеремещение = МассивПеремещений[СчетчикПеремещений-1];
			//	МассивПриемок = КритерииОтбора.СтруктураПодчиненности.Найти(ТекПеремещение);
			//	ВсегоВМассивеПриемок = МассивПриемок.Количество();
			//	Для СчетчикПриемок = 1 по  ВсегоВМассивеПриемок Цикл
			//		Если 
			//		СводныйМассивПриемок.Добавить(МассивПриемок[СчетчикПриемок-1]);
			//	КонецЦикла;	
			//КонецЦикла;
			ВыборкаПриемки = ЗапросПриемки.Выполнить().Выбрать();
			Если ВыборкаПриемки.Количество() = 0 Тогда
				//Курьер еще не отчитался
				СтрокаЗаявки.СтатусЗаявки = ТекСтатус;
				Возврат ТекСтатус;
			Иначе
				//Проверка всех БСО ?
				ТекСтатус = Перечисления.уб_СтатусыЗаявок.КомплектИДеньгиУКассира;//"Комплект и деньги у кассира";
				ФлПроверены = Истина;	
				Пока ВыборкаПриемки.Следующий() Цикл
					Если ВыборкаПриемки.ОтчетКассира.Пустая() Тогда
						ФлПроверены = Ложь;
					ИначеЕсли ВыборкаПриемки.ОКУдален Тогда
						ФлПроверены = Ложь;
					ИначеЕсли НЕ ВыборкаПриемки.ОКПодтвержден Тогда
						ФлПроверены = Ложь;
					Конецесли;	
					СтрокаЗаявки.ДатаСтатуса = ВыборкаПриемки.Дата;
				КонецЦикла;
				Если ФлПроверены = Ложь Тогда
				Иначе	
					ТекСтатус = Перечисления.уб_СтатусыЗаявок.ДеньгиВКомпании;//"Деньги в компании";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	СтрокаЗаявки.СтатусЗаявки = ТекСтатус;
	Если ФлЕстьСданноеБСО И ТекСтатус = Перечисления.уб_СтатусыЗаявок.БСОНаРукахУКурьера Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Частично вернули БСО по заявке: "+СтрокаЗаявки.Ссылка);
	КонецЕсли;	
	Возврат ТекСтатус;
	
КонецФункции	

Функция ПолучитьРеквизитыЗаявки(Знач Заявка, СоСтатусом = Ложь) Экспорт
	
	Отказ = Ложь;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Заявки.Ссылка,
	|	Заявки.Менеджер,
	|	Заявки.Курьер,
	|	Заявки.Страхователь,
	|	Заявки.Проведен,
	|	Заявки.ПометкаУдаления,
	|	Заявки.Утверждено КАК Подтверждена,
	|	Заявки.Дата КАК ДатаСтатусаSVS,
	|	Заявки.Статус КАК СтатусSVS,
	|	Заявки.Самовыезд,
	|	Заявки.НомерЗаявки,
	|	Заявки.Номер,
	|	Заявки.Дата,
	|	Заявки.Утверждено КАК Утверждено,
	|	Заявки.НетБСО,
	|	ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ПустаяСсылка) КАК СтатусЗаявки,
	|	"""" КАК ПоложениеБСО,
	|	"""" КАК Представление,
	|	"""" КАК ТаблицаБСО,
	|	Заявки.БСО.(
	|		Ссылка,
	|		НомерСтроки,
	|		СК,
	|		ВидСП,
	|		ВидБСО,
	|		СтраховаяПремия,
	|		ПредоставленнаяСкидка,
	|		ПредоставленнаяСкидкаПроцент,
	|		ЛимитОтветственности,
	|		Основной,
	|		СуммаВзноса,
	|		Количество,
	|		ОбъектСтрахования,
	|		ДатаНачала,
	|		ДатаОформления,
	|		ДатаОкончания
	|	),
	|	Заявки.Тип,
	|	&ДопПоля,
	|	Заявки.СозданНаОсновании,
	|	ТИПЗНАЧЕНИЯ(Заявки.СозданНаОсновании) КАК ТипОснования
	|ИЗ
	|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК Заявки";
	Если СоСтатусом Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопПоля", 
		"ЕСТЬNULL(СЗ.Статус, ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ПустаяСсылка)) КАК Статус,
		|	ЕСТЬNULL(СЗ.Доработка, ЛОЖЬ) КАК Доработка,
		|	ЕСТЬNULL(СЗ.ТребуетсяВозвратБСО, ЛОЖЬ) КАК ТребуетсяВозвратБСО,
		|	ЕСТЬNULL(СЗ.Комментарий, """") КАК Комментарий,
		|	ЕСТЬNULL(СЗ.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаСтатуса");
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК СЗ
		|		ПО (СЗ.Заявка = Заявки.Ссылка)";
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопПоля", "ЛОЖЬ");
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|ГДЕ
	|	&УсловиеГде
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заявки.МоментВремени";
	ТипПараметра = ТипЗнч(Заявка);
	Если ТипПараметра = Тип("Строка") Тогда
		Попытка
			Заявка = Число(Заявка);
			ТипПараметра = Тип("Число");
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_УСЗ.ПолучитьРеквизитыЗаявки(): некорректный параметр Заявка (типзнч Строка), значение: " + Заявка, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
			Отказ = Истина;
		КонецПопытки;
	КонецЕсли;
	Если Не Отказ Тогда
		Если ТипПараметра = Тип("Число") Тогда
			СтрокаЗамены = "Заявки.Номер = &Номер";
			Запрос.УстановитьПараметр("Номер", Заявка);
		ИначеЕсли ТипПараметра = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
			СтрокаЗамены = "Заявки.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка",	Заявка);
		Иначе
			Отказ = Истина;
		КонецЕсли;  
		Если Не Отказ Тогда
			ТекстЗапросаСУсловием = СтрЗаменить(ТекстЗапроса, "&УсловиеГде", СтрокаЗамены);
			Запрос.Текст = ТекстЗапросаСУсловием;
			РезультатЗапроса = Запрос.Выполнить();
		КонецЕсли;
	КонецЕсли;
	Если Отказ Или РезультатЗапроса.Пустой() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", 	"ВЫБРАТЬ ПЕРВЫЕ 1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде", "ИСТИНА");
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			ТЗ = РезультатЗапроса.Выгрузить();
			ТЗ.Очистить();
			ТЗ.Добавить();
		КонецЕсли;
	Иначе
		ТЗ = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	Структура = Новый Структура;
	СтрокаТЗ = ТЗ[0];;
	Для каждого Колонка из тз.Колонки Цикл 
		Если Колонка.Имя = "БСО" Тогда
			МассивБСО = Новый Массив;
			
			Для каждого СтрокаБСО из СтрокаТЗ.БСО Цикл
				МассивБСО.добавить(Новый Структура("СК,ВидБСО,СтраховаяПремия,ПредоставленнаяСкидка,СуммаВзноса,ОбъектСтрахования,ДатаНачала,ДатаОкончания,ДатаОформления",
				СтрокаБСО.СК,СтрокаБСО.ВидБСО,СтрокаБСО.СтраховаяПремия,СтрокаБСО.ПредоставленнаяСкидка,СтрокаБСО.СуммаВзноса,СтрокаБСО.ОбъектСтрахования,СтрокаБСО.ДатаНачала,СтрокаБСО.ДатаОкончания,СтрокаБСО.ДатаОформления));
			КонецЦикла;	
			Структура.Вставить(Колонка.Имя,МассивБСО);
		Иначе	
			Структура.Вставить(Колонка.Имя,СтрокаТЗ[Колонка.Имя]);
		КонецЕсли;	
	КонецЦикла;	
	//
	Возврат Структура;
КонецФункции	

Процедура ПроверитьВыполнитьДействиеПоЗаявке(Заявка, Действие, Роль = Неопределено) Экспорт
	
	Если Роль = Неопределено Тогда
		Роль = ПолучитьРольПользователяДляЗаявок();
	КонецЕсли;	
	ТекСтатус = ВернутьСтатусЗаявки (Заявка,ТекущаяДата());
	СтрокаРеквизитов = ПолучитьРеквизитыЗаявки(Заявка);
	СписокВозможныхДействий = ВернутьСписокДействийДляСтатуса(ТекСтатус,СтрокаРеквизитов);
	Если СписокВозможныхДействий.НайтиПоЗначению(Действие) = Неопределено Тогда
		Если ТекСтатус.Пустая() Тогда
			ИдентификаторСтатуса = "ПустаяСсылка";
		Иначе	
			ИндексСтатуса = Перечисления.уб_СтатусыЗаявок.Индекс(ТекСтатус);
			ИдентификаторСтатуса = Метаданные.Перечисления.уб_СтатусыЗаявок.ЗначенияПеречисления[ИндексСтатуса].Имя;
		КонецЕсли;	
		Если Действие = "УстановитьСтатус_" + ИдентификаторСтатуса Тогда
			//Этот статус уже установлен
			ОповеститьДляСервера("Консоль", "Статус " + ИдентификаторСтатуса +  " уже установлен для заявки № " + Заявка.Номер);
		Иначе	
			//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Действие "+ Действие +  " не доступно для "+Заявка);
			ОповеститьДляСервера("Консоль","Действие " + Действие + " не доступно для заявка № " + Заявка.Номер);
		Конецесли;	
	Иначе
		ОповеститьДляСервера("Консоль", "Проверка доступности и вызов действия " + Действие +  "  для заявки № " + Заявка.Номер);
		ВыполнитьДействиеПоЗаявке(Заявка, ТекСтатус, Действие, СтрокаРеквизитов, Роль);
	КонецЕсли;	
	
КонецПроцедуры

Функция ОтменитьСтатусЗаявки(Заявка, ОтменяемыйСтатус, НомерЗаявки = Неопределено) Экспорт
	
	//Если текущий статус совпадает с переданным
	//устанавливается предыдущий статус
	Результат = Ложь;
	ВыборкаСтатуса = Неопределено;
	ТекСтатус = ВернутьСтатусЗаявки(Заявка, ТекущаяДата(), ВыборкаСтатуса);
	Если ТекСтатус = ОтменяемыйСтатус Тогда
		СтрокаРеквизитов = ПолучитьРеквизитыЗаявки(Заявка);
		Роль = ПолучитьРольПользователяДляЗаявок();
		Результат = ВыполнитьДействиеПоЗаявке(Заявка, ТекСтатус, "УстановитьПредыдущийСтатус", СтрокаРеквизитов, Роль);
	Иначе
		Если НомерЗаявки = Неопределено Тогда
			НомерЗаявки = Заявка.Номер
		КонецЕсли;
		ОповеститьДляСервера("Консоль", "Нельзя отменить статус: " + ОтменяемыйСтатус + "; Текущий статус: " + ТекСтатус + "  для заявки № " + НомерЗаявки);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ВернутьСписокДействийДляСтатуса(
	ТекСтатус,
	СтрокаРеквизитов,
	ВыводитьСообщения 	= Истина,
	МассивРолей			= "",
	Интерактивные 		= Истина,
	КакМассив = ЛОЖЬ
	) 
	Экспорт
	
	Если МассивРолей = "" Тогда
		МассивРолей = Новый Массив;
	КонецЕсли;	
	ПравоНаДоработкуПослеУтв_ТолькоРСВС = Истина;
	СписокДействий = Новый СписокЗначений;
	Статусы = Перечисления.уб_СтатусыЗаявок;
	ЭтоОператор = НЕ Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокОператоров().Найти(ПараметрыСеанса.уб_ТекущееФизЛицо) = Неопределено;
	Если СтрокаРеквизитов.ПометкаУдаления = Истина Тогда
		Если ВыводитьСообщения Тогда
			#Если Клиент Тогда
				Предупреждение("Для помеченной на удаление заявки не могут быть установлены статусы! "+СтрокаРеквизитов.Ссылка);
				ОповеститьДляСервера("Консоль","Для помеченной на удаление заявки не могут быть установлены статусы! "+СтрокаРеквизитов.Ссылка);
			#КонецЕсли
		КонецЕсли;	
		СписокДействий.Добавить("УстановитьСтатус_ЗапросНаУдаление","Отказ от страховки");
	ИначеЕсли ТекСтатус = Статусы.ПустаяСсылка() Тогда
		//СписокДействий.Добавить("УстановитьСтатус_СогласованиеСКлиентом", "Создание заявки");
		//Если Интерактивные Тогда
		//	СписокДействий.Добавить("УстановитьСтатус_СтраховкаНеСостоялась", "Страховка не состоялась");
		//КонецЕсли;
	ИначеЕсли ТекСтатус = Статусы.СогласованиеСКлиентом Тогда
		СписокДействий.Добавить("УстановитьСтатус_ЗапросНаУдаление","Отказ от страховки");
		//Если СтрокаРеквизитов.Самовыезд Тогда
			СписокДействий.Добавить("УстановитьСтатус_ФормированиеКомплектаБСО", "Формирование комплекта БСО");
		//Иначе
		//	СписокДействий.Добавить("УстановитьСтатус_НазначениеКурьера", "Комплект подготовлен");	
		//КонецЕсли;	
		Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПравоУстанавливатьСтраховкаНеСостоялась, Ложь) Тогда
			СписокДействий.Добавить("УстановитьСтатус_СтраховкаНеСостоялась", "Страховка не состоялась");
		КонецЕсли;
		СписокДействий.Добавить("УстановитьСтатус_ЗапросНаУдаление", "Отказ от страховки");
	ИначеЕсли ТекСтатус = Статусы.НазначениеКурьера Тогда
		//Если Не ((ЕстьРоль("Менеджер", МассивРолей) И Не (ЕстьРоль("РСВС", МассивРолей) Или ЕстьРоль("ПолныеПрава", МассивРолей))) И Не СтрокаРеквизитов.Самовыезд) Тогда
			СписокДействий.Добавить("УстановитьСтатус_ФормированиеКомплектаБСО","Формирование комплекта БСО");
		//КонецЕсли;	
		СписокДействий.Добавить("УстановитьСтатус_ЗаявкаВПечати",	"Заявка в печати");
		//СписокДействий.Добавить("УстановитьСтатус_СогласованиеСКлиентом_Доработка", "Отменить заявку");
		СписокДействий.Добавить("УстановитьСтатус_БСОНаРукахУКурьера", "Заявка у курьера");
		Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПравоУстанавливатьСтраховкаНеСостоялась, Ложь) Тогда
			СписокДействий.Добавить("УстановитьСтатус_СтраховкаНеСостоялась",	"Страховка не состоялась");
		КонецЕсли;
		СписокДействий.Добавить("УстановитьСтатус_КомплектНаХраненииВБухгалтерии","Принять комплект документов на хранение в бухгалтерию");	
	
		СписокДействий.Добавить("СоздатьПриемкуОплат",				"Создать приемку денег");
	ИначеЕсли ТекСтатус = Статусы.ФормированиеКомплектаБСО Тогда
		
		//ВозможноНаДоработку = ?(ЕстьРоль("Контроль", МассивРолей) или ЕстьРоль("РСВС", МассивРолей) или ЕстьРоль("Печать", МассивРолей) или ЕстьРоль("ПолныеПрава", МассивРолей), Истина, ?(ПравоНаДоработкуПослеУтв_ТолькоРСВС, Ложь, Истина));
		//Если ВозможноНаДоработку Тогда
			СписокДействий.Добавить("УстановитьСтатус_СогласованиеСКлиентом_Доработка", "Создание заявки");
	//	КонецЕсли;	

		Если Интерактивные Тогда		
			СписокДействий.Добавить("СоздатьПеремещениеБСО", "Создать перемещение БСО");	
		КонецЕсли;
		СписокДействий.Добавить("УстановитьСтатус_ЗаявкаВПечати",	"Заявка в печати");
		
		Если ЭтоОператор = ЛОЖЬ или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ОтделПечати, Ложь)  Тогда
			СписокДействий.Добавить("УстановитьСтатус_НазначениеКурьера", "Комплект подготовлен");	
		КонецЕсли;
		Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПравоУстанавливатьСтраховкаНеСостоялась, Ложь) Тогда
