	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уб_ДвиженияБСО.СК,
	|	уб_ДвиженияБСО.ВидБСО,
	|	уб_ДвиженияБСО.НомерБСО
	|ПОМЕСТИТЬ СписокДвижений
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	|ГДЕ
	|	уб_ДвиженияБСО.Заявка = &Заявка
	|	И уб_ДвиженияБСО.Подтверждено
	|	И уб_ДвиженияБСО.Активность
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	уб_ОстаткиБСО.СК,
	//|	уб_ОстаткиБСО.ВидБСО
