		КонецЦикла;		
		//Строка.ИтогОС_НачисленнаяСуммаВзноса = РегистрыСведений.уб_ИсторияРеквизит.ПолучитьПоследнее(Строка.ДатаВерсии, Новый Структура("ОбъектИстории, НаименованиеРеквизита", ОбъектИстории, "ИтогОС_НачисленнаяСуммаВзноса")).ЗначениеРеквизита;
		//Строка.ИтогОС_КВ					 = РегистрыСведений.уб_ИсторияРеквизит.ПолучитьПоследнее(Строка.ДатаВерсии, Новый Структура("ОбъектИстории, НаименованиеРеквизита", ОбъектИстории, "ИтогОС_КВ")).ЗначениеРеквизита;
		//Строка.КоличествоСтрокОплат			 = РегистрыСведений.уб_ИсторияРеквизит.ПолучитьПоследнее(Строка.ДатаВерсии, Новый Структура("ОбъектИстории, НаименованиеРеквизита", ОбъектИстории, "КоличествоСтрокОплат")).ЗначениеРеквизита;
	КонецЦикла;	
