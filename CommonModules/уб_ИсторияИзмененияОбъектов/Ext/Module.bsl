Функция ПолучитьДатуАктуальнойВерсии(ОбъектИстории) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ИсторияОбъект.Период КАК ДатаВер,
	|	уб_ИсторияОбъект.НомерВерсии КАК Версия
	|ИЗ
	|	РегистрСведений.уб_ИсторияОбъект КАК уб_ИсторияОбъект
	|ГДЕ
	|	уб_ИсторияОбъект.ОбъектИстории = &ОбъектИстории
	|	И уб_ИсторияОбъект.ВерсияАктуальна");						  
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаВер;
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуПоследнейВерсии(ОбъектИстории) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ИсторияОбъект.Период КАК ДатаВер,
	|	уб_ИсторияОбъект.НомерВерсии КАК Версия
	|ИЗ
	|	РегистрСведений.уб_ИсторияОбъект КАК уб_ИсторияОбъект
	|ГДЕ
	|	уб_ИсторияОбъект.ОбъектИстории = &ОбъектИстории
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВер УБЫВ");						  
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаВер;
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
КонецФункции

//!!!Добавить ТЧ и подчиненные документы
Функция ЗаписатьВерсиюИсторииВРегистр(ОбъектИстории, СтруктураРазличий, Комментарий, Актуальна = Ложь,ДатаПоследнейВерсии) Экспорт 
	
	//Инициализируем дату версии
	ДатаИстории = ТекущаяДата();	
	Если ДатаПоследнейВерсии = ДатаИстории Тогда
		ДатаИстории = ДатаИстории+1;//Итерация периода записи, при очень быстрой повторной записи может возникать проблема 
	КонецЕсли;	
	//Добавляем запись в регистр о новой версии
	НомерПоследнейВерсии = РегистрыСведений.уб_ИсторияОбъект.ПолучитьПоследнее(, Новый Структура("ОбъектИстории", ОбъектИстории)).НомерВерсии;
	НачатьТранзакцию();
	МЗИсторияОбъекта = РегистрыСведений.уб_ИсторияОбъект.СоздатьМенеджерЗаписи();
	МЗИсторияОбъекта.Период = ДатаИстории;
	МЗИсторияОбъекта.ВерсияАктуальна = Актуальна;
	МЗИсторияОбъекта.ОбъектИстории = ОбъектИстории;
	МЗИсторияОбъекта.НомерВерсии = ?(ЗначениеЗаполнено(НомерПоследнейВерсии), НомерПоследнейВерсии + 1, 1);
	МЗИсторияОбъекта.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	МЗИсторияОбъекта.Записать();	
	НаборЗаписейИсторияРеквизит = РегистрыСведений.уб_ИсторияРеквизит.СоздатьНаборЗаписей();
	НаборЗаписейИсторияРеквизит.Отбор.ОбъектИстории.Установить(ОбъектИстории);
	НаборЗаписейИсторияРеквизит.Отбор.Период.Установить(ДатаИстории);
	НаборЗаписейИсторияРеквизит.Прочитать();
	НаборЗаписейИсторияРеквизитТЧ = РегистрыСведений.уб_ИсторияРеквизитТЧ.СоздатьНаборЗаписей();
	НаборЗаписейИсторияРеквизитТЧ.Отбор.ОбъектИстории.Установить(ОбъектИстории);
	НаборЗаписейИсторияРеквизитТЧ.Отбор.Период.Установить(ДатаИстории);
    НаборЗаписейИсторияРеквизитТЧ.Прочитать();		
	КэшРеквизитов = Новый Массив;
	Для Каждого СтрокаРазличий Из СтруктураРазличий Цикл	
		Если СтрокаРазличий.Ключ = "ПлатежныйДокумент" Тогда
			//Пишем различия ТЧ
			Для каждого Строка из СтрокаРазличий.Значение Цикл
				//МЗРеквизитыОбъекта = РегистрыСведений.уб_ИсторияРеквизитТЧ.СоздатьМенеджерЗаписи();
				Реквизит 		= Строка.Значение.НаименованиеРеквизитаТЧ;
				ИмяДокумента    = ОбъектИстории.Метаданные().Имя;
				
				РеквизитОбъекта = НайтиРеквизитОбъекта(Реквизит, ИмяДокумента);
				Если НЕ РеквизитОбъекта = Неопределено Тогда
					МЗРеквизитыОбъекта = НаборЗаписейИсторияРеквизитТЧ.Добавить();
					МЗРеквизитыОбъекта.Период 				= ДатаИстории;
					МЗРеквизитыОбъекта.ОбъектИстории 		= ОбъектИстории;
					МЗРеквизитыОбъекта.НаименованиеТЧ 		= СтрокаРазличий.Ключ;
					МЗРеквизитыОбъекта.УИДСтрокиТЧ 			= Строка.Значение.УИДСтроки;				
					МЗРеквизитыОбъекта.РеквизитОбъекта 		= РеквизитОбъекта;
					МЗРеквизитыОбъекта.ЗначениеРеквизита 	= Строка.Значение.ПравоеЗначение;
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("ЗаписатьВерсиюИсторииВРегистр(): записана история с пустым реквизитом: '" + Реквизит + "', имя документа: '" + ИмяДокумента + "'", ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
				Иначе
					Сообщить("Не найден реквизит "+Реквизит+" /// "+ИмяДокумента);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли СтрокаРазличий.Ключ = "ПодчиненныеДокументы" Тогда
			//Для подчиненного документа история уже записалась при записи самого подчиненного документа
			//но, для реквизитов - которых не было раньше, но нет сейчас - не отрабатывает
			//если нашлись изменения, то нужно писать версию, и все будет ок
			Для Каждого Строка из СтрокаРазличий.Значение Цикл
				ПодчиненныйДокумент = Строка.ПодчиненныйДокументСсылка;
				НомерПоследнейВерсииПодчиненного = РегистрыСведений.уб_ИсторияОбъект.ПолучитьПоследнее(, Новый Структура("ОбъектИстории", ПодчиненныйДокумент)).НомерВерсии;
				МЗИсторияПодчДок = РегистрыСведений.уб_ИсторияОбъект.СоздатьМенеджерЗаписи();
				МЗИсторияПодчДок.Период = ДатаИстории;
				МЗИсторияПодчДок.ВерсияАктуальна = Ложь;
				МЗИсторияПодчДок.ОбъектИстории = ПодчиненныйДокумент;
				МЗИсторияПодчДок.НомерВерсии = ?(ЗначениеЗаполнено(НомерПоследнейВерсииПодчиненного), НомерПоследнейВерсииПодчиненного + 1, 1);
				МЗИсторияПодчДок.Пользователь = ПараметрыСеанса.ТекущийПользователь;
				МЗИсторияПодчДок.Записать();
				Для каждого ПодСтрокаРазличий из строка.ПодчиненныйДокументРазличия Цикл
					Если НЕ КэшРеквизитов.Найти(ПодСтрокаРазличий.Ключ.Реквизит) = Неопределено Тогда
						Продолжить;
					Иначе
						КэшРеквизитов.Добавить(ПодСтрокаРазличий.Ключ.Реквизит);
					КонецЕсли;	
					МЗРеквизитыОбъекта = РегистрыСведений.уб_ИсторияРеквизит.СоздатьМенеджерЗаписи();
					МЗРеквизитыОбъекта.Период = ДатаИстории;
					МЗРеквизитыОбъекта.ОбъектИстории = ПодчиненныйДокумент;
					ИмяДокумента = ПодчиненныйДокумент.Метаданные().Имя;
					МЗРеквизитыОбъекта.РеквизитОбъекта = ПодСтрокаРазличий.Ключ.Реквизит;//НайтиРеквизитОбъекта(ПодСтрокаРазличий.Ключ, ИмяДокумента); 
					МЗРеквизитыОбъекта.ЗначениеРеквизита = ПодСтрокаРазличий.Значение.ПравоеЗначение;
					Если НЕ ЗначениеЗаполнено(ПодСтрокаРазличий.Ключ.Реквизит) Тогда
						Сообщить(ПодСтрокаРазличий.Значение.ПравоеЗначение);
					КонецЕсли;	
					МЗРеквизитыОбъекта.Записать();
				КонецЦикла;
			КонецЦикла;
		Иначе
			Если НЕ КэшРеквизитов.Найти(СтрокаРазличий.Ключ.Реквизит) = Неопределено Тогда
				Продолжить;
			Иначе
				КэшРеквизитов.Добавить(СтрокаРазличий.Ключ.Реквизит);
			КонецЕсли;	
			МЗРеквизитыОбъекта = НаборЗаписейИсторияРеквизит.Добавить();
			МЗРеквизитыОбъекта.Период = ДатаИстории;
			МЗРеквизитыОбъекта.ОбъектИстории = ОбъектИстории;
			ИмяДокумента = ОбъектИстории.Метаданные().Имя;
			МЗРеквизитыОбъекта.РеквизитОбъекта = СтрокаРазличий.Ключ.Реквизит;
			Если НЕ ЗначениеЗаполнено(СтрокаРазличий.Ключ.Реквизит) Тогда
				Сообщить(СтрокаРазличий.Значение.ПравоеЗначение);
			КонецЕсли;	
			МЗРеквизитыОбъекта.ЗначениеРеквизита = СтрокаРазличий.Значение.ПравоеЗначение;			
		КонецЕсли;		
	КонецЦикла;
	//Сообщить(""+ОбъектИстории+ДатаИстории);
	Попытка
		Если НаборЗаписейИсторияРеквизит.Количество() > 0 Тогда
			НаборЗаписейИсторияРеквизит.Записать();
		КонецЕсли;	
	Исключение
		Сообщить(ОписаниеОшибки());
		//Сообщить(ПолучитьДатуПоследнейВерсии(ОбъектИстории.Ссылка));
		
		
	//	Для каждого СтрокаРазличий из СтруктураРазличий Цикл
	//		
	//		Если ЗначениеЗаполнено(СтрокаРазличий.Ключ.Реквизит) Тогда
	//		Иначе	
	//			Сообщить(СтрокаРазличий.Значение.ПравоеЗначение);
	//		КонецЕсли;	
	//	КонецЦикла;	
	КонецПопытки;	
	Если НаборЗаписейИсторияРеквизитТЧ.Количество() > 0 Тогда
		НаборЗаписейИсторияРеквизитТЧ.Записать();
	КонецЕсли;			
	ЗафиксироватьТранзакцию();
	Возврат МЗИсторияОбъекта;
	
	//
	//Для Каждого СтрокаРазличий Из СтруктураРазличий Цикл
	//	МЗРеквизитыОбъекта = НаборЗаписейИсторияРеквизит.Добавить();
	//	МЗРеквизитыОбъекта.Период = ДатаИстории;
	//	МЗРеквизитыОбъекта.ОбъектИстории = ОбъектИстории;		
	//	МЗРеквизитыОбъекта.РеквизитОбъекта = СтрокаРазличий.СсылкаРеквизита;
	//	МЗРеквизитыОбъекта.ЗначениеРеквизита = СтрокаРазличий.ПравоеЗначение;
	//КонецЦикла;
	//
		
КонецФункции

//Получаем последнюю версию объекта
//Возврат:
//	Если версия не надена - Неопределено
//	Иначе Структура значений последней версии объекта
Функция ПолучитьПоследнююВерсиюОбъекта(ОбъектИстории) Экспорт
	
	СрезПоледних = РегистрыСведений.уб_ИсторияОбъект.СрезПоследних(, Новый Структура("ОбъектИстории", ОбъектИстории));
	Если СрезПоледних.Количество() > 0 Тогда
		Возврат ПолучитьДанныеОбъектаНаДату(ОбъектИстории, СрезПоледних[0].Период);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

//ТОДО Заменить на новую функцию в ЗП потом убрать

//Получаем версию объекта на заданную дату	!!!Добавить ТЧ и подчиненные документы
//Возврат:
//	
Функция ПолучитьДанныеОбъектаНаДату(ОбъектИстории, ДатаОбъектаИстории) Экспорт
	
	СтруктураОбъектаИстории = Новый Структура();	
	Если ЗначениеЗаполнено(ДатаОбъектаИстории) Тогда 	
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ИР.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
		|	ИР.ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(
		|			&ДатаОбъектаИстории,
		|			ОбъектИстории = &ОбъектИстории
		|				И РеквизитОбъекта <> ЗНАЧЕНИЕ(Справочник.уб_РеквизитыОбъектов.ПустаяСсылка)) КАК ИР");
		Запрос.УстановитьПараметр("ДатаОбъектаИстории", ДатаОбъектаИстории);
		Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);
		Выборка = Запрос.Выполнить().Выбрать();		
		//Получаем значение всех реквизитов
	 	Пока Выборка.Следующий() Цикл
			СтруктураОбъектаИстории.Вставить(Выборка.НаименованиеРеквизита, Выборка.ЗначениеРеквизита)
		КонецЦикла;			
	Иначе
		//Получаем структуру текущей версии объекта
		Реквизиты = ПолучитьСписокРеквизитов(ОбъектИстории);
		Для Каждого Реквизит Из Реквизиты.Реквизиты Цикл
			ЗначениеРеквизита = ОбъектИстории[Реквизит.НаименованиеРеквизита];
			СтруктураОбъектаИстории.Вставить(Реквизит, ЗначениеРеквизита);
		КонецЦикла;                             
	КонецЕсли;	
	//!!!Получаем значение подчиненного документа ОплатаПолиса
	Если ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории КАК ОплатаПолиса
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&ДатаОбъектаИстории, РеквизитОбъекта.Наименование = ""ОтчетПоставщику"") КАК уб_ИсторияРеквизитСрезПоследних
		|ГДЕ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита = &ОтчетПоставщику");
		Запрос.УстановитьПараметр("ДатаОбъектаИстории", ДатаОбъектаИстории);
		Запрос.УстановитьПараметр("ОтчетПоставщику", ОбъектИстории);
		Выборка = Запрос.Выполнить().Выбрать();		
		ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");		
		Пока Выборка.Следующий() Цикл
			НовСтр = ТаблицаПодчиненныхДокументов.Добавить();
			НовСтр.ПодчиненныйДокументСсылка = Выборка.ОплатаПолиса;
			НовСтр.ПодчиненныйДокументСтруктура = ПолучитьДанныеОбъектаНаДату(Выборка.ОплатаПолиса, ДатаОбъектаИстории);
		КонецЦикла;		
		СтруктураОбъектаИстории.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);		
	КонецЕсли;	
	//!!!Получаем значение ТЧ ПлатежныйДокумент
	//Если ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
	//	
	//	ТЧ = "ПлатежныйДокумент";
	//	
	//	СписокРеквизитовОбъекта = ПолучитьСписокРеквизитов(ОбъектИстории);
	//	СписокРеквизитовТЧ = СписокРеквизитовОбъекта.РеквизитыТЧ.Скопировать(Новый Структура("НаименованиеТЧ",ТЧ));
