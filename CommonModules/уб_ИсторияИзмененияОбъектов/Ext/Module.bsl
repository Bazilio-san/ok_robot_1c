Функция НайтиРеквизитОбъекта(Реквизит, ИмяДокумента) Экспорт
	
	Если ТипЗнч(Реквизит) = Тип("Строка") И Реквизит <> "" И ТипЗнч(ИмяДокумента) = Тип("Строка") И ИмяДокумента <> "" Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РО.Ссылка
		|ИЗ
		|	Справочник.уб_РеквизитыОбъектов КАК РО
		|ГДЕ
		|	РО.Наименование = &Реквизит
		|	И РО.ИмяДокумента = &ИмяДокумента
		|	И НЕ РО.ПометкаУдаления";
		Запрос.УстановитьПараметр("Реквизит",		Реквизит);
		Запрос.УстановитьПараметр("ИмяДокумента",	ИмяДокумента);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;	
		КонецЕсли;					
		Если Результат = Неопределено Тогда //если не найдено, то создаем новый			
			НовыйОбъект = Справочники.уб_РеквизитыОбъектов.СоздатьЭлемент();
			НовыйОбъект.Наименование = СокрЛП(Реквизит);
			НовыйОбъект.ИмяДокумента = СокрЛП(ИмяДокумента);
			НовыйОбъект.Записать();
			Результат = НовыйОбъект.Ссылка;
		КонецЕсли;	
		Возврат Результат;
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

Процедура ПриЗаписиДокументаИсторияПриЗаписи(Источник, Отказ) Экспорт
	
	//Если стоит флаг загрузка, не создаем новую версию в итории
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Источник.ДополнительныеСвойства.Свойство("НеЗаписыватьИсторию") И Источник.ДополнительныеСвойства.НеЗаписыватьИсторию Тогда
		Возврат;
	КонецЕсли;	
	Если Не Отказ Тогда
		Попытка
			НастройкиДокумента = Справочники.уб_СписокОбъектовИстории.НайтиПоКоду(Источник.Метаданные().Имя);		
			Если ЗначениеЗаполнено(НастройкиДокумента) Тогда
				ЗаписатьНовуюВерсиюИсторииОбъекта(Источник.Ссылка, "Автоматическая регистрация изменений", НастройкиДокумента.ФиксироватьАвтоматически,,Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ОткрытьФормуДокумент(НаименованиеДокумента, ПараметрыВерсии, ДокументОбъект) Экспорт
	
	//Транзакция открывается для отмены создания нового документа
	НачатьТранзакцию();
	//для менеджера документов обязательно требуется имя открываемой формы
	Форма = Документы[НаименованиеДокумента].ПолучитьФорму("ФормаДокументаУпрощение");	
	Форма.Открыть();	
	Форма.АвтоЗаголовок = Ложь;
	Форма.Заголовок = НаименованиеДокумента + ". История v." + ПараметрыВерсии.Версия + " от " + Формат(ПараметрыВерсии.ДатаВер, "ДЛФ=ДД") + ?(ПараметрыВерсии.АктуальностьВерсии,"/Актальная", "");
	Форма.Панель.ЦветФона = Новый Цвет(239, 247, 248);	
	//Обрабатываем элементы формы
	Для Каждого Элемент Из Форма.ЭлементыФормы Цикл
		//Чистим значения полей
		Если Тип(Элемент) = Тип("ПолеВвода") Тогда
			Элемент.Значение = Неопределено;
			Элемент.ТолькоПросмотр = Истина;
			Элемент.АвтоОтметкаНезаполненного = Ложь;
		ИначеЕсли Тип(Элемент) = Тип("Надпись") Тогда
			//TO BD DO проверить откуда берется, есть ли данные
			Если ЗначениеЗаполнено(Элемент.Данные) Тогда
				Элемент.Значение = Неопределено;
			КонецЕсли;
		ИначеЕсли Тип(Элемент) = Тип("ТабличноеПоле") Тогда
			//Элемент.ТолькоПросмотр = Истина;
			//Если Тип(Элемент.Значение) = Тип("ТаблицаЗначений") Тогда
			//ИначеЕсли Тип(Элемент.Значение) = Тип("ДокументТабличнаяЧасть.уб_ОтчетПоставщику.ПлатежныйДокумент") Тогда
			//ИначеЕсли Тип(Элемент.Значение) = Тип("ДокументСписок.уб_ОплатаПолисов") Тогда
			//КонецЕсли;
		ИначеЕсли Тип(Элемент) = Тип("Кнопка") ИЛИ Тип(Элемент) = Тип("КоманднаяПанель") ИЛИ Тип(Элемент) = Тип("Флажок") Тогда
			//Отключаем кнопки
			Элемент.Доступность = Ложь;
		Иначе
			//Сообщить(Элемент);
		КонецЕсли;
	КонецЦикла;
	ОтменитьТранзакцию();	
	уб_ИсторияИзмененияОбъектов.ЗаполнитьФормуДанными(Форма, ПараметрыВерсии, ДокументОбъект);	
	Возврат Форма;
	
КонецФункции

Функция ЗаполнитьФормуДанными(Форма, ПараметрыВерсии, СсылкаНаОбъект) Экспорт
	
	ДанныеОбъекта = уб_ИсторияИзмененияОбъектов.ПолучитьДанныеОбъектаНаДату(СсылкаНаОбъект, ПараметрыВерсии.ДатаВер);	
	Для Каждого Элемент Из Форма.ЭлементыФормы Цикл
		//Чистим значения полей
		Если ЗначениеЗаполнено(Элемент.Данные) Тогда
			Если Тип(Элемент) = Тип("ПолеВвода") ИЛИ Тип(Элемент) = Тип("Надпись") Тогда
				Попытка
					Элемент.Значение = ДанныеОбъекта[Элемент.Данные];
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			ИначеЕсли Тип(Элемент) = Тип("ТабличноеПоле") Тогда
				Если ТипЗнч(Форма.ДокументОбъект) = Тип("ДокументОбъект.уб_ОтчетПоставщику") И Элемент.Данные = "ПлатежныйДокумент" Тогда
					ОтчетПоставщикуЗаполнитьПлатежныйДокумент(Форма, ДанныеОбъекта, СсылкаНаОбъект);
				КонецЕсли;
				
				Если ТипЗнч(Форма.ДокументОбъект) = Тип("ДокументОбъект.уб_ОтчетПоставщику") И Элемент.Данные = "ОплатыСписок" Тогда
					ОтчетПоставщикуЗаполнитьОплатыСписок(Форма, ДанныеОбъекта, СсылкаНаОбъект);
				КонецЕсли;
			Иначе
				Сообщить(Элемент);
			КонецЕсли;				
		КонецЕсли;
	КонецЦикла;		
	Форма.Модифицированность = Ложь;
	
КонецФункции
	
Функция ОтчетПоставщикуЗаполнитьПлатежныйДокумент(Форма, ДанныеОбъекта, СсылкаНаОбъект)
	
	// Вывести платежные документы на дату версии
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ИсторияРеквизитТЧ.УИДСтрокиТЧ,
	|	уб_ИсторияРеквизитТЧ.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
	|	уб_ИсторияРеквизитТЧ.ЗначениеРеквизита,
	|	уб_ИсторияРеквизитТЧ.СтрокаУдалена
	|ИЗ
	|	РегистрСведений.уб_ИсторияРеквизитТЧ КАК уб_ИсторияРеквизитТЧ
	|ГДЕ
	|	уб_ИсторияРеквизитТЧ.Период <= &Период
	|	И уб_ИсторияРеквизитТЧ.ОбъектИстории = &ОбъектИстории
	|	И уб_ИсторияРеквизитТЧ.НаименованиеТЧ = &НаименованиеТЧ");
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектИстории",СсылкаНаОбъект);
	Запрос.УстановитьПараметр("НаименованиеТЧ","ПлатежныйДокумент");
	Выборка = Запрос.Выполнить().Выбрать();
	УИДСтрокиТЧ = "";	
	Пока Выборка.Следующий() Цикл
		Если УИДСтрокиТЧ <> Выборка.УИДСтрокиТЧ Тогда 
			НоваяСтрока = Форма.ПлатежныйДокумент.Добавить();
		КонецЕсли;
		НоваяСтрока[Выборка.НаименованиеРеквизита] = Выборка.ЗначениеРеквизита;
		УИДСтрокиТЧ = Выборка.УИДСтрокиТЧ;
	КонецЦикла;
	Форма.ЭлементыФормы.ПлатежныйДокумент.ТолькоПросмотр = Истина;
	
КонецФункции

Функция ОтчетПоставщикуЗаполнитьОплатыСписок(Форма, ДанныеОбъекта, СсылкаНаОбъект)
	
	ТаблицаОплат = Новый ТаблицаЗначений;
	НоваяСтрока = ТаблицаОплат.Добавить();
	Форма.ЭлементыФормы.ОплатыСписок.Данные = "";
	Форма.ЭлементыФормы.ОплатыСписок.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений");
	ФормаПустая = Документы.уб_ОтчетПоставщику.ПолучитьФорму();	
	Для Каждого Колонка Из ФормаПустая.ЭлементыФормы.ОплатыСписок.Колонки Цикл		
		НоваяКолонка = ТаблицаОплат.Колонки.Добавить(Колонка.Имя);
		НоваяКолонка = Колонка;        
	КонецЦикла;	
	Форма.ЭлементыФормы.ОплатыСписок.Значение = ТаблицаОплат;
	Форма.ЭлементыФормы.ОплатыСписок.СоздатьКолонки();	
	Для Каждого Колонка Из ФормаПустая.ЭлементыФормы.ОплатыСписок.Колонки Цикл
		НоваяКолонка = Форма.ЭлементыФормы.ОплатыСписок.Колонки.Найти(Колонка.Имя);
		НоваяКолонка.Положение = Колонка.Положение;        
	КонецЦикла;			
	Форма.ЭлементыФормы.ОплатыСписок.ТолькоПросмотр = Ложь;
	
КонецФункции

Функция ПолучитьЗапросСравненияВерсийОбъекта(
		ОбъектИстории, 		
		ТаблицаЛевыхРеквизитов = Неопределено, 
		ТаблицаПравыхРеквизитов = Неопределено, 
		ДатаЗапросаЛевая = Неопределено, 
		ДатаЗапросаПравая = Неопределено, 
		ТолькоИзмененныеРеквизиты = Истина, 
		ТолькоРезультатСравнения = Истина) Экспорт
	
	//НомераПакетов = Новый Структура;
	//Если ТолькоРезультатСравнения Тогда
	//	НомераПакетов.Вставить("РезультатСравнения", 3);
	//Иначе
	//	НомераПакетов.Вставить("СписокРеквизитов", 1);
	//	НомераПакетов.Вставить("ЛеваяТаблица", 3);
	//	НомераПакетов.Вставить("ПраваяТаблица", 5);
	//	НомераПакетов.Вставить("РезультатСравнения", 6);
	//КонецЕсли;
	ИмяМетаданныхОбъектаИстории = ОбъектИстории.Метаданные().Имя;	
	ЗаполнитьЛевуюТаблицу = Не ЗначениеЗаполнено(ТаблицаЛевыхРеквизитов);
	ЗаполнитьПравуюТаблицу = Не ЗначениеЗаполнено(ТаблицаПравыхРеквизитов);
	
	Если ЗаполнитьЛевуюТаблицу И ДатаЗапросаЛевая = Неопределено Тогда
		ДатаЗапросаЛевая = ПолучитьДатуПоследнейВерсии(ОбъектИстории);
	КонецЕсли;
	
	Если ЗаполнитьПравуюТаблицу И ДатаЗапросаПравая = Неопределено Тогда
		ЗаполнитьПравуюТаблицу = Ложь;
		ЗапросПравойТаблицы = Новый Запрос;		
		ИменаРеквизитов = ИменаРеквизитов(ИмяМетаданныхОбъектаИстории);
		ЗапросПравойТаблицы.Текст = "ВЫБРАТЬ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта КАК СсылкаРеквизита,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Синоним Как СинонимРеквизита,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита
		|Поместить ВТ_СписокРеквизитов
		|ИЗ
		|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
		|ГДЕ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код
		|	И уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|Выбрать
		|	ВТ_СписокРеквизитов.НаименованиеРеквизита,
		|	ВТ_СписокРеквизитов.СинонимРеквизита,
		|	ВТ_СписокРеквизитов.СсылкаРеквизита
		|	Из ВТ_СписокРеквизитов Как ВТ_СписокРеквизитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ "+ ИменаРеквизитов+" ИЗ Документ." + ИмяМетаданныхОбъектаИстории + " КАК Документ ГДЕ Документ.Ссылка = &ОбъектИстории";
		ЗапросПравойТаблицы.УстановитьПараметр("Код", ИмяМетаданныхОбъектаИстории);
		ЗапросПравойТаблицы.УстановитьПараметр("ОбъектИстории", ОбъектИстории);
		Пакет = ЗапросПравойТаблицы.ВыполнитьПакет();
		Выборка = Пакет[2].Выбрать();
		Если Выборка.Следующий() Тогда
			ТаблицаПравыхРеквизитов = Пакет[1].Выгрузить();
			ТаблицаПравыхРеквизитов.Колонки.Добавить("ЗначениеРеквизита", Метаданные.РегистрыСведений.уб_ИсторияРеквизит.Ресурсы.ЗначениеРеквизита.Тип);
			Для Каждого СтрокаТЗ Из ТаблицаПравыхРеквизитов Цикл
				СтрокаТЗ.ЗначениеРеквизита = Выборка[СтрокаТЗ.НаименованиеРеквизита];
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта КАК РеквизитОбъекта,
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита
	|Поместить ВТ_СписокРеквизитов
	|ИЗ
	|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
	|ГДЕ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код
	|	И уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения";
	Если Не ТолькоРезультатСравнения Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + "Выбрать
		|ВТ_СписокРеквизитов.НаименованиеРеквизита,
		|ВТ_СписокРеквизитов.РеквизитОбъекта
		|Из ВТ_СписокРеквизитов Как ВТ_СписокРеквизитов";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Код",ИмяМетаданныхОбъектаИстории);			
		
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|"+ ПолучитьТекстЗапросаЛевойТаблицы(ЗаполнитьЛевуюТаблицу, ТаблицаЛевыхРеквизитов, Запрос, ТолькоРезультатСравнения) + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|"+ ПолучитьТекстЗапросаПравойТаблицы(ЗаполнитьПравуюТаблицу, ТаблицаПравыхРеквизитов, Запрос, ТолькоРезультатСравнения) + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + ПолучитьТекстЗапросаСравненияТаблиц();
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаЗапросаПравая",Новый Граница(ДатаЗапросаПравая, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаЗапросаЛевая", Новый Граница(ДатаЗапросаЛевая, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);
	Запрос.УстановитьПараметр("ТолькоИзмененныеРеквизиты", ТолькоИзмененныеРеквизиты);
	Возврат Запрос;
	
КонецФункции


Функция ПолучитьТекстЗапросаЛевойТаблицы(ЗаполнитьТаблицу, Таблица, Запрос, ТолькоРезультатСравнения)
	Если ЗаполнитьТаблицу Тогда
		Текст = "ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта Как СсылкаРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Синоним Как СинонимРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование Как НаименованиеРеквизита
		|Поместить ВТ_ЛеваяТаблица
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(
		|			&ДатаЗапросаЛевая,
		|			ОбъектИстории = &ОбъектИстории
		|				И РеквизитОбъекта В (Выбрать Т.РеквизитОбъекта ИЗ ВТ_СписокРеквизитов Как Т)) КАК уб_ИсторияРеквизитСрезПоследних";
	Иначе
		Текст = "ВЫБРАТЬ
		|	ЛеваяТаблица.СсылкаРеквизита,
		|	ЛеваяТаблица.НаименованиеРеквизита,
		|	ЛеваяТаблица.СинонимРеквизита,
		|	ЛеваяТаблица.ЗначениеРеквизита
		|Поместить ВТ_ЛеваяТаблица
		|ИЗ
		|	&ЛеваяТаблица КАК ЛеваяТаблица";
		Запрос.УстановитьПараметр("ЛеваяТаблица", Таблица);
	КонецЕсли;
	Если Не ТолькоРезультатСравнения Тогда
		Текст = Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + "Выбрать
		|ВТ_ЛеваяТаблица.НаименованиеРеквизита,
		|ВТ_ЛеваяТаблица.СсылкаРеквизита,
		|ВТ_ЛеваяТаблица.СинонимРеквизита,
		|ВТ_ЛеваяТаблица.ЗначениеРеквизита
		|Из ВТ_ЛеваяТаблица Как ВТ_ЛеваяТаблица";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПолучитьТекстЗапросаПравойТаблицы(ЗаполнитьТаблицу, Таблица, Запрос, ТолькоРезультатСравнения)
	Если ЗаполнитьТаблицу Тогда		
		Текст = "ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта Как СсылкаРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Синоним Как СинонимРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование Как НаименованиеРеквизита
		|Поместить ВТ_ПраваяТаблица
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(
		|			&ДатаЗапросаПравая,
		|			ОбъектИстории = &ОбъектИстории
		|				И РеквизитОбъекта В (Выбрать Т.РеквизитОбъекта ИЗ ВТ_СписокРеквизитов Как Т)) КАК уб_ИсторияРеквизитСрезПоследних";				
	Иначе
		Текст = "ВЫБРАТЬ
		|	ПраваяТаблица.НаименованиеРеквизита,
		|	ПраваяТаблица.СсылкаРеквизита,
		|	ПраваяТаблица.СинонимРеквизита,
		|	ПраваяТаблица.ЗначениеРеквизита
		|Поместить ВТ_ПраваяТаблица
		|ИЗ
		|	&ПраваяТаблица КАК ПраваяТаблица";
		Запрос.УстановитьПараметр("ПраваяТаблица", Таблица);
	КонецЕсли;
	Если Не ТолькоРезультатСравнения Тогда
		Текст = Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + "Выбрать
		|ВТ_ПраваяТаблица.НаименованиеРеквизита,
		|ВТ_ПраваяТаблица.СсылкаРеквизита,
		|ВТ_ПраваяТаблица.СинонимРеквизита,
		|ВТ_ПраваяТаблица.ЗначениеРеквизита
		|Из ВТ_ПраваяТаблица Как ВТ_ПраваяТаблица";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПолучитьТекстЗапросаСравненияТаблиц()
	
	Возврат 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_ЛеваяТаблица.НаименованиеРеквизита, ВТ_ПраваяТаблица.НаименованиеРеквизита) КАК Реквизит,
	|	ЕСТЬNULL(ВТ_ЛеваяТаблица.СсылкаРеквизита, ВТ_ПраваяТаблица.СсылкаРеквизита) КАК СсылкаРеквизита,
	|	ЕСТЬNULL(ВТ_ЛеваяТаблица.СинонимРеквизита, ВТ_ПраваяТаблица.СинонимРеквизита) КАК СинонимРеквизита,
	|	ЕСТЬNULL(ВТ_ЛеваяТаблица.ЗначениеРеквизита, ""<Пустое значение>"") КАК ЛевоеЗначение,
	|	ЕСТЬNULL(ВТ_ПраваяТаблица.ЗначениеРеквизита, ""<Пустое значение>"") КАК ПравоеЗначение
	|ИЗ
	|	ВТ_ЛеваяТаблица КАК ВТ_ЛеваяТаблица
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ПраваяТаблица КАК ВТ_ПраваяТаблица
	|		ПО ВТ_ЛеваяТаблица.СсылкаРеквизита = ВТ_ПраваяТаблица.СсылкаРеквизита
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ТолькоИзмененныеРеквизиты
	|				ТОГДА ЕСТЬNULL(ВТ_ЛеваяТаблица.ЗначениеРеквизита, ""<Пустое значение>"") <> ЕСТЬNULL(ВТ_ПраваяТаблица.ЗначениеРеквизита, ""<Пустое значение>"")
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СинонимРеквизита,
	|	Реквизит";	
	
КонецФункции	

