//Функция получает список реквизитов по которым необходимо хранить историю
Функция ПолучитьСписокРеквизитов(ОбъектИстории) Экспорт

	СтруктураРеквизитов	= Новый Структура();
	СписокРеквизитов	= Новый СписокЗначений;
	
	//НайденныйДокумент = Справочники.уб_СписокОбъектовИстории.НайтиПоКоду(ОбъектИстории.Метаданные().Имя);
	//Если НЕ ЗначениеЗаполнено(НайденныйДокумент) Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	//СписокРеквизитов = НайденныйДокумент.СписокРеквизитов.Выгрузить(Новый Структура("ФиксироватьИзменения", Истина)).ВыгрузитьКолонку("НаименованиеРеквизита");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Синоним КАК СинонимРеквизита,
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта КАК Реквизит
	|ИЗ
	|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
	|ГДЕ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
	|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код";
	Запрос.УстановитьПараметр("Код",ОбъектИстории.Метаданные().Имя);
	ТабЗнач = Запрос.Выполнить().Выгрузить();
	//СписокРеквизитов = ТабЗнач.ВыгрузитьКолонку("НаименованиеРеквизита");
	//TO DD Неактуально
	//СписокРеквизитовТЧ = НайденныйДокумент.СписокРеквизитовТЧ.Выгрузить(Новый Структура("ФиксироватьИзменения", Истина));
	//СтруктураРеквизитов.Вставить("РеквизитыТЧ", СписокРеквизитовТЧ);
	СтруктураРеквизитов.Вставить("Реквизиты", ТабЗнач);
	Возврат СтруктураРеквизитов;
	
КонецФункции

Функция УстановитьВерсиюАктуальной(ОбъектИстории, ДатаВерсии) Экспорт
	
	НЗ = РегистрыСведений.уб_ИсторияОбъект.СоздатьНаборЗаписей();
	НЗ.Отбор.ОбъектИстории.Установить(ОбъектИстории);
	НЗ.Прочитать();	
	Для Каждого СтрокаНЗ Из НЗ Цикл
		Если  ДатаВерсии = СтрокаНЗ.Период Тогда
			СтрокаНЗ.ВерсияАктуальна = Истина;
		Иначе
			СтрокаНЗ.ВерсияАктуальна = Ложь;
		КонецЕсли;
	КонецЦикла;	
	НЗ.Записать();
	
КонецФункции

Функция ТекущаяВерсияДокументаАктуальна(ОбъектИстории) Экспорт
	
	ПоследняяВерсия = РегистрыСведений.уб_ИсторияОбъект.ПолучитьПоследнее(, Новый Структура("ОбъектИстории", ОбъектИстории));	
	Если Не ПоследняяВерсия.ВерсияАктуальна Тогда		
		Возврат Ложь;
	Иначе
		ДатаАктуальнойВерсии = ПолучитьДатуАктуальнойВерсии(ОбъектИстории);
		//СтруктураАктуальнойВерсии	= DDПолучитьСтруктуруОбъекта(ОбъектИстории, ДатаАктуальнойВерсии);
		//СтруктураТекущейВерсии		= DDПолучитьСтруктуруОбъекта(ОбъектИстории);
		СписокРеквизитов 		  = Новый Структура;		
		СтруктураТекущейВерсии 	  = Новый Структура;
		СтруктураАктуальнойВерсии = Новый Структура;
		СтруктураПараметров 	  = Новый Структура;
		СтруктураПараметров.Вставить("Объект", ОбъектИстории);
		СтруктураПараметров.Вставить("ДатаПредВерсии", ДатаАктуальнойВерсии);
		СтруктураПараметров.Вставить("ДатаВерсии", Неопределено);
		СтруктураПараметров.Вставить("ВключитьПодчиненныеДокументы", Истина);
		уб_ИсторияИзмененияОбъектов.ЗаполнитьСтруктурыДляСравнения(СтруктураПараметров, СтруктураАктуальнойВерсии, СтруктураТекущейВерсии, СписокРеквизитов);
		СтруктураРазличий 		  = уб_ИсторияИзмененияОбъектов.DDПолучитьТаблицуРазличий(ОбъектИстории, СтруктураАктуальнойВерсии, СтруктураТекущейВерсии, СписокРеквизитов);
		//аа = СтруктураРазличий.Получить("ПодчиненныеДокументы");//???
		Если СтруктураРазличий.Количество() > 0 Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

//Формируем список версий истории объекта
Функция ПолучитьВерсииИсторииОбъекта(ОбъектИстории) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ИсторияОбъект.Период КАК ДатаВерсии,
	|	уб_ИсторияОбъект.НомерВерсии КАК НомерВерсии,
	|	уб_ИсторияОбъект.ВерсияАктуальна КАК АктуальностьВерсии,
	|	уб_ПередачаОтчетаПоставщикуВБухгалтерию.ДатаПередачи КАК ПереданВБухгалтерию,
	|	уб_ИсторияОбъект.Комментарий,
	|	уб_ИсторияОбъект.НезначительныеИзменения,
	|	уб_ИсторияОбъект.Пользователь КАК Автор,
	|	уб_ПринятыеКОплатеОтчетыПоставщику.ДатаПринятия КАК ПринятВБухгалтерии,
	|	уб_ПринятыеКОплатеОтчетыПоставщику.Пользователь КАК ПринялПользователь
	|ИЗ
	|	РегистрСведений.уб_ИсторияОбъект КАК уб_ИсторияОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ПередачаОтчетаПоставщикуВБухгалтерию КАК уб_ПередачаОтчетаПоставщикуВБухгалтерию
	|		ПО уб_ИсторияОбъект.ОбъектИстории = уб_ПередачаОтчетаПоставщикуВБухгалтерию.ОтчетПоставщику
	|			И уб_ИсторияОбъект.Период = уб_ПередачаОтчетаПоставщикуВБухгалтерию.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ПринятыеКОплатеОтчетыПоставщику КАК уб_ПринятыеКОплатеОтчетыПоставщику
	|		ПО уб_ИсторияОбъект.ОбъектИстории = уб_ПринятыеКОплатеОтчетыПоставщику.ОтчетПоставщику
	|			И уб_ИсторияОбъект.Период = уб_ПринятыеКОплатеОтчетыПоставщику.Период
	|ГДЕ
	|	уб_ИсторияОбъект.ОбъектИстории = &ОбъектИстории");	
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);	
	СписокВерсий = Запрос.Выполнить().Выгрузить();	
	СписокВерсий.Колонки.Добавить("ИтогОС_НачисленнаяСуммаВзноса");
	СписокВерсий.Колонки.Добавить("ИтогОС_КВ");
	СписокВерсий.Колонки.Добавить("КоличествоСтрокОплат");	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ИтогОС_НачисленнаяСуммаВзноса");
	МассивРеквизитов.Добавить("ИтогОС_КВ");
	МассивРеквизитов.Добавить("КоличествоСтрокОплат");	
	Для Каждого Строка Из СписокВерсий Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование Как НаименованиеРеквизита
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(
		|			&Дата,
		|			ОбъектИстории = &ОбъектИстории
		|				И РеквизитОбъекта.Наименование В (&МассивРеквизитов)) КАК уб_ИсторияРеквизитСрезПоследних";
		Запрос.УстановитьПараметр("ОбъектИстории",ОбъектИстории);
		Запрос.УстановитьПараметр("МассивРеквизитов",МассивРеквизитов);	
		Запрос.УстановитьПараметр("Дата",Строка.ДатаВерсии);	
		Выборка = Запрос.Выполнить().Выбрать();                                     
		Пока Выборка.Следующий() Цикл
