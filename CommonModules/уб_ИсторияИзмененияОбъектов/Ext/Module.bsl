	Параметры.Вставить("ВключитьПодчиненныеДокументы",	Истина);
	уб_ИсторияИзмененияОбъектов.ЗаполнитьСтруктурыДляСравнения(Параметры, СтруктураПоследнейВерсии, СтруктураТекущейВерсии, СписокРеквизитов);
