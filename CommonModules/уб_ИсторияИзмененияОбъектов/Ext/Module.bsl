Процедура ДополнитьТекстЗапросаСписокРеквизитов(Запрос, СтруктураПакетов, ОбъектИстории, МассивЗапрещенныхРеквизитов = Неопределено)
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|";
	КонецЕсли;
	Если МассивЗапрещенныхРеквизитов = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта КАК Реквизит,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.СинонимРеквизита
		|ИЗ
		|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
		|ГДЕ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
		|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код";
	Иначе
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта КАК Реквизит,
		|	уб_СписокОбъектовИсторииСписокРеквизитов.СинонимРеквизита
		|ПОМЕСТИТЬ ВТ_СписокРеквизитов
		|ИЗ
		|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
		|ГДЕ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
		|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код
		|	И НЕ уб_СписокОбъектовИсторииСписокРеквизитов.НаименованиеРеквизита В (&МассивЗапрещенныхРеквизитов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписокРеквизитов.НаименованиеРеквизита,
		|	ВТ_СписокРеквизитов.Реквизит,
		|	ВТ_СписокРеквизитов.СинонимРеквизита
		|ИЗ
		|	ВТ_СписокРеквизитов КАК ВТ_СписокРеквизитов";
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
		Запрос.УстановитьПараметр("МассивЗапрещенныхРеквизитов", МассивЗапрещенныхРеквизитов);
	КонецЕсли;
	Запрос.УстановитьПараметр("Код",ОбъектИстории.Метаданные().Имя);
	СтруктураПакетов.Вставить("СписокРеквизитов",СтруктураПакетов.НомерСледующегоПакета);
	СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаИсториейОбъекта(Запрос, СтруктураПакетов, ОбъектИстории, ДатаВерсииИсторииОбъекта = Неопределено, ИмяПараметраДаты, ВключитьПодчиненныеДокументы = Истина, МассивЗапрещенныхРеквизитов = Неопределено)
	
	Если ДатаВерсииИсторииОбъекта <> Неопределено Тогда
		ДополнитьТекстЗапросаДанныхОбъектаИзИстории(Запрос, СтруктураПакетов, ОбъектИстории, ДатаВерсииИсторииОбъекта, ИмяПараметраДаты, ВключитьПодчиненныеДокументы, МассивЗапрещенныхРеквизитов);
	Иначе
		ДополнитьТекстЗапросаТекущихДанныеОбъекта(Запрос, СтруктураПакетов, ОбъектИстории, ИмяПараметраДаты, ВключитьПодчиненныеДокументы);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруИзПакета(Пакет, СтруктураПакетов, ДатаВерсииИсторииОбъекта, ИмяПараметраДаты, ОбъектИстории, ВключитьПодчиненныеДокументы = Истина, СписокРеквизитов)
	
	СтруктураОбъектаИстории = Новый Структура();
	//Если ЗначениеЗаполнено(ДатаВерсииИсторииОбъекта) Тогда
	Если ДатаВерсииИсторииОбъекта <> Неопределено Тогда
		СтруктураОбъектаИстории.Вставить("ДатаВерсииСтруктуры",ДатаВерсииИсторииОбъекта);		
		Выборка = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ИсторияОбъекта"]].Выбрать();
		//Заполняем структуру данными из регистра уб_ИсторияРеквизит
		Пока Выборка.Следующий() Цикл
			СтруктураОбъектаИстории.Вставить(Выборка.НаименованиеРеквизита, Выборка.ЗначениеРеквизита);
		КонецЦикла;
		//получаем данные всех оплат и вставляем в 				
		ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
		Если ВключитьПодчиненныеДокументы И ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
			//Получаем список оплат из регистра уб_ИсторияРеквизит, на момент истории входящих в Отчет Поставщику		
			Оплата = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_СписокОплатИзИстории"]].Выбрать();//документы оплаты		
			ВыборкаОплат = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ИсторияРеквизитовСпискаОплатИстория"]].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);//выборка истории для оплат
			//Для каждой оплаты получаем структуру ее значений и добавляем в таблицу подчиненных документов
			Пока Оплата.Следующий() Цикл
				//уб_ИсторияИзмененияОбъектов.DDПолучитьДанныеОбъектаИзИстории(Оплата.ОплатаПолиса, ДатаВерсииИсторииОбъекта, СтруктураОплаты);
				СтруктураОплаты = Новый Структура();
				ПолучитьСтруктуруОплаты(Оплата.ОплатаПолиса, ДатаВерсииИсторииОбъекта, СтруктураОплаты, ВыборкаОплат);
				НовСтр								= ТаблицаПодчиненныхДокументов.Добавить();
				НовСтр.ПодчиненныйДокументСсылка	= Оплата.ОплатаПолиса;
				НовСтр.ПодчиненныйДокументСтруктура	= СтруктураОплаты;
			КонецЦикла;
			СтруктураОбъектаИстории.Вставить("ВыборкаДанныхСтраховыхПолисов", Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ТекущиеДанныеСтраховыхПолисовСпискаОплатИстории"]].Выбрать());
		КонецЕсли;
		//Вставляем таблицу подчиненных документов в структуру Отчета поставщику
		СтруктураОбъектаИстории.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
	Иначе
		СтруктураОбъектаИстории.Вставить("ДатаВерсииСтруктуры",Дата(1,1,1));
		Выборка = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ТекущиеДанныеОбъекта"]].Выбрать();
		Выборка.Следующий();
		//ВыборкаРеквизитов = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_СписокРеквизитов"]].Выбрать();
		////Получаем значение реквизитов объекта из текущего объекта
		//Пока ВыборкаРеквизитов.Следующий() Цикл
		//	ЗначениеРевизита = Выборка[ВыборкаРеквизитов.НаименованиеРеквизита];
		//	СтруктураОбъектаИстории.Вставить(ВыборкаРеквизитов.НаименованиеРеквизита, ЗначениеРевизита);
		//КонецЦикла;
		Для Каждого СтрокаСпискаРеквизитов Из СписокРеквизитов.Реквизиты Цикл
			ЗначениеРевизита = Выборка[СтрокаСпискаРеквизитов.НаименованиеРеквизита];
			СтруктураОбъектаИстории.Вставить(СтрокаСпискаРеквизитов.НаименованиеРеквизита, ЗначениеРевизита);
		КонецЦикла;
			
		ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
		Если ВключитьПодчиненныеДокументы И ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда//Если это отчет поставщику, получаем данные всех оплат и вставляем в
			Оплата = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ТекущиеДанныеОплатПолисов"]].Выбрать();
			ВыборкаРеквизитов = Пакет[СтруктураПакетов[ИмяПараметраДаты + "_СписокРеквизитовДокументаОплаты"]].Выбрать();
			Пока Оплата.Следующий() Цикл
				СтруктураОплаты = Новый Структура();
				ВыборкаРеквизитов.Сбросить();
				Пока ВыборкаРеквизитов.Следующий() Цикл
					СтруктураОплаты.Вставить(ВыборкаРеквизитов.НаименованиеРеквизита, Оплата[ВыборкаРеквизитов.НаименованиеРеквизита]);
				КонецЦикла;
				НовСтр								= ТаблицаПодчиненныхДокументов.Добавить();
				НовСтр.ПодчиненныйДокументСсылка	= Оплата.Ссылка;
				НовСтр.ПодчиненныйДокументСтруктура	= СтруктураОплаты;
			КонецЦикла;
			СтруктураОбъектаИстории.Вставить("ВыборкаДанныхСтраховыхПолисов", Пакет[СтруктураПакетов[ИмяПараметраДаты + "_ТекущиеДанныеСтраховыхПолисовТекущегоСпискаОплат"]].Выбрать());
		КонецЕсли;
		//Вставляем таблицу подчиненных документов в структуру Отчета поставщику
		СтруктураОбъектаИстории.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
	КонецЕсли;
	Возврат СтруктураОбъектаИстории;
	
КонецФункции

Процедура ДополнитьТекстЗапросаДанныхОбъектаИзИстории(Запрос, СтруктураПакетов, ОбъектИстории, ДатаВерсииИсторииОбъекта, ИмяПараметраДаты, ВключитьПодчиненныеДокументы = Истина, МассивЗапрещенныхРеквизитов = Неопределено)
	
	//ИмяПараметраТекущаяДата = "ТекущаяДата";
	//ТекущаяДата = ТекущаяДата();
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
	|	уб_ИсторияРеквизитСрезПоследних.Период,
	|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории,
	|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
	|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита
	|ИЗ
	|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&" + ИмяПараметраДаты + ", ОбъектИстории = &ОбъектИстории" + ?(МассивЗапрещенныхРеквизитов <> Неопределено,"
					|		И РеквизитОбъекта В
					|		(ВЫБРАТЬ
					|			Т.Реквизит
					|		ИЗ
					|  			ВТ_СписокРеквизитов КАК Т)"," И НЕ РеквизитОбъекта = ЗНАЧЕНИЕ(Справочник.уб_РеквизитыОбъектов.ПустаяСсылка)") + ") КАК уб_ИсторияРеквизитСрезПоследних";
	//здесь берется не дата последней версии, а текущая дата
	Запрос.УстановитьПараметр(ИмяПараметраДаты, ДатаВерсииИсторииОбъекта);
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);

	СтруктураПакетов.Вставить(ИмяПараметраДаты + "_ИсторияОбъекта", СтруктураПакетов.НомерСледующегоПакета);
	СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
	Если ВключитьПодчиненныеДокументы И ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ Различные
		|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории КАК ОплатаПолиса
		|   Поместить ВТ_ОплатыПолисов" + ИмяПараметраДаты + " 
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&" + ИмяПараметраДаты + ", РеквизитОбъекта.Наименование = ""ОтчетПоставщику"") КАК уб_ИсторияРеквизитСрезПоследних
		|ГДЕ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита = &ОбъектИстории
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОплатыПолисов.ОплатаПолиса КАК ОплатаПолиса
		|Из 
		|	ВТ_ОплатыПолисов" + ИмяПараметраДаты + " Как ВТ_ОплатыПолисов";
		
		СтруктураПакетов.Вставить(ИмяПараметраДаты + "_СписокОплатИзИстории", СтруктураПакетов.НомерСледующегоПакета+1);
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 2;
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.Период,
		|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории Как ОплатаПолиса,
		|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита
		|Поместить ВТ_ИсторияОплатПолисов" + ИмяПараметраДаты + "
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&" + ИмяПараметраДаты + ", ОбъектИстории В (Выбрать Т.ОплатаПолиса Из ВТ_ОплатыПолисов" + ИмяПараметраДаты + " Как Т) 
		|	И НЕ РеквизитОбъекта = ЗНАЧЕНИЕ(Справочник.уб_РеквизитыОбъектов.ПустаяСсылка)) КАК уб_ИсторияРеквизитСрезПоследних
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИсторияОплатПолисов.Период КАК Период,
		|	ВТ_ИсторияОплатПолисов.ОплатаПолиса Как ОплатаПолиса,
		|	ВТ_ИсторияОплатПолисов.НаименованиеРеквизита КАК НаименованиеРеквизита,
		|	ВТ_ИсторияОплатПолисов.ЗначениеРеквизита
		|Из 
		|	ВТ_ИсторияОплатПолисов" + ИмяПараметраДаты + " Как ВТ_ИсторияОплатПолисов
		|Итоги По ОплатаПолиса
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ		
		|	ВТ_ИсторияОплатПолисов.ЗначениеРеквизита
		|Поместить ВТ_СтраховыеПолисыИзОплат" + ИмяПараметраДаты + "
		|Из 
		|	ВТ_ИсторияОплатПолисов" + ИмяПараметраДаты + " Как ВТ_ИсторияОплатПолисов
		|ГДЕ
		|	ВТ_ИсторияОплатПолисов.НаименованиеРеквизита = ""СтраховойПолис""
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ
		|	уб_СтраховойПолис.Ссылка,
		|	уб_СтраховойПолис.Страхователь,
		|	уб_СтраховойПолис.Поставщик,
		|	уб_СтраховойПолис.Дата,
		|	уб_СтраховойПолис.Номер,
		|	уб_СтраховойПолис.ДатаНачала,
		|	уб_СтраховойПолис.ДатаОкончания,
		|	уб_СтраховойПолис.СтраховаяПремия,
		|	уб_СтраховойПолис.БСО.(
		|		Ссылка,
		|		НомерСтроки,
		|		ВидБСО,
		|		НомерБСО,
		|		НомерПолиса,
		|		Обязательно,
		|		Оформлен,
		|		НазначениеБСО,
		|		Агент,
		|		ВидБСО.ТипУчетаБСО КАК ТипУчетаБСО
		|	) КАК БСО
		|ИЗ
		|	ВТ_СтраховыеПолисыИзОплат" + ИмяПараметраДаты + " КАК ВТ_СтраховыеПолисыИзОплат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		|		ПО (ВТ_СтраховыеПолисыИзОплат.ЗначениеРеквизита = уб_СтраховойПолис.Ссылка)";
		СтруктураПакетов.Вставить(ИмяПараметраДаты+"_ИсторияРеквизитовСпискаОплатИстория", СтруктураПакетов.НомерСледующегоПакета+1);
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 2;
		СтруктураПакетов.Вставить(ИмяПараметраДаты+"_ТекущиеДанныеСтраховыхПолисовСпискаОплатИстории", СтруктураПакетов.НомерСледующегоПакета+1);
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 2;
		//Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьТекстЗапросаТекущихДанныеОбъекта(Запрос, СтруктураПакетов, ОбъектИстории, ИмяПараметраДаты, ВключитьПодчиненныеДокументы = Истина)
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|";
	КонецЕсли;
	
	
	ИмяМета = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектИстории)).Имя;
	ИменаРеквизитов =  ИменаРеквизитов(ИмяМета);
	
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ "+ ИменаРеквизитов +" ИЗ Документ." + ИмяМета +" КАК Документ ГДЕ	Документ.Ссылка = &Ссылка";
	//|
	//|;
	//|///////////////////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование Как НаименованиеРеквизита 
	//|ИЗ
	//|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
	//|ГДЕ
	//|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
	//|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код";
	//Запрос.УстановитьПараметр("Код",ОбъектИстории.Метаданные().Имя);
	Запрос.УстановитьПараметр("Ссылка", ОбъектИстории);
	СтруктураПакетов.Вставить(ИмяПараметраДаты + "_ТекущиеДанныеОбъекта", СтруктураПакетов.НомерСледующегоПакета);
	СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
	//СтруктураПакетов.Вставить(ИмяПараметраДаты + "_СписокРеквизитов", СтруктураПакетов.НомерСледующегоПакета);
	//СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
	Если ВключитьПодчиненныеДокументы И ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
		ИменаРеквизитов = ИменаРеквизитов("уб_ОплатаПолисов");//"*";
		
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|" + "ВЫБРАТЬ "+ИменаРеквизитов+"
		|Поместить ВТ_ТекущиеДанныеОплатПолисов
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК Документ ГДЕ Документ.ОтчетПоставщику = &Ссылка
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|Выбрать * Из ВТ_ТекущиеДанныеОплатПолисов Как ВТ_ТекущиеДанныеОплатПолисов
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ
		|	уб_СтраховойПолис.Ссылка,
		|	уб_СтраховойПолис.Страхователь,
		|	уб_СтраховойПолис.Поставщик,
		|	уб_СтраховойПолис.Дата,
		|	уб_СтраховойПолис.Номер,
		|	уб_СтраховойПолис.ДатаНачала,
		|	уб_СтраховойПолис.ДатаОкончания,
		|	уб_СтраховойПолис.СтраховаяПремия,
		|	уб_СтраховойПолис.БСО.(
		|		Ссылка,
		|		НомерСтроки,
		|		ВидБСО,
		|		НомерБСО,
		|		НомерПолиса,
		|		Обязательно,
		|		Оформлен,
		|		НазначениеБСО,
		|		Агент,
		|		ВидБСО.ТипУчетаБСО КАК ТипУчетаБСО
		|	) КАК БСО
		|ИЗ
		|	ВТ_ТекущиеДанныеОплатПолисов КАК ВТ_ТекущиеДанныеОплатПолисов
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		|ПО ВТ_ТекущиеДанныеОплатПолисов.СтраховойПолис = уб_СтраховойПолис.Ссылка
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование Как НаименованиеРеквизита
		|ИЗ
		|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
		|ГДЕ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
		|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &КодОплатаПолисов";
		Запрос.УстановитьПараметр("КодОплатаПолисов","уб_ОплатаПолисов");//Метаданные.Документы.уб_ОплатаПолисов.Имя
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
		СтруктураПакетов.Вставить(ИмяПараметраДаты + "_ТекущиеДанныеОплатПолисов", СтруктураПакетов.НомерСледующегоПакета);
		
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
		СтруктураПакетов.Вставить(ИмяПараметраДаты + "_ТекущиеДанныеСтраховыхПолисовТекущегоСпискаОплат", СтруктураПакетов.НомерСледующегоПакета);
		
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
		СтруктураПакетов.Вставить(ИмяПараметраДаты + "_СписокРеквизитовДокументаОплаты", СтруктураПакетов.НомерСледующегоПакета);
		СтруктураПакетов.НомерСледующегоПакета = СтруктураПакетов.НомерСледующегоПакета + 1;
	КонецЕсли;
КонецПроцедуры

Процедура ПолучитьСтруктуруОплаты(ОплатаПолиса, ДатаВерсииИсторииОбъекта,СтруктураОплаты, ВыборкаОплат);

	СтруктураОплаты.Вставить("ДатаВерсииСтруктуры",ДатаВерсииИсторииОбъекта);
	ВыборкаОплат.Сбросить();
	Отбор = Новый Структура("ОплатаПолиса", ОплатаПолиса);
	Если ВыборкаОплат.НайтиСледующий(Отбор) Тогда
		ДетальныеЗаписи = ВыборкаОплат.Выбрать();
		Пока ДетальныеЗаписи.Следующий() Цикл
			СтруктураОплаты.Вставить(ДетальныеЗаписи.НаименованиеРеквизита, ДетальныеЗаписи.ЗначениеРеквизита);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ИменаРеквизитов(ИмяМета)
	//Исходи из того, что имена актуальны в справочнике, в том числе и общие реквизиты
	Запрос = Новый Запрос ("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                       |	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование как НаименованиеРеквизита
	                       |ИЗ
	                       |	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
	                       |ГДЕ
	                       |	уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &ИмяМета
	                       |	И уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения = ИСТИНА");
	Запрос.УстановитьПараметр("ИмяМета",ИмяМета);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоВВыборке = Выборка.Количество();
	ИменаРеквизитов = "";
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик+1;
		Если Счетчик = 1 Тогда
			ИменаРеквизитов = "Ссылка, ";
		КонецЕсли;	
		ИменаРеквизитов = ИменаРеквизитов+""+Выборка.НаименованиеРеквизита+?(Счетчик=КоличествоВВыборке,"",", ");
	КонецЦикла;
	Если КоличествоВВыборке >0 Тогда
		
		ЗапросТест = Новый Запрос;
		ЗапросТест.Текст = "Выбрать Первые 1 "+ИменаРеквизитов +" из Документ."+ИмяМета;
		Попытка
			Выборка2 = ЗапросТест.Выполнить();	
		Исключение
			ИменаРеквизитов = "";
		КонецПопытки;
		
	КонецЕсли;
	Возврат ?(ИменаРеквизитов="","*",ИменаРеквизитов);
КонецФункции
