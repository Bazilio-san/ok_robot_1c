                     
Функция DDПолучитьСтруктуруОбъекта(ОбъектИстории, ДатаВерсииИсторииОбъекта = Неопределено) Экспорт
	
	СтруктураОбъектаИстории = Новый Структура();
	//Если дата пустая получаем структуру текущего документа
	Если ЗначениеЗаполнено(ДатаВерсииИсторииОбъекта) Тогда
		DDПолучитьДанныеОбъектаИзИстории(ОбъектИстории, ДатаВерсииИсторииОбъекта, СтруктураОбъектаИстории);
	Иначе
		DDПолучитьТекущиеДанныеОбъекта(ОбъектИстории, СтруктураОбъектаИстории);
	КонецЕсли;
	Возврат СтруктураОбъектаИстории;
	
КонецФункции

//TO DD Выбирать только реквизиты у которых стоит флаг фиксировать? сейчас делает срез последних из уб_ИсторияРевизита
Функция DDПолучитьДанныеОбъектаИзИстории(ОбъектИстории, ДатаВерсииИсторииОбъекта, СтруктураОбъектаИстории) Экспорт
	
	СтруктураОбъектаИстории.Вставить("ДатаВерсииСтруктуры",ДатаВерсииИсторииОбъекта);
	ЭтоОтчетПоставщику = ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	//Получаем значение реквизитов объекта из регистра ИсторияРеквизитов
	//ТаблицаЗначенийРеквизитов = РегистрыСведений.уб_ИсторияРеквизит.СрезПоследних(ДатаВерсииИсторииОбъекта,  Новый Структура("ОбъектИстории", ОбъектИстории));
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	уб_ИсторияРеквизитСрезПоследних.Период,
	|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории,
	|	уб_ИсторияРеквизитСрезПоследних.РеквизитОбъекта.Наименование КАК НаименованиеРеквизита,
	|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита
	|ИЗ
	|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&ДатаВерсииИсторииОбъекта, ОбъектИстории = &ОбъектИстории И НЕ РеквизитОбъекта = ЗНАЧЕНИЕ(Справочник.уб_РеквизитыОбъектов.ПустаяСсылка)) КАК уб_ИсторияРеквизитСрезПоследних";
	Запрос.УстановитьПараметр("ДатаВерсииИсторииОбъекта", ДатаВерсииИсторииОбъекта);
	Запрос.УстановитьПараметр("ОбъектИстории", ОбъектИстории);
	//ТаблицаЗначенийРеквизитов = Запрос.Выполнить().Выгрузить();
	Если ЭтоОтчетПоставщику Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории КАК ОплатаПолиса
		|ИЗ
		|	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(&ДатаВерсииИсторииОбъекта, РеквизитОбъекта.Наименование = ""ОтчетПоставщику"") КАК уб_ИсторияРеквизитСрезПоследних
		|ГДЕ
		|	уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита = &ОбъектИстории";
	КонецЕсли;	
	РезультатПакета = Запрос.ВыполнитьПакет();
	Выборка = РезультатПакета[0].Выбрать();
	//Заполняем структуру данными из регистра уб_ИсторияРеквизит
	Пока Выборка.Следующий() Цикл
		СтруктураОбъектаИстории.Вставить(Выборка.НаименованиеРеквизита, Выборка.ЗначениеРеквизита);
	КонецЦикла;
	//Если это отчет поставщику, получаем данные всех оплат и вставляем в 
	Если ЭтоОтчетПоставщику Тогда
		ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
		//Получаем список оплат из регистра уб_ИсторияРеквизит, на момент истории входящих в Отчет Поставщику
		//СписокОплат = Запрос.Выполнить().Выгрузить();
		Оплата = РезультатПакета[1].Выбрать();
		//Для каждой оплаты получаем структуру ее значений и добавляем в таблицу подчиненных документов
		Пока Оплата.Следующий() Цикл
			СтруктураОплаты = Новый Структура();
			DDПолучитьДанныеОбъектаИзИстории(Оплата.ОплатаПолиса, ДатаВерсииИсторииОбъекта, СтруктураОплаты);
			НовСтр = ТаблицаПодчиненныхДокументов.Добавить();
			НовСтр.ПодчиненныйДокументСсылка	= Оплата.ОплатаПолиса;
			НовСтр.ПодчиненныйДокументСтруктура	= СтруктураОплаты;
		КонецЦикла;
		//Вставляем таблицу подчиненных документов в структуру Отчета поставщику
		СтруктураОбъектаИстории.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
	КонецЕсли;
	
КонецФункции

Функция DDПолучитьТекущиеДанныеОбъекта(ОбъектИстории, СтруктураОбъектаИстории)
	
	СтруктураОбъектаИстории.Вставить("ДатаВерсииСтруктуры", Дата(1,1,1));
	//Получим список реквизитов объекта, по которым ведется история
	ЭтоОтчетПоставщику = ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	ИмяМета = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектИстории)).Имя;
	ИменаРеквизитов = ИменаРеквизитов(ИмяМета);
	Запрос = Новый Запрос("ВЫБРАТЬ "+ИменаРеквизитов+" ИЗ Документ." + ИмяМета + " КАК Документ ГДЕ	Документ.Ссылка = &Ссылка
	|
	|;
	|///////////////////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование Как НаименованиеРеквизита 
	|ИЗ
	|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
	|ГДЕ
	|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
	|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &Код");
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектИстории);
	Если ЭтоОтчетПоставщику Тогда
		ИменаРеквизитов = ИменаРеквизитов("уб_ОплатаПолисов");
		Запрос.Текст = Запрос.Текст + "
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ "+ИменаРеквизитов+" ИЗ Документ.уб_ОплатаПолисов КАК Документ ГДЕ Документ.ОтчетПоставщику = &Ссылка
		|
		|;
		|///////////////////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.РеквизитОбъекта.Наименование Как НаименованиеРеквизита 
		|ИЗ
		|	Справочник.уб_СписокОбъектовИстории.СписокРеквизитов КАК уб_СписокОбъектовИсторииСписокРеквизитов
		|ГДЕ
		|	уб_СписокОбъектовИсторииСписокРеквизитов.ФиксироватьИзменения
		|	И уб_СписокОбъектовИсторииСписокРеквизитов.Ссылка.Код = &КодОплатаПолисов";
		Запрос.УстановитьПараметр("КодОплатаПолисов","уб_ОплатаПолисов");//Метаданные.Документы.уб_ОплатаПолисов.Имя
		Запрос.УстановитьПараметр("Код", "уб_ОтчетПоставщику");
	Иначе
		Запрос.УстановитьПараметр("Код", ОбъектИстории.Метаданные().Имя);
	КонецЕсли;
	РезультатПакета = Запрос.ВыполнитьПакет();
	Выборка = РезультатПакета[0].Выбрать();
	Выборка.Следующий();
	ВыборкаРеквизитов = РезультатПакета[1].Выбрать();
	//Получаем значение реквизитов объекта из текущего объекта
	Пока ВыборкаРеквизитов.Следующий() Цикл
		ЗначениеРевизита = Выборка[ВыборкаРеквизитов.НаименованиеРеквизита];
		СтруктураОбъектаИстории.Вставить(ВыборкаРеквизитов.НаименованиеРеквизита, ЗначениеРевизита);
	КонецЦикла;
	//Если это отчет поставщику, получаем данные всех оплат и вставляем в
	Если ЭтоОтчетПоставщику Тогда
		ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
		ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
		Оплата = РезультатПакета[2].Выбрать();
		ВыборкаРеквизитов = РезультатПакета[3].Выбрать();
		Пока Оплата.Следующий() Цикл
			СтруктураОплаты = Новый Структура();
			ВыборкаРеквизитов.Сбросить();
			Пока ВыборкаРеквизитов.Следующий() Цикл
				ЗначениеРевизита = Оплата[ВыборкаРеквизитов.НаименованиеРеквизита];
				СтруктураОплаты.Вставить(ВыборкаРеквизитов.НаименованиеРеквизита, ЗначениеРевизита);
			КонецЦикла;
			НовСтр = ТаблицаПодчиненныхДокументов.Добавить();
			НовСтр.ПодчиненныйДокументСсылка	= Оплата.Ссылка;
			НовСтр.ПодчиненныйДокументСтруктура	= СтруктураОплаты;
		КонецЦикла;
		//Вставляем таблицу подчиненных документов в структуру Отчета поставщику
		СтруктураОбъектаИстории.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
	КонецЕсли;

КонецФункции

Функция DDПолучитьТаблицуРазличий(ОбъектИстории, ЛеваяСторона, ПраваяСторона, СписокРеквизитовОбъекта = Неопределено, ТолькоРазличающиесяЗначения = Истина) Экспорт
	
	СтруктураИзменений = Новый Соответствие();	
	//Если переданы не структуры, возвращаем пустую структуру
	//Если ТипЗнч(ЛеваяСторона) <> Тип("Структура") Или ТипЗнч(ПраваяСторона) <> Тип("Структура") ИЛИ НЕ ЗначениеЗаполнено(ОбъектИстории) Или Не ЗначениеЗаполнено(ПраваяСторона) Или Не ЗначениеЗаполнено(ЛеваяСторона) Тогда
	//	Сообщить("Переданы некорректные параметры!!!");
	//	Возврат СтруктураИзменений;
	//КонецЕсли;
	ЭтоОтчетПоставщику = ТипЗнч(ОбъектИстории) = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	КоличествоВСтруктуре = ?(ЭтоОтчетПоставщику, 2, 1);
	//Если Не ЗначениеЗаполнено(СписокРеквизитовОбъекта) Тогда
	Если СписокРеквизитовОбъекта = Неопределено Тогда
		СписокРеквизитовОбъекта = ПолучитьСписокРеквизитов(ОбъектИстории);
	КонецЕсли;
	//Перебор реквизитов объекта истории
	ЛеваяСторонаЗаполнена 	= ЛеваяСторона <> Неопределено И ЛеваяСторона.Количество() > КоличествоВСтруктуре;
	ПраваяСторонаЗаполнена  = ПраваяСторона <> Неопределено И ПраваяСторона.Количество() > КоличествоВСтруктуре;
	Для Каждого Реквизит Из СписокРеквизитовОбъекта.Реквизиты Цикл
		НаименованиеРеквизита = Реквизит.НаименованиеРеквизита;
		//Если левая сторона незаполнена - истории не было
		Если ЛеваяСторонаЗаполнена Тогда
			//Если ЛеваяСторона.Свойство(НаименованиеРеквизита) Тогда
			//	ЛевоеЗначение = ЛеваяСторона[НаименованиеРеквизита];
			//Иначе
			//	//левого значения с этим реквизитом не было, поэтому заполним его пустым значениям по описанию типов метаданных
			//	//ОписаниеТиповТипы = ОбъектИстории.Метаданные().Реквизиты[НаименованиеРеквизита].Тип.Типы();
			//	//Если ОписаниеТиповТипы.Количество() > 1 Тогда
			//	//	//составной тип
			//	//	ЛеваяСторона = Неопределено;
			//	//Иначе
			//	//	ЛеваяСторона = ОбщегоНазначения.ПустоеЗначениеТипа(ОписаниеТиповТипы[0]);
			//	//КонецЕсли;
			//	ЛевоеЗначение = "<Пустое значение>";
			//КонецЕсли;
			ЛевоеЗначение = Неопределено;
			Если Не ЛеваяСторона.Свойство(НаименованиеРеквизита, ЛевоеЗначение) Тогда
				ЛевоеЗначение = "<Пустое значение>";
			КонецЕсли;
		КонецЕсли;
		//Если левая сторона незаполнена - истории не было
		Если ПраваяСторонаЗаполнена Тогда
			//Если ПраваяСторона.Свойство(НаименованиеРеквизита) Тогда
			//	ПравоеЗначение = ПраваяСторона[НаименованиеРеквизита];
			//Иначе
			//	ПравоеЗначение = "<Пустое значение>";
			//КонецЕсли;
			
			ПравоеЗначение = Неопределено;
			Если Не ПраваяСторона.Свойство(НаименованиеРеквизита, ПравоеЗначение) Тогда
				ПравоеЗначение = "<Пустое значение>";
			КонецЕсли;
		КонецЕсли;
		Если ТолькоРазличающиесяЗначения = Ложь Или ЛевоеЗначение <> ПравоеЗначение Тогда
			//СтруктураЗначенияРеквизиты = Новый Структура("ЛевоеЗначение, ПравоеЗначение", ЛевоеЗначение, ПравоеЗначение);
			//СтруктураИзменений.Вставить(Реквизит, СтруктураЗначенияРеквизиты);
			СтруктураИзменений.Вставить(Реквизит, Новый Структура("ЛевоеЗначение, ПравоеЗначение", ЛевоеЗначение, ПравоеЗначение));
		КонецЕсли;
	КонецЦикла;
	Если ЭтоОтчетПоставщику Тогда
		СписокРеквизитовОбъектаОплаты = ПолучитьСписокРеквизитов(Документы.уб_ОплатаПолисов.ПустаяСсылка());
		ЛеваяТаблицаДокументов	= ЛеваяСторона["ПодчиненныеДокументы"];
		ПраваяТаблицаДокументов	= ПраваяСторона["ПодчиненныеДокументы"];
		//Перебираем правую таблицу
		Для Каждого ПраваяСтрока Из ПраваяТаблицаДокументов Цикл
			НайденнаяСтрокаСлева = ЛеваяТаблицаДокументов.Найти(ПраваяСтрока.ПодчиненныйДокументСсылка, "ПодчиненныйДокументСсылка");
			СтруктураСправа = ПраваяСтрока.ПодчиненныйДокументСтруктура;
			Если НайденнаяСтрокаСлева = Неопределено Тогда
				//Получаем данные оплаты из истории
				//СтруктураСлева = Новый Структура();
				//DDПолучитьДанныеОбъектаИзИстории(ПраваяСтрока.ПодчиненныйДокументСсылка, ЛеваяСторона.ДатаВерсииСтруктуры, СтруктураСлева);
				
				СтруктураСлева		  = Новый Структура;
				СписокРеквизитов	  = Новый Структура;
				СтруктураПараметров   = Новый Структура;
				СтруктураПараметров.Вставить("Объект", ПраваяСтрока.ПодчиненныйДокументСсылка);
				СтруктураПараметров.Вставить("ДатаПредВерсии", ЛеваяСторона.ДатаВерсииСтруктуры);
				СтруктураПараметров.Вставить("ДатаВерсии", Неопределено);
				СтруктураПараметров.Вставить("ВключитьПодчиненныеДокументы",Истина);
				уб_ИсторияИзмененияОбъектов.ЗаполнитьСтруктурыДляСравнения(СтруктураПараметров, СтруктураСлева, Неопределено, СписокРеквизитов);
				
			Иначе
				СтруктураСлева = НайденнаяСтрокаСлева.ПодчиненныйДокументСтруктура;
			КонецЕсли;
			РазличияОплаты = DDПолучитьТаблицуРазличий(ПраваяСтрока.ПодчиненныйДокументСсылка, СтруктураСлева, СтруктураСправа, СписокРеквизитовОбъектаОплаты);
			Если РазличияОплаты.Количество() > 0 Тогда
				Если СтруктураИзменений["ПодчиненныеДокументы"] = Неопределено Тогда
					ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
					ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
					ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументДействие");
					ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
					ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументРазличия");
					СтруктураИзменений.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
				КонецЕсли;
				НовСтр = ТаблицаПодчиненныхДокументов.Добавить();
				НовСтр.ПодчиненныйДокументСсылка = ПраваяСтрока.ПодчиненныйДокументСсылка;
				Если НайденнаяСтрокаСлева = Неопределено Тогда
					НовСтр.ПодчиненныйДокументДействие = "Добавлена";
				Иначе
					НовСтр.ПодчиненныйДокументДействие = "Изменена";
				КонецЕсли;
				НовСтр.ПодчиненныйДокументРазличия 	= РазличияОплаты;
				НовСтр.ПодчиненныйДокументСтруктура = СтруктураСлева;
			КонецЕсли;
		КонецЦикла;
		//Перебираем левую таблицу
		Для Каждого ЛеваяСтрока Из ЛеваяТаблицаДокументов Цикл
			НайденнаяСтрокаСправа = ПраваяТаблицаДокументов.Найти(ЛеваяСтрока.ПодчиненныйДокументСсылка, "ПодчиненныйДокументСсылка");
			Если НайденнаяСтрокаСправа = Неопределено Тогда
				СтруктураСлева = ЛеваяСтрока.ПодчиненныйДокументСтруктура;
				//Получаем данные оплаты из истории
				//СтруктураСправа = Новый Структура();
				//DDПолучитьДанныеОбъектаИзИстории(ЛеваяСтрока.ПодчиненныйДокументСсылка, ПраваяСторона.ДатаВерсииСтруктуры, СтруктураСправа);
				
				СтруктураСправа		  = Новый Структура;
				СписокРеквизитов	  = Новый Структура;
				СтруктураПараметров   = Новый Структура;
				СтруктураПараметров.Вставить("Объект", ЛеваяСтрока.ПодчиненныйДокументСсылка);
				СтруктураПараметров.Вставить("ДатаПредВерсии", ПраваяСторона.ДатаВерсииСтруктуры);
				СтруктураПараметров.Вставить("ДатаВерсии", Неопределено);
				СтруктураПараметров.Вставить("ВключитьПодчиненныеДокументы",Истина);
				уб_ИсторияИзмененияОбъектов.ЗаполнитьСтруктурыДляСравнения(СтруктураПараметров, СтруктураСправа, Неопределено, СписокРеквизитов);				
				
				РазличияОплаты = DDПолучитьТаблицуРазличий(ЛеваяСтрока.ПодчиненныйДокументСсылка, СтруктураСлева, СтруктураСправа, СписокРеквизитовОбъектаОплаты);
				Если РазличияОплаты.Количество() > 0 Тогда
					Если СтруктураИзменений["ПодчиненныеДокументы"] = Неопределено Тогда
						ТаблицаПодчиненныхДокументов = Новый ТаблицаЗначений();
						ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСсылка");
						ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументДействие");
						ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументСтруктура");
						ТаблицаПодчиненныхДокументов.Колонки.Добавить("ПодчиненныйДокументРазличия");
						СтруктураИзменений.Вставить("ПодчиненныеДокументы", ТаблицаПодчиненныхДокументов);
					КонецЕсли;
					//TODO зачем??
					НовСтр = ТаблицаПодчиненныхДокументов.Добавить();
					НовСтр.ПодчиненныйДокументСсылка	= ЛеваяСтрока.ПодчиненныйДокументСсылка;
					НовСтр.ПодчиненныйДокументДействие	= "Удалена";
					НовСтр.ПодчиненныйДокументРазличия	= РазличияОплаты;
					НовСтр.ПодчиненныйДокументСтруктура	= СтруктураСправа;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СтруктураИзменений;
	
КонецФункции

