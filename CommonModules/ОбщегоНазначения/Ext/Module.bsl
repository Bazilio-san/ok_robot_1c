		//ТекстСРезультатомПоиска = ТекстДляПоиска;
		//ТранслитТекстаСРезультатомПоиска = ТранслитТекстДляПоиска;
		//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
		Если Список <> Неопределено Тогда
			Количество = Список.Количество();
			ЭлементСписка = Список.Получить(0);
			Если Количество = 1 Тогда
				Значение = ЭлементСписка.Значение;
			Иначе
				//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
