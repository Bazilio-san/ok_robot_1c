				//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
				Значение = Новый СписокЗначений;
				Для Каждого ЭлементСписка Из Список Цикл
					Значение.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление + " (" + ЭлементСписка.Значение.Код + ")");
					//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
