	Выборка = Результат.Выбрать();
	Количество = Выборка.Количество();
	
	Если Количество = 1 Тогда		
		Если Выборка.Следующий() Тогда
			Значение = Выборка.Ссылка;				
		КонецЕсли;
	ИначеЕсли Количество > 1 Тогда
		Значение = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			Значение.Добавить(Выборка.Ссылка, Выборка.Наименование + " (" + Выборка.Код + ")");
		КонецЦикла;
		Значение.СортироватьПоПредставлению();//!переделать на упорядочивание в запросе!
	ИначеЕсли ПроверитьВозможностьИспользованияПолнотекствогоПоиска() Тогда
		
		Если ДлинаТекста < 4 Тогда
			КоличествоОтличий = "#1";
		Иначе
