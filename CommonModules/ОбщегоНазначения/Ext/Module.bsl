Функция ПолучитьТранслит(Текст) Экспорт
	Рез = СокрЛП(Текст);
	Тек = 0; //0 - пустая строка, 1 - кириллица, 2 - латиница
	Если СтрДлина(Рез) > 0 Тогда		
		РусАлфавит = "аАбБвВгГдДеЕёЁжЖзЗиИйЙкКлЛмМнНоОпПрРсСтТуУфФхХцЦчЧшШщЩъЪыЫьЬэЭюЮяЯ";
		
		ОбщиеСимволы 		= "0123456789 .,;*";
		ПервыйСимвол = Лев(Рез, 1);
		Для Счетчик = 2 По СтрДлина(Рез) Цикл
			Если Найти(ОбщиеСимволы,ПервыйСимвол) = 0 Тогда
				Прервать;
			КонецЕсли;
			ПервыйСимвол = Сред(Рез, Счетчик, 1);
		КонецЦикла;
		
		Если Найти(РусАлфавит, ПервыйСимвол) <> 0 Тогда
			Тек = 1;
		Иначе
			Тек = 2;
		КонецЕсли;	
	КонецЕсли;
	Если Тек = 1 Тогда
		Рез = СтрЗаменить(Рез,"а","a");
