Функция ПолучитьПодстрокуВыделеннуюСимволами(Стр, СимволНачала = "(", СимволКонца = ")") Экспорт

	Результат = "";
	ИндНач = Найти(Стр, СимволНачала);
	Если ИндНач <> 0 Тогда
		ИндКон = Найти(Стр, СимволКонца);
		Если ИндКон <> 0 И ИндКон > ИндНач Тогда
			Результат = Сред(Стр, ИндНач, ИндКон - ИндНач)
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ПолучитьПодстрокуВыделеннуюСимволами()

