Функция ПроверитьВозможностьИспользованияПолнотекствогоПоиска()
	
	Результат = Ложь;
	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда
		//ИндексАктуален = ДобавитьМесяц(ТекущаяДата(), - 1) < ПолнотекстовыйПоиск.ДатаАктуальности();
		//Если ИндексАктуален Тогда
		//	Результат = Истина;
		//КонецЕсли;
		Если ПолнотекстовыйПоиск.ДатаАктуальности() <> '00010101000000' Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Процедура АвтоПодборТекстаСТранслитом(Элемент, Текст, ТекстАвтоПодбора, СтандартнаяОбработка, ИмяСправочника, Владелец = Неопределено) Экспорт
	
	ТекстДляПоиска = СокрЛП(Текст);
	ДлинаТекста = СтрДлина(ТекстДляПоиска);
	Если ДлинаТекста < 3 Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекстВДругойРаскладке = уб_Фильтры.ПеревестиСтроку(ТекстДляПоиска);
	ТранслитТекстДляПоиска = ОбщегоНазначения.ПолучитьТранслит(ТекстДляПоиска);
	ТранслитТекстВДругойРаскладке = ОбщегоНазначения.ПолучитьТранслит(ТекстВДругойРаскладке);
	Результат = ПолучитьРезультатЗапросаПоиска(ИмяСправочника, ТекстДляПоиска, ТранслитТекстДляПоиска, ТекстВДругойРаскладке, ТранслитТекстВДругойРаскладке, Владелец);
	Выборка = Результат.Выбрать();
	Количество = Выборка.Количество();
	Если Выборка.Следующий() Тогда
		Если Количество = 1 Тогда
			Форма = Справочники[ИмяСправочника].ПолучитьФормуВыбора(, Элемент);
			Форма.ОповеститьОВыборе(Выборка.Ссылка);
		Иначе
			ТекстАвтоПодбора = Выборка.Наименование;
		КонецЕсли;
	ИначеЕсли ПроверитьВозможностьИспользованияПолнотекствогоПоиска() Тогда
		
		Если ДлинаТекста < 4 Тогда
			КоличествоОтличий = "#1";
		Иначе
			КоличествоОтличий = "#2";
		КонецЕсли;
				
		ПоискПолнотекстовый = ТекстДляПоиска + "* OR " + ТекстВДругойРаскладке + "* OR " + ТекстДляПоиска + КоличествоОтличий + " OR " + ТекстВДругойРаскладке + КоличествоОтличий;
		Список = ВыполнитьПолнотекстовыйПоискВСправочнике(ПоискПолнотекстовый, ИмяСправочника, 30, Владелец);
		//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
		//ТекстСРезультатомПоиска = ТекстДляПоиска;
		//ТранслитТекстаСРезультатомПоиска = ТранслитТекстДляПоиска;
		//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
