Функция ПолучитьСписокЭлементовСправочникаПоОтборуСТранслитом(Знач Текст, ИмяСправочника, Владелец = Неопределено, ОграничениеКоличества = 30, ИндексЗапуска = 1) Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	ТекстДляПоиска = СокрЛП(Текст);
	ДлинаТекста = СтрДлина(ТекстДляПоиска);
	Если ДлинаТекста < ИндексЗапуска Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекстВДругойРаскладке = уб_Фильтры.ПеревестиСтроку(ТекстДляПоиска);
	ТранслитТекстДляПоиска = ОбщегоНазначения.ПолучитьТранслит(ТекстДляПоиска);
	ТранслитТекстВДругойРаскладке = ОбщегоНазначения.ПолучитьТранслит(ТекстВДругойРаскладке);
	
	Результат = ПолучитьРезультатЗапросаПоиска(ИмяСправочника, ТекстДляПоиска, ТранслитТекстДляПоиска, ТекстВДругойРаскладке, ТранслитТекстВДругойРаскладке, Владелец, ОграничениеКоличества);
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокЗначений.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
		
	ИначеЕсли ПроверитьВозможностьИспользованияПолнотекствогоПоиска() Тогда
		
		Если ДлинаТекста < 4 Тогда
			КоличествоОтличий = "#1";
		Иначе
			КоличествоОтличий = "#2";
		КонецЕсли;
		
		ПоискПолнотекстовый = ТекстДляПоиска + "* OR " + ТекстВДругойРаскладке + "* OR " + ТекстДляПоиска + КоличествоОтличий + " OR " + ТекстВДругойРаскладке + КоличествоОтличий;
		Список = ВыполнитьПолнотекстовыйПоискВСправочнике(ПоискПолнотекстовый, ИмяСправочника, ОграничениеКоличества, Владелец);
		//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
		//ТекстСРезультатомПоиска = ТекстДляПоиска;
		//ТранслитТекстаСРезультатомПоиска = ТранслитТекстДляПоиска;
		//СписокПодходящихЭлементов = Новый СписокЗначений;
		//СчетчикПодходящихЭлементов = 0;
		//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
		Если Список <> Неопределено Тогда
			Для Каждого ЭлементСписка Из Список Цикл
				ЭлементСпискаПредставление = ЭлементСписка.Представление;
				ЭлементСпискаЗначение = ЭлементСписка.Значение;
				//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
				//Если Нрег(ТекстСРезультатомПоиска) = Нрег(Лев(ЭлементСпискаПредставление,ДлинаТекста)) Или Нрег(ТранслитТекстаСРезультатомПоиска) = Нрег(Лев(ЭлементСпискаПредставление,ДлинаТекста)) Тогда
				//	СписокПодходящихЭлементов.Добавить(ЭлементСпискаЗначение, ЭлементСпискаПредставление);
				//КонецЕсли;
				//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
				СписокЗначений.Добавить(ЭлементСпискаЗначение, ЭлементСпискаПредставление);
			КонецЦикла;
		КонецЕсли;
		//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
		//Если СписокПодходящихЭлементов.Количество() > 0 Тогда
		//	СписокЗначений = СписокПодходящихЭлементов;
		//КонецЕсли;
		//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
	КонецЕсли;
	Возврат СписокЗначений;
	
КонецФункции

//Возвращает список если поиск дал результат, иначе возвращает Неопределено
Функция ВыполнитьПолнотекстовыйПоискВСправочнике(Знач Текст, ИмяСправочника = "", РазмерПорции = 30, Владелец = Неопределено) Экспорт
	
	Результат = Неопределено;
	//ДлинаТекста = СтрДлина(Текст);
	//Если ДлинаТекста < 4 Тогда
	//	КоличествоОтличий = "#1";
	//Иначе
	//	КоличествоОтличий = "#2";
	//КонецЕсли;
	//Текст = Текст + КоличествоОтличий;
	ВладелецМассив = ТипЗнч(Владелец) = Тип("Массив");
	Список = ПолнотекстовыйПоиск.СоздатьСписок(Текст, РазмерПорции);
	Если ТипЗнч(ИмяСправочника) = Тип("Массив") Тогда
		Список.ОбластьПоиска = ИмяСправочника;
	ИначеЕсли Не ПустаяСтрока(ИмяСправочника) Тогда
		МассивОтбор = Новый Массив();
		МассивОтбор.Добавить(Метаданные.Справочники[ИмяСправочника]);
		Список.ОбластьПоиска = МассивОтбор;
	КонецЕсли;
	Попытка
		Список.ПерваяЧасть();
		
		Количество = Список.Количество();
		Если Количество > 0 Тогда
			СписокРезультата = Новый СписокЗначений;
			Для Счетчик = 1 По Количество Цикл
				ЭлементСписка = Список.Получить(Количество - Счетчик);
				Если Найти(ЭлементСписка.Описание,"Наименование:") <> 0 Тогда
					Если Владелец <> Неопределено Тогда
						Если ВладелецМассив Тогда
							Если Владелец.Найти(ЭлементСписка.Значение.Владелец) = Неопределено Тогда
								Продолжить;
							КонецЕсли;
						ИначеЕсли ЭлементСписка.Значение.Владелец <> Владелец Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					СписокРезультата.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
				КонецЕсли;
			КонецЦикла;
			
			Если СписокРезультата.Количество() > 0 Тогда
				Результат = СписокРезультата;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;
	
КонецФункции
