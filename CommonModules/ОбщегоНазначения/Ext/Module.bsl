					//Если Нрег(ТекстСРезультатомПоиска) = Нрег(Лев(ЭлементСпискаПредставление,ДлинаТекста)) Или Нрег(ТранслитТекстаСРезультатомПоиска) = Нрег(Лев(ЭлементСпискаПредставление,ДлинаТекста)) Тогда
					//	СчетчикПодходящихЭлементов = СчетчикПодходящихЭлементов + 1;
					//	Если СчетчикПодходящихЭлементов = 1 Или СтрДлина(ЭлементСпискаПредставление) < СтрДлина(ЭлементСпискаПодходящийПредставление) Тогда
					//		ЭлементСпискаПодходящийПредставление = ЭлементСпискаПредставление;
					//		ЭлементСпискаПодходящийЗначение = ЭлементСписка.Значение;
					//	КонецЕсли;
					//КонецЕсли;
					//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
				КонецЦикла;
				//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос
				//Если СчетчикПодходящихЭлементов = 1 Тогда
				//	Значение = ЭлементСпискаПодходящийЗначение;
				//	Форма = Справочники[ИмяСправочника].ПолучитьФормуВыбора(, Элемент);
				//	Форма.ОповеститьОВыборе(ЭлементСпискаПодходящийЗначение);
				//Иначе
				//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
					Значение.СортироватьПоПредставлению();
				//+Не актуально, если Перед Полнотекстовым поискам выполняется запрос	
				//КонецЕсли;
				//-Не актуально, если Перед Полнотекстовым поискам выполняется запрос
			КонецЕсли;
		Иначе
			СтандартнаяОбработка = Истина;
		КонецЕсли;
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
