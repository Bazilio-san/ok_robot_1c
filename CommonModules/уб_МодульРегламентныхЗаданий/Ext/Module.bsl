Процедура уб_ОбработкаОчереди() Экспорт
	
	ВыполнитьОбработкуОчереди(2);
	
КонецПроцедуры //уб_ОбработкаОчереди

Процедура ВыполнитьОбработкуОчереди(КоличествоПопытокВыполнения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	ПрогнатьСтатусы();

	
Если ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина Тогда	
	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_Очередь.Объект,
	               |	уб_Очередь.Объект.Представление,
	               |	ТИПЗНАЧЕНИЯ(уб_Очередь.Объект) КАК ТипДокумента
	               |ИЗ
	               |	РегистрСведений.уб_Очередь КАК уб_Очередь
	               |ГДЕ
	               |	(уб_Очередь.КоличествоПопытокВыполнения < &КоличествоПопытокВыполнения
	               |			ИЛИ уб_Очередь.КоличествоПопытокВыполнения = 100)
	               |	И уб_Очередь.ТипОчереди = ЗНАЧЕНИЕ(Перечисление.уб_ТипыОчереди.Рассылка)";
	Запрос.УстановитьПараметр("КоличествоПопытокВыполнения", КоличествоПопытокВыполнения);
	ВсеДокументы = Запрос.Выполнить().Выгрузить();
	ВидыДоков = ВсеДокументы.Скопировать();
	ВидыДоков.Свернуть("ТипДокумента");
	
	Для Каждого ВидДоков из ВидыДоков Цикл
		
		Если ВидДоков.ТипДокумента = Тип("null") Тогда
			Продолжить;
		КонецЕсли;	
		
		ТекДоки = ВсеДокументы.Скопировать(Новый Структура("ТипДокумента",ВидДоков.ТипДокумента));
		
		Если ТекДоки.Количество() >0 Тогда
			ИмяМета = ТекДоки[0].Объект.Метаданные().Имя;
			Попытка
				Документы[ИмяМета].ОбработчикРассылки(ТекДоки.ВыгрузитьКолонку("Объект"));
