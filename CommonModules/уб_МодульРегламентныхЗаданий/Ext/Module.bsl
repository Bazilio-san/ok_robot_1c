	Запрос.УстановитьПараметр("Агент", 					Агент);
	Запрос.УстановитьПараметр("КоличествоДней", 					КоличествоДней);
	Запрос.УстановитьПараметр("КоличествоДнейДляПовторногоЗадания", КоличествоДнейДляПовторногоЗадания);
	Запрос.УстановитьПараметр("ТекущаяДата", 						ТекДата);
	Запрос.УстановитьПараметр("НачалоДня", 							НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("КонецПериода", 						КонецДня(НачалоДня(ТекДата) + КоличествоДнейДоОчередногоПлатежа * 86400));
	Запрос.УстановитьПараметр("СтатусВРаботе",	 					СтатусВРаботе);
	Запрос.УстановитьПараметр("СуммаДопустимогоДолга", 				СуммаДопустимогоДолга);	
	//+++не создавать задания по полисам, у которых: номер заявки - личная или вид страхового продукта НС или ДСАГО
	//задания на пролонгацию
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "уб_СтраховойПолис.СтраховойПродукт.Вид <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.НС)
	|И уб_СтраховойПолис.СтраховойПродукт.Вид <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ДСАГО)");
	//|И уб_СтраховойПолис.НомерЗаявки <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная)
	//|И уб_СтраховойПолис.НомерЗаявки <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Агентская)");
	//задания на очередной платеж
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "уб_СтраховойПолисПлатежи.Ссылка.СтраховойПродукт.Вид <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.НС)
	|И уб_СтраховойПолисПлатежи.Ссылка.СтраховойПродукт.Вид <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ДСАГО)");
	//|И уб_СтраховойПолисПлатежи.Ссылка.НомерЗаявки <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная)
	//|И уб_СтраховойПолисПлатежи.Ссылка.НомерЗаявки <> ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Агентская)");
	//---не создавать задания по полисам, у которых: номер заявки - личная или вид страхового продукта НС или ДСАГО
	Пакет = Запрос.ВыполнитьПакет();
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	//добавление новых задания на пролонгацию
	ТаблицаСП = Пакет[0].Выгрузить();
	Поиск = Новый Структура("Подразделение");
	ВыборкаРуководителейПодразделений = Пакет[1].Выбрать();	
	Выборка = Пакет[2].Выбрать();
	Если Выборка.Следующий() Тогда
		ПервыйРабочийДень = Выборка.ПервыйРабочийДень;
	Иначе
		ПервыйРабочийДень = ТекДата;
	КонецЕсли;
	ТаблицаЗаданийДляПовторнойОбработки = Пакет[5].Выгрузить();	
	Если ТаблицаСП.Количество() > 0 Тогда
		уб_temp.ПолучитьПреемникаСотрудника(ТаблицаСП, "Агент");
		Для Каждого СтрокаТЗ Из ТаблицаСП Цикл
			Менеджер = СтрокаТЗ.Агент;
			Уволен = Ложь;
			ПодразделениеМенеджера = уб_СС.ПолучитьПодразделениеАгента(Менеджер, ТекДата, Истина, Уволен);
			Если Уволен Тогда
				Поиск.Подразделение = ПодразделениеМенеджера;
				ВыборкаРуководителейПодразделений.Сбросить();
				Если ВыборкаРуководителейПодразделений.НайтиСледующий(Поиск) Тогда
					Менеджер = ВыборкаРуководителейПодразделений.Сотрудник;
				КонецЕсли;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений.уб_ЗаданияНаПролонгацию.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.СтраховойПолис = СтрокаТЗ.Ссылка;
			МенеджерЗаписи.ТипЗадания = Ложь;
			МенеджерЗаписи.Ответственный = Менеджер;
			МенеджерЗаписи.Автор = ТекПользователь;
			МенеджерЗаписи.Записать();			
			МенеджерЗаписи = РегистрыСведений.уб_СтатусыПролонгации.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ТекДата;
			МенеджерЗаписи.СтраховойПолис = СтрокаТЗ.Ссылка;
			МенеджерЗаписи.ТипЗадания = Ложь;
			МенеджерЗаписи.Комментарий = "Выставлено менеджеру " + Менеджер;
			МенеджерЗаписи.Автор = ТекПользователь;
			МенеджерЗаписи.Записать();
		КонецЦикла;
	КонецЕсли;
	//закрытие заданий
	ВыборкаЗаданийДляЗакрытия = Пакет[4].Выбрать();
	Пока ВыборкаЗаданийДляЗакрытия.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.уб_ЗаданияНаПролонгацию.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.СтраховойПолис = ВыборкаЗаданийДляЗакрытия.СтарыйСтраховойПолис;
		МенеджерЗаписи.ТипЗадания = Ложь;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Автор = ТекПользователь;
		МенеджерЗаписи.НовыйПолис = ВыборкаЗаданийДляЗакрытия.НовыйСтраховойПолис;
		МенеджерЗаписи.ДатаЗакрытия = ТекДата;
		МенеджерЗаписи.ТекущийСтатус = Перечисления.уб_СтатусыПролонгирования.Пролонгирован;
		МенеджерЗаписи.Записать();		
		МенеджерЗаписи = РегистрыСведений.уб_СтатусыПролонгации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекДата;
		МенеджерЗаписи.СтраховойПолис = ВыборкаЗаданийДляЗакрытия.СтарыйСтраховойПолис;
		МенеджерЗаписи.ТипЗадания = Ложь;
		МенеджерЗаписи.Комментарий = "Страховой полис пролонгирован";
