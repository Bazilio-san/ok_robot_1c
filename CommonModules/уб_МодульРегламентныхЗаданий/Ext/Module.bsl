Процедура уб_ВыгрузкаЖурналаРегистрации() Экспорт
	
	Если ПравоДоступа("Вывод", Метаданные) Тогда
		Тема = "Журнал регистрации" + Формат(ТекущаяДата(), "ДФ = yyMMdd");
		Начало = ТекущаяДата();
		//не отправляем примечания - там ничего интересного не бывает
		ОтправлятьПримечания = Ложь;
		//!!!Переделать
		// Вставить проверку на ошибки, писать в журнал регистрации, Отправлять одним письмом с двумя вложениями!!!
		МассивСообщений = уб_ОбменДанными.ПолучитьПочту();
		Конец = ТекущаяДата();
		Время = Конец - Начало;
		Сообщить(Время);
		ЕстьСообщение = Ложь;
		Для Каждого Сообщение Из МассивСообщений Цикл
			Если Сообщение.Тема = Тема Тогда
				ЕстьСообщение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСообщение Тогда
			Каталог = Новый Файл(КаталогВременныхФайлов() + "1С.log\");
			Если Не Каталог.Существует() Тогда
				СоздатьКаталог(Каталог.ПолноеИмя);
			КонецЕсли;
			//Формируем ошибки
			ВыходнойФайл1 = Каталог.ПолноеИмя + "_Error_" + Формат(ТекущаяДата(), "ДФ=""ггММдд""") + ".xml";
			СтруктураФильтра  = Новый Структура; 
			СтруктураФильтра.Вставить("ДатаНачала", 	НачалоДня(ТекущаяДата()-86400));
			СтруктураФильтра.Вставить("ДатаОкончания", 	КонецДня(ТекущаяДата()-86400));
			СтруктураФильтра.Вставить("Уровень", 		УровеньЖурналаРегистрации.Ошибка);
			ВыгрузитьЖурналРегистрации(ВыходнойФайл1, СтруктураФильтра, 	,);
			//формируем список получателей, из константы
			Получатели = Новый Массив;
			ТекСтрока = ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
			Пока Найти(ТекСтрока,";") > 0 Цикл
				Получатели.Добавить(Лев(ТекСтрока, Найти(ТекСтрока,";")-1));
				ТекСтрока = СтрЗаменить(ТекСтрока,Лев(ТекСтрока, Найти(ТекСтрока,";")),"");
			КонецЦикла;	
			Пока Найти(ТекСтрока,",") > 0 Цикл
				Получатели.Добавить(Лев(ТекСтрока, Найти(ТекСтрока,",")-1));
				ТекСтрока = СтрЗаменить(ТекСтрока,Лев(ТекСтрока, Найти(ТекСтрока,",")),"");
			КонецЦикла;	
			Получатели.Добавить(ТекСтрока);
			ТекстПисьма = "";
			Если ЕстьСобытияВФайлеXML(ВыходнойФайл1) Тогда
				Файл = Новый ЧтениеТекста(ВыходнойФайл1, КодировкаТекста.UTF8);
				ТекстФайла = Файл.Прочитать();
				ТекстПисьма = "Ошибки в журнале регистрации:
				|
				|" + ТекстФайла;
			КонецЕсли;
			//Формируем информационное сообщение
			Если ОтправлятьПримечания Тогда
				ВыходнойФайл2 = Каталог.ПолноеИмя + "_Info_"+Формат(ТекущаяДата(), "ДФ=""ггММдд""") +".xml";
				СтруктураФильтра  = Новый Структура; 
				СтруктураФильтра.Вставить("ДатаНачала", 	НачалоДня(ТекущаяДата()-86400));
				СтруктураФильтра.Вставить("ДатаОкончания", 	КонецДня(ТекущаяДата()-86400));
				СтруктураФильтра.Вставить("Уровень", 		УровеньЖурналаРегистрации.Примечание);
				ВыгрузитьЖурналРегистрации(ВыходнойФайл2, СтруктураФильтра, 	,);
				Если ЕстьСобытияВФайлеXML(ВыходнойФайл2) Тогда
					Файл = Новый ЧтениеТекста(ВыходнойФайл2, КодировкаТекста.UTF8); 
					ТекстФайла = Файл.Прочитать();
					ТекстПисьма = ТекстПисьма + "
					|Примечания в журнале регистрации:
					|
					|" + ТекстФайла;
				КонецЕсли;
			КонецЕсли;
			Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
			Параметры.Получатели 	= Получатели;
			Параметры.Тема			= Тема;
			Параметры.Сообщение		= ТекстПисьма;
			Если ЗначениеЗаполнено(ТекстПисьма) тогда
				уб_ОбменДанными.SendMail(Параметры);
			КонецЕсли;
		КонецЕсли;
		ПроверитьДоговора();
		ПроверитьАктуальностьПериодаПоСрочнымОшибкам();
	КонецЕсли;

КонецПроцедуры


Процедура уб_ЧисткаСессионныхКлючейПользователиB2B(ПользовательB2B=Неопределено) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_СессионныеКлючиB2B.СрокЖизни,
	|	уб_СессионныеКлючиB2B.ПользовательB2B
	|ИЗ
	|	РегистрСведений.уб_СессионныеКлючиB2B КАК уб_СессионныеКлючиB2B
	|ГДЕ
	|	уб_СессионныеКлючиB2B.СрокЖизни <= &ТекущаяДата");
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Если ПользовательB2B <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " И уб_СессионныеКлючиB2B.ПользовательB2B = &ПользовательB2B";
		Запрос.УстановитьПараметр("ПользовательB2B", ПользовательB2B);
	КонецЕсли;
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Результат Цикл 
		МенеджерЗаписи = РегистрыСведений.уб_СессионныеКлючиB2B.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.СрокЖизни = Строка.СрокЖизни;
		МенеджерЗаписи.ПользовательB2B = Строка.ПользовательB2B;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;    
	КонецЦикла;
	
