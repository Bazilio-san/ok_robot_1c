						Область.Параметры.ДатаОкончания	= ?(ЗначениеЗаполнено(Строка4.ДатаОкончания),	Формат(Строка4.ДатаОкончания, "ДФ=дд.ММ.yyyy"), "");
						ТабДок.Вывести(Область);
					КонецЦикла;
