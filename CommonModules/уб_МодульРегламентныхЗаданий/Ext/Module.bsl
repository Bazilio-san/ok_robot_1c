			ИмяФайла = Формат(ТекущаяДата(), "ДФ=yyyy_ММ_дд") + ".html";
			ТабДок.Записать(Путь + ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
			ТекстHTML = "";
			Файл = Новый ЧтениеТекста(Путь + ИмяФайла, КодировкаТекста.UTF8);
			СтрокаФайла = Файл.ПрочитатьСтроку();
			Пока СтрокаФайла <> Неопределено Цикл // строки читаются до символа перевода строки
				Если Найти(СтрокаФайла,"Номер&nbsp;договора") <> 0 Тогда //если строка с колонкой номер договора
					Позиция = Найти(СтрокаФайла, ">");
					СтрокаФайла = Лев(СтрокаФайла, Позиция - 1) + " width=""50%""" + Сред(СтрокаФайла, Позиция);//установка ширины колонки
