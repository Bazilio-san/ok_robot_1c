				ТекстHTML = ТекстHTML + Символы.ПС + СтрокаФайла;
				СтрокаФайла = Файл.ПрочитатьСтроку();
			КонецЦикла;
			Файл.Закрыть();
			Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
