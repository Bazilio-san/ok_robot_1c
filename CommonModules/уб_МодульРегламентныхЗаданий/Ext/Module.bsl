Процедура ПроверитьДоговора() Экспорт
	
	Если ПравоДоступа("Вывод", Метаданные) Тогда
		//TODO: каталог сохранения. Нужна константа.
		Путь = КаталогВременныхФайлов();
		ПериодПроверки = 7;
		ТипПериода = "ДЕНЬ";
		ПериодПроверкиДоговоров = ПараметрыСеанса.уб_Константы.ПериодПроверкиДоговоров;
		ТипЗнчПериодПроверкиДоговоров = ТипЗнч(ПериодПроверкиДоговоров);
		Если ТипЗнчПериодПроверкиДоговоров = Тип("Число") Тогда
			ПериодПроверки  = ПериодПроверкиДоговоров;
		ИначеЕсли ТипЗнчПериодПроверкиДоговоров = Тип("Строка") Тогда
			// возможные форматы 3д , 2 месяца (3 дня, 2 месяца)
			ПериодПроверкиДоговоров = СокрЛП(ПериодПроверкиДоговоров);
			ЧислоСтрока = "";
			Для Индекс = 1 По СтрДлина(ПериодПроверкиДоговоров) Цикл
				Символ = Сред(ПериодПроверкиДоговоров, Индекс, 1);
				КодСимвола = КодСимвола(Символ);
				Если КодСимвола >= 48 И КодСимвола <= 57 Тогда
					ЧислоСтрока = ЧислоСтрока + Символ;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеЗаполнено(ЧислоСтрока) Тогда
				Отказ = Ложь;
				Попытка
					ПериодПроверки = Число(ЧислоСтрока);
				Исключение
					Отказ = Истина;
				КонецПопытки;
				Если Не Отказ Тогда
					Строка = СокрЛ(Сред(ПериодПроверкиДоговоров, Индекс));
					Если Строка <> "" Тогда
						Символ = НРег(Лев(Строка, 1));
						Если Символ = "м" Тогда
							ТипПериода = "МЕСЯЦ"
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентов.Владелец КАК СК,
		|	ДоговорыКонтрагентов.Организация КАК ОргАгент,
		|	ДоговорыКонтрагентов.Наименование КАК НомерДоговора,
		|	ДоговорыКонтрагентов.ДатаЗаключенияДоговора КАК ДатаЗаключения,
		|	ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора КАК ДатаОкончания,
		|	ДоговорыКонтрагентов.ДопХарактеристика,
		|	РАЗНОСТЬДАТ(&ДатаТек, ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора, ДЕНЬ) КАК Срок,
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(&ДатаТек, ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора, ДЕНЬ) >= 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДоговорДействует
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Наименование <> ""Основной договор""
		|	И ДоговорыКонтрагентов.РасширениеНазвания <> ""---""
		|	И ДоговорыКонтрагентов.Владелец.Родитель.Наименование <> ""НЕ АКТИВНЫЕ""
		|	И РАЗНОСТЬДАТ(&ДатаТек, ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора, " + ТипПериода + ") <= " + ПериодПроверки + "
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Срок УБЫВ
		|ИТОГИ ПО
		|	ДоговорДействует,
		|	СК,
		|	ОргАгент";
		Запрос.УстановитьПараметр("ДатаТек",	ТекущаяДата());
		ГруппаКонтр = ПараметрыСеанса.уб_Константы.уб_НеактивныеКонтрагенты;
		Если ЗначениеЗаполнено(ГруппаКонтр) Тогда
			СтрЗам = " И (Не ДоговорыКонтрагентов.Ссылка В Иерархии(&НеактивКонтр)) ";
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"//ЗамУсловие",СтрЗам);
			Запрос.УстановитьПараметр("НеактивКонтр",ГруппаКонтр);
		КонецЕсли;
		//Выборка = Запрос.Выполнить().Выбрать();
		Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Макет = ПолучитьОбщийМакет("АктуальностьДоговоров");
		ТабДок = Новый ТабличныйДокумент;
		
		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Дата = Формат(ТекущаяДата(), "ДФ=дд.ММ.yyyy");
		ТабДок.Вывести(Область);
		
		//ДоговорДействует
		
		Для Каждого Строка Из Результат.Строки Цикл
			Область = Макет.ПолучитьОбласть("ДоговорДействует");
			Если Строка.ДоговорДействует Тогда
				Область.Параметры.ДоговорДействует = "Следующие договора прекратят свое действие в течении 7 дней:";
