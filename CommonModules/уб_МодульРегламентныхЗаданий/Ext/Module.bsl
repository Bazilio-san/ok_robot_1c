Процедура уб_ЗачисткаСтарыхКонтактов() Экспорт
	
	КоличествоЧасов	= ПараметрыСеанса.уб_Константы.ИнтервалЧасовЗачистки;
	Если ТипЗнч(КоличествоЧасов) = Тип("Число") Тогда
		ДатаСравнения = ТекущаяДата() - 60 * 60 * КоличествоЧасов;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	З.Ссылка
		|ИЗ
		|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК З
		|ГДЕ
		|	З.Дата <= &ДатаСравнения
		|	И (ВЫРАЗИТЬ(З.Контакты КАК СТРОКА(1))) <> """"");		
		Запрос.УстановитьПараметр("ДатаСравнения", ДатаСравнения);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл	
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.ОбменДанными.Загрузка = Истина;
			Если ПустаяСтрока(Объект.ПредставлениеСтроки) Тогда
				Объект.ПредставлениеСтроки = уб_temp.ШифрСтроки(Объект.Контакты);
			Иначе
				ТекСтрока = уб_temp.ШифрСтроки(Объект.ПредставлениеСтроки, Ложь);
				Объект.ПредставлениеСтроки = уб_temp.ШифрСтроки(ТекСтрока + ";" + Объект.Контакты);
			КонецЕсли;
			Объект.Контакты = "";
			Попытка
				Объект.Записать();
			Исключение
			КонецПопытки;		
		КонецЦикла;
	Иначе
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_ЗачисткаСтарыхКонтактов(): Некорректный тип значения константы ИнтервалЧасовЗачистки. Контакты не будут зачищены!", ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.РезультатПроверки,
	               |	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус,
	               |	РАЗНОСТЬДАТ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата, &ТекДата, ЧАС) КАК Просрочка
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
	               |		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.уб_РезультатПроверкиЗаявки.ПринятоСДоработкой)
	               |	И НЕ ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ДеньгиВКомпании), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.КомплектИДеньгиУКассира), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаСостоялась), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась))
	               |	И РАЗНОСТЬДАТ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата, &ТекДата, ЧАС) > 120";
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			уб_УСЗ.УстановитьСтатусЗаявки(Выборка.Ссылка, Перечисления.уб_СтатусыЗаявок.СтраховкаНеСостоялась, "Истек срок выезда заявки на доработке");
		Исключение
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры

Функция ЕстьСобытияВФайлеXML(ИмяФайлаXML) Экспорт 
	Файл = Новый ЧтениеXML;
	Файл.ОткрытьФайл(ИмяФайлаXML);	
	Пока Файл.Прочитать() Цикл		
		Если Файл.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Файл.Имя = "v8e:Event" Тогда				
				Файл.Закрыть();
				Возврат Истина;
			КонецЕсли;						
		КонецЕсли;		
	КонецЦикла;
	Файл.Закрыть();
	Возврат Ложь;
КонецФункции

