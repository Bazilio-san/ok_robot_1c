//====================== Обновление состояния действия полиса  =====================================
Процедура ОбновитьСостоянияПолисов() Экспорт
	
	ВремяНачала = ТекущаяДата();	
	СостояниеДействиеОкончено = Перечисления.уб_СостоянияПолиса.ДействиеОкончено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СП.Ссылка
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК СП
	|ГДЕ
	|	СП.ДатаОкончания < &НачалоСегодняшнегоДня
	|	И СП.СостояниеПолиса = &Действует
	|
	|УПОРЯДОЧИТЬ ПО
	|	СП.Дата";
	Запрос.УстановитьПараметр("НачалоСегодняшнегоДня", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Действует", Перечисления.уб_СостоянияПолиса.Действует);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоОбработанных = 0;
	УспешноОбновлены = 0;
	Ошибки = 0;
	СОО = "";
	СоздатьТекстовыйФайл(КаталогВременныхФайлов()+"1С.log\н-" + Формат(ТекущаяДата(),"ДФ=HH.mm.ss") + " " + ".txt","НАЧАЛО");
	Пока Выборка.Следующий() И КоличествоОбработанных < 1000 Цикл
		Попытка
			оСП = Выборка.Ссылка.ПолучитьОбъект();
			оСП.СостояниеПолиса = СостояниеДействиеОкончено;
			оСП.ОбменДанными.Загрузка = Истина;
			оСП.Записать();
			УспешноОбновлены = УспешноОбновлены + 1;
		Исключение
			СОО = СОО + "
			|" + Строка(оСП) + " -- " + ОписаниеОшибки();
			Ошибки = Ошибки + 1;
		КонецПопытки;
		КоличествоОбработанных = КоличествоОбработанных + 1;
	КонецЦикла;
	//теперь отправляет лог, только если были ошибки
	Если Ошибки > 0 Тогда
		ЗатраченноеВремя = ТекущаяДата() - ВремяНачала;
		Инфо = "Обработано полисов: " + КоличествоОбработанных + "
		|	Обновлено: " + УспешноОбновлены + "
		|	Ошибки: " + Ошибки + "
		|	На выполнение регламентного задания затрачено " + ЗатраченноеВремя + " секунд." + СОО;
		СоздатьТекстовыйФайл(КаталогВременныхФайлов()+"1С.log\о-" + Формат(ТекущаяДата(),"ДФ=HH.mm.ss") + ".txt",Инфо);
		Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
		Параметры.Получатели 	= ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
		Параметры.Тема			= "1С:РЗ: Обновление состояния полисов " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH.mm.ss'");
		Параметры.Сообщение		= Инфо;
		уб_ОбменДанными.SendMail(Параметры);
		#Если Клиент тогда
			Сообщить(Инфо);	
		#КонецЕсли
	КонецЕсли;
	УстановкаФлагаПредоставленРегистраПредоставленныхДокументов();
	
КонецПроцедуры


