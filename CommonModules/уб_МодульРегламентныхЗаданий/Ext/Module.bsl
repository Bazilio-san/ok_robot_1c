Процедура УстановкаФлагаПредоставленРегистраПредоставленныхДокументов() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПД.ВидДокумента КАК ВидДокумента,
	|	ВЫБОР
	|		КОГДА СП.Заявка.СозданНаОсновании <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|			ТОГДА СП.Заявка.СозданНаОсновании
	|		ИНАЧЕ СП.Заявка
	|	КОНЕЦ КАК Заявка,
	|	СП.ОбъектСтрахования
	|ПОМЕСТИТЬ ВТ_Предоставленные
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК СП
	|		ПО ПД.Объект = СП.Ссылка
	|ГДЕ
	|	ВЫБОР
	|			КОГДА СП.Заявка.СозданНаОсновании <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|				ТОГДА СП.Заявка.СозданНаОсновании
	|			ИНАЧЕ СП.Заявка
	|		КОНЕЦ <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|	И НЕ ПД.ВидДокумента.НеСвязанСОбъектомСтрахования
	|
	|СГРУППИРОВАТЬ ПО
	|	ПД.ВидДокумента,
	|	ВЫБОР
	|		КОГДА СП.Заявка.СозданНаОсновании <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|			ТОГДА СП.Заявка.СозданНаОсновании
	|		ИНАЧЕ СП.Заявка
	|	КОНЕЦ,
	|	СП.ОбъектСтрахования
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ПД.Предоставлен) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПД.Объект КАК Объект,
	|	ПД.ВидДокумента КАК ВидДокумента
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК СП
	|		ПО ПД.Объект = СП.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Предоставленные КАК ВТ_Предоставленные
	|		ПО (ВТ_Предоставленные.Заявка = ВЫБОР
	|				КОГДА СП.Заявка.СозданНаОсновании <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	|					ТОГДА СП.Заявка.СозданНаОсновании
	|				ИНАЧЕ СП.Заявка
	|			КОНЕЦ)
	|			И (ВТ_Предоставленные.ОбъектСтрахования = СП.ОбъектСтрахования)
	|			И ПД.ВидДокумента = ВТ_Предоставленные.ВидДокумента
	|ГДЕ
	|	ПД.Используется
	|	И НЕ ПД.Предоставлен
	|	И НЕ ПД.ВидДокумента.НеСвязанСОбъектомСтрахования");
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = РегистрыСведений.уб_ПредоставленныеДокументыСП.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Предоставлен = Истина;
				Если ПустаяСтрока(Запись.Комментарий) Тогда
					Запись.Комментарий	= "Автоматически регламентным заданием";
				КонецЕсли;
				Попытка
					Запись.Записать();
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка записи в регистр сведений предоставленных документов во время регламентного задания УстановкаФлагаПредоставленРегистраПредоставленныхДокументов: " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры



Процедура ЗакрытьОчередь(Ссылка,ТипОчереди) Экспорт
	МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект 		= Ссылка;
	МенеджерЗаписи.ТипОчереди 	= ТипОчереди;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;	
КонецПроцедуры

Процедура ОшибкаОчереди(Ссылка,ТипОчереди) Экспорт
	МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект 		= Ссылка;
	МенеджерЗаписи.ТипОчереди 	= ТипОчереди;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.КоличествоПопытокВыполнения= МенеджерЗаписи.КоличествоПопытокВыполнения+1;
		МенеджерЗаписи.Записать();
	КонецЕсли;	
КонецПроцедуры


Процедура ОбработатьОчередьПриемкиКЗаявкам(Запрос = Неопределено) Экспорт
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос;
	КонецЕсли;	
	Запрос.УстановитьПараметр("КоличествоПопытокВыполнения", 100);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_Очередь.Объект,
	|	уб_Очередь.Объект.Представление,
	|	ТИПЗНАЧЕНИЯ(уб_Очередь.Объект) КАК ТипДокумента
	|ИЗ
	|	РегистрСведений.уб_Очередь КАК уб_Очередь
	|ГДЕ
	|	(уб_Очередь.КоличествоПопытокВыполнения < &КоличествоПопытокВыполнения
	|			ИЛИ уб_Очередь.КоличествоПопытокВыполнения = 100)
	|	И уб_Очередь.ТипОчереди = ЗНАЧЕНИЕ(Перечисление.уб_ТипыОчереди.СозданиеПриемок)";
	
	ВсеДокументы = Запрос.Выполнить().Выбрать();
	
	КэшПриемок = Новый Соответствие;
	Пока ВсеДокументы.Следующий() Цикл
		Документы.уб_ПриемкаОплат.СоздатьПриемкуКЗаявке(ВсеДокументы.Объект,КэшПриемок);
	КонецЦикла;	
КонецПроцедуры


Процедура ОбработатьОчередьСозданиеПолисов(Запрос = Неопределено) Экспорт
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос;
	КонецЕсли;	
	Запрос.УстановитьПараметр("КоличествоПопытокВыполнения", 100);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_Очередь.Объект,
	               |	уб_Очередь.Объект.Представление,
	               |	ТИПЗНАЧЕНИЯ(уб_Очередь.Объект) КАК ТипДокумента
	               |ИЗ
	               |	РегистрСведений.уб_Очередь КАК уб_Очередь
	               |ГДЕ
	               |	(уб_Очередь.КоличествоПопытокВыполнения < &КоличествоПопытокВыполнения
	               |			ИЛИ уб_Очередь.КоличествоПопытокВыполнения = 100)
	               |	И уб_Очередь.ТипОчереди = ЗНАЧЕНИЕ(Перечисление.уб_ТипыОчереди.СозданиеПолисов)
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	уб_ПриемкаОплатПолисы.Ссылка,
	               |	уб_ПриемкаОплатПолисы.Ссылка,
	               |	ТИПЗНАЧЕНИЯ(уб_ПриемкаОплатПолисы.Ссылка)
	               |ИЗ
	               |	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_КвитовкаОплат КАК уб_КвитовкаОплат
	               |		ПО уб_ПриемкаОплатПолисы.УИДСтроки = уб_КвитовкаОплат.УИДСтрокиТЧ
	               |ГДЕ
	               |	уб_ПриемкаОплатПолисы.Ссылка.ОтчетКассира.Подтверждено = ИСТИНА
	               |	И уб_ПриемкаОплатПолисы.Ссылка.Дата >= &Дата1
	               |	И уб_КвитовкаОплат.ОплатаПолиса ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Дата1",ТекущаяДата()-24*3600*35);
	ВсеДокументы = Запрос.Выполнить().Выбрать();
	
	Пока ВсеДокументы.Следующий() Цикл
		Документы.уб_ПриемкаОплат.СоздатьПолисыКПриемке(ВсеДокументы.Объект);
	КонецЦикла;	
КонецПроцедуры


Процедура ОбработатьОчередьВыгрузкаВоВнешнююСистему(Запрос = Неопределено) Экспорт
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос;
	КонецЕсли;	
	Запрос.УстановитьПараметр("КоличествоПопытокВыполнения", 100);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_Очередь.Объект,
	|	уб_Очередь.Объект.Представление,
	|	ТИПЗНАЧЕНИЯ(уб_Очередь.Объект) КАК ТипДокумента
	|ИЗ
	|	РегистрСведений.уб_Очередь КАК уб_Очередь
	|ГДЕ
	|	(уб_Очередь.КоличествоПопытокВыполнения < &КоличествоПопытокВыполнения
	|			ИЛИ уб_Очередь.КоличествоПопытокВыполнения = 100)
	|	И уб_Очередь.ТипОчереди = ЗНАЧЕНИЕ(Перечисление.уб_ТипыОчереди.ВыгрузкаВоВнешнююСистему)";
	
	ВсеДокументы = Запрос.Выполнить().Выбрать();
	
	ОбработкаВыгрузки = Обработки.ВыгрузкаДанныхВоВнешнююСистему.Создать();
	ОбработкаВыгрузки.Инициализировать();
	ТипОчереди = Перечисления.уб_ТипыОчереди.ВыгрузкаВоВнешнююСистему;
	Пока ВсеДокументы.Следующий() Цикл
		Если ОбработкаВыгрузки.ОтправитьСсылку(ВсеДокументы.Объект) = Истина Тогда 
			ЗакрытьОчередь(ВсеДокументы.Объект,ТипОчереди);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры


