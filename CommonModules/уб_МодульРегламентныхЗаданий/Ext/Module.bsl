Функция ВыполнитьКонвертациюФайла(Объект) Экспорт
	
	Результат = Истина;
	Параметры = уб_СЛ.СтруктураПараметровКонвертацииФайловПоУмолчанию();
	Параметры.СсылкаНаОбъект 						= Объект;
	Параметры.СоздаватьТаблицуФайловПоЗаявке      	= Истина;
	Параметры.ИспользуетсяИмяФайлаСТаблицейФайлов   = Истина;
	Параметры.ЧерезФоновоеЗадание					= ПараметрыСеанса.уб_Константы.КонвертацияЧерезФоновоеЗадание;
	Параметры.ВремяОжиданияФоновогоЗадания			= 60;
	Параметры.ВремяОжиданияСозданияФайла1С			= 200;
	уб_СЕРВЕРные.ВызовКонвертацииСервер(Параметры);
	Возврат Параметры.ВыполненаКонвертацияВсехФайлов;
	
КонецФункции //ВыполнитьКонвертациюФайла

Процедура уб_ПроверкаПролонгации() Экспорт
	//Связываем уже созданные полисы, с полисами прошлых лет
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_СтраховойПолис.Ссылка
	               |ИЗ
	               |	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗаданияНаПролонгацию КАК уб_ЗаданияНаПролонгацию
	               |		ПО (уб_ЗаданияНаПролонгацию.НовыйПолис = уб_СтраховойПолис.Ссылка)
	               |			И (уб_ЗаданияНаПролонгацию.ТипЗадания = ЛОЖЬ)
	               |ГДЕ
	               |	уб_СтраховойПолис.ДатаИзменения >= &Дата1
	               |	И уб_СтраховойПолис.ДатаИзменения <= &Дата2
	               |	И уб_СтраховойПолис.ПометкаУдаления = ЛОЖЬ
	               |	И уб_ЗаданияНаПролонгацию.СтраховойПолис ЕСТЬ NULL
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	уб_СтраховойПолис.ДатаНачала УБЫВ";
	ТекущаяДата = ТекущаяДата();
	Запрос.УстановитьПараметр("Дата1",ТекущаяДата-3*24*3600);
	Запрос.УстановитьПараметр("Дата2",ТекущаяДата);
	
	Менеджер = РегистрыСведений.уб_ЗаданияНаПролонгацию;
	Выборка = Запрос.Выполнить().Выбрать();
	Сообщить("Всего полисов без задания "+Выборка.Количество());
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Документ = Менеджер.НайтиПодходящийПолис(Выборка.Ссылка,Истина);
		Если ЗначениеЗаполнено(Документ) Тогда
			Счетчик = Счетчик+1;
		КонецЕсли;	
		//ОбработкаПрерыванияПользователя();
	КонецЦикла;	
	Сообщить("Создано "+Счетчик);

	
	//Старый алгоритм работал заранее
	Возврат;
	//Если Агент  = Неопределено Тогда
		Агент = Справочники.ФизическиеЛица.ПустаяСсылка();
	//КонецЕсли;
	
	СуммаДопустимогоДолга = 10;//не создавать задание на очередную оплату если сумма меньше 10 р.
	КоличествоДней = 21;//Дней до даты окончания полиса для создания задания на пролонгацию
	КоличествоДнейДляПовторногоЗадания = 7;//если прошло 7 дней с последнего движения и задания не закрыто, то создать еще одно задание
	КоличествоДнейДоОчередногоПлатежа = 14;//создавать задания на очередной платеж за 14 дней до запланированной даты
	СтатусВРаботе = Перечисления.уб_СтатусыПролонгирования.ВРаботе;
	ТекДата = ТекущаяДата();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	уб_СтраховойПолис.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер, уб_СтраховойПолис.Агент) КАК Агент
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗаданияНаПролонгацию КАК уб_ЗаданияНаПролонгацию
	|		ПО уб_СтраховойПолис.Ссылка = уб_ЗаданияНаПролонгацию.СтраховойПолис
	|			И (уб_ЗаданияНаПролонгацию.ТипЗадания = ЛОЖЬ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	|		ПО уб_СтраховойПолис.Ссылка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.НомерДоговора
