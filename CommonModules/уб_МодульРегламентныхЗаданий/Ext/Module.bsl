			Параметры.Тема			= "Список договоров " + Формат(ТекущаяДата(), "ДФ=""ггММдд""");
			Параметры.Сообщение		= "Список договоров";
			Параметры.ТекстHTML		= ТекстHTML;
			уб_ОбменДанными.SendMail(Параметры);
			УдалитьФайлы(Путь,ИмяФайла);
		КонецЕсли;
