Функция УбратьСимволы(строка, СимволЗамены = "") Экспорт
	
	НоваяСтрока = Строка;
	
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"""",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"'",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	">",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"<",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"|",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"?",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"/",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"\",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	":",	СимволЗамены);
	НоваяСтрока = стрЗаменить(НоваяСтрока,	"*",	СимволЗамены);
	
	Возврат НоваяСтрока
	
КонецФункции

