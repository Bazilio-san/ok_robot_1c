Функция ЗаписатьОшибкуИСообщить(
	ТекстСообщения,
	ТипСообщения			= "Сообщить", 
	ДобавлятьЗаписьВЖурнал	= Ложь, 
	УровеньРегистрации		= "", 
	ОбъектМетаданных		= "", 
	СсылкаНаОбъект			= "", 
	КомментарийЖурнала		= "", 
	Статус 					= "", 
	Таймуат					= 0,
	Заголовок				= ""
	) Экспорт
	
	//Выводим информацию на экран
	Если ТипСообщения = "Сообщить" Тогда
		Если Статус = "" Тогда Статус = СтатусСообщения.Обычное;КонецЕсли;
		#Если Клиент Тогда
			Сообщить(ТекстСообщения, Статус);
		#КонецЕсли
	ИначеЕсли ТипСообщения = "Предупреждение" Тогда
		//Предупреждение возможно выдавать только в режиме клиента
		#Если Клиент Тогда
			Предупреждение(ТекстСообщения, Таймуат, Заголовок);
		#КонецЕсли
	КонецЕсли;
	//Создаем запись в журнале регистрации
	Если ДобавлятьЗаписьВЖурнал Тогда
		Если УровеньРегистрации = "" Тогда 
			УровеньРегистрации = УровеньЖурналаРегистрации.Ошибка;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньРегистрации, ОбъектМетаданных, СсылкаНаОбъект, КомментарийЖурнала);
	КонецЕсли;
КонецФункции

//Генератор паролей
//	Используется:
//		* Пользователи B2B
//	Параметры:
//		Русский, Маленькие, Большие, Цифры, Знаки - (Булево) Использование символов
//		Длина - (Число) Длина пароля
Функция ГенераторПароля(Русский = Ложь, Маленькие = Истина, Большие = Ложь, Цифры = Истина, Знаки = Ложь, Длина = 8) Экспорт
	ГСЧ = Новый ГенераторСлучайныхЧисел();
	
	МаленькиеРусскиеБуквыЛевые = "ёйцукефывапячсми";
	МаленькиеРусскиеБуквыПравые = "нгшзхърлджэитьбю";
	БольшиеРусскиеБуквыЛевые = "ЁЙЦУКЕФЫВАПЯЧСМИ";
	БольшиеРусскиеБуквыПравые = "НГШЗХЪРЛДЖЭИТЬБЮ";
	ЦифрыЛевые = "123456";
	ЦифрыПравые = "789";
	ЗнакиРусскиеЛевые = "!""№;%:";
	ЗнакиРусскиеПравые = "-=.?*()_+,";
	МаленькиеЛатинскиеБуквыЛевые = "qwertasdfgzxcvb";
	МаленькиеЛатинскиеБуквыПравые = "yuiphklbnm";
	БольшиеЛатинскиеБуквыЛевые = "QWERTASDFGZXCVB";
	БольшиеЛатинскиеБуквыПравые = "YUIPHKLBNM";
	ЗнакиЛатинскиеЛевые = "`~!@#$%^";
	ЗнакиЛатинскиеПравые = "-=[];',./&*()_+{}:""<>?";
	
	НаборЛевый = "";
	НаборПравый = "";
	
	Если русский тогда
		если маленькие тогда
			НаборЛевый = НаборЛевый + МаленькиеРусскиеБуквыЛевые;
			НаборПравый =НаборПравый+ МаленькиеРусскиеБуквыПравые;
		КонецЕсли;
		если Большие тогда
			НаборЛевый = НаборЛевый + БольшиеРусскиеБуквыЛевые;
			НаборПравый = НаборПравый + БольшиеРусскиеБуквыПравые;
		КонецЕсли;
		если Цифры тогда
			НаборЛевый = НаборЛевый + ЦифрыЛевые;
			НаборПравый = НаборПравый + ЦифрыПравые;
		КонецЕсли;
		если Знаки тогда
			НаборЛевый = НаборЛевый + ЗнакиРусскиеЛевые;
			НаборПравый = НаборПравый + ЗнакиРусскиеПравые;
		КонецЕсли;
	иначе
		если маленькие тогда
			НаборЛевый = НаборЛевый + МаленькиеЛатинскиеБуквыЛевые;
			НаборПравый = НаборПравый + МаленькиеЛатинскиеБуквыПравые;
		КонецЕсли;
		если Большие тогда
			НаборЛевый = НаборЛевый + БольшиеЛатинскиеБуквыЛевые;
			НаборПравый = НаборПравый + БольшиеЛатинскиеБуквыПравые;
		КонецЕсли;
		если Цифры тогда
			НаборЛевый = НаборЛевый + ЦифрыЛевые;
			НаборПравый = НаборПравый + ЦифрыПравые;
		КонецЕсли;
		если Знаки тогда
			НаборЛевый = НаборЛевый + ЗнакиЛатинскиеЛевые;
			НаборПравый = НаборПравый + ЗнакиЛатинскиеПравые;
		КонецЕсли;
	КонецЕсли;
	
	НовыйПароль = "";
	Для НомерСимвола = 1 По Длина Цикл
		если НомерСимвола%2=0 тогда			
			ТекущийНабор = НаборЛевый;
		иначе
			ТекущийНабор = НаборПравый;
		КонецЕсли;
		ДлинаНабора = СтрДлина(ТекущийНабор);
		НачальныйНомер = ГСЧ.СлучайноеЧисло(1, ДлинаНабора);
		символ = Сред(ТекущийНабор, НачальныйНомер, 1);
		НовыйПароль = НовыйПароль + Символ;
	КонецЦикла;
		
	Возврат НовыйПароль;
КонецФункции
	
Функция ПолучитьСтатусПользователяB2B(ПользовательB2B) Экспорт
	//Не Опубликован И ID заполнено - отличается
	Если НЕ ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID <> 0 Тогда
		ЦветСтатуса = Новый Цвет(255, 255, 200);
		ТекстСтатуса = "Отличается на В2В";
	//Не Опубликован И ID = 0 - Еще не публиковался
	ИначеЕсли НЕ ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID = 0 Тогда
		ЦветСтатуса = Новый Цвет(200, 240, 255);
		ТекстСтатуса = "Не опубликован";
	//Опубликован И ID = 0 - Удален
	ИначеЕсли ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID = 0 Тогда
		ЦветСтатуса = Новый Цвет(255, 150, 150);
		ТекстСтатуса = "Удален на В2В";
	ИначеЕсли ПользовательB2B.Блокировка Тогда
		ЦветСтатуса = Новый Цвет(200, 255, 200);
		ТекстСтатуса = "Заблокирован";
	Иначе
		НЗ = РегистрыСведений.уб_СвязкаВ2ВПользователиГруппы.СоздатьНаборЗаписей();
		СправочникПользовательB2B = Справочники.уб_ПользователиB2B;
		НЗ.Отбор.Пользователь.Установить(СправочникПользовательB2B.НайтиПоКоду(ПользовательB2B.код));
		НЗ.Прочитать();
		Если НЗ.Количество() = 0 Тогда
			ЦветСтатуса = Новый Цвет(240, 220, 255);
			ТекстСтатуса = "Групп неопределено";
		Иначе
			ЦветСтатуса = Новый Цвет();
			ТекстСтатуса = "Опубликован";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ЦветСтатуса, ТекстСтатуса", ЦветСтатуса, ТекстСтатуса);
КонецФункции

Функция ПолучитьСтатусМассиваПользователейB2B(Массив) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(уб_ПользователиB2B.JoomlaID) КАК JoomlaID,
	|	МАКСИМУМ(уб_ПользователиB2B.Опубликован) КАК Опубликован,
	|	МАКСИМУМ(уб_ПользователиB2B.Блокировка) КАК Блокировка,
	|	уб_ПользователиB2B.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров) КАК Количество
	|ИЗ
	|	Справочник.уб_ПользователиB2B КАК уб_ПользователиB2B
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_СвязкаВ2ВПользователиГруппы КАК уб_СвязкаВ2ВПользователиГруппы
	|		ПО уб_СвязкаВ2ВПользователиГруппы.Пользователь = уб_ПользователиB2B.Ссылка
	|ГДЕ
	|	уб_ПользователиB2B.Ссылка В(&Массив)
	|
	|СГРУППИРОВАТЬ ПО
	|	уб_ПользователиB2B.Ссылка";
	Запрос.УстановитьПараметр("Массив", Массив);
	ПользовательB2B = Запрос.Выполнить().Выбрать();
	Соответсвие = Новый Соответствие;
	Пока ПользовательB2B.Следующий() Цикл
		//Не Опубликован И ID заполнено - отличается
		Если НЕ ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID <> 0 Тогда
			ЦветСтатуса = Новый Цвет(255, 255, 200);
			ТекстСтатуса = "Отличается на В2В";
			//Не Опубликован И ID = 0 - Еще не публиковался
		ИначеЕсли НЕ ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID = 0 Тогда
			ЦветСтатуса = Новый Цвет(200, 240, 255);
			ТекстСтатуса = "Не опубликован";
			//Опубликован И ID = 0 - Удален
		ИначеЕсли ПользовательB2B.Опубликован И ПользовательB2B.JoomlaID = 0 Тогда
			ЦветСтатуса = Новый Цвет(255, 150, 150);
			ТекстСтатуса = "Удален на В2В";
		ИначеЕсли ПользовательB2B.Блокировка Тогда
			ЦветСтатуса = Новый Цвет(200, 255, 200);
			ТекстСтатуса = "Заблокирован";
		Иначе
			Если ПользовательB2B.Количество = 0 Тогда
				ЦветСтатуса = Новый Цвет(240, 220, 255);
				ТекстСтатуса = "Групп неопределено";
			Иначе
				ЦветСтатуса = Новый Цвет();
				ТекстСтатуса = "Опубликован";
			КонецЕсли;
		КонецЕсли;
		Структура = Новый Структура("ЦветСтатуса, ТекстСтатуса", ЦветСтатуса, ТекстСтатуса);
		Соответсвие.Вставить(ПользовательB2B.Ссылка, Структура);
	КонецЦикла;
	Возврат Соответсвие;
	
КонецФункции

//Функция для проверки!
Функция Temp(id) Экспорт
	//СтруктураПользователя = ДайДанныеПоSid(sid);
	СписокId = уб_B2B.UnJSON(id);
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	РезультатОбъединения = Новый ТаблицаЗначений;
	РезультатОбъединения.Колонки.Добавить("path");
	
	Для Каждого СтрокаId Из СписокId Цикл
		//Разбиваем полученную строку на массив
		СтруктураПараметров = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтрокаId, "/");
		КоличествоПараметров = СтруктураПараметров.Количество();
	
		Если КоличествоПараметров = 1 Тогда
			МассивПервогоПараметра		= ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтруктураПараметров[0]);
			КоличествоПервогоПараметра	= МассивПервогоПараметра.Количество();
			
			//Это файл
			Если КоличествоПервогоПараметра = 1 Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
				|			ТОГДА """"
				|		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
				|	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
				|ИЗ
				|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
				|ГДЕ
				|	уб_ФайлыКПолисам.УИД = &УИД
				|	И уб_ФайлыКПолисам.Размещен
				|	И ВЫБОР
				|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
				|		КОНЕЦ");
									  
				Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
				Запрос.УстановитьПараметр("УИД", СтрокаId);
				Рез = Запрос.Выполнить().Выгрузить();
			//Это путь папки 1 уровня Поставщик-ОргАгент
			Иначе
				ПараметрПоставщик	= МассивПервогоПараметра[0];
				ПараметрОргАгент	= МассивПервогоПараметра[1];
				
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
				|			ТОГДА """"
				|		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
				|	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
				|ИЗ
				|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
				|ГДЕ
				|	ВЫБОР
				|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
				|		КОНЕЦ
				|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.Код = &ОрганизацияАгент
				|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик.Код = &Поставщик
				|	И уб_ФайлыКПолисам.Размещен");
				Запрос.УстановитьПараметр("Поставщик", ПараметрПоставщик);
				Запрос.УстановитьПараметр("ОрганизацияАгент", ПараметрОргАгент);
				Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
				Рез = Запрос.Выполнить().Выгрузить();
			КонецЕсли;
		//Это путь папки 2 уровня Поставщик-ОргАгент/дата
		ИначеЕсли КоличествоПараметров = 2 Тогда
			МассивПервогоПараметра		= ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтруктураПараметров[0]);
			ПараметрПоставщик	= МассивПервогоПараметра[0];
			ПараметрОргАгент	= МассивПервогоПараметра[1];
			ДатаНачала = Дата("20" + СтруктураПараметров[1] + "01");
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
			|			ТОГДА """"
			|		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
			|	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
			|ИЗ
			|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
			|		КОНЕЦ
			|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.Код = &ОрганизацияАгент
			|	И уб_ФайлыКПолисам.СтраховойПолис.Дата МЕЖДУ &ДатаНач И &ДатаКон
			|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик.Код = &Поставщик
			|	И уб_ФайлыКПолисам.Размещен");
			
			Запрос.УстановитьПараметр("ДатаНач",ДатаНачала);
			Запрос.УстановитьПараметр("ДатаКон",КонецМесяца(ДатаНачала));					  
								  
			Запрос.УстановитьПараметр("Поставщик", ПараметрПоставщик);
			Запрос.УстановитьПараметр("ОрганизацияАгент", ПараметрОргАгент);
			Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
			Рез = Запрос.Выполнить().Выгрузить();
		//Это путь папки 3 уровня Поставщик-ОргАгент/дата/СП
		ИначеЕсли КоличествоПараметров = 3 Тогда
            НовыйУИД = Новый УникальныйИдентификатор(СтруктураПараметров[2]);
			ПараметрСП	= Документы.уб_СтраховойПолис.ПолучитьСсылку(НовыйУИД);
			Если Не ЗначениеЗаполнено(ПараметрСП.Дата) Тогда
				ПараметрСП	= Документы.уб_ОтчетПоставщику.ПолучитьСсылку(НовыйУИД);
			КонецЕсли;
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
			|			ТОГДА """"
			|		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
			|	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
			|ИЗ
			|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
			|ГДЕ
			|	уб_ФайлыКПолисам.Размещен
			|	И уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис
			|	И ВЫБОР
			|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
			|		КОНЕЦ");
			
			Запрос.УстановитьПараметр("СтраховойПолис", ПараметрСП);
			Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
			Рез = Запрос.Выполнить().Выгрузить();
			
		//Это путь папки 4 уровня Поставщик-ОргАгент/дата/СП/Вид
		ИначеЕсли КоличествоПараметров = 4 Тогда
			НовыйУИД = Новый УникальныйИдентификатор(СтруктураПараметров[2]);
			ПараметрСП	= Документы.уб_СтраховойПолис.ПолучитьСсылку(НовыйУИД);
			Если Не ЗначениеЗаполнено(ПараметрСП.Дата) Тогда
				ПараметрСП	= Документы.уб_ОтчетПоставщику.ПолучитьСсылку(НовыйУИД);
				ЗначениеПараметра = СтруктураПараметров[3];
			Иначе
				ЗначениеПараметра = Перечисления.уб_ВидыФайловB2B[СтрЗаменить(СтруктураПараметров[3], " ", "_")];
			КонецЕсли;
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
			|			ТОГДА """"
			|		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
			|	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
			|ИЗ
			|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
			|ГДЕ
			|	уб_ФайлыКПолисам.Размещен
			|	И уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис
			|	И ВЫБОР
			|			КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
			|				ТОГДА ПОДСТРОКА(уб_ФайлыКПолисам.УИД, 1, 8) = &Параметр
			|			ИНАЧЕ уб_ФайлыКПолисам.ВидДокумента.ВидФайлаB2B = &Параметр
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
			|		КОНЕЦ");
			
			Запрос.УстановитьПараметр("СтраховойПолис", ПараметрСП);
			Запрос.УстановитьПараметр("Параметр", ЗначениеПараметра);
			Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
			Рез = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
		
		Для Каждого строка Из Рез Цикл
			НовСтр = РезультатОбъединения.Добавить();
			НовСтр.path = строка.path;
		КонецЦикла;

	КонецЦикла;
	
	Возврат уб_B2B.JSON(РезультатОбъединения);
КонецФункции
