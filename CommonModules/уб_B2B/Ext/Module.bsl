//Функция отправки POST запроса на сервер
//Параметры: строка данных - строка
//Возвращает соответсвие
Функция ОтправитьPOSTЗапросНаСервер(СтрокаДанных) Экспорт
	//Определение переменных
	Boundary = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	
	ИмяФайлаОтправки = ПолучитьИмяВременногоФайла("tmp");
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("tmp");
	
	Если СформироватьФайлОтправки(СтрокаДанных, Boundary, ИмяФайлаОтправки) Тогда
		Если ОтправитьФайл(Boundary, ИмяФайлаОтправки, ИмяФайлаОтвета) Тогда
			Возврат ПрочитатьОтветСервера(ИмяФайлаОтвета);
		Иначе
			ОтветСервера = Новый Соответствие;
			ОтветСервера.Вставить("status", "unavailable");
			Возврат ОтветСервера;
		КонецЕсли;
	Иначе
		//Если не удалось записать файл, надо что то передать...
	КонецЕсли;
КонецФункции

//Формируем файл для отправки
Функция СформироватьФайлОтправки(СтрокаДанных, Boundary, ИмяФайлаОтправки)
	Попытка
		ФайлОтправки = Новый ЗаписьТекста(ИмяФайлаОтправки, КодировкаТекста.UTF8, Символы.ПС, ЛОЖЬ);
		
		//Блок установки кодировки
		ФайлОтправки.ЗаписатьСтроку("--" + Boundary);
		ФайлОтправки.ЗаписатьСтроку("Content-type: text/html; charset=windows-1251" + Символы.ПС);
		ФайлОтправки.ЗаписатьСтроку("--" + Boundary);
		
		//Блок установки данных
		ФайлОтправки.ЗаписатьСтроку("--" + Boundary);
		ФайлОтправки.ЗаписатьСтроку("Content-disposition: form-data; name=""data""" + Символы.ПС);
		ФайлОтправки.ЗаписатьСтроку(СтрокаДанных);
		ФайлОтправки.ЗаписатьСтроку("--" + Boundary);
		
		ФайлОтправки.Закрыть();
		Возврат Истина;
	Исключение
		ТекстОшибки = "Не удалось записать файл для отправки POST запроса!
		|" + СтрокаДанных + "
		|Файл отправки: " + ИмяФайлаОтправки;
		ЗаписатьОшибкуИСообщить(
			ТекстОшибки,
			?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), 
			Истина, 
			УровеньЖурналаРегистрации.Ошибка, 
			, 
			, 
			"Скорее всего проблема с правами. " + ОписаниеОшибки(), СтатусСообщения.Важное
		);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

//Отправляем файл на сервер, получаем ответ
Функция ОтправитьФайл(Boundary, ИмяФайлаОтправки, ИмяФайлаОтвета)
	
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "multipart/form-data; boundary=" + Boundary);	
	Сервер = ПараметрыСеанса.уб_Константы.СерверB2B;
	Порт = ПараметрыСеанса.уб_Константы.Порт;
	АдресСкрипта = ПараметрыСеанса.уб_Константы.АдресСкрипта;
	НТТР = Новый HTTPСоединение(Сервер, Порт);
	Попытка
		НТТР.ОтправитьДляОбработки(ИмяФайлаОтправки, АдресСкрипта, ИмяФайлаОтвета, ЗаголовокHTTP);
		//УдалитьФайлы(ИмяФайлаОтправки);
		Возврат Истина;
	Исключение
		ТекстОшибки = "Не удалось отправить файл POST запроса! " + Сервер + ":" + Порт + "/" + АдресСкрипта + "
		|Файла отправки: " + ИмяФайлаОтправки + ", Файла ответа: " + ИмяФайлаОтвета;
		ЗаписатьОшибкуИСообщить(
			ТекстОшибки,
			?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), 
			Истина, 
			УровеньЖурналаРегистрации.Ошибка, 
			, 
			, 
			"Проверить доступность сервера. " + ОписаниеОшибки(), СтатусСообщения.Важное
		);
		УдалитьФайлы(ИмяФайлаОтправки);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

//Читаем ответ сервера
Функция ПрочитатьОтветСервера(ИмяФайлаОтвета)
	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	Если ФайлОтвета.Существует() Тогда
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок() > 0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();
			Ответ = уб_B2B.UnJSON(ОтветСервера);
			//УдалитьФайлы(ИмяФайлаОтвета);
			Возврат Ответ;
		Иначе
			ТекстОшибки = "Отправка POST запроса на сервер: Получен пустой ответ сервера!
			|Файл ответа: " + ИмяФайлаОтвета;
			ЗаписатьОшибкуИСообщить(
				ТекстОшибки,
				?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), 
				Истина, 
				УровеньЖурналаРегистрации.Ошибка, 
				, 
				, 
				"Скорее всего проблема с правами", 
				СтатусСообщения.Важное
			);
			Возврат Ложь;
		КонецЕсли;
		УдалитьФайлы(ИмяФайлаОтвета);
	Иначе
		ТекстОшибки = "Отправка POST запроса на сервер: Ответ сервера не получен!
		|Файл ответа: " + ИмяФайлаОтвета;
		ЗаписатьОшибкуИСообщить(
			ТекстОшибки,
			?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), 
			Истина, 
			УровеньЖурналаРегистрации.Ошибка, 
			, 
			, 
			"Скорее всего проблема с правами", 
			СтатусСообщения.Важное
		);
		Возврат Ложь;
	КонецЕсли;
КонецФункции

