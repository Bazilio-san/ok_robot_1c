Функция ПолучитьПрочитатьKey(key="", КонтрольнаяФраза = "контрольная фраза") Экспорт
	
	MD5 = Обработки.уб_MD5.Создать();
	
	Соединения = ПолучитьСоединенияИнформационнойБазы();
	
	Для Каждого Соединение из Соединения Цикл
		//Если соединение с базой в режиме предприятия
		Если Соединение.ИмяПриложения = "1CV8" ИЛИ Соединение.ИмяПриложения = "Толстый клиент" Тогда
			//Если key не передали, вернем key для текущего пользователя
			Если ЗначениеНеЗаполнено(key) Тогда
				Если Соединение.Пользователь.УникальныйИдентификатор = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор Тогда
					Возврат MD5.РасчетХЭШ(Строка(Соединение) + КонтрольнаяФраза + Строка(Соединение.Пользователь.УникальныйИдентификатор));
					//Возврат ОбщегоНазначения.MD5Хэш(Строка(Соединение) + КонтрольнаяФраза + Строка(Соединение.Пользователь.УникальныйИдентификатор));
				КонецЕсли;
			//Ищем key в активных соединениях
			Иначе
				Если key = MD5.РасчетХЭШ(Строка(Соединение) + КонтрольнаяФраза + Строка(Соединение.Пользователь.УникальныйИдентификатор)) Тогда
				//Если key = ОбщегоНазначения.MD5Хэш(Строка(Соединение) + КонтрольнаяФраза + Строка(Соединение.Пользователь.УникальныйИдентификатор)) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//Если пытаемся получить key для несуществующего пользователя или 
	//Не удается найти key в активных соединениях возвращаем Ложь
	Возврат Ложь;
КонецФункции

