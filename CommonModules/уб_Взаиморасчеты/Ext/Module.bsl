	|		0,
	|		0,
	|		ВЫБОР
	|			КОГДА ДВОУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ДВОУ)
	|				ТОГДА ДВОУ.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ДВОУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.Штраф)
	|				ТОГДА ДВОУ.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		0,
	|		ВЫБОР
	|			КОГДА ДВОУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ДВОУ)
	|				ТОГДА ДВОУ.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ДВОУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ДВОУ)
	|				ТОГДА ДВОУ.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		ДВОУ.Ссылка.Дата,
	|		ДВОУ.ВнешнийНомер,
	|		ДВОУ.Дата
	|	ИЗ
	|		Документ.уб_ДополнительныеРасчетыСПоставщикомДВОУШтрафы КАК ДВОУ
	|	ГДЕ
	|		НЕ ДВОУ.Ссылка.ПометкаУдаления
	|		И &УсловиеГде3) КАК Итоги
	|
	|СГРУППИРОВАТЬ ПО
	|	Итоги.ОтчетПоставщику,
	|	ЕСТЬNULL(Итоги.ОтчетПоставщику.НомерОтчетаПоставщику, """"),
	|	ЕСТЬNULL(Итоги.ОтчетПоставщику.ВидВзаиморасчета, """")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СостояниеОП.ОтчетПоставщику,
	|	ВТ_СостояниеОП.ФактЗадолженность,
	|	ВЫБОР
	|		КОГДА ВТ_СостояниеОП.ФактЗадолженность = 0
	|				ИЛИ ВТ_СостояниеОП.Начислено - ВТ_СостояниеОП.НачисленоПоКВ = 0
	|			ТОГДА 1
	|		ИНАЧЕ (ВТ_СостояниеОП.Оплачено - ВТ_СостояниеОП.ОплаченоКВ) / (ВТ_СостояниеОП.Начислено - ВТ_СостояниеОП.НачисленоПоКВ)
	|	КОНЕЦ КАК КоэфОплаченности,
	|	ВЫБОР
	|		КОГДА ВТ_СостояниеОП.Задолженность = 0
	|				ИЛИ ВТ_СостояниеОП.Начислено = 0
	|			ТОГДА 1
	|		ИНАЧЕ ВТ_СостояниеОП.Оплачено / ВТ_СостояниеОП.Начислено
	|	КОНЕЦ КАК КоэфОплаченностиВзноса,
	|	ВЫБОР
	|		КОГДА ВТ_СостояниеОП.ЗадолженностьПоКВ = 0
	|				ИЛИ ВТ_СостояниеОП.НачисленоПоКВ = 0
	|			ТОГДА 1
	|		ИНАЧЕ ВТ_СостояниеОП.ОплаченоКВ / ВТ_СостояниеОП.НачисленоПоКВ
	|	КОНЕЦ КАК КоэфОплаченностиКВ,
	|	ВТ_СостояниеОП.Задолженность,
	|	ВТ_СостояниеОП.ЗадолженностьПоКВ,
	|	ВТ_СостояниеОП.Начислено,
	|	ВТ_СостояниеОП.НачисленоПоКВ,
	|	ВТ_СостояниеОП.НачисленоПоКВДляОтчета,
	|	ВТ_СостояниеОП.Оплачено,
	|	ВТ_СостояниеОП.ОплаченоКВ,
	|	ВТ_СостояниеОП.Дата,
	|	ВТ_СостояниеОП.АльтернативноеУдержаниеДопКВ,
	|	ВТ_СостояниеОП.Баланс_Брокер_Поставщик,
	|	ВТ_СостояниеОП.НачисленнаяСуммаВзноса,
	|	ВТ_СостояниеОП.КВСуммаДляОтчета,
	|	ВТ_СостояниеОП.КВСумма,
	|	ВТ_СостояниеОП.КВСумма - ВТ_СостояниеОП.КВСуммаДляОтчета КАК ДопКВ,
	|	ВТ_СостояниеОП.ОтчетПоставщикуДата,
	|	ВТ_СостояниеОП.ОтчетПоставщикуНомер,
	|	ВТ_СостояниеОП.НомерОтчетаПоставщику,
	|	ВТ_СостояниеОП.ВидВзаиморасчета,
	|	ВТ_СостояниеОП.ОплаченоКлиентомФакт,
	|	ВТ_СостояниеОП.СкидкаКлиенту
	|ИЗ
	|	ВТ_СостояниеПромежуточная КАК ВТ_СостояниеОП";
	Если НЕ ВТ="нет" Тогда
		ПозПервогоИЗ = Найти(ТекстЗапроса,"ИЗ
	|	ВТ_СостояниеПромежуточная");
		ТекстЗапроса = Лев(ТекстЗапроса, ПозПервогоИЗ-1)+"ПОМЕСТИТЬ " + ИмяВТ + " 
		|ИЗ"+Сред(ТекстЗапроса,ПозПервогоИЗ+2);
	КонецЕсли;
	Если ОтчетПоставщику = Неопределено Тогда
		СтрокаЗамены1 = "ОплатыПолисов.ОтчетПоставщику ССЫЛКА Документ.уб_ОтчетПоставщику
	|		И ОплатыПолисов.ОтчетПоставщику.Дата > &ДатаАктуальностиОтчетов";
		СтрокаЗамены2 = "ПлатежныеВедомости.ОтчетПоставщику ССЫЛКА Документ.уб_ОтчетПоставщику
	|		И ПлатежныеВедомости.ОтчетПоставщику.Дата > &ДатаАктуальностиОтчетов";
		СтрокаЗамены3 = "ДВОУ.Дата > &ДатаАктуальностиОтчетов"
	Иначе
		СтрокаЗамены1 = "&ОтчетПоставщику = ВЫБОР КОГДА &ЭтоПоставщикДляОтчетаПоКарточкам = ИСТИНА
			|		ТОГДА ОплатыПолисов.ОтчетПоКарточкам.Ссылка
			|	ИНАЧЕ ОплатыПолисов.ОтчетПоставщику.Ссылка
			|КОНЕЦ";
		СтрокаЗамены2 = "ПлатежныеВедомости.ОтчетПоставщику = &ОтчетПоставщику";
		СтрокаЗамены3 = "ДВОУ.Ссылка = &ОтчетПоставщику";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде1", 	СтрокаЗамены1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде2", 	СтрокаЗамены2);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде3", 	СтрокаЗамены3);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОтчетПоставщику", ОтчетПоставщику);
	Если ОтчетПоставщику <> Неопределено Тогда
		Если Поставщик = Неопределено Тогда
			Поставщик = ОтчетПоставщику.Поставщик;
		КонецЕсли;
		Запрос.УстановитьПараметр("ЭтоПоставщикДляОтчетаПоКарточкам", Поставщик = ПараметрыСеанса.уб_Константы.ПоставщикДляОтчетаПоКарточкам);
	КонецЕсли;
	//В объекте может быть другой вид взаиморасчетов в отличии от ссылки
	Если ЗначениеЗаполнено(ВидВзаиморасчетов) Тогда
		Запрос.УстановитьПараметр("ВидВзаиморасчетовСУдержаниемКВ", ВидВзаиморасчетов = Справочники.ВидыВзаиморасчетов.СудержаниемКВ);
	Иначе
		Запрос.УстановитьПараметр("ВидВзаиморасчетовСУдержаниемКВ", Неопределено);
	КонецЕсли;
	//Если ОтчетПоставщику = Неопределено Тогда
		Запрос.УстановитьПараметр("ДатаАктуальностиОтчетов",ДатаАктуальностиОтчетов);//раньше не актуально
	//КонецЕсли;
	Если ВТ = "нет" Тогда
		Таблица = Запрос.Выполнить().Выгрузить();		
		Если ОтчетПоставщику <> Неопределено Тогда
			Если Таблица.Количество() = 0 Тогда
				Таблица.Добавить();
			КонецЕсли;
			Результат = Таблица[0];
		Иначе
			Результат = Таблица;
		КонецЕсли;
	ИначеЕсли ВТ = "да" Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Результат = Запрос.Выполнить();
	Иначе
		//не выполняем запрос
		Результат = Запрос;
	КонецЕсли;
	Возврат Результат;

КонецФункции	

Функция ПолучитьУИДГруппыПоКлючуОперации (КлючОперации) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ Различные
	              |	уб_ВзаиморасчетыПоДоговору.ИДГруппы
	              |ИЗ
	              |	РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	              |ГДЕ
	              |	уб_ВзаиморасчетыПоДоговору.КлючОперации = &КлючОперации";
	Запрос.УстановитьПараметр("КлючОперации",КлючОперации);			  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Количество()>1 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "По переданному КлючОперации: " + КлючОперации+" обнаружено несколько групп взаиморасчетов!";
			Сообщение.Сообщить();		
		КонецЕсли;	
		Возврат Выборка.ИДГруппы;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьУИДГруппыПоДокументу (Документ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	Группы.ИДГруппы
	              |ИЗ
	              |	(ВЫБРАТЬ
	              |		уб_ВзаиморасчетыПоДоговору.ИДГруппы КАК ИДГруппы
	              |	ИЗ
	              |		РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	              |	ГДЕ
	              |		уб_ВзаиморасчетыПоДоговору.Документ = &Документ
	              |	
	              |	ОБЪЕДИНИТЬ ВСЕ
	              |	
	              |	ВЫБРАТЬ
	              |		уб_ВзаиморасчетыПоДоговору.ИДГруппы
	              |	ИЗ
	              |		РегистрСведений.уб_КвитовкаОплат КАК уб_КвитовкаОплат
	              |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	              |			ПО уб_КвитовкаОплат.УИДСтрокиТЧ = уб_ВзаиморасчетыПоДоговору.ИДОперации
	              |	ГДЕ
	              |		(уб_КвитовкаОплат.ОплатаПолиса = &Документ
	              |				ИЛИ уб_КвитовкаОплат.ПриемОплаты = &Документ)) КАК Группы";
	Запрос.УстановитьПараметр("Документ",Документ);			  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Количество()>1 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "По переданному документу: " + Документ+" обнаружено несколько групп взаиморасчетов!";
			Сообщение.КлючДанных = Документ.Ссылка;
			Сообщение.Сообщить();		
		КонецЕсли;	
		Возврат Выборка.ИДГруппы;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	
	
Функция СлияниеГрупп(УИДПриемник,УИДИсточник) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ * 
	                      |ИЗ
	                      |	РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	                      |ГДЕ
	                      |	уб_ВзаиморасчетыПоДоговору.ИДГруппы = &ИДГруппы");
	Запрос.УстановитьПараметр("ИДГруппы",УИДИсточник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Счетчик = 0;
	Запись		= РегистрыСведений.уб_ВзаиморасчетыПоДоговору.СоздатьМенеджерЗаписи(); 
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик+1;
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.ИДГруппы = УИДПриемник;
			Попытка
				Запись.Записать()
			Исключение
				Возврат -1;
			КонецПопытки;	
        КонецЕсли;
			
	КонецЦикла;	
	Возврат Счетчик;
КонецФункции	

Функция ТекстЗапросаВзаиморасчеты2(Расчетно)
	ТекстЗапроса= ?(Расчетно , "ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |	К.УИДСтрокиТЧ КАК УИДСтрокиТЧ,
						  |	К.ОплатаПолиса.Ссылка КАК ОплатаПолиса,
						  |	K2.Ведущая
						  |ПОМЕСТИТЬ ВедомыеСВедущими
						  |ИЗ
						  |	РегистрСведений.уб_КвитовкаОплат КАК К
						  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |			К2.ОплатаПолиса КАК ОплатаПолиса,
						  |			К3.Ведущий КАК Ведущая
						  |		ИЗ
						  |			РегистрСведений.уб_КвитовкаОплат КАК К2
						  |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |					К3.УИДСтрокиТЧ КАК УИДСтрокиТЧ,
						  |					К4.УИДСтрокиТЧ КАК Ведущий
						  |				ИЗ
						  |					РегистрСведений.уб_КвитовкаОплат КАК К3
						  |						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_КвитовкаОплат КАК К4
						  |						ПО К3.ОплатаПолиса = К4.ОплатаПолиса
						  |							И (К4.ОплатаПолиса = &ОплатаПолиса
						  |								ИЛИ К4.ОплатаПолиса.СтраховойПолис = &СтраховойПолис)) КАК К3
						  |				ПО К2.УИДСтрокиТЧ = К3.УИДСтрокиТЧ) КАК K2
						  |		ПО К.ОплатаПолиса = K2.ОплатаПолиса
						  |;
						  |
						  |////////////////////////////////////////////////////////////////////////////////
						  |ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |	Квитовки.УИДСтрокиТЧ,
						  |	Квитовки.ОплатаПолиса,
						  |	Квитовки.Ведущая КАК Ведущая,
						  |	Квитовки.ОплатаПолиса.ОплаченоФакт КАК ОплаченоФакт,
						  |	Квитовки.ОплатаПолиса.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
						  |	Квитовки.ОплатаПолиса.АВилиСкидкаСумма КАК АВилиСкидкаСумма,
						  |	ВЫБОР
						  |		КОГДА Квитовки.ОплатаПолиса.ВидРасчетаСАгентом = ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ)
						  |			ТОГДА ИСТИНА
						  |		ИНАЧЕ ЛОЖЬ
						  |	КОНЕЦ КАК ПоАВ,
						  |	Квитовки.ОплатаПолиса.СкидкаВыплаченаяКлиенту КАК СкидкаВыплаченаяКлиенту,
						  |	Приемки.Сумма КАК СуммаПриемка,
						  |	Приемки.Ссылка КАК Приемка
						  |ПОМЕСТИТЬ КвитовкиИСуммы
						  |ИЗ
						  |	ВедомыеСВедущими КАК Квитовки
						  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |			МИНИМУМ(Квитовки.УИДСтрокиТЧ) КАК УИДСтрокиТЧ,
						  |			Квитовки.Ведущая КАК Ведущая
						  |		ИЗ
						  |			ВедомыеСВедущими КАК Квитовки
						  |		
						  |		СГРУППИРОВАТЬ ПО
						  |			Квитовки.Ведущая) КАК ЗаменаВедущегоНаМИНИМУМ
						  |		ПО (ЗаменаВедущегоНаМИНИМУМ.УИДСтрокиТЧ = Квитовки.Ведущая)
						  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК Приемки
						  |		ПО (Приемки.УИДСтроки = Квитовки.УИДСтрокиТЧ)
						  |;
						  |
						  |////////////////////////////////////////////////////////////////////////////////
						  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	СжатыеПоГруппам.Ведущая КАК Ведущая,
						  |	СжатыеПоГруппам.Операция,
						  |	СжатыеПоГруппам.Сумма,
						  |	СжатыеПоГруппам.Документ,
						  |	ВЫБОР
						  |		КОГДА ВЫБОР
						  |				КОГДА СжатыеПоГруппам.Документ ССЫЛКА Документ.уб_СтраховойПолис
						  |					ТОГДА СжатыеПоГруппам.Документ.СостояниеПолиса
