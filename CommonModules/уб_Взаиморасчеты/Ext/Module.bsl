//Формирует временную таблицу регистра взаиморасчетов по документу и его движениям
Функция ЗапросПоВзаиморасчетамДокумента(Документ,КлючОперации=Неопределено) Экспорт
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	уб_ВзаиморасчетыПоДоговору.ИДГруппы КАК ИДГруппы,
	                      |	уб_ВзаиморасчетыПоДоговору.Операция КАК Операция,
						  |	уб_ВзаиморасчетыПоДоговору.КлючОперации КАК КлючОперации,
	                      |	уб_ВзаиморасчетыПоДоговору.Сумма КАК Сумма,
	                      |	уб_ВзаиморасчетыПоДоговору.Документ КАК Документ,
	                      |	уб_ВзаиморасчетыПоДоговору.ИДОперации КАК ИДОперации,
	                      |	уб_ВзаиморасчетыПоДоговору.Страхователь,
	                      |	уб_ВзаиморасчетыПоДоговору.Поставщик,
	                      |	уб_ВзаиморасчетыПоДоговору.Агент,
	                      |	уб_ВзаиморасчетыПоДоговору.ДатаОперации,
	                      |	уб_ВзаиморасчетыПоДоговору.ОрганизацияАгент,
	                      |	уб_ВзаиморасчетыПоДоговору.ТипОперации
	                      |ПОМЕСТИТЬ ДвиженияДокументаПоОперации
	                      |ИЗ
	                      |	РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	                      |ГДЕ
	                      |	уб_ВзаиморасчетыПоДоговору.Документ = &Документ"+
	                      ?(КлючОперации=Неопределено,""," И уб_ВзаиморасчетыПоДоговору.КлючОперации = &КлючОперации");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;					  
	Запрос.УстановитьПараметр("Документ",Документ);
	Запрос.УстановитьПараметр("КлючОперации",КлючОперации);
	Запрос.Выполнить();
    Возврат Запрос;
КонецФункции	

//Отражает операцию в регистре взаиморасчетов, если операция с заданными параметрами есть, добивает до указаной операции суммой  
Функция ОтразитьОперациюВзаиморасчета(
	КлючОперации, 
	ВидОперации				= Неопределено,
	Документ,
	ЗначениеОтбора,
	Знач СуммаОперации,
	СтруктураПараметров,
	ИДГруппы				= Неопределено,
	Запрос 					= Неопределено
	) Экспорт
	
	Если НЕ ПараметрыСеанса.уб_Константы.ВестиВзаиморасчетыПоОперациям = Истина Тогда
		Возврат Ложь;
	КонецЕсли;	
	Если ВидОперации = Неопределено Тогда
		Если КлючОперации = "КВСумма" Тогда 
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.НачислениеКВБрокера;
		ИначеЕсли КлючОперации = "ВычетСАгента"	 Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.УдержаниеИзВМ;
		ИначеЕсли КлючОперации = "СкидкаВыплаченаяКлиенту" Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.ВыплатаКлиенту;
		ИначеЕсли КлючОперации = "НачислениеВМ"  Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.НачислениеВМ;
		ИначеЕсли КлючОперации = "НачисленнаяСуммаВзноса"  Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.НачислениеСтраховогоВзноса;
		ИначеЕсли КлючОперации = "УдержаноМенеджеромИзДСКлиента" Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.УдержаноМенеджеромИзДСКлиента;
			//---Скидка Клиенту		
		ИначеЕсли КлючОперации = "СкидкаКлиентуИзДБ" Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.СкидкаКлиентуИзДБ;
		ИначеЕсли КлючОперации = "СуммовыеОтклоненияВПриемке" Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.СуммовыеОтклоненияВПриемке;	
		ИначеЕсли КлючОперации = "СозданиеСтраховогоПолиса" Тогда
			ВидОперации = Справочники.уб_ВидыРасчетныхОпераций.СозданиеСтраховогоПолиса;		
		Иначе
			#Если Клиент Тогда
				Сообщить("Не определен вид операции для ключа: "+КлючОперации);
			#КонецЕсли	
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;		
    Если Запрос = Неопределено Тогда
		//Получить все, что ранее уже отражено по данному документу
		Запрос = ЗапросПоВзаиморасчетамДокумента(Документ);	
	КонецЕсли;		
    //Определение ранее отраженной суммы по виду операции 
	ТекстЗапроса = "
               |Выбрать * из ДвиженияДокументаПоОперации
			   |;
			   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
               |	уб_ВзаиморасчетыПоДоговору.ИДГруппы КАК ИДГруппы,
               |	уб_ВзаиморасчетыПоДоговору.ИДГруппы КАК КоличествоГрупп,
               |	уб_ВзаиморасчетыПоДоговору.Операция,
			   |	уб_ВзаиморасчетыПоДоговору.КлючОперации,
               |	уб_ВзаиморасчетыПоДоговору.ИДОперации КАК ИДОперации,
               |	уб_ВзаиморасчетыПоДоговору.Сумма КАК Сумма,
               |	уб_ВзаиморасчетыПоДоговору.Документ,
               |	уб_ВзаиморасчетыПоДоговору.Страхователь,
               |	уб_ВзаиморасчетыПоДоговору.Поставщик,
               |	уб_ВзаиморасчетыПоДоговору.Агент,
               |	уб_ВзаиморасчетыПоДоговору.ДатаОперации КАК ДатаОперации,
               |	уб_ВзаиморасчетыПоДоговору.ОрганизацияАгент,
               |	уб_ВзаиморасчетыПоДоговору.ТипОперации
               |ИЗ
               |	ДвиженияДокументаПоОперации КАК уб_ВзаиморасчетыПоДоговору
               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
			   |		ВЫБРАТЬ РАЗЛИЧНЫЕ 
			   |			ИДГруппы 
			   |		ИЗ 
			   |			ДвиженияДокументаПоОперации 
			   |        ГДЕ 
			   |           ДвиженияДокументаПоОперации.Операция =&Операция 
			   |           И ДвиженияДокументаПоОперации.КлючОперации = &КлючОперации 
			   |           И (1 = 1)) КАК УИДГруппы
               |		ПО уб_ВзаиморасчетыПоДоговору.ИДГруппы = УИДГруппы.ИДГруппы
               |			 И уб_ВзаиморасчетыПоДоговору.Операция =&Операция
			   |			 И уб_ВзаиморасчетыПоДоговору.КлючОперации = &КлючОперации
               |УПОРЯДОЧИТЬ ПО ДатаОперации
			   |ИТОГИ
               |	МАКСИМУМ(ИДГруппы),
               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоГрупп),
               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИДОперации),
               |	СУММА(Сумма),
               |	МАКСИМУМ(ДатаОперации)
               |ПО
               |	ОБЩИЕ
			   | ";
		//ОтборПоУИД = ТипЗНЧ(значениеОтбора)=Тип("Строка");
		//
		//Если ОтборПоУИД Тогда
		//	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"ДвиженияДокументаПоОперации.КлючОперации = &КлючОперации","(ДвиженияДокументаПоОперации.ИДОперации=&ЗначениеОтбора ИЛИ ДвиженияДокументаПоОперации.ИДГруппы=&ЗначениеОтбора")+" ";
		//КонецЕсли;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"1 = 1","ДвиженияДокументаПоОперации.Документ=&ЗначениеОтбора")+" ";
	Запрос.УстановитьПараметр("ЗначениеОтбора",ЗначениеОтбора);
	Запрос.УстановитьПараметр("Операция",ВидОперации);
	Запрос.УстановитьПараметр("КлючОперации",КлючОперации);	
	//ВыборкаПоДокументу = Запрос.ВыполнитьПакет()[0].Выбрать();//Для отладки
	ВыборкаОтраженных = Запрос.Выполнить().Выбрать();					 	
	//Строка итогов
	Если ВыборкаОтраженных.Следующий() Тогда
		СуммаОтразить = СуммаОперации - ВыборкаОтраженных.Сумма;
		Если СуммаОтразить <> 0 Тогда
			Если ВыборкаОтраженных.КоличествоГрупп = 1 Тогда
			Иначе
				//Операция взаиморасчетов не должна проходить по нескольким группам (либо это ошибка, либо группы должны слиться в одну)
				//TODO задание либо информирование пользователя о необходимости слияния
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибочное количество групп ("+ВыборкаОтраженных.КоличествоГрупп+") по строке в "+Документ+" КлючОперации:"+КлючОперации,"",Истина,,,Документ,"Взаиморасчеты.Error");
				Возврат Ложь;
			КонецЕсли;	
			ИДГруппы = ВыборкаОтраженных.ИДГруппы;
			ДатаОперации = 
			//?(ВыборкаОтраженных.ДатаОперации=СтруктураПараметров.Дата И ВыборкаОтраженных.ИДОперации <=1,//Если дата не поменялась TODO подумать как отслеживать правку суммы после отвязки от подтвержденного ОК
			//  СтруктураПараметров.Дата,
			  ?(НачалоДня(ТекущаяДата())= НачалоДня(ВыборкаОтраженных.ДатаОперации),//Корректировки внутри дня схлапываются
			    ВыборкаОтраженных.ДатаОперации,
			    ТекущаяДата()
				)
				//)
				;
			СуммаПоДате = 0;
			РанееОтраженоОпераций = 0;
			ИДОперации  = Неопределено;
			Пока ВыборкаОтраженных.Следующий() Цикл
				//Поиск УИД соответствующего выбранной дате операции
				Если ВыборкаОтраженных.ДатаОперации = ДатаОперации Тогда
					Если ИДОперации  = Неопределено Тогда
						ИДОперации = ВыборкаОтраженных.ИДОперации;
					КонецЕсли;
					Если ИДОперации = ВыборкаОтраженных.ИДОперации Тогда
						СуммаПоДате = СуммаПоДате+ВыборкаОтраженных.Сумма;
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;		
			Если ИДОперации  = Неопределено Тогда
				//По этой дате операции еще не записывались
				ИДОперации = Строка(Новый УникальныйИдентификатор);	
				ТипОперации = "Основная";
			Иначе	
				ТипОперации = "Корректировка";
			КонецЕсли;	
			СуммаПоДате = СуммаОтразить+СуммаПоДате;
			//Если СуммаПоДате + СуммаОтразить = Сумма Тогда
			//	// Контроль контроль отражения суммы
			//	//Все операции при совпадающей дате должны проходить по одному ИДОперации
			//	Сообщить("Множественные УИД ");
			//КонецЕсли;	
		КонецЕсли;
	Иначе
		//Еще не отражалась, такая сумма Генерируем новую группу 
		СуммаОтразить = СуммаОперации;
		СуммаПоДате   = СуммаОтразить;
		ИДГруппы = ?(ИДГруппы=Неопределено,Строка(Новый УникальныйИдентификатор),ИДГруппы);
		ДатаОперации = СтруктураПараметров.Дата;
		//Первая операция записывается по
		//ИДОперации  = ?(ОтборПоУИД,ЗначениеОтбора,Строка(Новый УникальныйИдентификатор));;
		ИДОперации  = Строка(Новый УникальныйИдентификатор);
		ТипОперации = "Основная";
	КонецЕсли;
	Если СуммаОтразить <> 0 
		ИЛИ (СуммаОперации = 0 и ТипЗнч(Документ)=Тип("ДокументСсылка.уб_СтраховойПолис"))  //По нему запись пустышка TODO Параметром?
		Тогда
		Запись = РегистрыСведений.уб_ВзаиморасчетыПоДоговору.СоздатьМенеджерЗаписи();
		//Измерения
		Запись.ИДОперации = ИДОперации;
		//Ресурсы
		Запись.ИДГруппы     	= ИДГруппы;
		Запись.Операция     	= ВидОперации;
		Запись.КлючОперации 	= КлючОперации;
		Запись.Сумма        	= СуммаПоДате;
		Запись.Документ     	= Документ;
		Запись.Страхователь 	= СтруктураПараметров.Страхователь; //TODO 
		Запись.Поставщик    	= СтруктураПараметров.Поставщик;
		Запись.Агент        	= СтруктураПараметров.агент;
		Запись.ДатаОперации 	= ДатаОперации; //TODO
		Запись.ОрганизацияАгент = СтруктураПараметров.ОрганизацияАгент;
		//Реквизиты
		Запись.ТипОперации = ТипОперации;
		Попытка
			Запись.Записать();
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("При записи движения взаиморасчета "+Документ+" КлючОперации:"+КлючОперации+"/"+ОписаниеОшибки(),"",Истина,,,Документ,"Взаиморасчеты.Error");
		КонецПопытки;	
		Возврат Истина;//Успешно
	КонецЕсли;	
	Возврат Ложь;//Операция не произведена
	//---Взаиморасчеты по Группе полисов
	
КонецФункции

//Показывает взаиморасчеты связанные с указанными документом или УИД операции 
Функция ПоказатьВзаиморасчеты(Ссылка,Владелец = Неопределено) Экспорт
	Форма = ПолучитьОбщуюФорму("уб_ВзаиморасчетыПоГруппеПолисов");
	Форма.ОбъектВзаиморасчетов = Ссылка;
	Если НЕ Владелец = Неопределено Тогда
		Форма.ВладелецФормы = Владелец;
	КонецЕсли;	
	Форма.Открыть();
КонецФункции	

//Возвращает строку состояния взаиморасчетов по Отчету поставщику или в виде запроса с сформированной временной таблицей
//TODO Убрать 
Функция ПолучитьСостояниеОтчетаПоставщику(ОтчетПоставщику,ВТ = "нет", ИмяВТ = "ВТ_СостояниеОП", ДатаАктуальностиОтчетов = '20110101000000', ВидВзаиморасчетов = Неопределено, Знач Поставщик = Неопределено) Экспорт
	
	//ОтчетПоставщику  - отчет поставщику или ДВОУ/штраф
	//ФактЗадолженность - общая задолженность за минусом КВ в независимости от вида удержания
	//КоэфОплаченности - коэффициент оплаченности по общей задолженности <=1
	//КоэфОплаченностиВзноса - коэффициент оплаченности взносов поставщику <=1
	//КоэфОплаченностиКВ - коэффициент оплаченности КВ поставщиком <=1
	//Задолженность - задолженность по взносам/по штрафам, при виде взаиморасчетов с удержанием за минусом КВ с учетом оплаты поставщику
	//ЗадолженностьПоКВ - задолженность по КВ/ДВОУ, при виде взаиморасчетов с удержанием = 0 с учетом оплаты взносов
	//Начислено - задолженность по взносам, при виде взаиморасчетов с удержанием за минусом КВ
	//НачисленоПоКВ - задолженность по КВ/ДВОУ, при виде взаиморасчетов с удержанием = 0
	//НачисленоПоКВДляОтчета задолженность по КВ по реквизиту кв для отчета, при виде взаиморасчетов с удержанием = 0
	//Оплачено   - сумма платежей по направлению взаиморасчетов ПеречислениеПоставщику/ПеречислениеПоставщикуСтрахователем
	//ОплаченоКВ - сумма платежей по направлению взаиморасчетов ПоступлениеКВОтПоставщика 
	//Дата  - дата последнего платежа в независимости от направления,
	//АльтернативноеУдержаниеДопКВ - признак альтернативного удержания доп КВ (перебрасывается/уточнить), устанавливается в карточке поставщику,
	//Баланс_Брокер_Поставщик - итог по полям оплат полисов/при отрицательном сигнализирует, что преимущественно в отчете оплата поставщику напрямую,
	//НачисленнаяСуммаВзноса - итог по полю ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику оплат полисов,
	//КВСуммаДляОтчета - итог по полю КВСуммаДляОтчета,
	//КВСумма - итог по полю КВСумма,
	//ДопКВ - итог по полю КВСумма-КВСуммаДляОтчета,
	//ОтчетПоставщикуДата -  Дата отчета поставщику,
	//ОтчетПоставщикуНомер - Системный номер
	//НомерОтчетаПоставщику - номер для поставщика,
	//ВидВзаиморасчета  - вид взаиморасчетов по отчету   
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Итоги.ОтчетПоставщику,
	|	СУММА(Итоги.Задолженность - Итоги.ЗадолженностьПоКВ) КАК ФактЗадолженность,
	|	СУММА(Итоги.Задолженность) КАК Задолженность,
	|	СУММА(Итоги.ЗадолженностьПоКВ) КАК ЗадолженностьПоКВ,
	|	СУММА(Итоги.Начислено) КАК Начислено,
	|	СУММА(Итоги.НачисленоПоКВ) КАК НачисленоПоКВ,
	|	СУММА(Итоги.НачисленоПоКВДляОтчета) КАК НачисленоПоКВДляОтчета,
	|	СУММА(Итоги.Оплачено) КАК Оплачено,
	|	СУММА(Итоги.ОплаченоКВ) КАК ОплаченоКВ,
	|	СУММА(Итоги.ОплаченоФакт) КАК ОплаченоКлиентомФакт,
	|	СУММА(Итоги.СкидкаКлиенту) КАК СкидкаКлиенту,
