	                |		ИНАЧЕ ПодготовленныеРасчеты.Сумма * ПодготовленныеРасчеты.ВзАгент
	                |	КОНЕЦ КАК ВзАгент,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ИсключатьПриИсклОП
	                |			ТОГДА 0
	                |		ИНАЧЕ ПодготовленныеРасчеты.Сумма * ПодготовленныеРасчеты.ВзКасса
	                |	КОНЕЦ КАК ВзКасса,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ИсключатьПриИсклОП
	                |			ТОГДА 0
	                |		ИНАЧЕ ПодготовленныеРасчеты.Сумма * ПодготовленныеРасчеты.ВзДоходБрокера
	                |	КОНЕЦ КАК ВзДоходБрокера,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ИсключатьПриИсклОП
	                |			ТОГДА 0
	                |		ИНАЧЕ ПодготовленныеРасчеты.Сумма * ПодготовленныеРасчеты.ВзПоставщик
	                |	КОНЕЦ КАК ВзПоставщик,
	                |	ПодготовленныеРасчеты.Страхователь,
	                |	ПодготовленныеРасчеты.Поставщик,
	                |	ПодготовленныеРасчеты.Агент,
	                |	ПодготовленныеРасчеты.ОрганизацияАгент,
	                |	ПодготовленныеРасчеты.НеВключатьВОтчетыПоставщикам КАК НеВключатьВОтчетыПоставщикам,
	                |	ПодготовленныеРасчеты.ИсключитьИзРасчетаЗП КАК ИсключитьИзРасчетаЗП,
	                |	ПодготовленныеРасчеты.Аннулирован КАК Аннулирован,
	                |	ПодготовленныеРасчеты.Состояние,
	                |	ВЫБОР
	                |		КОГДА НЕ ПодготовленныеРасчеты.ОтчетПоставщику = ЛОЖЬ
	                |				И ПодготовленныеРасчеты.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК НетОП,
	                |	ПодготовленныеРасчеты.ОтчетПоставщику,
	                |	NULL КАК ОтчетПоставщику1,
	                |	NULL КАК Задолженность,
	                |	NULL КАК ЗадолженностьКВ,
	                |	NULL КАК Начислено,
	                |	NULL КАК НачисленоКВ,
	                |	NULL КАК Оплачено,
	                |	NULL КАК ОплаченоКВ,
	                |	NULL КАК Дата,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ВзКлиент <> 0
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК флКлиент,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ВзПоставщик <> 0
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК флПоставщик,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ВзАгент <> 0
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК флАгент,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ВзКасса <> 0
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК флКасса,
	                |	ВЫБОР
	                |		КОГДА ПодготовленныеРасчеты.ВзДоходБрокера <> 0
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК флДоходБрокера
	                |ИЗ
	                |	ВзаиморасчетыИОперации КАК ПодготовленныеРасчеты
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ДатаОперации";
	Возврат ТекстЗапроса
КонецФункции	

Функция ПолучитьТаблицуВзаиморасчетов(ОбъектВзаиморасчетов,Расчетно = Истина) Экспорт
	
	Если ЗначениеЗаполнено(ОбъектВзаиморасчетов)= Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;	
	//Далее Двурежимный запрос
	ТекстЗапроса = ТекстЗапросаВзаиморасчеты(Расчетно);
	
	ЗапросТабВзаиморасчетов = ПолучитьСостояниеОтчетаПоставщику(,"ВТ без запроса");//Получаем запрос с итогами задолженностей по отчетам поставщику
	
	//Запрос = Новый Запрос;
	
	ТипОбъекта= ТипЗнч(ОбъектВзаиморасчетов);							   
	Если ТипОбъекта = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		ЗапросТабВзаиморасчетов.УстановитьПараметр("СтраховойПолис",ОбъектВзаиморасчетов.СтраховойПолис);
		ЗапросТабВзаиморасчетов.УстановитьПараметр("ОплатаПолиса",ОбъектВзаиморасчетов.Ссылка);//?(ОбъектВзаиморасчетов.ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка));
	ИначеЕсли ТипОбъекта = Тип("Строка") Тогда	//Приемка оплат или поиск по подоперации
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"уб_ВзаиморасчетыПоДоговору.Документ = &Документ",
												"уб_ВзаиморасчетыПоДоговору.КлючОперации = &УИДСтрокиТЧ");
												
		//	Запрос.Текст = СтрЗаменить(Запрос.Текст,"К4.ОплатаПолиса = &ОплатаПолиса
		//						  |								ИЛИ К4.ОплатаПолиса.СтраховойПолис = &СтраховойПолис","К4.УИДСтрокиТЧ=&УИДСтрокиТЧ");
		ЗапросТабВзаиморасчетов.УстановитьПараметр("УИДСтрокиТЧ",ОбъектВзаиморасчетов);
	Иначе
		ЗапросТабВзаиморасчетов.УстановитьПараметр("СтраховойПолис",ОбъектВзаиморасчетов.Ссылка);
		ЗапросТабВзаиморасчетов.УстановитьПараметр("ОплатаПолиса",ОбъектВзаиморасчетов.Ссылка);//?(ОбъектВзаиморасчетов.ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка));
	КонецЕсли;	
	ЗапросТабВзаиморасчетов.УстановитьПараметр("Документ",ОбъектВзаиморасчетов);		
	
	//В запросе уже есть ВТ с задолженностью
	ЗапросТабВзаиморасчетов.Текст = ЗапросТабВзаиморасчетов.Текст +";
	|"+ ТекстЗапроса;
	
	Взаиморасчеты = ЗапросТабВзаиморасчетов.Выполнить().Выгрузить();
	//Взаиморасчеты.Сортировать("ДатаОперации");
	
	Возврат Взаиморасчеты;
КонецФункции	

Функция ВернутьСписокДействийДляОперации(Операция,ТекущиеДанные,ИмяПоля,Объект,ДоступноРедактирование = Ложь) Экспорт
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	СписокДействий = Новый СписокЗначений;
	Уровень = ТекущиеДанные.Уровень();
	Если Уровень>0 Тогда
		ТекущиеДанные = ТекущиеДанные.Родитель;
	КонецЕсли;	
	ИмяОперации = Справочники.уб_ВидыРасчетныхОпераций.ПолучитьИмяПредопределенного(ТекущиеДанные.Операция);
	
	ЭтоОперацияОткрытогоДокумента = ТекущиеДанные.Документ = Объект.Ссылка;
	Если ЭтоОперацияОткрытогоДокумента   Тогда
		Если ДоступноРедактирование Тогда
			подОперация = Найти("НачислениеСтраховогоВзноса,СкидкаКлиентуИзДБ",ИмяОперации); 
			Если подОперация>0 Тогда
				СписокДействий.Добавить("ИзменитьСкидкуСуммуВзноса", "Изменить начисленный взнос, скидку");	
			КонецЕсли;	
			Если подОперация = 1 Тогда
				//
				Если ТекущиеДанные.Сумма>0 Тогда
					СписокДействий.Добавить("АннулироватьВзнос", "Аннулировать взнос, скидку");	
					Если СистемаНаправлениеПлатежа Тогда
						Если Объект.НаправлениеПлатежа = Перечисления.уб_НаправленияПлатежа.Поставщику Тогда
							СписокДействий.Добавить("ОтразитьВыплатуКлиенту", "Отразить выплату клиенту скидки");
						КонецЕсли;
					Иначе
						Если Объект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику Тогда
							СписокДействий.Добавить("ОтразитьВыплатуКлиенту", "Отразить выплату клиенту скидки");	
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;	
				
			ИначеЕсли подОперация >0 Тогда
				//Скидка
				Если ТекущиеДанные.Сумма>0 Тогда
					СписокДействий.Добавить("ОтменитьСкидку", "Отменить скидку");	
				ИначеЕсли ТекущиеДанные.Сумма<0 Тогда
					СписокДействий.Добавить("ОтменитьСкидку", "Отменить наценку");		
				КонецЕсли;
			ИначеЕсли Найти("НачислениеВМ,УдержаноМенеджеромИзДСКлиента",ИмяОперации) > 0 Тогда
				СписокДействий.Добавить("ОтразитьУдержаниеИзВМ", "Отразить вычет из вознаграждения");	
			КонецЕсли;
		КонецЕсли;
	Иначе	
		//СписокДействий.Добавить("ОткрытьСвязанныйДокумент", "Открыть связанный с операцией документ");	
		СписокДействий.Добавить("ОткрытьСвязанныйДокумент", "Открыть документ """+ТекущиеДанные.ДокументСтрока+"""");	
	КонецЕсли;
	Если СписокДействий.Количество()>0 Тогда
		СписокДействий.Добавить("Разделитель");
	КонецЕсли;	
	СписокДействий.Добавить("ОткрытьТаблицуВсехВзаиморасчетов", "Открыть форму просмотра всех связанных взаиморасчетов");
	СписокДействий.Добавить("ОткрытьФормуОбъединенияГрупп", "Открыть форму объединения групп взаиморасчетов");
	
	Возврат СписокДействий;
	
КонецФункции	

//Общие действия
Процедура ВыполнитьДействие(ДанныеПоСтроке, ИмяКоманды,Владелец) Экспорт
	Документ = ДанныеПоСтроке.Документ;
	ТипДокумента = ТипЗнч(Документ);
	
	Если ИмяКоманды = "ОткрытьСвязанныйДокумент" Тогда
		
		Если ТипДокумента = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда
			//ОткрытьПриемкуОплат(Документ,ПолучитьУИДСтрокиПоДокументам(Документ,Ссылка));
			фФорма = Документ.ПолучитьФорму(,Владелец);
			фФорма.СтруктураИскомойСтроки = Новый Структура("УИДСтроки",ДанныеПоСтроке.КлючОперации); 
			фФорма.Открыть(); 
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
			Документ.ПолучитьФорму().Открыть();
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
			Документ.ПолучитьФорму().Открыть();	
		КонецЕсли;	
	ИначеЕсли ИмяКоманды = "ОткрытьТаблицуВсехВзаиморасчетов" Тогда
		уб_Взаиморасчеты.ПоказатьВзаиморасчеты(ДанныеПоСтроке[?(ТипДокумента = Тип("ДокументСсылка.уб_ПриемкаОплат"),"Ведущая","Документ")],Владелец);
	ИначеЕсли ИмяКоманды = "ОткрытьФормуОбъединенияГрупп" Тогда
		Форма = Обработки.уб_ОбъединениеГруппВзаиморасчетов.ПолучитьФорму(,);
		Форма.Документ1 = ДанныеПоСтроке[?(ТипДокумента = Тип("ДокументСсылка.уб_ПриемкаОплат"),"Ведущая","Документ")];
		Форма.Открыть();
	ИначеЕсли ИмяКоманды = "ОтразитьУдержаниеИзВМ" Тогда
		_СуммаУдержания = 0;
		#Если Клиент Тогда
		Если ВвестиЧисло(_СуммаУдержания,"Удержать с менеджера",15,2) Тогда
			ЗапросВзаиморасчеты = уб_Взаиморасчеты.ЗапросПоВзаиморасчетамДокумента(Документ);
			ИДГруппыВзаиморасчетов = уб_Взаиморасчеты.ПолучитьУИДГруппыПоДокументу(Документ);
			СтруктураПараметров = Новый Структура("Дата,Агент,Страхователь,Поставщик,ОрганизацияАгент",ТекущаяДата(),Документ.Агент,Документ.СтраховойПолис.Страхователь,Документ.Поставщик,Документ.ОрганизацияАгент,Документ.Дата,ЗапросВзаиморасчеты);
			ИДОперации = Строка(Новый УникальныйИдентификатор);//Разовые операции не самосторнирующиеся
			уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета(Строка(Новый УникальныйИдентификатор()),
		Справочники.уб_ВидыРасчетныхОпераций.УдержаниеИзВМ,Документ,ИДОперации,_СуммаУдержания,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	        Оповестить("ИзмененаГруппаВзаиморасчетов",ИДГруппыВзаиморасчетов);
		КонецЕсли;	
		#КонецЕсли
	Иначе	
		Сообщить("Неизвестное действие по взаиморасчетам "+ИмяКоманды+" для "+Документ);	
	Конецесли;	
	
КонецПроцедуры	

Процедура СтатусОтСуммы(эу,Баланс,н0,нПлюс,нМинус,ц0,цПлюс,цМинус,к0,кПлюс=Неопределено,кМинус=Неопределено) Экспорт
	
	Если Баланс = 0 Тогда
		эу.Заголовок  = н0;
		эу.ЦветТекста = Новый Цвет;
		эу.Картинка = Картинка(к0);
	ИначеЕсли Баланс >0 Тогда
		эу.Заголовок  = нПлюс+Формат(Баланс,"ЧЦ=15; ЧДЦ=2");
		эу.ЦветТекста = Новый Цвет(200,0,0);
		эу.Картинка = Картинка(кПлюс);
	Иначе
		эу.Заголовок  = нМинус+Формат(-Баланс,"ЧЦ=15; ЧДЦ=2");
		эу.ЦветТекста = Новый Цвет(50,180,0);
		эу.Картинка = Картинка(кМинус);
	КонецЕсли;	
КонецПроцедуры	

Функция Картинка(Картинка)
	Если Картинка = Неопределено Тогда
		Возврат Новый Картинка;
	ИначеЕсли ТипЗнч(Картинка)=Тип("Строка") Тогда
		Попытка 
			_Картинка = БиблиотекаКартинок[Картинка];
			Возврат _Картинка;
		Исключение
			Возврат Новый Картинка;
		КонецПопытки;	
	ИначеЕсли ТипЗнч("Картинка")=Тип("Картинка") Тогда
		Возврат Картинка;
	Иначе
			Возврат Новый Картинка;
	КонецЕсли;	
КонецФункции	

Функция ПоказателиГруппы(ОбъектВзаиморасчетов) Экспорт
	//Премия
	//НачисленнаяСуммаВзноса
	//ПринятаяСумма
	//СкидкаКлиенту
	//СкидкаКлиентуПроцент //Расчетный
	//ВыплатаКлиенту -Скидка выплаченная клиенту после перечисления безналом
	//АВ 
	//АВПроцент
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Группы.ИДГруппы
	               |ПОМЕСТИТЬ УИДГРУППЫ
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		уб_ВзаиморасчетыПоДоговору.ИДГруппы КАК ИДГруппы
	               |	ИЗ
	               |		РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
	               |	ГДЕ
	               |		уб_ВзаиморасчетыПоДоговору.Документ = &Документ
	               |	
	               //|	ОБЪЕДИНИТЬ ВСЕ
	               //|	
				   //|	ВЫБРАТЬ
				   //|		уб_ВзаиморасчетыПоДоговору.ИДГруппы
				   //|	ИЗ
				   //|		РегистрСведений.уб_КвитовкаОплат КАК уб_КвитовкаОплат
				   //|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ВзаиморасчетыПоДоговору КАК уб_ВзаиморасчетыПоДоговору
				   //|			ПО уб_КвитовкаОплат.УИДСтрокиТЧ = уб_ВзаиморасчетыПоДоговору.ИДОперации
				   //|	ГДЕ
				   //|		(уб_КвитовкаОплат.ОплатаПолиса = &Документ
				   //|				ИЛИ уб_КвитовкаОплат.ПриемОплаты = &Документ)
				   |) КАК Группы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ВЫБОР
	               |				КОГДА ПоказателиГруппы.Документ = &Документ
	               |						И ПоказателиГруппы.Операция = ЗНАЧЕНИЕ(Справочник.уб_ВидыРасчетныхОпераций.СозданиеСтраховогоПолиса)
	               |					ТОГДА ВЫБОР
	               |							КОГДА ПоказателиГруппы.Документ.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
	               |								ТОГДА 0
