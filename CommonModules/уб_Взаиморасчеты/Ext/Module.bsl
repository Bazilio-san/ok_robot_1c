//
Функция СравнитьСкорректироватьТаблицу(ПредыдущиеРасчеты,НовыеРасчеты,ЕстьИзменения =  Ложь, КлючевыеПараметры = "Вид,УидСтроки,Уточнение") Экспорт
	ЕстьИзменения =  Ложь;
	врРасчетыПоЗаявке = ПредыдущиеРасчеты.Скопировать();
	ПредыдущиеРасчеты.Колонки.Добавить("Учтено",Новый ОписаниеТипов("Булево"));
	врРасчетыПоЗаявке.Очистить();
	//.Очистить();
	
	СтруктураПоиска = Новый Структура(КлючевыеПараметры);
	ЕстьИзменения = Ложь;
	Для каждого СтрокаР Из НовыеРасчеты Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаР);
		ПредыдущиеСтроки = ПредыдущиеРасчеты.НайтиСтроки(СтруктураПоиска);
		ИтСуммаКлиент   = 0;
		ИтСуммаМенеджер = 0;
		ИтСуммаБрокер   = 0;
		ИтСуммаБрокерВС   = 0;
		Для каждого СтрокаПР Из ПредыдущиеСтроки Цикл
			//Копирование уже существующих
			СтрокаРПЗ = врРасчетыПоЗаявке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРПЗ,СтрокаПР);
			ИтСуммаКлиент   = ИтСуммаКлиент   + СтрокаПР.СуммаКлиент;
			ИтСуммаМенеджер = ИтСуммаМенеджер + СтрокаПР.СуммаМенеджер;
			ИтСуммаБрокер   = ИтСуммаБрокер   + СтрокаПР.СуммаБрокер;
			ИтСуммаБрокерВС   = ИтСуммаБрокерВС  + СтрокаПР.СуммаБрокерВС;
			СтрокаПР.Учтено  = Истина;
		КонецЦикла;
		
		//Корректировка или создание новой записи расчетов (НР)
		Если ИтСуммаКлиент <> СтрокаР.СуммаКлиент 
			ИЛИ ИтСуммаМенеджер <> СтрокаР.СуммаМенеджер
			ИЛИ ИтСуммаБрокер <> СтрокаР.СуммаБрокер 
			ИЛИ ИтСуммаБрокерВС<> СтрокаР.СуммаБрокерВС Тогда
			СтрокаНР = врРасчетыПоЗаявке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНР,СтрокаР);
			СтрокаНР.СуммаКлиент   = СтрокаР.СуммаКлиент-ИтСуммаКлиент;
			СтрокаНР.СуммаМенеджер = СтрокаР.СуммаМенеджер-ИтСуммаМенеджер;
			СтрокаНР.СуммаБрокер   = СтрокаР.СуммаБрокер-ИтСуммаБрокер;
			СтрокаНР.СуммаБрокерВС = СтрокаР.СуммаБрокерВС-ИтСуммаБрокерВС;
			
			Попытка
			СтрокаНР.ВремяРегистрации = ТекущаяДата();
			СтрокаНР.Автор = ПараметрыСеанса.ТекущийПользователь;
			Исключение
			КонецПопытки;
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	//Отработка удаленных расчетов
	СтруктураПоиска = Новый Структура("Учтено",Ложь);
	ПредыдущиеСтроки = ПредыдущиеРасчеты.Скопировать(СтруктураПоиска);
	ПредыдущиеСтроки.Свернуть(КлючевыеПараметры,"СуммаКлиент,СуммаМенеджер,СуммаБрокер,СуммаБрокерВС");
	Для каждого СтрокаПР Из ПредыдущиеСтроки Цикл
		
		СтруктураПоискаПР = Новый Структура(КлючевыеПараметры);
		ЗаполнитьЗначенияСвойств(СтруктураПоискаПР,СтрокаПР);
		Для каждого СтрокаТекПР Из ПредыдущиеРасчеты.НайтиСтроки(СтруктураПоискаПР) Цикл
			//Копирование уже существующих 
			// с периодами правки
			СтрокаРПЗ = врРасчетыПоЗаявке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРПЗ,СтрокаТекПР);
			СтрокаТекПР.Учтено  = Истина;
		КонецЦикла;
		
		//Сторнирующие расчеты
		Если 0 <> СтрокаПР.СуммаКлиент 
			ИЛИ 0 <> СтрокаПР.СуммаМенеджер
			ИЛИ 0 <> СтрокаПР.СуммаБрокер
			ИЛИ 0 <> СтрокаПР.СуммаБрокерВС Тогда
			СтрокаСР = врРасчетыПоЗаявке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСР,СтрокаПР);
			СтрокаСР.СуммаКлиент   = 0-СтрокаПР.СуммаКлиент;
			СтрокаСР.СуммаМенеджер = 0-СтрокаПР.СуммаМенеджер;
			СтрокаСР.СуммаБрокер   = 0-СтрокаПР.СуммаБрокер;
			СтрокаСР.СуммаБрокерВС = 0-СтрокаПР.СуммаБрокерВС;
			Попытка
				СтрокаСР.ВремяРегистрации = ТекущаяДата();
				СтрокаСР.Автор = ПараметрыСеанса.ТекущийПользователь;
			Исключение
			КонецПопытки;
			
			ЕстьИзменения = Истина;
		КонецЕсли;
		
		
	КонецЦикла;
	Если ЕстьИзменения = Истина  
		ИЛИ врРасчетыПоЗаявке.Итог("СуммаКлиент")   <> ПредыдущиеРасчеты.Итог("СуммаКлиент")
		ИЛИ врРасчетыПоЗаявке.Итог("СуммаМенеджер") <> ПредыдущиеРасчеты.Итог("СуммаМенеджер")
		ИЛИ врРасчетыПоЗаявке.Итог("СуммаБрокер")   <> ПредыдущиеРасчеты.Итог("СуммаБрокер")
		ИЛИ врРасчетыПоЗаявке.Итог("СуммаБрокерВС") <> ПредыдущиеРасчеты.Итог("СуммаБрокерВС")
		Тогда
		//
		ЕстьИзменения = Истина;
		//РасчетыПоЗаявке.Загрузить(врРасчетыПоЗаявке);
	КонецЕсли;	
	Возврат врРасчетыПоЗаявке
КонецФункции	

Процедура ПроверитьСтроку(Строка) Экспорт
	Если ПустаяСтрока(Строка.УидСтроки) Тогда
		Строка.УидСтроки = Новый УникальныйИдентификатор();
	КонецЕсли;	
КонецПроцедуры


