//Функция определяет пол Физ. лица по отчеству
//
//	Параметры:	ФизЛицо					- ссылка на справочник физ. лиц
//				ИгнорироватьЗаполненый	- Если Истина, не производим проверку на заполнение реквизита "Пол"
//
//	Возращаемое значение: Перечисление.ПолФизическихЛиц
//
//	5.3.1.	GetSex
//	function GetSex(pMiddleName: PChar): Integer; stdcall; export;
//	Определяет род по отчеству, записанному в произвольном падеже.
//	Значение, возвращаемое этой функцией, содержит информацию о роде:
//		1 — мужской;
//		0 — женский;
//		-1 — невозможно определить;
//	Позволяет определить род ФИО. Допускается параметром передавать не только отчество, но и ФИО целиком. Главное, чтобы в передаваемой строке последним было отчество.
Функция ФизЛицо_ОпределитьПол(ФизЛицо = "", Отчество = "") Экспорт
	
	Если (ЗначениеНеЗаполнено(ФизЛицо) И ЗначениеНеЗаполнено(Отчество)) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если ЗначениеНеЗаполнено(Отчество) Тогда
		//Получим Отчество
		//PS: если допустима смена пола физ. лица, необходимо добавить параметр на дату
		ФИОСрез 	= РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(,Новый Структура("ФизЛицо", ФизЛицо));
		Отчество	= ФИОСрез.Отчество;
	Иначе
		Если Найти(Отчество,"вич")>0 и Найти(Отчество,"вна")= 0 Тогда
			Возврат	Перечисления.ПолФизическихЛиц.Мужской;
		ИначеЕсли Найти(Отчество,"вна")>0 и Найти(Отчество,"вич")=0 Тогда
			Возврат	Перечисления.ПолФизическихЛиц.Женский;
		КонецЕсли;	
	КонецЕсли;
		
	
	Попытка
		Компонента = Новый COMОбъект("Padeg.Declension");
	Исключение
		Компонента = Null;
		//Сообщить("Не удалось подключить компоненту: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	iПол = Компонента.GetSex(Отчество);
	Компонента = Null;
	
	Если iПол = 1 Тогда
		Возврат	Перечисления.ПолФизическихЛиц.Мужской;
	ИначеЕсли iПол = 0 Тогда
		Возврат	Перечисления.ПолФизическихЛиц.Женский;
	Иначе
		//-1 — невозможно определить;
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьПолПоФамилии(Фамилия) Экспорт
	
	ПоследниеДваСимвола = Прав(СокрЛП(Нрег(Фамилия)),2);
	Если ПоследниеДваСимвола = "ва" Или ПоследниеДваСимвола = "на" Или ПоследниеДваСимвола = "ая" Тогда
		Возврат	Перечисления.ПолФизическихЛиц.Женский;
	ИначеЕсли ПоследниеДваСимвола = "ов" Или ПоследниеДваСимвола = "ев" Или ПоследниеДваСимвола = "ий" Или ПоследниеДваСимвола = "ой" Или ПоследниеДваСимвола = "ый" Тогда
		Возврат	Перечисления.ПолФизическихЛиц.Мужской;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
