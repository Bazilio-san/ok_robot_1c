//Функция получает должность (должность включая подразделение) 
//возвращает склонение в заданном падеже
// Параметр "Падеж" - тип ПеречислениеСсылка.Падежи или число от 1 до 6 
Функция Должность_Склонение(Должность = "", Падеж = 1) Экспорт 
	
	Если нрег(Должность) = "устав" Тогда
		Если Падеж = Перечисления.Падежи.Родительный Тогда
			Возврат Лев(Должность,1)+"става";
		КонецЕсли;	
	КонецЕсли;	
	Рез = Склонение(Должность, Падеж);
	Рез = СтрЗаменить(Рез,". ""","."""); //заменяем глюкавое поведение функции склонения
	Рез = СтрЗаменить(Рез,". ру""",".ру"""); //заменяем глюкавое поведение функции склонения
	Возврат Рез;
	
КонецФункции

