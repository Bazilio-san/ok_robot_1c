Функция ЧисловоеПредствалениеПадежа(Падеж) Экспорт 
	//Возвращает числовое представление падежа в не зависимости от того, передано число или перечисление
	Если ЗначениеНеЗаполнено(Падеж) Тогда
		Возврат 1; //Именительный	
	КонецЕсли;
	
	Если ТипЗнч(Падеж) = Тип("ПеречислениеСсылка.Падежи") Тогда 
		Возврат Перечисления.Падежи.Индекс(Падеж) + 1; 
	ИначеЕсли ТипЗнч(Падеж) = Тип("Число") И Падеж > 0 и Падеж < 7 Тогда
		Возврат Цел(Падеж);
	Иначе
		Возврат 1;
	КонецЕсли;
КонецФункции


//Функция получает либо полное ФИО, либо части ФИО и возвращает склонение ФИО
//Из полного ФИО и из частей выбираются наиболее длинные части и помещаются обратно в параметры 
//Например: ФамилияИмяОтчество = "Иванов И. Иванович", Фамилия = "", Имя = "Иван", Отчество = "И"
//Получим: ФамилияИмяОтчество = "Иванов Иван Иванович", Фамилия = "", Имя = "Иван", Отчество = "Иванович" 
//По отчеству определяется пол, если не передан явно.
//Если бВозвращать_ФИОКратко = Истина, то вернется склонение "Фамилия И. О."
// Параметр "Падеж" - тип ПеречислениеСсылка.Падежи или число от 1 до 6 
//&НаСервере
Функция ФИО_Склонение(Знач ФамилияИмяОтчество = "", Знач Фамилия = "", Знач Имя = "", Знач Отчество = "", Пол = Неопределено, Падеж = Неопределено, 
	бВозвращать_ФИОКратко = Ложь
	,бПробелМеждуТочкойИОтчеством = Истина
	) Экспорт 
	
	ФамилияИмяОтчество = СокрЛП(ФамилияИмяОтчество);
	Фамилия = СокрЛП(Фамилия);
	Имя = СокрЛП(Имя);
	Отчество = СокрЛП(Отчество);	
	ПолучитьФИОБезТочек(Фамилия, Имя, Отчество);						
	
	Если Падеж <> Неопределено и Падеж <> 1 и ПараметрыСеанса.уб_КомпонентаПадежейИнициализирована Тогда
		Попытка 
			Компонента = Новый COMОбъект("Padeg.Declension");
		Исключение
			//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось подключить компоненту склонения для ФИО",,Истина,,,,"Не удалось подключить компоненту Padeg: " + ОписаниеОшибки());
			Компонента = Null;
		КонецПопытки;
	Иначе
		Компонента = Null;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФамилияИмяОтчество) Тогда
		//Дополняет более полными значениями ФИО
		ОбновитьПараметрыФамилияИмяОтчество(ФамилияИмяОтчество, Фамилия, Имя, Отчество, Компонента);		
	КонецЕсли;
	
	Если СтрДлина(Имя) = 1 Тогда
		ТочкаПослеИмени = Истина;
	Иначе
		ТочкаПослеИмени = Ложь;
	КонецЕсли;
	Если СтрДлина(Отчество) = 1 Тогда
		ТочкаПослеОтчества = Истина;
	Иначе
		ТочкаПослеОтчества = Ложь;
	КонецЕсли;
	
	РазделительТиО = ?((НЕ бПробелМеждуТочкойИОтчеством И ТочкаПослеИмени),""," ");
	ФамилияИмяОтчество = СокрЛП(СокрЛП(Фамилия + " " + Имя + (?(ТочкаПослеИмени,".","")) + ?(ПустаяСтрока(Имя),"",РазделительТиО + Отчество + (?(ТочкаПослеОтчества,".","")))));
	//Определять Род с помощью функций Pageg   GetSex(pMiddleName: PChar): 
	//Определяем Род
	Род = Неопределено;
	//Сначала по переданному полу, если передан
	Если Компонента <> NULL Тогда 
		Если ТипЗнч(Пол) = Тип("ПеречислениеСсылка.ПолФизическихЛиц") И ЗначениеЗаполнено(Пол) Тогда 
			Если Пол = Перечисления.ПолФизическихЛиц.Мужской Тогда 
				Род = "М";
			ИначеЕсли Пол = Перечисления.ПолФизическихЛиц.Женский  Тогда
				Род = "Ж";
			КонецЕсли;
		Иначе
			//Если пол не передан, то по отчеству
		    iРод = Компонента.GetSex(ФамилияИмяОтчество);
			Если iРод = 1 Тогда
				Род = "М";
			ИначеЕсли iРод = 0 Тогда
				Род = "Ж";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Нормализуем падеж
	iПадеж = ЧисловоеПредствалениеПадежа(Падеж);
	//Склоняем ФИО
	//Если нет Имени, отчество в функцию не передаем	
	Имя = Имя + ?(ТочкаПослеИмени,".","");	
	Отчество = ?(ПустаяСтрока(Имя),"",Отчество + ?(ТочкаПослеОтчества,".",""));
	ПадежПол = 3;
	Если ТипЗнч(Пол) = Тип("ПеречислениеСсылка.ПолФизическихЛиц") И Не Пол.Пустая() Тогда
		Если Пол = Перечисления.ПолФизическихЛиц.Мужской Тогда
			ПадежПол = 1;
		Иначе
			ПадежПол = 2;
		КонецЕсли;
	КонецЕсли;
	Если Компонента <> NULL Тогда 
		//Для корректного склонения в случае отсутствия отчества необходимо передать Род
		ФИОСклонение = Компонента.GetFIOPadeg(Фамилия, Имя, Отчество, Род, iПадеж);
		Компонента = Null;
	Иначе
		Если iПадеж = 1 Тогда
			ФИОСклонение = ФамилияИмяОтчество;
		Иначе
			ФИОСклонение = Падеж(ФамилияИмяОтчество, ?(бВозвращать_ФИОКратко, -1, 1) * iПадеж, ПадежПол, "123");
		КонецЕсли;
	КонецЕсли;
	Если бПробелМеждуТочкойИОтчеством И ТочкаПослеИмени И НЕ ПустаяСтрока(Отчество) Тогда
		ФИОСклонение = СтрЗаменить(ФИОСклонение,"."+Лев(Отчество,1),". "+Лев(Отчество,1));	
	КонецЕсли;
	Если бВозвращать_ФИОКратко Тогда
		ФамилияВПадеже = ОбщегоНазначения.ВыделитьСлово(ФИОСклонение);		
		Результат = СокрЛП(?(НЕ ПустаяСтрока(ФамилияВПадеже), 
					СокрЛП(ФамилияВПадеже + ?(НЕ ПустаяСтрока(Имя)," " + Лев(Имя,1) + "." + РазделительТиО + ?(НЕ ПустаяСтрока(Отчество),Лев(Отчество,1)+".", ""), "")),
					""));			
	Иначе
		Результат = ФИОСклонение;
	КонецЕсли;
		
	Возврат СокрЛП(Результат);
	
КонецФункции

Процедура ПолучитьФИОБезТочек(Фамилия, Имя, Отчество)
	
	ПозицияПробелаВФамилии = Найти(Фамилия, " ");//в фамилии будет пробел, если инцициалы в поле фамилия
	Если ЗначениеЗаполнено(Имя) И Не ЗначениеЗаполнено(Отчество) Тогда
		ИмяОтчество = Имя;
	ИначеЕсли НЕ ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Отчество) Тогда
		ИмяОтчество = Отчество; 	
	ИначеЕсли НЕ ЗначениеЗаполнено(Имя) И НЕ ЗначениеЗаполнено(Отчество) И ПозицияПробелаВФамилии > 0 Тогда
		ИмяОтчество = СокрЛП(Сред(Фамилия, ПозицияПробелаВФамилии + 1)); //всё, что после пробела - это отчество
		Фамилия = СокрЛП(Лев(Фамилия, ПозицияПробелаВФамилии - 1)); //всё, что до пробела - это фамилия					
	Иначе	
		ИмяОтчество = "";
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ИмяОтчество) Тогда  		
		ПозицияРазделителя = Найти(ИмяОтчество," ");
		Если ПозицияРазделителя = 0 Тогда  //если нет пробела, то ищем точку
			ПозицияРазделителя = Найти(ИмяОтчество,".");
		КонецЕсли;
		Если ПозицияРазделителя = 0 Тогда  //если нет точки, то ищем запятую
			ПозицияРазделителя = Найти(ИмяОтчество,",");
		КонецЕсли;	
		Если ПозицияРазделителя > 0 Тогда						
			Имя = СокрЛП(Лев(ИмяОтчество, ПозицияРазделителя - 1)); //всё, что до разделителя - это имя			
			ТочкаПослеИмени = Истина;
			Отчество = СокрЛП(Сред(ИмяОтчество, ПозицияРазделителя + 1)); //всё, что после разделителя - это отчество
			Если ЗначениеЗаполнено(Отчество) Тогда
				ПозицияРазделителя = Найти(Отчество," ");
				Если ПозицияРазделителя = 0 Тогда  //если нет пробела, то ищем точку
					ПозицияРазделителя = Найти(Отчество,".");
				КонецЕсли;
				Если ПозицияРазделителя = 0 Тогда  //если нет точки, то ищем запятую
					ПозицияРазделителя = Найти(Отчество,",");
				КонецЕсли;
				Если ПозицияРазделителя > 0 Тогда
					Отчество = СокрЛП(Лев(Отчество, ПозицияРазделителя - 1)); //всё, что до разделителя - отчество
					ТочкаПослеОтчества = Истина;
				КонецЕсли;	
			КонецЕсли;		
		КонецЕсли;	
	Иначе			
		Имя = СокрЛП(СтрЗаменить(Имя, ".", ""));
		Отчество = СокрЛП(СтрЗаменить(Отчество, ".", ""));
	КонецЕсли;
КонецПроцедуры
//Разбивает ФИО на отдельные значения и в случае если они длиннее, производит перезаполнение Фамилии, Имени и Отчества
Процедура ОбновитьПараметрыФамилияИмяОтчество(ФамилияИмяОтчество, Фамилия, Имя, Отчество, Компонента)
	
	ФамилияИзФИО 	= "";
	ИмяИзФИО 		= "";
	ОтчествоИзФИО 	= "";
	Если Компонента <> NULL Тогда
		Компонента.SeparateFIO(ФамилияИмяОтчество, ФамилияИзФИО, ИмяИзФИО, ОтчествоИзФИО);
	Иначе
		РазбитаяСтрока = СтрЗаменить(ФамилияИмяОтчество, " ", Символы.ПС);
		ФамилияИзФИО = СтрПолучитьСтроку(РазбитаяСтрока, 1);
		ИмяИзФИО = СтрПолучитьСтроку(РазбитаяСтрока, 2);
		ОтчествоИзФИО = СтрПолучитьСтроку(РазбитаяСтрока, 3);
	КонецЕсли;
	ПолучитьФИОБезТочек(ФамилияИзФИО, ИмяИзФИО, ОтчествоИзФИО);
	Если СтрДлина(ФамилияИзФИО) > СтрДлина(Фамилия) Тогда
		Фамилия = ФамилияИзФИО;
	КонецЕсли;
	Если СтрДлина(ИмяИзФИО) > СтрДлина(Имя) Тогда
		Имя = ИмяИзФИО;	
	КонецЕсли;
	Если СтрДлина(ОтчествоИзФИО) > СтрДлина(Отчество) Тогда
		Отчество = ОтчествоИзФИО;		
	КонецЕсли;
			
КонецПроцедуры	
