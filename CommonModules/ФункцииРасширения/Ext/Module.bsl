Функция СмешениеДвухЦветов(Цвет1,Цвет2,Вариант=0) Экспорт
	
	//Цвета стиля
	Если Цвет1.Красный =-1 Тогда 
		Возврат Цвет2;
	ИначеЕсли Цвет2.Красный =-1 Тогда 	
		Возврат Цвет1;
	КонецЕсли;	
	Если Вариант = 1 Тогда
		//Первый цвет приоритетней
		Результат  = Новый Цвет(ЦЕЛ((Цвет1.Красный+Цвет1.Красный+Цвет2.Красный)/3),ЦЕЛ((Цвет1.Зеленый+Цвет1.Зеленый+Цвет2.Зеленый)/3),ЦЕЛ((Цвет1.Синий+Цвет1.Синий+Цвет2.Синий)/3));
	ИначеЕсли Вариант = 2 Тогда
		//Второй цвет приоритетней
		Результат  = Новый Цвет(ЦЕЛ((Цвет1.Красный+Цвет2.Красный+Цвет2.Красный)/3),ЦЕЛ((Цвет1.Зеленый+Цвет2.Зеленый+Цвет2.Зеленый)/3),ЦЕЛ((Цвет1.Синий+Цвет2.Синий+Цвет2.Синий)/3));
	Иначе
		//Равномерное смешивание
		Результат  = Новый Цвет(ЦЕЛ((Цвет1.Красный+Цвет2.Красный)/2),ЦЕЛ((Цвет1.Зеленый+Цвет2.Зеленый)/2),ЦЕЛ((Цвет1.Синий+Цвет2.Синий)/2));
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

Функция НаложитьНаКартинкуЦвет(Картинка,Цвет,Вариант = 0) Экспорт
	
	Попытка
		Скрипт= Новый COMОбъект("MSScriptControl.ScriptControl");
		Скрипт.language="javascript";
		
		ИмяФайла = ПолучитьИмяВременногоФайла();
		Img =  IMG(Картинка,ИмяФайла);
		
		IP = Новый Comobject("WIA.ImageProcess");
		IP.Filters.Add(IP.FilterInfos("ARGB").FilterID);
		
		Скрипт.AddObject("newARGBData",Img.ARGBData._NewEnum);
		
		Замена = "  var r_ = " + Цвет.Красный + "; 
		| var g_ = " + Цвет.Зеленый + ";
		| var b_ = " + Цвет.Синий   + ";";
		Если Вариант = 0 Тогда
			УсловиеИсключения =	"a == 0";
		Иначе
		КонецЕсли;	
		
		Для номерТочки = 1 по  Img.ARGBData.Count Цикл
			СтрокаНомераТочки = Формат(НомерТочки,"ЧДЦ=0; ЧГ=");
			Если Вариант = 1 Тогда
				УсловиеИсключения =	"newARGBData("+СтрокаНомераТочки+")==  newARGBData(1)";
			КонецЕсли;	
			Строка = Замена+"
			| var argb = newARGBData("+СтрокаНомераТочки+");
			| var a = (argb&0xFF000000)>>24; 
			| var r = (argb&0x00FF0000)>>16; 
			| var g = (argb&0x0000FF00)>>8;
			| var b =  argb&0x000000FF;
			| if ("+УсловиеИсключения+") 
			| 	argb =(a<<24)|(r<<16)|(g<<8)|b;
			| else 
			|	argb =(a<<24)|(((r_+r+r)/3)<<16)|(((g_+g+g)/3)<<8)|((b_+b+b)/3);
			| newARGBData("+СтрокаНомераТочки+") = argb;
			|";
			Попытка
				Скрипт.Eval(Строка);
			Исключение
				Сообщить(ОписаниеОшибки()+Символы.ПС+Строка);
			КонецПопытки;	
		КонецЦикла;	
		IP.Filters(1).Properties("ARGBData").Value = Скрипт.CodeObject.newARGBData;
		
		Img = IP.Apply(Img);
		
		УдалитьФайлы(ИмяФайла);
		Img.SaveFile (ИмяФайла);
		
		Результат =  Новый Картинка(ИмяФайла,Вариант=1);
		УдалитьФайлы(ИмяФайла);
		
		Возврат результат;
	Исключение
		Возврат Картинка;
	КонецПопытки;
КонецФункции	

