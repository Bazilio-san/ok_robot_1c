Функция ПереключательКонтейнера(Контекст, мАрг, ИмяФункции)
	
	//(<АРГ>)
	отладка_Лог_НачалоПроцедуры(Контекст, "ПереключательКонтейнера (" + ИмяФункции + ")");		
	Рез = "";
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 1) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	//Должен быть исключительно именем свойства контейнера
	ИмяСвойства = мАрг[0];
	ТипЗ = ТипЗнч(ИмяСвойства);	
	Если ТипЗ <> Тип("Строка") Тогда
		СОО = "В функцию '" + ИмяФункции + "' (ПереключательКонтейнера) передан аргумент '" + Строка(ИмяСвойства) + "' не являющийся строкой и поэтому не являющийся именем свойства контейнера.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
	Иначе
		RegExp = Новый COMОбъект("VBScript.RegExp");
		RegExp.MultiLine = Ложь;
		RegExp.Global = Истина;
		RegExp.IgnoreCase = Истина;
		RegExp.Pattern = "^[A-Za-zА-Яа-я_][A-Za-zА-Яа-я0-9_]*$";
		Если RegExp.Test(ИмяСвойства) Тогда
			Если ВРег(ИмяФункции) = "ДОК" Тогда
				Контекст.ОперативныйКонтейнер = Контекст.Контейнер_Документ;
			ИначеЕсли ВРег(ИмяФункции) = "ИТОГ" Тогда
				Контекст.ОперативныйКонтейнер = Контекст.Контейнер_Итоги;
			Иначе
				//если и произойдет, то контейнер останется без изменений
			КонецЕсли;
			Рез = ПолучитьСвойство(Контекст, ИмяСвойства);
		Иначе	
			RegExp.Pattern = "[A-Za-zА-Яа-я0-9_]+";
			НедопустимыеСимволы = RegExp.Replace(ИмяСвойства,"");
			СОО = "В функцию '" + ИмяФункции + "' (ПереключательКонтейнера) передан аргумент '" + Строка(ИмяСвойства) + "' содержащий недопустимые символы '" + НедопустимыеСимволы + "' и поэтому неявляющийся именем свойства контейнера.";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		КонецЕсли;
		RegExp = Null;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез; 
	
КонецФункции    

Функция ПадежПФФ(Контекст, мАрг)
	
	//(<АРГ>, <ПАДЕЖ>, <ТИП АРГУМЕНТА>*, <ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>*)
	ИмяФункции = "Падеж";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);	
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 2, 3) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	АРГ = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
	// 2-й аргумент <ПАДЕЖ>
	Падеж = ДайАргумент_Падеж(Контекст, мАрг, ИмяФункции, 2, , Истина);
	// 3-й аргумент <ТИП АРГУМЕНТА>
	
	//По умолчанию тип аргумента "Ф"
	ТипАргумента_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<ТИП АРГУМЕНТА>","Ф"));
	ТипАргумента = ВРег(Лев(ТипАргумента_,1));	
	Если ТипАргумента <> "Ф" и ТипАргумента <> "Д" Тогда
		ТипАргумента = "Ф";  //по умолчанию - ФИО
		СОО = "В функцию 'Падеж' передан неверный 3-й аргумент <ТИП АРГУМЕНТА>: """ + ТипАргумента_ + """.
		|		Должно быть: [должность|Д|фио|Ф]. (Использовано 'Ф')";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;
	Если ТипАргумента = "Ф" Тогда
		// 4-й аргумент <ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>*
		ФИОКратко = ДайАргумент_ПредставлениеФизлица(Контекст, мАрг, ИмяФункции, 4, "Полно");
		ТипЗнчАРГ = ТипЗнч(АРГ);
		Если ТипЗнчАРГ = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Рез = уб_Кэшируемые.ФИОФизлицаСтрокой(АРГ, Контекст.Объект.Дата, ФИОКратко, Падеж);
		ИначеЕсли ТипЗнчАРГ = Тип("СправочникСсылка.КонтактныеЛица") Тогда 	
			Рез = ФункцииРасширения.ФИО_Склонение(АРГ.Наименование, , , ,АРГ.Пол , Падеж, ФИОКратко); 
		Иначе
			Рез = ФункцииРасширения.ФИО_Склонение(Строка(АРГ), , , , , Падеж, ФИОКратко); 
		КонецЕсли;
	Иначе //ТипАргумента = "Д"
		Рез = ФункцииРасширения.Должность_Склонение(Строка(АРГ), Падеж);
	КонецЕсли;	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

