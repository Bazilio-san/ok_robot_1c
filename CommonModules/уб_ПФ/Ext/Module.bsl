Процедура ПСПФ_КолонтитлыИНастройки(Контекст) Экспорт	
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСПФ_КолонтитлыИНастройки");	      
	ТабДокумент = Контекст.ТабличныйДокумент;
	Объект = Контекст.Объект;
	Если Контекст.АвтоУстанавливатьИмяПараметровПечати Тогда
		Контекст.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_" + Объект.Ссылка.Метаданные().Имя + "_" + Контекст.ИмяМакета;
	КонецЕсли;
	Если Контекст.ИмяПараметровПечати <> "" Тогда
		ТабДокумент.ИмяПараметровПечати = Контекст.ИмяПараметровПечати;
		//При установке имени параметров печати считываются настройки печати, ранее сохраненные под этим именем для данного пользователя.
		//Сохранение настроек происходит в момент вывода на печать
		//В настройках сохраняются параметры из диалога Файл - Параметры страницы.
		//А именно, свойства табличного/текстового документа:
		//	АвтоМасштаб
		//	ИмяПринтера 
		//	КоличествоЭкземпляров
		//	МасштабПечати
		//	ОриентацияСтраницы
		//	ПолеСверху
		//	ПолеСлева
		//	ПолеСправа
		//	ПолеСнизу
		//	РазмерКолонтитулаСверху
		//	РазмерКолонтитулаСнизу
		//	ЧерноБелаяПечать
		//	ЭкземпляровНаСтранице
	КонецЕсли;
	Если НЕ Контекст.ИспользоватьСохраненныеНастройкиПечати Тогда
		//Считаем, что установки, заданные для конкретной ПФ имеют более высокий приоритет
		//Надо отметить, что при очередной печати будут сохранены новые настройки
		ТабДокумент.КоличествоЭкземпляров	= Контекст.КоличествоЭкземпляров;
		ТабДокумент.ОриентацияСтраницы		= Контекст.ОриентацияСтраницы;
		ТабДокумент.АвтоМасштаб				= Контекст.АвтоМасштаб;
	КонецЕсли;
	ТабДокумент.ОтображатьЗаголовки		= Контекст.ОтображатьЗаголовки;
	ТабДокумент.ОтображатьСетку			= Контекст.ОтображатьСетку;
	ТабДокумент.РазборПоКопиям			= Контекст.РазборПоКопиям;
	ТабДокумент.ТолькоПросмотр			= Контекст.ТолькоПросмотр;
	ТабДокумент.РазмерКолонтитулаСверху = 6;
	ВКлн = ТабДокумент.ВерхнийКолонтитул;
	ВКлн.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ВКлн.НачальнаяСтраница = 1;
	Если Контекст.ПоказыватьЗаголовокДокументаВКолонтитле Тогда
		ВКлн.ТекстСлева = ДайЗаголовокДокументаПоставщику(Контекст); 
	КонецЕсли;
	ВКлн.ТекстСправа = " стр. [&НомерСтраницы] из [&СтраницВсего]";
	ВКлн.Шрифт = Новый Шрифт(,7);
	ВКлн.Выводить	= Контекст.ВыводитьВерхнийКолонтитл;
	ТабДокумент.РазмерКолонтитулаСнизу = 8;
	HКлн = ТабДокумент.НижнийКолонтитул;
	HКлн.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	HКлн.НачальнаяСтраница = 1;
	HКлн.Выводить	= Контекст.ВыводитьНижнийКолонтитл;
	HКлн.ТекстСправа = "ITC:УБ v." + Метаданные.Версия + "." + Формат(ТекущаяДата(),"ДФ=yyMMdd.HHmm");
	HКлн.Шрифт = Новый Шрифт(,7);
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры	

