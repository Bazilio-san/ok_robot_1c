	ПД_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, "<ПРЕДСТАВЛЕНИЕ ДОЛЖНОСТИ>",ПоУмолчанию));
	ПД = ВРег(Лев(ПД_,1));
	Если ПД <> "П" и ПД <> "К" Тогда
		ПД = ВРег(Лев(ПоУмолчанию,1)); //по умолчанию
		СОО = "В функцию '" + ИмяФункции + "' передан неверный " + НомерАргумента + "-й аргумент <ПРЕДСТАВЛЕНИЕ ДОЛЖНОСТИ>: """ + ПД_ + """.
		|		Должно быть: [Полно|П|Кратко|К]. (Использовано '" + ПоУмолчанию + "')";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);		
	Возврат (ПД <> "П"); //ДолжностьКратко
	
