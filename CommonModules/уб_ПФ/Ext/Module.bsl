Процедура ПСП_СтрокиТЧ_СБ(Контекст, ИмяОбласти = "Строка") Экспорт
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_СтрокиТЧ_СБ (Область: '" + ИмяОбласти + "')");	
	
	Область_Строка = ПолучитьОбласть(Контекст, ИмяОбласти);
