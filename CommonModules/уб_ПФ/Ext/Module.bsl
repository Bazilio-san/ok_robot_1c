			Возврат ФункцииРасширения.ФИО_Склонение(ФизЛицоКонтрагента, , , , , Падеж, ФИОКратко);
		КонецЕсли;
	КонецЕсли;	
	Прочерк = "";
	Для ч = 1 По КоличествоПодчеркиванийЕслиНеУказан Цикл
		Прочерк = Прочерк + "_";	  
	КонецЦикла;
	Возврат Прочерк;
	
