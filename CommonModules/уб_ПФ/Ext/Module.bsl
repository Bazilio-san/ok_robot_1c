	ТЗ.Колонки.Добавить("Организация",				Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТЗ.Колонки.Добавить("ОтветственноеЛицо",		Новый ОписаниеТипов("ПеречислениеСсылка.ОтветственныеЛицаОрганизаций"));
	ТЗ.Колонки.Добавить("ФизическоеЛицо", 			Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
