Функция НайтиЭлементСпискаПоПредставлению2(Список, Текст)
	
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Представление = "" Тогда
			ТекстПоиска = ЭлементСписка.Значение;
		Иначе
			ТекстПоиска = ЭлементСписка.Представление;
		КонецЕсли;
		Если Текст = ТекстПоиска Тогда
			Возврат ЭлементСписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция ПФ_ДатаПрописью(ДатаЗнач, СЗаглавнойБуквы = Ложь, Падеж = Неопределено) Экспорт 
	
	День_П 	= День(ДатаЗнач);
	Месяц_П = Месяц(ДатаЗнач);
	Год_П	= Год(ДатаЗнач);
	
	Если Падеж = Перечисления.Падежи.Родительный ИЛИ Падеж = 2 Тогда
		День_Зн = ДеньПрописью(День_П);
	Иначе
		Если Прав(День_П, 1) = 3 Тогда
			День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2);
			Если День_П = 13 Тогда 
				День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2) + "е";
			КонецЕсли;	
		ИначеЕсли День_П = 23 Тогда
			День_Зн = "двадцать третье"
		Иначе
			День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2) + "е";
		КонецЕсли
	КонецЕсли;
	
	Месяц_Зн = МесяцПрописью(Месяц_П);
	Год_Зн 	 = ГодПрописью(Год_П);
	
	ТекстДата = День_Зн + " " + Месяц_Зн + " " + Год_Зн;
	
	Если СЗаглавнойБуквы Тогда
		ТекстДата = ВРег(Лев(ТекстДата,1)) + Прав(ТекстДата,СтрДлина(ТекстДата) - 1);
	КонецЕсли;
	
	Возврат ТекстДата;
КонецФункции
