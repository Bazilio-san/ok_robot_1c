Функция ОбъединитьСтруктуры(МассивСтруктур, ИгнорироватьПовторяющиесяКлючи = Ложь)

	Перем Результат;
	
	Результат = Новый Структура;
	Для Каждого Структура Из МассивСтруктур Цикл
		Для Каждого КлючИЗначение Из Структура Цикл
			Если Результат.Свойство(КлючИЗначение.Ключ) Тогда
				Если Не ИгнорироватьПовторяющиесяКлючи Тогда
					Возврат Неопределено;
				КонецЕсли;
			Иначе
				Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции // ОбъединитьСтруктуры()

