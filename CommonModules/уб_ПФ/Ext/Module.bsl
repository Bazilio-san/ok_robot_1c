Функция СформироватьСообщениеОшибка(Контекст, СообщениеОшибки, ЧастныйКод);
	
	Результат = Символы.ПС +
	            "Код печатной формы: " + Контекст.СтруктураОбъектаПФ.Код + Символы.ПС + 
	            "Наименование печатной формы: '" + Контекст.СтруктураОбъектаПФ.Наименование + "'" + Символы.ПС + 
	            "Ошибка выполнения (Кода программы)" + Символы.ПС + уб_temp.ОшибкаПоИсходномуКоду(ЧастныйКод, СообщениеОшибки);
	            
	Возврат Результат;

