//возвращает строкое представление переданных параметров в зависимости от формы оплаты
Функция КомуПеречислитьПоОтчету(Контекст, мАрг)

	ИмяФункции = "КомуПеречислитьПоОтчету";
	//1 параметр - представление оргагента, 2ой - поставщика
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	Если СистемаНаправлениеПлатежа Тогда
		Если Контекст.Контейнер_СтрокаТЧ.НаправлениеПлатежа = Перечисления.уб_НаправленияПлатежа.Поставщику Тогда
			Индекс = 2;
			ЗначениеПоУмолчанию = "Поставщику";
		Иначе
			Индекс = 1;
			ЗначениеПоУмолчанию = "Агенту";
		КонецЕсли;
	Иначе
		Если Контекст.Контейнер_СтрокаТЧ.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику Тогда
			Индекс = 2;
			ЗначениеПоУмолчанию = "Поставщику";
		Иначе
			Индекс = 1;
			ЗначениеПоУмолчанию = "Агенту";
		КонецЕсли;
	КонецЕсли;
	Рез = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, Индекс, "КОМУ"));
	Если ПустаяСтрока(Рез) Тогда
		Рез = ЗначениеПоУмолчанию
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;

КонецФункции // КомуПеречислитьПоОтчету()

Функция ИтогиСРазрядностью2(Контекст, мАрг)

	ИмяФункции = "ИтогиСРазрядностью2";
	Рез = 0;
	// 1 аргумент - наименование итога	
	Имя = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ИМЯ>")));
	
	// 2 аргумент - разрядность. По умолчанию 2
	Разрядность = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<РАЗРЯДНОСТЬ>")));
	Если Разрядность = "" Тогда
		Разрядность = "2"
	КонецЕсли;
	
	// 3 аргумент - для точной настройки показателей
	Слагаемое = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<СЛАГАЕМОЕ>")));
	Попытка
		Слагаемое = Число(Слагаемое)
	Исключение
		Слагаемое = 0
	КонецПопытки;
	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 1) Или Имя = "" Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	
	Для Каждого Строка Из Контекст.ТЧДокумента Цикл
		Если Имя <> "суммакперечислениюпоставщику2" Тогда
			Показатель = Формат(Строка[Имя], "ЧН=; ЧДЦ = " + Разрядность);
		Иначе
			//TOD любой расчет, если придется еще чтолибо добавлять помимо суммы к перечислению поставщику
			//частные
			//пересчет суммы к перечислению поставщику
			Показатель = Формат(Строка.НачисленнаяСуммаВзноса, "ЧН=; ЧДЦ = " + Разрядность) - Формат(Строка.КВСуммаДляОтчета, "ЧН=; ЧДЦ = " + Разрядность)
		КонецЕсли;
		Рез = Рез + Показатель;
	КонецЦикла;
	
~НаВыход:
	Возврат Рез + Слагаемое;

КонецФункции // ИтогиСРазрядностью2()

Функция БанковскиеРеквизиты(Контекст, мАрг)
	
	ИмяФункции 	= "БАНК";
	Организация = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ОРГАНИЗАЦИЯ>")));
	Реквизит 	= НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<РЕКВИЗИТ>")));
	Рез = "";
	Если Реквизит = "номерсчета" Тогда
		ПутьКРеквизиту = Контекст[Организация].ОсновнойБанковскийСчет
	Иначе
		ПутьКРеквизиту = Контекст[Организация].ОсновнойБанковскийСчет.Банк
	КонецЕсли;	
	Рез = ПутьКРеквизиту[Реквизит];
	Возврат Рез;
	
КонецФункции

//%%%%%%%%%%%%%%  Вспомогательные функции %%%%%%%%%%%%%%%%%%%%%%
Функция ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, ИмяАргумента, ЗначениеПоУмолчанию = "", Обязательный = Ложь)
	
	Рез = ЗначениеПоУмолчанию;
	Если мАрг.Количество() >= НомерАргумента Тогда	
		АргументИлиМассивФункции = мАрг[НомерАргумента - 1];		
		ТипЗ = ТипЗнч(АргументИлиМассивФункции);		
		Если ТипЗ = Тип("Строка") Тогда
			Если ЗначениеЗаполнено(АргументИлиМассивФункции) Тогда
				Рез = АргументИлиМассивФункции;
			Иначе
				Если Обязательный Тогда
					СОО = "В функцию '" + ИмяФункции + "' передан пустой обязательный аргумент № " + НомерАргумента + " " + ИмяАргумента + ".";
					отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
					Рез = АргументИлиМассивФункции;
				КонецЕсли; //Иначе - по умолчанию
			КонецЕсли;
		ИначеЕсли ТипЗ = Тип("Массив") Тогда
			СОО = "В функции '" + ИмяФункции + "' аргумент № " + НомерАргумента + " " + ИмяАргумента + " не может быть функцией.";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
		Иначе
			Сообщить("В функции '" + ИмяФункции + "' аргумент № " + НомерАргумента + " " + ИмяАргумента 
			+ " неподходящего типа: '" + ТипЗ + "'!",СтатусСообщения.Важное);
			отладка_ПФ(Контекст, "", "", СтатусСообщения.Внимание, 0+1);
		КонецЕсли;
	Иначе
		Если Обязательный Тогда
			СОО = "В функцию '" + ИмяФункции + "' не передан обязательный аргумент № " + НомерАргумента + " " + ИмяАргумента + ".";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		КонецЕсли;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ДостаточноАргументов(Контекст, ИмяФункции, мАрг, минКолАрг, максКолАрг)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДостаточноАргументов");	
	Рез = Истина;
	Если мАрг.Количество() = 0 Тогда
		СОО = "В функцию '" + ИмяФункции + "' не передано ни одного аргумента.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Рез = Ложь;	
	ИначеЕсли мАрг.Количество() < минКолАрг Тогда
		СОО = "В функцию '" + ИмяФункции + "' передано недостаточно аргументов (" + мАрг.Количество() + "). Должно быть " 
		+ ?(минКолАрг = максКолАрг, минКолАрг, "от " + минКолАрг + " до " + максКолАрг) + ".";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Рез = Ложь;	
	ИначеЕсли мАрг.Количество() > максКолАрг Тогда	
		СОО = "В функцию '" + ИмяФункции + "' передано больше аргументов (" + мАрг.Количество() + "), чем требуется (" + максКолАрг + ").";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Информация, 0+1);
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции
	
Функция ДайАргумент_ФорматнаяСтрокаДаты(Контекст, мАрг, ИмяФункции, НомерАргумента, ФорматПоУмолчанию = Неопределено)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_ФорматнаяСтрокаДаты");		
	ФрматнаяСтрока = ?(ФорматПоУмолчанию = Неопределено, Контекст.ДФ_Полный, ФорматПоУмолчанию); //по умолчанию
	Если мАрг.Количество() >= НомерАргумента Тогда
		ФС_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, "<ФОРМАТНАЯ СТРОКА ДАТЫ>"));
		ФСН = НРег(ФС_);
		Если ФСН = "кратко" Тогда
			ФрматнаяСтрока = Контекст.ДФ_Кратко;	
		ИначеЕсли ФСН = "полно" ИЛИ ФСН = "полный" Тогда
			ФрматнаяСтрока = Контекст.ДФ_Полный;	
		ИначеЕсли ФСН = "полныйгод" Тогда
			ФрматнаяСтрока = Контекст.ДФ_Полный_год;	
		ИначеЕсли ФСН = "полныймесяцгод" Тогда
			ФрматнаяСтрока = Контекст.ДФ_Полный_месяц_год;
		ИначеЕсли ФСН = "" Тогда 	
			//используем по умолчанию	
		Иначе 	
			Если Найти(ФС_,"""") > 0 Тогда
				RegExp = Новый COMОбъект("VBScript.RegExp");
				RegExp.MultiLine = Ложь;
				RegExp.Global = Истина;
				RegExp.IgnoreCase = Истина;
				//Заменяем кавычки вокруг даты на парные кавычки
				RegExp.Pattern = """([dд]+)""";
				ФС_ = RegExp.Replace(ФС_,"«$1»");
				//Заменяем оставшиеся двойные кавычки на похожие
				RegExp.Pattern = """";
				ФС_ = RegExp.Replace(ФС_,Символ(8243)); //Внимание! Между крайними двойными кавычками не двойная кавычка, а похожий символ (2033 в WORD)
				RegExp = Null;
			КонецЕсли;
			ФрматнаяСтрока = "ДФ=""" + ФС_ + """";
		КонецЕсли;
	КонецЕсли;	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат ФрматнаяСтрока;
	
КонецФункции

Функция ДайАргумент_ПредставлениеФизлица(Контекст, мАрг, ИмяФункции, НомерАргумента, ПоУмолчанию = "К")
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_ПредставлениеФизлица");		
	ТНФ_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, "<ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>",ПоУмолчанию));
	ТНФ = ВРег(Лев(ТНФ_,1));
	Если ТНФ <> "П" и ТНФ <> "К" Тогда
		ТНФ = ВРег(Лев(ПоУмолчанию,1)); //по умолчанию
		СОО = "В функцию '" + ИмяФункции + "' передан неверный " + НомерАргумента + "-й аргумент <ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>: """ + ТНФ_ + """.
		|		Должно быть: [Полно|П|Кратко|К]. (Использовано '" + ПоУмолчанию + "')";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат (ТНФ <> "П"); //ФИОКратко
	
КонецФункции

Функция ДайАргумент_ПредставлениеЮрлица(Контекст, мАрг, ИмяФункции, НомерАргумента, ПоУмолчанию = "К")
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_ПредставлениеЮрлица");		
	ТНЮ_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, "<ПРЕДСТАВЛЕНИЕ ЮРЛИЦА>",ПоУмолчанию));
	ТНЮ = Найти("СКП",ВРег(Лев(ТНЮ_,1)))-1;
	Если ТНЮ < 0 Тогда
		ТНЮ = Найти("СКП",ВРег(Лев(ПоУмолчанию,1)))-1;
		СОО = "В функцию '" + ИмяФункции + "' передан неверный " + НомерАргумента + "-й аргумент <ПРЕДСТАВЛЕНИЕ ЮРЛИЦА>: """ + ТНЮ_ + """.
		|		Должно быть: [Полно|П|Кратко|К|Справочник|С]. (Использовано '" + ПоУмолчанию + "')";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат ТНЮ;
	
КонецФункции

Функция ДайАргумент_ПредставлениеДолжности(Контекст, мАрг, ИмяФункции, НомерАргумента, ПоУмолчанию = "П")
	
