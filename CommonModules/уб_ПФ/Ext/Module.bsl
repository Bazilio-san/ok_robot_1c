Функция ДайПериодПрописью(Количество, ЕдиницаИзмеренияСрокаДействия, ВозвращатьЦифру = Истина) Экспорт
	
	Если ЕдиницаИзмеренияСрокаДействия = Перечисления.уб_ЕдиницыИзмеренияСрокаДействия.День Тогда
		СрокПрописью = СокрЛП(Прав(ЧислоПрописью(Количество,"Л=ru_RU;НП=Истина;НД=Ложь;ДП=Ложь","день, дня, дней, м, , , , , 0"),4));
	ИначеЕсли	ЕдиницаИзмеренияСрокаДействия = Перечисления.уб_ЕдиницыИзмеренияСрокаДействия.Неделя Тогда
		СрокПрописью = СокрЛП(Прав(ЧислоПрописью(Количество,"Л=ru_RU;НП=Истина;НД=Ложь;ДП=Ложь","неделю, недели, недель, ж, , , , , 0"),6));
	ИначеЕсли	ЕдиницаИзмеренияСрокаДействия = Перечисления.уб_ЕдиницыИзмеренияСрокаДействия.Месяц Тогда
		Если Количество%10=1 и Количество<>11 тогда Отрезать = 5;Иначе Отрезать = 7;КонецЕсли;
		СрокПрописью = СокрЛП(Прав(ЧислоПрописью(Количество,"Л=ru_RU;НП=Истина;НД=Ложь;ДП=Ложь","месяц, месяца, месяцев, м, , , , , 0"),Отрезать));
	ИначеЕсли	ЕдиницаИзмеренияСрокаДействия = Перечисления.уб_ЕдиницыИзмеренияСрокаДействия.Год Тогда
		СрокПрописью = СокрЛП(Прав(ЧислоПрописью(Количество,"Л=ru_RU;НП=Истина;НД=Ложь;ДП=Ложь","год, года, лет, м, , , , , 0"),4));
	КонецЕсли;	
	Если ВозвращатьЦифру Тогда
		Возврат(строка(Количество) + " " + СрокПрописью);
	Иначе
		Возврат(СрокПрописью);
	КонецЕсли;
	
КонецФункции

Функция ДайЗаголовокДокументаПоставщику(Контекст) Экспорт	
	
	Объект = Контекст.Объект;	
	сНомер	= Дай_ТиповойНомер(Объект);
	сДата	= Формат(Объект.Дата,"ДФ=""dd.MM.yyyy 'г.'""");
	Тзд = ТипЗнч(Объект.Ссылка);	
	Если Тзд = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда 
		Заголовок = "Отчет для '" + Объект.Поставщик.НаименованиеКраткое + "' №" + сНомер + " от " + сДата + " от " 
		+ Объект.ОрганизацияАгент.НаименованиеДляДоговоровИПлатежныхДокументов + ".";
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_ПередачаБСОПоставщику") Тогда 
		Заголовок = "АКТ п-п №" + сНомер + " от " + сДата + ". Передает: " 
		+ Объект.ОрганизацияАгент.НаименованиеДляДоговоровИПлатежныхДокументов 
		+ ", принимает: " + Объект.Поставщик.НаименованиеКраткое;
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_СписаниеБСО") Тогда 
		Заголовок = "Списание БСО №" + сНомер + " от " + сДата + ".";
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_СписаниеБСО") Тогда 
		Заголовок = "Списание БСО №" + сНомер + " от " + сДата + ".";
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_Доверенности") Тогда 
		Заголовок = "Доверенность №" + сНомер + " от " + сДата + ".";
	Иначе
		Заголовок = Строка(Объект);
	КонецЕсли;	
	Возврат Заголовок;
	
КонецФункции	

