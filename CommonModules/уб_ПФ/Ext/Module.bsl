Функция ДайДолжностьОтветственногоЛица(ОрганизацияАгент, ОтветственноеЛицо, НаДату = Неопределено, Предупреждать = Истина) Экспорт 
	
	СтруктураОтветственноеЛицо = ДайОтветственноеЛицоОрганизации(ОтветственноеЛицо, ОрганизацияАгент, НаДату, Предупреждать);	
	Если СтруктураОтветственноеЛицо <> Неопределено Тогда
		Возврат ОбъектДолжностьОтветственногоЛица(СтруктураОтветственноеЛицо, Предупреждать = Истина)
	КонецЕсли;	
	
КонецФункции

//Общ  //Падеж
Функция ДайНаименованиеДолжностиОтветственногоЛица(ОрганизацияАгент, ОтветственноеЛицо, НаДату = Неопределено, Падеж = 1, Предупреждать = Истина) Экспорт 
	
	Должность = ДайДолжностьОтветственногоЛица(ОрганизацияАгент, ОтветственноеЛицо, НаДату, Предупреждать);
	НаименованиеДолжности = ?(Должность = Неопределено, "", Должность.Наименование);	
	Возврат ФункцииРасширения.Должность_Склонение(НаименованиеДолжности, Падеж);
	
КонецФункции

//Частное для Руководителя
Функция ДайРуководителя(ОрганизацияАгент, Знач НаДату = Неопределено, Предупреждать = Истина) Экспорт 
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДата();	
	КонецЕсли;
	ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;	
	Руководитель = ДайОтветственноеЛицоОрганизации(ОтветственноеЛицо, ОрганизацияАгент, НаДату, Предупреждать);
	Если Руководитель <> Неопределено Тогда
		Возврат Руководитель;
	КонецЕсли;	
	Если ОрганизацияАгент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Возврат Неопределено; 
	Иначе
		НС = СтруктураОтветственногоЛица();
		НС.Организация = ОрганизацияАгент;
		НС.ОтветственноеЛицо = ОтветственноеЛицо;
		НС.ФизическоеЛицо = ОрганизацияАгент.ИндивидуальныйПредприниматель;
		Если ОрганизацияАгент.ЭтоИндивидуальныйПредприниматель Тогда
			НС.Должность.Наименование = "Индивидуальный Предприниматель";
			НС.Должность.НаименованиеКратко = "Индивидуальный Предприниматель";
			НС.ОснованиеДействия = "Устав";
		Иначе
			НС.ОснованиеДействия = "";
		КонецЕсли;
		Возврат НС;
	КонецЕсли;
	
КонецФункции

//Частное для Руководителя
Функция ДайНаименованиеДолжностиРуководителя(ОрганизацияАгент, НаДату = Неопределено, Падеж = 1, Предупреждать = Истина) Экспорт 
	
	Руководитель = ДайРуководителя(ОрганизацияАгент, НаДату, Предупреждать);
	Если Руководитель = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ФункцииРасширения.Должность_Склонение(Руководитель.Должность.Наименование, Падеж);
	
КонецФункции

Функция ДайОтветственноеЛицоДляФизлица(Физлицо, Предупреждать = Ложь) Экспорт 
	
	НС = СтруктураОтветственногоЛица();
	НС.Организация 			= Физлицо;
	НС.ОтветственноеЛицо 	= Физлицо;
	НС.ФизическоеЛицо 		= Физлицо;
	НС.Должность 			= "";
	НС.ОснованиеДействия 	= "";
	НС.ПаспортныеДанные 	= ДайПаспортныеДанныеФизлица(Физлицо, Предупреждать);	
	НС.АдресПрописки 		= АдресПоПропискеФизлица(Физлицо, Предупреждать);	
	Возврат НС;
	
КонецФункции
		
//Частное для Руководителя
Функция ДайФИОРуководителя(ОрганизацияАгент, НаДату = Неопределено, ФИОКратко = Истина, Падеж = Неопределено, Предупреждать = Истина) Экспорт 
	
	Руководитель = ДайРуководителя(ОрганизацияАгент, НаДату, Предупреждать);	
	Если Руководитель = Неопределено Тогда
		Возврат "";	
	КонецЕсли;
	Возврат уб_Кэшируемые.ФИОФизлицаСтрокой(Руководитель.ФизическоеЛицо, НаДату, ФИОКратко, Падеж);
	
КонецФункции

//Общ
Функция ДайПолФизлица(ФизЛицо, Предупреждать = Истина) Экспорт 
	
	Если ЗначениеНеЗаполнено(ФизЛицо) Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	ФизЛицоПол = ФизЛицо.Пол;
	ТипФизЛица = ТипЗнч(ФизЛицо);
	Если ФизЛицоПол = Перечисления.ПолФизическихЛиц.ПустаяСсылка() ИЛИ ФизЛицоПол = Неопределено Тогда
		Фрм = ФизЛицо.ПолучитьФорму();
		#Если Клиент Тогда
		Если Предупреждать И НЕ Фрм.Открыта() Тогда
			Если ТипФизЛица = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				Заг = "Необходимо указать пол контактного лица!";
				СОО = "Для контактного лица '" + Строка(ФизЛицо) + "' не указан пол.
				|
				|Зайдите в справочник контактных лиц и внесите необходимые данные.
				|
				|Открыть форму контактного лица?";
			Иначе
				Заг = "Необходимо указать пол физлица!";
				СОО = "Для физического лица '" + Строка(ФизЛицо) + "' не указан пол.
				|
				|Зайдите в справочник физлиц и внесите необходимые данные.
				|
				|Открыть форму физлица?";
			КонецЕсли;
			
			Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Фрм.Открыть();
				Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.Пол;
			КонецЕсли;
		КонецЕсли;
		#КонецЕсли
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФизЛицоПол;
	
КонецФункции

//Общ
Функция ДайПаспортныеДанныеФизлица(ФизЛицо, Предупреждать = Истина) Экспорт 
	
	Если ЗначениеНеЗаполнено(ФизЛицо) Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	ДанныеФизЛица = РегистрыСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, Новый Структура("ФизЛицо", ФизЛицо));	
	#Если Клиент Тогда
	Если Предупреждать = Истина и ДанныеФизЛица.Количество() = 0 Тогда
		Фрм = ФизЛицо.ПолучитьФорму();
		Если НЕ Фрм.Открыта() Тогда
			Заг = "Необходимо указать все данные физ. лица!";
			СОО = "Не найдены паспортные данные физ. лица: '" + Строка(ФизЛицо)  + "' не заданы:
				|
				|Зайдите в справочник физлиц и внесите необходимые данные.
				|
				|Открыть форму физлица?";
			Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Фрм.Открыть();
				Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.Удостоверение;
				ДанныеФизЛица = РегистрыСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, Новый Структура("ФизЛицо", ФизЛицо));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	Если ДанныеФизЛица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Возврат ДанныеФизЛица[0];
	
КонецФункции //

//Общ
Функция АдресПоПропискеФизлица(ФизЛицо, Предупреждать = Истина) Экспорт 
	
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	К.Объект,
	|	К.Тип,
	|	К.Вид,
	|	К.УИД,
	|	К.Представление,
	|	К.Поле1,
	|	К.Поле2,
	|	К.Поле3,
	|	К.Поле4,
	|	К.Поле5,
	|	К.Поле6,
	|	К.Поле7,
	|	К.Поле8,
	|	К.Поле9,
	|	К.Поле10,
	|	К.Комментарий,
	|	К.ЗначениеПоУмолчанию,
	|	К.ПользовательЛичногоКонтакта
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК К
	|ГДЕ
	|	К.Объект = &Объект
	|	И К.Вид = &Вид";	
	Запрос.УстановитьПараметр("Объект", ФизЛицо);
	Запрос.УстановитьПараметр("Вид", 	Справочники.ВидыКонтактнойИнформации.АдресФизЛицаПоПрописке);	
	Результат = Запрос.Выполнить();
	#Если Клиент Тогда
	Если Результат.Пустой() И Предупреждать Тогда
		Заг = "Необходимо указать Адрес по прописке физ. лица!";
		СОО = "Не найден Адрес по прописке физ. лица '" + Строка(ФизЛицо)  + "'
		|
		|Зайдите в справочник физлиц и внесите необходимые данные.
		|
		|Открыть форму физлица?";
		Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Форма = ФизЛицо.ПолучитьФорму();
			Форма.ЭлементыФормы.Панель1.ТекущаяСтраница = Форма.ЭлементыФормы.Панель1.Страницы.Дополнительно;
			Форма.ТекущийЭлемент 						= Форма.ЭлементыФормы.КонтактнаяИнформация;
			Форма.ТекущийЭлемент.ТекущаяКолонка 		= Форма.ТекущийЭлемент.Колонки.Представление;
			Форма.ТекущийЭлемент.ТекущаяСтрока 			= Форма.ТекущийЭлемент.Значение[3];
			Форма.ОткрытьМодально();
			Результат = Запрос.Выполнить();
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	Если Не Результат.Пустой() Тогда
		ТЗ = Результат.Выгрузить();
		Возврат ТЗ[0];
	КонецЕсли;
	
КонецФункции //

//Общ Получает пол и слово (в любом роде, но лучше в мужском). Ищет слово в словаре и, если находит, возвращает нужный род. 
Функция СклонениеСловаПоРоду(Пол, Слово) Экспорт
	
	//Словарь склонения слов по родам
	тзРод = Новый ТаблицаЗначений;
	тзРод.Колонки.Добавить("М");
	тзРод.Колонки.Добавить("Ж");
	тзРод.Колонки.Добавить("Д");
	НС = тзРод.Добавить(); НС.М = "зарегистрирован";	НС.Ж = "зарегистрирована"; 	НС.Д = "зарегистрирован(а)";
	НС = тзРод.Добавить(); НС.М = "передал"; 			НС.Ж = "передала"; 			НС.Д = "передал(а)";
	НС = тзРод.Добавить(); НС.М = "действующего"; 		НС.Ж = "действующей"; 		НС.Д = "действующего(ей)";
	НС = тзРод.Добавить(); НС.М = "действующий"; 		НС.Ж = "действующая"; 		НС.Д = "действующий(ая)";
	НС = тзРод.Добавить(); НС.М = "именуемый"; 			НС.Ж = "именуемая"; 		НС.Д = "именуемый(ая)";
	НС = тзРод.Добавить(); НС.М = "уважаемый"; 			НС.Ж = "уважаемая"; 		НС.Д = "уважаемый(ая)";
	НС = тзРод.Добавить(); НС.М = "сдал"; 				НС.Ж = "сдала"; 			НС.Д = "сдал(а)";
	НайденнаяСтрока = тзРод.Найти(Нрег(Слово));
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат Слово;
	КонецЕсли;
	Если Пол = Перечисления.ПолФизическихЛиц.Мужской Тогда
		Результат = НайденнаяСтрока.М;
	ИначеЕсли Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
		Результат = НайденнаяСтрока.Ж;
	Иначе
		Результат = НайденнаяСтрока.Д;
	КонецЕсли;
	Возврат ТакойЖеРегистр(Слово, Результат);
	
КонецФункции

//Функция устанавливает такой же регистр 2-го слова, как и у эталона
Функция ТакойЖеРегистр(Эталон, Слово)
	
	Если Лев(Эталон,2) = ВРег(Лев(Эталон,2)) Тогда
		//Верхний регистр
		Возврат ВРег(Слово);
	ИначеЕсли Лев(Эталон,1) = ВРег(Лев(Эталон,1)) Тогда
		//Первая Заглавная
		Возврат ОбщегоНазначения.ПерваяЗаглавная(Слово);
	Иначе
		//Нижний регистр
		Возврат НРег(Слово);
	КонецЕсли;
	
КонецФункции

Функция ДайСловоЗависимоеОтПолаФизлица(Физлицо, Слово, Предупреждать = Истина) Экспорт 
	
	ТипФизЛицо = ТипЗнч(Физлицо);
	Если ТипФизЛицо = Тип("Строка") И Не ПустаяСтрока(Физлицо) Тогда
		Попытка 
			Компонента = Новый COMОбъект("Padeg.Declension");
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось подключить компоненту склонения для ФИО",,Истина,,,,"Не удалось подключить компоненту Padeg: " + ОписаниеОшибки());
			Компонента = Null;
		КонецПопытки;
		Если Компонента <> NULL Тогда
			iРод = Компонента.GetSex(Физлицо);
			Если iРод = 1 Тогда
				Пол = Перечисления.ПолФизическихЛиц.Мужской;
			ИначеЕсли iРод = 0 Тогда
				Пол = Перечисления.ПолФизическихЛиц.Женский;
			КонецЕсли;
		Иначе
			Пол = Неопределено;
		КонецЕсли;
	ИначеЕсли ТипФизЛицо = Тип("СправочникСсылка.КонтактныеЛица") И ЗначениеЗаполнено(Физлицо) Тогда
		Пол = ДайПолФизлица(Физлицо, Предупреждать);
	ИначеЕсли ТипФизЛицо <> Тип("СправочникСсылка.ФизическиеЛица") ИЛИ ЗначениеНеЗаполнено(Физлицо) Тогда
		Пол = Неопределено;	
	Иначе
		Пол = ДайПолФизлица(Физлицо, Предупреждать);
	КонецЕсли;
	Возврат СклонениеСловаПоРоду(Пол, Слово);
	
КонецФункции

Функция ДайСловоЗависимоеОтПолаРуководителя(ОрганизацияАгент, НаДату = Неопределено, Слово, Предупреждать = Истина) Экспорт 
	
	Руководитель = ДайРуководителя(ОрганизацияАгент, НаДату, Предупреждать);	
	Возврат ДайСловоЗависимоеОтПолаФизлица(Руководитель.ФизическоеЛицо, Слово, Предупреждать);
	
КонецФункции

Функция ДайНаименованиеКонтрагента(КонтрагентСсылка, НаДату = Неопределено, ФИОКратко = Ложь, Контрагент_ТипИмени = 1, Падеж = 1, Предупреждать = Истина) Экспорт 
	
	Тзч = ТипЗнч(КонтрагентСсылка);
	Если Контрагент_ТипИмени = Неопределено Тогда
		Контрагент_ТипИмени = 1;
	КонецЕсли;
	Если ФИОКратко = Неопределено Тогда
		ФИОКратко = Ложь;
	КонецЕсли;
	Если Тзч = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Возврат уб_Кэшируемые.ФИОФизлицаСтрокой(КонтрагентСсылка, НаДату, ФИОКратко, Падеж);	
	ИначеЕсли Тзч = Тип("СправочникСсылка.Контрагенты") Тогда		
		Если КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Если Контрагент_ТипИмени = 1 Тогда
				КН = СокрЛП(КонтрагентСсылка.НаименованиеКраткое);
				КН = СокрЛП(КонтрагентСсылка.Наименование);
				КакоеНаименование = "краткое";
			ИначеЕсли Контрагент_ТипИмени = 2 Тогда
				КН = СокрЛП(КонтрагентСсылка.НаименованиеПолное);
				КакоеНаименование = "полное";
			Иначе
				КН = СокрЛП(КонтрагентСсылка.Наименование);
				КакоеНаименование = "";
			КонецЕсли;
			Если КН = "" Тогда
				Фрм = КонтрагентСсылка.ПолучитьФорму();
				#Если Клиент Тогда
				Если Предупреждать И НЕ Фрм.Открыта() Тогда
					Заг = "Необходимо указать " + КакоеНаименование + " наименование Контрагента!";
					СОО = "Для контрагента '" + КонтрагентСсылка.Наименование + "' не указано " + КакоеНаименование + " наименование
						|
						|Зайдите в справочник Контрагентов внесите необходимые данные.
						|
						|Открыть форму Контрагента?";
					Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
					Если Ответ = КодВозвратаДиалога.Да Тогда
						Фрм.Открыть();
						Если Контрагент_ТипИмени = 1 Тогда
							Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.НаименованиеКраткое;
						ИначеЕсли Контрагент_ТипИмени = 2 Тогда
							Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.НаименованиеПолное;
						Иначе
							Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.Наименование;
						КонецЕсли;						
						Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.НаименованиеКраткое;
					КонецЕсли;
				КонецЕсли;
				#КонецЕсли
			КонецЕсли;
			Возврат ФункцииРасширения.Должность_Склонение(КН, Падеж);
		Иначе
			ФизЛицо = КонтрагентСсылка.Физлицо;
			Если ЗначениеНеЗаполнено(Физлицо) Тогда
				Фрм = КонтрагентСсылка.ПолучитьФорму();
				#Если Клиент Тогда
				Если Предупреждать И НЕ Фрм.Открыта() Тогда
					Заг = "Необходимо связать Контрагента с физлицом!";
					СОО = "Контрагент '" + КонтрагентСсылка.Наименование + "' (тип ФизЛицо) не связан с физлицом" 
						+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС + "Зайдите в справочник Контрагентов внесите необходимые данные." 
						+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС + "Открыть форму Контрагента?";
					Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
					Если Ответ = КодВозвратаДиалога.Да Тогда
						Фрм.Открыть();
						Фрм.ТекущийЭлемент = Фрм.ЭлементыФормы.СвязанноеФизлицо;
					КонецЕсли;
				КонецЕсли;
				#КонецЕсли
			КонецЕсли;			
			Если Контрагент_ТипИмени = 1 Тогда
				Если КонтрагентСсылка.ЭтоИндивидуальныйПредприниматель Тогда
					Возврат "ИП """ + уб_Кэшируемые.ФИОФизлицаСтрокой(ФизЛицо, НаДату, Истина, Падеж) + """";
				Иначе
					Возврат уб_Кэшируемые.ФИОФизлицаСтрокой(ФизЛицо, НаДату, Истина, Падеж);	
				КонецЕсли;
			ИначеЕсли Контрагент_ТипИмени = 2 Тогда
				Если КонтрагентСсылка.ЭтоИндивидуальныйПредприниматель Тогда
					Рез = "Индивидуальный предприниматель """ + уб_Кэшируемые.ФИОФизлицаСтрокой(ФизЛицо, НаДату, Ложь, Падеж) + """";	
				Иначе
					Возврат уб_Кэшируемые.ФИОФизлицаСтрокой(ФизЛицо, НаДату, Ложь, Падеж);	
				КонецЕсли;
			Иначе
				Рез = КонтрагентСсылка.Наименование;
			КонецЕсли;
			Возврат ФункцииРасширения.Должность_Склонение(Рез, Падеж);		
		КонецЕсли;		
	ИначеЕсли Тзч = Тип("СправочникСсылка.Организации") Тогда
		Если КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо И НЕ КонтрагентСсылка.ЭтоИндивидуальныйПредприниматель Тогда
			Если Контрагент_ТипИмени = 1 Тогда
				Рез = уб_Кэшируемые.ФИОФизлицаСтрокой(КонтрагентСсылка.ИндивидуальныйПредприниматель, НаДату, Истина, Падеж);
			ИначеЕсли Контрагент_ТипИмени = 2 Тогда
				Рез = уб_Кэшируемые.ФИОФизлицаСтрокой(КонтрагентСсылка.ИндивидуальныйПредприниматель, НаДату, Ложь, Падеж);;
			Иначе
				Рез = КонтрагентСсылка.Наименование;
			КонецЕсли; 
		Иначе
			Если Контрагент_ТипИмени = 1 Тогда
				Рез = КонтрагентСсылка.НаименованиеДляДоговоровИПлатежныхДокументов;
			ИначеЕсли Контрагент_ТипИмени = 2 Тогда
				Рез = КонтрагентСсылка.НаименованиеПолное;
			Иначе
				Рез = КонтрагентСсылка.Наименование;
			КонецЕсли; 
		КонецЕсли;		
		Возврат ФункцииРасширения.Должность_Склонение(Рез, Падеж);
	КонецЕсли;	
	Возврат "";
	
КонецФункции

