//генерируем имя файла сохраняемой ПФ
Функция ИмяФайлаПФ(Контекст) Экспорт

	Если ТипЗнч(Контекст.Объект.Ссылка) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
		ИмяФайла = "Отчет";
	ИначеЕсли ТипЗнч(Контекст.Объект.Ссылка) = Тип("ДокументСсылка.уб_ПередачаБСОПоставщику") Тогда
		ИмяФайла = "Акт п-п";
	Иначе
		ИмяФайла = Контекст.Объект.Метаданные().Синоним; 
	КонецЕсли;
	ИмяФайла = ИмяФайла + " №" + Дай_ТиповойНомер(Контекст.Объект) + " " + Контекст.ИмяМакета;
	ИмяФайла = уб_temp.УбратьСимволы(ИмяФайла, "-");
	Возврат ИмяФайла;

КонецФункции // ИмяФайлаПФ()

