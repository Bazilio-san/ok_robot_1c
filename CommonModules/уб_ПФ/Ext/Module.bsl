	//СтрокиПараметров = Контекст.ОбъектПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
	СтрокиПараметров = Контекст.СтруктураОбъектаПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
	RegExp = Новый COMОбъект("VBScript.RegExp");
	Для каждого СтрокаПараметра Из СтрокиПараметров Цикл
		Контекст.Отладка.ТекущаяСтрокаПараметра = СтрокаПараметра;
		Контекст.ОперативныйКонтейнер = Контекст.Контейнер; //Восстанавливаем значение оперативного контейнера (может измениться модификатором при заполнении параметра)
		
		ИмяПараметра = СтрокаПараметра.Параметр;
		
		Если ИмяПараметра = "" Тогда
			
		//ИначеЕсли ИмяПараметра = "<особое имя параметра>" Тогда
		//	Прмт[ИмяПараметра] = <особый код заполнения параметра>;
		
		Иначе
			ОПТЧ(Контекст, Прмт, RegExp);
		КонецЕсли;
	КонецЦикла;
	RegExp = Null;
	
	//===========================================================
	
	Контекст.ТабличныйДокумент.Вывести(Область_Строка);
	
	отладка_Лог_КонецПроцедуры(Контекст);	
КонецПроцедуры
                   
Процедура ПеремещениеБСО_Акт(Контекст) Экспорт

	Агент 		= Контекст.Контейнер_Документ.Агент;
	АгентКуда 	= Контекст.Контейнер_Документ.АгентКуда;
	Автор		= Контекст.Объект.Автор;
	
	Если ТипЗнч(Агент)=Тип("СправочникСсылка.Контрагенты") Тогда
		ФИОАгента = СокрЛП(Агент.ОсновноеКонтактноеЛицо.Наименование);	
	ИначеЕсли ТипЗнч(Агент)=Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ФИОАгента = СокрЛП(Агент.Наименование);	
	КонецЕсли;
	
	Если ТипЗнч(АгентКуда)=Тип("СправочникСсылка.Контрагенты") Тогда
		ФИОАгентаКуда = СокрЛП(АгентКуда.ОсновноеКонтактноеЛицо.Наименование);	
	ИначеЕсли ТипЗнч(АгентКуда)=Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ФИОАгентаКуда = СокрЛП(АгентКуда.Наименование);	
	КонецЕсли;
	
	Если Не ЗначениеНеЗаполнено(Агент) Тогда
		Передающий		= " агента "+Агент;
		//TODO - глобальные переменные во внешнем соединении. Исправить на инициализированные параметры сеанса.
		#Если Клиент И Сервер Тогда
		Принимающий		= ОсновнаяОрганизация;
		#КонецЕсли
		ФИОПринимающего	= Автор;
		НаименованиеАгента = Агент.Наименование;
		ФИОПередающего	= ФИОАгента;
		Если ТипЗнч(Агент)=Тип("СправочникСсылка.Контрагенты") Тогда
			Если Агент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				НаименованиеАгента=НаименованиеАгента+" в лице "+ФИОАгента;
				ФИОПередающего	= ФИОАгента;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Не ЗначениеНеЗаполнено(АгентКуда) Тогда
		//TODO - глобальные переменные во внешнем соединении. Исправить на инициализированные параметры сеанса.
		#Если Клиент И Сервер Тогда
		Передающий			= ОсновнаяОрганизация;
		#КонецЕсли
		Принимающий			= " агента " + АгентКуда;
		ФИОПередающего		= Автор;
		НаименованиеАгента 	= АгентКуда.Наименование;
		ФИОПринимающего		= ФИОАгентаКуда;
		Если ТипЗнч(АгентКуда)=Тип("СправочникСсылка.Контрагенты") Тогда
			Если АгентКуда.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				НаименованиеАгента=НаименованиеАгента+" в лице "+ФИОАгентаКуда;
				ФИОПринимающего	= ФИОАгентаКуда;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПеремещениеБСО = Новый Структура;
	ПеремещениеБСО.Вставить("ФИОАгента",			ФИОАгента);
	ПеремещениеБСО.Вставить("ФИОАгентаКуда",		ФИОАгентаКуда);
	ПеремещениеБСО.Вставить("Передающий",			Передающий);
	ПеремещениеБСО.Вставить("Принимающий",			Принимающий);
	ПеремещениеБСО.Вставить("ФИОПередающего",		ФИОПередающего);
	ПеремещениеБСО.Вставить("ФИОПринимающего",		ФИОПринимающего);
	ПеремещениеБСО.Вставить("НаименованиеАгента",   НаименованиеАгента);
	
	Контекст.Вставить("ПеремещениеБСО", ПеремещениеБСО);	
	Контекст.ТЧДокумента.Сортировать("НомерСтроки");

КонецПроцедуры

Процедура ПеремещениеБСО_АктКСостоянием(Контекст) Экспорт

	Агент 		= Контекст.Контейнер_Документ.Агент;
	АгентКуда 	= Контекст.Контейнер_Документ.АгентКуда;
	Дата		= Контекст.Контейнер_Документ.Дата;
	
	//Устанавливаем количество экземпляров для печати
	
	НаправлениеПередачиБСО 	= "";
	ПодразделениеОт 		= уб_СС.ПолучитьПодразделениеАгента(Агент, Дата, Истина);
	ПодразделениеКуда 		= уб_СС.ПолучитьПодразделениеАгента(АгентКуда, Дата, Истина);
	
	Если ПодразделениеОт = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
		И ПодразделениеКуда <> ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
	  Тогда
		Если НЕ ЗначениеНеЗаполнено(АгентКуда) И ТипЗнч(АгентКуда.Ссылка) <> Тип("СправочникСсылка.Контрагенты") Тогда
			КоличествоЭкземпляров = 3;
		Иначе
			КоличествоЭкземпляров = 1;
		КонецЕсли;
		НаправлениеПередачиБСО = Символы.ВК + Символы.ПС + "(выдача отделом БСО " + ПодразделениеОт.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов + ")"; 
	ИначеЕсли ПодразделениеОт <> ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
		И ПодразделениеКуда = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
	  Тогда
		НаправлениеПередачиБСО = Символы.ВК + Символы.ПС + "(прием отделом БСО " + ПодразделениеКуда.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов + ")"; 
        КоличествоЭкземпляров = 1;
	ИначеЕсли ПодразделениеОт = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
		И ПодразделениеКуда = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
	  Тогда
		НаправлениеПередачиБСО = "(перемещение внутри отдела БСО " + ПодразделениеОт.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов + ")"; 
		КоличествоЭкземпляров = 1;
	ИначеЕсли ПодразделениеОт <> ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО
		И ПодразделениеКуда <> ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО 
	  Тогда
		НаправлениеПередачиБСО = "(перемещение между сотрудниками " + ПодразделениеОт.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов + ")"; 
		КоличествоЭкземпляров = 1;		
	КонецЕсли;
	
	// Создаем нужные данные по перемещению в контексте
	
	ПеремещениеБСО = Новый Структура;
	
	ПеремещениеБСО.Вставить("КоличествоЭкземпляров", КоличествоЭкземпляров);
	ПеремещениеБСО.Вставить("Экземпляр", 0);
	ПеремещениеБСО.Вставить("ПередающийДляШапки");
	ПеремещениеБСО.Вставить("ПринимающийДляШапки");
	ПеремещениеБСО.Вставить("Перемещение");
	ПеремещениеБСО.Вставить("ПеремещениеКуда");
	ПеремещениеБСО.Вставить("НаправлениеПередачиБСО", НаправлениеПередачиБСО);
	ПеремещениеБСО.Вставить("ПередающийДляПодписи");
	ПеремещениеБСО.Вставить("ФИОПередающего");
	ПеремещениеБСО.Вставить("ПринимающийДляПодписи");
	ПеремещениеБСО.Вставить("ФИОПринимающего");
	ПеремещениеБСО.Вставить("Выдавший");

	Контекст.Вставить("ПеремещениеБСО", ПеремещениеБСО);

КонецПроцедуры

Процедура ПСП_ПеремещениеБСО(Контекст, ИмяОбластиШапка = "ШапкаТаб", ИмяОбластиСтрока = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_ТЧ_ПеремещениеБСО (Область шапки: '" + ИмяОбластиШапка + "', Область строки: '" + ИмяОбластиСтрока + "')");	
	 
	ТабДок = Контекст.ТабличныйДокумент;
	Макет = Контекст.Макет;
	
	КПБСО 					= Контекст.ПеремещениеБСО;
	Агент 					= Контекст.Контейнер_Документ.Агент;
	АгентКуда 				= Контекст.Контейнер_Документ.АгентКуда;
	Дата 					= Контекст.Контейнер_Документ.Дата;
	Экз 					= КПБСО.Экземпляр;
	Выдал 					= Контекст.Контейнер_Документ.Выдал;
	ПередающийФИО 			= "";
	ПередающийДляШапки 		= "";
	ПередающийДляПодписи 	= "";
	ПринимающийФИО 			= "";
	ПринимающийДляШапки 	= "";
	ПринимающийДляПодписи 	= "";
	
	Контекст.Объект.ПолучитьПодписиДляСтороны(Агент, 		Дата, ПередающийФИО, 	ПередающийДляШапки, 	ПередающийДляПодписи);	
	Контекст.Объект.ПолучитьПодписиДляСтороны(АгентКуда, 	Дата, ПринимающийФИО, 	ПринимающийДляШапки, 	ПринимающийДляПодписи);	

  	Если Найти(ИмяОбластиШапка, "ШапкаТаблицы") = 1 Тогда
		КПБСО.Экземпляр = КПБСО.Экземпляр + 1;
	КонецЕсли;
	
	КПБСО.НаправлениеПередачиБСО 	= "(передача выездному специалисту)";
	КПБСО.ПередающийДляШапки 		= ?(Экз = 0, ПередающийДляШапки,	ПринимающийДляШапки);
	КПБСО.ПринимающийДляШапки 		= ?(Экз = 0, ПринимающийДляШапки,	"Выездной специалист");
	КПБСО.ПередающийДляПодписи 		= ?(Экз = 0, ПередающийДляПодписи, 	ПринимающийДляПодписи);
	КПБСО.ФИОПередающего 			= ?(Экз = 0, ПередающийФИО, 		ПринимающийФИО);
	КПБСО.ПринимающийДляПодписи 	= ?(Экз = 0, ПринимающийДляПодписи, "Выездной специалист");
	КПБСО.ФИОПринимающего 			= ?(Экз = 0, ПринимающийФИО, 		"____________________");

	ТЗ_ТЧДокумента = Контекст.ТЧДокумента;
	
	ПСП(Контекст, ИмяОбластиШапка, Контекст.Предупреждать);

	//Указываем, какую строку повторять на каждой странице при печати
	ОблШапкаТаб = ТабДок.Области.Найти(ИмяОбластиШапка);
	Если ОблШапкаТаб <> Неопределено Тогда
		Если Контекст.ПовторятьШапкуТаблицыПриПечати Тогда
			ВерхняяГраница = ОблШапкаТаб.Верх;
			НижняяГраница = ОблШапкаТаб.Низ;
			Если Контекст.КоличествоСтрокПовторенияШапкиТЧ < 1 Тогда
				ОбластьПовторения = ОблШапкаТаб;
			Иначе
				ВыводитьВверхДо = Макс(ВерхняяГраница, НижняяГраница - Контекст.КоличествоСтрокПовторенияШапкиТЧ + 1);
				ОбластьПовторения = ТабДок.Область("R"+ВыводитьВверхДо+":R" + НижняяГраница);
			КонецЕсли;
			ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовторения;
		КонецЕсли;
		Если Контекст.ФиксацияСверху Тогда
			ТабДок.ФиксацияСверху = ОблШапкаТаб.Низ;	
		КонецЕсли;
	КонецЕсли;	
	Если Найти(ИмяОбластиШапка, "ШапкаТаблицы") = 1 Тогда		
		Итоги = ПолучитьСтруктуруИтогов_Общее(Контекст);
		Если ТЗ_ТЧДокумента.Колонки.Найти("Документ") <> Неопределено Тогда
			ТЗ_ТЧДокумента.Сортировать("Документ");
		КонецЕсли;
		Для Каждого СтрокаТЧ Из ТЗ_ТЧДокумента Цикл			
			Если Контекст.Отладка.Групповая И Контекст.Контейнер_Итоги.НомерТекущейСтроки >= Контекст.Отладка.МаксКоличествоСтрокТЧ Тогда
				Прервать;	
			КонецЕсли;
			//чкн
			ОбластьГруппаДокументов = Макет.Области.Найти("ГруппаДокументов");
			Если ОбластьГруппаДокументов = Неопределено Тогда
				бОбрабатыватьГруппуДокументов = Ложь
			Иначе
				ОбластьМакета_ГруппаДокументов = Макет.ПолучитьОбласть("ГруппаДокументов");
				бОбрабатыватьГруппуДокументов = Истина;
			КонецЕсли;
			Если бОбрабатыватьГруппуДокументов И Контекст.МассивОбъектов.Количество() > 1 Тогда
				Если Итоги.ТекущийДокумент <> СтрокаТЧ.Документ Тогда
					ОбластьМакета_ГруппаДокументов.Параметры.Документ = Строка(СтрокаТЧ.Документ);	
					ТабДок.Вывести(ОбластьМакета_ГруппаДокументов);
				КонецЕсли;
				Итоги.ТекущийДокумент = СтрокаТЧ.Документ;
			КонецЕсли;
			//чкн
			УстановитьТекущийКонтейнер(Контекст,"СтрокаТЧ",СтрокаТЧ);					
			ПСП_СтрокиТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст, ИмяОбластиСтрока);		        		
		КонецЦикла;
	КонецЕсли;
	Контекст.ТЧДокумента.Сортировать("НомерСтроки");
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры

