	ТЗ.Колонки.Добавить("ОснованиеДействия", 		ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(150));
	ТЗ.Колонки.Добавить("АгентОснованиеДействия", 	ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(150));
