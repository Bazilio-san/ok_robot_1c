Функция ПолучитьЧисловойТипОбласти(ТипОбласти) Экспорт
	
	//Тип области. 0 - вне области, 1 - таблица, 2 - строки, 3 - колонки, 4 - прямоугольник
	Если ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Таблица Тогда
		Возврат 1;	
	ИначеЕсли ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда	
		Возврат 2;	
	ИначеЕсли ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Колонки Тогда
		Возврат 3;	
	ИначеЕсли ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
		Возврат 4;	
	Иначе
		Возврат 0;	
	КонецЕсли;
	
КонецФункции

//Ищет в табличном документе все параметры и возвращает в виде таблицы значений с полями:
// Параметр - имя параметра;
// Область - имя области таб. документа, в котором найден параметр
// ИмяОъединенияЯчеек - адрес объединения ячеек, в котором найден параметр
// Строка - номер строки ячейки, в которой найден параметр (или левой верхней ячейки объединения ячеек)
// Колонка - номер колонки ячейки, в которой найден параметр (или левой верхней ячейки объединения ячеек)
// Тип - тип ячейки, содержащей параметр: Параметр или Шаблон
// Порядок - порядок сортировки - в том порядке, в котором расположены параметры в табличном документе
//
Функция ПолучитьСписокПараметровТабличногоДокумента(ТабДок) Экспорт
	
	//Цель - получить двумерную таблицу, в которой бубут перечислены все сочетания
	//[Имя области] - [Имя Параметра].
	//Такая таблица позволяет сделать выборку всех параметров, входящих в заданную именованную область.	
	//Инициализируем объект RegExp для поиска параметров
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.MultiLine = Ложь; // истина — текст многострочный, ложь — одна строка
	RegExp.Global = Истина; // истина — поиск по всей строке, ложь — до первого совпадения
	RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	RegExp.Pattern = "\[([^[]*)\]"; // шаблон (регулярное выражение) для поиска параметра	
	ТипТекст = ТипЗаполненияОбластиТабличногоДокумента.Текст;
	ТипШаблон = ТипЗаполненияОбластиТабличногоДокумента.Шаблон;
	ТипПараметр = ТипЗаполненияОбластиТабличногоДокумента.Параметр;	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСтолбцов = ТабДок.ШиринаТаблицы;	
	//Создаем соответствие [Имя Области Объединения Ячееек] - [Массив имен параметров, входящих в ООЯ]
	Соотв_ООЯ_Параметры = Новый Соответствие;	
	//Создаем аналогичное соответствие (на данном этапе - копия)
	//но впоследствие отсюда будут удалены все ООЯ, входящие в именованные области
	//И останутся только ООЯ вне каких-либо областей.
	Соотв_ООЯ_Параметры_ВнеОбластей = Новый Соответствие;	
	Для Строчка = 1 по КоличествоСтрок цикл
		Для Колонка = 1 по КоличествоСтолбцов цикл			
			//Получаем ячейку или область объединенных ячеек (ООЯ). 
			//Для всех ячеек (сочетаний строка, колонка), входящих в ООЯ, 
			//будет получена одна и та же область.
			//Поэтому при первом случае получения адреса (имени) ООЯ,
			//парсим ее содержимое, находя массив параметров,
			//и добавляем в соответствие, где ключем является имя ООЯ
			//(что бы не парсить ООЯ больше одного раза)			
			ООЯ = ТабДок.Область(Строчка,Колонка);			
			типЗаполнения = ООЯ.Заполнение;			
			//Пропускаем текстовые ООЯ
			Если типЗаполнения = ТипТекст тогда
				Продолжить;
			КонецЕсли;			
			адресООЯ = ООЯ.Имя;			
			Если Соотв_ООЯ_Параметры.Получить(адресООЯ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;			
			мПарам = Новый Массив;
			Если типЗаполнения = ТипПараметр тогда
				мПарам.Добавить(ООЯ.Параметр);
			ИначеЕсли типЗаполнения = ТипШаблон тогда
				РезультатАнализаСтроки = RegExp.Execute(СокрЛП(ООЯ.Текст));
				Для Каждого Выражение Из РезультатАнализаСтроки Цикл
					мПарам.Добавить(Выражение.SubMatches(0));
			    КонецЦикла;
			КонецЕсли;			
			Соотв_ООЯ_Параметры.Вставить(адресООЯ, мПарам);
			Соотв_ООЯ_Параметры_ВнеОбластей.Вставить(адресООЯ, мПарам);
		КонецЦикла;    
	КонецЦикла;    	
	//На этом этапе заполним таблицу соответствий 
	//[Имя области] - [Имя ООЯ].	
	тзОО = Новый ТаблицаЗначений;
	тзОО.Колонки.Добавить("ИмяОбласти");
	тзОО.Колонки.Добавить("ТипОбласти");
	тзОО.Колонки.Добавить("ПорядокОбласти"); 
	//Тип области. 0 - вне области, 1 - таблица, 2 - строки, 3 - колонки, 4 - прямоугольник
	тзОО.Колонки.Добавить("ИмяООЯ");	
	сч = 0;
	Для Каждого Обл из ТабДок.Области цикл
		сч = сч + 1;		
		//Пропускаются рисунки, в них нет параметров
		Если ТипЗнч(Обл) = Тип("РисунокТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;			
		//Для каждой именованной области табличного документа 
		//соберем список входящих в нее ООЯ.		
		//При этом учитываем, что:
		// - если тип области "Колонки", то в нее НЕ войдут параметры 
		// из объединений ячеек, левая ячейка которых не входит в область колонок.
		// - если тип области "Строки", то в нее НЕ войдут параметры 
		// из объединений ячеек, верхняя ячейка которых не входит в область строк.		
		ИмяОбласти = Обл.Имя;
		ТипОбласти = Обл.ТипОбласти;
		чТипОбл = ПолучитьЧисловойТипОбласти(ТипОбласти);		
		Если ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда				
			Верх = Обл.Верх;
			Низ = Обл.Низ;			
			Для Строчка = Верх по Низ цикл
				Для Колонка = 1 по КоличествоСтолбцов цикл
					ООЯ = ТабДок.Область(Строчка,Колонка);
					Если ООЯ.Верх < Верх Тогда
						Продолжить;	
					КонецЕсли;
					Если ООЯ.Заполнение = ТипТекст тогда
						Продолжить;
					КонецЕсли;				
					НС = тзОО.Добавить();
					НС.ИмяОбласти = ИмяОбласти;
					НС.ИмяООЯ = ООЯ.Имя;
					НС.ТипОбласти = чТипОбл; 
					НС.ПорядокОбласти = чТипОбл * 1000000 + Верх * 1000;
				КонецЦикла;    
			КонецЦикла;    			
		ИначеЕсли ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Колонки Тогда			
			Лево = Обл.Лево;
			Право = Обл.Право;			
			Для Строчка = 1 по КоличествоСтрок цикл
				Для Колонка = Лево по Право цикл
					ООЯ = ТабДок.Область(Строчка,Колонка);
					Если ООЯ.Лево < Лево Тогда
						Продолжить;	
					КонецЕсли;
					Если ООЯ.Заполнение = ТипТекст тогда
						Продолжить;
					КонецЕсли;					
					НС = тзОО.Добавить();
					НС.ИмяОбласти = ИмяОбласти;
					НС.ИмяООЯ = ООЯ.Имя;
					НС.ТипОбласти = чТипОбл;
					НС.ПорядокОбласти = чТипОбл * 1000000 + Лево;
				КонецЦикла;    
			КонецЦикла;    			
		ИначеЕсли ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			ИЛИ  ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Таблица
			Тогда				
			Лево = Обл.Лево;
			Право = Обл.Право;
			Верх = Обл.Верх;
			Низ = Обл.Низ;			
			Для Строчка = Верх по Низ цикл
				Для Колонка = Лево по Право цикл
					ООЯ = ТабДок.Область(Строчка,Колонка);
					Если ООЯ.Заполнение = ТипТекст тогда
						Продолжить;
					КонецЕсли;					
					НС = тзОО.Добавить();
					НС.ИмяОбласти = ИмяОбласти;
					НС.ИмяООЯ = ООЯ.Имя;
					НС.ТипОбласти = чТипОбл;
					НС.ПорядокОбласти = чТипОбл * 1000000 + Верх * 1000 + Лево;
				КонецЦикла;    
			КонецЦикла;    			
		КонецЕсли; 		
	КонецЦикла;    	
	//Получим набор уникальных сочетаний 
	тзОО.Свернуть("ИмяОбласти,ТипОбласти,ПорядокОбласти,ИмяООЯ");
	//Создаем уникальный список ООЯ, входящих в именованные области 
	тзИменООЯ = тзОО.Скопировать();
	тзИменООЯ.Свернуть("ИмяООЯ");	
	//Получаем список ООЯ вне именованных областей 
	Для Каждого СтрТЗ из тзИменООЯ Цикл
		Если Неопределено <> Соотв_ООЯ_Параметры_ВнеОбластей.Получить(СтрТЗ.ИмяООЯ) Тогда
			Соотв_ООЯ_Параметры_ВнеОбластей.Удалить(СтрТЗ.ИмяООЯ);	
		КонецЕсли;
	КонецЦикла;		
	RegExp.Pattern = "^R\d+C\d+:R\d+C\d+$"; // шаблон (регулярное выражение) для поиска имени оласти, созданной автоматически	
	//Подготавливаем результирующую таблицу	
	ТЗПараметров = Новый ТаблицаЗначений;
	ТЗПараметров.Колонки.Добавить("ТипОбласти", 			ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(1));
	ТЗПараметров.Колонки.Добавить("Область", 				ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(50));
	ТЗПараметров.Колонки.Добавить("Параметр", 				ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(150));
	ТЗПараметров.Колонки.Добавить("ИмяООЯ", 				ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(20));
	ТЗПараметров.Колонки.Добавить("Строка", 				ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(6));
	ТЗПараметров.Колонки.Добавить("Колонка", 				ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(6));
	ТЗПараметров.Колонки.Добавить("СтрокаВОбласти", 		ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(6));
	ТЗПараметров.Колонки.Добавить("КолонкаВОбласти", 		ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(6));
	ТЗПараметров.Колонки.Добавить("АдресЯчейкиВОбласти", 	ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(20));
	ТЗПараметров.Колонки.Добавить("Тип", 					ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(8));
	ТЗПараметров.Колонки.Добавить("Порядок", 				ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(18));
	ТЗПараметров.Колонки.Добавить("ПорядокОбласти", 		ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(18));
	ТЗПараметров.Колонки.Добавить("ИД", 					ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(200));
	ТЗПараметров.Колонки.Добавить("Количество", 			ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(2));	
	//Заполняем таблицу строками для параметров, входящих в именованные области
	Для Каждого СтрТЗ из тзОО Цикл
		ИмяООЯ = СтрТЗ.ИмяООЯ;		
		мПарам = Соотв_ООЯ_Параметры.Получить(ИмяООЯ);
		Если Неопределено = мПарам Тогда
			Сообщить("Ошибка в функции ""ПолучитьСписокПараметровТабличногоДокумента"": не найдена область объединения ячеек " + ИмяООЯ, СтатусСообщения.Внимание);
			Продолжить;	
		КонецЕсли;
		ИмяОбласти = СтрТЗ.ИмяОбласти;
		Если RegExp.Test(ИмяОбласти) Тогда
			Продолжить;	
		КонецЕсли;
		ООЯ = ТабДок.Область(ИмяООЯ);
		Стр = ООЯ.Верх;
		Кол = ООЯ.Лево;
		оОбласть = ТабДок.Область(ИмяОбласти); 
		СтрВОбласти = Стр - ?(оОбласть.Верх = 0, 1, оОбласть.Верх) + 1; 
		КолВОбласти = Кол - ?(оОбласть.Лево = 0, 1, оОбласть.Лево) + 1; 
		АдресЯчейкиВОбласти = "R" + СтрВОбласти + "C" + КолВОбласти; 
		
		типЗаполнения = ООЯ.Заполнение;
		ТипОбласти = СтрТЗ.ТипОбласти;
		ПорядокОбласти = СтрТЗ.ПорядокОбласти;
		Сч = 0;
		Для Каждого Параметр из мПарам Цикл
			Сч = Сч + 1;
			ИД = ИмяОбласти + "@" + Параметр;
			НС = ТЗПараметров.Найти(ИД,"ИД");
			Если Неопределено <> НС Тогда
				НС.Количество = НС.Количество + 1;
				Продолжить;	
			КонецЕсли;
			НС = ТЗПараметров.Добавить();
			НС.ТипОбласти = ТипОбласти;
			НС.Область = ИмяОбласти;
			НС.Параметр = Параметр;
			НС.ИмяООЯ = ИмяООЯ;
			НС.Строка = Стр;
			НС.Колонка = Кол;
			НС.СтрокаВОбласти = СтрВОбласти;
			НС.КолонкаВОбласти = КолВОбласти;
			НС.АдресЯчейкиВОбласти = АдресЯчейкиВОбласти;
			НС.Тип = типЗаполнения;
			НС.Порядок = ПорядокОбласти * 1000000000 + Стр * 1000000 + Кол * 1000 + Сч;
			НС.ПорядокОбласти = ПорядокОбласти;
			НС.ИД = ИД;
			НС.Количество = 1;
		КонецЦикла;		
	КонецЦикла; // по тзОО	
	мПризнакНеименованнойОбласти = кПризнакНеименованнойОбласти();	
	//Заполняем таблицу строками для параметров, НЕ входящих в именованные области
	Для Каждого КлючЗнач из Соотв_ООЯ_Параметры_ВнеОбластей Цикл
		ИмяООЯ = КлючЗнач.Ключ;
		ООЯ = ТабДок.Область(ИмяООЯ);
		Стр = ООЯ.Верх;
		Кол = ООЯ.Лево;
		типЗаполнения = ООЯ.Заполнение;		
		мПарам = КлючЗнач.Значение;		
		Сч = 0;
		Для Каждого Параметр из мПарам Цикл
			Сч = Сч + 1;
			ИД = "@" + Параметр;
			НС = ТЗПараметров.Найти(ИД,"ИД");
			Если НС <> Неопределено Тогда
				НС.Количество = НС.Количество + 1;
				Продолжить;	
			КонецЕсли;
			НС = ТЗПараметров.Добавить();
			НС.ТипОбласти = 1;
			НС.Область = мПризнакНеименованнойОбласти;
			НС.Параметр = Параметр;
			НС.ИмяООЯ = ИмяООЯ;
			НС.Строка = Стр;
			НС.Колонка = Кол;
			НС.СтрокаВОбласти = Стр;
			НС.КолонкаВОбласти = Кол;
			НС.АдресЯчейкиВОбласти = ИмяООЯ;
			НС.Тип = типЗаполнения;
			НС.Порядок = Стр * 1000000 + Кол * 1000 + Сч;
			НС.ПорядокОбласти = 1000000;
			НС.ИД = ИД;
			НС.Количество = 1;
		КонецЦикла;		
	КонецЦикла; // по тзОО	
	RegExp = Null;	
	//Перенумеровывваем порядок;
	ТЗПараметров.Сортировать("Порядок");
	i = 0;
	Для Каждого СтрТЗ из ТЗПараметров Цикл
		i = i + 1;
		СтрТЗ.Порядок = i;
	КонецЦикла;
	Возврат ТЗПараметров;
	
КонецФункции

//Возвращает наименование договора между заданными Поставщиком и Оргагентом, действующий на заданную дату
// Получает данные из справочника ДоговорыКонтрагентов
// В имени договора возвращается расширение названия договора
// используется во внешней ПФ заявки
Функция ДайНаименованиеДоговора(Поставщик, ОрганизацияАгент, НаДату = Неопределено, Предупреждать = Ложь, МесяцПрописью = Ложь) Экспорт 
	
	Договор = уб_СС.ДайДоговорМеждуПоставщикомИОргАгентом(Поставщик, ОрганизацияАгент, НаДату, Предупреждать);
	Если Договор.Пустая() Тогда
		Возврат "";	
	КонецЕсли;
	РасширениеНазвания = ?(ПустаяСтрока(СокрЛП(Договор.РасширениеНазвания)),"",Договор.РасширениеНазвания + " ");	
	ФС = ?(МесяцПрописью = Истина,"ДФ='dd MMMM yyyy'","ДФ='dd.MM.yyyy'");
	сДог = РасширениеНазвания + "№ " + Договор.Наименование + " от "	+ Формат(Договор.ДатаЗаключенияДоговора,ФС) + "г.";	
	Возврат сДог;
	
КонецФункции

//Общ
Функция ДайОтветственноеЛицоОрганизации(ОтветственноеЛицо, ОрганизацияАгент, НаДату = Неопределено, Предупреждать = Истина) Экспорт 
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДата();	
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	О.СтруктурнаяЕдиница КАК Организация,
	|	О.ОтветственноеЛицо,
	|	О.ФизическоеЛицо,
	|	О.Должность КАК Должность,
	|	О.ОснованиеДействия
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
	|			&НаДату,
	|			СтруктурнаяЕдиница = &ОрганизацияАгент
	|				И ОтветственноеЛицо = &ОтветственноеЛицо) КАК О";	
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ОрганизацияАгент", ОрганизацияАгент);
	Запрос.УстановитьПараметр("ОтветственноеЛицо", ОтветственноеЛицо);	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() > 0 Тогда
		Возврат ТЗ[0];	
	КонецЕсли;	
	
	#Если Клиент Тогда
	Фрм = РегистрыСведений.ОтветственныеЛицаОрганизаций.ПолучитьФормуСписка();
	Если Предупреждать И НЕ Фрм.Открыта() Тогда
		Заг = "Необходимо указать ответсвенное лицо организации!";
		СОО = "На дату " + Формат(НаДату,"ДФ='dd.MM.yyyy'") + " не найдено ответственное лицо '" 
			+ Строка(ОтветственноеЛицо) + "' для организации '" + Строка(ОрганизацияАгент)  + "'
			|
			|Зайдите в регистр сведений 'Ответственные Лица Организаций' и внесите необходимые данные.
			|
			|Открыть регистр сведений 'Ответственные Лица Организаций' для внесения изменений?";
		Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Фрм.Открыть();
			ТЗ = Запрос.Выполнить().Выгрузить();
			Если ТЗ.Количество() > 0 Тогда
				Возврат ТЗ[0];	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	Возврат Неопределено;
	
КонецФункции

Функция ОбъектДолжностьОтветственногоЛица(СтруктураОтветственноеЛицо, Предупреждать = Истина) Экспорт 
	
	Если СтруктураОтветственноеЛицо = Неопределено Тогда
