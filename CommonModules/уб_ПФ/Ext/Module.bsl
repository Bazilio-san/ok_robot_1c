Функция СтрокаДоступнаДляИменованияКлючаСтруктуры(Знач Строка, ВключаяСимволыUID = Ложь) Экспорт

	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		// TODO 1ый символ не должен быть числом
		Символ = Сред(Строка, Индекс, 1);
		Если Не ДопустимыйСимволДляСтрок(Символ, ВключаяСимволыUID, Индекс = 1) Тогда
			Возврат Ложь
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции // УбратьНедопустимыеСимволыДляСтрок()

Функция ДопустимыйСимволДляСтрок(Символ, ВключаяСимволыUID = Ложь, НеВключатьЦифры = Ложь)

	Код = КодСимвола(Символ);
	Возврат (ВключаяСимволыUID И ((Код >= 32 И Код <= 64) Или (Код >= 123 И Код <= 126)))
		Или (Не НеВключатьЦифры И (Код >= 48 И Код <= 57)) 	// цифры
		Или (Код >= 65 		И Код <= 90) 	// заглавные английские
		Или (Код >= 97 		И Код <= 122) 	// строчные английские
		Или (Код >= 1040 	И Код <= 1103) 	// кириллица

КонецФункции // ДопустимыйСимволДляСтрок()

