Функция ПолучитьСтруктуруОбъектаПФИзСсылки(СсылкаПФ) Экспорт
	
	СтруктураОбъектаПФ = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	Справочник.уб_ПечатныеФормы КАК уб_ПечатныеФормы
	|ГДЕ
	|	уб_ПечатныеФормы.Ссылка = &СсылкаПФ";
	Запрос.УстановитьПараметр("СсылкаПФ",СсылкаПФ);
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	мКолво = ТЗ.Количество() = 0;
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если мКолво тогда
			Значение = Неопределено;
		Иначе
			Значение = ТЗ[0][Колонка.Имя];
		КонецЕсли;
		СтруктураОбъектаПФ.Вставить(Колонка.Имя, Значение);
	КонецЦикла;
	
	Возврат СтруктураОбъектаПФ;
	
КонецФункции	

Процедура ПечатьЗаявкаНаПечать_(Объект) Экспорт

	Перем ТЗ;
	
	ЭтоПустойБланкОСАГО = Объект.Макет.Наименование = "ОСАГО пустое";
	ТекущаяДата = ТекущаяДата();
	Объект.ПодготовитьДанные(0, ТЗ);
	Данные = Новый Структура;
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Данные.Вставить(СтрокаТЗ.Параметр, СтрокаТЗ.Значение);
	КонецЦикла;
	Данные.Вставить("СК", ДайНаименованиеКонтрагента(Объект.Шаблон.СтраховойПродукт.Владелец, Объект.Дата, Истина));
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТС.РегистрационныйЗнак КАК ОбъектСтрахованияРегистрационныйЗнак,
	|	ТС.ИдентификационныйНомер КАК ОбъектСтрахованияИдентификационныйНомер,
	|	ТС.МаркаТС КАК ОбъектСтрахованияМаркаТС,
	|	ТС.МодельТС КАК ОбъектСтрахованияМодельТС,
	|	ТС.ТипТС КАК ОбъектСтрахованияТипТС,
	|	ТС.Категория КАК ОбъектСтрахованияКатегория,
	|	ТС.ГодВыпуска КАК ОбъектСтрахованияГодВыпуска,
	|	ТС.ДвигательНомер КАК ОбъектСтрахованияДвигательНомер,
	|	ТС.ШассиНомер КАК ОбъектСтрахованияШассиНомер,
	|	ТС.КузовНомер КАК ОбъектСтрахованияКузовНомер,
	|	ТС.Цвет КАК ОбъектСтрахованияЦвет,
	|	ТС.МощностьДвигателя КАК ОбъектСтрахованияМощностьДвигателя,
	|	ТС.МаксМасса КАК ОбъектСтрахованияМаксМасса,
	|	ТС.КолПассажирскихМест КАК ОбъектСтрахованияКолПассажирскихМест,
	|	ТС.Грузоподъемность КАК ОбъектСтрахованияГрузоподъемность,
	|	ТС.ПротивоугоннаяСистема КАК ОбъектСтрахованияПротивоугоннаяСистема,
	|	ТС.ПаспортСерия КАК ОбъектСтрахованияПаспортСерия,
	|	ТС.ПаспортНомер КАК ОбъектСтрахованияПаспортНомер,
	|	ТС.ПаспортДатаВыдачи КАК ОбъектСтрахованияПаспортДатаВыдачи
	|ИЗ
	|	РегистрСведений.уб_ТранспортныеСредства КАК ТС
	|ГДЕ
	|	ТС.Объект = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Данные.ОбъектСтрахования);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные.Вставить("ОбъектСтрахованияРегистрационныйЗнак",     Выборка.ОбъектСтрахованияРегистрационныйЗнак);
		Данные.Вставить("ОбъектСтрахованияИдентификационныйНомер",  Выборка.ОбъектСтрахованияИдентификационныйНомер);
		Данные.Вставить("ОбъектСтрахованияМаркаТС",     			Выборка.ОбъектСтрахованияМаркаТС);
		Данные.Вставить("ОбъектСтрахованияМодельТС",     			Выборка.ОбъектСтрахованияМодельТС);
		Данные.Вставить("ОбъектСтрахованияТипТС",     				Выборка.ОбъектСтрахованияТипТС);
		Данные.Вставить("ОбъектСтрахованияКатегория",     			Выборка.ОбъектСтрахованияКатегория);
		Данные.Вставить("ОбъектСтрахованияГодВыпуска",     			Выборка.ОбъектСтрахованияГодВыпуска);
		Данные.Вставить("ОбъектСтрахованияДвигательНомер",    		Выборка.ОбъектСтрахованияДвигательНомер);
		Данные.Вставить("ОбъектСтрахованияШассиНомер",     			?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияШассиНомер), 				Выборка.ОбъектСтрахованияШассиНомер,			"------"));
		Данные.Вставить("ОбъектСтрахованияКузовНомер",     			?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияКузовНомер),				Выборка.ОбъектСтрахованияКузовНомер,			"------"));
		Данные.Вставить("ОбъектСтрахованияЦвет",     				?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияЦвет),						Выборка.ОбъектСтрахованияЦвет,					"------"));
		Данные.Вставить("ОбъектСтрахованияМощностьДвигателя",     	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияМощностьДвигателя), 		Выборка.ОбъектСтрахованияМощностьДвигателя, 	"------"));
		Данные.Вставить("ОбъектСтрахованияМаксМасса",     			?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияМаксМасса), 				Выборка.ОбъектСтрахованияМаксМасса,				"------"));
		Данные.Вставить("ОбъектСтрахованияКолПассажирскихМест",     ?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияКолПассажирскихМест),		Выборка.ОбъектСтрахованияКолПассажирскихМест,	"------"));
		Данные.Вставить("ОбъектСтрахованияГрузоподъемность",     	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияГрузоподъемность),			Выборка.ОбъектСтрахованияГрузоподъемность,		"------"));
		Данные.Вставить("ОбъектСтрахованияПротивоугоннаяСистема",   ?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПротивоугоннаяСистема),	Выборка.ОбъектСтрахованияПротивоугоннаяСистема, "------"));
		Данные.Вставить("ОбъектСтрахованияПаспортСерия",    	 	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПаспортСерия),				Выборка.ОбъектСтрахованияПаспортСерия,			"------"));
		Данные.Вставить("ОбъектСтрахованияПаспортНомер",     		?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПаспортНомер),				Выборка.ОбъектСтрахованияПаспортНомер,			"------"));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачи",     	Выборка.ОбъектСтрахованияПаспортДатаВыдачи);
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиДень",	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПаспортДатаВыдачи), 	Формат(Данные.ОбъектСтрахованияПаспортДатаВыдачи, "ДФ=dd"), "---"));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиМесяц",	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПаспортДатаВыдачи),	ФункцииРасширения.ПадежП(Формат(Данные.ОбъектСтрахованияПаспортДатаВыдачи, "ДФ=ММММ"), 2), "-----"));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиГод",	?(ЗначениеЗаполнено(Выборка.ОбъектСтрахованияПаспортДатаВыдачи), 	Формат(Данные.ОбъектСтрахованияПаспортДатаВыдачи, "ДФ=yyyy"), "----"));
		Данные.Вставить("ОбъектСтрахованияПредставление",			Строка(Данные.ОбъектСтрахованияМаркаТС) + " " + Данные.ОбъектСтрахованияМодельТС);
	КонецЕсли;
