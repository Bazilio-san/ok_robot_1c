Функция Регистр(Знач Фраза, Флаг_регистр) Экспорт 
	
	Если Флаг_регистр = "Н" Тогда
		Возврат НРег(Фраза);  
	ИначеЕсли Флаг_регистр = "В" Тогда
		Возврат ВРег(Фраза); 
	ИначеЕсли Флаг_регистр = "П" Тогда
		Возврат ФункцииРасширения.ПРег(Фраза); 
	ИначеЕсли Флаг_регистр = "Т" Тогда
		Возврат ТРег(Фраза); 
	Иначе 
		Возврат Фраза; 
	КонецЕсли;
	
КонецФункции

//функция заполняет стандартный код, чтобы при отсутствии кода в странице "Код программы" элемента справочника "Печатные формы", ПФ печаталась
//Два варианта:
//Контекст заполнен - при печати ПФ
//Контекст не заполнен - из справочника ПФ
Функция ЗаполнитьСтандартныйКодПФ(Контекст = Неопределено) Экспорт

	Текст = "";
	ЭтоСтруктура = ТипЗнч(Контекст) = Тип("Структура");
	Области = ?(ЭтоСтруктура, Контекст.Макет.Области, Контекст.МакетШаблона.Получить().Области);
	//отсортируем имена областей по их положению в ПФ
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИмяОбласти");
	ТЗ.Колонки.Добавить("Верх");
	Для Каждого Область Из Области Цикл
		Если ТипЗнч(Область) = Тип("ОбластьЯчеекТабличногоДокумента")
			И Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки
			Тогда
			СтрокаТЗ = ТЗ.Добавить();
			СтрокаТЗ.ИмяОбласти = Область.Имя;
			СтрокаТЗ.Верх		= Область.Верх;
		КонецЕсли;
	КонецЦикла;
	ТЗ.Сортировать("Верх");
	Счетчик = 0;
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Счетчик = Счетчик + 1;
		Отступ = ?(Счетчик = 1, "
		|", "
		|
		|");
		ИмяОбласти = СтрокаТЗ.ИмяОбласти;
		Если ИмяОбласти = "ШапкаТаб" Тогда
		ИначеЕсли ИмяОбласти = "Строка" Тогда
			//ДокументКонфигурации = ?(ЭтоСтруктура, Контекст.ОбъектПФ.ДокументКонфигурации, Контекст.ДокументКонфигурации);
			ДокументКонфигурации = ?(ЭтоСтруктура, Контекст.СтруктураОбъектаПФ.ДокументКонфигурации, Контекст.ДокументКонфигурации);
			//TODO доверенности, заявление об утрате, объявления в сми, перемещение БСО, сверка БСО, уведомление о досрочном действии договора
			Если ДокументКонфигурации = "уб_ОтчетПоставщику" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_ОП(Контекст);"
			ИначеЕсли ДокументКонфигурации = "уб_ВозвратБСООтПоставщика" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст);"
			ИначеЕсли ДокументКонфигурации = "уб_ПередачаБСОПоставщику" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_ПБП(Контекст);"
			ИначеЕсли ДокументКонфигурации = "уб_ПоступлениеБСО" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_ПБ(Контекст);"
			ИначеЕсли ДокументКонфигурации = "уб_СписаниеБСО" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_СБ(Контекст);"
			ИначеЕсли ДокументКонфигурации = "уб_УведомлениеПоставщикаОбУтратеБСО" Тогда
				Текст = Текст + Отступ + "уб_ПФ.ПСП_ТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст);"
			КонецЕсли;
		Иначе
			Текст = Текст + Отступ + "уб_ПФ.ПСП(Контекст,""" + ИмяОбласти + """);"
		КонецЕсли;
	КонецЦикла;
	Если Текст <> "" Тогда
		Текст = Текст + Отступ + "уб_ПФ.ПСПФ_КолонтитлыИНастройки(Контекст);
		|
		|уб_ПФ.ПСПФ_Показать(Контекст);"
	КонецЕсли;
	Возврат Текст;

КонецФункции // ЗаполнитьСтандартныйКодПФ()

//TODO ПараметрПринадлежности перенести в шапку запроса из отчета поставщику, только добавить проверок на пустые ссылки всех типов составного типа
Функция ПолучитьСтруктуруПечатныхФорм(Объект, ТолькоУниверсальные = Ложь, ДобавлятьСубагентскиеПФ = Ложь) Экспорт
	
	ИмяОбъекта 	= Объект.Метаданные().Имя;
	ТабПФ		= ПустаяТЗСтруктурыПФ();
	Ссылка 		= Объект.Ссылка;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПФ.Ссылка,
	|	ЕСТЬNULL(ПФ.Родитель.ДобавлятьВМенюПечати, ЛОЖЬ) КАК ДобавлятьВМенюПечатиРодитель,
	|	ПФ.ДобавлятьВМенюПечати КАК ДобавлятьВМенюПечати,
	|	ПФ.ПараметрПринадлежности.Ссылка,
	|	ПФ.Код,
	|	Выбор Когда ПФ.ПредставлениеКнопки <> """" Тогда ПФ.ПредставлениеКнопки Иначе ПФ.Наименование Конец Как Наименование,
	|	ПФ.ПоУмолчанию,
	|	ПФ.УниверсальнаяПечатнаяФорма,
	|	ВЫБОР
	|			КОГДА ПФ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			КОГДА &Дата >= ПФ.ДатаНачалаДействия
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА ПФ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			КОГДА ПФ.ДатаОкончанияДействия >= &Дата
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК Действует,
	|	ВЫБОР
	|		КОГДА ПФ.ДатаОкончанияДействия <= &Дата
	|				И НЕ ПФ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Действовала,
	|	ПФ.ДатаОкончанияДействия,
	|	ПФ.ДатаНачалаДействия,
	|	ПФ.Статус
	|ИЗ
	|	Справочник.уб_ПечатныеФормы КАК ПФ
	|ГДЕ
	|	(ПФ.ДобавлятьВМенюПечати
	|			ИЛИ ПФ.Родитель.ДобавлятьВМенюПечати)
	|	И ПФ.ДокументКонфигурации = &Документ");
	Запрос.УстановитьПараметр("Документ", 		ИмяОбъекта);
	Запрос.УстановитьПараметр("Дата", 			?(Объект.Дата = Дата(1,1,1),ТекущаяДата(),Объект.Дата));
	Запрос.УстановитьПараметр("ТекущаяДата", 	НачалоДня(ТекущаяДата()));
	Если ИмяОбъекта = "уб_ОтчетПоставщику" Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И (ПФ.Поставщик = &Поставщик
		|			ИЛИ ПФ.УниверсальнаяПечатнаяФорма)
		|	И ВЫБОР
		|			КОГДА ПФ.ОрганизацияАгент <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|				ТОГДА ПФ.ОрганизацияАгент = &ОрганизацияАгент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И (ПФ.ПараметрПринадлежности.Ссылка ЕСТЬ NULL 
		|	ИЛИ ПФ.ПараметрПринадлежности = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка) 
		|	ИЛИ ПФ.ПараметрПринадлежности = &ВидСП)";
		Запрос.УстановитьПараметр("Поставщик", 			Объект.Поставщик);
		Запрос.УстановитьПараметр("ОрганизацияАгент", 	Объект.ОрганизацияАгент);
		Запрос.УстановитьПараметр("ВидСП", 				Объект.ВидСП);
	ИначеЕсли ИмяОбъекта = "уб_Доверенности" Тогда
		//Выбираем все ПФ у которых:
		// Оргагент равен Доверителю
		// Оргагент равен Пустой ссылке на справочник типа доверителя
		// Оргагент = Неопределено
		Доверитель = Ссылка.Доверитель;
		ВидДоверенности = Ссылка.ВидДоверенности;
		Если Доверитель = Неопределено Тогда
			ЗначПараметра = Неопределено;	
		Иначе
			ЗначПараметра = Справочники[Доверитель.Метаданные().Имя].ПустаяСсылка();	
		КонецЕсли;		
		Запрос.Текст = Запрос.Текст + 
		"	И (ПФ.ПараметрПринадлежности.Ссылка = &ВидДоверенности
		|	И (ПФ.ОрганизацияАгент = &Доверитель
		|	ИЛИ ПФ.ОрганизацияАгент = &ПустаяСсылкаТипаСправочникаДоверителя
		|	ИЛИ ПФ.ОрганизацияАгент = &Неопределено)
		|	ИЛИ ПФ.УниверсальнаяПечатнаяФорма)";
		Запрос.УстановитьПараметр("ПустаяСсылкаТипаСправочникаДоверителя", 	ЗначПараметра);			   
		Запрос.УстановитьПараметр("Неопределено", 							Неопределено);			   
		Запрос.УстановитьПараметр("ВидДоверенности", 						ВидДоверенности);
		Запрос.УстановитьПараметр("Доверитель", 							Доверитель);
	ИначеЕсли ИмяОбъекта 	= "уб_ОбъявлениеВСМИобУтратеБСО"
		Или ИмяОбъекта 		= "уб_ЗаявлениеОбУтрате"
		Или ИмяОбъекта 		= "уб_СписаниеБСО"
		Или ИмяОбъекта		= "уб_ЗаявлениеВПолицию"
		Тогда
		Запрос.Текст = Запрос.Текст + "	И ПФ.УниверсальнаяПечатнаяФорма";
	ИначеЕсли ИмяОбъекта = "уб_ПередачаБСОПоставщику"
		Или ИмяОбъекта = "уб_ПоступлениеБСО"
		Или ИмяОбъекта = "уб_СверкаБСО" 
		Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И (ПФ.Поставщик = &Поставщик
		|			ИЛИ ПФ.УниверсальнаяПечатнаяФорма)
		|	И ВЫБОР
		|			КОГДА ПФ.ОрганизацияАгент <> &ПустойОргАгент
		|				ТОГДА ПФ.ОрганизацияАгент = &ОрганизацияАгент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
		Запрос.УстановитьПараметр("Поставщик", 			Ссылка.Поставщик);
		Запрос.УстановитьПараметр("ОрганизацияАгент", 	Ссылка.ОрганизацияАгент);
		Запрос.УстановитьПараметр("ПустойОргАгент", 	Справочники.Организации.ПустаяСсылка());
	ИначеЕсли ИмяОбъекта = "уб_УведомлениеПоставщикаОбУтратеБСО" Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И (ПФ.Поставщик = &Поставщик
		|			ИЛИ ПФ.УниверсальнаяПечатнаяФорма)";
		Запрос.УстановитьПараметр("Поставщик", Ссылка.Поставщик);
	ИначеЕсли ИмяОбъекта = "уб_ВыплатаЗП" 
		Или ИмяОбъекта = "уб_НачислениеЗП" 
		Тогда
		Запрос.Текст = Запрос.Текст + "	И ПФ.ОрганизацияАгент = &ОрганизацияАгент";
		Запрос.УстановитьПараметр("ОрганизацияАгент", Ссылка.Организация);
	ИначеЕсли ИмяОбъекта = "уб_УведомлениеОДосрочномПрекращенииДействияДоговора" Тогда
		Запрос.Текст = Запрос.Текст + "	И ПФ.ОрганизацияАгент = &ОрганизацияАгент";
		Запрос.УстановитьПараметр("ОрганизацияАгент", Ссылка.СозданНаОсновании.ОрганизацияАгент);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	УниверсальнаяПечатнаяФорма Убыв, Наименование Убыв";
	НайденаПФ = Ложь;
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() И (ИмяОбъекта = "уб_ВыплатаЗП" Или ИмяОбъекта = "уб_НачислениеЗП") Тогда
		Запрос.УстановитьПараметр("ОрганизацияАгент", Справочники.Организации.ПустаяСсылка());
		Результат = Запрос.Выполнить();
	КонецЕсли;
	Выборка = Результат.Выбрать();//Выгрузить();
	//Для каждого Стр Из ТЗ Цикл
	Пока Выборка.Следующий() Цикл
		Если ТолькоУниверсальные и Не Выборка.УниверсальнаяПечатнаяФорма Тогда
			Продолжить;
		КонецЕсли;
		
		//!!!!
		Если Найти(ВРЕГ(Выборка.Наименование),"СУБАГЕНТ")>0 Тогда
			Продолжить;
		КонецЕсли;	
		СтрокаТЗ = ТабПФ.Добавить();
		СтрокаТЗ.КодПФ 					= "ПФ" + Выборка.Код;
		СтрокаТЗ.СсылкаПФ 				= Выборка.Ссылка;
		СтрокаТЗ.Наименование   		= Выборка.Наименование + ?(Выборка.Действовала, " (по " + Формат(Выборка.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy") + ")", "");
		СтрокаТЗ.ДобавлятьВМенюПечати   = Выборка.ДобавлятьВМенюПечати;
		СтрокаТЗ.Статус					= Выборка.Статус;
		СтрокаТЗ.Действовала			= Выборка.Действовала;
		СтрокаТЗ.ПоУмолчанию			= Выборка.ПоУмолчанию;
		Если Выборка.ПоУмолчанию И Не Выборка.УниверсальнаяПечатнаяФорма И Не НайденаПФ Тогда			
			#Если Клиент Тогда
			СохранитьЗначение(Ссылка.Метаданные().Имя + "МакетПечати", Выборка.Наименование);
			#КонецЕсли
			НайденаПФ = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ДобавлятьСубагентскиеПФ И ИмяОбъекта = "уб_ОтчетПоставщику" Тогда
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			Если ТолькоУниверсальные и Не Выборка.УниверсальнаяПечатнаяФорма Тогда
				Продолжить;
			КонецЕсли;
			//!!!!
			Если Найти(ВРЕГ(Выборка.Наименование),"СУБАГЕНТ")>0 Тогда
				СтрокаТЗ = ТабПФ.Добавить();
				СтрокаТЗ.КодПФ					= "СА" + Выборка.Код;
				СтрокаТЗ.Наименование   		= Выборка.Наименование + ?(Выборка.Действовала, " (по " + Формат(Выборка.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy") + ")", "") + " (субагент)";
				СтрокаТЗ.ДобавлятьВМенюПечати   = Выборка.ДобавлятьВМенюПечати;
				СтрокаТЗ.Статус					= Выборка.Статус;
				СтрокаТЗ.Действовала			= Выборка.Действовала;
				СтрокаТЗ.ПоУмолчанию			= Ложь;
				СтрокаТЗ.СсылкаПФ				= Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ТабПФ;
	
КонецФункции

Процедура ДобавитьОбщиеПоказателиПечатныхФорм(Контекст, КодПФ = Неопределено) Экспорт
	
	Объект = Контекст.Объект;
	ИмяДокумента = Контекст.ИмяОбъекта;
	Показатели = Новый Структура;
	ТЧДокумента = Контекст.ТЧДокумента;
	//Контекст.Вставить("СтруктураОбщихПоказателей",СтруктураОбщихПоказателей);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	уб_ПечатныеФормыОбщиеПоказатели.ОбщийПоказатель
	|ПОМЕСТИТЬ ВТ_ОтключенныеПоказатели
	|ИЗ
	|	Справочник.уб_ПечатныеФормы.ОбщиеПоказатели КАК уб_ПечатныеФормыОбщиеПоказатели
	|ГДЕ
	|	уб_ПечатныеФормыОбщиеПоказатели.Ссылка = &СсылкаПФ
	|	И уб_ПечатныеФормыОбщиеПоказатели.Отключен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	уб_ОбщиеПоказателиПечатныхФорм.ИмяПоказателя,
	|	уб_ОбщиеПоказателиПечатныхФорм.Формула,
	|	уб_ОбщиеПоказателиПечатныхФорм.ПоказательТабличнойЧасти,
	|	уб_ОбщиеПоказателиПечатныхФорм.Порядок,
	|	уб_ОбщиеПоказателиПечатныхФорм.РассчитыватьИтоги,
	|	уб_ОбщиеПоказателиПечатныхФорм.Разрядность,
	|	уб_ОбщиеПоказателиПечатныхФорм.РазрядностьДробнойЧасти
	|ПОМЕСТИТЬ ВТ_Показатели
	|ИЗ
	|	Справочник.уб_ОбщиеПоказателиПечатныхФорм КАК уб_ОбщиеПоказателиПечатныхФорм
	|ГДЕ
	|	уб_ОбщиеПоказателиПечатныхФорм.Наименование = &ИмяДокумента
	|	И НЕ уб_ОбщиеПоказателиПечатныхФорм.ПометкаУдаления
	|	И НЕ уб_ОбщиеПоказателиПечатныхФорм.Ссылка В
	|				(ВЫБРАТЬ
	|					Т.ОбщийПоказатель
	|				ИЗ
	|					ВТ_ОтключенныеПоказатели КАК Т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Показатели.ИмяПоказателя,
	|	ВТ_Показатели.Формула
	|ИЗ
	|	ВТ_Показатели КАК ВТ_Показатели
	|ГДЕ
	|	НЕ ВТ_Показатели.ПоказательТабличнойЧасти
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Показатели.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Показатели.ИмяПоказателя,
	|	ВТ_Показатели.Формула,
	|	ВТ_Показатели.РассчитыватьИтоги,
	|	ВТ_Показатели.Разрядность,
	|	ВТ_Показатели.РазрядностьДробнойЧасти
	|ИЗ
	|	ВТ_Показатели КАК ВТ_Показатели
	|ГДЕ
	|	ВТ_Показатели.ПоказательТабличнойЧасти
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Показатели.Порядок";	
	Запрос.УстановитьПараметр("ИмяДокумента",	ИмяДокумента);
	Запрос.УстановитьПараметр("СсылкаПФ",		?(КодПФ = Неопределено, Контекст.СсылкаПФ, Справочники.уб_ПечатныеФормы.НайтиПоКоду(КодПФ)));
	Результат = Запрос.ВыполнитьПакет();
	Выборка = Результат[2].Выбрать();//общие показатели шапки
	Пока Выборка.Следующий() Цикл		
		Формула = Выборка.Формула;
		ИмяПоказателя = Выборка.ИмяПоказателя;
		Если Не ПустаяСтрока(Формула) И Не ПустаяСтрока(ИмяПоказателя) Тогда						
			ЗначениеПоказателя = Неопределено;
			Попытка
				Выполнить(Формула);
				Показатели.Вставить(ИмяПоказателя, ЗначениеПоказателя);
			Исключение
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Ошибка вычисления общего показателя " + ИмяПоказателя + " при выполнении кода: 
				| " + Формула + "
				|Имя документа = " + ИмяДокумента + ";
				|Справочник печатной формы = " + Контекст.СтруктураОбъектаПФ.Наименование + " (" + Контекст.СтруктураОбъектаПФ.Код +")" + ";
				|Описание ошибки: " + ОписаниеОшибки();
				Сообщение.Сообщить();
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(ТЧДокумента) = Тип("ТаблицаЗначений") Тогда
		ВыборкаТЧ = Результат[3].Выбрать();//общие показатели табличной части
		МассивПоказателейДляЗаполнения 	= Новый Массив;
		МассивПоказателейСИтогами		= Новый Массив;
		ТЗИтогов = Контекст.Контейнер_Итоги.Владелец();
		ТЗПоказателей = Новый ТаблицаЗначений;
		ТЗПоказателей.Колонки.Добавить("ИмяПоказателя");
		ТЗПоказателей.Колонки.Добавить("РассчитыватьИтоги");
		ТЗПоказателей.Колонки.Добавить("Разрядность");
		ТЗПоказателей.Колонки.Добавить("РазрядностьДробнойЧасти");
		Пока ВыборкаТЧ.Следующий() Цикл//Добавить колонки для общих показателей
			ИмяПоказателя = ВыборкаТЧ.ИмяПоказателя;
			Если ТЧДокумента.Колонки.Найти(ИмяПоказателя) = Неопределено Тогда
				ТЧДокумента.Колонки.Добавить(ИмяПоказателя);
				МассивПоказателейДляЗаполнения.Добавить(ИмяПоказателя);
			КонецЕсли;
			СтрокаТЗ = ТЗПоказателей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, ВыборкаТЧ);			
			Если ВыборкаТЧ.РассчитыватьИтоги И ТЗИтогов.Колонки.Найти(ИмяПоказателя) = Неопределено Тогда
				ТЗИтогов.Колонки.Добавить(ИмяПоказателя, ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(ВыборкаТЧ.Разрядность, ВыборкаТЧ.РазрядностьДробнойЧасти));
			КонецЕсли;
		КонецЦикла;
		Показатели.Вставить("ТЗПоказателей", ТЗПоказателей);
		Для Каждого Стр Из ТЧДокумента Цикл		
			ВыборкаТЧ.Сбросить();
			Пока ВыборкаТЧ.Следующий() Цикл			
				ЗначениеПоказателя = Неопределено;
				Формула = ВыборкаТЧ.Формула;
				ИмяПоказателя = ВыборкаТЧ.ИмяПоказателя;
				Если МассивПоказателейДляЗаполнения.Найти(ИмяПоказателя) <> Неопределено Тогда				
					Попытка
						Выполнить(Формула);
						Если ВыборкаТЧ.РассчитыватьИтоги И ТипЗнч(ЗначениеПоказателя) <> Тип("Число") Тогда
							//ошибка частного кода, должен быть тип число
							ЗначениеПоказателя = 0;
						КонецЕсли;
						Стр[ИмяПоказателя] = ЗначениеПоказателя;
					Исключение
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Ошибка вычисления общего показателя " + ИмяПоказателя + " при выполнении кода:
						| " + Формула + "
						|Имя документа = " + ИмяДокумента + ";
						|Справочник печатной формы = " + Контекст.СтруктураОбъектаПФ.Наименование + " (" + Контекст.СтруктураОбъектаПФ.Код + ")" + ";
						|Описание ошибки: " + ОписаниеОшибки();
						Сообщение.Сообщить();
						Если ВыборкаТЧ.РассчитыватьИтоги Тогда
							//чтобы посчитались итоги, и зная, что показатель числовой, запишем вместо ЗначениеПоказателя = Неопределено на 0
							Стр[ИмяПоказателя] = 0
						КонецЕсли;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Контекст.Показатели = Показатели;
	
КонецПроцедуры

Процедура НайтиОтличияОтТекущегоСостояния(Контекст)
	ТЧДокумента = Контекст.ТЧДокумента;
	Если ТипЗнч(ТЧДокумента) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Оплата Из ТЧДокумента Цикл
			СтрокаТЧДокументаТекущегоСостояния = Контекст.ТабличнаяЧатьТекущегоСостоянияДокумента.Найти(Оплата.Ссылка,"Ссылка");
			СписокИзменений = Новый СписокЗначений;
			Для Каждого КолонкаТаблицы Из ТЧДокумента.Колонки Цикл
				Если СтрокаТЧДокументаТекущегоСостояния <> Неопределено Тогда
					Если Контекст.ТабличнаяЧатьТекущегоСостоянияДокумента.Колонки.Найти(КолонкаТаблицы.Имя) <> Неопределено Тогда
						ЗначениеСлева = Оплата[КолонкаТаблицы.Имя];
						ЗначениеСправа = СтрокаТЧДокументаТекущегоСостояния[КолонкаТаблицы.Имя];
						ПроверитьЗаполнениеЗначений(ЗначениеСлева, ЗначениеСправа, КолонкаТаблицы.Имя, Контекст);
						Если ЗначениеСлева <> ЗначениеСправа Тогда
							СписокИзменений.Добавить(КолонкаТаблицы.Имя);
						КонецЕсли;
					Иначе
						СписокИзменений.Добавить(КолонкаТаблицы.Имя);
					КонецЕсли;
				Иначе
					СписокИзменений.Добавить(КолонкаТаблицы.Имя);
				КонецЕсли;
			КонецЦикла;
			Оплата.Изменить = СписокИзменений;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЗаполнениеЗначений(ЗначениеСлева, ЗначениеСправа, ИмяКолонкаТаблицы, Контекст)
		
	Если ИмяКолонкаТаблицы = "НомерВзноса" Или ИмяКолонкаТаблицы = "ПризнакПлатежа" Тогда
		Номер = Найти(ЗначениеСлева," ");
		Если Номер > 0 Тогда
			СтрокаДляСравнения = Лев(ЗначениеСлева,Номер - 1);
			Если СтрокаДляСравнения = Строка(ЗначениеСправа) Тогда
				ЗначениеСправа = ЗначениеСлева;
			КонецЕсли;
		ИначеЕсли Нрег(ЗначениеСлева) = "п.премия" И ЗначениеСправа = 1 Тогда
			ЗначениеСправа = ЗначениеСлева;
		КонецЕсли;
	Иначе
		Если ТипЗнч(ЗначениеСлева) = Тип("Число") Тогда
			Если ИмяКолонкаТаблицы <> "Курс" Тогда
				ЗначениеСлева = Формат(ЗначениеСлева,Контекст.ЧФ);
			Иначе
				ЗначениеСлева = Формат(ЗначениеСлева,"ЧДЦ=4");
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ЗначениеСправа) = Тип("Число") Тогда
			Если ИмяКолонкаТаблицы <> "Курс" Тогда
				ЗначениеСправа = Формат(ЗначениеСправа,Контекст.ЧФ);
			Иначе
				ЗначениеСправа = Формат(ЗначениеСправа,"ЧДЦ=4");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Процедура Печать(Контекст, Объект, ИмяМакета) Экспорт
	
	ИмяОбъекта = Контекст.ИмяОбъекта;
	Если Не Объект_Печать_степ2(Объект, Контекст, ИмяМакета) Тогда 
		Возврат;
	КонецЕсли;
	Контекст.ТЧДокумента = ПолучитьТЗизТЧдляПечати(Контекст);
	Если Контекст.Свойство("ЭтоИсторияОП") И Контекст.ЭтоИсторияОП = Истина Тогда
		НайтиОтличияОтТекущегоСостояния(Контекст);
	КонецЕсли;
	Если Контекст.СтруктураОбъектаПФ.ЭтоКомплект Тогда//Если Контекст.ОбъектПФ.ЭтоКомплект Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПФ.Ссылка,
		|	ПФ.Код
		|ИЗ
		|	Справочник.уб_ПечатныеФормы КАК ПФ
		|ГДЕ
		|	ПФ.Родитель = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Контекст.СсылкаПФ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Контекст.СсылкаПФ = Выборка.Ссылка;
			Контекст.СтруктураОбъектаПФ = уб_ПФ.ПолучитьСтруктуруОбъектаПФИзСсылки(Выборка.Ссылка);
			Если Не Объект_Печать_степ2(Объект, Контекст, "ПФ" + Выборка.Код) Тогда
				Возврат;
			КонецЕсли;
			//TODO оптимизировать! Чтобы не перебирать одни и те же данные в цикле,
			//только изза различий отключенных показателей
			ДобавитьОбщиеПоказателиПечатныхФорм(Контекст, "ПФ" + Выборка.Код);
			ЧастныйКод = Контекст.СтруктураОбъектаПФ.ТекстПрограммы.Получить();
			Если СокрЛП(ЧастныйКод) = "" Тогда
				ЧастныйКод = ЗаполнитьСтандартныйКодПФ(Контекст);
			КонецЕсли;
			Попытка
				Выполнить(ЧастныйКод)
			Исключение
				//ППС 13-08-2014
				СообщениеОшибки = ОписаниеОшибки();
				Если Не ПустаяСтрока(СообщениеОшибки) Тогда
					
					СообщениеОшибки = СформироватьСообщениеОшибка(Контекст, СообщениеОшибки, ЧастныйКод);
					
					Если Контекст.Отладка.Включена Тогда
						ТипСообщения = "Сообщить";
					Иначе
						ТипСообщения = "ЛишьВЖурналаРегистрации";
					КонецЕсли;
					
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СообщениеОшибки, ТипСообщения, Истина);
					
				КонецЕсли;
				//ППС 13-08-2014
			КонецПопытки;
		КонецЦикла;
	Иначе
		ДобавитьОбщиеПоказателиПечатныхФорм(Контекст);
		ЧастныйКод = Контекст.СтруктураОбъектаПФ.ТекстПрограммы.Получить();
		Если СокрЛП(ЧастныйКод) = "" Тогда
			ЧастныйКод = ЗаполнитьСтандартныйКодПФ(Контекст);
		КонецЕсли;
		Попытка
			Выполнить(ЧастныйКод)
		Исключение
			//ППС 13-08-2014
			СообщениеОшибки = ОписаниеОшибки();
			Если Не ПустаяСтрока(СообщениеОшибки) Тогда
				
				СообщениеОшибки = СформироватьСообщениеОшибка(Контекст, СообщениеОшибки, ЧастныйКод);
				
				Если Контекст.Отладка.Включена Тогда
					ТипСообщения = "Сообщить";
				Иначе
					ТипСообщения = "ЛишьВЖурналаРегистрации";
				КонецЕсли;
				
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СообщениеОшибки, ТипСообщения, Истина);
				
			КонецЕсли;                               
			//ППС 13-08-2014
		КонецПопытки;
	КонецЕсли;
	Если Контекст.Отладка.Включена Тогда
		Сообщить("<<<< " + ?(Контекст.Отладка.ТЗОшибок.Количество() > 0, "Ошибок: " + Контекст.Отладка.ТЗОшибок.Количество(),"ОК") + " <<<<");
	КонецЕсли;
	//частно для передачи БСО Поставщику
	Если ИмяОбъекта = "уб_ПередачаБСОПоставщику" Тогда
		Если ЗначениеЗаполнено(Контекст.Объект.Курьер) Тогда
			ПечатьАктаПередачиКурьеру(Контекст);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ПечатьАктаПередачиКурьеру(Контекст) Экспорт
	
	Объект 			= Контекст.Объект;
	Курьер 			= Объект.Курьер;
	Агент			= Объект.Агент;
	Поставщик   	= Объект.Поставщик;
	Дата			= Объект.Дата;
	Номер			= Объект.Номер;
	НомерДляОтчета  = Объект.НомерДляОтчета;
	мБСОклон = Контекст.ТЧДокумента;
	//ТОДО перевести акт в шаблоны ПФ.
	Макет = Документы.уб_ПередачаБСОПоставщику.ПолучитьМакет("АктКурьеру");
	ТабДок2 = Новый ТабличныйДокумент;
	
	сНомерАкта		= ?(НомерДляОтчета <> "",НомерДляОтчета + " (" + Формат(Номер,"ЧГ=") + ")",Формат(Номер,"ЧГ="));
	сНомерАктаПП	= сНомерАкта + "-п";
	сДатаАкта		= Формат(Дата,"ДЛФ=ДД");
	
	ОбластьМакета_Шапка = Макет.ПолучитьОбласть("ШапкаКурьера");
	
	Прм = ОбластьМакета_Шапка.Параметры;
	Прм.Номер0				= сНомерАкта;
	Прм.Номер				= сНомерАктаПП;
	Прм.Дата				= сДатаАкта;
	Прм.Поставщик			= ДайНаименованиеКонтрагента(Поставщик, сДатаАкта, Истина, 1, 1, Истина);
	Прм.АгентОтправитель	= Агент;
	Прм.АгентПолучатель		= Курьер;
	
	ТабДок2.Вывести(ОбластьМакета_Шапка);
	
	ОбластьМакета_ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицыКурьера");
	ТабДок2.Вывести(ОбластьМакета_ШапкаТаблицы);
	
	ОбластьМакета_СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаКурьера");
	ПрмС = ОбластьМакета_СтрокаТаблицы.Параметры;
	
	ОбластьМакета_ГруппаСК = Макет.ПолучитьОбласть("ГруппаСККурьера");
	
	
	мБСОклон.Сортировать("СК,ВидБСО,НомерБСО");
	ТекущаяСК = Неопределено;	
	СчетчикСтрок = 0;
	 
	Для Каждого СтрокаТЧ из мБСОклон Цикл
		Если ТекущаяСК <> СтрокаТЧ.СК Тогда
			ОбластьМакета_ГруппаСК.Параметры.СК = СтрокаТЧ.СК;	
			ТабДок2.Вывести(ОбластьМакета_ГруппаСК);
		КонецЕсли;
		ТекущаяСК = СтрокаТЧ.СК;
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
		ПрмС.НомерСтроки	  = СчетчикСтрок;
		ПрмС.ВидБСО			  = СтрокаТЧ.ВидБСО;		
		ПрмС.НомерБСО	 	  = СтрокаТЧ.НомерБСО;
		ПрмС.НомерПолиса 	  = СтрокаТЧ.НомерПолиса;
		ПрмС.СостояниеБСО 	  = СтрокаТЧ.Состояние;
		ПрмС.Страхователь 	  = СтрокаТЧ.Страхователь;
		ПрмС.РасшСтрахователь = СтрокаТЧ.РасшСтрахователь;
		
		ТабДок2.Вывести(ОбластьМакета_СтрокаТаблицы);
	КонецЦикла;
	
	
	ОбластьМакета_Подвал = Макет.ПолучитьОбласть("ПодвалКурьера");
	
	ПрмП = ОбластьМакета_Подвал.Параметры;
	ПрмП.Сдал = Агент;
	ПрмП.Курьер = Курьер;
	
	ПрмП.ТекДень = Формат(Дата,"ДФ='dd'");
	ПрмП.ТекМесяц = ФункцииРасширения.Месяца(Дата);
	ПрмП.ТекГод = Формат(Дата,"ДФ='yyyy'");

	ТабДок2.Вывести(ОбластьМакета_Подвал);

	ТабДок2.ОтображатьЗаголовки	= Истина;
	ТабДок2.ОтображатьСетку		= Ложь;
	ТабДок2.ТолькоПросмотр		= Истина;
	ТабДок2.Защита				= Ложь;
	ТабДок2.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДок2.АвтоМасштаб			= Истина;
	
	ТабДок2.ПовторятьПриПечатиСтроки = ТабДок2.Области.ШапкаТаблицыКурьера;

	ТабДок2.РазмерКолонтитулаСверху = 6;
	ВКлн = ТабДок2.ВерхнийКолонтитул;
	ВКлн.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ВКлн.НачальнаяСтраница = 1;
	ВКлн.Выводить	= Истина;
	ВКлн.ТекстСлева = "АКТ п/п БСО №" + сНомерАктаПП + " от " + сДатаАкта + ". Передает: "
		+ Строка(Агент) + ", принимает: " + Строка(Курьер);
	ВКлн.ТекстСправа = " стр. [&НомерСтраницы] из [&СтраницВсего]";
	//ВКлн.Шрифт = Новый Шрифт(,7);
	
	ТабДок2.РазмерКолонтитулаСнизу = 8;
	HКлн = ТабДок2.НижнийКолонтитул;
	HКлн.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	HКлн.НачальнаяСтраница = 1;
	HКлн.Выводить	= Истина;
	HКлн.ТекстСправа = "ITC:УБ v." + Метаданные.Версия;
	HКлн.Шрифт = Новый Шрифт(,7);

	ТабДок2.Показать("АКТ пп БСО №" + сНомерАктаПП + " от " + сДатаАкта + " (от " + Строка(Агент) + " курьеру " + Строка(Курьер) + ")");
КонецПроцедуры

Функция ПолучитьТЗизТЧдляПечати(Контекст) Экспорт
	
	ИмяОбъекта = Контекст.ИмяОбъекта;
	Если ИмяОбъекта = "уб_Доверенности" Или ИмяОбъекта = "уб_СтраховойПолис" Тогда
		//не нужна
	ИначеЕсли ИмяОбъекта = "уб_ПередачаБСОПоставщику" Тогда
		ТЗБСО = ТЗизТЧ_ПередачаБСОПоставщику(Контекст)
	//для истории отчета поставщику своя ТЗИзТЧ и свойства при открытии элемента справочника печатных форм нет	
	ИначеЕсли ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(Контекст, "ЭтоИсторияОП", Истина) Тогда
		ТЗБСО = ОП_ПолучитьТЗОплатИстории(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ОтчетПоставщику" Тогда
		ТЗБСО = ОП_ПолучитьТЗОплат(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ПоступлениеБСО" Тогда
		ТЗБСО = ТЗизТЧ_ПоступлениеБСО(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_УведомлениеОДосрочномПрекращенииДействияДоговора" Тогда
		ТЗБСО = ТЗизТЧ_УведомлениеОДосрочномПрекращенииДействияДоговора(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ТабельУчетаРабочегоВремени" Тогда
		ТЗБСО = ТЗизТЧ_ТабельУчетаРабочегоВремени(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ВыплатаЗП" Или ИмяОбъекта = "НачислениеЗП" Тогда
		ТЗБСО = Контекст.Объект.Ведомость.Выгрузить();
	ИначеЕсли ИмяОбъекта = "уб_ЗаявлениеВПолицию" Тогда
		ТЗБСО = ТЗизТЧ_ЗаявлениеВПолицию(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ИнвентаризацияБСО" Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Подтверждено",Истина);
		Строки = Контекст.Объект.БСО.НайтиСтроки(Отбор);
		ТЗБСО = Контекст.Объект.БСО.Выгрузить(Строки);
	Иначе
		ТЗБСО = ТзизТЧ_Типовая(Контекст)	
	КонецЕсли;
	Возврат ТЗБСО;
	
КонецФункции

Процедура Печать_Обратный_Вызов_3(Контекст) Экспорт
	
	//Определяем тип доверителя
	//В зависимости от типа доверителя будут браться соответствующие типовые блоки макета доверенности
	Контекст.Вставить("ТипДоверителя");
	Объект = Контекст.Объект;
	Доверитель = Объект.Доверитель;
	ЕдиницаИзмеренияСрокаДействия = Объект.ЕдиницаИзмеренияСрокаДействия;
	СрокДействия = Объект.СрокДействия;
	ДоверенноеЛицо = Объект.ДоверенноеЛицо;	
	Если ТипЗнч(Доверитель) = Тип("СправочникСсылка.Организации") Тогда
		Если Доверитель.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			Контекст.ТипДоверителя = "ФизЛицо";
			Если Доверитель.ЭтоИндивидуальныйПредприниматель Тогда
				Контекст.ТипДоверителя = "ИП";
			Иначе
				Контекст.ТипДоверителя = "ФизЛицо";
				Контекст.Контейнер_Документ.Доверитель = Доверитель.ИндивидуальныйПредприниматель; 	
			КонецЕсли;
		Иначе
			Контекст.ТипДоверителя = ?(Доверитель.ЭтоИндивидуальныйПредприниматель,"ИП","Организация");
		КонецЕсли;
	ИначеЕсли ТипЗнч(Доверитель)= Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Контекст.ТипДоверителя = "ФизЛицо";
	КонецЕсли;	
	//Получаем структуру "ответственного лица" Доверенного
	//В ней предуспотрены поля для структур адреса и паспортных данных	
 	ОЛДоверенного = ДайОтветственноеЛицоДляФизлица(ДоверенноеЛицо, Ложь);  
	Если ОЛДоверенного.ПаспортныеДанные = Неопределено Тогда
		#Если Клиент Тогда
		Предупреждение("Паспортные данные доверенного лица не указаны! Печать не возможна");
		#КонецЕсли
		Возврат;	
	КонецЕсли;
	Если ОЛДоверенного.АдресПрописки = Неопределено Тогда
		#Если Клиент Тогда
		Предупреждение("Адрес по прописке доверенного лица не указан! Печать не возможна");
		#КонецЕсли
		Возврат;	
	КонецЕсли;			
	//Создаем новое свойство контейнера для использования в Параметрах макетов
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "АдресДоверенногоЛица", ОЛДоверенного.АдресПрописки.Представление);	
	ПД = ОЛДоверенного.ПаспортныеДанные;
	ПДДЛ = "паспорт: " + ПД.ДокументСерия + " № " + ПД.ДокументНомер + ", выдан: " 
	+ Формат(ПД.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy") + "г., " + ПД.ДокументКемВыдан;
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "ПаспортДоверенногоЛица", ПДДЛ);		
	//Создаем новое свойство контейнера для использования в Параметрах макетов
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "Срок", ДайПериодПрописью(СрокДействия, ЕдиницаИзмеренияСрокаДействия));		
	//Создаем клон структуры контекста, который будет использоваться для работы с макетом типовых блоков доверенности
	//В этой структуре будут альтернативный Макет и СсылкаПФ
	Контекст.Вставить("КонтекстТиповогоМакета", КлонироватьКонтекст(Контекст));	
	ПФ = ПараметрыСеанса.уб_Константы.МакетТиповыхБлоковДоверенности;
	Контекст.КонтекстТиповогоМакета.Макет = ПФ.МакетШаблона.Получить();
	Контекст.КонтекстТиповогоМакета.СсылкаПФ = ПФ;
	Контекст.КонтекстТиповогоМакета.СтруктураОбъектаПФ = уб_ПФ.ПолучитьСтруктуруОбъектаПФИзСсылки(ПФ);//Контекст.КонтекстТиповогоМакета.ОбъектПФ = ПФ.ПолучитьОбъект();
	Если Контекст.ТипДоверителя <> "ФизЛицо" Тогда
		ВывестиШапкуОрганизации(Контекст, Доверитель, Истина);	
	КонецЕсли;
	
КонецПроцедуры

//Типовая функция, вызываемая из процедуры "Печать" модуля объекта документа
Функция Объект_Печать_степ2(Объект, Контекст, ИмяМакета) Экспорт
	
	Если Объект.Ссылка.Пустая() Тогда 
		#Если Клиент Тогда
		Предупреждение("Документ можно распечатать только после его записи"); 
		#КонецЕсли
		Рез = Ложь;
		Перейти ~НаВыход;
	КонецЕсли;
	//TODO - Работа с диалогами для внешнего соединения?
	#Если Клиент И Сервер Тогда
	Если Не РаботаСДиалогами.ПроверитьМодифицированность(Объект) Тогда 
		Рез = Ложь;
		Перейти ~НаВыход;
	КонецЕсли;          
	#КонецЕсли
    Если ИмяМакета = "РазличияОтчета" Тогда
		 Рез = Объект.ПечатьРазличийОтчетаИОплат();
	КонецЕсли;
	//ИнициализироватьКонтекстПечати(Контекст);
	Контекст.ИмяМакета 	= ИмяМакета;
	Контекст.Объект 	= Объект;
	//ОбъектМетаданные 	= Объект.Метаданные();
	ИмяОбъекта = Контекст.ИмяОбъекта;
	Если Контекст.Отладка.Включена Тогда
		Сообщить("
		|>>>> Начало проверки " + ИмяМакета + " (" + Строка(Объект.Ссылка)+ ") >>>>>");
	КонецЕсли;
	отладка_Лог_НачалоПроцедуры(Контекст, "Объект_Печать_степ2 (Объект: '" + Строка(Объект.Ссылка) + "', Макет: '" + ИмяМакета + "')");	
	// Очищаем результрующий табличный документ при очередном вызове печати
	//!!!!!Контекст.ТабличныйДокумент = Новый ТабличныйДокумент;
	//TODO убрать этот код, предварительно исправив
	Если ИмяОбъекта = "уб_ОтчетПоставщику" Тогда
		Контекст.КоличествоЭкземпляров = 4;
		Контекст.АвтоУстанавливатьИмяПараметровПечати = Ложь;
		Контекст.ТабличныйДокумент.ИспользуемоеИмяФайла = ""+Формат(Объект.Номер,"ЧГ=")+"-"+уб_b2b.УбратьСимволы(Объект.НомерОтчетаПоставщику);
	ИначеЕсли ИмяОбъекта = "уб_ПередачаБСОПоставщику" Тогда
		Контекст.АвтоУстанавливатьИмяПараметровПечати = Ложь;
		Если Контекст.Объект.ВидОперации = Перечисления.уб_ВидыОперацииПередачиБСОвСК.ПередачаИспорченыхБСО Тогда
			Контекст.КоличествоЭкземпляров = 2;
		ИначеЕсли	Контекст.Объект.ВидОперации = Перечисления.уб_ВидыОперацииПередачиБСОвСК.ПередачаБСО Тогда
			Контекст.КоличествоЭкземпляров = 3;
		КонецЕсли;
	КонецЕсли;
	Если Контекст.СсылкаПФ = Неопределено Тогда
		СтрТабПФ = Контекст.ТабПФ.НайтиСтроки(Новый Структура("КодПФ", ИмяМакета));
		Если СтрТабПФ.Количество() = 0 Тогда 
			Сообщить("Печатная форма " + ИмяМакета + " не входит в состав меню печати и не будет напечатана", СтатусСообщения.Внимание);
			Рез = Ложь;
			Перейти ~НаВыход;
		КонецЕсли;
		СсылкаПФ = СтрТабПФ[0].СсылкаПФ;
		Контекст.СсылкаПФ = СсылкаПФ;
		Контекст.СтруктураОбъектаПФ = уб_ПФ.ПолучитьСтруктуруОбъектаПФИзСсылки(СсылкаПФ);//Контекст.ОбъектПФ = СсылкаПФ.ПолучитьОбъект();
	КонецЕсли;
	#Если Клиент Тогда
	Если Не Контекст.Отладка.Включена Тогда 
		ОчиститьСообщения(); 
	КонецЕсли;
	#КонецЕсли
	Если ПараметрыСеанса.уб_отладка_ПечататьТЕСТМакет Тогда
		ОтладкаПечати(Контекст);
		Рез = Истина;
		Перейти ~НаВыход;
	КонецЕсли;
	//TODO только для отчета поставщику форма истории
	Инициализировать_данными_КонтекстПечати(Контекст);
	Если ИмяОбъекта = "уб_Доверенности" Тогда
		Печать_Обратный_Вызов_3(Контекст)
	ИначеЕсли ИмяОбъекта = "уб_ЗаявкаНаПечать" Тогда
		ДобавитьДанныеЗаявкиНаПечать(Контекст);
	КонецЕсли;
	Рез = Истина;
	Перейти ~НаВыход;
~НаВыход:
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ОП_ПолучитьТЗОплат(Контекст, ТекущийПоставщик = Неопределено) Экспорт
	
	Объект = Контекст.Объект;
	//возвращает таблицу - список оплат, отсортированных по дате платежа
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	О.*,
	|	О.ПолнаяСтраховаяПремия КАК ПолнаяПремия,
	|	О.Дата КАК ДатаОплатыСтраховогоВзноса,
	|	О.СтраховойПолис.Номер КАК НомерПолиса,
	|	О.СтраховойПолис.Дата КАК ДатаОформленияПолиса,
	|	О.СтраховойПолис.ДатаНачала КАК НачалоДействияПолиса,
	|	О.СтраховойПолис.ДатаОкончания КАК ОкончаниеДействияПолиса,
	|	О.СтраховойПолис.Страхователь КАК Страхователь,
	|	О.СтраховойПолис.Страхователь.Наименование КАК НаименованиеСтрахователя,
	|	О.ВидСП КАК ВидСтраховогоПродукта,
	|	О.СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма,
	|	О.СтраховойПолис.Поставщик КАК СтраховойПолисПоставщик,
	|   Выбор Когда &Поставщик <> (ВЫРАЗИТЬ(&ПоставщикДляОтчетаПоКарточкам КАК Справочник.Контрагенты))
	|		Тогда ""ОтчетПоставщику""
	|       Иначе ""ОтчетПоКарточкам"" Конец Как ИмяРеквизитаОтбора
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|	И Выбор Когда &Поставщик <> (ВЫРАЗИТЬ(&ПоставщикДляОтчетаПоКарточкам КАК Справочник.Контрагенты))
	|		Тогда О.ОтчетПоставщику = &ОтчетПоставщику
	|       Иначе О.ОтчетПоКарточкам = &ОтчетПоставщику Конец			
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеСтрахователя,Дата";
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
		Запрос.УстановитьПараметр("ОтчетПоставщику", Неопределено)
	Иначе
		Запрос.УстановитьПараметр("ОтчетПоставщику", ?(Объект.ЭтоНовый(), Объект.ПолучитьСсылкуНового(), Объект.Ссылка));
	КонецЕсли;
	Запрос.УстановитьПараметр("Поставщик",?(текущийПоставщик = Неопределено, Объект.Поставщик, текущийПоставщик));
	ПоставщикДляОтчетаПоКарточкам = ПараметрыСеанса.уб_Константы.ПоставщикДляОтчетаПоКарточкам;
	Запрос.УстановитьПараметр("ПоставщикДляОтчетаПоКарточкам", ПоставщикДляОтчетаПоКарточкам);
	ТЗОплат = Запрос.Выполнить().Выгрузить();
	ИспользоватьФильтрФормаОплатыКасса = ПараметрыСеанса.уб_Константы.ФильтрВКассуДляСубагентскихПФ = Истина;
	МассивУдаляемыхСтрокТЗ = Новый Массив;
	Если Контекст.Свойство("ЭтоПФСубагент") И Контекст.ЭтоПФСубагент Тогда
		Для Каждого СтрокаТЗ Из ТЗОплат Цикл
			Если ИспользоватьФильтрФормаОплатыКасса	И СтрокаТЗ.ФормаОплаты <> Перечисления.уб_ФормыОплаты.Касса Тогда
				МассивУдаляемыхСтрокТЗ.Добавить(СтрокаТЗ);
			Иначе
				СтрокаТЗ.КВПроцентДляОтчета			= Контекст.ПроцентСубагента;
				СтрокаТЗ.КВСуммаДляОтчета 			= уб_РасчетыСМенеджерами.уб_ОКР(СтрокаТЗ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику * Контекст.ПроцентСубагента / 100, СтрокаТЗ.РазрядностьОкругления, СтрокаТЗ.РежимОкругления);
				СтрокаТЗ.Поставщик 					= Контекст.Объект.ОрганизацияАгент;
				СтрокаТЗ.ОрганизацияАгент   		= Контекст.Субагент;
				Если СтрокаТЗ.НачисленнаяСуммаВзноса = 0 Тогда
					СтрокаТЗ.Баланс_Брокер_Поставщик = СтрокаТЗ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику - СтрокаТЗ.КВСуммаДляОтчета - ?(СтрокаТЗ.НаправлениеПлатежа = Перечисления.уб_НаправленияПлатежа.ВБрокер, 0, СтрокаТЗ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого СтрокаТЗ Из МассивУдаляемыхСтрокТЗ Цикл
		ТЗОплат.Удалить(СтрокаТЗ);
	КонецЦикла;
	Возврат ТЗОплат;
	
КонецФункции

Функция ОП_ПолучитьТЗОплатИстории(Контекст, ТекущийПоставщик = Неопределено) Экспорт
	
	КонтекстТекущегоСостояния = КлонироватьКонтекст(Контекст);
	Если КонтекстТекущегоСостояния.Свойство("ЭтоИсторияОП") Тогда
		КонтекстТекущегоСостояния.ЭтоИсторияОП = Ложь;
	Иначе
		КонтекстТекущегоСостояния.Вставить("ЭтоИсторияОП",Ложь);
	КонецЕсли;	
	КонтекстТекущегоСостояния.ТЧДокумента = ПолучитьТЗизТЧдляПечати(КонтекстТекущегоСостояния);
	ДобавитьОбщиеПоказателиПечатныхФорм(КонтекстТекущегоСостояния);			
	
	Контекст.Вставить("ТабличнаяЧатьТекущегоСостоянияДокумента",КонтекстТекущегоСостояния.ТЧДокумента);
	
	ОплатыСписок = Контекст.ОплатыСписок;
	//возвращает таблицу - список оплат, отсортированных по дате платежа
	ТЗОплат = Новый ТаблицаЗначений;	
	ТЗОплат.Колонки.Добавить("Дата");	
	ТЗОплат.Колонки.Добавить("НомерВзноса");	
	ТЗОплат.Колонки.Добавить("ПолнаяСтраховаяПремия");
	ТЗОплат.Колонки.Добавить("СтраховойПолис");			
	ТЗОплат.Колонки.Добавить("Удалить");
	ТЗОплат.Колонки.Добавить("Добавить");
	ТЗОплат.Колонки.Добавить("Изменить");
	//ТЗОплат.Колонки.Добавить("ОплатаСсылка");
	МассивОплат = ОплатыСписок.ВыгрузитьКолонку("ОплатаСсылка");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|ГДЕ
	|	уб_ОплатаПолисов.Ссылка В(&МассивОплат)";
	Запрос.УстановитьПараметр("МассивОплат", МассивОплат);	
	//ТекущиеСостояниеОплат = Новый Соответствие;
	//		
	СписокРеквизитовОплаты = уб_ИсторияИзмененияОбъектов.ПолучитьСписокРеквизитов(Документы.уб_ОплатаПолисов.ПустаяСсылка()).Реквизиты;
	ВсегоРеквизитов = СписокРеквизитовОплаты.Количество();		
	
	//Удаляем отсутствующие в Источнике
	Колонки = ОплатыСписок.Колонки;
	Для Счетчик = 1 по ВсегоРеквизитов Цикл
		ТекРеквизит = СписокРеквизитовОплаты[ВсегоРеквизитов - Счетчик];
		Если ТекРеквизит.НаименованиеРеквизита = "СтраховойПолис" Тогда
			Продолжить;
		КонецЕсли;
		Если Колонки.Найти(ТекРеквизит.НаименованиеРеквизита) = Неопределено Тогда
			СписокРеквизитовОплаты.Удалить(ВсегоРеквизитов - Счетчик);
		КонецЕсли;
	КонецЦикла;
	
	ВсегоРеквизитов = СписокРеквизитовОплаты.Количество();
	
	ТаблицаТекущегоСостоянияОплат = Запрос.Выполнить().Выгрузить();
	//Для Каждого Выборка Из ТаблицаТекущегоСостоянияОплат Цикл
	//	СтуктураОплаты = Новый Структура;
	//	СтуктураОплаты.Вставить("Ссылка",Выборка.Ссылка);
	//	Для Каждого РеквизитОплаты Из СписокРеквизитовОплаты Цикл
	//		Если Не СтуктураОплаты.Свойство(РеквизитОплаты.НаименованиеРеквизита) Тогда
	//			СтуктураОплаты.Вставить(РеквизитОплаты.НаименованиеРеквизита,Выборка[РеквизитОплаты.НаименованиеРеквизита]);
	//		КонецЕсли;	
	//	КонецЦикла;
	//	ТекущиеСостояниеОплат.Вставить(Выборка.Ссылка,СтуктураОплаты);
	//КонецЦикла;	
	//Контекст.Вставить("ТекущиеСостояниеОплат",ТекущиеСостояниеОплат);
	
	
	//Создаем отсутствующие в получателе из таблицы текущего состояния оплат
	Колонки = ТЗОплат.Колонки;
	Для Каждого Колонка Из ТаблицаТекущегоСостоянияОплат.Колонки Цикл		
		Если Колонки.Найти(Колонка.Имя) = Неопределено Тогда			
			ТЗОплат.Колонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	//Создаем отсутствующие в получателе из списка реквизитов истории
	Для Счетчик = 1 по ВсегоРеквизитов Цикл
		ТекРеквизит = СписокРеквизитовОплаты[ВсегоРеквизитов - Счетчик];
		Если Колонки.Найти(ТекРеквизит.НаименованиеРеквизита) = Неопределено Тогда
			ТЗОплат.Колонки.Добавить(ТекРеквизит.НаименованиеРеквизита);
		КонецЕсли;
	КонецЦикла;
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	Для Каждого Оплата Из ОплатыСписок Цикл
		НоваяСтрока = ТЗОплат.Добавить();
		СтрокаТЗ = ТаблицаТекущегоСостоянияОплат.Найти(Оплата.ОплатаСсылка,"Ссылка");
		Если СтрокаТЗ <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЗ);
		КонецЕсли;
		НоваяСтрока.Удалить  = Оплата.Оформление.НайтиПоЗначению("Удалена") <> Неопределено;
		НоваяСтрока.Добавить = Оплата.Оформление.НайтиПоЗначению("Добавлена") <> Неопределено;
		НоваяСтрока.Изменить = Оплата.Оформление;
		//НоваяСтрока.ОплатаСсылка = Оплата.ОплатаСсылка;
							
		Для Каждого Реквизит Из СписокРеквизитовОплаты Цикл
			ДобавлятьВСтроку = Истина;
			Попытка
				Если Реквизит.НаименованиеРеквизита = "СтраховойПолис" Тогда
					ДобавлятьВСтроку = Ложь;
					НоваяСтрока["СтраховойПолис"] = Оплата["СтраховойПолисСсылка"];
				Иначе
					// TODO почему в строку не записываем форму оплаты (направление платежа по новой системе) ??
					Если СистемаНаправлениеПлатежа Тогда
						Если Реквизит.НаименованиеРеквизита = "НаправлениеПлатежа" Тогда
							ДобавлятьВСтроку = Ложь;
							Если Оплата[Реквизит.НаименованиеРеквизита] = Перечисления.уб_НаправленияПлатежа.ВБрокер Тогда
								НоваяСтрока["ВидОплаты"] = "В брокер";
							Иначе
								НоваяСтрока["ВидОплаты"] = "В СК";
							КонецЕсли;
						КонецЕсли;
					Иначе
						Если Реквизит.НаименованиеРеквизита = "ФормаОплаты" Тогда
							ДобавлятьВСтроку = Ложь;
							Если Оплата[Реквизит.НаименованиеРеквизита] = Перечисления.уб_ФормыОплаты.Касса ИЛИ Оплата[Реквизит.НаименованиеРеквизита] = Перечисления.уб_ФормыОплаты.Безнал Тогда
								НоваяСтрока["ВидОплаты"] = "В брокер";
							Иначе
								НоваяСтрока["ВидОплаты"] = "В СК";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					Если ДобавлятьВСтроку Тогда
						НоваяСтрока[Реквизит.НаименованиеРеквизита] = Оплата[Реквизит.НаименованиеРеквизита];
					КонецЕсли;
				КонецЕсли;
			Исключение
				Сообщить("Отладка! Не найден реквизит " + Реквизит.НаименованиеРеквизита);
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Возврат ТЗОплат;
	
КонецФункции

Функция ПолучитьИмяРевизитаОтбора(ЗначениеПоставщик) Экспорт
	
	Возврат ?(ЗначениеПоставщик = ПараметрыСеанса.уб_Константы.ПоставщикДляОтчетаПоКарточкам, "ОтчетПоКарточкам","ОтчетПоставщику")
	
КонецФункции

Функция ТЗизТЧ_ЗаявлениеВПолицию(Контекст)

	Объект = Контекст.Объект;
	//Подготовка таблицы значений для вывода	
	ТЗБСО = Объект.БСО.Выгрузить(); 
	ТЗБСО.Колонки.Добавить("НомерПолиса");
	ТЗБСО.Колонки.Добавить("ТекСостояниеБСО");
	ТЗБСО.Колонки.Добавить("ТекПоложениеБСО");
	ТЗБСО.Колонки.Добавить("Страхователь");
	ТЗБСО.Колонки.Добавить("РасшСтрахователь");
	ТЗБСО.Колонки.Добавить("ДатаОформленияПолиса");
	пСст = Перечисления.уб_СостоянияБСО;
	КоличествоСтрок	= ТЗБСО.Количество();
	Для Сч = 1 По КоличествоСтрок Цикл
		СтрокаТЧ = ТЗБСО[КоличествоСтрок - Сч];
		УдалятьСтроку = НЕ( ?(ЗначениеНеЗаполнено(Контекст.СтруктураОбъектаПФ.Поставщик), Истина, СтрокаТЧ.Поставщик = Контекст.СтруктураОбъектаПФ.Поставщик) И
			?(ЗначениеНеЗаполнено(Контекст.СтруктураОбъектаПФ.ОрганизацияАгент), Истина, СтрокаТЧ.ОрганизацияАгент = Контекст.СтруктураОбъектаПФ.ОрганизацияАгент) );
		Если УдалятьСтроку Тогда
			ТЗБСО.Удалить(ТЗБСО.Индекс(СтрокаТЧ));
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТЧ из ТЗБСО Цикл
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТекСтрока",СтрокаТЧ);
		СтруктураПараметров.Вставить("ТекСостояниеБСО",Неопределено);
		СтруктураПараметров.Вставить("НаДату",Объект.Дата);
		СтруктураПараметров.Вставить("тсАгент",Неопределено);
		СтруктураПараметров.Вставить("тсПоставщик",Неопределено);
		СтруктураПараметров.Вставить("тсОрганизацияАгент",Неопределено);
		СтруктураПараметров.Вставить("хВидГраницы",ВидГраницы.Исключая);
		СтруктураБСО = уб_СС.ПрочитатьТекущееСостояниеБСОПоСтрокеТЧ(СтруктураПараметров);
		//  СтрокаТЧ
		//, Неопределено
		//, Объект.Дата
		//, Неопределено
		//, Неопределено
		//, Неопределено
		////, ?(Проведен,ВидГраницы.Включая,ВидГраницы.Исключая));
		//, ВидГраницы.Исключая
		СтрокаТЧ.НомерПолиса 		= "";
		СтрокаТЧ.ТекСостояниеБСО	= "";
		СтрокаТЧ.ТекПоложениеБСО	= "";
		СтрокаТЧ.Страхователь 		= "";
		СтрокаТЧ.РасшСтрахователь 	= Неопределено;
		Если СтруктураБСО.КоличественныйУчет Тогда
			СтрокаТЧ.НомерБСО		= СокрЛП(Строка(СтрокаТЧ.Количество))+"шт.";
		Иначе
			СостояниеБСО = СтруктураБСО.СостояниеБСО;
			СтрокаТЧ.ТекСостояниеБСО = СостояниеБСО;
			СтрокаТЧ.ТекПоложениеБСО = СтруктураБСО.ПоложениеБСО;
			Если СтруктураБСО.НомернойУчет и СтруктураБСО.Существует Тогда				
				//Номер полиса выводим 
				//- для бланков БСО пролисов - всегда
			    //- для остальных бланков, если они в состоянии оформлен (и тогда к ним есть номер сопутствующего полиса)
				оСП = СтруктураБСО.СтраховойПолис;
				Если уб_СЛ.ОпределитьЭтоПолис(СтрокаТЧ.ВидБСО) ИЛИ  СостояниеБСО = пСст.Оформлен Тогда
					СтрокаТЧ.НомерПолиса = СокрЛП(СтруктураБСО.НомерПолиса);
				КонецЕсли;
								
				Если НЕ ЗначениеНеЗаполнено(оСП) И СостояниеБСО = пСст.Оформлен Тогда
					СтрокаТЧ.Страхователь			= Строка(оСП.Страхователь);
					СтрокаТЧ.РасшСтрахователь		= оСП;
					СтрокаТЧ.ДатаОформленияПолиса	= оСП.Дата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		
	ТЗБСО.Сортировать("Поставщик,ОрганизацияАгент,СК,ВидБСО,НомерБСО");	
	Возврат ТЗБСО;
	
КонецФункции // ТЗизТЧ_ЗаявлениеВПолицию()

Функция ТЗизТЧ_ПередачаБСОПоставщику(Контекст)

	Объект 		= Контекст.Объект;
	Дата		= Объект.Дата;
	Проведен	= Объект.Проведен;
	БСО			= Объект.БСО;
	//Подготовка таблицы значений для вывода
	ТЗБСО = БСО.Выгрузить(); 
	ТЗБСО.Колонки.Добавить("Состояние");
	ТЗБСО.Колонки.Добавить("Страхователь");
	ТЗБСО.Колонки.Добавить("РасшСтрахователь");
	ТЗБСО.Колонки.Добавить("ДатаОформленияПолиса");
	пСст = Перечисления.уб_СостоянияБСО;	
	Для Каждого СтрокаТЧ из ТЗБСО Цикл
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТекСтрока",СтрокаТЧ);
		СтруктураПараметров.Вставить("НаДату",Дата);
		СтруктураПараметров.Вставить("хВидГраницы",?(Проведен,ВидГраницы.Включая,ВидГраницы.Исключая));
		СтруктураБСО = уб_СС.ПрочитатьТекущееСостояниеБСОПоСтрокеТЧ(СтруктураПараметров);
		//  СтрокаТЧ
		//, Неопределено
		//, Дата
		//, Неопределено
		//, Неопределено
		//, Неопределено
		//, ?(Проведен,ВидГраницы.Включая,ВидГраницы.Исключая)		
		СтрокаТЧ.НомерПолиса 		= "";
		СтрокаТЧ.Состояние	 		= "";
		СтрокаТЧ.Страхователь 		= "";
		СтрокаТЧ.РасшСтрахователь 	= Неопределено;		
		Если СтруктураБСО.КоличественныйУчет Тогда
			СтрокаТЧ.НомерБСО		= СокрЛП(Строка(СтрокаТЧ.Количество))+"шт.";
		Иначе			
			СостояниеБСО = ?(ЗначениеНеЗаполнено(СтрокаТЧ.СостояниеБСО),СтруктураБСО.СостояниеБСО,СтрокаТЧ.СостояниеБСО);
			Если ЛОЖЬ
				или СостояниеБСО = пСст.ПустойБланк
				или СостояниеБСО = пСст.НеиспользованныйБланк
				или СостояниеБСО = пСст.НеПолностьюОформлен
			Тогда
				Сст = "Не использован";
			ИначеЕсли ЛОЖЬ
				или СостояниеБСО = пСст.НедействующийБланк
			Тогда
				Сст = "Не действующий бланк";
			ИначеЕсли ЛОЖЬ
				или СостояниеБСО = пСст.НеполныйБланк
			Тогда
				Сст = "Неполный бланк";
			ИначеЕсли ЛОЖЬ
				или СостояниеБСО = пСст.Оформлен
				или СостояниеБСО = пСст.НеПравильноОформлен
			Тогда
				Сст = "Оформлен";
			ИначеЕсли ЛОЖЬ
				или СостояниеБСО = пСст.Утрачен
				или СостояниеБСО = пСст.Уничтожен
				или СостояниеБСО = пСст.Украден
			Тогда
				Сст = "Утрачен";
			ИначеЕсли ЛОЖЬ
				или СостояниеБСО = пСст.Испорчен
			Тогда
				Сст = "Испорчен";
			Иначе 
				Сст = СтруктураБСО.cСостояниеБСО;
			КонецЕсли;			
			СтрокаТЧ.Состояние 	= Сст;			
			Если СтруктураБСО.НомернойУчет и СтруктураБСО.Существует Тогда
				//Номер полиса выводим 
				//- для бланков БСО пролисов - всегда
			    //- для остальных бланков, если они в состоянии оформлен (и тогда к ним есть номер сопутствующего полиса)
				оСП = СтруктураБСО.СтраховойПолис;
				Если уб_СЛ.ОпределитьЭтоПолис(СтрокаТЧ.ВидБСО) ИЛИ  Сст = "Оформлен" Тогда
					СтрокаТЧ.НомерПолиса 		  = СокрЛП(СтруктураБСО.НомерПолиса);
				КонецЕсли;								
				Если НЕ ЗначениеНеЗаполнено(оСП) И Сст = "Оформлен" Тогда
					СтрокаТЧ.Страхователь		  = Строка(оСП.Страхователь.Наименование);
					СтрокаТЧ.РасшСтрахователь	  = оСП;
					СтрокаТЧ.ДатаОформленияПолиса = оСП.Дата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ТЗБСО;	

КонецФункции // ТЗизТЧ_ПередачаБСОПоставщику()

Функция ТЗизТЧ_Типовая(Контекст)

	Если ЗначениеЗаполнено(Контекст.МассивОбъектов) Тогда 
		Массив = Контекст.МассивОбъектов;
	Иначе
		Массив = Новый Массив;
		Массив.Добавить(Контекст.Объект);
	КонецЕсли;
	
	//Подготовка таблицы значений для вывода	
	Попытка
		БСО = Массив[0].БСО
	Исключение
		//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не найдена ТЧ БСО у документа: " + ?(Объект = Неопределено, "Неопределено", Объект.Метаданные()));
		Возврат Неопределено;
	КонецПопытки;
	ТЗБСО = БСО.Выгрузить(); 
	ТЗБСО.Колонки.Добавить("НомерПолиса");
	ТЗБСО.Колонки.Добавить("ТекСостояниеБСО");
	ТЗБСО.Колонки.Добавить("ТекПоложениеБСО");
	ТЗБСО.Колонки.Добавить("Страхователь");
	ТЗБСО.Колонки.Добавить("РасшСтрахователь");
	ТЗБСО.Колонки.Добавить("ДатаОформленияПолиса");
	ТЗБСО.Колонки.Добавить("Документ");
	ТЗБСО.Очистить();
	пСст = Перечисления.уб_СостоянияБСО;
	
	Для Каждого СтрокаМассива ИЗ Массив Цикл 
		мТЗБСО = СтрокаМассива.БСО.Выгрузить(); 
		мТЗБСО.Колонки.Добавить("НомерПолиса");
		мТЗБСО.Колонки.Добавить("ТекСостояниеБСО");
		мТЗБСО.Колонки.Добавить("ТекПоложениеБСО");
		мТЗБСО.Колонки.Добавить("Страхователь");
		мТЗБСО.Колонки.Добавить("РасшСтрахователь");
		мТЗБСО.Колонки.Добавить("ДатаОформленияПолиса");
		мТЗБСО.Колонки.Добавить("Документ");
		КоличествоСтрок	= мТЗБСО.Количество();
		Для Сч = 1 По КоличествоСтрок Цикл
			СтрокаТЧ = мТЗБСО[КоличествоСтрок - Сч];
			УдалятьСтроку = НЕ( ?(ЗначениеНеЗаполнено(Контекст.СтруктураОбъектаПФ.Поставщик), Истина, СтрокаТЧ.Поставщик = Контекст.СтруктураОбъектаПФ.Поставщик) И 
			?(ЗначениеНеЗаполнено(Контекст.СтруктураОбъектаПФ.ОрганизацияАгент), Истина, СтрокаТЧ.ОрганизацияАгент = Контекст.СтруктураОбъектаПФ.ОрганизацияАгент) );
			Если УдалятьСтроку Тогда
				мТЗБСО.Удалить(мТЗБСО.Индекс(СтрокаТЧ));
			КонецЕсли; 		
		КонецЦикла;	
		Для Каждого СтрокаТЧ из мТЗБСО Цикл
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ТекСтрока",СтрокаТЧ);
			СтруктураПараметров.Вставить("НаДату",СтрокаМассива.Дата);
			СтруктураПараметров.Вставить("хВидГраницы",?(СтрокаМассива.Проведен,ВидГраницы.Включая,ВидГраницы.Исключая));
			СтруктураБСО = уб_СС.ПрочитатьТекущееСостояниеБСОПоСтрокеТЧ(СтруктураПараметров);
			//  СтрокаТЧ
			//, Неопределено
			//, Объект.Дата
			//, Неопределено
			//, Неопределено
			//, Неопределено
			//, ?(Объект.Проведен,ВидГраницы.Включая,ВидГраницы.Исключая)
			СтрокаТЧ.НомерПолиса 		= "";
			СтрокаТЧ.ТекСостояниеБСО	= "";
			СтрокаТЧ.ТекПоложениеБСО	= "";
			СтрокаТЧ.Страхователь 		= "";
			СтрокаТЧ.РасшСтрахователь 	= Неопределено;
			СтрокаТЧ.Документ           = СтрокаМассива.Ссылка;
			Если СтруктураБСО.КоличественныйУчет Тогда
				СтрокаТЧ.НомерБСО		= СокрЛП(Строка(СтрокаТЧ.Количество))+"шт.";
			Иначе
				СостояниеБСО = СтруктураБСО.СостояниеБСО;
				СтрокаТЧ.ТекСостояниеБСО = СостояниеБСО;
				СтрокаТЧ.ТекПоложениеБСО = СтруктураБСО.ПоложениеБСО;
				Если СтруктураБСО.НомернойУчет и СтруктураБСО.Существует Тогда
					//Номер полиса выводим 
					//- для бланков БСО пролисов - всегда
					//- для остальных бланков, если они в состоянии оформлен (и тогда к ним есть номер сопутствующего полиса)
					оСП = СтруктураБСО.СтраховойПолис;
					Если уб_СЛ.ОпределитьЭтоПолис(СтрокаТЧ.ВидБСО) ИЛИ  СостояниеБСО = пСст.Оформлен Тогда
						СтрокаТЧ.НомерПолиса = СокрЛП(СтруктураБСО.НомерПолиса);
					КонецЕсли;
					Если НЕ ЗначениеНеЗаполнено(оСП) И СостояниеБСО = пСст.Оформлен Тогда
						СтрокаТЧ.Страхователь			= Строка(оСП.Страхователь);
						СтрокаТЧ.РасшСтрахователь		= оСП;
						СтрокаТЧ.ДатаОформленияПолиса	= оСП.Дата;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого мСтрока Из мТЗБСО Цикл 
			Строка = ТЗБСО.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, мСтрока);
		КонецЦикла;
		
	КонецЦикла;

	ТЗБСО.Сортировать("СК,ВидБСО,НомерБСО");
	Возврат ТЗБСО;

КонецФункции // ТзизТЧ_Типовая()

Функция ТЗизТЧ_ПоступлениеБСО(Контекст) Экспорт
	
	Объект 	= Контекст.Объект;
	Ссылка 	= Объект.Ссылка;
	БСО		= Объект.БСО;
	//Подготовка таблицы значений для вывода
	ТЗБСО = Новый ТаблицаЗначений;
	ТЗБСО.Колонки.Добавить("СК");
	ТЗБСО.Колонки.Добавить("ВидБСО");
	ТЗБСО.Колонки.Добавить("НомерБСО");
	ТЗБСО.Колонки.Добавить("Количество");
	ТЗБСО.Колонки.Добавить("НомерПолиса");
	ТЗБСО.Колонки.Добавить("ГодПолиса");
	Для Каждого СтрокаТЧ Из БСО Цикл
		Если уб_СЛ.ОпределитьВедетсяНомернойУчет(СтрокаТЧ.ВидБСО) 
			И НЕ ЗначениеНеЗаполнено(СокрЛП(СтрокаТЧ.НачНомерБСО)) Тогда
			// ДВИЖЕНИЯ ДЛЯ БСО НОМЕРНОГО УЧЕТА
			сНачНомерБСО = СтрокаТЧ.НачНомерБСО;
			сКонНомерБСО = СтрокаТЧ.КонНомерБСО;
			сНачНомерСП = СтрокаТЧ.НачНомерПолиса;
			сКонНомерСП = СтрокаТЧ.КонНомерПолиса;
			КолличествоБСО = СтрокаТЧ.КоличествоБСО;
			КолличествоСП = СтрокаТЧ.КоличествоПолисов;
			чНомерБСО = Число2(сНачНомерБСО);
			чНомерСП = Число2(сНачНомерСП);
			МаксДлинаНомераБСО  = Макс(СтрДлина(сНачНомерБСО),СтрДлина(сКонНомерБСО));
			МаксДлинаНомераСП  = Макс(СтрДлина(сНачНомерСП),СтрДлина(сКонНомерСП));
			Если КолличествоСП > 1 И Число2(сНачНомерСП) > Число2(сКонНомерСП) Тогда
				Дельта = -1; //Обратная нумерация полисов
			Иначе	 
				Дельта = 1; //Прямая нумерация полисов
			КонецЕсли;
			Для N=0 По КолличествоБСО - 1 Цикл
				сНомерБСО = Формат(чНомерБСО,"ЧГ=");
				сНомерСП = Формат(чНомерСП,"ЧГ=");
				уб_СтраховойБрокер.ДобавитьНулиСлева(сНомерБСО, МаксДлинаНомераБСО);
				уб_СтраховойБрокер.ДобавитьНулиСлева(сНомерСП, МаксДлинаНомераСП);
				СерияБСО = СокрЛП(СтрокаТЧ.СерияБСО);
				СерияСП = СокрЛП(СтрокаТЧ.СерияПолиса);
				СуффиксСП = СокрЛП(СтрокаТЧ.СуффиксПолиса);
				ПолныйНомерБСО = СерияБСО + сНомерБСО;
				СтрБСОклон = ТЗБСО.Добавить();
				СтрБСОклон.СК 					= СтрокаТЧ.СК;
				СтрБСОклон.ВидБСО				= СтрокаТЧ.ВидБСО;
				СтрБСОклон.НомерБСО 			= ПолныйНомерБСО;
				СтрБСОклон.Количество			= 1;
				Если КолличествоСП > 0 Тогда
					СтрБСОклон.НомерПолиса		= СерияСП + сНомерСП + СуффиксСП;
					СтрБСОклон.ГодПолиса		= СтрокаТЧ.ГодПолиса;
				КонецЕсли;
				чНомерБСО = чНомерБСО + 1;
				чНомерСП = чНомерСП + Дельта;
			КонецЦикла;
		ИначеЕсли Ссылка.Проведен И уб_СЛ.ОпределитьВедетсяКоличественныйУчет(СтрокаТЧ.ВидБСО) Тогда
			// ДВИЖЕНИЯ ДЛЯ БСО КОЛИЧЕСТВЕННОГО УЧЕТА
			//  увеличиваем количество, куда перемещается
			СтрБСОклон = ТЗБСО.Добавить();
			СтрБСОклон.СК 			= СтрокаТЧ.СК;
			СтрБСОклон.ВидБСО		= СтрокаТЧ.ВидБСО;
			СтрБСОклон.Количество	= СтрокаТЧ.КоличествоБСО;
		КонецЕсли;
	КонецЦикла;
	Возврат ТЗБСО;
	
КонецФункции

Функция ТЗизТЧ_УведомлениеОДосрочномПрекращенииДействияДоговора(Контекст)

	Объект = Контекст.Объект;
	Ссылка = Объект.Ссылка;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УДП.Менеджер КАК Менеджер,
	|	УДП.Причина КАК Причина,
	|	УДП.ПричинаДляСК,
	|	УДП.УведомленУстно КАК УведомленУстно,
	|	УДП.УведомленEmail КАК УведомленEmail,
	|	УДП.СозданНаОсновании.СтраховойПродукт КАК СтраховойПродукт,
	|	УДП.СозданНаОсновании.ОрганизацияАгент КАК ОрганизацияАгент,
	|	УДП.СозданНаОсновании.ОбъектСтрахования,
	|	УДП.СозданНаОсновании.СК КАК СК,
	|	УДП.СозданНаОсновании.РассрочкаПлатежа КАК Рассрочка,
	|	УДП.СозданНаОсновании.Страхователь КАК Страхователь,
	|	УДП.СозданНаОсновании.Номер КАК Номер,
	|	УДП.СозданНаОсновании.Платежи.(
	|		Ссылка,
	|		НомерСтроки,
	|		Дата КАК Дата,
	|		Сумма КАК Сумма
	|	) КАК Платежи,
	|	УДП.СозданНаОсновании.ДатаНачала КАК ДатаНачалаДействия,
	|	УДП.СозданНаОсновании КАК СтраховойПолис,
	|	УДП.СозданНаОсновании.СтраховаяПремия КАК СтраховаяПремия,
	|	УДП.Дата КАК Дата,
	|	0 КАК ДатаОчередногоПлатежа,
	|	1 КАК НомерВзноса,
	|	0 КАК СуммаОчередногоПлатежа
	|ИЗ
	|	Документ.уб_УведомлениеОДосрочномПрекращенииДействияДоговора КАК УДП
	|ГДЕ
	|	УДП.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаОчередногоПлатежа  = "";
		СуммаОчередногоПлатежа = 0;
		ТзОплат = уб_СС.ОП_ПолучитьТзОплат(Выборка.СтраховойПолис);
		лАктуальныйПериод= Выборка.Дата;
		Если ТзОплат.Количество() = 0 Тогда
			НомерВзноса_ =  1;
		Иначе
			НомерВзноса_ = 0;
			Для Каждого оОплата из ТзОплат Цикл
				НомерВзноса_ = НомерВзноса_ + 1;
				Если лАктуальныйПериод < оОплата.Дата Тогда
					НомерВзноса_ = НомерВзноса_ - 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ИтогоОплачено = ТзОплат.Итог("НачисленнаяСуммаВзноса");		
		ОсталосьОплатить = Выборка.СтраховаяПремия-ИтогоОплачено;
		ВыборкаПлатежей = Выборка.Платежи.Выбрать();
		ТаблицаПлатежей = Новый ТаблицаЗначений;
		ТаблицаПлатежей.Колонки.Добавить("Дата");
		ТаблицаПлатежей.Колонки.Добавить("Сумма");
		Пока ВыборкаПлатежей.Следующий() Цикл
			СтрокаПлатежа      = ТаблицаПлатежей.Добавить();
			СтрокаПлатежа.Дата = ВыборкаПлатежей.Дата;
			СтрокаПлатежа.Сумма = ВыборкаПлатежей.Сумма;
		КонецЦикла;	
		СтрокаТЗ = ТЗ[0];
		ТаблицаПлатежей.Сортировать("Дата");
		ИтогоПлатежей = ТаблицаПлатежей.Итог("Сумма");
		Если ИтогоПлатежей <= 0 Тогда
			СуммаОчередногоПлатежа = ОсталосьОплатить;
			ДатаОчередногоПлатежа  = "";
		ИначеЕсли ИтогоПлатежей = ИтогоОплачено Тогда
			СуммаОчередногоПлатежа = ОсталосьОплатить;
			ДатаОчередногоПлатежа  = "";
		ИначеЕсли ИтогоПлатежей > ИтогоОплачено Тогда
			РаспределеноОплат = 0;
			НомерСтроки = 0;
			ДатаОчередногоПлатежа  = "";
			Для каждого СтрокаПлатежа из ТаблицаПлатежей Цикл
				НомерСтроки = НомерСтроки + 1;
				РаспределеноОплат = РаспределеноОплат + СтрокаПлатежа.Сумма;
				Если РаспределеноОплат > ИтогоОплачено Тогда
					СуммаОчередногоПлатежа = РаспределеноОплат - ИтогоОплачено;
					ДатаОчередногоПлатежа  = СтрокаПлатежа.Дата;
					НомерВзноса_ = НомерСтроки;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		СтрокаТЗ.НомерВзноса = НомерВзноса_;
		СтрокаТЗ.ДатаОчередногоПлатежа = ДатаОчередногоПлатежа;
		СтрокаТЗ.СуммаОчередногоПлатежа = СуммаОчередногоПлатежа;
	КонецЦикла;
	Возврат ТЗ;

КонецФункции // ТЗизТЧ_УведомлениеОДосрочномПрекращенииДействияДоговора()

Функция ТЗизТЧ_ТабельУчетаРабочегоВремени(Контекст)

	Объект = Контекст.Объект;
	Ссылка = Объект.Ссылка;
	ЭтоДокумент = ТипЗнч(Ссылка) = Тип("ДокументСсылка.уб_ТабельУчетаРабочегоВремени");
	Если ЭтоДокумент Тогда
		ВсегоДней = День(КонецМесяца(Ссылка.РасчетныйПериод));
		ТаблицаЗанятости = Ссылка.Занятость.Выгрузить();
	Иначе
		ВсегоДней = День(КонецМесяца(Ссылка));
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Табель.Ссылка,
		|	Табель.НомерСтроки,
		|	Табель.Сотрудник,
		|	Табель.Подразделение,
		|	Табель.НомерДня,
		|	Табель.ВидЗанятости,
		|	Табель.Часов
		|ИЗ
		|	Документ.уб_ТабельУчетаРабочегоВремени.Занятость КАК Табель
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(Табель.Ссылка.Дата, МЕСЯЦ) = &РасчетныйПериод");
		Запрос.УстановитьПараметр("РасчетныйПериод",НачалоМесяца(Ссылка));					  
		ТаблицаЗанятости = Запрос.Выполнить().Выгрузить();
	Конецесли;	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сотрудник");
	ТЗ.Колонки.Добавить("Подразделение");
	Для Счетчик = 1 по ВсегоДней Цикл
		ТЗ.Колонки.Добавить("День"+Счетчик);
	КонецЦикла;	
	ТЗ.Колонки.Добавить("ВсегоДней");
	ТЗ.Колонки.Добавить("ВсегоЧасов");
	ТекСтрока = Неопределено;
	Для каждого Строка Из ТаблицаЗанятости Цикл
		ТекСтрока = Документы.уб_ТабельУчетаРабочегоВремени.ПолучитьСтрокуСотрудника(ТЗ,Строка,ТекСтрока);
		ТекСтрока["День"+Строка.НомерДня]=""+Строка.ВидЗанятости+?(Строка.Часов=0,"",""+Строка.Часов);
	КонецЦикла;		
	Для каждого СтрокаТабеля из ТЗ Цикл
		Документы.уб_ТабельУчетаРабочегоВремени.ОбновитьДниЧасыПоСтроке(СтрокаТабеля,Документы.уб_ТабельУчетаРабочегоВремени.ПустаяСсылка(),ВсегоДней);
	КонецЦикла;	
    Возврат ТЗ;

КонецФункции // ТЗизТЧ_ТабельУчетаРабочегоВремени()

