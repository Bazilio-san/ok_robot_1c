	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Обычное Тогда
		чСтатус = 2; //>
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - пусто
	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Внимание Тогда
		чСтатус = 3; //!
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - (### Ошибка! ###)
	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Важное Тогда
		чСтатус = 4; //!!
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - (### Ошибка! ###)
	//в режиме отладки - ###########
	// + ОписаниеОшибки
	ИначеЕсли Статус = СтатусСообщения.ОченьВажное Тогда
		чСтатус = 5; //!!!
	КонецЕсли;	
	Контекст.Отладка.МаксСтатусОшибкиПриЗаполненииПараметра = Макс(Контекст.Отладка.МаксСтатусОшибкиПриЗаполненииПараметра, чСтатус);
	Если НЕ Контекст.Отладка.Включена Тогда
		Возврат;	
	КонецЕсли;	
	//Случай вызова не из процедуры заполнения параметров макета
	Если Контекст.Отладка.ТекущаяСтрокаПараметра = Неопределено Тогда
