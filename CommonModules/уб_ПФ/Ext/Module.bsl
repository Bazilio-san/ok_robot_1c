Функция ПолучитьСтруктуруИтоговСтрокиТЧ_ОтчетаПоставщику(Контекст) Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПолучитьСтруктуруИтоговСтрокиТЧ_ОтчетаПоставщику");	
	Ч15_4 = ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15,4);
	ТЗ = ПолучитьСтруктуруИтогов_Общее(Контекст).Владелец();
	ДобавитьСвойствоВТЗ(ТЗ, "КВСумма",											Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "ПолнаяПремия",										Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "НачисленнаяСуммаВзноса",							Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "КВСуммаДляОтчета",									Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику",	Ч15_4, 0);
	//ДобавитьСвойствоВТЗ(ТЗ, "СуммаУдержаннаяАгентом",							Ч15_4);
	ДобавитьСвойствоВТЗ(ТЗ, "Баланс_Брокер_Поставщик",							Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "СуммаКПеречислениюАгенту",							Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "СуммаКПеречислениюПоставщику",						Ч15_4, 0);
	ДобавитьСвойствоВТЗ(ТЗ, "ЭтоДоговорСУдержаниемКВ", Новый ОписаниеТипов("Булево"));
    //--------------------------
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Контекст.Контейнер_Итоги;
	
КонецФункции

//// 2-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в ТЧ отчета Поставщику:
// ПечатьСтроки - Вывести область "Строка" на печать или нет
Процедура ПСП_ТЧ_ОП(Контекст, ИмяОбластиШапка = "ШапкаТаб", ИмяОбластиСтрока = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_ТЧ_ОП (Область шапки: '" + ИмяОбластиШапка + "', Область строки: '" + ИмяОбластиСтрока + "')");	
	
	ТабДок = Контекст.ТабличныйДокумент;
	Макет = Контекст.Макет;
	Объект = Контекст.Объект;	
	ТЗ_ТЧДокумента = Контекст.ТЧДокумента;	
	ПСП(Контекст, ИмяОбластиШапка, Контекст.Предупреждать);
	
	//Указываем, какую строку повторять на каждой странице при печати	
	ОблШапкаТаб = ТабДок.Области.Найти(ИмяОбластиШапка);
	Если ОблШапкаТаб <> Неопределено Тогда
		Если Контекст.ПовторятьШапкуТаблицыПриПечати Тогда
			ВерхняяГраница = ОблШапкаТаб.Верх;
			НижняяГраница = ОблШапкаТаб.Низ;
			Если Контекст.КоличествоСтрокПовторенияШапкиТЧ < 1 Тогда
				ОбластьПовторения = ОблШапкаТаб;
			Иначе
				ВыводитьВверхДо = Макс(ВерхняяГраница, НижняяГраница - Контекст.КоличествоСтрокПовторенияШапкиТЧ + 1);
				ОбластьПовторения = ТабДок.Область("R"+ВыводитьВверхДо+":R" + НижняяГраница);
			КонецЕсли;
			ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовторения;
		КонецЕсли;
		Если Контекст.ФиксацияСверху Тогда
			ТабДок.ФиксацияСверху = ОблШапкаТаб.Низ;	
		КонецЕсли;
	КонецЕсли;
	Итоги = ПолучитьСтруктуруИтоговСтрокиТЧ_ОтчетаПоставщику(Контекст);	
	Если Контекст.ЭтоПФСубагент Тогда
		Итоги.ЭтоДоговорСУдержаниемКВ = Истина;
	Иначе
		Итоги.ЭтоДоговорСУдержаниемКВ = уб_СС.ОпределитьЭтоРасчетСУдержаниемКВ(Объект.Поставщик, Объект.ОрганизацияАгент, Объект.Дата, Ложь);
	КонецЕсли;
	Сортировка = "";	
	//не нужна попытка
	ОбластьГруппаСК = Макет.Области.Найти("ГруппаСК");
	Если ОбластьГруппаСК = Неопределено Тогда
		бОбрабатыватьГруппуСК = Ложь
	Иначе
		ОбластьМакета_ГруппаСК = Макет.ПолучитьОбласть("ГруппаСК");
		бОбрабатыватьГруппуСК = Истина;
		Если Контекст.ТЧДокумента.Колонки.Найти("СК") <> Неопределено Тогда
			Сортировка = "СК";
		КонецЕсли;
	КонецЕсли;
	ОбластьГруппаВидаСП = Макет.Области.Найти("ГруппаВидаСП");
	Если ОбластьГруппаВидаСП = Неопределено Тогда
		бОбрабатыватьГруппуВидаСП = Ложь
	Иначе
		ОбластьМакета_ГруппаВидаСП = Макет.ПолучитьОбласть("ГруппаВидаСП");
		бОбрабатыватьГруппуВидаСП = Истина;	
		Если Контекст.ТЧДокумента.Колонки.Найти("ВидСтраховогоПродукта") <> Неопределено Тогда
			Сортировка = Сортировка + ?(Сортировка = "","",",") + "ВидСтраховогоПродукта";
		КонецЕсли;	
	КонецЕсли;
	ОбластьГруппаСП = Макет.Области.Найти("ГруппаСП");
	Если ОбластьГруппаСП = Неопределено Тогда
		бОбрабатыватьГруппуСП = Ложь
	Иначе
		ОбластьМакета_ГруппаСП = Макет.ПолучитьОбласть("ГруппаСП");
		бОбрабатыватьГруппуСП = Истина;	
		Если Контекст.ТЧДокумента.Колонки.Найти("СтраховойПродукт") <> Неопределено Тогда
			Сортировка = Сортировка + ?(Сортировка = "","",",") + "СтраховойПродукт";
		КонецЕсли;
	КонецЕсли;
	Если Контекст.ТЧДокумента.Колонки.Найти("ДатаОплатыСтраховогоВзноса") <> Неопределено Тогда
		Сортировка = Сортировка + ?(Сортировка = "","",",ДатаОплатыСтраховогоВзноса");
	КонецЕсли;	
	Если Сортировка <> "" Тогда
		Контекст.ТЧДокумента.Сортировать(Сортировка);
	КонецЕсли;	
	//Добавим в TЗ производные колонки, что бы испоользовать их (единообразно) как свойства контейнера при заполнении параметров 
	Ч15_2 = ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15,2);	
	//Колонки = ТЗ_ТЧДокумента.Колонки; 
	//ДобавитьСвойствоВТЗ(ТЗ_ТЧДокумента, "СуммаУдержаннаяАгентом",		Ч15_2);
	ДобавитьСвойствоВТЗ(ТЗ_ТЧДокумента, "СуммаКПеречислениюАгенту",		Ч15_2);
	ДобавитьСвойствоВТЗ(ТЗ_ТЧДокумента, "СуммаКПеречислениюПоставщику",	Ч15_2);
	//>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
	// Иттерации заполнения строк шаблона 
	СчетчикСтрок = 1;
	ВсегоСтрок = ТЗ_ТЧДокумента.Количество();
	Для Каждого СтрокаТЧ Из ТЗ_ТЧДокумента Цикл
		Если Контекст.Отладка.Групповая И Контекст.Контейнер_Итоги.НомерТекущейСтроки >= Контекст.Отладка.МаксКоличествоСтрокТЧ Тогда
			Прервать;	
		КонецЕсли;
		Если бОбрабатыватьГруппуСК Тогда
			Если Итоги.ТекущаяСК <> СтрокаТЧ.СК Тогда
				ОбластьМакета_ГруппаСК.Параметры.СК = Строка(СтрокаТЧ.СК);	
				ТабДок.Вывести(ОбластьМакета_ГруппаСК);				
				Если бОбрабатыватьГруппуВидаСП Тогда
					Итоги.ТекущийВидСП = Неопределено; //Для того, что бы после смены СК всегда выводилась группировка ВидаСП
				КонецЕсли;				
			КонецЕсли;
			Итоги.ТекущаяСК = СтрокаТЧ.СК;
		КонецЕсли;		
		Если бОбрабатыватьГруппуВидаСП Тогда
			Если Итоги.ТекущийВидСП <> СтрокаТЧ.ВидСтраховогоПродукта Тогда
				ОбластьМакета_ГруппаВидаСП.Параметры.ВидСтраховогоПродукта = Строка(СтрокаТЧ.ВидСтраховогоПродукта);	
				ТабДок.Вывести(ОбластьМакета_ГруппаВидаСП);
			КонецЕсли;
			Итоги.ТекущийВидСП = СтрокаТЧ.ВидСтраховогоПродукта;
		КонецЕсли;
		Если бОбрабатыватьГруппуСП Тогда
			Если Итоги.ТекущийСтраховойПродукт <> СтрокаТЧ.СтраховойПродукт Тогда
				ОбластьМакета_ГруппаСП.Параметры.СтраховойПродукт = Строка(СтрокаТЧ.СтраховойПродукт);	
				ТабДок.Вывести(ОбластьМакета_ГруппаСП);
			КонецЕсли;
			Итоги.ТекущийСтраховойПродукт = СтрокаТЧ.СтраховойПродукт;
		КонецЕсли;		
		УстановитьТекущийКонтейнер(Контекст,"СтрокаТЧ",СтрокаТЧ);
		#Если Клиент Тогда
		Состояние("Вывод строки " + СчетчикСтрок + " из " + ВсегоСтрок);
		СчетчикСтрок = СчетчикСтрок + 1;
		#КонецЕсли
		
		ПСП_СтрокиТЧ_ОП(Контекст, ИмяОбластиСтрока);	
	КонецЦикла;
	
	#Если Клиент Тогда
		Состояние("Вывод подвала печатной формы");
	#КонецЕсли
	
	Если Итоги.Баланс_Брокер_Поставщик >= 0 Тогда
		Итоги.СуммаКПеречислениюАгенту = 0;
		Итоги.СуммаКПеречислениюПоставщику = Итоги.Баланс_Брокер_Поставщик;
	Иначе
		Итоги.СуммаКПеречислениюАгенту = - Итоги.Баланс_Брокер_Поставщик;
		Итоги.СуммаКПеречислениюПоставщику = 0;
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры	

//// 3-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в СТРОКЕ ТЧ отчета Поставщику:
//1.1 		НомерСтроки
//2.1 Страхователь
//3.1 НомерПолиса
//3.2 НомерБСО
//3.3 НомерКвитанции
//4.1 ДатаОформленияПолиса
//4.2 ДатаОформленияПолиса_Кратко
//5.1 НачалоДействияПолиса
//5.2 НачалоДействияПолиса_Кратко
//6.1 ОкончаниеДействияПолиса
//6.2 ОкончаниеДействияПолиса_Кратко
//7.1 ПолнаяПремия
//7.2 СтраховаяСумма
//8.1 НачисленнаяСуммаВзноса
//8.2 НачисленнаяСуммаВзносаВВалюте
//8.3 Валюта
//8.4 Курс
//9.1 КВПроцентДляОтчета
//9.2 КВСуммаДляОтчета
//10.1 ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
//11.1 СуммаУдержаннаяАгентом
//12.1 Баланс_Брокер_Поставщик
//13.1 СуммаКПеречислениюАгенту
//14.1 СуммаКПеречислениюПоставщику
//15.1 ДатаОплатыСтраховогоВзноса
//15.2 ДатаОплатыСтраховогоВзноса_Кратко
//16.1 ПризнакПлатежа
//17.1 ВидСтраховогоПродукта
//17.2 СтраховойПродукт
//18.1 ПлатежныйДокумент_Номер
//18.2 ПлатежныйДокумент_Дата
Процедура ПСП_СтрокиТЧ_ОП(Контекст, ИмяОбласти = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_СтрокиТЧ_ОП (Область: '" + ИмяОбласти + "')");
	Область_Строка = ПолучитьОбласть(Контекст, ИмяОбласти);
	ПСП_ЗаполнениеПараметровОбласти_ПоЧастномуКоду(Контекст);
	Итоги = Контекст.Контейнер_Итоги;
	Итоги.НомерТекущейСтроки = Итоги.НомерТекущейСтроки + 1;
	СтрокаТЧ = Контекст.Контейнер_СтрокаТЧ;
	//TODO почему забито здесь? убрать
	//СтрокаТЧ.КВСумма = СтрокаТЧ.НачисленнаяСуммаВзноса * СтрокаТЧ.КВПроцент / 100;
	//СтрокаТЧ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
	//Сумма взноса, отражаемая в Отчете Поставщику, как "полученная" с клиента.
	//При оплате клиентом напрямую в СК (форма оплаты "В СК" или "Терминал") равна фактической сумме оплаты - ОплаченоФакт.
	//А при оплате в брокер (в кассу или по безналу) принимается равной начисленной (полной) сумме взноса - НачисленнаяСуммаВзноса.
	//СтрокаТЧ.СуммаУдержаннаяАгентом = ?(Итоги.ЭтоДоговорСУдержаниемКВ,СтрокаТЧ.КВСуммаДляОтчета,0);
	//СтрокаТЧ.Баланс_Брокер_Поставщик;
	//Сумма, которую надо оплатить (по этой оплате) поставщику.
	//Завивит от вида расчета: при расчетах с удержанием уменьшается на сумму КВ для отчета
	//Зависит от того, куда оплатил Клиент (в брокер или Поставщику): уменьшается на сумму, оплаченную Поставщику
	//! Может быть отрицательной: случай оплаты Клиентом напрямую Поставщику полной суммы взноса при расчетах по удержанию
	//Она же - 
	// ??????? "Сумма поступившая Поставшику"
	// ??????? "Поступившая премия" (поставщику, после оплаты)
	// ??????? "Сумма переведенная на расчетный счет Страховщика".
	//Если СтрокаТЧ.Баланс_Брокер_Поставщик >= 0 Тогда
	//	СтрокаТЧ.СуммаКПеречислениюАгенту = 0;
	//	СтрокаТЧ.СуммаКПеречислениюПоставщику	= СтрокаТЧ.Баланс_Брокер_Поставщик;
	//	//TODO СуммаКПеречислениюПоставщику для разрядности 2
	//Иначе
	//	СтрокаТЧ.СуммаКПеречислениюАгенту = - СтрокаТЧ.Баланс_Брокер_Поставщик;
	//	СтрокаТЧ.СуммаКПеречислениюПоставщику = 0;
	//КонецЕсли;
	Итоги.ТекущаяСК = СтрокаТЧ.СК;
	Итоги.ТекущийСтраховойПродукт = СтрокаТЧ.СтраховойПродукт;
	Итоги.ТекущийВидСП = СтрокаТЧ.ВидСтраховогоПродукта;
	//===========================================================
	Если Область_Строка <> Неопределено Тогда
		Область_Строка.Области[ИмяОбласти].ПараметрРасшифровки = "Расшифровка";
		Если Область_Строка.Параметры.Количество() > 0 Тогда 
			Попытка
				//если в строке пусто - расшифровывать нечего, расшифровка не устанавливается
				Область_Строка.Параметры.Расшифровка = Контекст.Контейнер_СтрокаТЧ.Ссылка
			Исключение
				//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("ПСП_СтрокиТЧ_ОП(): ошибка установки расшифровки. " + ОписаниеОшибки(),, Истина);
			КонецПопытки;
		КонецЕсли;
		Прмт = Область_Строка.Параметры;
		СтрокиПараметров = Контекст.СтруктураОбъектаПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
		RegExp = Новый COMОбъект("VBScript.RegExp");
		Для каждого СтрокаПараметра Из СтрокиПараметров Цикл
			Контекст.Отладка.ТекущаяСтрокаПараметра = СтрокаПараметра;
			Контекст.ОперативныйКонтейнер = Контекст.Контейнер; //Восстанавливаем значение оперативного контейнера (может измениться модификатором при заполнении параметра)		
			ИмяПараметра = СтрокаПараметра.Параметр;
			Если ИмяПараметра = "" Тогда
			ИначеЕсли ИмяПараметра = "Баланс_Брокер_Поставщик" Тогда
				Прмт.Баланс_Брокер_Поставщик = Формат(СтрокаТЧ.Баланс_Брокер_Поставщик,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "Валюта" Тогда
				Прмт.Валюта = СтрокаТЧ.Валюта;
			ИначеЕсли ИмяПараметра = "ВидСтраховогоПродукта" Тогда
				Прмт.ВидСтраховогоПродукта = Строка(СтрокаТЧ.ВидСтраховогоПродукта);
			ИначеЕсли ИмяПараметра = "ДатаОплатыСтраховогоВзноса" Тогда
				Прмт.ДатаОплатыСтраховогоВзноса = Формат(СтрокаТЧ.ДатаОплатыСтраховогоВзноса,Контекст.ДФ_Полный);
			ИначеЕсли ИмяПараметра = "ДатаОплатыСтраховогоВзноса_Кратко" Тогда
				Прмт.ДатаОплатыСтраховогоВзноса_Кратко = Формат(СтрокаТЧ.ДатаОплатыСтраховогоВзноса,Контекст.ДФ_Кратко);
			ИначеЕсли ИмяПараметра = "КВПроцент" Тогда
				Прмт.КВПроцент = Строка(СтрокаТЧ.КВПроцент) + "%";
			ИначеЕсли ИмяПараметра = "КВПроцентДляОтчета" Тогда
				Прмт.КВПроцентДляОтчета = Строка(СтрокаТЧ.КВПроцентДляОтчета) + "%";
			ИначеЕсли ИмяПараметра = "КВСумма" Тогда
				Прмт.КВСумма = Формат(СтрокаТЧ.КВСумма, Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "КВСуммаДляОтчета" Тогда
				Прмт.КВСуммаДляОтчета = Формат(СтрокаТЧ.КВСуммаДляОтчета,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "Курс" Тогда
				Прмт.Курс = Формат(СтрокаТЧ.Курс,"ЧДЦ=4");
			ИначеЕсли ИмяПараметра = "НачалоДействияПолиса" Тогда
				Прмт.НачалоДействияПолиса = Формат(СтрокаТЧ.НачалоДействияПолиса,Контекст.ДФ_Полный);
			ИначеЕсли ИмяПараметра = "НачалоДействияПолиса_Кратко" Тогда
				Прмт.НачалоДействияПолиса_Кратко = Формат(СтрокаТЧ.НачалоДействияПолиса,Контекст.ДФ_Кратко);
			ИначеЕсли ИмяПараметра = "НачисленнаяСуммаВзноса" Тогда
				Прмт.НачисленнаяСуммаВзноса = Формат(СтрокаТЧ.НачисленнаяСуммаВзноса,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "НачисленнаяСуммаВзносаВВалюте" Тогда
				Прмт.НачисленнаяСуммаВзносаВВалюте = Формат(СтрокаТЧ.НачисленнаяСуммаВзносаВВалюте,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "НомерБСО" Тогда
				Прмт.НомерБСО = СокрЛП(СтрокаТЧ.НомерБСО);//СокрЛП(уб_СС.ДайНомерБСОПоСП(СтрокаТЧ.СтраховойПолис));
			ИначеЕсли ИмяПараметра = "НомерКвитанции" Тогда
				Прмт.НомерКвитанции = СокрЛП(СтрокаТЧ.НомерКвитанции);
			ИначеЕсли ИмяПараметра = "ОкончаниеДействияПолиса" Тогда
				Прмт.ОкончаниеДействияПолиса = Формат(СтрокаТЧ.ОкончаниеДействияПолиса,Контекст.ДФ_Полный);
			ИначеЕсли ИмяПараметра = "ОкончаниеДействияПолиса_Кратко" Тогда
				Прмт.ОкончаниеДействияПолиса_Кратко = Формат(СтрокаТЧ.ОкончаниеДействияПолиса,Контекст.ДФ_Кратко);
			ИначеЕсли ИмяПараметра = "ПлатежныйДокумент_Дата" Тогда
				Прмт.ПлатежныйДокумент_Дата = Формат(СтрокаТЧ.ПлатежныйДокумент_Дата,Контекст.ДФ_Полный);
			ИначеЕсли ИмяПараметра = "ПлатежныйДокумент_Номер" Тогда
				Прмт.ПлатежныйДокумент_Номер = СокрЛП(СтрокаТЧ.ПлатежныйДокумент_Номер);
			ИначеЕсли ИмяПараметра = "ПолнаяПремия" Тогда
				Прмт.ПолнаяПремия = Формат(СтрокаТЧ.ПолнаяПремия,Контекст.ЧФ)
			ИначеЕсли ИмяПараметра = "ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику" Тогда
				Прмт.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = Формат(СтрокаТЧ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "ПризнакПлатежа" Тогда
				Если СтрокаТЧ.ПризнакПлатежа = 0 Тогда
					Прмт.ПризнакПлатежа = "П";
				Иначе	
					Прмт.ПризнакПлатежа = Строка(?(СтрокаТЧ.НомерВзноса = 0,1,СтрокаТЧ.НомерВзноса));//+"-й взнос";
				КонецЕсли;
			ИначеЕсли ИмяПараметра = "СтраховаяСумма" Тогда
				Прмт.СтраховаяСумма = Формат(СтрокаТЧ.СтраховаяСумма,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "СтраховойПродукт" Тогда
				Прмт.СтраховойПродукт = Строка(СтрокаТЧ.СтраховойПродукт);
			ИначеЕсли ИмяПараметра = "СуммаКПеречислениюАгенту" Тогда
				Прмт.СуммаКПеречислениюАгенту = Формат(СтрокаТЧ.СуммаКПеречислениюАгенту,Контекст.ЧФ);
			ИначеЕсли ИмяПараметра = "СуммаКПеречислениюПоставщику" Тогда
				Прмт.СуммаКПеречислениюПоставщику = Формат(СтрокаТЧ.СуммаКПеречислениюПоставщику,Контекст.ЧФ);
			//ИначеЕсли ИмяПараметра = "СуммаУдержаннаяАгентом" Тогда
			//	Прмт.СуммаУдержаннаяАгентом = Формат(СтрокаТЧ.СуммаУдержаннаяАгентом,Контекст.ЧФ);
			Иначе
				ОПТЧ(Контекст, Прмт, RegExp);
			КонецЕсли;
		КонецЦикла;
		RegExp = Null;
		Если СтрокаТЧ.Валюта <> ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета Тогда
			Область_Строка.Области[ИмяОбласти].ЦветФона = WebЦвета.Желтый;
		КонецЕсли;
			
		Если Контекст.Свойство("ЭтоИсторияОП") И Контекст.ЭтоИсторияОП <> Неопределено И Контекст.ЭтоИсторияОП Тогда
			//Если СтрокаТЧ.Удалить Тогда
			//	Область_Строка.Области[ИмяОбласти].ЦветФона = Новый Цвет(255, 173, 173);
			//ИначеЕсли СтрокаТЧ.Добавить Тогда	
			//	Если ЗначениеЗаполнено(СтрокаТЧ.Дата) Тогда
			//		Область_Строка.Области[ИмяОбласти].ЦветФона = Новый Цвет(204, 255, 204);
			//	Иначе
			//		Область_Строка.Области[ИмяОбласти].ЦветФона = Новый Цвет(255, 250, 200);
			//	КонецЕсли;	
			//Иначе
			Если СтрокаТЧ.Изменить.Количество() > 0 Тогда				
				Для Строчка = 1 По Область_Строка.ВысотаТаблицы Цикл
					Для Колонка = 1 По Область_Строка.ШиринаТаблицы Цикл
						Ячейка = Область_Строка.Область(Строчка,Колонка);						
						Если ЗначениеЗаполнено(Ячейка.Параметр) Тогда
							Для Каждого ЭлементСписка Из СтрокаТЧ.Изменить Цикл
								ИскомаяСтрока = ЭлементСписка.Значение;								
								Если ИскомаяСтрока <> "" Тогда
									Номер = Найти(Ячейка.Параметр,ИскомаяСтрока);
									Если Номер > 0 Тогда
										//Ячейка.Примечание.Текст = ТекущееСостояниеОплаты[Ячейка.Параметр];
										МассивДопустимыхСимволов = Новый Массив;
										МассивДопустимыхСимволов.Добавить("(");
										МассивДопустимыхСимволов.Добавить(")");
										МассивДопустимыхСимволов.Добавить(".");
										МассивДопустимыхСимволов.Добавить(",");
										МассивДопустимыхСимволов.Добавить(" ");
										МассивДопустимыхСимволов.Добавить("");
										Если СтрДлина(Ячейка.Параметр) = СтрДлина(ИскомаяСтрока)
											Или Номер = 1 И МассивДопустимыхСимволов.Найти(Сред(Ячейка.Параметр,Номер+СтрДлина(ИскомаяСтрока),1)) <> Неопределено
											Или Номер > 1 И МассивДопустимыхСимволов.Найти(Сред(Ячейка.Параметр,Номер-1,1)) <> Неопределено И СтрДлина(Ячейка.Параметр) > Номер + СтрДлина(ИскомаяСтрока) - 1 И МассивДопустимыхСимволов.Найти(Сред(Ячейка.Параметр,Номер + СтрДлина(ИскомаяСтрока),1)) <> Неопределено
											Или Номер > 1 И МассивДопустимыхСимволов.Найти(Сред(Ячейка.Параметр,Номер-1,1)) <> Неопределено И СтрДлина(Ячейка.Параметр) = Номер + СтрДлина(ИскомаяСтрока) - 1
											Тогда
											Строка = Контекст.ТабличнаяЧатьТекущегоСостоянияДокумента.Найти(СтрокаТЧ.Ссылка,"Ссылка");
											Если Строка <> Неопределено И Контекст.ТабличнаяЧатьТекущегоСостоянияДокумента.Колонки.Найти(ИскомаяСтрока) <> Неопределено Тогда
												Ячейка.Примечание.Текст = Строка[ИскомаяСтрока];
											Иначе
												Ячейка.Примечание.Текст = " ";
											КонецЕсли;
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;	
						КонецЕсли;							
					КонецЦикла;	
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;		
		Контекст.ТабличныйДокумент.Вывести(Область_Строка);
	КонецЕсли;
	//===========================================================
	//>>>>>>>> история >>>>>>>>>>>>>>>>>	
	КонтрольИтога = Контекст.Свойство("Оформить");
	//При выводе Истории считаем только строки текущей версии 
	Если Не КонтрольИтога или СтрокаТЧ.РасчетИтогов Тогда
		//TODO Вынести имена полей в отдельное свойство Контекста, как Контекст.Показатели.ТЗПоказателей
		Попытка
			Итоги.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = Итоги.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику + СтрокаТЧ.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
		Исключение
		КонецПопытки;	
		Попытка
			Итоги.КВСумма 						= Итоги.КВСумма 						+ СтрокаТЧ.КВСумма;
		Исключение
		КонецПопытки;		
		Попытка	
			Итоги.ПолнаяПремия 					= Итоги.ПолнаяПремия 					+ СтрокаТЧ.ПолнаяПремия;
		Исключение
		КонецПопытки;		
		Попытка
			Итоги.НачисленнаяСуммаВзноса 		= Итоги.НачисленнаяСуммаВзноса 			+ СтрокаТЧ.НачисленнаяСуммаВзноса;
		Исключение
		КонецПопытки;		
		Попытка	
			Итоги.КВСуммаДляОтчета 				= Итоги.КВСуммаДляОтчета 				+ СтрокаТЧ.КВСуммаДляОтчета;
		Исключение
		КонецПопытки;		
		//Итоги.СуммаУдержаннаяАгентом 		= Итоги.СуммаУдержаннаяАгентом 			+ СтрокаТЧ.СуммаУдержаннаяАгентом;
		Попытка
			Итоги.Баланс_Брокер_Поставщик 		= Итоги.Баланс_Брокер_Поставщик 		+ СтрокаТЧ.Баланс_Брокер_Поставщик;
		Исключение
		КонецПопытки;		
		Попытка
			Итоги.СуммаКПеречислениюАгенту 		= Итоги.СуммаКПеречислениюАгенту 		+ СтрокаТЧ.СуммаКПеречислениюАгенту;
		Исключение
		КонецПопытки;		
		Попытка Итоги.СуммаКПеречислениюПоставщику 	= Итоги.СуммаКПеречислениюПоставщику 	+ СтрокаТЧ.СуммаКПеречислениюПоставщику;
		Исключение
		КонецПопытки;		
		Для Каждого СтрокаТЗ Из Контекст.Показатели.ТЗПоказателей Цикл
			Если СтрокаТЗ.РассчитыватьИтоги Тогда
				
					Имя = СтрокаТЗ.ИмяПоказателя;
				Попытка
					Итоги[Имя] = Итоги[Имя] + СтрокаТЧ[Имя];
				Исключение
				КонецПопытки;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	
КонецПроцедуры	

/////////////////////////////////////////////////////////////////////////////////
//     процессор подстановок ТЧ Передачи БСО Поставщику 
/////////////////////////////////////////////////////////////////////////////////

//// 2-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в ТЧ Передачи БСО Поставщику:
Процедура ПСП_ТЧ_ПБП(Контекст, ИмяОбластиШапка = "ШапкаТаб", ИмяОбластиСтрока = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_ТЧ_ПБП (Область шапки: '" + ИмяОбластиШапка + "', Область строки: '" + ИмяОбластиСтрока + "')");		
	ТабДок = Контекст.ТабличныйДокумент;
	Макет = Контекст.Макет;	
	ТЗ_ТЧДокумента = Контекст.ТЧДокумента;
	ТЗ_ТЧДокумента.Сортировать("СК,ВидБСО,НомерБСО");
	ПСП(Контекст, ИмяОбластиШапка, Контекст.Предупреждать);
	//Указываем, какую строку повторять на каждой странице при печати
	ОблШапкаТаб = ТабДок.Области.Найти(ИмяОбластиШапка);
	Если ОблШапкаТаб <> Неопределено Тогда
		Если Контекст.ПовторятьШапкуТаблицыПриПечати Тогда
			ВерхняяГраница = ОблШапкаТаб.Верх;
			НижняяГраница = ОблШапкаТаб.Низ;
			Если Контекст.КоличествоСтрокПовторенияШапкиТЧ < 1 Тогда
				ОбластьПовторения = ОблШапкаТаб;
			Иначе
				ВыводитьВверхДо = Макс(ВерхняяГраница, НижняяГраница - Контекст.КоличествоСтрокПовторенияШапкиТЧ + 1);
				ОбластьПовторения = ТабДок.Область("R"+ВыводитьВверхДо+":R" + НижняяГраница);
			КонецЕсли;
			ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовторения;
		КонецЕсли;	
		Если Контекст.ФиксацияСверху Тогда
			ТабДок.ФиксацияСверху = ОблШапкаТаб.Низ;	
		КонецЕсли;
	КонецЕсли;	
	Итоги = ПолучитьСтруктуруИтогов_Общее(Контекст);
	Сортировка = "";
	ОбластьМакета_ГруппаСК = Макет.Области.Найти("ГруппаСК");
	Если ОбластьМакета_ГруппаСК = Неопределено Тогда
		бОбрабатыватьГруппуСК = Ложь;
	Иначе
		ОбластьМакета_ГруппаСК 	= Макет.ПолучитьОбласть("ГруппаСК");
		бОбрабатыватьГруппуСК 	= Истина;
		Если Контекст.ТЧДокумента.Колонки.Найти("СК") <> Неопределено Тогда
			Сортировка = Сортировка + ?(Сортировка = "", "",",") + "СК";
		КонецЕсли;
	КонецЕсли;
	ОбластьМакета_ГруппаВидБСО  = Макет.Области.Найти("ГруппаВидБСО");
	Если ОбластьМакета_ГруппаВидБСО = Неопределено Тогда
		бОбрабатыватьГруппуВидБСО = Ложь;
	Иначе
		ОбластьМакета_ГруппаВидБСО	= Макет.ПолучитьОбласть("ГруппаВидБСО");
		бОбрабатыватьГруппуВидБСО	= Истина;
		Если Контекст.ТЧДокумента.Колонки.Найти("ВидБСО") <> Неопределено Тогда
			Сортировка = Сортировка + ?(Сортировка = "", "",",") + "ВидБСО"; 
		КонецЕсли;
	КонецЕсли;	
	ЭтоПередачаБСО = Контекст.Объект.Метаданные() = Метаданные.Документы.уб_ПередачаБСОПоставщику И Контекст.Объект.ВидОперации = Перечисления.уб_ВидыОперацииПередачиБСОвСК.ПередачаБСО;
	Для Каждого СтрокаТЧ Из ТЗ_ТЧДокумента Цикл
		Если Контекст.Отладка.Групповая И Контекст.Контейнер_Итоги.НомерТекущейСтроки >= Контекст.Отладка.МаксКоличествоСтрокТЧ Тогда
			Прервать;	
		КонецЕсли;
		//не печатаем строки с БСО карточек
		Попытка
			Если ЭтоПередачаБСО И СтрокаТЧ.ВидБСО.Тип = Перечисления.уб_ТипыБСО.Карточка Тогда
				Продолжить
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если бОбрабатыватьГруппуСК Тогда
			Если Итоги.ТекущаяСК <> СтрокаТЧ.СК Тогда
				ОбластьМакета_ГруппаСК.Параметры.СК = Строка(СтрокаТЧ.СК);	
				ТабДок.Вывести(ОбластьМакета_ГруппаСК);
			КонецЕсли;
			Итоги.ТекущаяСК = СтрокаТЧ.СК;
		КонецЕсли;
		Если бОбрабатыватьГруппуВидБСО Тогда
			Если Итоги.ТекущийВидБСО <> СтрокаТЧ.ВидБСО Тогда
				ОбластьМакета_ГруппаВидБСО.Параметры.ВидБСО = Строка(СтрокаТЧ.ВидБСО);	
				ТабДок.Вывести(ОбластьМакета_ГруппаВидБСО);
			КонецЕсли;
			Итоги.ТекущийВидБСО = СтрокаТЧ.ВидБСО;
		КонецЕсли;
		//Контекст.РазрешенныеТипыБСО - Присутствует в контексте всегда. 
		//Если список пуст, то считается, что разрешены все БСО
		//Если не пуст, то разрешены только перечисленные в списке. Только их строки и будут выводиться
		Если Контекст.РазрешенныеТипыБСО.Количество() = 0
		//ИЛИ Контекст.РазрешенныеТипыБСО.НайтиПоЗначению(СтрокаТЧ.ВидБСО.Тип) <> Неопределено 
		Тогда
			УстановитьТекущийКонтейнер(Контекст,"СтрокаТЧ",СтрокаТЧ);
			ПСП_СтрокиТЧ_ПБП(Контекст, ИмяОбластиСтрока);
		КонецЕсли;
	КонецЦикла;
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры	

//// 2-й УРОВЕНЬ |	Процессов заполняет типовые места подстановки в ТЧ Поступления БСО:
Процедура ПСП_ТЧ_ПБ(Контекст, ИмяОбластиШапка = "ШапкаТаб", ИмяОбластиСтрока = "Строка") Экспорт

	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_ТЧ_ПБП (Область шапки: '" + ИмяОбластиШапка + "', Область строки: '" + ИмяОбластиСтрока + "')");	
	
	Контекст.Вставить("КоличествоПолисовВсего", 0);
	
	ТабДок = Контекст.ТабличныйДокумент;
	Макет = Контекст.Макет;
	
	ТЗ_ТЧДокумента = Контекст.Объект.БСО;
	
	ПСП(Контекст, ИмяОбластиШапка, Контекст.Предупреждать);
	
	//Указываем, какую строку повторять на каждой странице при печати
	ОблШапкаТаб = ТабДок.Области.Найти(ИмяОбластиШапка);
	Если ОблШапкаТаб <> Неопределено Тогда
		Если Контекст.ПовторятьШапкуТаблицыПриПечати Тогда
			ВерхняяГраница = ОблШапкаТаб.Верх;
			НижняяГраница = ОблШапкаТаб.Низ;
			Если Контекст.КоличествоСтрокПовторенияШапкиТЧ < 1 Тогда
				ОбластьПовторения = ОблШапкаТаб;
			Иначе
				ВыводитьВверхДо = Макс(ВерхняяГраница, НижняяГраница - Контекст.КоличествоСтрокПовторенияШапкиТЧ + 1);
				ОбластьПовторения = ТабДок.Область("R"+ВыводитьВверхДо+":R" + НижняяГраница);
			КонецЕсли;
			ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовторения;
		КонецЕсли;	
		Если Контекст.ФиксацияСверху Тогда
			ТабДок.ФиксацияСверху = ОблШапкаТаб.Низ;	
		КонецЕсли;
	КонецЕсли;	
	Счетчик = 1;
	Для Каждого Строка Из ТЗ_ТЧДокумента Цикл
		ОблСтрока = Макет.ПолучитьОбласть(ИмяОбластиСтрока);
		ОблСтрока.Параметры.НомерСтроки = Счетчик;
		ОблСтрока.Параметры.ВидБСО		= Строка.ВидБСО;
		ОблСтрока.Параметры.СерияБСО	= СокрЛП(Строка.СерияБСО);
		НачНомерБСО = Строка.НачНомерБСО;
		КонНомерБСО = ?(Строка.КонНомерБСО = 0, НачНомерБСО, Строка.КонНомерБСО);
		ОблСтрока.Параметры.НачНомерБСО = НачНомерБСО;
		ОблСтрока.Параметры.КонНомерБСО = КонНомерБСО;
		ОблСтрока.Параметры.КоличествоПолисов = Строка.КоличествоБСО;
		Контекст.КоличествоПолисовВсего = Контекст.КоличествоПолисовВсего + Строка.КоличествоБСО;
		ТабДок.Вывести(ОблСтрока);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
КонецПроцедуры

//// 3-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в СТРОКЕ ТЧ Передачи БСО Поставщику:
//1.1 		НомерСтроки
//2.1 СК
//3.1 ВидБСО
//4.1 НомерБСО
//5.1 НомерПолиса
//6.1 Количество
//7.1 Комментарий
//8.1 ДатаУтратыПорчи
//8.2 ДатаУтратыПорчи_Кратко
//9.1 СостояниеБСО
//9.2 СостояниеДляПоставщика
//10.1 Страхователь
//10.2 Страхователь_Расширение
//11.1 ДатаОформленияПолиса
//11.2 ДатаОформленияПолиса_Кратко
Процедура ПСП_СтрокиТЧ_ПБП(Контекст, ИмяОбласти = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_СтрокиТЧ_ПБП (Область: '" + ИмяОбласти + "')");
	Область_Строка = ПолучитьОбласть(Контекст, ИмяОбласти);
	ПСП_ЗаполнениеПараметровОбласти_ПоЧастномуКоду(Контекст);
	СтрокаТЧ = Контекст.Контейнер_СтрокаТЧ;
	Итоги = Контекст.Контейнер_Итоги;
	Итоги.НомерТекущейСтроки = Итоги.НомерТекущейСтроки + 1;
	Итоги.ТекущаяСК = СтрокаТЧ.СК;
	//===========================================================
	Если Область_Строка <> Неопределено Тогда
		Прмт = Область_Строка.Параметры;
		//СтрокиПараметров = Контекст.ОбъектПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
		СтрокиПараметров = Контекст.СтруктураОбъектаПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
		RegExp = Новый COMОбъект("VBScript.RegExp");
		Для каждого СтрокаПараметра Из СтрокиПараметров Цикл
			//здесь была частная функция для Ингосстраха
			Контекст.Отладка.ТекущаяСтрокаПараметра = СтрокаПараметра;
			Контекст.ОперативныйКонтейнер = Контекст.Контейнер; //Восстанавливаем значение оперативного контейнера (может измениться модификатором при заполнении параметра)
			ИмяПараметра = СтрокаПараметра.Параметр;
			Если ИмяПараметра <> "" Тогда
				ОПТЧ(Контекст, Прмт, RegExp);
			КонецЕсли;
		КонецЦикла;
		RegExp = Null;
		//===========================================================
		//для проверки частного случая по передаче Ингосстрах - квитанции не выводим
		Если Не Контекст.Свойство("Ингосстрах") Или Контекст.Ингосстрах.ВыводитьЭтуСтроку Тогда
			Контекст.ТабличныйДокумент.Вывести(Область_Строка);
		КонецЕсли;
		отладка_Лог_КонецПроцедуры(Контекст);
	КонецЕсли;
	
КонецПроцедуры	
