Функция ПолучитьПараметрДоговора_Тип_Строка(НаименованиеПараметра, Поставщик, ОрганизацияАгент, НаДату = Неопределено, Падеж = Неопределено
	, КоличествоПодчеркиванийЕслиНеУказан = 20) Экспорт
	
	ЗначениеПараметра = уб_СтраховойБрокер.ПолучитьПараметрДоговора(НаДату, НаименованиеПараметра, Поставщик, ОрганизацияАгент);
	Если ТипЗнч(ЗначениеПараметра) = Тип("Строка") И СокрЛП(ЗначениеПараметра) <> "" Тогда
		Если Падеж = Неопределено Тогда
			Возврат СокрЛП(ЗначениеПараметра);
		Иначе
			Возврат ФункцииРасширения.Должность_Склонение(ЗначениеПараметра, Падеж);
		КонецЕсли;
	КонецЕсли;	
	Прочерк = "";
	Для ч = 1 По КоличествоПодчеркиванийЕслиНеУказан Цикл
		Прочерк = Прочерк + "_";	  
	КонецЦикла;
	Возврат Прочерк;
	
КонецФункции

