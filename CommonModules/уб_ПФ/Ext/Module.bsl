Функция Дай_ТиповойНомер(Объект, ДобавлятьСистемныйНомер = Истина) Экспорт
	//
	//Ссылка = Объект.Ссылка;
	//Тзд = ТипЗнч(Ссылка);
	Ссылка = Объект;
	Тзд = ТипЗнч(Объект.Ссылка);
	//
	Если Тзд = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда 
		НомерОтчетаПоставщику = Ссылка.НомерОтчетаПоставщику;
		Номер = Ссылка.Номер;
		Возврат  ?(ДобавлятьСистемныйНомер,?(НомерОтчетаПоставщику <> "",НомерОтчетаПоставщику + " (" + Формат(Номер,"ЧГ=") + ")",Формат(Номер,"ЧГ=")), НомерОтчетаПоставщику);
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_ПередачаБСОПоставщику") Тогда 
		Возврат  ?(Ссылка.НомерДляОтчета <> "",Ссылка.НомерДляОтчета + " (" + Формат(Ссылка.Номер,"ЧГ=") + ")",Формат(Ссылка.Номер,"ЧГ="));
	ИначеЕсли Тзд = Тип("ДокументСсылка.уб_Доверенности") Тогда 
		Возврат  СокрЛП(?(ЗначениеЗаполнено(Ссылка.НомерДоверенности),Ссылка.НомерДоверенности,Формат(Ссылка.Номер,"ЧГ=")));	
	Иначе
		Если ТипЗнч(Ссылка.Номер) = Тип("Строка") Тогда 
			Возврат  СокрЛП(Ссылка.Номер);
		Иначе
			Возврат  Формат(Ссылка.Номер,"ЧГ=");
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

