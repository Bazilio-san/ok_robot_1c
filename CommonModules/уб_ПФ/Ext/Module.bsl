		Возврат;
	КонецЕсли;
	//Результат выполнения функций заполнения параметра передается в параметр
	//в обычном режиме - результат
	//в режиме отладки - результат
	Если Статус = Неопределено Тогда
		Статус = СтатусСообщения.БезСтатуса;	
		чСтатус = 0; //
	ИначеЕсли Статус = СтатусСообщения.Информация Тогда
		чСтатус = 1; //i
	//Результат выполнения функций заполнения параметра передается в параметр
	//в обычном режиме - результат
	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Обычное Тогда
		чСтатус = 2; //>
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - пусто
	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Внимание Тогда
		чСтатус = 3; //!
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - (### Ошибка! ###)
	//в режиме отладки - ###########
	ИначеЕсли Статус = СтатусСообщения.Важное Тогда
		чСтатус = 4; //!!
	//Результат выполнения функций заполнения параметра НЕ передается в параметр
	//в обычном режиме - (### Ошибка! ###)
	//в режиме отладки - ###########
	// + ОписаниеОшибки
	ИначеЕсли Статус = СтатусСообщения.ОченьВажное Тогда
		чСтатус = 5; //!!!
	КонецЕсли;
	ТекСтрокаПараметра = Контекст.Отладка.ТекущаяСтрокаПараметра;
	ИмяПараметра = ТекСтрокаПараметра.Параметр;
	ИмяОбласти = ТекСтрокаПараметра.Область;
	ИмяООЯ = ТекСтрокаПараметра.ИмяООЯ;
	Свойство = Контекст.Отладка.ИмяТекущегоСвойства;
	ТипКонтейнера = Контекст.ОперативныйКонтейнер.Тип_;
	Табс25 = "																									";
	//Статусы Важное и ОченьВажное поступают из исключений
	Если Статус = СтатусСообщения.ОченьВажное Тогда
		СОО = СОО + ?(ЗначениеЗаполнено(СОО),Символы.ВК + Символы.ПС,"") + Лев(Табс25,Уровень + 1) + "Описание Ошибки: <" + ?(ЗначениеЗаполнено(сОписаниеОшибки),сОписаниеОшибки,"отсутствует") + ">";
	ИначеЕсли Статус = СтатусСообщения.Важное Тогда
		СОО = СОО + ?(ЗначениеЗаполнено(сОписаниеОшибки), Символы.ВК + Символы.ПС + Лев(Табс25,Уровень + 1) + "Описание Ошибки: <" + сОписаниеОшибки + ">","");
	КонецЕсли;
	Если ТекСтрокаПараметра.ЕстьКодЗаполнения Тогда
		Если ТекСтрокаПараметра.Параметр = кПризнакСвободногоКода() Тогда
			СОО = Лев(Табс25,Уровень + 1) + "Ошибка при выполнении свободного кода области '" + ИмяОбласти + "'";
		Иначе
			СОО = Лев(Табс25,Уровень + 1) + "Ошибка при выполнении кода заполнения параметра [" + ИмяПараметра + "] (область '" + ИмяОбласти + "')";
		КонецЕсли;
		СОО = СОО + Символы.ВК + Символы.ПС + Лев(Табс25,Уровень + 1) + "Описание Ошибки: <" + ?(ЗначениеЗаполнено(сОписаниеОшибки),сОписаниеОшибки,"отсутствует") + ">";
		СОО = СОО + Символы.ВК + Символы.ПС + Лев(Табс25,Уровень + 1) + "========= КОД =========" + Символы.ВК + Символы.ПС + ТекСтрокаПараметра.КодЗаполнения + Символы.ВК + Символы.ПС + "=======================" +Символы.ВК + Символы.ПС;	
	КонецЕсли;
	Преф = Символы.ВК + Символы.ПС + Лев(Табс25,Уровень + 1) + "0 "; //	 "? "
	СООКооодината = Преф + "Параметр: '" + ИмяОбласти + "' / '" + ИмяООЯ + "' / [" + ИмяПараметра + "]" 
	+ Преф + "Контейнер: '" + ТипКонтейнера + "', свойство: '" + Свойство + "'.";	
	СОО = Лев(Табс25,Уровень) + СОО + СООКооодината;
	//Раскраска ошибочных ячеек и установка примечания
	Обл = Контекст.ТекущаяОбластьТД.Область(ТекСтрокаПараметра.АдресЯчейкиВОбласти);
	Если чСтатус < 2 Тогда
		Цв = Новый Цвет(216, 255, 216);	// Светло-светло зеленый
	ИначеЕсли чСтатус = 2 Тогда
		Цв = Новый Цвет(252, 255, 200); // Светло-Желтый
	ИначеЕсли чСтатус = 3 Тогда
		Цв = Новый Цвет(243, 255, 115); // Желтый
	ИначеЕсли чСтатус = 4 Тогда
		Цв = Новый Цвет(255, 213, 213); // розовый
	ИначеЕсли чСтатус = 5 Тогда
		Цв = Новый Цвет(255, 150, 150); // красный
	КонецЕсли;
	Обл.ЦветФона = Цв;
	Обл.Примечание.Текст = Обл.Примечание.Текст + ?(ЗначениеЗаполнено(Обл.Примечание.Текст),Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС,"") + СОО;
	Обл.Примечание.АвтоРазмер = Ложь;
	Обл.Примечание.Ширина = 70;
	Обл.Примечание.Высота = СтрДлина(Обл.Примечание.Текст)/Обл.Примечание.Ширина * 9;
	Обл.ПараметрРасшифровки = ИмяООЯ;
	Контекст.ТекущаяОбластьТД.Параметры[ИмяООЯ] = Новый Структура("ГдеНайдено, Область, Параметр, Шаблон, СсылкаПФ" 
					,"Макет" 
					,ИмяООЯ 
					,ИмяПараметра 
					,"" 
					,Контекст.СсылкаПФ 
					);	
	Сообщить(СОО,Статус);	
	НС = Контекст.Отладка.ТЗОшибок.Добавить();
	НС.Область = ИмяОбласти;
	НС.Параметр = ИмяПараметра;
	НС.ИмяООЯ = ТекСтрокаПараметра.ИмяООЯ;
	НС.Свойство = Свойство;
	НС.ТипКонтейнера = ТипКонтейнера;
	НС.ОписаниеОшибки = сОписаниеОшибки;
	НС.СОО = СОО;
	НС.Статус = чСтатус;
		
КонецПроцедуры

Процедура отладка_Лог_НачалоПроцедуры(Контекст, ИмяПроцедуры) Экспорт
	
	Если Контекст = Неопределено ИЛИ НЕ Контекст.Отладка.Лог = Истина Тогда
		Возврат;	
	КонецЕсли;
	УВ = Контекст.Отладка.УовеньВложенностиПроцедуры + 1;
	Табс25 = "																									";
	Сообщить(Символ(9553) + Лев(Табс25,УВ) + ИмяПроцедуры);	
	Контекст.Отладка.УовеньВложенностиПроцедуры = УВ;
	
КонецПроцедуры	

Процедура отладка_Лог_КонецПроцедуры(Контекст) Экспорт
	
	Если НЕ Контекст.Отладка.Лог Тогда
		Возврат;	
	КонецЕсли;
	Контекст.Отладка.УовеньВложенностиПроцедуры = Контекст.Отладка.УовеньВложенностиПроцедуры - 1;
	
КонецПроцедуры	

//Эта процедура используется в режиме разработки и тестирования печати
//Если параметр сеанса уб_отладка_ПечататьТЕСТМакет пеерключен в ИСТИНУ,
//то в качестве макета, вместо макета из справочника,
//используется общий макет с именем "ТЕСТ", а вместо кода 
//из справочника запускается код процедуры ПечатьТЕСТ().
//
//Переключить параметр сеанса уб_отладка_ПечататьТЕСТМакет можно в Предприятии 
//в пункте меню SS -> Настройка параметров отладки
Процедура ОтладкаПечати(Контекст) Экспорт
	
	Инициализировать_данными_КонтекстПечати(Контекст, ПолучитьОбщийМакет("ТЕСТ"));
	ПечатьТЕСТ(Контекст);
	#Если Клиент Тогда
	Предупреждение("Печать тестового макета!",5);	
	#КонецЕсли

КонецПроцедуры	

//Предполагается, что при отладке в тело процедуры копируется код из справочника.
//Это позволяет поставить в нем точки останова и произвести отладку
Процедура ПечатьТЕСТ(Контекст) Экспорт
	// 	
	Сообщить("Привет из модуля уб_ПФ, процедуры ПечатьТЕСТ))");
	
КонецПроцедуры	

//------------------------------------------------------------------------------
//     Инициализация контекста
//------------------------------------------------------------------------------

Функция ИнициализироватьКонтекстПечати(Контекст = Неопределено) Экспорт
	
	//Формируем образ структуры контекста
	КТЕМП = Новый Соответствие();
	КТЕМП.Вставить("МассивОбъектов");
	КТЕМП.Вставить("Объект");
	КТЕМП.Вставить("Макет");
	КТЕМП.Вставить("ТЧДокумента");
	КТЕМП.Вставить("СсылкаПФ");
	КТЕМП.Вставить("СтруктураОбъектаПФ");//КТЕМП.Вставить("ОбъектПФ");	
	КТЕМП.Вставить("Контейнер_Документ");
	КТЕМП.Вставить("Контейнер_Итоги");
	КТЕМП.Вставить("Контейнер_СтрокаТЧ");
	КТЕМП.Вставить("ТекущаяОбластьТД");
	КТЕМП.Вставить("ИмяТекущейОбластиТД");	
	//Текущий контейнер, из которго по умолчанию заполняется обрабатываемая область
	КТЕМП.Вставить("Контейнер"); 
	//Оперативный контейнер - из которого заполняется конкретный параметр. 
	//При начале заполнения парамера равно текущему контейнеру, 
	//но может переключаться модификаторами Док() и Итог()   
	КТЕМП.Вставить("ОперативныйКонтейнер"); 
	КТЕМП.Вставить("ИспользоватьСохраненныеНастройкиПечати", Истина);
	КТЕМП.Вставить("ПовторятьШапкуТаблицыПриПечати", Истина);
	КТЕМП.Вставить("КоличествоСтрокПовторенияШапкиТЧ", 0); //0 - повторять вcю область ШапкаТаб 
	КТЕМП.Вставить("ПоказыватьЗаголовокДокументаВКолонтитле", Истина);
	//ТОДО Переименовать с СохранятьПараметрыПечатиИзДиалогаПечати
	КТЕМП.Вставить("АвтоУстанавливатьИмяПараметровПечати", Истина);
	КТЕМП.Вставить("ИмяПараметровПечати", "");
	КТЕМП.Вставить("ИмяМакета", "_неизвестный_макет_");
	КТЕМП.Вставить("ФиксацияСверху", Ложь);
	КТЕМП.Вставить("ТабличныйДокумент", Новый ТабличныйДокумент);
	КТЕМП.Вставить("Итоги", Неопределено);
	КТЕМП.Вставить("ДФ_Полный_месяц_год","ДФ=""dd MMMM yyyy'г.'""");
	КТЕМП.Вставить("ДФ_Полный_год","ДФ=""dd.MM.yyyy'г.'""");
	КТЕМП.Вставить("ДФ_Полный","ДФ=dd.MM.yyyy");
	КТЕМП.Вставить("ДФ_Кратко","ДФ=dd.MM.yy");
	КТЕМП.Вставить("ЧФ","ЧЦ=14; ЧДЦ=2; ЧН=");	
	// параметры табличного документа по умолчанию
	КТЕМП.Вставить("ОтображатьЗаголовки", Истина);
	КТЕМП.Вставить("ОтображатьСетку", Ложь);
	КТЕМП.Вставить("ТолькоПросмотр", Ложь);
	КТЕМП.Вставить("КоличествоЭкземпляров", 2);
	КТЕМП.Вставить("РазборПоКопиям", Истина);
	КТЕМП.Вставить("ОриентацияСтраницы", ОриентацияСтраницы.Ландшафт);
	КТЕМП.Вставить("АвтоМасштаб", Истина);	
	КТЕМП.Вставить("ВыводитьВерхнийКолонтитл", Истина);
	КТЕМП.Вставить("ВыводитьНижнийКолонтитл", Истина);
	//Дополнительные параметры:
	//РазрешенныеТипыБСО. Используется для передачи БСО Поставщику
	//Присутствует в контексте всегда. Если список пуст, то считается, что разрешены все БСО
	//Если не пуст, то разрешены только перечисленные
	КТЕМП.Вставить("РазрешенныеТипыБСО", Новый СписокЗначений());
	КТЕМП.Вставить("СохранятьПФВФайл", Ложь);
	//Дополнительные праметры контекста
	КТЕМП.Вставить("Предупреждать", Ложь);
	КТЕМП.Вставить("Падеж", 1);
	КТЕМП.Вставить("ОрганизацияАгент");
	КТЕМП.Вставить("ЛицоНаше");	
	КТЕМП.Вставить("Поставщик");
	КТЕМП.Вставить("ЛицоИх");
	КТЕМП.Вставить("ИмяОбъекта");
	КТЕМП.Вставить("ЭтоИсторияОП");
	КТЕМП.Вставить("ОплатыСписок");
	//Структура контекста уже может быть передана
	//Это происходит в режиме групповой отладки.
	//В этом режиме нужно вызвать процедуру "Печать" из модуля объекта документа с контекстом, 
	//в котором нужным образом проинициализированы параметры отладки до вызова процедуры "Печать".
	//Но внутри функции происходи вызов процедуры инициализации контекста (этой)
	//Что бы при вызове процедуры инициализации контекста не произошел сброс установленных параметров отладки
	//проверим, какой сейчас режим. И, если режим группповой отладки, то сначала сохраним данные контекста, 
	//а потом восстановим:
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда 
		Контекст = Новый Структура();
	КонецЕсли;	
	Если Контекст.Свойство("Отладка") И Контекст.Отладка.Групповая Тогда 
		СтруктураОтладка = Контекст.Отладка;
	Иначе
		СтруктураОтладка = Новый Структура();
		СтруктураОтладка.Вставить("Включена", ПараметрыСеанса.уб_отладка_Печать);
		СтруктураОтладка.Вставить("ТекущаяСтрокаПараметра");
		СтруктураОтладка.Вставить("Групповая", Ложь);
		СтруктураОтладка.Вставить("НеПоказыватьРезультатПечати", Ложь);
		СтруктураОтладка.Вставить("МаксКоличествоОшибок", 100);
		СтруктураОтладка.Вставить("МаксКоличествоПФ", 10);
		СтруктураОтладка.Вставить("МаксКоличествоСтрокТЧ", 1);
		СтруктураОтладка.Вставить("МаксСтатусОшибкиПриЗаполненииПараметра", 1); 
		//В течении заполнения параметра накручивается и принимает максимальное значение из всех произошедших ошибок.
		//В начале заполнения очередного параметра - сбрасывается в 0;
		СтруктураОтладка.Вставить("Лог", Ложь);
		СтруктураОтладка.Вставить("УовеньВложенностиПроцедуры", 0);
		//Динамические свойства, изменяющиеся по ходу заполнения макета
		СтруктураОтладка.Вставить("ИмяТекущегоСвойства"); //Имя свойства, обрабатываемого в данный момент при заполнении параметра
	КонецЕсли;
	ТЗОшибок = Новый ТаблицаЗначений;
	ТЗОшибок.Колонки.Добавить("Область");
	ТЗОшибок.Колонки.Добавить("Параметр");
	ТЗОшибок.Колонки.Добавить("ИмяООЯ");
	ТЗОшибок.Колонки.Добавить("Свойство");
	ТЗОшибок.Колонки.Добавить("ТипКонтейнера");
	ТЗОшибок.Колонки.Добавить("ОписаниеОшибки");
	ТЗОшибок.Колонки.Добавить("СОО");
	ТЗОшибок.Колонки.Добавить("Статус");
	СтруктураОтладка.Вставить("ТЗОшибок", ТЗОшибок);	
	КТЕМП.Вставить("Отладка", СтруктураОтладка);
	//добавляем в контекст ТабПФ (ранее была переменной объекта печатаемого документа)
	КТЕМП.Вставить("ТабПФ", 			Новый ТаблицаЗначений);
	КТЕМП.Вставить("ЭтоПФСубагент", 	Ложь);
	КТЕМП.Вставить("ПроцентСубагента",	0);
	КТЕМП.Вставить("Субагент",			Справочники.Контрагенты.ПустаяСсылка());
	//Дозаполняем контекст параметрами, которых там еще нет. Существующие не трогаем.
	Для Каждого КлючЗнач Из КТЕМП Цикл
		Если НЕ Контекст.Свойство(КлючЗнач.Ключ) Тогда
			Контекст.Вставить(КлючЗнач.Ключ, КлючЗнач.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Не Контекст.Свойство("Показатели") Тогда
		Структура = Новый Структура;
		ТЗПоказателей = Новый ТаблицаЗначений;
		ТЗПоказателей.Колонки.Добавить("ИмяПоказателя");
		Структура.Вставить("ТЗПоказателей", ТЗПоказателей);
		Контекст.Вставить("Показатели", Структура);
	КонецЕсли;
	Возврат Контекст;
	
КонецФункции

Процедура Инициализировать_данными_КонтекстПечати(Контекст, Макет = Неопределено) Экспорт
	отладка_Лог_НачалоПроцедуры(Контекст, "Инициализировать_данными_КонтекстПечати");	
	
	СсылкаПФ = Контекст.СтруктураОбъектаПФ;//СсылкаПФ = Контекст.ОбъектПФ;
	
	Если Макет = Неопределено Тогда
		Контекст.Макет = СсылкаПФ.МакетШаблона.Получить();
	Иначе
		Контекст.Макет = Макет;
	КонецЕсли;
	
	Если НЕ СсылкаПФ.ПП_ИспользоватьКоличествоЭкземпляровПоУмолчанию Тогда
		Контекст.КоличествоЭкземпляров = СсылкаПФ.ПП_КоличествоЭкземпляров;
	КонецЕсли;
	
	Если НЕ СсылкаПФ.ПП_ИспользоватьОриентациюСтраницыПоУмолчанию Тогда
		Контекст.ОриентацияСтраницы = ?(СсылкаПФ.ПП_Ориентация_Страницы = Истина,ОриентацияСтраницы.Портрет,ОриентацияСтраницы.Ландшафт);
	КонецЕсли;
	
	Контекст.ИспользоватьСохраненныеНастройкиПечати		= СсылкаПФ.ПП_ИспользоватьСохраненныеНастройкиПечати;
	Контекст.АвтоУстанавливатьИмяПараметровПечати		= СсылкаПФ.ПП_АвтоСохранятьНастройкиПечати;
	
	Контекст.ПовторятьШапкуТаблицыПриПечати				= СсылкаПФ.ПП_ПовторятьШапкуТаблицыПриПечати;
	Контекст.КоличествоСтрокПовторенияШапкиТЧ			= СсылкаПФ.ПП_КоличествоСтрокПовторенияШапкиТЧ;
	Контекст.ПоказыватьЗаголовокДокументаВКолонтитле	= СсылкаПФ.ПП_ПоказыватьЗаголовокДокументаВКолонтитле;
	Контекст.ВыводитьВерхнийКолонтитл					= СсылкаПФ.ПП_ВыводитьВерхнийКолонтитл;
	Контекст.ВыводитьНижнийКолонтитл					= СсылкаПФ.ПП_ВыводитьНижнийКолонтитл;
	Контекст.АвтоМасштаб								= СсылкаПФ.ПП_АвтоМасштаб;
	Попытка
		КонтекстСохранятьПФВФайл 							= ?(ТипЗнч(Контекст.СохранятьПФВФайл) = Тип("Флажок"),Контекст.СохранятьПФВФайл.Значение,Контекст.СохранятьПФВФайл);
	Исключение
		КонтекстСохранятьПФВФайл = Ложь;
	КонецПопытки;	
	Контекст.СохранятьПФВФайл							= СсылкаПФ.ПП_СохранятьПФВФайл ИЛИ (КонтекстСохранятьПФВФайл = Истина);
	// №№№№№  Контейнер Итогов   №№№№	
	ТЗКонтейнер_Итоги = Новый ТаблицаЗначений; 
	Контекст.Контейнер_Итоги = ТЗКонтейнер_Итоги.Добавить();		
	// Свойство, хранящее тип контейнера 
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "Тип_", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(8));
	Контекст.Контейнер_Итоги.Тип_ = "ИТОГИ";
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "НомерТекущейСтроки", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(5),0);
	//Для группировок:
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущаяСК");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийВидБСО");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийПоставщик");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийОрганизацияАгент");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийСтраховойПродукт");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийВидСП");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Итоги, "ТекущийДокумент");
	// №№№№№  Контейнер Свойств Документа   №№№№
	ТЗКонтейнер_Документ = Новый ТаблицаЗначений;
	Контекст.Контейнер_Документ = ТЗКонтейнер_Документ.Добавить();
	Для Каждого Реквизит из Контекст.Объект.Метаданные().Реквизиты Цикл
		ТЗКонтейнер_Документ.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);	
		Контекст.Контейнер_Документ[Реквизит.Имя] = Контекст.Объект[Реквизит.Имя]; 	
	КонецЦикла;
	Если Контекст.Свойство("ЭтоПФСубагент") И Контекст.ЭтоПФСубагент Тогда
		// меняем типы колонок и значения данных
		Колонка = ТЗКонтейнер_Документ.Колонки.Найти("Поставщик");
		ТЗКонтейнер_Документ.Колонки.Удалить(Колонка);
		Колонка = ТЗКонтейнер_Документ.Колонки.Найти("ОрганизацияАгент");
		ТЗКонтейнер_Документ.Колонки.Удалить(Колонка);
		ТЗКонтейнер_Документ.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ТЗКонтейнер_Документ.Колонки.Добавить("ОрганизацияАгент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		Контекст.Контейнер_Документ.Поставщик 			= Контекст.Объект.ОрганизацияАгент;
		Контекст.Контейнер_Документ.ОрганизацияАгент 	= Контекст.Субагент;
	КонецЕсли;
	// Свойство, хранящее тип контейнера 
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "Тип_", "ДОКУМЕНТ", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(8));
	//Даты и Номера нет в реквизитах	
	ДлинаНомера = Контекст.Объект.Метаданные().ДлинаНомера;
	Если Строка(Контекст.Объект.Метаданные().ТипНомера) = "Число" Тогда
		ОписТипаНом = ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(ДлинаНомера);
	Иначе
		ОписТипаНом = ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(ДлинаНомера);
	КонецЕсли;
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "Дата", Контекст.Объект.Дата, ОбщегоНазначения.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
	ДобавитьСвойствоВКонтейнер(Контекст.Контейнер_Документ, "Номер", Контекст.Объект.Номер, ОписТипаНом);	
	//ТОДО  перессмотреть, возможно уйти от этих свойств в Контексте - они есть в контейнере документа и в объекте.
	// а в коде и при формировании имен параметров мы всегда занем, что у нас есть в документе.
	
	//Добавляем искусственные свойства
	//Требуется для корректной отработки функции заполнения параметров макета
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Документ, "ЛицоНаше");
	ДобавитьСвойствоВТЗ(ТЗКонтейнер_Документ, "ЛицоИх");
	//Инициализируем переменные контекста, характерные для документов с поставщиками и оргагентами
	бЕстьПоставщик = ОбщегоНазначения.ЕстьРеквизит("Поставщик", Контекст.Объект);
	бЕстьОргАгент = ОбщегоНазначения.ЕстьРеквизит("ОрганизацияАгент", Контекст.Объект);
	Если Контекст.Свойство("ЭтоПФСубагент") И Контекст.ЭтоПФСубагент Тогда
		Контекст.Поставщик 			= ?(бЕстьОргАгент, Контекст.Объект.ОрганизацияАгент, Справочники.Организации.ПустаяСсылка());
		Контекст.ОрганизацияАгент   = Контекст.Субагент;
	Иначе
		Контекст.Поставщик = ?(бЕстьПоставщик, Контекст.Объект.Поставщик, Справочники.Контрагенты.ПустаяСсылка());
		Контекст.ОрганизацияАгент = ?(бЕстьОргАгент, Контекст.Объект.ОрганизацияАгент, Справочники.Организации.ПустаяСсылка());
	КонецЕсли;
	ОтвЛицо_Руководитель = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;
	Если бЕстьОргАгент Тогда
		Контекст.Контейнер_Документ.ЛицоНаше = ДайРуководителя(Контекст.ОрганизацияАгент, Контекст.Объект.Дата, Контекст.Предупреждать);
		Контекст.ЛицоНаше = Контекст.Контейнер_Документ.ЛицоНаше;
	КонецЕсли;
	Если бЕстьПоставщик Тогда
		Контекст.Контейнер_Документ.ЛицоИх = ДайОтветственноеЛицоКонтрагента(ОтвЛицо_Руководитель, Контекст.Поставщик, Контекст.ОрганизацияАгент, Контекст.Объект.Дата, Контекст.Объект);
		Контекст.ЛицоИх = Контекст.Контейнер_Документ.ЛицоИх;
	КонецЕсли;
    ////////////////////////////////////////////////////////////////////
	//Контекст.Контейнер_Документ = СтруктураКонтейнерДокументПоСтрокеТЗ(Контекст.КонтейнерДокумент)
	Контекст.ТекущаяОбластьТД = Контекст.Макет;
	Контекст.ИмяТекущейОбластиТД = "#";
	отладка_Общее(Контекст);
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры

Функция КлонироватьКонтекст(Контекст) Экспорт
	
	Клон = Новый Структура();
	Для Каждого Эл из Контекст Цикл
		Клон.Вставить(Эл.Ключ,Эл.Значение);
	КонецЦикла;
	Возврат Клон;
	
КонецФункции

//Получает область макета и выполняет функцию отладки
Функция ПолучитьОбласть(Контекст, ИмяОбласти, Макет = Неопределено) Экспорт
	отладка_Лог_НачалоПроцедуры(Контекст, "ПолучитьОбласть ('" + ИмяОбласти + "')");	
	
	Если Макет = Неопределено Тогда
		Макет = Контекст.Макет;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяОбласти) Тогда
		ИмяОбласти = "#";
	КонецЕсли;
	
	Если ИмяОбласти = "#" Тогда
		ТекущаяОбластьТД = Макет;
	Иначе
		Если Макет.Области.Найти(ИмяОбласти) <> Неопределено Тогда
			ТекущаяОбластьТД = Макет.ПолучитьОбласть(ИмяОбласти);
		Иначе
			ТекущаяОбластьТД = Неопределено;
		КонецЕсли;
	КонецЕсли;
	Контекст.ТекущаяОбластьТД = ТекущаяОбластьТД;
	Контекст.ИмяТекущейОбластиТД = ИмяОбласти;
	отладка_Общее(Контекст);
	
	отладка_Лог_КонецПроцедуры(Контекст);	

	Возврат ТекущаяОбластьТД;
КонецФункции	

//******************************************************************************
//     Функции, вызываемые из модуля объекта
//******************************************************************************

//******************************************************************************
//     ПСП 2-й УРОВЕНЬ детализации
//******************************************************************************

//Заполняет заданную область значениями параметров и вываодит в результат (Стандартный набор параметров)
Функция ПСП(Контекст, ИмяОбласти, Предупреждать = Истина, Макет = Неопределено, ОсновнойКонтейнер = "ДОКУМЕНТ") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП (Область: '" + ИмяОбласти + "', Котейнер: '" + ОсновнойКонтейнер + "')");	
	Если Предупреждать Тогда
		//все предупреждения только на отдел БСО
		Предупреждать = ПараметрыСеанса.уб_ОсновноеПодразделение = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО
	КонецЕсли;
	Область = ПолучитьОбласть(Контекст, ИмяОбласти, Макет);
	Если Область = Неопределено Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	ПСП_ДокументовДляПоставщика(Контекст, Предупреждать, ОсновнойКонтейнер);
	
	Если Контекст.ИмяОбъекта = "уб_ЗаявкаНаПечать" Тогда		
		ТЗГрупп = Неопределено;
		
		ЗаполнитьВспомогательныеМассивы(ТЗГрупп);
		Для Каждого СтрокаТЗ Из ТЗГрупп Цикл
			ПрерватьЦикл = Ложь;
			Если СтрокаТЗ.Тип <> "" Тогда
				Для Каждого ОбластьМакета Из Макет.Области Цикл
					Если ТипЗнч(ОбластьМакета) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
						_Область = Макет.ПолучитьОбласть(ОбластьМакета.Имя);
						Для Каждого Рисунок Из _Область.Рисунки Цикл
							Если СтрокаТЗ.БратьЗначениеИзРисунка = Рисунок.Имя Тогда
								СтрокаТЗ.Значение 			= Рисунок[СтрокаТЗ.Тип];
								СтрокаТЗ.ЗначениеЗаполнено  = Истина;
								ПрерватьЦикл = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					Если ПрерватьЦикл Тогда
						Прервать
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		ЛинияНетЛинии = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		Для Каждого Рисунок Из Область.Рисунки Цикл
			Если Лев(Рисунок.Имя, 10) = "Скрываемое" Тогда
				Рисунок.ВыводитьНаПечать = ЛОЖЬ;
			КонецЕсли;	
			//	//СкрываемыеЭлементыФормы.Добавить(Рисунок);
			//Иначе	
				Если Рисунок.ТипРисунка = ТипРисункаТабличногоДокумента.Текст Тогда
					
					//Если Не Рисунок.Имя = "скрСерия" Тогда
						
						Рисунок.Линия = ЛинияНетЛинии;
						Для Каждого СтрокаТЗ Из ТЗГрупп Цикл
							Для Каждого ИмяРисунка Из СтрокаТЗ.Массив Цикл
								Если ИмяРисунка = Рисунок.Имя Тогда
									Если СтрокаТЗ.ЗначениеЗаполнено Тогда
										Рисунок[СтрокаТЗ.Тип] = СтрокаТЗ.Значение;
									Иначе
										//аа = 12;
									КонецЕсли;
									Рисунок.Верх = Рисунок.Верх + СтрокаТЗ.Верх;
									Рисунок.Лево = Рисунок.Лево + СтрокаТЗ.Лево;
								КонецЕсли;
							КонецЦикла;
						КонецЦикла;
					//Иначе
					//	;
					//КонецЕсли;
                    ВремСтрока = ""+Рисунок.Текст;
					СвойствоИлиМассив = ПолучитьМассивФункций(Контекст, ВремСтрока);
					//Возвращает строку, если это просто параметр, или массив, 
					//в котором первый элемент Имя функции, 
					//последующие параметры элемент значение параметра,
					//если параметром является функция, то возвращается массив с аналогичной структурой элементов
					ТипЗнчСвойствоИлиМассивСтрока = ТипЗнч(СвойствоИлиМассив) = Тип("Строка");
					                                         
					//Если Рисунок.Имя = "ДатаЗаполненияЗаявленияГод2" тогда
					//	Рисунок.Параметр = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, СвойствоИлиМассив, ТипЗнчСвойствоИлиМассивСтрока);
					//КонецЕсли;
					
					Рисунок.Параметр = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, СвойствоИлиМассив, ТипЗнчСвойствоИлиМассивСтрока);
				КонецЕсли;
			//КонецЕсли;
		КонецЦикла;
		ЭтоЗаявлениеОСАГО = Контекст.СтруктураОбъектаПФ.Наименование = "Заявление ОСАГО";
		Если ЭтоЗаявлениеОСАГО Тогда
			ДопТекст 		= "ВидИспользованияТС";
			СЗ = Новый СписокЗначений;
			СЗ.Добавить("Личное");
			СЗ.Добавить("Учебная");
			СЗ.Добавить("Такси");
			СЗ.Добавить("ДорожныеИСпециальныеТС", "Дорожные и специальные ТС");
			СтрокаСЗ = НайтиЭлементСпискаПоПредставлению2(СЗ, Контекст.ДанныеЗаявки.ВидИспользованияТС);
			Если СтрокаСЗ = Неопределено Тогда
				ВидИспользованияТС = "Прочее";
			Иначе
				ВидИспользованияТС = СтрокаСЗ.Значение;
			КонецЕсли;
			Область.Области[ДопТекст + ВидИспользованияТС].Шрифт = Новый Шрифт(Область.Области[ДопТекст + ВидИспользованияТС].Шрифт,,,,, Истина);
			ДопТекст = ДопТекст + "Аренда";
			СЗ = Новый СписокЗначений;
			СЗ.Добавить("Аренда");
			СЗ.Добавить("Прочее");
			СтрокаСЗ = НайтиЭлементСпискаПоПредставлению2(СЗ, Контекст.ДанныеЗаявки.ВидИспользованияТС);
			Если СтрокаСЗ = Неопределено Тогда
				ВидИспользованияТС = "Прочее";
			Иначе
				ВидИспользованияТС = СтрокаСЗ.Значение;
			КонецЕсли;
			Область.Области[ДопТекст + ВидИспользованияТС].Шрифт = Новый Шрифт(Область.Области[ДопТекст + ВидИспользованияТС].Шрифт,,,,, Истина);				
		КонецЕсли;
	КонецЕсли;
	
	Контекст.ТабличныйДокумент.Вывести(Область);
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);
	
	Возврат Область;
КонецФункции

Процедура ЗаполнитьВспомогательныеМассивы(ТЗГрупп)
		ТЗГрупп = Новый ТаблицаЗначений;
		ТЗГрупп.Колонки.Добавить("Массив", 					Новый ОписаниеТипов("Массив"));
		ТЗГрупп.Колонки.Добавить("Тип",						Новый ОписаниеТипов("Строка")); // если не заполнено, выравнивание не происходит
		ТЗГрупп.Колонки.Добавить("Значение",				Новый ОписаниеТипов("Число"));
		ТЗГрупп.Колонки.Добавить("ЗначениеЗаполнено",   	Новый ОписаниеТипов("Булево"));
		ТЗГрупп.Колонки.Добавить("БратьЗначениеИзРисунка",	Новый ОписаниеТипов("Строка"));
		// сдвиг группы картинок
		ТЗГрупп.Колонки.Добавить("Верх",					Новый ОписаниеТипов("Число"));
		ТЗГрупп.Колонки.Добавить("Лево",					Новый ОписаниеТипов("Число"));
		//
		СтрокаТЗ = ТЗГрупп.Добавить();
		Массив = Новый Массив;
		Массив.Добавить("Часов1");
		Массив.Добавить("Часов2");
		Массив.Добавить("Минут1");
		Массив.Добавить("Минут2");
		Массив.Добавить("НачалоДействия111");
		Массив.Добавить("НачалоДействия112");
		Массив.Добавить("НачалоДействия113");
		Массив.Добавить("НачалоДействия114");
		Массив.Добавить("НачалоДействия115");
		Массив.Добавить("НачалоДействия116");
		СтрокаТЗ.Массив 				= Массив;
		СтрокаТЗ.Тип					= "Верх";
		СтрокаТЗ.БратьЗначениеИзРисунка = Массив[0];
		СтрокаТЗ.Верх = 0;
		СтрокаТЗ.Лево = 0;
		//
		СтрокаТЗ = ТЗГрупп.Добавить();
		Массив = Новый Массив;
		Массив.Добавить("НачалоДействия11");
		Массив.Добавить("НачалоДействия12");
		Массив.Добавить("НачалоДействия13");
		Массив.Добавить("НачалоДействия14");
		Массив.Добавить("НачалоДействия15");
		Массив.Добавить("НачалоДействия16");
		Массив.Добавить("НачалоДействия21");
		Массив.Добавить("НачалоДействия22");
		Массив.Добавить("НачалоДействия23");
