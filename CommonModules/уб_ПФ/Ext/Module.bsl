Функция ДайАргумент_Падеж(Контекст, мАрг, ИмяФункции, НомерАргумента, ПоУмолчанию = "Именительный", Обязательный = Ложь)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_Падеж");		
	Падеж_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, НомерАргумента, "<ПАДЕЖ>", ПоУмолчанию, Обязательный));
	Падеж = Найти("ИРДВТП",ВРег(Лев(Падеж_,1)));
	Если Падеж = 0 Тогда
		Падеж = Найти("ИРДВТП",ВРег(Лев(ПоУмолчанию,1))); //по умолчанию
		СОО = "В функцию '" + ИмяФункции + "' передан неверный " + НомерАргумента + "-й аргумент <ПАДЕЖ>: """ + Падеж_ + """.
		|		Должно быть полное название или сокращенное (вплоть до 1 буквы) название падежа. (Использовано '" + ПоУмолчанию + "').";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Падеж;
	
КонецФункции

Функция ДайАргумент_Типа_Число(Контекст, мАрг, ИмяФункции, НомерАргумента, ЧИСЛО_)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_Типа_Число");		
	Рез = Истина;
	ЧИСЛО_ = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[НомерАргумента - 1], Истина);
	Если ТипЗнч(ЧИСЛО_) = Тип("Строка") Тогда
		Попытка
			ЧИСЛО_ = Число(ЧИСЛО_);
		Исключение
			СОО = "В функцию '" + ИмяФункции + "' передан " + НомерАргумента + "-й аргумент, который не может быть представлен в виде числа: """ + Строка(ЧИСЛО_) + """.";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
			Рез = Ложь;
			Перейти ~НаВыход;	
		КонецПопытки;   
	КонецЕсли;		
	Если ТипЗнч(ЧИСЛО_) <> Тип("Число") Тогда
		СОО = "В функцию '" + ИмяФункции + "' передан " + НомерАргумента + "-й аргумент типа '" + ТипЗнч(ЧИСЛО_) + "'. Допустим тип 'Число' или строка, приводимая к типу 'Число'.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Рез = Ложь;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ДайАргумент_Типа_СправочникОрганизация(Контекст, мАрг, ИмяФункции, НомерАргумента, Организация)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ДайАргумент_Типа_СправочникОрганизация");		
	Рез = Истина;	
	Организация = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[НомерАргумента - 1], Истина);
	ТипЗ = ТипЗнч(Организация);
	Если ТипЗ <> Тип("СправочникСсылка.Организации") Тогда
		СОО = "В функцию '" + ИмяФункции + "' передан " + НомерАргумента + "-й аргумент <ОРГАНИЗАЦИЯ-ПАРТНЕР> неверного типа типа '" + ТипЗ + "'. Допустим тип справочника Организаций.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Рез = Ложь;
		Перейти ~НаВыход;	
	КонецЕсли;	
	Если ЗначениеНеЗаполнено(Организация) Тогда
		СОО = "В функцию '" + ИмяФункции + "' передан пустой " + НомерАргумента + "-й аргумент <ОРГАНИЗАЦИЯ-ПАРТНЕР> (обязательный).";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
		Рез = Ложь;
		Перейти ~НаВыход;	
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

