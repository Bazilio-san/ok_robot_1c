Процедура отладка_Общее(Контекст)	
	Если Контекст.Отладка.Включена Тогда
		Если Контекст.ТекущаяОбластьТД = Неопределено Тогда
			Сообщить("Область '" + Контекст.ИмяТекущейОбластиТД + "' не найдена!");	
		КонецЕсли;
		//Показываем незадействованные места подстановки в режиме отладки
		ПараметрыОбластиПечати = Контекст.ТекущаяОбластьТД.Параметры;
		Для i = 0 По ПараметрыОбластиПечати.Количество() - 1 Цикл
			ПараметрыОбластиПечати.Установить(i, "#########################");	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры	

Процедура отладка_ПФ(Контекст, сОписаниеОшибки = "", СОО = "", Статус = Неопределено, Уровень = 0) Экспорт 
	
	//Процедура должна вызываться из всех мест, где могут возникать ошибки и несуразности
	//Результат выполнения функций заполнения параметра передается в параметр
	//в обычном режиме - результат
	//в режиме отладки - результат
	Если Контекст = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	Если Статус = Неопределено Тогда
		Статус = СтатусСообщения.БезСтатуса;	
		чСтатус = 0; //
	ИначеЕсли Статус = СтатусСообщения.Информация Тогда
		чСтатус = 1; //i
