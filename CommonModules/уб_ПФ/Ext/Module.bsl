Процедура ДобавитьСвойствоВТЗ(ТЗ, ИмяСвойства, ОписаниеТипаСвойства = Неопределено,ЗначениеЗаполнения = Неопределено);
	
	Если ТЗ.Колонки.Найти(ИмяСвойства) = Неопределено Тогда
		ТЗ.Колонки.Добавить(ИмяСвойства, ОписаниеТипаСвойства);	
	Иначе
		Если НЕ ЗначениеЗаполнения  = Неопределено Тогда
			ТЗ.ЗаполнитьЗначения(ЗначениеЗаполнения,ИмяСвойства);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура ДобавитьСвойствоВКонтейнер(Контейнер, ИмяСвойства, ЗначениеСвойства = Неопределено, ОписаниеТипаСвойства = Неопределено) Экспорт	
	
	Если ТипЗнч(Контейнер) = Тип("СтрокаТаблицыЗначений") Тогда
		ТЗ = Контейнер.Владелец();
		ДобавитьСвойствоВТЗ(ТЗ, ИмяСвойства, ОписаниеТипаСвойства);
		Контейнер[ИмяСвойства] = ЗначениеСвойства; 
	Иначе
		// структура
		Если Не Контейнер.Свойство(ИмяСвойства) Тогда
			Контейнер.Вставить(ИмяСвойства);
		КонецЕсли;
		Контейнер[ИмяСвойства] = ЗначениеСвойства;
	КонецЕсли;
		
КонецПроцедуры	

Процедура УстановитьТекущийКонтейнер(Контекст, ТипКонтейнера, СтрокаТЗ)
	отладка_Лог_НачалоПроцедуры(Контекст, "УстановитьТекущийКонтейнер");	
	
	Если ВРег(ТипКонтейнера) = "ДОКУМЕНТ" Тогда
		// TODO на всякий случай только для новой системы, потом убрать это условие
		// попробовать перейти на структуру на самом ранеем уровне
		Контекст.Контейнер_Документ = СтрокаТЗ;
	ИначеЕсли ВРег(ТипКонтейнера) = "ИТОГИ" Тогда
		Контекст.Контейнер_Итоги = СтрокаТЗ;
		Контекст.Контейнер = Контекст.Контейнер_Итоги;
	ИначеЕсли ВРег(ТипКонтейнера) = "СТРОКАТЧ" Тогда
		Контекст.Контейнер_СтрокаТЧ = СтрокаТЗ;
		Контекст.Контейнер 			= Контекст.Контейнер_СтрокаТЧ;
	Иначе
		//Порождаем ошибку, мимо которой не пройти
		Выполнить("Проверка = Контекст.Контейнер_"+ТипКонтейнера+";");		
		Перейти ~НаВыход;	
	КонецЕсли;
	ДобавитьСвойствоВКонтейнер(СтрокаТЗ, "Тип_", ВРег(ТипКонтейнера), ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(8));
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
КонецПроцедуры

Функция СтруктураКонтейнерДокументПоСтрокеТЗ(СтрокаТЗ)

	Результат = Новый Структура;
	ТЗ = СтрокаТЗ.Владелец;
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Результат, СтрокаТЗ);
	Возврат Результат;

КонецФункции // СтруктураКонтейнерДокументПоСтрокеТЗ()

