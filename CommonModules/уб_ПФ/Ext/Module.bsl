Функция Город(Контекст, мАрг)
	
	//(<Контрагент>)
	ИмяФункции = "Город";
	отладка_Лог_НачалоПроцедуры(Контекст, "Город");	
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 1) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	Контрагент = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
	Если НЕ (ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") ИЛИ 
		 ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации")) Тогда
		СОО = "В функцию 'Город' передан аргумент типа '" + ТипЗнч(Контрагент) + "'. Допустим тип 'СправочникСсылка.Контрагенты'.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
	Иначе
		мЗапрос = Новый Запрос;
        
        мЗапрос.УстановитьПараметр("Объект", Контрагент);
        мЗапрос.УстановитьПараметр("Вид"   , ?(ТипЗнч(Контрагент)=Тип("СправочникСсылка.Организации"), 
		                           Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации, Справочники.ВидыКонтактнойИнформации.АдресКонтрагентаФактический));
        
        мЗапрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |       КонтактнаяИнформация.Поле2 КАК Регион,
        |       КонтактнаяИнформация.Поле3 КАК Район,
        |       КонтактнаяИнформация.Поле4 КАК Город,
        |       КонтактнаяИнформация.Поле5 КАК НаселенныйПункт,
        |       КонтактнаяИнформация.Поле6 КАК Улица,
        |       КонтактнаяИнформация.Поле7 КАК Дом,
        |       КонтактнаяИнформация.Поле8 КАК Корпус,
        |       КонтактнаяИнформация.Представление
        |ИЗ
        |       РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
        |ГДЕ
        |       КонтактнаяИнформация.Объект = &Объект
        |       И КонтактнаяИнформация.Вид = &Вид";
        РезультатЗапроса = мЗапрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() Тогда 
			Рез = ""+?(ЗначениеЗаполнено(РезультатЗапроса.Город), РезультатЗапроса.Город, РезультатЗапроса.Регион)+"";
			мДлинна = СтрДлина(Рез);
			Рез = "г. "+СокрЛП(Лев(Рез, мДлинна-2))+"";
		Иначе 
			Рез = "";
		КонецЕсли;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции
//чкн

Функция СуммаПрописью(Контекст, мАрг)
	
	//(<ЧИСЛО>, <ВАЛЮТА>*, <ФОРМАТНАЯ СТРОКА>*)
	ИмяФункции = "СуммаПрописью";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если Не	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 4) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	ЧИСЛО_ = Неопределено;
	Если Не ДайАргумент_Типа_Число(Контекст, мАрг, ИмяФункции, 1, ЧИСЛО_) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 2-й аргумент <ВАЛЮТА>*
	Валюта = ОбщегоНазначения.ПолучитьВалютуРубли();  //по умолчанию - рубли
	Если мАрг.Количество() > 1 Тогда
		Валюта = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[1], Не ПустаяСтрока(мАрг[1]));
		Если ТипЗнч(Валюта) <> Тип("СправочникСсылка.Валюты") Или Не ЗначениеЗаполнено(Валюта) Тогда
			//Ищем валюту в справочнике валют
			ВалютаРубли = ОбщегоНазначения.ПолучитьВалютуРубли();
			Если Не ЗначениеЗаполнено(Валюта) Тогда
				СОО = "В функцию 'СуммаПрописью' передано пустое значение валюты. Использована валюта 'RUB'.";
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Информация, 0+1);
				Валюта = ВалютаРубли;	
			ИначеЕсли Строка(Валюта) = ВалютаРубли.Наименование Тогда
				Валюта = ВалютаРубли;	
			Иначе	
		 		вхВалюта = Строка(Валюта);
		 		стрВалюта = ВРег(вхВалюта);				
				Валюта = Справочники.Валюты.НайтиПоКоду(стрВалюта);
				Если Не ЗначениеЗаполнено(Валюта) Тогда
					Валюта = Справочники.Валюты.НайтиПоРеквизиту("КодС", стрВалюта);
					Если Не ЗначениеЗаполнено(Валюта) Тогда
						Валюта = Справочники.Валюты.НайтиПоНаименованию(стрВалюта);
						Если Не ЗначениеЗаполнено(Валюта) Тогда
							//Если не находим валюту, сообщаем 
							//ТОДО проверить!
							СОО = "В функцию 'СуммаПрописью' передана неизвестная валюта '" + вхВалюта + "'. Использована валюта 'RUB'.";
							отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
							Валюта = ВалютаРубли;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	// 3-й аргумент <ФОРМАТНАЯ СТРОКА>*
	ФорматнаяСтрока = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<ФОРМАТНАЯ СТРОКА>", ФорматнаяСтрока));
	Если ПустаяСтрока(ФорматнаяСтрока) Тогда
		ФорматнаяСтрока = "Л = ru_RU; НП = Истина; НД = Истина; ДП = Истина";
	КонецЕсли;
	// 4-й аргумент <ПАРАМЕТРЫ ПРЕДМЕТА ИСЧИСЛЕНИЯ>*
	//запятая в ПФ заменяется символом ";"
	ППИ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 4, "<ПАРАМЕТРЫ ПРЕДМЕТА ИСЧИСЛЕНИЯ>")); 
	Если ПустаяСтрока(ППИ) Тогда
		ППИ = Валюта.ПараметрыПрописиНаРусском;
	Иначе
		ППИ = СтрЗаменить(ППИ, ";", ",");
	КонецЕсли;
	Рез = ЧислоПрописью(ЧИСЛО_, ФорматнаяСтрока, ППИ);
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция Окр_(Контекст, мАрг)
	
	//(<ЧИСЛО>, <РАЗРЯДНОСТЬ>*, <РЕЖИМ ОКРУГЛЕНИЯ>*)
	ИмяФункции = "Окр";
	отладка_Лог_НачалоПроцедуры(Контекст, "Окр_");		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 3) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 1-й аргумент <АРГ>
	ЧИСЛО_ = Неопределено;
	Если НЕ ДайАргумент_Типа_Число(Контекст, мАрг, ИмяФункции, 1, ЧИСЛО_) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 2-й аргумент <РАЗРЯДНОСТЬ>*
	РазрядностьОкругл = 2;  //по умолчанию
	Разрядность_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<РАЗРЯДНОСТЬ>",РазрядностьОкругл));
	Попытка
		//Если строка аргумента - число, то используем его как есть
		РазрядностьОкругл = Число(Разрядность_);
	Исключение
		СОО = "В функцию 'Окр' передан 2-й аргумент <РАЗРЯДНОСТЬ>, который не может быть представлен в виде числа: """ 
		+ Строка(Разрядность_) + """ (Использовано 2).";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецПопытки;   	
	// 3-й аргумент <РЕЖИМ ОКРУГЛЕНИЯ>*
	РежимОкругл = РежимОкругления.Окр15как20; //по умолчанию
	РО_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<РЕЖИМ ОКРУГЛЕНИЯ>","ОКР15КАК20"));
	РО = ВРег(РО_);
	Если РО = "0" ИЛИ РО = "ОКР15КАК10" Тогда
		РежимОкругл = РежимОкругления.Окр15как10;	
	ИначеЕсли РО = "1" ИЛИ РО = "ОКР15КАК20" Тогда
		//	
	Иначе
		СОО = "В функцию 'Окр' передан неправильный 3-й аргумент <РЕЖИМ ОКРУГЛЕНИЯ>: """ + РО_ + """. (Использовано Окр15как20)";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Обычное, 0+1);
	КонецЕсли;	
	Рез = Окр(ЧИСЛО_, РазрядностьОкругл, РежимОкругл);
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ДФ(Контекст, мАрг)
	
	//(<ДАТА>, <ФОРМАТНАЯ СТРОКА ДАТЫ>*)
	ИмяФункции = "ДФ";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);	
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 2) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	ДАТА_ = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
	Если ТипЗнч(ДАТА_) <> Тип("Дата") Тогда
		//СОО = "В функцию 'ДФ' передан аргумент типа '" + ТипЗнч(ДАТА_) + "'. Допустим тип 'Дата'.";
		//отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Рез = ДАТА_;
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 3-й аргумент <Я САМ ВВЕДУ ФОРМАТНУЮ СТРОКУ>
	БезОбработки = ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "asddaf");
	Если НРег(Лев(БезОбработки, 1)) = "и" Тогда
		ФорматнаяСтрока = мАрг[1];
	Иначе
		// 2-й аргумент <ФОРМАТНАЯ СТРОКА ДАТЫ>*
		ФорматнаяСтрока = ДайАргумент_ФорматнаяСтрокаДаты(Контекст, мАрг, ИмяФункции, 2);	
	КонецЕсли;
	Рез = Формат(ДАТА_, ФорматнаяСтрока);
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез; 
	
КонецФункции

Функция ЧФ(Контекст, мАрг)
	
	//(<ЧИСЛО>, <ФОРМАТНАЯ СТРОКА>*)
	ИмяФункции = "ЧФ";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 2) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	ЧИСЛО_ = Неопределено;
	Если НЕ ДайАргумент_Типа_Число(Контекст, мАрг, ИмяФункции, 1, ЧИСЛО_) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 2-й аргумент <ФОРМАТНАЯ СТРОКА>*
	ФрматнаяСтрока = Контекст.ЧФ; //по умолчанию
	ФС_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<ФОРМАТНАЯ СТРОКА>",ФрматнаяСтрока));
	ФСН = НРег(ФС_);
	Если ФСН = "" ИЛИ ФСН = "стд" Тогда
		//используем по умолчанию	
	ИначеЕсли ФСН = "процент" Тогда
		Рез = Строка(ЧИСЛО_) + "%";
		Перейти ~НаВыход;	
	Иначе 	
 		ФрматнаяСтрока = ФС_;
	КонецЕсли;	
	Рез = Формат(ЧИСЛО_, ФрматнаяСтрока);	
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция Наименование(Контекст, мАрг)
	
	//(<АРГ>, <ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>*, <ПРЕДСТАВЛЕНИЕ ЮРЛИЦА>*, <ПАДЕЖ>*)
	ИмяФункции = "Наименование";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 4) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 1-й аргумент <АРГ>
	АРГ = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
	ТипЗ = ТипЗнч(АРГ);
	Если ТипЗ = Тип("СправочникСсылка.Организации") ИЛИ ТипЗ = Тип("СправочникСсылка.Контрагенты") Тогда
		бЮрлицо = Истина;
	ИначеЕсли ТипЗ = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		бЮрлицо = Ложь;
	ИначеЕсли ТипЗ = Тип("СправочникСсылка.КонтактныеЛица") Тогда
		бЮрлицо = Ложь;
	ИначеЕсли ТипЗ = Тип("Строка") Тогда
		//бЮрлицо = Ложь;
		//если передана строка - возвращаем ее не в измененном виде
		Рез = Арг;
		Перейти ~НаВыход
	Иначе
		СОО = "В функцию 'Наименование' передан 1-й аргумент типа '" + ТипЗ + "'. Допустимы типы справочников Организаций, Контрагентов, Физлиц.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 2-й аргумент <ПРЕДСТАВЛЕНИЕ ФИЗЛИЦА>*
	ФИОКратко = ДайАргумент_ПредставлениеФизлица(Контекст, мАрг, ИмяФункции, 2, "Кратко");		
	// 4-й аргумент <ПАДЕЖ>*
	Падеж = ДайАргумент_Падеж(Контекст, мАрг, ИмяФункции, 4);	
	Если бЮрлицо Тогда
		// 3-й аргумент <ПРЕДСТАВЛЕНИЕ ЮРЛИЦА>*
		ТипНаименЮрлица = ДайАргумент_ПредставлениеЮрлица(Контекст, мАрг, ИмяФункции, 3, "Кратко");
		Рез = ДайНаименованиеКонтрагента(АРГ, Контекст.Объект.Дата, ФИОКратко, ТипНаименЮрлица, Падеж);
	Иначе
		Рез = уб_Кэшируемые.ФИОФизлицаСтрокой(АРГ, Контекст.Объект.Дата, ФИОКратко, Падеж);
	КонецЕсли;
	// 5-й аргумент  - Ф, И, О, (без учета падежей и кратко/полно!), по умолчанию - как обычно	
	Если Не бЮрлицо Тогда
		РаздИм = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 5, "<РаздИм>")));		
		Запрос = Новый Запрос;
		Если ТипЗ = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
			ТекстЗапроса = "ВЫБРАТЬ
			|	ФИОФизЛицСрезПоследних.Фамилия,
			|	ФИОФизЛицСрезПоследних.Имя,
			|	ФИОФизЛицСрезПоследних.Отчество
			|ИЗ
			|	РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
			|ГДЕ
			|	ФИОФизЛицСрезПоследних.ФизЛицо = &ФизЛицо";
		ИначеЕсли ТипЗ = Тип("СправочникСсылка.КонтактныеЛица") Тогда
			ТекстЗапроса = "ВЫБРАТЬ
			|	КонтактныеЛица.Фамилия,
			|	КонтактныеЛица.Имя,
			|	КонтактныеЛица.Отчество
			|ИЗ
			|	Справочник.КонтактныеЛица КАК КонтактныеЛица
			|ГДЕ
			|	КонтактныеЛица.Ссылка = &ФизЛицо";
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ФизЛицо", АРГ);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если РаздИм = "ф" Или РаздИм = "фамилия" Тогда
				Рез = Выборка.Фамилия;
			ИначеЕсли РаздИм = "и" или РаздИм = "имя" Тогда
				Рез = Выборка.Имя;
			ИначеЕсли РаздИм = "о" Или РаздИм = "отчество" Тогда
				Рез = Выборка.Отчество;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез; 
	
КонецФункции

Функция СЗП(Контекст, мАрг)
	
	//(<СЛОВО>, <ФИЗЛИЦО>)
	ИмяФункции = "СЗП";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 2, 2) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 1-й аргумент <СЛОВО>
	СЛОВО = ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<СЛОВО>");
	Если НЕ ЗначениеЗаполнено(СЛОВО) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;	
	// 2-й аргумент <ФИЗЛИЦО>
	ФИЗЛИЦО = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[1], Истина);
	ТипЗ = ТипЗнч(ФИЗЛИЦО);	
	Если ТипЗ <> Тип("СправочникСсылка.ФизическиеЛица") И ТипЗ <> Тип("Строка") И ТипЗ <> Тип("СправочникСсылка.КонтактныеЛица") Тогда
		СОО = "В функцию 'СЗП' передан 2-й аргумент <ФИЗЛИЦО> типа '" + ТипЗ + "'. Допустим тип справочника Физлиц, Контактных лиц, строка";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
	ИначеЕсли ЗначениеНеЗаполнено(ФИЗЛИЦО) Тогда
		//ТОДО Переделать на нейтральное название
		СОО = "В функцию 'СЗП' передан пустой 2-й аргумент <ФИЗЛИЦО>.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
	КонецЕсли;
	Рез =  ДайСловоЗависимоеОтПолаФизлица(ФИЗЛИЦО, СЛОВО, Контекст.Предупреждать);
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

//по получении данных контрагентов 2ой параметр совершенно игнорируется
Функция ОтветственноеЛицо(Контекст, мАрг)
	
	//ВАРИАНТ 1:
	//ОТВЕТСТВЕННОЕЛИЦО(<ВИДЗНАЧЕНИЯ>, <ОТВЕТСТВЕННОЕЛИЦО>, <ОРГАНИЗАЦИЯ>, <КОНТРАГЕНТ>, <ПРЕДСТАВЛЕНИЕ ДОЛЖНОСТИ>*)
	// если тип ОРГАНИЗАЦИЯ - организация, то параметр контрагент игнорируется
	//ВАРИАНТ 2:
	//ОТВЕТСТВЕННОЕЛИЦО(<ВИДЗНАЧЕНИЯ>, <ОТВЕТСТВЕННОЕЛИЦО>, <КОНТРАГЕНТ>, <ОРГАНИЗАЦИЯ-ПАРТНЕР>, <ПРЕДСТАВЛЕНИЕ ДОЛЖНОСТИ>*)
	ИмяФункции = "ОтветственноеЛицо";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 3, 4) Тогда
		//ТОДО проверить совместно с др функциями
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <ВИДЗНАЧЕНИЯ>
	ВЗ_ = мАрг[0];
	Вид_Значения = ВРег(Лев(ВЗ_,1));
	// 2-й аргумент <ОТВЕТСТВЕННОЕЛИЦО>
	ОЛ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<ОТВЕТСТВЕННОЕЛИЦО>"));
	// 3-й аргумент <КОНТРАГЕНТ|ОРГАНИЗАЦИЯ>
	КилиО = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[2], Истина);
	ТипЗ = ТипЗнч(КилиО);
	Если Не ЗначениеЗаполнено(КилиО) Тогда
		СОО = "В функцию 'ОтветственноеЛицо' передан пустой 3-й аргумент <КОНТРАГЕНТ|ОРГАНИЗАЦИЯ> (тип '" + ТипЗ + "').";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
		Перейти ~НаВыход;	
	КонецЕсли;
	Если ТипЗ = Тип("СправочникСсылка.Организации") Тогда
		//ВАРИАНТ 1:
		ОЛ = НРег(ОЛ);
		Если Метаданные.Перечисления.ОтветственныеЛицаОрганизаций.ЗначенияПеречисления.Найти(ОЛ) = Неопределено Тогда
			Если ОЛ = "рук"  ИЛИ ОЛ = "" Тогда ОЛ = "Руководитель" 
			ИначеЕсли ОЛ = "гбух" Тогда ОЛ = "ГлавныйБухгалтер"
			ИначеЕсли ОЛ = "бсо" Тогда ОЛ = "ОтветственныйЗаБСО"
			ИначеЕсли ОЛ = "кадровик" Тогда ОЛ = "РуководительКадровойСлужбы"
			ИначеЕсли ОЛ = "уп" Тогда ОЛ = "УполномоченныйПредставитель"
			ИначеЕсли ОЛ = "исп" Тогда ОЛ = "Исполнитель"
			ИначеЕсли ОЛ = "фо" Тогда ОЛ = "ФинОтветственный"		
			Иначе
				СОО = "В функцию 'ОтветственноеЛицо' передан неправильный 2-й аргумент <ОТВЕТСТВЕННОЕЛИЦО>: """ + ОЛ + """. Должно быть одно из:";
				Для Каждого ЗП ИЗ Метаданные.Перечисления.ОтветственныеЛицаОрганизаций.ЗначенияПеречисления Цикл
					СОО = СОО + Символы.ВК + Символы.ПС + "		" + ЗП.Имя;	
				КонецЦикла;
				СОО = СОО + Символы.ВК + Символы.ПС + "Либо сокращения (см. справку)";	
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
				Перейти ~НаВыход;	
			КонецЕсли;
		КонецЕсли;
		ОтветствЛицо = Перечисления.ОтветственныеЛицаОрганизаций[ОЛ];
		Организация = КилиО;
		структураОтвЛицо = ДайОтветственноеЛицоОрганизации(ОтветствЛицо, Организация, Контекст.Объект.Дата, Контекст.Предупреждать);
		ДляОрганизаци = " '" + Строка(ОтветствЛицо) + "' для организации '" + Организация.Наименование 
				+ "' на " + Формат(Контекст.Объект.Дата,"ДФ=dd.MM.yyyy") + ".";
		Если структураОтвЛицо = Неопределено Тогда
			СОО = "Отсутствует ответственное лицо " + ДляОрганизаци;
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
			Перейти ~НаВыход;	
		КонецЕсли;
		Если Вид_Значения = "О" Тогда
			ОснованиеДействия = ОснованиеДействияОтветственногоЛица(структураОтвЛицо, Контекст.Предупреждать);
			Если ОснованиеДействия = Неопределено Тогда
				СОО = "Нет сведений об ОСНОВАНИИ ДЕЙСТВИЯ отв. лица " + ДляОрганизаци;   
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
				Перейти ~НаВыход;	
			Иначе
				Рез = ОснованиеДействия;
				Перейти ~НаВыход;	
			КонецЕсли;
		ИначеЕсли Вид_Значения = "Д" Тогда 
			оДолжность = ОбъектДолжностьОтветственногоЛица(структураОтвЛицо, Контекст.Предупреждать);
			Если оДолжность = Неопределено Тогда
				СОО = "Нет сведений о ДОЛЖНОСТИ отв. лица " + ДляОрганизаци;   
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
				Перейти ~НаВыход;	
			Иначе
				// 4-й аргумент <ПРЕДСТАВЛЕНИЕ ДОЛЖНОСТИ>
				ДолжностьКратко = ДайАргумент_ПредставлениеФизлица(Контекст, мАрг, ИмяФункции, 5, "Полно");
				Рез = СокрЛП(?(ДолжностьКратко,оДолжность.НаименованиеКратко,оДолжность.Наименование));
				Перейти ~НаВыход;	
			КонецЕсли;
		Иначе // Вид_Значения = "Ф" 
			Рез = структураОтвЛицо.ФизическоеЛицо;
			Если Рез = Неопределено Тогда
				СОО = "Нет сведений об Ответственном ЛИЦЕ " + ДляОрганизаци;   
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0 + 1);
			КонецЕсли;
			Перейти ~НаВыход;	
		КонецЕсли;
	ИначеЕсли ТипЗ = Тип("СправочникСсылка.Контрагенты") Тогда
		//ВАРИАНТ 2:
		Контрагент = КилиО;
		// 4-й аргумент <ОРГАНИЗАЦИЯ-ПАРТНЕР>
		Если мАрг.Количество() < 4 Тогда
			СОО = "В функцию 'ОтветственноеЛицо' не передан 4-й аргумент <ОРГАНИЗАЦИЯ-ПАРТНЕР>, обязательный при использовании функции в 'Варианте 2' (3-й аргумент - Контрагент).";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
			Перейти ~НаВыход;	
		КонецЕсли;
		Организация = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[3], Истина);
		Если Вид_Значения = "О" Тогда			
			ИмяПараметра = "ЛицоПринципала_ОснованиеДействия"
		ИначеЕсли Вид_Значения = "Д" Тогда 
			ИмяПараметра = "ЛицоПринципала_Должность"
		ИначеЕсли Вид_Значения = "А" Тогда 
			ИмяПараметра = "ОргАгент_Доверенность"
		ИначеЕсли Вид_Значения = "Ф" Тогда 
			ИмяПараметра = "ЛицоПринципала"
		Иначе
			ИмяПараметра = ОЛ;
		КонецЕсли;
		Рез = уб_СтраховойБрокер.ПолучитьПараметрДоговора(Контекст.Объект.Дата, ИмяПараметра, Контрагент, Организация, ?(Контекст.ЭтоПФСубагент, Неопределено, Контекст.Объект), ОЛ);
	Иначе
		СОО = "В функцию 'ОтветственноеЛицо' передан 3-й аргумент <КОНТРАГЕНТ|ОРГАНИЗАЦИЯ> неверного типа типа '" + ТипЗ + "'. Допустимы типы справочников Организаций или Контрагентов.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Перейти ~НаВыход;	
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция КонтактноеЛицо(Контекст, мАрг)

	ИмяФункции = "КонтактноеЛицо";
	Рез = "";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);
	Если Не	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 2, 4) Тогда
		Перейти ~НаВыход
	КонецЕсли;
	Принудительное = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<ПРИНУДИТЕЛЬНОЕ>"));
	Если ПустаяСтрока(Принудительное) Тогда
		Поставщик 	= ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
		ОргАгент	= ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[1], Истина);
		Основное	= НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 4, "<ОСНОВНОЕ>")));
		Если Лев(Основное, 1) = "о" Тогда
			Рез = Поставщик.ОсновноеКонтактноеЛицо
		Иначе
			Рез = уб_СтраховойБрокер.ПолучитьПараметрДоговора(Контекст.Объект.Дата, "ЛицоПринципала", Поставщик, ОргАгент, Контекст.Объект);
		КонецЕсли;
	Иначе
		Рез = Принудительное
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;

КонецФункции // КонтактноеЛицо()

Функция Договор(Контекст, мАрг)
	
	//(<ВИДЗНАЧЕНИЯ>, <КОНТРАГЕНТ>, <ОРГАНИЗАЦИЯ-ПАРТНЕР>, <ФОРМАТНАЯ СТРОКА ДАТЫ>*)
	ИмяФункции = "Договор";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);	
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 3, 4) Тогда
		//ТОДО проверить совместно с др функциями
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <ВИДЗНАЧЕНИЯ>
	ВЗ_ = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ВИДЗНАЧЕНИЯ>"));
	Если НЕ ЗначениеЗаполнено(ВЗ_) Тогда
		СОО = "В функцию 'Договор' передан пустой 1-й аргумент <ВИДЗНАЧЕНИЯ>.";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Перейти ~НаВыход;	
	КонецЕсли;
	Вид_Значения = ВРег(Лев(ВЗ_,1));
	Если Найти("ПРНД",Вид_Значения) = 0 Тогда
		СОО = "В функцию 'Договор' передан неправильный 1-й аргумент <ВИДЗНАЧЕНИЯ>: """ + ВЗ_ 
		+ """. Должно быть: ПолноеНаименование|ПН|П|Расширение|Р|Номер|Н|Дата|Д";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
		Перейти ~НаВыход;	
	КонецЕсли;
	// 2-й и 3-й аргумент <КОНТРАГЕНТ> ИЛИ <ОРГАНИЗАЦИЯ-АГЕНТ>
	Для Счетчик = 1 По 2 Цикл
		Аргумент = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[Счетчик], Истина);
		ТипЗнчАргумент = ТипЗнч(Аргумент);
		Если Не ЗначениеЗаполнено(Аргумент) Тогда
			СОО = "В функцию 'Договор' передан пустой " + Счетчик + "-й аргумент <КОНТРАГЕНТ> ИЛИ <ОРГАНИЗАЦИЯ-АГЕНТ> (тип '" + ТипЗнчАргумент + "').";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
		КонецЕсли;
		Если ТипЗнчАргумент = Тип("СправочникСсылка.Контрагенты") Тогда
			Контрагент = Аргумент;
		ИначеЕсли ТипЗнчАргумент = Тип("СправочникСсылка.Организации") Тогда
			ОрганизацияАгент = Аргумент;
		Иначе
			СОО = "В функцию 'Договор' передан " + Счетчик + "-й аргумент <КОНТРАГЕНТ> ИЛИ <ОРГАНИЗАЦИЯ-АГЕНТ> неверного типа типа '" + ТипЗнчАргумент + "'. Допустим тип справочника Контрагентов.";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
			Перейти ~НаВыход;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(ОрганизацияАгент) Тогда
		Перейти ~НаВыход;
	КонецЕсли;
	//добавлен параметр Вида страхования - возможно изменение данных ПФ (раньше не было)
	Попытка
		ВидСП = ?(Контекст.Контейнер.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ПустаяСсылка(), Неопределено, Контекст.Контейнер.ВидСП);
	Исключение
		ВидСП = Неопределено;
	КонецПопытки;
	// TODO оптимизировать
	Договор = уб_СС.ДайДоговорМеждуПоставщикомИОргАгентом(Контрагент, ОрганизацияАгент, Контекст.Объект.Дата, Контекст.Предупреждать, ВидСП);
	Если Договор.Пустая() Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 4-й аргумент <ФОРМАТНАЯ СТРОКА ДАТЫ>*
	ФрматнаяСтрока = ДайАргумент_ФорматнаяСтрокаДаты(Контекст, мАрг, ИмяФункции, 4, Контекст.ДФ_Полный_год);
	Если Вид_Значения = "Д" Тогда
		Рез = ?(Не ЗначениеЗаполнено(Договор.ДатаЗаключенияДоговора), "", Формат(Договор.ДатаЗаключенияДоговора, ФрматнаяСтрока));	
	ИначеЕсли Вид_Значения = "Р" Тогда
		Рез = СокрЛП(Договор.РасширениеНазвания);	
	ИначеЕсли Вид_Значения = "Н" Тогда
		Рез = СокрЛП(Договор.Наименование);	
	Иначе // Вид_Значения = "П"
		РасширениеНазвания = ?(ПустаяСтрока(СокрЛП(Договор.РасширениеНазвания)), "", Договор.РасширениеНазвания + " ");
		ДатаДоговора = ?(Не ЗначениеЗаполнено(Договор.ДатаЗаключенияДоговора), "", " от " + Формат(Договор.ДатаЗаключенияДоговора,ФрматнаяСтрока));
		Рез = РасширениеНазвания + "№ " + Договор.Наименование + ДатаДоговора;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция Заполнитель(Контекст, мАрг)
	
	//(<АРГ>, <СИМВОЛ>*, <КОЛИЧЕСТВО>*)
	ИмяФункции = "Заполнитель";
	отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);		
	Рез = ""; 	
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 3) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	// 1-й аргумент <АРГ>
	АРГ = Строка(ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина));
	Если ЗначениеЗаполнено(Строка(АРГ)) Тогда
		Рез = Строка(АРГ);
		Перейти ~НаВыход;	
	КонецЕсли;
	// 2-й аргумент <СИМВОЛ>
	Симв = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<СИМВОЛ>"));
	Если НЕ ЗначениеЗаполнено(Симв) Тогда
		Симв = "_";
	КонецЕсли;
	// 2-й аргумент <КОЛИЧЕСТВО>
	КоличествоПовторений = 20;
	КП = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 3, "<КОЛИЧЕСТВО>"));
	Попытка
		КоличествоПовторений = Число(КП);
	Исключение
	КонецПопытки;   
	Рез = "";
	Для ч = 1 По КоличествоПовторений Цикл
		Рез = Рез + Симв;	  
	КонецЦикла;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция Реквизит(Контекст, мАрг)
	
	ИмяФункции = "Реквизит";
	Рез = "";
	Если НЕ	ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 1, 1) Тогда
		Перейти ~НаВыход;	
	КонецЕсли;
	
	// 1 аргумент - имя реквизита	
	Реквизит = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<РЕКВИЗИТ>")));
	// 2 аргумент - чей реквизит 	
	Орг = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ОРГ>")));
	// по умолчанию - ИНН агента, если аргумент - "Поставщик", тогда поставщика
	Если Контекст.Свойство(Орг) Тогда
		Рез = Контекст[Орг][Реквизит];
	Иначе
		Рез = Контекст.Контейнер[Орг][Реквизит];
	КонецЕсли;
	
~НаВыход:
	Возврат Рез;
	
КонецФункции

Функция ДокументУдостоверяющийЛичность(Контекст, мАрг)

	Рез = "";
	ИмяФункции = "ДокументУдостоверяющийЛичность";
	Если Не ДостаточноАргументов(Контекст, ИмяФункции, мАрг, 2, 2) Тогда
		Перейти ~НаВыход
	КонецЕсли;
	// 1 аргумент - физическое лицо или контрагент ИП с заполненным в нем физлицом
	ФизЛицо = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, мАрг[0], Истина);
	Если ТипЗнч(ФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		ФизЛицо = ФизЛицо.ФизЛицо;
	КонецЕсли;
	Если ЗначениеЗаполнено(ФизЛицо) Тогда		
		ИмяРеквизита = СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<ИМЯРЕКВИЗИТА>"));
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПД." + ИмяРеквизита + " КАК " + ИмяРеквизита + "
		|ИЗ
		|	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(&Период, ФизЛицо = &ФизЛицо) КАК ПД");
		Запрос.УстановитьПараметр("ФизЛицо", 	ФизЛицо);
		Запрос.УстановитьПараметр("Период",		Контекст.Объект.Дата);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Рез = Выборка[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;
	
	~НаВыход:
	
	Возврат Рез;

КонецФункции // ДокументУдостоверяющийЛичность()

Функция ИНН(Контекст, мАрг)
	
	ИмяФункции = "Реквизит";
	
	Рез = "";
	
	// 1 аргумент - чей реквизит 
	Орг = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ОРГ>")));
	// по умолчанию - ИНН агента, если аргумент - "Поставщик", тогда поставщика
	Если Контекст.Свойство(Орг) Тогда
		Рез = Контекст[Орг].ИНН;
	Иначе
		Рез = Контекст.Контейнер[Орг].ИНН;
	КонецЕсли;
	
~НаВыход:
	Возврат Рез;
	
КонецФункции

Функция КПП(Контекст, мАрг)
	
	ИмяФункции = "КПП";
	Орг = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ОРГ>")));
	Если Орг = "" Тогда
		Орг = "ОрганизацияАгент"
	КонецЕсли;
	Рез = Контекст[Орг].КПП;
	Возврат Рез;
	
КонецФункции

Функция ОГРН(Контекст, мАрг)

	ИмяФункции = "ОГРН";
	
	// 1 аргумент - чье ИНН
	Орг = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ОРГ>")));
	
	Если Орг = "" Тогда
		Орг = "ОрганизацияАгент"
	КонецЕсли;
	
	// по умолчанию - ИНН агента, если аргумент - "Поставщик", тогда поставщика
	Рез = Контекст[Орг].ОГРН;
	
	Возврат Рез;

КонецФункции // ОГРН()

Функция БСО(Контекст, мАрг)
	
	ИмяФункции = "БСО";	
	// 1 аргумент - "Серия", "Номер", "Вид", иначе полностью Серия + Номер	
	Тип = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ТИП>")));	
	СерияПроверки = Новый Массив;
	Если Контекст.Свойство("СерияПроверки") Тогда
		СерияПроверки = Контекст.СерияПроверки
	Иначе
		Контекст.Вставить("СерияПроверки", СерияПроверки);
		СерияПроверки = Контекст.СерияПроверки;
	КонецЕсли;		
	ТипОтчетПоставщику	= "ДокументОбъект.уб_ОтчетПоставщику";
	СерияБСО			= "";
	НомерБСОБезСерии	= "";		
	// устанавливаем НомерБСО и ВидБСО
	ДопНомерБСО = "";
	Если ТипЗнч(Контекст.Объект) <> Тип(ТипОтчетПоставщику) Тогда
		// если это уведомление поставщика об утрате БСО
		НомерБСО 	= Контекст.Контейнер_СтрокаТЧ.НомерБСО;
		ВидБСО 		= Контекст.Контейнер_СтрокаТЧ.ВидБСО;
	Иначе
		// если это Отчет поставщику. ДайНомерБСОПоСП также возвращает ВидБСО
		//НомерБСО = СокрЛП(уб_СС.ДайНомерБСОПоСП(Контекст.Контейнер.СтраховойПолис, ВидБСО,));
		тзБСО = уб_СС.БСОПоРегистратору(Контекст.Контейнер.СтраховойПолис);
		Для каждого Строка из тзБСО Цикл
			Если Строка.ВидБСОТип = Перечисления.уб_ТипыБСО.Полис или Строка.ВидБСОТип = Перечисления.уб_ТипыБСО.ПолисОсаго Тогда
				НомерБСО    = Строка.НомерБСО;
				ДопНомерБСО = Строка.ДопНомерБСО;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	// сделать для других документов...
	// ПеремещениеБСО 		- ок
	// ВозвратБСО			- ок
	// ЗаявлениеОбУтрате    - ок
	// ОбъявлениеВСМИ		- нет
	// ПередачаБСО			- ок
	// ПоступлениеБСО		- ок
	// СверкаБСО			- ок
	// СписаниеБСО			- ок	
	уб_СтраховойБрокер.Выделить_Серию_и_Номер_в_НомереБСО(ВидБСО, НомерБСО, СерияБСО, НомерБСОБезСерии);	
	СерияПроверки.Добавить(СерияБСО);	
	// 2 аргумент - Н - получает полис, если нет номера БСО	
	Тип2 = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<ПОЛИС>")));	
	//если номер бсо заполнен вручную
	Если НомерБСО = "" И Тип2 <> "н" Тогда
		НомерБСО = СокрЛП(Контекст.Контейнер_СтрокаТЧ.НомерПолиса);
		Для Индекс = 0 По СерияПроверки.Количество() - 1 Цикл
			Если СерияПроверки[Индекс] <> "" И Найти(НомерБСО, СерияПроверки[Индекс]) <> Неопределено Тогда
				СерияБСО = СерияПроверки[Индекс];
				НомерБСОБезСерии = Сред(НомерБСО, СтрДлина(СерияБСО) + 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если Тип = "серия" Или Тип = "с" Тогда
		Рез = СерияБСО
	ИначеЕсли Тип = "номер" Или Тип = "н" Тогда
		Рез = НомерБСОБезСерии
	ИначеЕсли Тип = "вид" Или Тип = "в" Тогда
		Рез = ВидБСО.Наименование
	ИначеЕсли Тип = "доп" Или Тип = "д" Тогда
		Рез = ДопНомерБСО;	
	Иначе
		Рез = НомерБСО
	КонецЕсли;	
	Возврат Рез;

КонецФункции

Функция Полис(Контекст, мАрг)

	НомерПолиса = СокрЛП(Контекст.Контейнер.НомерПолиса);	
	ИмяФункции = "Полис";
	//1 аргумент - "Серия", "Номер", иначе полностью Серия + Номер
	Тип = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ТИП>")));
	//2 аргумент - тип обработки. "п" - по поступлениям БСО, "с" - по справочнику серий, "пс" и "сп" соответственно
	Тип2 = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 2, "<ТИП>")));	
	Структура = уб_temp.ПолучитьСериюИНомерПолиса(НомерПолиса);
	Если Тип = "с" или Тип = "серия" Тогда
		Если Структура = Неопределено Тогда
			Возврат ""
		Иначе
			Возврат Структура.СерияПолиса
		КонецЕсли;
	ИначеЕсли Тип = "н" или Тип = "номер" Тогда
		Если Структура = Неопределено Тогда
			Возврат НомерПолиса
		Иначе
			Возврат Структура.НомерПолиса
		КонецЕсли;
	Иначе
		Возврат НомерПолиса
	КонецЕсли;
	
КонецФункции // Полис()

Функция А7(Контекст, мАрг)

	ИмяФункции = "А7";
	
	// 1 аргумент - "Серия", "Номер", иначе полностью Серия + Номер
	
	Тип = НРег(СокрЛП(ДолженБытьАргументСтрока(Контекст, мАрг, ИмяФункции, 1, "<ТИП>")));
	
	ТипОтчетПоставщику = "ДокументОбъект.уб_ОтчетПоставщику";
	
	Если ТипЗнч(Контекст.Объект) <> Тип(ТипОтчетПоставщику) Тогда
		Попытка
			А7 = уб_temp.ВернутьНомерКвитанцииА7ПоНомеруПолиса(Контекст.Контейнер_СтрокаТЧ.НомерПолиса);
		Исключение
			Возврат "";
		КонецПопытки;
	Иначе
		А7 = Контекст.Контейнер_СтрокаТЧ.НомерКвитанции;
	КонецЕсли;
	
	НомерА7 = "";
	СерияА7 = "";
	
	//работает для отчета поставщику. проверить для других документов.
	Если Тип = "серия" Или Тип = "с" Тогда
		уб_temp.ПолучитьСериюИНомерКвитанцииА7(А7, НомерА7, СерияА7);
		Рез = СерияА7
	ИначеЕсли Тип = "номер" Или Тип = "н" Тогда
		уб_temp.ПолучитьСериюИНомерКвитанцииА7(А7, НомерА7, СерияА7);
		Рез = НомерА7
	Иначе
		Рез = А7
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции // А7()

