//// 2-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в ТЧ Списание БСО Поставщику:
Процедура ПСП_ТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст, ИмяОбластиШапка = "ШапкаТаб", ИмяОбластиСтрока = "Строка", ПоказыватьШапку = Истина) Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_ТЧ_УведомлениеПоставщикаОбУтратеБСО (Область шапки: '" + ИмяОбластиШапка + "', Область строки: '" + ИмяОбластиСтрока + "')");	
	ТабДок = Контекст.ТабличныйДокумент;
	Макет = Контекст.Макет;
	Если ПоказыватьШапку Тогда
		ПСП(Контекст, ИмяОбластиШапка, Контекст.Предупреждать);	
		//Указываем, какую строку повторять на каждой странице при печати
		ОблШапкаТаб = ТабДок.Области.Найти(ИмяОбластиШапка);
		Если ОблШапкаТаб <> Неопределено Тогда
			Если Контекст.ПовторятьШапкуТаблицыПриПечати Тогда
				ВерхняяГраница = ОблШапкаТаб.Верх;
				НижняяГраница = ОблШапкаТаб.Низ;
				Если Контекст.КоличествоСтрокПовторенияШапкиТЧ < 1 Тогда
					ОбластьПовторения = ОблШапкаТаб;
				Иначе
					ВыводитьВверхДо = Макс(ВерхняяГраница, НижняяГраница - Контекст.КоличествоСтрокПовторенияШапкиТЧ + 1);
					ОбластьПовторения = ТабДок.Область("R"+ВыводитьВверхДо+":R" + НижняяГраница);
				КонецЕсли;
				ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовторения;
			КонецЕсли;
			Если Контекст.ФиксацияСверху Тогда
				ТабДок.ФиксацияСверху = ОблШапкаТаб.Низ;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	Итоги = ПолучитьСтруктуруИтогов_Общее(Контекст);		
	Если Не Контекст.Объект.Метаданные() = Метаданные.Документы.уб_УведомлениеОДосрочномПрекращенииДействияДоговора Тогда
		ТЗ_ТЧДокумента = Контекст.ТЧДокумента;
		Для Каждого СтрокаТЧ Из ТЗ_ТЧДокумента Цикл
			Если Контекст.Отладка.Групповая И Контекст.Контейнер_Итоги.НомерТекущейСтроки >= Контекст.Отладка.МаксКоличествоСтрокТЧ Тогда
				Прервать;	
			КонецЕсли;		
			УстановитьТекущийКонтейнер(Контекст,"СтрокаТЧ",СтрокаТЧ);				
			ПСП_СтрокиТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст,ИмяОбластиСтрока);	
		КонецЦикла;
	КонецЕсли;
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры	

//// 3-й УРОВЕНЬ |  Процессор заполняет типовые места подстановки в СТРОКЕ ТЧ Списание БСО Поставщику:
//1.1 		НомерСтроки
//2.1 Поставщик
//3.1 ОрганизацияАгент
//4.1 СК
//5.1 ВидБСО
//6.1 НомерБСО
//7.1 НомерПолиса
//8.1 Количество
//9.1 Комментарий
//10.1 ДатаУтратыПорчи
//10.2 ДатаУтратыПорчи_Кратко
//11.1 ТипСписания
//11.2 ТекСостояниеБСО
//11.3 ТекПоложениеБСО
//11.4 ВидУтратыБСО
//12.1 Страховател
//12.2 Страхователь_Расширение
//13.1 ДатаОформленияПолиса
//13.2 ДатаОформленияПолиса_Кратко
Процедура ПСП_СтрокиТЧ_УведомлениеПоставщикаОбУтратеБСО(Контекст, ИмяОбласти = "Строка") Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПСП_СтрокиТЧ_УведомлениеПоставщикаОбУтратеБСО (Область: '" + ИмяОбласти + "')");	
	
	Область_Строка = ПолучитьОбласть(Контекст, ИмяОбласти);
	ПСП_ЗаполнениеПараметровОбласти_ПоЧастномуКоду(Контекст);
	
	СтрокаТЧ = Контекст.Контейнер_СтрокаТЧ;
	
	Итоги = Контекст.Контейнер_Итоги;
	Итоги.НомерТекущейСтроки = Итоги.НомерТекущейСтроки + 1;
	
	//===========================================================
	Прмт = Область_Строка.Параметры;
	
	//СтрокиПараметров = Контекст.ОбъектПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
	СтрокиПараметров = Контекст.СтруктураОбъектаПФ.ПараметрыМакета.НайтиСтроки(Новый Структура("Область,ЕстьКодЗаполнения,НетВМакете", ИмяОбласти, Ложь, Ложь));
	RegExp = Новый COMОбъект("VBScript.RegExp");
	Для каждого СтрокаПараметра Из СтрокиПараметров Цикл
		Контекст.Отладка.ТекущаяСтрокаПараметра = СтрокаПараметра;
		Контекст.ОперативныйКонтейнер = Контекст.Контейнер; //Восстанавливаем значение оперативного контейнера (может измениться модификатором при заполнении параметра)
		ИмяПараметра = СтрокаПараметра.Параметр;		
		Если ИмяПараметра = "" Тогда
		//ИначеЕсли ИмяПараметра = "<особое имя параметра>" Тогда
		//	Прмт[ИмяПараметра] = <особый код заполнения параметра>;
		Иначе
			ОПТЧ(Контекст, Прмт, RegExp);
		КонецЕсли;
	КонецЦикла;
	RegExp = Null;
	
	//===========================================================	
	Контекст.ТабличныйДокумент.Вывести(Область_Строка);
	
	отладка_Лог_КонецПроцедуры(Контекст);
	
КонецПроцедуры	

// Рассчитывает итог по выбранной колонке
//
// Параметры:
//  ТабЗнач  - ТаблицаЗначений
//                 
//  Колонка  - строка,выбранная колонка 
//
// Возвращаемое значение:
//   <Число>   - итог по выбранной колонке
//
Функция РассчитатьИтогиТЗПоКолонке(ТабЗнач, Колонка) Экспорт
	
	Итог=0;
	Попытка
		Для Каждого Строка Из ТабЗнач Цикл
			Итог	= Итог + Строка[Колонка];
		КонецЦикла;
		Возврат Итог;
	Исключение 
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции // РассчитатьИтогиЧЗПоКолонке()

/////////////////////////////////////////////////
///////////        ПФФ        ///////////////////
/////////////////////////////////////////////////

Функция ОПТЧ(Контекст, ПараметрыОбласти, RegExp = Неопределено) Экспорт
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПФ.ОПТЧ");
	Контекст.Отладка.МаксСтатусОшибкиПриЗаполненииПараметра = 0;
	//В процессе заполнения параметра содержит максимальный статус из всех произошедших ошибок
	ИмяПараметра = Контекст.Отладка.ТекущаяСтрокаПараметра.Параметр;
	Контейнер = Контекст.Контейнер;
	Свойство = ИмяПараметра;
	Контекст.ОперативныйКонтейнер = Контейнер;
	бНетРегВыр = (RegExp = Неопределено);
	Если бНетРегВыр Тогда
		RegExp = Новый COMОбъект("VBScript.RegExp");
	КонецЕсли;
	RegExp.MultiLine = Ложь; // истина — текст многострочный, ложь — одна строка
	RegExp.Global = Ложь; // истина — поиск по всей строке, ложь — до первого совпадения
	RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	//Для режима отладки
	Контекст.Отладка.ИмяТекущегоСвойства = Свойство;
	//Сначала обрабатываем зарезервированные имена параметров
	Рез = Истина;
	нСвойство = НРег(Свойство);
	Если Лев(нСвойство, 2) = "сп" Тогда
		аа = 12;
	КонецЕсли;
	Если нСвойство = "" Тогда
		ЗначениеСвойства = "";
		Перейти ~НаВыход;
	Иначе
		СвойствоИлиМассивФункций = ПолучитьМассивФункций(Контекст, Свойство, RegExp);
		ЗначениеСвойства = ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, СвойствоИлиМассивФункций, Истина);
	КонецЕсли;
	чСтатус = Контекст.Отладка.МаксСтатусОшибкиПриЗаполненииПараметра;
	бРежимОтладки = Контекст.Отладка.Включена;
	_ЗаполнительОтладки_ = "___________________";
	//                   в режиме: | обычный           |  Отладки
	
	Если чСтатус < 2 Тогда       //| результат         |  результат
		ЗначениеПараметра = ЗначениеСвойства;
	ИначеЕсли чСтатус = 2 Тогда  //| результат         |  ###########
		ЗначениеПараметра = ?(бРежимОтладки,ЗначениеСвойства,_ЗаполнительОтладки_);
	ИначеЕсли чСтатус = 3 Тогда  //| пусто             |  ###########
		ЗначениеПараметра = ?(бРежимОтладки,"",_ЗаполнительОтладки_);
	ИначеЕсли чСтатус > 3 Тогда  //| (### Ошибка! ###) |  ###########
		Рез = Ложь;
		ЗначениеПараметра = ?(бРежимОтладки,"(### Ошибка! ###)",_ЗаполнительОтладки_);
	КонецЕсли;
	Если Контекст.Свойство("Показатели") И Контекст.Показатели.Свойство("ТЗПоказателей") Тогда
		СтрокаТЗПоказателей = Контекст.Показатели.ТЗПоказателей.Найти(ИмяПараметра, "ИмяПоказателя");
		Если СтрокаТЗПоказателей <> Неопределено Тогда
			//ЗначениеПараметра = Формат(ЗначениеПараметра, "ЧДЦ=" + СтрокаТЗПоказателей.РазрядностьДробнойЧасти + "; ЧН=0.00");
			ЗначениеПараметра = Формат(ЗначениеПараметра, "ЧДЦ=" + 2 + "; ЧН=0.00");
		КонецЕсли;
	КонецЕсли;
	Попытка
		ПараметрыОбласти[ИмяПараметра] = ЗначениеПараметра;	
	Исключение
		Рез = Ложь;
	КонецПопытки;
	
	Если бНетРегВыр Тогда
		RegExp = Null;
	КонецЕсли;
~НаВыход:
	отладка_Лог_КонецПроцедуры(Контекст);
	Возврат Рез;
	
КонецФункции

Функция ПолучитьСвойство(Контекст, Знач Свойство, НеИспользоватьЗаполнитель = Ложь)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПолучитьСвойство ('" + Свойство + "')");	
	ИнфоОЗаместителе = "";
	//Список параметров, значение которых - результат особых вычислений	
	нСвойство = НРег(Свойство);
	Если нСвойство = "текущийгод" Тогда
		Рез = Формат(ТекущаяДата(),"ДФ='yyyy'");
		Перейти ~НаВыход;	
	ИначеЕсли нСвойство = "номердокумента" Тогда
		Рез = Дай_ТиповойНомер(Контекст.Объект);
		Перейти ~НаВыход;	
	ИначеЕсли нСвойство = "номердокументабезтипового" Тогда
		Рез = Дай_ТиповойНомер(Контекст.Объект, Ложь);
		Перейти ~НаВыход;
	ИначеЕсли нСвойство = "версияуб" Тогда
		Рез = Метаданные.Версия;
		Перейти ~НаВыход;
	ИначеЕсли нСвойство = "всегострок" Или нСвойство = "номерстроки"  Тогда
		// ТОДО	 преобразовать Итог(НомерТекущейСтроки)
		ИнфоОЗаместителе = "(Алиас затребованного свойства """ + Свойство + """; вызов из контейнера '" + Контекст.ОперативныйКонтейнер.Тип_ + "')";
		Свойство = "номертекущейстроки";
		Контекст.ОперативныйКонтейнер = Контекст.Контейнер_Итоги;
	ИначеЕсли Свойство = "бла-бла-бла" Тогда
	КонецЕсли;
	Если Найти(нСвойство, ".") <> 0 Тогда
		//получение вложенных данных
		Массив = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(нСвойство, ".");
		Корень = Массив[0];
		Если ЕстьСвойство(Контекст, Корень) Тогда
			текУровень 			= Контекст.ОперативныйКонтейнер[Корень];
			МассивКоличество 	= Массив.Количество();
			ВызваноИсключение 	= Ложь;
			Для Индекс = 1 По МассивКоличество - 1 Цикл
				//много проверок на встроенную функцию Найти различных типов
				Попытка
					текУровень = текУровень[Массив[Индекс]]
				Исключение
					Рез = Неопределено;
					СОО = "В контейнере '" + Контекст.ОперативныйКонтейнер.Тип_ + "' не найдено свойство '" + Свойство + "'" + ИнфоОЗаместителе + "."; 
					отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0 + 1);
					ВызваноИсключение = Истина;
				КонецПопытки;
			КонецЦикла;
			Если Не ВызваноИсключение Тогда
				Рез = текУровень
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Контекст.ИмяОбъекта = "уб_ЗаявкаНаПечать" Тогда
		СвойствоИлиМассив = ПолучитьМассивФункций(Контекст, Свойство);
		Рез = ПолучитьСвойствоЗаявкиНаПечать(Контекст, СвойствоИлиМассив,, НеИспользоватьЗаполнитель);
	ИначеЕсли ЕстьСвойство(Контекст, Свойство) Тогда
		Рез = Контекст.ОперативныйКонтейнер[Свойство];	
	Иначе
		//свойство может быть с символами, не подходящих для именования ключа структуры
		Попытка
			Если Контекст.Свойство("Показатели") И Контекст.Показатели.Свойство(Свойство) Тогда
				Рез = Контекст.Показатели[Свойство];
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если Рез = Неопределено Тогда
			СОО = "В контейнере '" + Контекст.ОперативныйКонтейнер.Тип_ + "' не найдено свойство '" + Свойство + "'" + ИнфоОЗаместителе + "."; 
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0 + 1);	
		КонецЕсли;
	КонецЕсли;
	
~НаВыход:	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьСвойствоЗаявкиНаПечать(Контекст, Свойство, СимволЗаполнителя = "-", НеИспользоватьЗаполнитель = Ложь)

	Если Свойство = "Водитель2ДатаРождения" Тогда
		аа = 12;
	КонецЕсли;
	Попытка
		ЕстьСвойство = Контекст.ДанныеЗаявки.Свойство(Свойство);
	Исключение
		ЕстьСвойство = Ложь
	КонецПопытки;
	Если ЕстьСвойство И ЗначениеЗаполнено(Контекст.ДанныеЗаявки[Свойство]) Тогда
		Результат = Контекст.ДанныеЗаявки[Свойство];
	ИначеЕсли Не НеИспользоватьЗаполнитель Тогда
		Попытка
			Результат = ЗаполнительЗаявкиНаПечать(Контекст, Свойство, СимволЗаполнителя);
		Исключение
			Сообщить(">>>ЗаполнительЗаявкиНаПечать " +Свойство);
			Результат = "--";
		КонецПопытки;	
	КонецЕсли;
	Возврат Результат;

КонецФункции // ЗаполнительЗаявкаНаПечать()

Функция ЗаполнительЗаявкиНаПечать(Контекст, Свойство, СимволЗаполнителя = "-") Экспорт 

	Результат = "";
	Если Контекст.Заполнитель.Свойство(Свойство) Тогда
		ЧислоСимволов = Контекст.Заполнитель[Свойство];
	Иначе
		ЧислоСимволов = Контекст.Заполнитель.Общий;
	КонецЕсли;
	Для Счетчик = 1 По ЧислоСимволов Цикл
		Результат = Результат + СимволЗаполнителя;
	КонецЦикла;
	Возврат Результат;

КонецФункции // ЗаполнительЗаявкиНаПечать()

Функция ЕстьСвойство(Контекст, Свойство)
	
	Возврат (Контекст.ОперативныйКонтейнер.Владелец().Колонки.Найти(Свойство) <> Неопределено);
	
КонецФункции

Функция ПолучитьМассивФункций(Контекст, СтрокаРазбора, RegExp = Неопределено)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ПолучитьМассивФункций (Строка разбора: '" + СтрокаРазбора + "')");		
	бНетРегВыр = (RegExp = Неопределено);
	Если бНетРегВыр Тогда
		RegExp = Новый COMОбъект("VBScript.RegExp");
		RegExp.MultiLine = Ложь; // истина — текст многострочный, ложь — одна строка
		RegExp.Global = Ложь; // истина — поиск по всей строке, ложь — до первого совпадения
		RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	КонецЕсли;
	//---------------------------------------------------------
	//Ищем имя функции и перечень аргументов
	RegExp.Pattern = "^\s*([А-Яа-я][А-Яа-я0-9_]*)\((.*?)\)\s*$";
	Рез = RegExp.Execute(СтрокаРазбора);
	Если Рез.Count > 0 Тогда
		ИмяФункции = Рез.Item(0).SubMatches(0);
		ПереченьАргументов = СокрЛП(Рез.Item(0).SubMatches(1));
		массивВложеннойФункции = Новый Массив();
		массивВложеннойФункции.Добавить(ИмяФункции);
		//ТОДО внести в скобки
		массивВложеннойФункции = РазобратьАргументы(Контекст, массивВложеннойФункции, ПереченьАргументов, RegExp);
		МассивФункций = массивВложеннойФункции;
	Иначе
		МассивФункций = СокрЛП(СтрокаРазбора);
	КонецЕсли;
	//---------------------------------------------------------
	Если бНетРегВыр Тогда
		RegExp = Null;
	КонецЕсли;
	
	отладка_Лог_КонецПроцедуры(Контекст);	
	
	Возврат МассивФункций;
	
КонецФункции

Функция РазобратьАргументы(Контекст, массивВложеннойФункции, ПереченьАргументов, RegExp)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "РазобратьАргументы (Перечень аргументов: '" + ПереченьАргументов + "')");	
	
	ДлинаСтроки = СтрДлина(ПереченьАргументов);	
	Стек = Новый Массив();
	ЛевСтр = "";
	ПравСтр = ПереченьАргументов;
	Добавлять = Истина;
	ПредыдущийСимвол = "";
	Для Сч = 1 по ДлинаСтроки Цикл
		Симв = Сред(ПереченьАргументов,Сч,1);
		//ПравСтр = Сред(Стр,Сч);
		Если Симв = "," И ПредыдущийСимвол <> "\" И Добавлять Тогда
			АргументИлиМассив = ПолучитьМассивФункций(Контекст, ЛевСтр, RegExp);	
			массивВложеннойФункции.Добавить(АргументИлиМассив);	
			ЛевСтр = "";
		ИначеЕсли Симв = "(" Тогда
			Добавлять = Ложь;
			ЛевСтр = ЛевСтр + Симв;
			Стек.Вставить(0,Сч); 
		ИначеЕсли Симв = ")" Тогда
			Попытка
				Стек.Удалить(0);
				ЛевСтр = ЛевСтр + Симв;
				Добавлять = Стек.Количество() = 0;
			Исключение
			КонецПопытки;
			//ЛевСтр = ЛевСтр + Симв;
			//Добавлять = Стек.Количество() = 0;
		ИначеЕсли Симв <> "\" Тогда
			ЛевСтр = ЛевСтр + Симв;
		КонецЕсли;
		ПредыдущийСимвол = Симв;
	КонецЦикла;
	АргументИлиМассив = ПолучитьМассивФункций(Контекст, ЛевСтр, RegExp);	
	массивВложеннойФункции.Добавить(АргументИлиМассив);		
	отладка_Лог_КонецПроцедуры(Контекст);		
	Возврат массивВложеннойФункции;
	
КонецФункции

Функция ВычислитьАргументИлиСвойствоИлиФункцию(
	Контекст, 
	СвойствоИлиМассивФункции, 
	бИмяСвойстваЕслиСтрока, 
	НеИспользоватьЗаполнитель = Ложь
	)
	
	//Функция вызывается из частных функций в тот момент, когда обрабатываются значения аргументов.
	//Если из структуры аргументов частной функции следует, что значение аргумента типа "строка" является
	//параметром функции, то бИмяСвойстваЕслиСтрока = Ложь
	//Если значение аргумента типа "строка" в обрабатываемой позиции трактуется как имя свойства контейнера 
	//то бИмяСвойстваЕслиСтрока = Истина	
	отладка_Лог_НачалоПроцедуры(Контекст, "ВычислитьАргументИлиСвойствоИлиФункцию ('" + Строка(СвойствоИлиМассивФункции) + "')");		
	ТипЗ = ТипЗнч(СвойствоИлиМассивФункции);	
	Рез = "";
	Если ТипЗ = Тип("Строка") Тогда
		Если бИмяСвойстваЕслиСтрока Тогда
			Если ЗначениеЗаполнено(СвойствоИлиМассивФункции) Тогда
				Рез = ПолучитьСвойство(Контекст, СвойствоИлиМассивФункции, НеИспользоватьЗаполнитель);
			Иначе
				СОО = "В функцию 'ВычислитьАргументИлиСвойствоИлиФункцию' передано пустое имя свойства контейнера.";
				отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Внимание, 0+1);
			КонецЕсли;
		Иначе
			Рез = СвойствоИлиМассивФункции;
		КонецЕсли;
	ИначеЕсли ТипЗ = Тип("Массив") Тогда
		ИмяФункции = СвойствоИлиМассивФункции[0];
		//Если ИмяФункции = "СП" Тогда
		//	аа = 12;
		//КонецЕсли;
		Если Не ЗначениеЗаполнено(ИмяФункции) Тогда
			СОО = "В функцию 'ВычислитьАргументИлиСвойствоИлиФункцию' передан массв функции с пустым первым аргументом (именем функции).";
			отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
			ПоказатьДеревоФункций(СвойствоИлиМассивФункции, 0);
		Иначе
			СвойствоИлиМассивФункции.Удалить(0);
			Рез = ВыполнитьФункцию(Контекст, ИмяФункции, СвойствоИлиМассивФункции);
		КонецЕсли;
	Иначе
		Сообщить("Ошибка: элемент маcсива разбора строки параметра неподходящего типа: '" + ТипЗ + "'!",СтатусСообщения.Важное);	
		отладка_ПФ(Контекст, "", "", СтатусСообщения.Важное, 0+1);
	КонецЕсли;	
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Функция ВыполнитьФункцию(Контекст, ИмяФункции, мАргументы)
	
	отладка_Лог_НачалоПроцедуры(Контекст, "ВыполнитьФункцию ('" + ИмяФункции + "')");	
	
	ИмяФ = ВРег(ИмяФункции);
	Рез = "";
	Если НЕ ЗначениеЗаполнено(ИмяФ) Тогда
		СОО = "В функцию 'ВыполнитьФункцию' передано пустое имя функции!";
		отладка_ПФ(Контекст, "", СОО, СтатусСообщения.Важное, 0+1);
	ИначеЕсли ИмяФ = "ТЕКУЩАЯДАТА" ИЛИ ИмяФ = "ТДАТА"  Тогда
		отладка_Лог_НачалоПроцедуры(Контекст, "ТекущаяДата");	
		Рез = ТекущаяДата();
		отладка_Лог_КонецПроцедуры(Контекст);	
	ИначеЕсли ИмяФ = "НРЕГ" ИЛИ  ИмяФ = "ВРЕГ" ИЛИ ИмяФ = "ТРЕГ" ИЛИ  ИмяФ = "ПРЕГ" ИЛИ  ИмяФ = "СОКРЛП" Тогда
		Если ДостаточноАргументов(Контекст, ИмяФункции, мАргументы, 1, 1) Тогда
			Аргумент = мАргументы[0];	
			ЗначениеАргумента = Строка(ВычислитьАргументИлиСвойствоИлиФункцию(Контекст, Аргумент, Истина));
			отладка_Лог_НачалоПроцедуры(Контекст, ИмяФункции);	
			Попытка
				Выполнить("Рез = " + ИмяФункции + "(ЗначениеАргумента);")
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_ПФ.ВыполнитьФункцию() ошибка частного кода. Код:
				|" + ИмяФункции, "НеСообщать", Истина)
			КонецПопытки;
			отладка_Лог_КонецПроцедуры(Контекст);	
		КонецЕсли;
	ИначеЕсли ИмяФ = "ПАДЕЖ" ИЛИ ИмяФ = "П" Тогда
		Рез = ПадежПФФ(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ДАТАПРОПИСЬЮ" ИЛИ ИмяФ = "ДП" Тогда
		Рез = ДатаПрописью_(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "Город" Тогда
		Рез = Город(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ОКР" Тогда
		Рез = Окр_(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "НАИМЕНОВАНИЕ" ИЛИ ИмяФ = "Н" Тогда
		Рез = Наименование(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ОТВЕТСТВЕННОЕЛИЦО" ИЛИ ИмяФ = "ОЛ" Тогда
		Рез = ОтветственноеЛицо(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ЗАПОЛНИТЕЛЬ" ИЛИ ИмяФ = "З" Тогда
		Рез = Заполнитель(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "СУММАПРОПИСЬЮ" ИЛИ ИмяФ = "СП" Тогда
		Рез = СуммаПрописью(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ДФ" 	Тогда
		Рез = ДФ(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ЧФ" 	Тогда
		Рез = ЧФ(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "СЗП" 	Тогда
		Рез = СЗП(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ДОГОВОР" Тогда
		Рез = Договор(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ДОК" 	Тогда
		Рез = ПереключательКонтейнера(Контекст, мАргументы, "Док");
	ИначеЕсли ИмяФ = "ИТОГ" Тогда
		Рез = ПереключательКонтейнера(Контекст, мАргументы, "Итог");
	// 48
	ИначеЕсли ИмяФ = "РЕКВИЗИТ" Тогда
		Рез = Реквизит(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "ИНН" 	Тогда
		Рез = ИНН(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "ОГРН" Тогда
		Рез = ОГРН(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "БСО" Тогда
		Рез = БСО(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "А7" Тогда
		Рез = А7(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "ПОЛИС" Тогда
		Рез = Полис(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "ИТОГ2" Тогда
		Рез = ИтогиСРазрядностью2(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "БР" Тогда
		Рез = БанковскиеРеквизиты(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "КомуПеречислитьПоОтчету" Тогда
		Рез = КомуПеречислитьПоОтчету(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "КОНТАКТНОЕЛИЦО" Или ИмяФ = "КЛ" Тогда
		Рез = КонтактноеЛицо(Контекст, мАргументы)
	ИначеЕсли ИмяФ = "ИЛИ" Или ИмяФ = "ФУНКЦИЯИЛИ" Тогда
		Рез = ФункцияИли(Контекст, мАргументы);
	ИначеЕсли ИмяФ = "ДОКУМЕНТУДОСТОВЕРЯЮЩИЙЛИЧНОСТЬ" Или ИмяФ = "ДУ" Тогда
		Рез = ДокументУдостоверяющийЛичность(Контекст, мАргументы);
	Иначе	
		Попытка
			Выполнить("Рез = " + ИмяФункции + "(Контекст, мАргументы);");
		Исключение
			СОО = "Функция '" + ИмяФункции + "' отсутствует.";
			отладка_ПФ(Контекст, ОписаниеОшибки(), СОО, СтатусСообщения.ОченьВажное, 0+1);
		КонецПопытки;
	КонецЕсли;                                    
	отладка_Лог_КонецПроцедуры(Контекст);	
	Возврат Рез;
	
КонецФункции

Процедура ПоказатьДеревоФункций(АргументИлиМассив, Уровень)
	
	Если Уровень > 10 Тогда
		Возврат;	
	КонецЕсли;
	УровеньНов = Уровень + 1;
	ПРЕ = ДайТабс(УровеньНов);
	ТипЗ = ТипЗнч(АргументИлиМассив);
	Если ТипЗ = Тип("Массив") Тогда
		Сообщить(ДайТабс(УровеньНов) + "Функция:	" + АргументИлиМассив[0]);
		Для Сч = 1 По АргументИлиМассив.Количество() - 1 Цикл
			ПоказатьДеревоФункций(АргументИлиМассив[Сч], УровеньНов);
		КонецЦикла;
	ИначеЕсли ТипЗ = Тип("Строка") Тогда
		Сообщить(ДайТабс(УровеньНов) + "Арг:	" + АргументИлиМассив);
	Иначе
		Сообщить("Ошибка: элемент массива разбора строки параметра неподходящего типа: '" + ТипЗ + "'!", СтатусСообщения.Важное);	
	КонецЕсли;
	
КонецПроцедуры

Функция ДайТабс(СчТаб)
	Стр = "";
	Для Сч = 1 По СчТаб Цикл
		Стр = Стр + "	";	
	КонецЦикла;
	Возврат Стр;
КонецФункции

