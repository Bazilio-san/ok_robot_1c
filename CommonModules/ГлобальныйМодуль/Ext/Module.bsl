Функция МесяцПрописью(Месяц_П, СЗаглавнойБуквы = Ложь, Падеж = 2) Экспорт
	
	Если Месяц_П = 1 Тогда
		Месяц_П = "январь";
	ИначеЕсли Месяц_П = 2 Тогда
		Месяц_П = "февраль";
	ИначеЕсли Месяц_П = 3 Тогда
		Месяц_П = "март";
	ИначеЕсли Месяц_П = 4 Тогда
		Месяц_П = "апрель";
	ИначеЕсли Месяц_П = 5 Тогда
		Месяц_П = "май";
	ИначеЕсли Месяц_П = 6 Тогда
		Месяц_П = "июнь";
	ИначеЕсли Месяц_П = 7 Тогда
		Месяц_П = "июль";
	ИначеЕсли Месяц_П = 8 Тогда
		Месяц_П = "август";
	ИначеЕсли Месяц_П = 9 Тогда
		Месяц_П = "сентябрь";
	ИначеЕсли Месяц_П = 10 Тогда
		Месяц_П = "октябрь";	
	ИначеЕсли Месяц_П = 11 Тогда
		Месяц_П = "ноябрь";	 	
	ИначеЕсли Месяц_П = 12 Тогда
		Месяц_П = "декабрь";
	КонецЕсли;	
	Месяц_П = ФункцииРасширения.Склонение(Месяц_П, Падеж);
	Возврат ?(СЗаглавнойБуквы, ВРег(Лев(Месяц_П,1)) + Прав(Месяц_П,СтрДлина(Месяц_П) - 1), Месяц_П);
	
КонецФункции

Функция ГодПрописью(Год_П) Экспорт
	
	ПолныйГод = Год_П;
	
	Если Число(Прав(Год_П, 1)) = 0 Тогда 
		Десятки = ПреобразоватьДесятки(Год_П, Истина);
		Год_Зн = "" + Десятки + " года";
	Иначе 
		Если Число(Прав(Год_П, 2)) < 10 Или Число(Прав(Год_П, 2)) >= 20 Тогда
			Десятки = ПреобразоватьДесятки(Число(Лев(Прав(Год_П,2), 1) + "0"), Ложь);
			Еденицы = ПреобразоватьЕденицы(Число(Прав(Год_П, 1)));
			Год_Зн = "" + Десятки + Еденицы + " года";
		Иначе 
			ВыборТекст = "один" + Символы.ПС + "две" + Символы.ПС + "три" + Символы.ПС + "четыр" + Символы.ПС + "пят" + Символы.ПС + "шест" + Символы.ПС + "сем" + Символы.ПС + "восем" + Символы.ПС + "девят";
			Год_Зн = " " + СтрПолучитьСтроку(ВыборТекст, Прав(Год_П, 1)) + "надцатого года";
		КонецЕсли;
	КонецЕсли;
	
	Если ПолныйГод = 2000 Тогда 
		Возврат "двухтысячного года";
	ИначеЕсли ПолныйГод > 2000 Тогда 
		Возврат "две тысячи" + Год_Зн;
	ИначеЕсли ПолныйГод = 1900 Тогда  
		Возврат "одна тысяча девятьсотого" + Год_Зн;
	Иначе
		Возврат "одна тысяча девятьсот" + Год_Зн;
	КонецЕсли;	
	
КонецФункции

Функция ПреобразоватьДесятки(ЧислоДесятки, Нуль)
	
	ЧислоДесятки = Число(Прав(ЧислоДесятки,2));
	
	Если ЧислоДесятки = 10 Тогда
		Месяц_П = " десятого";
	ИначеЕсли ЧислоДесятки = 20 Тогда 
		Месяц_П = " двадцатого";
		Месяц_П_1 = " двадцать";
	ИначеЕсли ЧислоДесятки = 30 Тогда
		Месяц_П = " тридцатого";
		Месяц_П_1 = " тридцать";
	ИначеЕсли ЧислоДесятки = 40 Тогда
		Месяц_П = " сорокового";
		Месяц_П_1 = " сорок";
	ИначеЕсли ЧислоДесятки = 50 Тогда
		Месяц_П = " пятидесятого";
		Месяц_П_1 = " пятьдесят";
	ИначеЕсли ЧислоДесятки = 60 Тогда
		Месяц_П = " шестидесятого";
		Месяц_П_1 = " шестьдесят";
	ИначеЕсли ЧислоДесятки = 70 Тогда
		Месяц_П = " семидесятого";
		Месяц_П_1 = " семьдесят";
	ИначеЕсли ЧислоДесятки = 80 Тогда
		Месяц_П = " восьмидесятого";
		Месяц_П_1 = " восемьдесят";
	ИначеЕсли ЧислоДесятки = 90 Тогда
		Месяц_П = " девяностого";
		Месяц_П_1 = " девяносто";
	КонецЕсли;
	
	Если Нуль Тогда
		Возврат Месяц_П;
	Иначе
		Возврат Месяц_П_1;
	КонецЕсли;
	
КонецФункции

Функция ПреобразоватьЕденицы(ЧислоЕденицы)
	
	Если ЧислоЕденицы = 1 Тогда 
		myDay = " первого";
	ИначеЕсли ЧислоЕденицы = 2 Тогда 
		myDay = " второго";
	ИначеЕсли ЧислоЕденицы = 3 Тогда
		myDay = " третьего";
	ИначеЕсли ЧислоЕденицы = 4 Тогда
		myDay = " четвертого";
	ИначеЕсли ЧислоЕденицы = 5 Тогда
		myDay = " пятого";
	ИначеЕсли ЧислоЕденицы = 6 Тогда
		myDay = " шестого";
	ИначеЕсли ЧислоЕденицы = 7 Тогда
		myDay = " седьмого";
	ИначеЕсли ЧислоЕденицы = 8 Тогда
		myDay = " восьмого";
	ИначеЕсли ЧислоЕденицы = 9 Тогда
		myDay = " девятого";
	КонецЕсли;
	
	Возврат  myDay;
	
КонецФункции


