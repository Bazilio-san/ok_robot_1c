Функция УстановитьЗначение(Реквизит, НовоеЗначение, СтароеЗначение = Неопределено, УстанавливатьНеопределено = Истина) Экспорт
	СтароеЗначение = Реквизит;
	Если Реквизит <> НовоеЗначение Тогда
		Если НовоеЗначение = Неопределено и УстанавливатьНеопределено = ЛОЖЬ Тогда
		Иначе	
			Реквизит = НовоеЗначение;
			Возврат Истина;
		КонецЕсли;	
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции


Функция ПРег(знач Фраза) Экспорт 
	//Первая буква в предложении - прописная, остальные - строчные
	Возврат ВРег(Лев(Фраза,1)) + НРег(Прав(Фраза,СтрДлина(Фраза) - 1));
КонецФункции

Функция ДатаПрописью(ДатаЗнач, СЗаглавнойБуквы = Ложь, Падеж = Неопределено) Экспорт 
	
	День_П 	= День(ДатаЗнач);
	Месяц_П = Месяц(ДатаЗнач);
	Год_П	= Год(ДатаЗнач);
	
	Если Падеж = Перечисления.Падежи.Родительный ИЛИ Падеж = 2 Тогда
		День_Зн = ДеньПрописью(День_П);
	Иначе
		Если Прав(День_П, 1) = 3 Тогда
			День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2);
			Если День_П = 13 Тогда 
				День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2) + "е";
			КонецЕсли;	
		ИначеЕсли День_П = 23 Тогда
			День_Зн = "двадцать третье"
		Иначе
			День_Зн = Сред(ДеньПрописью(День_П), 1, СтрДлина(ДеньПрописью(День_П)) - 2) + "е";
		КонецЕсли
	КонецЕсли;
	
	Месяц_Зн = МесяцПрописью(Месяц_П);
	Год_Зн 	 = ГодПрописью(Год_П);
	
	ТекстДата = День_Зн + " " + Месяц_Зн + " " + Год_Зн;
	
	Если СЗаглавнойБуквы Тогда
		ТекстДата = ВРег(Лев(ТекстДата,1)) + Прав(ТекстДата,СтрДлина(ТекстДата) - 1);
	КонецЕсли;
	
	Возврат ТекстДата;
КонецФункции

Функция ДеньПрописью(День_П) Экспорт
	
	Если День_П = 1 Тогда
		День_П = "первого";
	ИначеЕсли День_П = 2 Тогда
		День_П = "второго";
	ИначеЕсли День_П = 3 Тогда
		День_П = "третьего";
	ИначеЕсли День_П = 4 Тогда
		День_П = "четвертого";
	ИначеЕсли День_П = 5 Тогда
		День_П = "пятого";
	ИначеЕсли День_П = 6 Тогда
		День_П = "шестого";
	ИначеЕсли День_П = 7 Тогда
		День_П = "седьмого";
	ИначеЕсли День_П = 8 Тогда
		День_П = "восьмого";
	ИначеЕсли День_П = 9 Тогда
		День_П = "девятого";
	ИначеЕсли День_П = 10 Тогда
		День_П = "десятого";
	ИначеЕсли День_П = 11 Тогда
		День_П = "одиннадцатого";
	ИначеЕсли День_П = 12 Тогда
		День_П = "двенадцатого";
	ИначеЕсли День_П = 13 Тогда
		День_П = "тринадцатого";
	ИначеЕсли День_П = 14 Тогда
		День_П = "четырнадцатого";
	ИначеЕсли День_П = 15 Тогда
		День_П = "пятнадцатого";
	ИначеЕсли День_П = 16 Тогда
		День_П = "шестнадцатого";
	ИначеЕсли День_П = 17 Тогда
		День_П = "семнадцатого";
	ИначеЕсли День_П = 18 Тогда
		День_П = "восемнадцатого";
	ИначеЕсли День_П = 19 Тогда
