Функция ПроставитьСтрахователяВФайлахПоЗаявке(Полис) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка КАК Заявка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Страхователь КАК ЗаявкаСтрахователь,
	               |	уб_СтраховойПолис.Страхователь КАК ПолисСтрахователь,
	               |	уб_ФайлыКПолисам.УИД,
	               |	уб_ФайлыКПолисам.СтраховойПолис,
	               |	уб_ФайлыКПолисам.СК,
	               |	уб_ФайлыКПолисам.ВидБСО,
	               |	уб_ФайлыКПолисам.НомерБСО
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	               |		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка = уб_СтраховойПолис.Заявка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	               |		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.СсылкаСправочника = уб_ФайлыКПолисам.УИД
	               |ГДЕ
	               |	уб_ФайлыКПолисам.Страхователь = НЕОПРЕДЕЛЕНО
	               |	И уб_СтраховойПолис.Ссылка = &Полис
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.МоментВремени";
				   
	Запрос.УстановитьПараметр("Полис",Полис);
	Счетчик = 0;
	Выборка =  Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик+1;
		МЗ = РегистрыСведений.уб_ФайлыКПолисам.СоздатьМенеджерЗаписи();	
		МЗ.СтраховойПолис =  Выборка.СтраховойПолис;
		МЗ.УИД            =  Выборка.УИД;
		МЗ.СК             =  Выборка.СК;
		МЗ.ВидБСО         =  Выборка.ВидБСО;
		МЗ.НомерБСО       =  Выборка.НомерБСО; 
		МЗ.Прочитать();
		Если  Мз.Выбран() = Истина и Мз.Страхователь = Неопределено Тогда
			МЗ.Страхователь = Выборка.ПолисСтрахователь;
			МЗ.Записать();
		КонецЕсли;

	КонецЦикла;
	
КонецФункции


//Добавляем запись в журнал регистрации и выводим сообщение
//
//														ПАРАМЕТРЫ:
//*************************************************************************************************************************
//	ТекстСообщение			- Строка                                                                                      *
//                                                                                                                        *
//*************************************************************************************************************************
//	ТипСообщение			- Строка						Сообщить, Предупреждение	                                  *
//															Значение по умолчанию: Сообщить                               *
//*************************************************************************************************************************
//	ДобавлятьЗаписьВЖурнал  - Булево						Значение по умолчанию: Ложь							          *
//															                                                              *
//*************************************************************************************************************************
//															Информация, Ошибка, Предупреждение, Примечание                *
//	УровеньРегистрации   	- УровеньЖурналаРегистрации		Значение по умолчанию: Ошибка. Для информационного сообщения  *
//															будем использовать "Примечание"                               *
//*************************************************************************************************************************
//	ОбъектМетаданных		- ОбъектМетаданных                                                                            *
//                                                                                                                        *
//*************************************************************************************************************************
//															Данные, с которыми связано событие.                           *
//	СсылкаНаОбъект			- Произвольный					Рекомендуется указывать ссылки на объекты данных (элементы    *
//															справочников, документы, к которым относится событие).        *
//*************************************************************************************************************************
//	КомментарийЖурнала		- Строка						Комментарий к записи журнала регистрации                      *
//                                                                                                                        *
//*************************************************************************************************************************
//	Статус					- СтатусСообщения				БезСтатуса, Важное, Внимание, Информация, Обычное, ОченьВажное*
//															Значение по умолчанию: Обычное                                *
//*************************************************************************************************************************
//	Таймаут					- Число							Таймаут предупреждения                                        *
//															Значение по умолчанию: 0                                      *
//*************************************************************************************************************************
//	Заголовок				- Строка						Заголовок предупреждения                                      *
//															Значение по умолчанию: "1С:Предприятие"                       *
//*************************************************************************************************************************
Функция ЗаписатьОшибкуИСообщить(
	ТекстСообщения,
	ТипСообщения = "Сообщить", 
	ДобавлятьЗаписьВЖурнал = Ложь,  //3
	УровеньРегистрации = "",        //4
	ОбъектМетаданных = "",          //5
	СсылкаНаОбъект = "",            //6
	СобытиеЖурнала = "Логирование", //7
	Статус = "",                    //8
	Таймуат = 0,                    //9
	Заголовок = "") Экспорт         //10
	//Выводим информацию на экран
	Если ТипСообщения = "Сообщить" Тогда
		Если Статус = "" Тогда 
			Статус = СтатусСообщения.Обычное;
		КонецЕсли;
		//#Если Клиент Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения; 
			Сообщение.Сообщить();
			//Сообщить(ТекстСообщения, Статус);
		//КонецЕсли
	ИначеЕсли ТипСообщения = "Предупреждение" Тогда
		//Предупреждение возможно выдавать только в режиме клиента
		#Если Клиент Тогда
			Предупреждение(ТекстСообщения, Таймуат, Заголовок);
		#Иначе	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения; 
			Сообщение.Сообщить();
		#КонецЕсли
	КонецЕсли;
	//Создаем запись в журнале регистрации
	Если ДобавлятьЗаписьВЖурнал Тогда
		Если УровеньРегистрации = "" Тогда 
			УровеньРегистрации = УровеньЖурналаРегистрации.Ошибка;
		КонецЕсли;
		Если ОбъектМетаданных = "" и ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			Попытка
				ОбъектМетаданных = СсылкаНаОбъект.Метаданные();
			Исключение
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Передан объект не имеющий Метаданные() "+СсылкаНаОбъект; 
				Сообщение.Сообщить();
			КонецПопытки;	
		КонецЕсли;	
		ЗаписьЖурналаРегистрации("ITC."+СобытиеЖурнала, УровеньРегистрации, ОбъектМетаданных, СсылкаНаОбъект, ТекстСообщения);
	КонецЕсли;
КонецФункции
