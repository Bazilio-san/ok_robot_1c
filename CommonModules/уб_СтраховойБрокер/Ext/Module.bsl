Процедура РазобратьРазностьДат(ДатаОкончания, ДатаНачала, Лет = 0, Месяцев = 0, Дней = 0) Экспорт
    
    Лет     = 0;
    Месяцев = 0;
    Дней    = 0;
    Если ДатаОкончания > ДатаНачала Тогда
        
        ВременнаяДата = ДатаОкончания;
        Если День(ВременнаяДата) < День(ДатаНачала) Тогда
            Дней = (ВременнаяДата - ДобавитьМесяц(ВременнаяДата,-1))/86400;
            ВременнаяДата = ДобавитьМесяц(ВременнаяДата,-1);
        КонецЕсли;
        Если Месяц(ВременнаяДата) < Месяц(ДатаНачала) Тогда
            ВременнаяДата = ДобавитьМесяц(ВременнаяДата,-12);
            Месяцев = 12;
        КонецЕсли;
        Лет     = Макс(             Год(ВременнаяДата)        - Год(ДатаНачала),    0);
        Месяцев = Макс(Месяцев    + Месяц(ВременнаяДата)    - Месяц(ДатаНачала),    0);
        Дней    = Макс(Дней        + День(ВременнаяДата)    - День(ДатаНачала),    0);
        
        // скорректируем отображаемое значение, если "вмешалось" разное количество дней в месяцах
 
        Если ДатаНачала <> (ДобавитьМесяц(ДатаОкончания,-Лет*12-Месяцев)-Дней*86400) Тогда
            Дней = Дней + (День(КонецМесяца(ДатаНачала)) - День(НачалоМесяца(ДатаНачала))) - (День(КонецМесяца(ДобавитьМесяц(ДатаОкончания,-1))) - День(НачалоМесяца(ДобавитьМесяц(ДатаОкончания,-1))));
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры// РазобратьРазностьДат
