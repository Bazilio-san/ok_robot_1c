

// Устанавливает свойство ТолькоПросмотр (для элементов у которых нет такого свойства - устанавливает Доступность)
// у всех элементы формы  если у них стоит свойство ИзменяетДанные
// Табличные поля - устанавливает ИзменятьСоставСтрок, и также устанавливает ТолькоПросмотр для элементов управления колонок
//
// Параметры
//  ЭлементыФормы  – Массив – элементы формы по которым ставим досупность
//                 
//  Доступность  – Булево – Истина - установить доступность, Ложь - снять доступность
//
Процедура УстановитьДоступностьЭлементовФормы(ЭлементыФормы, Доступность) Экспорт
	ТипТП = Тип("ТабличноеПоле");
	ТипФл = Тип("Флажок");
	ТипПр = Тип("Переключатель");
	ТипКп = Тип("КоманднаяПанель");
	ТипКн = Тип("Кнопка");
	ТипН  = Тип("Надпись");
	ТипIMG = Тип("ПолеКартинки");
	ТипПВ = Тип("ПолеВвода");
	Для Каждого Элемент Из ЭлементыФормы Цикл
		Если Элемент.ИзменяетДанные Тогда
			ТипЭлемента = ТипЗнч(Элемент);
			Если ТипЭлемента = ТипПВ Тогда
				Элемент.ТолькоПросмотр = Не Доступность;
			ИначеЕсли ТипЭлемента = ТипН ИЛИ ТипЭлемента = ТипФл Или ТипЭлемента = ТипПр Или ТипЭлемента = ТипКп Или ТипЭлемента = ТипКн Или ТипЭлемента = ТипIMG Тогда
				Элемент.Доступность = Доступность;
			ИначеЕсли ТипЭлемента = ТипТП Тогда
				//Элемент.ИзменятьСоставСтрок = Доступность;
				//Для каждого Колонка Из Элемент.Колонки Цикл
				//	ЭлементУправления = Колонка.ЭлементУправления;
				//	ТипЭлемента = ТипЗнч(ЭлементУправления);
				//	Если ЭлементУправления = Неопределено Тогда
				//		Колонка.Доступность = Доступность;
				//	Иначе
				//		Если ТипЭлемента = ТипПВ Тогда 	
				//			ЭлементУправления.ТолькоПросмотр = Не Доступность;
				//		ИначеЕсли ТипЭлемента = ТипФл Или ТипЭлемента = ТипПр Тогда
				//			ЭлементУправления.Доступность = Доступность;
				//		Иначе
				//			ЭлементУправления.ТолькоПросмотр = Не Доступность;
				//		КонецЕсли;
				//	КонецЕсли;
				//КонецЦикла; 
				Элемент.ТолькоПросмотр = Не Доступность;
			Иначе 
				Элемент.ТолькоПросмотр = Не Доступность;
			КонецЕсли;
			//	
		КонецЕсли; 
	КонецЦикла;
КонецПроцедуры // УстановитьДоступностьЭлементовФормы


