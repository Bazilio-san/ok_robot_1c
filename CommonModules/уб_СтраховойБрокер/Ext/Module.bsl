Функция глВернутьКлючДляПозиционирования(ТЗ, Рег) Экспорт
	Отбор = Новый Структура;
	Для НомерКолонки=0 По тз.колонки.Количество()-1 Цикл
		Отбор.Вставить(тз.колонки[НомерКолонки].имя,тз[0][НомерКолонки]); 
