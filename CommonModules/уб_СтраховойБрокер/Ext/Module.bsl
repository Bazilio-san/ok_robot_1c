Процедура ПрочитатьСостояниеНомераПолиса(СтруктураСНП) Экспорт
	
	Если СтруктураСНП.Период = Неопределено Тогда
		СтруктураСНП.Период = Новый Граница(ТекущаяДата(), ВидГраницы.Исключая);
	КонецЕсли;
	СтруктураОтбора = Новый Структура("СК, НомерПолиса",СтруктураСНП.СК, СтруктураСНП.НомерПолиса);		
	//тзРег = РегистрыСведений.уб_СвободныеНомераПолисов.СрезПоследних(СтруктураСНП.Период, СтруктураОтбора);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_СвободныеНомераПолисовСрезПоследних.Поставщик,
	|	уб_СвободныеНомераПолисовСрезПоследних.НомерПолиса,
	|	уб_СвободныеНомераПолисовСрезПоследних.ГодПолиса,
	|	уб_СвободныеНомераПолисовСрезПоследних.НомерИспользован,
	|	уб_СвободныеНомераПолисовСрезПоследних.НомерЗаблокирован,
	|	уб_СвободныеНомераПолисовСрезПоследних.НомерЗарезервирован,
	|	уб_СвободныеНомераПолисовСрезПоследних.НомерВыданАгенту,
	|	уб_СвободныеНомераПолисовСрезПоследних.КодОперации,
	|	ВложенныйЗапрос.ВидНумерации
	|ИЗ
	|	РегистрСведений.уб_СвободныеНомераПолисов.СрезПоследних(
	|			&Период,
	|			СК = &СК
	|				И НомерПолиса = &НомерПолиса) КАК уб_СвободныеНомераПолисовСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			уб_СвободныеНомераПолисовСрезПервых.ВидНумерации КАК ВидНумерации,
	|			уб_СвободныеНомераПолисовСрезПервых.Регистратор КАК Регистратор,
	|			уб_СвободныеНомераПолисовСрезПервых.СК КАК СК,
	|			уб_СвободныеНомераПолисовСрезПервых.НомерПолиса КАК НомерПолиса
	|		ИЗ
	|			РегистрСведений.уб_СвободныеНомераПолисов.СрезПервых(
	|					,
	|					СК = &СК
	|						И НомерПолиса = &НомерПолиса
	|						И Регистратор ССЫЛКА Документ.уб_ПоступлениеНомеровПолисов) КАК уб_СвободныеНомераПолисовСрезПервых) КАК ВложенныйЗапрос
	|		ПО уб_СвободныеНомераПолисовСрезПоследних.СК = ВложенныйЗапрос.СК
	|			И уб_СвободныеНомераПолисовСрезПоследних.НомерПолиса = ВложенныйЗапрос.НомерПолиса");
	Запрос.УстановитьПараметр("Период", 		СтруктураСНП.Период);
	Запрос.УстановитьПараметр("СК",				СтруктураСНП.СК);
	Запрос.УстановитьПараметр("НомерПолиса",    СтруктураСНП.НомерПолиса);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		СтруктураСНП.Существует = Ложь;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		СтруктураСНП.Существует 		= Истина;
		СтруктураСНП.Поставщик 			= Выборка.Поставщик;
		СтруктураСНП.ВидНумерации 		= Выборка.ВидНумерации;
		СтруктураСНП.ГодПолиса			= Выборка.ГодПолиса;
		СтруктураСНП.НомерИспользован 	= Выборка.НомерИспользован;
		СтруктураСНП.НомерЗаблокирован	= Выборка.НомерЗаблокирован;
		СтруктураСНП.НомерЗарезервирован= Выборка.НомерЗарезервирован;
		СтруктураСНП.НомерВыданАгенту	= Выборка.НомерВыданАгенту;
		СтруктураСНП.КодОперации		= Выборка.КодОперации;
		СтруктураСНП.Существует 		= Истина;
	КонецЕсли;
	//Если тзРег.Количество() < 1 Тогда
