// Возвращает список положений БСО, которые соответствуют наличию БСО
//
// Параметры
//  ПоложениеБСО - ссылка на перечисление ПоложенияБСО
//
// Возвращаемое значение
//  Булево
//
Функция ПоложениеЕстьВНаличие(ПоложениеБСО) Экспорт 
	Если ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ПолученИзСК
	 или ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ВозвращенИзСК
	 или ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ПереданНаТочку
	 или ПоложениеБСО = Перечисления.уб_ПоложенияБСО.ВозвращенСТочки
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции


// Получает точку продаж по подразделению
//
// Параметры
//  Подразделение - ссылка на элемент справочника ПодразделенияОрганизации
//
// Возвращаемое значение
//  Ссылка на элемент справочника ПодразделенияОрганизации
//
Функция ПолучитьТочкуПродаж(Подразделение) Экспорт
	
	Если ЗначениеНеЗаполнено(Подразделение) Тогда
		Возврат Подразделение;
	КонецЕсли;
	
	Если Подразделение.УчетБСО Тогда
		Возврат Подразделение;
	Иначе
		Возврат ПолучитьТочкуПродаж(Подразделение.Родитель);
	КонецЕсли;
	
КонецФункции

// Процедура предназначена для заполнения общих реквизитов документов,
// вызывается в обработчиках событий "ПриОткрытии" в модулех форм всех документов.
//
// Параметры:
//  ДокументОбъект                 - объект редактируемого документа,
//  ТекПользователь                - ссылка на справочник, определяет текущего пользователя  
//  ВалютаРегламентированногоУчета - валюта регламентированного учета
//  ТипОперации                    - необязаетельный, строка вида операции ("Покупка" или "Продажа"),
//                                   если не передан, то реквизиты, зависящие от вида операции, не заполняются
//
Процедура ЗаполнитьШапкуДокументаСтрБрокер(ДокументОбъект, ТекПользователь, ВалютаРегламентированногоУчета = Неопределено, ТипОперации = "") Экспорт

	МетаданныеДокумента = ДокументОбъект.Метаданные();
    оПодразделениеПользователя = уб_СС.ПолучитьПодразделениеАгента(ТекПользователь.ФизЛицо);
	Если ЗначениеНеЗаполнено(оПодразделениеПользователя) Тогда
    	оПодразделениеПользователя = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация", МетаданныеДокумента) 
	  И ЗначениеНеЗаполнено(ДокументОбъект.Организация) Тогда
		ДокументОбъект.Организация = оПодразделениеПользователя.Владелец;
		Если ДокументОбъект.Организация.Пустая() Тогда
			ДокументОбъект.Организация = ПараметрыСеанса.уб_ОсновнаяОрганизация;
		КонецЕсли;	
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОрганизацияАгент", МетаданныеДокумента) 
	  И ЗначениеНеЗаполнено(ДокументОбъект.ОрганизацияАгент) Тогда
	  #Если Клиент Тогда
		  Если ТекПользователь = ПараметрыСеанса.ТекущийПользователь Тогда
			  ДокументОбъект.ОрганизацияАгент = ПараметрыСеанса.уб_ОсновнаяОрганизация
			  
		  Иначе  
			  
			  ДокументОбъект.ОрганизацияАгент = оПодразделениеПользователя.Владелец;
		  Конецесли;	
	  #Иначе
		  ДокументОбъект.ОрганизацияАгент = оПодразделениеПользователя.Владелец
	  #КонецЕсли
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ПодразделениеОрганизации", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.ПодразделениеОрганизации) Тогда
		ДокументОбъект.ПодразделениеОрганизации = оПодразделениеПользователя;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Ответственный", МетаданныеДокумента) Тогда
	  ДокументОбъект.Ответственный = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнойОтветственный");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Склад", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.Склад) Тогда
		ДокументОбъект.Склад = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнойСклад");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("БанковскийСчет", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.БанковскийСчет) Тогда
		ДокументОбъект.БанковскийСчет = ДокументОбъект.Организация.ОсновнойБанковскийСчет;
		Если ОбщегоНазначения.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = ДокументОбъект.Организация.ОсновнойБанковскийСчет.ВалютаДенежныхСредств;
		КонецЕсли;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("СчетОрганизации", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.СчетОрганизации) Тогда
		ДокументОбъект.СчетОрганизации = ДокументОбъект.Организация.ОсновнойБанковскийСчет;
		ДокументОбъект.ВалютаДокумента = ДокументОбъект.Организация.ОсновнойБанковскийСчет.ВалютаДенежныхСредств;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("КурсДокумента", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.КурсДокумента) Тогда
	    СтруктураКурсаДокумента      = ОбщегоНазначения.ПолучитьКурсВалюты(ДокументОбъект.ВалютаДокумента, ДокументОбъект.Дата);
		ДокументОбъект.КурсДокумента = СтруктураКурсаДокумента.Курс;
		Если ОбщегоНазначения.ЕстьРеквизитДокумента("КратностьДокумента", МетаданныеДокумента) Тогда
			ДокументОбъект.КратностьДокумента = СтруктураКурсаДокумента.Кратность;
		КонецЕсли;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ДатаС", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.ДатаС) Тогда
		ДокументОбъект.ДатаС = ДокументОбъект.Дата;
	КонецЕсли;
	# Если Клиент Тогда
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ПериодРегистрации", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.ПериодРегистрации) Тогда
		ДокументОбъект.ПериодРегистрации = НачалоМесяца(РабочаяДата);
	КонецЕсли;
	#КонецЕсли
	//{{ Добавлено Управление страховым брокером
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента)
	   И ЗначениеНеЗаполнено(ДокументОбъект.Подразделение) Тогда
		ДокументОбъект.Подразделение = ПолучитьТочкуПродаж(оПодразделениеПользователя);
	КонецЕсли;
	Если Метаданные.Последовательности.уб_УчетБСО.Документы.Содержит(МетаданныеДокумента) Тогда
		ДокументОбъект.Дата = ТекущаяДата();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизитыДокумента(ДокументОбъект, МетаданныеДокумента, ТекПользователь);

КонецПроцедуры

Процедура ЗаполнитьОбщиеРеквизитыДокумента(ДокументОбъект, МетаданныеДокумента, ТекПользователь) Экспорт
	
	ОбщиеРеквизиты 	= Метаданные.ОбщиеРеквизиты;
	ИмяДокумента	= МетаданныеДокумента.Имя;	
	//
	ОбщийРеквизит = ОбщиеРеквизиты.Автор;
	Если Не ОбщийРеквизит.Состав.Найти(ИмяДокумента) = Неопределено Или ОбщегоНазначения.ЕстьРеквизитДокумента("Автор", МетаданныеДокумента) Тогда
		ДокументОбъект.Автор = ТекПользователь;
	КонецЕсли;	
	ОбщийРеквизит = ОбщиеРеквизиты.ДатаСоздания;
	Если Не ОбщийРеквизит.Состав.Найти(ИмяДокумента) = Неопределено Или ОбщегоНазначения.ЕстьРеквизитДокумента("ДатаСоздания", МетаданныеДокумента) Тогда
		ДокументОбъект.ДатаСоздания = ТекущаяДата();
	КонецЕсли;	
	ОбщийРеквизит = ОбщиеРеквизиты.ДатаИзменения;
	Если Не ОбщийРеквизит.Состав.Найти(ИмяДокумента) = Неопределено Или ОбщегоНазначения.ЕстьРеквизитДокумента("ДатаИзменения", МетаданныеДокумента) Тогда
		ДокументОбъект.ДатаИзменения = ТекущаяДата();
	КонецЕсли;	
	ОбщийРеквизит = ОбщиеРеквизиты.Модификатор;
	Если Не ОбщийРеквизит.Состав.Найти(ИмяДокумента) = Неопределено Или ОбщегоНазначения.ЕстьРеквизитДокумента("Модификатор", МетаданныеДокумента) Тогда
		ДокументОбъект.Модификатор = ТекПользователь;
	КонецЕсли;	
	
КонецПроцедуры	
// Получает марку транспортного средства по объекту страхования
//
// Параметры
//  Подразделение - ссылка на элемент справочника ОбъектСтрахования
//
// Возвращаемое значение
//  Ссылка на элемент справочника МаркаТС или Неопределено
//
Функция ПолучитьМаркуТС(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТранспортныеСредства.МаркаТС
	|ИЗ
	|	РегистрСведений.уб_ТранспортныеСредства КАК ТранспортныеСредства
	|ГДЕ
	|	ТранспортныеСредства.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.МаркаТС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Получает направление по переданным параметрам
//
// Параметры
//  Подразделение - ссылка на элемент справочника ПодразделенияОрганизации
//  МаркаТС - ссылка на элемент справочника МаркиТС
//  ЧужоеТС - булево
//
// Возвращаемое значение
//  Ссылка на элемент справочника Направления или Неопределено
//
Функция ПолучитьНаправление(Подразделение, МаркаТС, ЧужоеТС=Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НаправленияНастройки.Направление,
	               |	НаправленияНастройки.МаркаТС,
	               |	ВЫБОР
	               |		КОГДА НаправленияНастройки.МаркаТС = &МаркаТС
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Приоритет
	               |ИЗ
	               |	РегистрСведений.уб_НаправленияНастройки КАК НаправленияНастройки
	               |ГДЕ
	               |	НаправленияНастройки.Подразделение = &Подразделение
	               |	И (НаправленияНастройки.МаркаТС = &МаркаТС
	               |			ИЛИ НаправленияНастройки.МаркаТС = &Остальные
	               |			ИЛИ НаправленияНастройки.МаркаТС = &Все)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритет";
	
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Если ЧужоеТС Тогда
		Запрос.УстановитьПараметр("МаркаТС", Неопределено);
	Иначе
		Запрос.УстановитьПараметр("МаркаТС", МаркаТС);
	КонецЕсли;
	Запрос.УстановитьПараметр("Остальные", Перечисления.уб_ВидыВыбораМаркиТС.ОстальныеТС);
	Запрос.УстановитьПараметр("Все", Перечисления.уб_ВидыВыбораМаркиТС.ВсеТС);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Направление;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Устанавливает номер документа с префиксом "00"
//
// Параметры
//  ДокументОбъект - объект документа
//
Процедура УстановитьНомерДокументаСтрБрокер(ДокументОбъект) Экспорт 
	ДокументОбъект.УстановитьНовыйНомер("00");
КонецПроцедуры

Функция УстановитьСледующийПорядковыйНомер(ВидДокумента) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	МАКСИМУМ(П.Номер) КАК ПоследнийНомер
				   |ИЗ
				   |	Документ."+ВидДокумента+" КАК П";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Номер = Выборка.ПоследнийНомер + 1;
	Иначе
		Номер = 1; 
	КонецЕсли;	
	Возврат Номер;	
КонецФункции

// Определяет, установлен ли запрет на дату мониторинга
//
// Параметры
//  ДатаМ - дата
//
// Возвращаемое значение
//  Истина - можно использовать, Ложь - нет
//
Функция МожноИспользоватьДатуМониторинга(ДатаМ) Экспорт
	
	ДатаЗапрета = ПараметрыСеанса.уб_Константы.уб_ДатаЗапретаДляМониторинга;	
	Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПраваНаИзменениеДатыМониторинга, Ложь) Тогда
		Возврат Истина;
	КонецЕсли;	
	Если ТипЗнч(ДатаЗапрета) = Тип("Дата") И ДатаЗапрета <> '00010101000000' Тогда
		Если ДатаМ <= ДатаЗапрета Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Возвращает дату запрета мониторинга
//
// Параметры
//  нет
//
// Возвращаемое значение
//  Строка
//
Функция ПолучитьДатуЗапретаМ() Экспорт 
	
	ДатаЗапрета = ПараметрыСеанса.уб_Константы.уб_ДатаЗапретаДляМониторинга;
	Если ТипЗнч(ДатаЗапрета) = Тип("Дата") Тогда
		ДатаЗапрета = Формат(ДатаЗапрета, "ДФ=dd.MM.yyyy");
	Иначе
		ДатаЗапрета = '00010101';
	КонецЕсли;
	Возврат ДатаЗапрета;
	
КонецФункции

////////////////////////////////////////////////////////////////////////
// Вспомогательные функции для получения значений из регистров 
// по нескольким измерениям, имеющим приоритет
////////////////////////////////////////////////////////////////////////

Процедура ДобавитьИзмерение(
	соотвИзмРС
	,Знач ИмяПоля
	,Аргумент
	,ЕстьГруппа = Ложь
	,ОбязательныйКритерий = Ложь
	,Важность = -1
	,Пусто = Неопределено
	,ПустоКакЗначение = Ложь //Если передано пустое значение измерения и в выборке есть пустое значение - специфичность будет назначаться как для совпадения 
	)
	ДанныеИзмерения = Новый Структура("ИмяПоля, Аргумент, Пусто, ЕстьГруппа, ОбязательныйКритерий, Важность, ПустоКакЗначение",
									   ИмяПоля, Аргумент, Пусто, ЕстьГруппа, ОбязательныйКритерий, Важность, ПустоКакЗначение); 
									   
	Если ЕстьГруппа Тогда
		СписокГрупп = Новый Массив;
		//>>>!!!TODEL
		//УправлениеВзаиморасчетами.ПолучитьСписокВышестоящихГрупп(СписокГрупп, Аргумент);	
		ДанныеИзмерения.Вставить("СписокГрупп",СписокГрупп);
	КонецЕсли;
	
	Если ДанныеИзмерения.Важность = -1 Тогда
		ДанныеИзмерения.Важность = Pow(2,соотвИзмРС.Количество());
	КонецЕсли;
	
	соотвИзмРС.Вставить(ИмяПоля,ДанныеИзмерения);
КонецПроцедуры

Функция ЯдроПолученияДанных_РЕГИСТР(наДату, соотвИзмРС, ТекстЗапроса, ПостояннаяЧастьЗапроса, РезультатЗапроса, ИмяРегистра, СписокПолейНеВлияющихНаПриоритет = Неопределено, Запрос = Неопределено)
	
	ПустаяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос();
	КонецЕсли;
	Запрос.УстановитьПараметр("наДату",наДату);
	Запрос.Текст = ПостояннаяЧастьЗапроса;
	Рез = ЯдроПолученияДанных(Запрос, соотвИзмРС, РезультатЗапроса, ПустаяЗапись, СписокПолейНеВлияющихНаПриоритет);	
	ТекстЗапроса = Запрос.Текст;
	Возврат Рез; 
	
КонецФункции

Функция ЯдроПолученияДанных(ЗапросЯдроПолученияДанных, соотвИзмРС, РезультатЗапроса, ПустаяЗапись, СписокПолейНеВлияющихНаПриоритет = Неопределено) Экспорт
	
	ФиктивноеЗначение = "фиктивное значение";	
	ТекстЗапроса = ЗапросЯдроПолученияДанных.Текст; 
	//Устанавливаем параметры для тех реквизитов, у которых указан признак ОбязательныйКритерий
	//Формируем пустые значения
	Для Каждого Элемент Из соотвИзмРС Цикл 
		Изм = Элемент.Значение;
		Изм.Пусто = ПустаяЗапись[Изм.ИмяПоля];
		Если  Изм.ОбязательныйКритерий Тогда
			ЗапросЯдроПолученияДанных.УстановитьПараметр(Изм.ИмяПоля, Изм.Аргумент);
			ТекстЗапроса = ТекстЗапроса +" И Т." + Изм.ИмяПоля + " = &" + Изм.ИмяПоля + " ";	
		КонецЕсли;
	КонецЦикла; 	
    ЗапросЯдроПолученияДанных.Текст = ТекстЗапроса;
 	РезультатЗапроса = ЗапросЯдроПолученияДанных.Выполнить();
	//ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
		ИмяПоля = Колонка.Имя;
		Элемент = соотвИзмРС[ИмяПоля];
		Если Элемент = Неопределено Тогда
			
			//Если НЕ ПустаяЗапись.Метаданные().Реквизиты.Найти(ИмяПоля) = Неопределено Тогда
				Попытка
					ЗначениеПустого  = ПустаяЗапись[ИмяПоля];
				Исключение
					Если Найти(ИмяПоля,"Строка") Тогда
						ЗначениеПустого = "";
					ИначеЕсли Найти(ИмяПоля,"Число") Тогда
						ЗначениеПустого = 0;	
					Иначе
						ЗначениеПустого = Неопределено;
					КонецЕсли;	
				КонецПопытки;	
			//Иначе
			//	Если Найти(ИмяПоля,"Строка") Тогда
			//		ЗначениеПустого = "";
			//	ИначеЕсли Найти(ИмяПоля,"Число") Тогда
			//		ЗначениеПустого = 0;	
			//	Иначе
			//		ЗначениеПустого = Неопределено;
			//	КонецЕсли;	
			//КонецЕсли;	
				
			ДобавитьИзмерение(соотвИзмРС,ИмяПоля,ФиктивноеЗначение,Ложь,Ложь,0,ЗначениеПустого);
 		КонецЕсли;
	КонецЦикла;
	ТаблицаРезультата.Колонки.Вставить(0,"Приоритет",,,15);
	ТаблицаРезультата.Колонки.Добавить("Специфичность",,,30);
	ТаблицаРезультата.Колонки.Добавить("Совпадения",,,30);
	СписокПолейНеВлияющихНаПриоритетЭтоМассив = ТипЗнч(СписокПолейНеВлияющихНаПриоритет) = Тип("Массив");
	Для Каждого Стр Из ТаблицаРезультата Цикл
		Совпадения = 0;
		Специфичность = 0;
		Важность = 0;
		сСпец = "";
		сСовп = "";
		Стр.Приоритет = 0;
		Для Каждого Элемент Из соотвИзмРС Цикл 
			//Если Стр.Приоритет = -1 Тогда
			//	//Пропускаем строки, у которых было найдено неравенство значения переданного измерения и значения поля 
			//	Прервать;//Продолжить;
			//КонецЕсли;
			Изм 			= Элемент.Значение;
			Аргумент 		= Изм.Аргумент;
			ПустоеЗначение 	= Изм.Пусто;
			ЗначениеПоля 	= Стр[Изм.ИмяПоля];
			ИмяПоля 		= Изм.ИмяПоля;
			Если Аргумент = ФиктивноеЗначение
				ИЛИ Аргумент = ПустоеЗначение 
				ИЛИ Аргумент = Неопределено 
				 Тогда
				//Передано пустое значение Измерения или не передано вовсе	
				Если СписокПолейНеВлияющихНаПриоритетЭтоМассив 
					И СписокПолейНеВлияющихНаПриоритет.Найти(ИмяПоля) <> Неопределено Тогда
					// Обрабатываемое поле входит в список (массив) полей, которые не должны влиять на приоритет
					// это никак не тражается на приоритете выбора
				ИначеЕсли ЗначениеПоля <> ПустоеЗначение Тогда
					//Устанавливаем специфичность 
					Специфичность = Специфичность + 1;
					сСпец = сСпец + ИмяПоля + "/"; //%%%%%
				ИначеЕсли ЗначениеПоля = ПустоеЗначение Тогда
					Если Изм.ПустоКакЗначение И ЗначениеПоля = Аргумент Тогда
						//Совпадения c пустым значением измерения
						//Устанавливаем специфичность 
						//Специфичность = Специфичность + 1;
						//сСпец = сСпец + ИмяПоля + "/"; //%%%%%
						//И, поскольку значение поля и измерения совпадают,
						//устанавливаем совпадение и важность
						Совпадения = Совпадения + Изм.Важность;
						сСовп = сСовп + ИмяПоля + "/"; //%%%%%
						Важность = Важность + Изм.Важность;
					Иначе
						// это никак не тражается на приоритете выбора
					КонецЕсли;
				Иначе
					// это никак не тражается на приоритете выбора
				КонецЕсли;
			Иначе
				//Передано действительное значение Измерения	
				Если ЗначениеПоля <> ПустоеЗначение Тогда
					//Если занчение поля не пусто 
					//и не совпадает с переданным,
					//Исключаем поле из рассмотрения
					Если ЗначениеПоля <> Аргумент Тогда
						Стр.Приоритет = -1;
						Прервать;//Продолжить;
					КонецЕсли;
					//Если значение поля не пусто
					//Устанавливаем специфичность
					Специфичность = Специфичность + 1;
					сСпец = сСпец + Изм.ИмяПоля + "/"; //%%%%%
					//И, поскольку значение поля и измерения совпадают,
					//устанавливаем совпадение и важность
					Совпадения = Совпадения + Изм.Важность;
					сСовп = сСовп + ИмяПоля + "/"; //%%%%%
					Важность = Важность + Изм.Важность;
				Иначе
					//Если занчение поля ПУСТО (то есть, оно не специфицировано и может быть подходящим по другим критериям..) 
					//Специфичность не устанавливаем
					//Важность - устанавливаем (значение измерения не пусто)
					Важность = Важность + Изм.Важность;
				КонецЕсли;
			КонецЕсли;
			Стр.Приоритет = Совпадения * 1000000000 + Специфичность * 1000000 + Важность;
			Стр.Специфичность = сСпец; //%%%%%
			Стр.Совпадения = сСовп; //%%%%%
		КонецЦикла;	
	КонецЦикла;
	ТаблицаРезультата.Сортировать("Приоритет Убыв");
	//Создаем колонки в последовательности по убыванию приоритета
	ТЗколонок = Новый ТаблицаЗначений;
	ТЗколонок.Колонки.Добавить("Важность");
	ТЗколонок.Колонки.Добавить("ИмяПоля");
	Для каждого Элемент Из соотвИзмРС Цикл 
		Изм = Элемент.Значение;
		НовСтр = ТЗколонок.Добавить();
		НовСтр.Важность = ?(Изм.ОбязательныйКритерий = Истина,-1,Изм.Важность);
		НовСтр.ИмяПоля = Изм.ИмяПоля;
	КонецЦикла;
	ТЗколонок.Сортировать("Важность Убыв");
	ТЗРез = Новый ТаблицаЗначений;
	Для каждого стрКол из ТЗколонок Цикл 
		ТЗРез.Колонки.Добавить(стрКол.ИмяПоля);
	КонецЦикла;
	//В результирующую таблицу добавляются строки с наивысшим значением приоритета (и только с одним значением приоритета!)
	Первый = Истина;
	ПоследнийПриоритет = 0;
	Для Каждого Стр Из ТаблицаРезультата Цикл
		Если Стр.Приоритет = -1 Тогда
			Продолжить;
		КонецЕсли;
		Если Первый Или Стр.Приоритет = ПоследнийПриоритет Тогда
			Первый = Ложь;
			ПоследнийПриоритет = Стр.Приоритет;
			НовСтрока = ТЗРез.Добавить();
			Для каждого Кол Из ТЗРез.Колонки Цикл
				НовСтрока[Кол.Имя] = Стр[Кол.Имя];
			КонецЦикла; 	
		КонецЕсли;
	КонецЦикла;
	Возврат ТЗРез;
	
КонецФункции


