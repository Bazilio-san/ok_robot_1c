// убирает в строке лидирующие нули
//
// Параметры
//  Стр - текстовая строка
//
// Возвращаемое значение
//  Текстовая строка - исходная строка без лидирующих нулей
//
Функция УбратьЛидирующиеНулиВСтроке(Знач Стр)
	Для Сч = 1 По СтрДлина(Стр) - 1 Цикл
		Если Лев(Стр, 1) = "0" Тогда
			Стр = Сред(Стр, 2);
		Иначе
			Прервать;
		КонецЕсли;	
	КонецЦикла; 
	Возврат Стр;
КонецФункции

Функция ДобавитьНулиСлева(Стр, ДоПолнойДлиныСтроки) Экспорт
	ДС = СтрДлина(Стр);
	Для й = ДС по ДоПолнойДлиныСтроки - 1 Цикл
		Стр = "0" + Стр;
		ДС = СтрДлина(Стр);
	КонецЦикла;
	Возврат Стр;
КонецФункции

// возвращает строку с лидирующими нулями из строки
//
// Параметры
//  Стр  – Строка 
//
// Возвращаемое значение:
//   Строка   – 
//
Функция ПолучитьЛидирующиеНулиИзСтроки(Знач Стр)
	СтрНули = "";
	Для Сч = 1 По СтрДлина(Стр) - 1 Цикл
		Если Лев(Стр, 1) = "0" Тогда
			Стр = Сред(Стр, 2);
			СтрНули = СтрНули + "0";
		Иначе
			Прервать;
		КонецЕсли;	
	КонецЦикла; 
	Возврат СтрНули;	
КонецФункции

Функция ДобавитьЛидирующиеНули(Знач Текст, ПривестиКДлине) Экспорт
	
	Текст = СокрЛП(Текст);
	Префикс = "";
	Номер = "";
	ВыделитьПрефиксИНомер(Текст, Префикс, Номер);
	ДлинаПрефикса = СтрДлина(Префикс);
	ДлинаНомера = СтрДлина(Номер);
	ДобавитьНулей = ПривестиКДлине - ДлинаПрефикса - ДлинаНомера;
	ЛидирующиеНули = "";
	Если ДобавитьНулей > 0 Тогда
		Для Сч = 1 По ДобавитьНулей Цикл
			ЛидирующиеНули = ЛидирующиеНули + "0";
		КонецЦикла;
	КонецЕсли;
	Возврат Префикс + ЛидирующиеНули + Номер;
	
КонецФункции

Процедура ВыделитьПрефиксИНомер(Текст, Префикс, Номер)
	
	ДлинаТекста = СтрДлина(Текст);
	Цифры = "0123456789";
	Для Сч = 1 По ДлинаТекста Цикл
		Символ = Сред(Текст, Сч, 1);
		ЭтоЦифра = Найти(Цифры, Символ) <> 0;
		Если ЭтоЦифра Тогда
			Прервать;
		Иначе
			Префикс = Префикс + Символ;
		КонецЕсли;
	КонецЦикла;
	Если Префикс <> "" Тогда
		Номер = СтрЗаменить(Текст, Префикс, "");
	Иначе
		Номер = Текст;
	КонецЕсли;
	
КонецПроцедуры

Функция ВыделитьПрефикс(фНомерБСО) Экспорт
	
	СтрЦифры = "0123456789";
	КолСим = СтрДлина(фНомерБСО);
	ЕстьПрефикс = Ложь;
	Для Сч = 1 По КолСим Цикл
		ПравСч = КолСим - Сч + 1;
		Если Найти(СтрЦифры, Сред(фНомерБСО, ПравСч, 1)) = 0 Тогда
			ЕстьПрефикс = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла; 
	
	Если ЕстьПрефикс Тогда
		Возврат Лев(фНомерБСО, ПравСч);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Проверяем на наличие в строке любых символов кроме цифр.
//
// Параметры
//  Стр  – Строка 
//
// Возвращаемое значение:
//   Булево   – Истина - есть, Ложь - нет
//
Функция ПроверитьНаНаличиеСимволовВСтроке(Стр)
	СтрЦифры = "0123456789";
	Для Сч = 1 По СтрДлина(Стр) Цикл
		Если Найти(СтрЦифры, Сред(Стр, Сч, 1)) = 0 Тогда
			Возврат Истина;
		КонецЕсли;	
	КонецЦикла; 
	Возврат Ложь;
КонецФункции
//Функция возвращает только цифры из переданной строки (например, для очистки телефонного номера от разделителей)
Функция ТолькоЦифрыСтроки(Стр,ДлинаСтроки = 0) Экспорт
	_стрЦифры = "0123456789";
	_ДлинаИсхСтроки = СтрДлина(Стр);
	Результат = "";
	Для _Сч = 1 По _ДлинаИсхСтроки Цикл
		_Символ = Сред(Стр, _Сч, 1);
		Если Найти(_стрЦифры,_Символ ) = 0 Тогда
			Продолжить;
		КонецЕсли;	
		Результат = Результат + _Символ;
		ДлинаСтроки = ДлинаСтроки + 1;
	КонецЦикла; 
	Возврат Результат;
КонецФункции	
// Определяет максимальную длину номера, по переданным параметрам номера
//
// Параметры
//  Серия   - строка
//  НачНомер   - строка
//  КонНомер   - строка
//  Год   - строка
//
// Возвращаемое значение
//  Число
//
Функция ОпределитьМаксДлинуНомера(Серия, НачНомер, КонНомер, Год = "") Экспорт 
	
	ДлинаСерии = ?(ЗначениеНеЗаполнено(Серия),0,СтрДлина(СокрЛП(Серия)));
	ДлинаНомера = Макс(СтрДлина(НачНомер), СтрДлина(УбратьЛидирующиеНулиВСтроке(КонНомер)));
	ДлинаГода = ?(ЗначениеНеЗаполнено(Год),0,СтрДлина(СокрЛП(Год)));
	
	Возврат ДлинаСерии + ДлинаНомера + ДлинаГода;
	
КонецФункции

// Проверяет правильность введенного диапазона номеров БСО
//
// Параметры
//  Начало  - строка, начало диапазона
//  Конец   - строка, конец диапазона
//
// Возвращаемое значение
//  Истина - диапазон установлен корректно, Ложь - не корректно
//
Функция ПроверитьДиапазонБСО(Начало, Конец, ДопускатьОбратнуюНумерацию = Ложь) Экспорт
	
	// сначала проверим на правильность заполнения (чтобы не было ничего кроме цифр)
	Если ПроверитьНаНаличиеСимволовВСтроке(Начало) 
	 или ПроверитьНаНаличиеСимволовВСтроке(Конец) Тогда
		Сообщить("В значениях диапазона не должно быть других символов кроме цифр!");
		Возврат Ложь;	
	КонецЕсли; 
	КонецЧ = УбратьЛидирующиеНулиВСтроке(Конец);
	Если КонецЧ = "" Тогда // т.к. пустая строка к числу не преобразуется
		КонецЧ = 0;
	Иначе
		КонецЧ = Число(КонецЧ);
	КонецЕсли; 
	НачалоЧ = УбратьЛидирующиеНулиВСтроке(Начало);
	Если НачалоЧ = "" Тогда
		НачалоЧ = 0;
	Иначе
		НачалоЧ = Число(НачалоЧ);
	КонецЕсли; 
	Если НЕ ДопускатьОбратнуюНумерацию Тогда
		Если КонецЧ <> 0 И (НачалоЧ > КонецЧ И НЕ ДопускатьОбратнуюНумерацию) Тогда
			Сообщить("Не верно указано значение диапазона!");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Рассчитывает количество номеров БСО в диапазоне
//
// Параметры
//  Начало  - строка, начало диапазона
//  Конец   - строка, конец диапазона
//
// Возвращаемое значение
//  Число, величина диапзона
//
Функция РассчитатьКоличествоБСО(Начало, Конец) Экспорт
	НачалоЧ = УбратьЛидирующиеНулиВСтроке(Начало);
	Если НачалоЧ = "" Тогда
		НачалоЧ = 0;
	Иначе
		НачалоЧ = Число(НачалоЧ);
	КонецЕсли; 
	КонецЧ = УбратьЛидирующиеНулиВСтроке(Конец);
	Если КонецЧ = "" Тогда // т.к. пустая строка к числу не преобразуется
		КонецЧ = НачалоЧ;
	Иначе
		КонецЧ = Число(КонецЧ);
	КонецЕсли; 
	
	Если КонецЧ = 0 и НачалоЧ = 0 Тогда
		Возврат 0;
	ИначеЕсли КонецЧ >= НачалоЧ Тогда
		Возврат КонецЧ - НачалоЧ + 1;
	Иначе
		Возврат НачалоЧ - КонецЧ + 1;
	КонецЕсли;
КонецФункции

// Формирует таблицу с номерами БСО и номерами полисов
//
// Параметры
//  СтрокаТЧ - строка табличной части документа ПоступлениеБСО
//
// Возвращаемое значение
//  Таблица значений
//

Функция СформироватьСписокНомеровБСО(СтрокаТЧ) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерБСО");
	ТЗ.Колонки.Добавить("НомерПолиса");
	
	ЕстьНомераПолисов = уб_СЛ.НомерПолисаЗаполняетсяПриПоступлении(СтрокаТЧ.ВидБСО);
	
	сНачНомерБСО = СтрокаТЧ.НачНомерБСО;
	сКонНомерБСО = СтрокаТЧ.КонНомерБСО;
	КолличествоБСО = СтрокаТЧ.КоличествоБСО;
	чНомерБСО = Число2(сНачНомерБСО);
	МаксДлинаНомераБСО  = Макс(СтрДлина(сНачНомерБСО),СтрДлина(сКонНомерБСО));
	
	Если ЕстьНомераПолисов Тогда
		сНачНомерСП = СтрокаТЧ.НачНомерПолиса;
		сКонНомерСП = СтрокаТЧ.КонНомерПолиса;
		КолличествоСП = СтрокаТЧ.КоличествоПолисов;
		чНомерСП = Число2(сНачНомерСП);
		МаксДлинаНомераСП  = Макс(СтрДлина(сНачНомерСП),СтрДлина(сКонНомерСП));
		
		Если КолличествоСП > 1 И Число2(сНачНомерСП) > Число2(сКонНомерСП) Тогда
			Дельта = -1; //Обратная нумерация полисов
		Иначе	 
			Дельта = 1; //Прямая нумерация полисов
		КонецЕсли;
	КонецЕсли;

	Для N=0 По КолличествоБСО - 1 Цикл
		СтрокаТЗ = ТЗ.Добавить();
		сНомерБСО = Формат(чНомерБСО,"ЧГ=");
		ДобавитьНулиСлева(сНомерБСО, МаксДлинаНомераБСО);
		СерияБСО = СокрЛП(СтрокаТЧ.СерияБСО);
		СтрокаТЗ.НомерБСО = СерияБСО + сНомерБСО;
		чНомерБСО = чНомерБСО + 1;
		
		Если ЕстьНомераПолисов Тогда
			сНомерСП = Формат(чНомерСП,"ЧГ=");
			ДобавитьНулиСлева(сНомерСП, МаксДлинаНомераСП);
			СерияСП = СокрЛП(СтрокаТЧ.СерияПолиса);
			СуффиксСП = СокрЛП(СтрокаТЧ.СуффиксПолиса);
			СтрокаТЗ.НомерПолиса = СерияСП + сНомерСП + СуффиксСП;
			чНомерСП = чНомерСП + Дельта;
		КонецЕсли;
	КонецЦикла;
	Возврат ТЗ;
КонецФункции 

// Формирует таблицу с номерами полисов
//
// Параметры
//  СтрокаТЧ - строка табличной части документа НомерПолиса
//
// Возвращаемое значение
//  Таблица значений
//
Функция СформироватьСписокНомеровПолисов0(СтрокаТЧ) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерПолиса");
	
	ДлинаНачНомераПолиса = СтрДлина(СтрокаТЧ.НачНомерПолиса);
	НачНомерПолиса = УбратьЛидирующиеНулиВСтроке(СтрокаТЧ.НачНомерПолиса);
	НачНомерПолиса = Число(?(НачНомерПолиса="","0",НачНомерПолиса));
	КонНомерПолиса = УбратьЛидирующиеНулиВСтроке(СтрокаТЧ.КонНомерПолиса);
	КонНомерПолиса = Число(?(КонНомерПолиса="","0",КонНомерПолиса));
	НулиНомераПолиса = ПолучитьЛидирующиеНулиИзСтроки(СтрокаТЧ.НачНомерПолиса); 
	Для Сч = 0 По СтрокаТЧ.КоличествоПолисов-1 Цикл
		СтрокаТЗ = ТЗ.Добавить();
		
		СерияПолиса = СокрЛП(СтрокаТЧ.СерияПолиса);
		НомерПолиса = Формат(НачНомерПолиса+Сч, "ЧГ=");
		СуффиксПолиса	= СокрЛП(СтрокаТЧ.СуффиксПолиса);
		Если СтрДлина(НомерПолиса) >= ДлинаНачНомераПолиса Тогда
			СтрокаТЗ.НомерПолиса = СерияПолиса + НомерПолиса + СуффиксПолиса;
		Иначе
			СтрокаТЗ.НомерПолиса = СерияПолиса + Прав(НулиНомераПолиса + НомерПолиса, ДлинаНачНомераПолиса) + СуффиксПолиса;
		КонецЕсли;
	КонецЦикла; 	
	
	Возврат ТЗ;
	
КонецФункции 

Функция СформироватьСписокНомеровПолисов(СтрокаТЧ) Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерПолиса");
	
	сНачНомерСП = СтрокаТЧ.НачНомерПолиса;
	сКонНомерСП = СтрокаТЧ.КонНомерПолиса;
	КолличествоСП = СтрокаТЧ.КоличествоПолисов;
	чНомерСП = Число2(сНачНомерСП);
	МаксДлинаНомераСП  = Макс(СтрДлина(сНачНомерСП),СтрДлина(сКонНомерСП));
	
	Если КолличествоСП > 1 И Число2(сНачНомерСП) > Число2(сКонНомерСП) Тогда
		Дельта = -1; //Обратная нумерация полисов
	Иначе	 
		Дельта = 1; //Прямая нумерация полисов
	КонецЕсли;

	Для N=0 По КолличествоСП - 1 Цикл
		СтрокаТЗ = ТЗ.Добавить();
		сНомерСП = Формат(чНомерСП,"ЧГ=");
		ДобавитьНулиСлева(сНомерСП, МаксДлинаНомераСП);
		СерияСП = СокрЛП(СтрокаТЧ.СерияПолиса);
		СуффиксСП = СокрЛП(СтрокаТЧ.СуффиксПолиса);
		СтрокаТЗ.НомерПолиса = СерияСП + сНомерСП + СуффиксСП;
		чНомерСП = чНомерСП + Дельта;
	КонецЦикла;
	Возврат ТЗ;
КонецФункции 

//-------------------------------------------------------
//  Разделение номеров БСО и полисов на серию и номер
//-------------------------------------------------------

//Вспомогательная функция. Получает полный номер и список серий в виде выборки.
//Находит из списка подходящую серию и выделяет ее.
//Дефис на конце серии удаляется
Процедура Получить_Серию_и_Номер_по_полному_номеру_и_выборке_серий(СерияИНомер, ВыборкаСерий, Серия = "", Номер = "");
	
	//В случае, если серию не найдем, вернем пустую серию и в номере - полный номер
	Номер = СокрЛП(СерияИНомер); 
	
	Пока ВыборкаСерий.Следующий() Цикл
		Сер = СокрЛП(ВыборкаСерий.Серия);
		
		//Если серия найдена не с первой позиции, то это не наш вариант
		Если Найти(СерияИНомер, Сер) <> 1 Тогда
			Продолжить;	
		КонецЕсли;
		
		//Вычленяем номер, удаляя серию 
		Номер = СтрЗаменить(Номер,Сер,"" ); 
		
		//Удаляем конечный дефис у серии, если он есть
		Серия = ?(Прав(Сер,1) = "-", СтрЗаменить(Сер + "@","-@","" ), Сер);
	КонецЦикла;
КонецПроцедуры

// Возвращает значение Серии и Номера полиса ИЛИ БСО по виду и номеру БСО
// В зависимости от типа учета БСО: 
// Если номер полиса отсутствует (квитанция), то вернутся серия и номер БСО
// Если номер полиса есть (указывается при поступлении, соответствует номеру БСО, свободный или указывается вручную),
// то вернется серия и номер ПОЛИСА.
// (если серию выделить не получится, вернется пустая серия и полный номер в номере, например для номеров полисов, указываемых вручную)
// 
//Параметры: ВидБСО, НомерБСО
// Возвращаемые значения: СерияП, НомерП
//
// Использование:
//СерияП = "";
//НомерП = "";
//Имя_функции(ВидБСО, НомерБСО, СерияП, НомерП);
//
Процедура Получить_Серию_и_Номер_БСО_или_ПОЛИСА_по_НомеруБСО(ВидБСО, НомерБСО, СерияП = "", НомерП = "") Экспорт
	//Остается случай, когда номер БСО есть, но нет номера полиса (например, карточки)
	//В этом случае оставляем серию и номер пустыми - по факту их просто нет

	Если ВидБСО.ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.НомернойНетПолиса Тогда
		Выделить_Серию_и_Номер_в_НомереБСО(ВидБСО, НомерБСО, СерияП, НомерП)
	Иначе
		Получить_Серию_и_Номер_ПОЛИСА_по_НомеруБСО(ВидБСО, НомерБСО, СерияП, НомерП);
	КонецЕсли;
	
КонецПроцедуры 

// Возвращает значение Серии и Номера !ПОЛИСА! по Виду и Номеру БСО
// Параметры: ВидБСО, НомерБСО
// Возвращаемые значения: СерияП, НомерП
//
// Использование:
//СерияП = "";
//НомерП = "";
//Имя_функции(ВидБСО, НомерБСО, СерияП, НомерП);
//
Процедура Получить_Серию_и_Номер_ПОЛИСА_по_НомеруБСО(ВидБСО, НомерБСО, СерияП = "", НомерП = "") Экспорт
	
	//Если номерной учет по номеру бланка не ведется,
	//то по номеру БСО и нечего искать.
	Если НЕ уб_СЛ.ОпределитьВедетсяНомернойУчет(ВидБСО) Тогда 
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СК", ВидБСО.Владелец); //Нужно для попадания в индекс в запросах - существенно быстрее!
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО", НомерБСО);
	
	
	//Если используются свободные номера полисов или номер полиса заполняется вручную, 
	//то надо искать номер ПОЛИСА по Номеру БСО
	бНомерПолисаСвободный = уб_СЛ.ОпределитьИспользуютсяСвободныеНомераПолисов(ВидБСО);
	бНомерПолисаВручную = уб_СЛ.НомерПолисаЗаполняетсяВручную(ВидБСО);

	Если бНомерПолисаСвободный ИЛИ бНомерПолисаВручную Тогда 
		
		// Находим номер полиса, соответствующего данному номеру БСО
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Т.НомерПолиса
		               |ИЗ
		               |	РегистрСведений.уб_ДвиженияБСО КАК Т
		               |ГДЕ
		               |	Т.ВидБСО = &ВидБСО
		               |	И Т.НомерБСО = &НомерБСО
					   |	И Т.Регистратор ССЫЛКА Документ.уб_СтраховойПолис
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Т.Активность УБЫВ";
					   //|	Т.ДокПроведен УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать(); 
		
		//Номер полиса не найден - выходим без результата
		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		//Найдено движение, сделанное полисом
		НомерП =  Выборка.НомерПолиса;
		
		//Если номер полиса вписан вручную, то серию у него выделить не представляется возможным (нет ни серий в системе ни четкого алгоритма, по которому можно выделить серию)
		Если бНомерПолисаВручную Тогда 
			Возврат;
		КонецЕсли;
		
		//Остается случай, когда номер полиса получается из списка свободных
		//Тогда в системе было поступление этого свободного номера (если в полисе не накосячили)
		Выделить_Серию_и_Номер_Полиса_в_Свободном_Номере(ВидБСО.Владелец, НомерП, СерияП = "", НомерП = "");
		
		Возврат;
	КонецЕсли;
	
	
	//Если номер полиса заполняется при поступлении:
	Если уб_СЛ.НомерПолисаЗаполняетсяПриПоступлении(ВидБСО) Тогда
		Выделить_Серию_и_Номер_ПОЛИСА_по_НомеруБСО_для_номера_полиса_заполняющегося_при_поступлении(ВидБСО, НомерБСО, СерияП, НомерП);
		Возврат;
	КонецЕсли;
	
	//Остается случай, когда номер БСО есть, но нет номера полиса (например, карточки)
	//В этом случае оставляем серию и номер пустыми - по факту их просто нет
	
КонецПроцедуры 

// Возвращает значение Серии и Номера !ПОЛИСА! по виду и номеру БСО для БСО, у которого 
// номер полиса заполняется при поступлении 
// (когда соответствует номеру БСО или указывается отдельным диапазоном номеров полисов со своими сериями): 
// Для всех остальных типов учета БСО вернутся пустая серия и номер 
// 
//Параметры: ВидБСО, НомерБСО
// Возвращаемые значения: СерияП, НомерП
//
// Использование:
//СерияП = "";
//НомерП = "";
//Имя_функции(ВидБСО, НомерБСО, СерияП, НомерП);
//
Процедура Выделить_Серию_и_Номер_ПОЛИСА_по_НомеруБСО_для_номера_полиса_заполняющегося_при_поступлении(ВидБСО, НомерБСО, Серия = "", Номер = "") Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО", НомерБСО);
	
	// Находим документ поступления для переданного номра БСО
	// А из него выбираем набор серий ПОЛИСА
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиПоступления.СерияПолиса как Серия,
	|	ДокПоступления.НомерПолиса
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК СтрокиПоступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Т2.Регистратор КАК Ссылка,
	|			Т2.НомерПолиса КАК НомерПолиса
	|		ИЗ
	|			РегистрСведений.уб_ДвиженияБСО КАК Т2
	|		ГДЕ
	|			Т2.ВидБСО = &ВидБСО
	|			И Т2.НомерБСО = &НомерБСО
	|			И Т2.Подтверждено
	|			И Т2.Активность
	|			И Т2.Регистратор ССЫЛКА Документ.уб_ПоступлениеБСО) КАК ДокПоступления
	|		ПО СтрокиПоступления.Ссылка = ДокПоступления.Ссылка
	|			И (СтрокиПоступления.ВидБСО = &ВидБСО)";
	ВыборкаСерий = Запрос.Выполнить().Выбрать(); 
	Если ВыборкаСерий.Следующий() Тогда			   
		НомерПолиса = ВыборкаСерий.НомерПолиса;	
		ВыборкаСерий.Сбросить();
		Получить_Серию_и_Номер_по_полному_номеру_и_выборке_серий(НомерПолиса, ВыборкаСерий, Серия, Номер);
	КонецЕсли;
КонецПроцедуры

// Возвращает значение Серии и Номера БСО по Виду и полному НомеруБСО
// Параметры: ВидБСО, НомерБСО
// Возвращаемые значения: СерияБСО, НомерБСО
//
// Использование:
//Серия = "";
//Номер = "";
//Имя_функции(ВидБСО, НомерБСО, Серия, Номер);
//
Процедура Выделить_Серию_и_Номер_в_НомереБСО(ВидБСО, НомерБСО, Серия = "", Номер = "", ВидБСОВладелец = Неопределено) Экспорт
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("НомерБСО", НомерБСО);
	
	// Находим документ поступления для переданного номра БСО
	// А из него выбираем набор серий БСО
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиПоступления.СерияБСО КАК Серия
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК СтрокиПоступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Т2.Регистратор КАК Ссылка
	|		ИЗ
	|			РегистрСведений.уб_ДвиженияБСО КАК Т2
	|		ГДЕ
	|			Т2.ВидБСО = &ВидБСО
	|			И Т2.НомерБСО = &НомерБСО
	|			И Т2.Подтверждено
	|			И Т2.Активность
	|			И Т2.Регистратор ССЫЛКА Документ.уб_ПоступлениеБСО) КАК ДокПоступления
	|		ПО СтрокиПоступления.Ссылка = ДокПоступления.Ссылка
	|			И (СтрокиПоступления.ВидБСО = &ВидБСО)";
	ВыборкаСерий = Запрос.Выполнить().Выбрать();
	
	Получить_Серию_и_Номер_по_полному_номеру_и_выборке_серий(НомерБСО, ВыборкаСерий, Серия, Номер);
КонецПроцедуры

Процедура ПолучитьТаблицу_Серий_в_НомерахБСО(Таблица) Экспорт
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	// Находим документ поступления для переданного номра БСО
	// А из него выбираем набор серий БСО
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.НомерБСО,
	|	Таблица.ВидБСО,
	|	Таблица.ВидБСОВладелец КАК ВидБСОВладелец
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	&Таблица КАК Таблица
	|ГДЕ
	|	Таблица.НомерБСО <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиПоступления.СерияБСО КАК Серия,
	|	СтрокиПоступления.ВидБСО,
	|	СтрокиПоступления.СК КАК ВидБСОВладелец,
	|	ДокПоступления.НомерБСО КАК НомерБСО
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК СтрокиПоступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МАКСИМУМ(Т2.Регистратор) КАК Ссылка,
	|			ВТ_Таблица.НомерБСО КАК НомерБСО,
	|			ВТ_Таблица.ВидБСО КАК ВидБСО,
	|			ВТ_Таблица.ВидБСОВладелец КАК СК
	|		ИЗ
	|			РегистрСведений.уб_ДвиженияБСО КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Таблица КАК ВТ_Таблица
	|				ПО Т2.СК = ВТ_Таблица.ВидБСОВладелец
	|					И Т2.ВидБСО = ВТ_Таблица.ВидБСО
	|					И Т2.НомерБСО = ВТ_Таблица.НомерБСО
	|					И (Т2.Подтверждено)
	|					И (Т2.Активность)
	|					И (Т2.Регистратор ССЫЛКА Документ.уб_ПоступлениеБСО)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_Таблица.НомерБСО,
	|			ВТ_Таблица.ВидБСО,
	|			ВТ_Таблица.ВидБСОВладелец) КАК ДокПоступления
	|		ПО СтрокиПоступления.Ссылка = ДокПоступления.Ссылка
	|			И СтрокиПоступления.ВидБСО = ДокПоступления.ВидБСО
//	|			И СтрокиПоступления.СК = ДокПоступления.СК
	|ИТОГИ ПО
	|	НомерБСО";
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//Отбор = Новый Структура("НомерБСО, ВидБСО, ВидБСОВладелец");
	Отбор = Новый Структура("НомерБСО");
	Пока Выборка.Следующий() Цикл			   
		Серия = "";
		Номер = "";
		ВыборкаСерий = Выборка.Выбрать();					
		Получить_Серию_и_Номер_по_полному_номеру_и_выборке_серий(Выборка.НомерБСО, ВыборкаСерий, Серия, Номер);
		Если Серия <> "" Тогда
			Отбор.НомерБСО = Выборка.НомерБСО;
			//Отбор.ВидБСО = Выборка.ВидБСО;
			//Отбор.ВидБСОВладелец = Выборка.ВидБСОВладелец;
			СтрокиТЗ = Таблица.НайтиСтроки(Отбор);
			Для Каждого СтрокаТЗ Из СтрокиТЗ Цикл
				СтрокаТЗ.Серия = Серия;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает значение Серии и Номера свободного номера полиса по СК и полному свободному номеру полиса
// Параметры: СК, НомерПолиса
// Возвращаемые значения: Серия, Номер
//
// Если серия не выделена, вернется пустая серия, а номер - полный номер
//
// Использование:
//Серия = "";
//Номер = "";
//Имя_функции(СК, НомерПолиса, Серия, Номер);
//
Процедура Выделить_Серию_и_Номер_ПОЛИСА_в_Свободном_Номере(СК, НомерПолиса, СерияП = "", НомерП = "") Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СК", СК); //Нужно для попадания в индекс в запросах - существенно быстрее!
	Запрос.УстановитьПараметр("НомерПолиса", НомерПолиса);
	
	//Вложенным запросом находим движение заданного номера полиса, 
	//сделанное документом уб_ПоступлениеНомеровПолисов
	//В полученном документе находим список серий 			   
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Т.СерияПолиса КАК Серия
	               |ИЗ
	               |	Документ.уб_ПоступлениеНомеровПолисов.НомераПолисов КАК Т
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	               |			С.Регистратор КАК Регистратор,
	               |			С.ВидНумерации КАК ВидНумерации
	               |		ИЗ
	               |			РегистрСведений.уб_СвободныеНомераПолисов КАК С
	               |		ГДЕ
	               |			С.СК = &СК
	               |			И С.НомерПолиса = &НомерПолиса
	               |			И С.Регистратор ССЫЛКА Документ.уб_ПоступлениеНомеровПолисов) КАК СВ
	               |		ПО Т.Ссылка = СВ.Регистратор
	               |			И Т.ВидНумерации = СВ.ВидНумерации";
				   
	ВыборкаСерий = Запрос.Выполнить().Выбрать(); 
	Получить_Серию_и_Номер_по_полному_номеру_и_выборке_серий(НомерПолиса, ВыборкаСерий, СерияП, НомерП);
КонецПроцедуры

