Функция  ОбъединениеТаблиц(Таблица1,Таблица2) Экспорт
	ОбъединениеТаблиц = Таблица2.Скопировать();
	Для ё = 1 По Таблица1.Количество() Цикл ОбъединениеТаблиц.Вставить(0) КонецЦикла;
	Для ё = 0 По Таблица1.Колонки.Количество() - 1 Цикл 
		ОбъединениеТаблиц.ЗагрузитьКолонку(Таблица1.ВыгрузитьКолонку(ё), ё) 
	КонецЦикла;
	Возврат ОбъединениеТаблиц;
КонецФункции

Функция СписокПоследнихЗначений(ИмяРеквизита,Дней = 7, ВидДока = "уб_ЗаявкаНаЗаказВыездногоСпециалиста") Экспорт
	Попытка
		Запрос = Новый  Запрос;
		ЗапроС.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВидДокумента."+ИмяРеквизита+" КАК Реквизит
			|ИЗ
			|	Документ."+ВидДока+" КАК ВидДокумента
			|ГДЕ
			|	ВидДокумента.Дата >= &Дата1
			|
			|УПОРЯДОЧИТЬ ПО
		|	"+ИмяРеквизита;
		Запрос.УстановитьПараметр("Дата1",ТекущаяДата()-Дней*24*3600);		   
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Реквизит");		   	
		Массив2 = Новый Массив;
		Для Каждого Эл Из Массив Цикл
			Если ЗначениеЗаполнено(Массив2)  Тогда
				Массив2.Добавить(Эл);
			КонецЕсли;	
		КонецЦикла;
		Возврат Массив2;
	Исключение
		Возврат Новый  Массив;
	КонецПопытки;
	
КонецФункции	

Функция ЗаполнитьВидБСОПолиса(Дата = Неопределено) Экспорт
	Запрос =новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	уб_ОплатаПолисов.Ссылка,
	              |	уб_ОплатаПолисов.СтраховойПолис,
	              |	уб_ОплатаПолисов.ВидБСОПолиса,
	              |	уб_СтраховойПолисБСО.ВидБСО как ВидБСО
	              |ИЗ
	              |	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис.БСО КАК уб_СтраховойПолисБСО
	              |		ПО (уб_СтраховойПолисБСО.Ссылка = уб_ОплатаПолисов.СтраховойПолис)
	              |			И (уб_СтраховойПолисБСО.ВидБСО.Тип В (ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис), ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОСАГО)))
	              |ГДЕ
	              |	уб_ОплатаПолисов.Дата >= &Дата
	              |	И уб_ОплатаПолисов.ВидБСОПолиса <> уб_СтраховойПолисБСО.ВидБСО
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	уб_ОплатаПолисов.Дата";
				  Если Дата = Неопределено Тогда
					 Дата = Дата(2018,1,1);
					КонецЕсли; 
					
					Запрос.УстановитьПараметр("Дата",Дата);
				  Выборка= Запрос.Выполнить().Выбрать();
				  Пока Выборка.Следующий() Цикл
					  Об = Выборка.Ссылка.ПолучитьОбъект();
					  Об.ОбменДанными.Загрузка =Истина;
					  Об.ВидБСОПолиса = Выборка.ВидБСО;
					  #Если Клиент Тогда
					  ОбработкаПрерыванияПользователя();
					  Состояние(Выборка.Ссылка);
					  #КонецЕсли
					  Об.Записать();
					 КонецЦикла; 
	
КонецФункции