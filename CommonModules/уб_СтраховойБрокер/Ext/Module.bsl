			КонецЕсли;	
			ОформлениеСтроки.Ячейки.Подразделение.УстановитьТекст(СтруктураПараметров.Подразделение);
			
		ИначеЕсли ЭтоПоступлениеБСО = Истина Тогда//док. поступление БСО
			
			ВидБСО	 	= ДанныеСтроки.ВидБСО;
			Если НЕ ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
				возврат
			КонецЕсли;
			ТипУчБСО 	= ВидБСО.ТипУчетаБСО;
			Прч 		= Перечисления.уб_ТипыУчетаБСО;
			ОЯ = ОформлениеСтроки.Ячейки;
			баПолисов = (ТипУчБСО = Прч.НомернойЕстьПолис);
			НесоответствиеКоличества = Не ДанныеСтроки.ВидБСО.Пустая()
			И (ТипУчБСО = Прч.НомернойПолисСоответствуетНомеруБСО Или баПолисов)
			И (ДанныеСтроки.КоличествоБСО <> ДанныеСтроки.КоличествоПолисов);
			ОЯ.КоличествоПолисов.ЦветТекста = ?(НесоответствиеКоличества,гЦветКрасный,гЦветАвто);
			ТекТипУчетаБСО = ВидБСО.ТипУчетаБСО;
			ОЯ.КоличествоПолисов.ЦветФона = ?(уб_СЛ.ОпределитьВедетсяКоличественныйУчет(ВидБСО, ТекТипУчетаБСО),гЦветАвто,гЦветФонаПоляТДЧ);
			цБСО = ?(уб_СЛ.ОпределитьВедетсяНомернойУчет(ВидБСО),гЦветАвто,гЦветФонаПоляТДЧ);
			цПолисов = ?(баПолисов,гЦветАвто,гЦветФонаПоляТДЧ);
			ОЯ.СерияПолиса.ЦветФона		= цПолисов;
			ОЯ.НачНомерПолиса.ЦветФона	= цПолисов;
			ОЯ.КонНомерПолиса.ЦветФона	= цПолисов;
			ОЯ.СуффиксПолиса.ЦветФона	= цПолисов;
			ОЯ.СерияБСО.ЦветФона		= цБСО;
			ОЯ.НачНомерБСО.ЦветФона		= цБСО;
			ОЯ.КонНомерБСО.ЦветФона		= цБСО;
			ОЯ.ГодПолиса.ЦветФона		= цБСО;
			
		Иначе																	
			
			ЭтоСписание = ?(СтруктураПараметров.Свойство("ЭтоСписание", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			ТекСостояниеБСО = ?(СтруктураПараметров.Свойство("ТекСостояниеБСО", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			ФлагТекСостояние = ?(СтруктураПараметров.Свойство("ФлагТекСостояние", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			НеКонтролироватьНаличиеБСОПриПроведении = ?(СтруктураПараметров.Свойство("НеКонтролироватьНаличиеБСОПриПроведении", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			КолонкиТЧ = ?(СтруктураПараметров.Свойство("КолонкиТЧ", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			Проведен = ?(СтруктураПараметров.Свойство("Проведен", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			УстанавливатьКоличествоЕдиницуПриНомерномУчете = ?(СтруктураПараметров.Свойство("УстанавливатьКоличествоЕдиницуПриНомерномУчете", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			ЭтоВозвратОтПоставщика = ?(СтруктураПараметров.Свойство("ЭтоВозвратОтПоставщика", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			УчитыватьКолонкуПодтверждено = ?(СтруктураПараметров.Свойство("УчитыватьКолонкуПодтверждено", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			ПрочитатьТекущееСостояниеИзФормы = ?(СтруктураПараметров.Свойство("ПрочитатьТекущееСостояниеИзФормы", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
			
			ПодрПередающего = Неопределено;
			ПодрПринимающего = Неопределено;
			ОрганизацияАгент = Неопределено;
			Поставщик = Неопределено;
			Агент = Неопределено;
									
			ЭтоПеремещение = СтруктураПараметров.Свойство("ПодрПередающего",ПодрПередающего) И
							 СтруктураПараметров.Свойство("ПодрПринимающего",ПодрПринимающего);
			
			ОрганизацияАгентИПоставщикВШапке = СтруктураПараметров.Свойство("ОрганизацияАгент",ОрганизацияАгент) И
											   СтруктураПараметров.Свойство("Поставщик",Поставщик);
											   
			СтруктураПараметров.Вставить("ОрганизацияАгентИПоставщикВШапке",ОрганизацияАгентИПоставщикВШапке);								   
											   
			ЕстьКолонкаАгент = КолонкиТЧ.Найти("Агент") <> Неопределено;
			ЕстьКолонкаКоличество = КолонкиТЧ.Найти("Количество") <> Неопределено;
			
			СтруктураПараметров.Вставить("ЕстьКолонкаАгент",ЕстьКолонкаАгент);
			
			АгентВШапкеИТЧ = СтруктураПараметров.Свойство("Агент",Агент) И
							 ЕстьКолонкаАгент;
							 
			ОЯ = ОформлениеСтроки.Ячейки;
			Если ПрочитатьТекущееСостояниеИзФормы = Истина Тогда
				СтруктураБСО = ЭтаФорма.ПрочитатьТекущееСостояниеБСО(ДанныеСтроки);
			ИначеЕсли ЭтоВозвратОтПоставщика = Истина Тогда
				СтруктураБСО = ПрочитатьТекущееСостояниеБСО(ДанныеСтроки, СтруктураПараметров, "НаДатуДокумента");
			Иначе
				СтруктураБСО = ПрочитатьТекущееСостояниеБСО(ДанныеСтроки, СтруктураПараметров, "");
			КонецЕсли;
			бКоличественныйУчет = СтруктураБСО.КоличественныйУчет;
			
			Если ЭтоПеремещение = Истина Тогда
				
				бПеремешениеРазрешено = Проведен ИЛИ ЭтаФорма.ПеремещениеРазрешено(СтруктураБСО.Владелец, ПодрПередающего, ПодрПринимающего, СтруктураБСО.Регистратор, СтруктураБСО.АгентОтправитель,СтруктураБСО.ПодразделениеОтправитель);
				Покрасить = НЕ СтруктураБСО.Существует
				ИЛИ НЕ бПеремешениеРазрешено
				ИЛИ (СтруктураБСО.Количество < ДанныеСтроки.Количество И бКоличественныйУчет = Истина);
				Если ДанныеСтроки.Подтверждено ИЛИ Покрасить Тогда
					ЦветТекстаСтроки = ?(ДанныеСтроки.Подтверждено, ?(Покрасить, гЦветКрасный, гЦветАвто), ?(Покрасить, гЦветОранжевый, гЦветВторостепенный));
				Иначе
					ЦветТекстаСтроки = гЦветАвто;
				КонецЕсли;
				
			ИначеЕсли АгентВШапкеИТЧ Тогда
				
				Покрасить = Не СтруктураБСО.Существует
				Или (СтруктураБСО.Количество < 1 И СтруктураБСО.КоличественныйУчет);
				ЦветТекстаСтроки = ?(Покрасить, гЦветКрасный, гЦветАвто);
				ОЯ.ТекСостояниеБСО.УстановитьТекст(СтруктураБСО.сСостояниеБСО);
				
			Иначе
				
				Если ЭтоВозвратОтПоставщика = Истина Тогда
					Покрасить = НЕ СтруктураБСО.Существует;
					ОЯ.НомерПолиса.УстановитьТекст(?(СтруктураБСО.НомернойУчет,СтруктураБСО.НомерПолиса,""));
				Иначе
					Покрасить = НЕ СтруктураБСО.Существует
					ИЛИ (бКоличественныйУчет И ( СтруктураБСО.Количество < ДанныеСтроки.Количество
					ИЛИ ДанныеСтроки.Количество < 1
					ИЛИ (Не ОрганизацияАгентИПоставщикВШапке И ЗначениеНеЗаполнено(ДанныеСтроки.Агент))
					ИЛИ ?(ОрганизацияАгентИПоставщикВШапке,СтруктураБСО.ОрганизацияАгент <> ОрганизацияАгент И ЗначениеЗаполнено(ОрганизацияАгент),ЗначениеНеЗаполнено(ДанныеСтроки.ОрганизацияАгент))
					ИЛИ ?(ОрганизацияАгентИПоставщикВШапке,СтруктураБСО.Поставщик <> Поставщик И ЗначениеЗаполнено(Поставщик),ЗначениеНеЗаполнено(ДанныеСтроки.Поставщик))
					));
					Если Не ОрганизацияАгентИПоставщикВШапке И Не ЭтоСписание = Истина Тогда
						Если НеКонтролироватьНаличиеБСОПриПроведении = Неопределено Тогда
							бАктивностьПиО = бКоличественныйУчет
							ИЛИ (СтруктураБСО.НомернойУчет И НЕ СтруктураБСО.Существует);
						Иначе
							бАктивностьПиО = СтруктураБСО.НомернойУчет И НЕ СтруктураБСО.Существует И НеКонтролироватьНаличиеБСОПриПроведении = Истина;
						КонецЕсли;
						Если бАктивностьПиО Тогда
							ОЯ.Поставщик.ЦветФона 			= гЦветАвто;
							ОЯ.ОрганизацияАгент.ЦветФона	= гЦветАвто;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если УчитыватьКолонкуПодтверждено = Истина Тогда
					ЦветТекстаСтроки =  ?(ДанныеСтроки.Подтверждено, ?(Покрасить, гЦветКрасный, гЦветАвто), ?(Покрасить, гЦветОранжевый, гЦветВторостепенный));
				Иначе
					ЦветТекстаСтроки =  ?(Покрасить, гЦветКрасный, гЦветАвто);
				КонецЕсли;
																				
			КонецЕсли;
			
			Если бКоличественныйУчет Тогда
				Если Не ЭтоВозвратОтПоставщика = Истина Тогда
					Если ЭтоСписание = Истина Тогда
						ОЯ.Агент.ЦветФона 				= гЦветАвто;
						ОЯ.Поставщик.ЦветФона 			= гЦветАвто;
						ОЯ.ОрганизацияАгент.ЦветФона	= гЦветАвто;
					ИначеЕсли АгентВШапкеИТЧ Тогда
						ОЯ.Агент.ЦветФона 		= ЦветаСтиля.ЦветФонаПоля;
						ОЯ.НомерБСО.ЦветФона 	= гЦветФонаПоляТДЧ;
						ОЯ.ТекущийВладелец.УстановитьТекст(Строка(ДанныеСтроки.Агент));
					КонецЕсли;
					
					Если ЭтоПеремещение = Истина Тогда
						
						ОЯ.ОрганизацияАгент.ЦветФона	= гЦветАвто;
						ОЯ.Поставщик.ЦветФона 			= гЦветАвто;
						ОЯ.ЗаявкаОт.ЦветФона 			= гЦветАвто;
						
					ИначеЕсли Не ОрганизацияАгентИПоставщикВШапке Тогда
						Если ЕстьКолонкаКоличество Тогда
							ОЯ.Количество.ЦветФона 			= гЦветАвто;
						КонецЕсли;
						Если ЗначениеНеЗаполнено(ДанныеСтроки.Агент) Тогда
							ОЯ.Агент.УстановитьТекст("<все>");
						Иначе
							//ОЯ.Агент.УстановитьТекст(ДанныеСтроки.Агент.Наименование);
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли АгентВШапкеИТЧ Тогда
				
				Если ЗначениеНеЗаполнено(ДанныеСтроки.Агент) Тогда
					ОЯ.Агент.УстановитьТекст(Строка(Агент));
				КонецЕсли;
				ОЯ.Агент.ЦветФона		= гЦветФонаПоляТДЧ;
				ОЯ.НомерБСО.ЦветФона 	= ЦветаСтиля.ЦветФонаПоля;
				ОЯ.ТекущийВладелец.УстановитьТекст(Строка(СтруктураБСО.сВладелец));
				
			ИначеЕсли Не ЭтоПеремещение = Истина Тогда
				
				Если Не ОрганизацияАгентИПоставщикВШапке Тогда
					Если Не СтруктураБСО.Существует И НЕ НеКонтролироватьНаличиеБСОПриПроведении = Истина Тогда
						ОЯ.Поставщик.УстановитьТекст(СтруктураБСО.сПоставщик);
						ОЯ.ОрганизацияАгент.УстановитьТекст(СтруктураБСО.сОрганизацияАгент);
					ИначеЕсли ЭтоСписание = Истина Тогда
						Если НЕ СтруктураБСО.Существует Тогда
							ОЯ.Поставщик.УстановитьТекст(СтруктураБСО.сПоставщик);
							ОЯ.ОрганизацияАгент.УстановитьТекст(СтруктураБСО.сОрганизацияАгент);
						Иначе
							ОЯ.Поставщик.УстановитьТекст(ДанныеСтроки.Поставщик.Наименование);
							ОЯ.ОрганизацияАгент.УстановитьТекст(ДанныеСтроки.ОрганизацияАгент.Наименование);
						КонецЕсли;
					Иначе
						ОЯ.Поставщик.УстановитьТекст(ДанныеСтроки.Поставщик.Наименование);
						ОЯ.ОрганизацияАгент.УстановитьТекст(ДанныеСтроки.ОрганизацияАгент.Наименование);
					КонецЕсли;
				КонецЕсли;
				Если ЕстьКолонкаАгент Тогда
					ОЯ.Агент.УстановитьТекст(СтруктураБСО.сВладелец);
				КонецЕсли;
				Если УстанавливатьКоличествоЕдиницуПриНомерномУчете = Истина Тогда
					ОЯ.Количество.УстановитьТекст("1");
				КонецЕсли;
			КонецЕсли;
			Если ФлагТекСостояние = Истина Тогда
				ОЯ.ТекСостояниеБСО.УстановитьТекст(СтруктураБСО.сСостояниеБСО);
				Если ЭтоПеремещение Тогда
					ОЯ.ТекущийВладелец.УстановитьТекст(СтруктураБСО.сВладелец);
					ОЯ.ТекДатаВозврата.УстановитьТекст(СтруктураБСО.сДатаВозврата);
				Иначе
					Если ЭтоВозвратОтПоставщика = Истина Тогда
						ОЯ.ТекущийВладелец.УстановитьТекст(СтруктураБСО.сВладелец);
					Иначе
						ОЯ.ТекПоложениеБСО.УстановитьТекст(СтруктураБСО.сПоложениеБСО);
					КонецЕсли;
				КонецЕсли;
				Если ОрганизацияАгентИПоставщикВШапке И Не ЭтоВозвратОтПоставщика = Истина Тогда
					ОЯ.ТекущаяОрганизацияАгент.УстановитьТекст(СтруктураБСО.сОрганизацияАгент);
					ОЯ.ТекущийПоставщик.УстановитьТекст(СтруктураБСО.сПоставщик);
				КонецЕсли;
			КонецЕсли;
			Если АгентВШапкеИТЧ Тогда
				Покрасить = СтруктураБСО.КоличественныйУчет И СокрЛП(ДанныеСтроки.НомерБСО) <> "";
				ОЯ.НомерБСО.ЦветТекста = ?(Покрасить, гЦветОранжевый, ЦветТекстаСтроки);
			Иначе
				ОЯ.НомерБСО.ЦветТекста = ?(СтруктураБСО.НомернойУчет, ЦветТекстаСтроки, гЦветОранжевый);
				ОформлениеСтроки.ЦветТекста = ЦветТекстаСтроки;
			КонецЕсли;
			Если ОрганизацияАгентИПоставщикВШапке И Не ЭтоВозвратОтПоставщика = Истина Тогда
				ОЯ.НомерПолиса.ЦветТекста = ОЯ.НомерБСО.ЦветТекста;
				ОЯ.СостояниеБСО.ЦветФона = ?(КолонкиТЧ.СостояниеБСО.ТолькоПросмотр, гЦветФонаПоляТДЧ, гЦветАвто);
			КонецЕсли;
			Если ЭтоПеремещение = Истина Тогда
				Если НЕ ДанныеСтроки.ЗаявкаКуда.Пустая() Тогда
					Ячейка = ОЯ.ЗаявкаКуда;
					Ячейка.УстановитьТекст(ЭтаФорма.НомерЗаявкиИзПредставления(Ячейка.Текст));
				КонецЕсли;
				Если НЕ ДанныеСтроки.ЗаявкаОт.Пустая() Тогда
					Ячейка = ОЯ.ЗаявкаОт;
					Ячейка.УстановитьТекст(ЭтаФорма.НомерЗаявкиИзПредставления(Ячейка.Текст));
				КонецЕсли;
			КонецЕсли;			
		КонецЕсли;
	#КонецЕсли

КонецПроцедуры//БСОПриВыводеСтроки()

Функция ПрочитатьТекущееСостояниеБСО(ТекСтрока, Параметры, Документ)
	
	ЗначениеПараметра				 = Неопределено;
	ТекСостояниеБСО					 = ?(Параметры.Свойство("ТекСостояниеБСО", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ЭтотОбъект						 = ?(Параметры.Свойство("ЭтотОбъект", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ФлагСостояниеНаДатуДокумента	 = ?(Параметры.Свойство("ФлагСостояниеНаДатуДокумента", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ЕстьКолонкаАгент				 = ?(Параметры.Свойство("ЕстьКолонкаАгент", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ПолучатьПодразделениеОтправителя = ?(Параметры.Свойство("ПолучатьПодразделениеОтправителя", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	Поставщик						 = ?(Параметры.Свойство("Поставщик", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ОрганизацияАгент				 = ?(Параметры.Свойство("ОрганизацияАгент", 	ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	ОрганизацияАгентИПоставщикВШапке = ?(Параметры.Свойство("ОрганизацияАгентИПоставщикВШапке", ЗначениеПараметра), ЗначениеПараметра, Неопределено);	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТекСтрока",		ТекСтрока);
	СтруктураПараметров.Вставить("ТекСостояниеБСО",	ТекСостояниеБСО);
	Агент = ?(Параметры.Свойство("Агент", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
	Если "НаДатуДокумента" = Документ Тогда
		Дт = уб_temp.ДатаАктуальностиОбъекта(ЭтотОбъект);
		СтруктураПараметров.Вставить("НаДату",	Дт);
		СтруктураПараметров.Вставить("тсАгент",	Агент);
		Поставщик = ?(Параметры.Свойство("Поставщик", ЗначениеПараметра), ЗначениеПараметра, Неопределено);
		СтруктураПараметров.Вставить("тсПоставщик", Поставщик);
		ОрганизацияАгент = ?(Параметры.Свойство("ОрганизацияАгент", ЗначениеПараметра), ЗначениеПараметра, Неопределено);				
		СтруктураПараметров.Вставить("тсОрганизацияАгент",ОрганизацияАгент);
	Иначе	
		СтруктураПараметров.Вставить("НаДату",уб_temp.ДатаАктуальностиОбъекта(ЭтотОбъект, ФлагСостояниеНаДатуДокумента));
		Если ЕстьКолонкаАгент = Истина Тогда
			СтруктураПараметров.Вставить("тсАгент", ТекСтрока.Агент);
		Иначе
			СтруктураПараметров.Вставить("тсАгент", Агент);
		КонецЕсли;	
		Если ОрганизацияАгентИПоставщикВШапке = Истина Тогда
			СтруктураПараметров.Вставить("тсПоставщик",			Поставщик);
			СтруктураПараметров.Вставить("тсОрганизацияАгент",	ОрганизацияАгент);
		Иначе			
			СтруктураПараметров.Вставить("тсПоставщик",			ТекСтрока.Поставщик);
			СтруктураПараметров.Вставить("тсОрганизацияАгент",	ТекСтрока.ОрганизацияАгент);
		КонецЕсли;
	КонецЕсли;	
	СтруктураПараметров.Вставить("хВидГраницы",ВидГраницы.Исключая);
	Если ПолучатьПодразделениеОтправителя = Истина Тогда
		СтруктураПараметров.Вставить("ПолучатьПодразделениеОтправителя",Истина);
	КонецЕсли;	
	Результат = уб_СС.ПрочитатьТекущееСостояниеБСОПоСтрокеТЧ(СтруктураПараметров);
	ТекСостояниеБСО = СтруктураПараметров.ТекСостояниеБСО;
	Возврат Результат;
	
КонецФункции//ПрочитатьТекущееСостояниеБСО()

