Функция Получить_КВ_Брокера(
	Знач наДату, 
	Знач СК, 
	Знач Поставщик, 
	Знач ОрганизацияАгент, 
	Знач ВидСП, 
	Знач СтраховойПродукт, 
	Знач Риск = Неопределено
	) Экспорт
	
	соотвИзмРС = Новый Соответствие; 
	
	//4-й парам: ЕстьГруппа - булево. Если ИСТИНА, то для данного измерения надо искать записи,
	// в которых значения совпадают со значениями вышестоящих групп
	
	//5-й парам: ОбязательныйКритерий - булево. 
	//Если ИСТИНА, то в критерии выборки добавляется жесткое условие по этому измерению 	
	
	//Добавление измерений - в порядке возрастания важности
	//Важность - самый весомый параметр подбора. Поэтому в первую очередь будут выбраны
	// совпадения аргумента с наиболее важными параметрами
	
	ДобавитьИзмерение(соотвИзмРС,"СК",СК,Ложь,Истина);
	Если Поставщик <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС,"Поставщик",Поставщик);
	КонецЕсли;
	Если ОрганизацияАгент <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС,"ОрганизацияАгент",ОрганизацияАгент);
	КонецЕсли;
	ДобавитьИзмерение(соотвИзмРС,"ВидСП",ВидСП);
	ДобавитьИзмерение(соотвИзмРС,"СтраховойПродукт",СтраховойПродукт);
	
	// В СписокПолейНеВлияющихНаПриоритет передаются имена полей, которые не будут учавствовать в процедуре выбора 
	// в качестве критериев отбора. Они никак не повлияют на приоритет выбора тех или иных записей.
	// И если по прочим критериям отбора найдется несколько строк с различными значениями в этих полях,
	// то все они будут возвращены.
	СписокПолейНеВлияющихНаПриоритет = Новый Массив;
	СписокПолейНеВлияющихНаПриоритет.Добавить("Процент");
	СписокПолейНеВлияющихНаПриоритет.Добавить("ПроцентДляОтчета");
	СписокПолейНеВлияющихНаПриоритет.Добавить("Условие");
	СписокПолейНеВлияющихНаПриоритет.Добавить("Банк");
	СписокПолейНеВлияющихНаПриоритет.Добавить("БанкСтрока");
	СписокПолейНеВлияющихНаПриоритет.Добавить("Код");
	СписокПолейНеВлияющихНаПриоритет.Добавить("ПролонгацияПоПредыдущемуПроценту");
	
	Если Риск = Неопределено Тогда
		СписокПолейНеВлияющихНаПриоритет.Добавить("Риск");
	Иначе	
		ДобавитьИзмерение(соотвИзмРС,"Риск",Риск,Истина);
	КонецЕсли;	
	ПостояннаяЧастьЗапроса = 
	"ВЫБРАТЬ
	|	Т.СК,
	|	Т.Поставщик,
	|	Т.ОрганизацияАгент,
	|	Т.ВидСП,
	|	Т.СтраховойПродукт,
	|	Т.Риск,
	|	Т.Условие,
	|	Т.Банк,
	|	ЕСТЬNULL(Т.Банк.Наименование, """") КАК БанкСтрока,
	|	Т.Процент,
	|	Т.ПроцентДляОтчета,
	|	Т.Код,
	|	Т.Ссылка,
	|	Т.ПролонгацияПоПредыдущемуПроценту
	|ИЗ
	|	Справочник.уб_КВ КАК Т
	|ГДЕ
	|	Т.ДатаНачалаДействия <= &наДату
	|	И (Т.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ Т.ДатаОкончанияДействия > &наДату)";					
	Запрос = Новый Запрос();
	Запрос.Текст = ПостояннаяЧастьЗапроса;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	РезультатЗапроса = Неопределено;
	ПустаяЗапись = Справочники.уб_КВ.ПустаяСсылка();
	Возврат ЯдроПолученияДанных(Запрос, соотвИзмРС, РезультатЗапроса, ПустаяЗапись, СписокПолейНеВлияющихНаПриоритет);	
	
КонецФункции

Функция Получить_АВ(
	Знач наДату 
	, Знач СсылкаНаКВ 
	, Знач Организация = Неопределено
	, Знач Подразделение = Неопределено 
	, Знач Агент
	) Экспорт
	
	соотвИзмРС = Новый Соответствие; 
	
	ДобавитьИзмерение(соотвИзмРС,"СсылкаНаКВ",СсылкаНаКВ,Ложь,Истина);
	
	Если Организация <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС,"Организация",Организация);
	КонецЕсли;
	Если Подразделение <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС,"Подразделение",Подразделение,Истина);
	КонецЕсли;
	Если Агент <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС,"Агент",Агент,Истина);
	КонецЕсли;
	
	СписокПолейНеВлияющихНаПриоритет = Новый Массив;
	СписокПолейНеВлияющихНаПриоритет.Добавить("СсылкаНаКВ");
	СписокПолейНеВлияющихНаПриоритет.Добавить("ДатаНачалаДействия");
	СписокПолейНеВлияющихНаПриоритет.Добавить("ДатаОкончанияДействия");
	СписокПолейНеВлияющихНаПриоритет.Добавить("Процент");
	
	ПостояннаяЧастьЗапроса = "ВЫБРАТЬ
	                         |	Т.*
	                         |ИЗ
	                         |	РегистрСведений.уб_КВ_Агентов КАК Т
	                         |ГДЕ
	                         |	Т.ДатаНачалаДействия <= &наДату
	                         |	И (Т.ДатаОкончанияДействия = &НульДата
	                         |			ИЛИ Т.ДатаОкончанияДействия > &наДату)";
					
	Запрос = Новый Запрос();
	Запрос.Текст = ПостояннаяЧастьЗапроса;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("НульДАта", Дата("00010101000000"));
	
	РезультатЗапроса = Неопределено;
	ПустаяЗапись = РегистрыСведений.уб_КВ_Агентов.СоздатьМенеджерЗаписи();
	Возврат ЯдроПолученияДанных(Запрос, соотвИзмРС, РезультатЗапроса, ПустаяЗапись, СписокПолейНеВлияющихНаПриоритет);	
КонецФункции

Функция ПолучитьДельтуКВ(
	Знач наДату, 
	Знач НазначениеКВ,
	Знач Организация, 
	Знач Подразделение 		= Неопределено, 
	Знач Агент 				= Неопределено, 
	Знач Поставщик 			= Неопределено, 
	Знач ОрганизацияАгент 	= Неопределено, 
	Знач СК 				= Неопределено, 
	Знач ВидСП 				= Неопределено, 
	Знач СтраховойПродукт 	= Неопределено 
	) Экспорт
	
	соотвИзмРС = Новый Соответствие; 
	ИмяРегистра = "уб_КВ_ДельтыАгентовИМенеджеров";	
	Если Не ЗначениеЗаполнено(наДату) Тогда
		наДату = ТекущаяДата();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Подразделение) И ЗначениеЗаполнено(Агент) Тогда
		Подразделение = уб_СС.ПолучитьПодразделениеАгента(Агент, НаДату,Ложь);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Подразделение) Тогда
		Организация = Подразделение.Владелец;
	КонецЕсли;
	ДобавитьИзмерение(соотвИзмРС, "Организация", Организация,,,,, Истина);
	Если ОрганизацияАгент <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС, "ОрганизацияАгент", ОрганизацияАгент);
	КонецЕсли;
	ДобавитьИзмерение(соотвИзмРС,"Подразделение", Подразделение,,,4,, Истина);
	Если НЕ ЗначениеНеЗаполнено(Агент) Тогда
		ДобавитьИзмерение(соотвИзмРС, "Агент", Агент, Ложь,,4,, Истина);
	КонецЕсли;

	Если Поставщик <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС, "Поставщик", Поставщик);
	КонецЕсли;
	
	Если СК <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС, "СК", СК);
	КонецЕсли;
	Если ВидСП <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС, "ВидСП", ВидСП);
	КонецЕсли;
	Если СтраховойПродукт <> Неопределено Тогда
		ДобавитьИзмерение(соотвИзмРС, "СтраховойПродукт", СтраховойПродукт);
	КонецЕсли;
	ДобавитьИзмерение(соотвИзмРС,"НазначениеКВ",НазначениеКВ);
	ПостояннаяЧастьЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.уб_КВ_ДельтыАгентовИМенеджеров.СрезПоследних(&наДату, ) КАК Т
	|ГДЕ
	|	Т.НеДействует = ЛОЖЬ";					
	ТекстЗапроса = "";
	РезультатЗапроса = Неопределено;
	Возврат ЯдроПолученияДанных_РЕГИСТР(наДату, соотвИзмРС, ТекстЗапроса, ПостояннаяЧастьЗапроса, РезультатЗапроса, ИмяРегистра);
	
КонецФункции


/////// Руководитель подразделения
//эта функция вернет только руководителя, НЕ заместителя
Функция ПолучитьРуководителяПодразделения(наДату, Подразделение = Неопределено,ЗАМ = Ложь) Экспорт
	
	соотвИзмРС = Новый Соответствие; 
	ИмяРегистра = "уб_РуководителиПодразделений";
	
	ДобавитьИзмерение(соотвИзмРС,"Подразделение",Подразделение);

	ПостояннаяЧастьЗапроса = "ВЫБРАТЬ Т.*
					|	ИЗ РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&наДату, "+?(ЗАМ=Ложь,"НЕ","")+" Заместитель) КАК Т
					|	ГДЕ Т.Уход = ЛОЖЬ";
					
	ТекстЗапроса = "";
	РезультатЗапроса = Неопределено;
	ТЗРез = ЯдроПолученияДанных_РЕГИСТР(наДату, соотвИзмРС, ТекстЗапроса, ПостояннаяЧастьЗапроса, РезультатЗапроса, ИмяРегистра);
		
	Если ТЗРез.Количество() > 0 Тогда
		Возврат ТЗРез[0];
	Иначе
		Возврат РегистрыСведений.уб_РуководителиПодразделений.СоздатьМенеджерЗаписи();		
	КонецЕсли;
КонецФункции

/////// Параметры договоров
Функция ПолучитьПараметрДоговора(
	НаДату 						= Неопределено, 
	Наименование 				= Неопределено, 
	Поставщик 					= Неопределено, 
	ОрганизацияАгент 			= Неопределено, 
	Объект 						= Неопределено,
	Знач РольКонтактногоЛица	= ""
	) Экспорт
	
	РольКонтактногоЛица = НРег(СокрЛП(РольКонтактногоЛица));
	Если РольКонтактногоЛица <> "" И РольКонтактногоЛица <> "рук" Тогда
		//получаем данные из контактного лица напрямую по реквизиту РольКонтактногоЛица
		//TODO параметр ОрганизацияАгент игнорируется в этом случае (у справочника КонтактныеЛица нет реквизита ОрганизацияАгент)
		Запрос = Новый Запрос;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	КЛ.Ссылка,
		|	КЛ.Должность,
		|	КЛ.ОснованиеДействия
		|ИЗ
		|	Справочник.КонтактныеЛица КАК КЛ
		|ГДЕ
		|	НЕ КЛ.ПометкаУдаления
		|	И КЛ.Роль.Наименование = &РольКонтактногоЛица
		|	И КЛ.ВидКонтактногоЛица = ЗНАЧЕНИЕ(Перечисление.ВидыКонтактныхЛиц.КонтактноеЛицоКонтрагента)
		|	И &УсловиеГде
		|
		|УПОРЯДОЧИТЬ ПО
		|	КЛ.ДатаСоздания УБЫВ";
		Если ЗначениеЗаполнено(Поставщик) Тогда
			УсловиеГде = "КЛ.ОбъектВладелец = &Поставщик";
			Запрос.УстановитьПараметр("Поставщик", Поставщик);
		Иначе
			УсловиеГде = Истина;
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГде", УсловиеГде);
		Запрос.УстановитьПараметр("РольКонтактногоЛица", РольКонтактногоЛица);
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если Наименование = "ЛицоПринципала" Тогда
				Возврат Выборка.Ссылка
			ИначеЕсли Наименование = "ЛицоПринципала_Должность" Тогда
				Возврат Выборка.Должность
			ИначеЕсли Наименование = "ЛицоПринципала_ОснованиеДействия" Тогда
				Возврат Выборка.ОснованиеДействия
			ИначеЕсли Наименование = "Структура" Тогда
				Структура = Новый Структура;
				Структура.Вставить("ЛицоПринципала", 					Выборка.Ссылка);
				Структура.Вставить("ЛицоПринципала_Должность", 			Выборка.Должность);
				Структура.Вставить("ОргАгент_Доверенность", 			"");
				Структура.Вставить("ЛицоПринципала_ОснованиеДействия", 	Выборка.ОснованиеДействия);
				Возврат Структура;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДата();	
	КонецЕсли;
	Если Поставщик = Неопределено Тогда
		Поставщик = Справочники.Контрагенты.ПустаяСсылка();	
	КонецЕсли;
	Если ОрганизацияАгент = Неопределено Тогда
		ОрганизацияАгент = Справочники.Организации.ПустаяСсылка();	
	КонецЕсли;
	Если Объект <> Неопределено И НЕ Объект.Метаданные().Реквизиты.Найти("КонтактноеЛицо") = Неопределено И ЗначениеЗаполнено(Объект.КонтактноеЛицо) Тогда
		Если Наименование = "ЛицоПринципала_Должность" Тогда
			Если ЗначениеЗаполнено(Объект.ДолжностьКонтактногоЛица) Тогда
				Возврат Объект.ДолжностьКонтактногоЛица;
			Иначе
				Возврат Объект.КонтактноеЛицо.Должность;
			КонецЕсли;
		ИначеЕсли Наименование = "ОргАгент_Доверенность" Тогда
			Если ЗначениеЗаполнено(Объект.ДоверенностьКонтрагента) Тогда
				Возврат Объект.ДоверенностьКонтрагента;
			Иначе
				Возврат Объект.Поставщик.Доверенность;
			КонецЕсли;
		ИначеЕсли Наименование = "ЛицоПринципала_ОснованиеДействия" Тогда
			Если ЗначениеЗаполнено(Объект.ОснованиеДействияКонтактногоЛица) Тогда
				Возврат Объект.ОснованиеДействияКонтактногоЛица;
			Иначе
				Возврат Объект.КонтактноеЛицо.ОснованиеДействия;
			КонецЕсли;
		Иначе
			Если Наименование = "ЛицоПринципала" Тогда
				Возврат Объект.КонтактноеЛицо;
			Иначе
				ЗапросКЛ = Новый Запрос;
				ЗапросКЛ.Текст = "ВЫБРАТЬ
				|	КонтактныеЛица.Должность,
				|	КонтактныеЛица.ОснованиеДействия,
				|	КонтактныеЛица.ОбъектВладелец.Доверенность КАК Доверенность
				|ИЗ
				|	Справочник.КонтактныеЛица КАК КонтактныеЛица
				|ГДЕ
				|	КонтактныеЛица.Ссылка = &Ссылка";
				ЗапросКЛ.УстановитьПараметр("Ссылка", Объект.КонтактноеЛицо);
				ВыборкаКЛ = ЗапросКЛ.Выполнить().Выбрать();
				ВыборкаКЛ.Следующий();
				Структура = Новый Структура;
				Структура.Вставить("ЛицоПринципала", Объект.КонтактноеЛицо);
				Если ЗначениеЗаполнено(Объект.ДолжностьКонтактногоЛица) Тогда
					Структура.Вставить("ЛицоПринципала_Должность", Объект.ДолжностьКонтактногоЛица);
				Иначе
					Структура.Вставить("ЛицоПринципала_Должность", ВыборкаКЛ.Должность);
				КонецЕсли;
				Если ЗначениеЗаполнено(Объект.ДоверенностьКонтрагента) Тогда
					Структура.Вставить("ОргАгент_Доверенность", Объект.ДоверенностьКонтрагента);
				Иначе
					Структура.Вставить("ОргАгент_Доверенность", ВыборкаКЛ.Доверенность);
				КонецЕсли;
				Если ЗначениеЗаполнено(Объект.ОснованиеДействияКонтактногоЛица) Тогда
					Структура.Вставить("ЛицоПринципала_ОснованиеДействия", Объект.ОснованиеДействияКонтактногоЛица);
				Иначе
					Структура.Вставить("ЛицоПринципала_ОснованиеДействия", ВыборкаКЛ.ОснованиеДействия);
				КонецЕсли;
				Возврат Структура;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.Ссылка = ДоговорыКонтрагентов.Владелец.ОсновнойДоговорКонтрагента
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоОсновнойДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_Договоры
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Поставщик
	|	И ДоговорыКонтрагентов.Организация = &ОрганизацияАгент
	|	И (ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДоговорыКонтрагентов.ДатаОкончанияДействияДоговора > &ТекДата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_Договоры.ЭтоОсновнойДоговорКонтрагента, ЛОЖЬ)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок2,
	|	ВЫБОР
	|		КОГДА уб_ПараметрыДоговоровИОтчетовСрезПоследних.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Порядок1,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.ОснованиеДействия, """") КАК ОснованиеДействия,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.Поставщик.Доверенность, """") КАК Доверенность,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Должность, """") КАК Должность,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Фамилия, """") КАК Фамилия,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Имя, """") КАК Имя,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Отчество, """") КАК Отчество,
	|	ЕСТЬNULL(уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Наименование, """") КАК КонтактноеЛицоНаименование
	|ИЗ
	|	РегистрСведений.уб_ПараметрыДоговоровИОтчетов.СрезПоследних(
	|			&ТекДата,
	|			Поставщик = &Поставщик
	|				И ОрганизацияАгент = &ОрганизацияАгент
	|				И (Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|					ИЛИ Договор В
	|						(ВЫБРАТЬ
	|							Т.Договор
	|						ИЗ
	|							ВТ_Договоры КАК Т))) КАК уб_ПараметрыДоговоровИОтчетовСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Договоры КАК ВТ_Договоры
	|		ПО уб_ПараметрыДоговоровИОтчетовСрезПоследних.Договор = ВТ_Договоры.Договор
	|ГДЕ
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо <> ЗНАЧЕНИЕ(Справочник.КонтактныеЛица.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок1,
	|	Порядок2";	
	Запрос.УстановитьПараметр("Поставщик",			Поставщик);
	Запрос.УстановитьПараметр("ОрганизацияАгент",	ОрганизацияАгент);
	Запрос.УстановитьПараметр("ТекДата",			НаДату);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Наименование = "ЛицоПринципала" Тогда
			Возврат Выборка.КонтактноеЛицо;
		ИначеЕсли Наименование = "ЛицоПринципала_Должность" Тогда
			Возврат Выборка.Должность;
		ИначеЕсли Наименование = "ОргАгент_Доверенность" Тогда
			Возврат Выборка.Доверенность;
		ИначеЕсли Наименование = "ЛицоПринципала_ОснованиеДействия" Тогда
			Возврат Выборка.ОснованиеДействия;
		Иначе
			Структура = Новый Структура;
			Структура.Вставить("ЛицоПринципала", 					Выборка.КонтактноеЛицо);
			Структура.Вставить("ЛицоПринципала_Должность", 			Выборка.Должность);
			Структура.Вставить("ОргАгент_Доверенность", 			Выборка.Доверенность);
			Структура.Вставить("ЛицоПринципала_ОснованиеДействия", 	Выборка.ОснованиеДействия);
			Возврат Структура;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат Новый Структура;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
