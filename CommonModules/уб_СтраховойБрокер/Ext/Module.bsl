// Устанавливает отбор в форме по подразделению, если это необходимо
//
// Параметры
//     Форма - форма, где находится элемент управления
//     УчетБСОПоВсемПодразделениям - Истина - если для пользователя учет ведется по всем подразделениям
//     ОсновноеПодразделение - основное подразделение пользователя
//     ИмяРеквизитаСписка - имя реквизита списка, по которому будет установлен отбор
//     СкрыватьКолонку - Истина - надо скрыть колонку, Ложь - нет
//     ИмяОтбора - текстовая строка, имя отбора
Процедура УстановитьОтборПоПодразделению(Форма, УчетБСОПоВсемПодразделениям, ОсновноеПодразделение, ИмяРеквизитаСписка, СкрыватьКолонку = Истина, ИмяОтбора = "Подразделение") Экспорт

	Если НЕ УчетБСОПоВсемПодразделениям Тогда

		Если НЕ (ТипЗнч(Форма[ИмяРеквизитаСписка]) = Тип("ТаблицаЗначений")) Тогда // Элемент - табличное поле

			// Проверим - Если это связанный регитср сведений тогда не нужно устанавливать отбор - 
			// он уже установлен системой автоматически

			Если ИмяРеквизитаСписка = "РегистрСведенийСписок" Тогда

				// Возвможно это переход по кнопке ПЕрейти
				Если ТипЗнч(Форма.ПараметрОтборПоИзмерению) = Тип("Структура") Тогда
					Если НЕ ЗначениеНеЗаполнено(Форма.ПараметрОтборПоИзмерению) Тогда
						Возврат; // Это переход по кнопке Перейти - не нужно устанавливать отбор
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;

			Форма[ИмяРеквизитаСписка].Отбор[ИмяОтбора].ВидСравнения  = ВидСравнения.Равно;
			Форма[ИмяРеквизитаСписка].Отбор[ИмяОтбора].Использование = Истина;
			Форма[ИмяРеквизитаСписка].Отбор[ИмяОтбора].Значение      = ОсновноеПодразделение;

			Форма.ЭлементыФормы[ИмяРеквизитаСписка].НастройкаОтбора[ИмяОтбора].Доступность = Ложь;

		КонецЕсли;

		Если СкрыватьКолонку Тогда

			Если НЕ Форма.ЭлементыФормы[ИмяРеквизитаСписка].Колонки.Найти(ИмяОтбора) = Неопределено Тогда

				Форма.ЭлементыФормы[ИмяРеквизитаСписка].Колонки[ИмяОтбора].Видимость         = Ложь;
				Форма.ЭлементыФормы[ИмяРеквизитаСписка].Колонки[ИмяОтбора].ИзменятьВидимость = Ложь;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Возвращает список доступных для пользователя подразделений
//
// Параметры
//  ОсновноеПодразделение - основное подразделение пользователя
//
// Возвращаемое значение
//  Список значений - подразделения, с которыми может работать пользователь
//
Функция ПолучитьСписокДоступныхПодразделений(ОсновноеПодразделение) Экспорт
	
	СписокПодразделений = Новый СписокЗначений;
	ТочкаПродаж = ПолучитьТочкуПродаж(ОсновноеПодразделение);
	Если НЕ ЗначениеНеЗаполнено(ТочкаПродаж) Тогда
		Если ТочкаПродаж.ИспользованиеВМониторинге Тогда
			СписокПодразделений.Добавить(ТочкаПродаж);
		КонецЕсли;
		Выборка = Справочники.ПодразделенияОрганизаций.ВыбратьИерархически(ТочкаПродаж);
		Пока Выборка.Следующий() Цикл
			Если Выборка.ИспользованиеВМониторинге Тогда
				СписокПодразделений.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокПодразделений;
	
КонецФункции

// Возвращает список наименований подразделений доступных для пользователя
//
// Параметры
//  ОсновноеПодразделение - основное подразделение пользователя
//
// Возвращаемое значение
//  Список значений - наименования подразделений, с которыми может работать пользователь
//
Функция ПолучитьСписокНаименованийДоступныхПодразделений(ОсновноеПодразделение) Экспорт
	
	СписокНаименований = Новый СписокЗначений;
	СписокПодразделений = ПолучитьСписокДоступныхПодразделений(ОсновноеПодразделение);
	Для Каждого СтрокаСЗ из СписокПодразделений Цикл
		СписокНаименований.Добавить(СтрокаСЗ.Значение.Наименование);
	КонецЦикла;
	
	Возврат СписокНаименований;
	
КонецФункции



