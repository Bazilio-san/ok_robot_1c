Функция ПроверитьПредОплаты(Объект)
	
	Результат = Истина;
	Если Объект.НомерВзноса <> 1 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.КВПроцент
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	уб_ОплатаПолисов.СтраховойПолис = &СтраховойПолис
		|	И НЕ уб_ОплатаПолисов.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	уб_ОплатаПолисов.Дата");
		Запрос.УстановитьПараметр("СтраховойПолис", Объект.СтраховойПолис);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Объект.КВПроцент = Выборка.КВПроцент;
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция УстЗнач(ПолеДанных, НовоеЗначение, Форма = Неопределено, ИгнорироватьБлокировкуОплаты = Ложь)// 
	
	Если Форма <> Неопределено Тогда
		Возврат Форма.УстЗнач(ПолеДанных, НовоеЗначение,,ИгнорироватьБлокировкуОплаты); 
	Иначе
		#Если ТолстыйКлиент Тогда
			Возврат УстановитьЗначение(ПолеДанных, НовоеЗначение); 
		#Иначе
			Изменилось = НЕ ПолеДанных=НовоеЗначение;
			Если Изменилось Тогда
				ПолеДанных = НовоеЗначение;
				Возврат Изменилось
			Иначе
				Возврат ЛОЖЬ;
			КонецЕсли;
		#КонецЕсли	
	КонецЕсли;
	
КонецФункции

Функция РазмерКС(ЗППериод=Неопределено) Экспорт
	
	Если ЗППериод=Неопределено Тогда
		ЗППериод = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ЗП_ПоказателиРасчетаЗПСрезПоследних.РазмерКрупнойСделки
	|ИЗ
	|	РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних(&ЗППериод, ) КАК уб_ЗП_ПоказателиРасчетаЗПСрезПоследних");
	Запрос.УстановитьПараметр("ЗППериод",КонецМесяца(ЗППериод));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РазмерКрупнойСделки;
	Иначе
		Возврат 41900;
	КонецЕсли;
КонецФункции	
Функция РасчетДО1БП(ЗППериод=Неопределено) Экспорт
	
	Если ЗППериод=Неопределено Тогда
		ЗППериод = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	уб_ЗП_ПоказателиРасчетаЗПСрезПоследних.БазаРОП_до_1БП
	                      |ИЗ
	                      |	РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних(&ЗППериод, ) КАК уб_ЗП_ПоказателиРасчетаЗПСрезПоследних");
	Запрос.УстановитьПараметр("ЗППериод",КонецМесяца(ЗППериод));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.БазаРОП_до_1БП;
	Иначе
		Возврат ЛОЖЬ;
	КонецЕсли;
КонецФункции

Функция ПолучитьПолноеКВСделки(Сделка) Экспорт 
	КВСделки = 0;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СУММА(уб_ОплатаПолисов.КВСумма) КАК КВСумма
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|ГДЕ
	|	НЕ уб_ОплатаПолисов.ПометкаУдаления 
	|	И уб_ОплатаПолисов.СтраховойПолис.Сделка = &Сделка");
	Запрос.УстановитьПараметр("Сделка",Сделка);
	Выборка = Запрос.Выполнить().Выбрать();					  
	Если Выборка.Следующий() Тогда
		КВСделки = Выборка.КВСумма;
	КонецЕсли;	
	Возврат КВСделки;
КонецФункции	

Функция ПланВыполнен(Менеджер,Период,Условие) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ЗП_ВыполнениеПланаМенеджерами.ВыполненПлан
	|ИЗ
	|	РегистрСведений.уб_ЗП_ВыполнениеПланаМенеджерами КАК уб_ЗП_ВыполнениеПланаМенеджерами
	|ГДЕ
	|	уб_ЗП_ВыполнениеПланаМенеджерами.Менеджер = &Менеджер
	|	И НАЧАЛОПЕРИОДА(уб_ЗП_ВыполнениеПланаМенеджерами.ПериодЗП, МЕСЯЦ) = &ПериодЗП");
	Запрос.УстановитьПараметр("Менеджер",Менеджер);						  
	Запрос.УстановитьПараметр("ПериодЗП",НачалоМесяца(Период));						  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВыполненПлан;
	Иначе
		Возврат Условие;
	КонецЕсли;	
КонецФункции	

