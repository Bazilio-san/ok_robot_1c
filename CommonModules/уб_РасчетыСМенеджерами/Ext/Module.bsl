Процедура ПолучитьВМдляСхемы_ОСАГО_Фикс_Администратор(ОП, Инфо, ВознаграждениеМенеджера)
	
	//ОСАГО:
	//Для дневного и вечернего администратора
	// 50р за сраховку при КВ < 30%.
	// 100р за страховку при КВ >= 30% 
	// Без вычета за скидку.	
	Ф = "ЧН=0; ЧГ=";
	Если ОП.Знч("КВПроцент") < 30 Тогда
		ФиксПоОСАГО = 50; //руб.
	Иначе
		ФиксПоОСАГО = 100; //руб.
	КонецЕсли;
	ПроцентВычетаЗаСкидкуПоОСАГО = 0; //%
	ДоляОплатыОтПолнойПремии = ДайДолюОтПолнойПремии(ОП);
	ЗаОСАГО = Окр(ФиксПоОСАГО * ДоляОплатыОтПолнойПремии,2);
	ВычетЗаСкидку = Окр(ОП.Знч("АВилиСкидкаСумма") * ПроцентВычетаЗаСкидкуПоОСАГО / 100 * ДоляОплатыОтПолнойПремии,2); 
	ВознаграждениеМенеджера = Окр(ЗаОСАГО - ВычетЗаСкидку);
	Если ДоляОплатыОтПолнойПремии < 1 Тогда
		Инфо = Инфо + "
		|Доля оплаты от полной премии: ДО = " + Строка(Окр(ДоляОплатыОтПолнойПремии*100,1)) + "%. 
		|Фикс по ОСАГО: " + Формат(ФиксПоОСАГО,Ф) + "р (при КВ брокера " + ОП.Знч("КВПроцент") + "%).
		|За ОСАГО: " + Формат(ФиксПоОСАГО,Ф) + " * ДО = " + Формат(ЗаОСАГО,Ф) + "р. 
		|Вычет за скидку: " + Формат(ОП.Знч("АВилиСкидкаСумма"),Ф) + "*" 
		+ Формат(ПроцентВычетаЗаСкидкуПоОСАГО,Ф) + "% * ДО = " + Формат(ВычетЗаСкидку,Ф) + "р.";
	Иначе
		Инфо = Инфо + "
		|За ОСАГО: " + Формат(ЗаОСАГО,Ф) + "р (при КВ брокера " + ОП.Знч("КВПроцент") + "%). 
		|Вычет за скидку: " + Формат(ОП.Знч("АВилиСкидкаСумма"),Ф) + " * " + ПроцентВычетаЗаСкидкуПоОСАГО + "% = " + Формат(ВычетЗаСкидку,Ф) + "р.";
	КонецЕсли;
	Инфо = Инфо + "
	|Итого, ВМ = " + Формат(ЗаОСАГО,Ф) + " - " + Формат(ВычетЗаСкидку,Ф) + " = " + Формат(ВознаграждениеМенеджера,Ф) + "р.";
	ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_ОСАГО_Фикс(ОП, Инфо, ВознаграждениеМенеджера)
	
	//ОСАГО:
	// Для дневных и вечерних менеджеров
	// Фикс за сраховку в зависимости от КВ. Выит за скидку - 30% от суммы предоставленной скидки
	// По остальным видам страхования - 0р	
	Ф = "ЧН=0; ЧГ=";
	Если ОП.Знч("ЗарплатныйПериод") < Дата("20090714000000") Тогда
		Если ОП.Знч("КВПроцент") < 30 Тогда
			ФиксПоОСАГО = 150; //руб.
		Иначе
			ФиксПоОСАГО = 350; //руб.
		КонецЕсли;
	Иначе
		Если ОП.Знч("КВПроцент") < 30 Тогда
			ФиксПоОСАГО = 100; //руб.
		Иначе
			ФиксПоОСАГО = 250; //руб.
		КонецЕсли;
	КонецЕсли;
	ПроцентВычетаЗаСкидкуПоОСАГО = 30; //%
