Функция ПолучитьСхемуИАлгоритмРасчета(Знач ВидБСО,Знач Агент,Знач ЗарплатныйПериод, Знач какТз = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБСО",ВидБСО);
	Запрос.УстановитьПараметр("Агент",Агент);
	Запрос.УстановитьПараметр("тДата",ЗарплатныйПериод);
	Запрос.Текст  = "ВЫБРАТЬ
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Родитель КАК ПодразделениеРодитель
	                |ПОМЕСТИТЬ Подразделения
	                |ИЗ
	                |	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&тДата, Агент = &Агент) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	                |ГДЕ
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ЛОЖЬ
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ ПЕРВЫЕ 10000
	                |	уб_ВидыБСОСхемыРасчетаЗП.Ссылка,
	                |	уб_ВидыБСОСхемыРасчетаЗП.Период КАК Период,
	                |	уб_ВидыБСОСхемыРасчетаЗП.Агент,
	                |	уб_ВидыБСОСхемыРасчетаЗП.Схема,
	                |	уб_ВидыБСОСхемыРасчетаЗП.СхемаРОП,
	                |	уб_ВидыБСОСхемыРасчетаЗП.МинимальнаяСумма,
	                |	уб_ВидыБСОСхемыРасчетаЗП.Алгоритм,
	                |	ВЫБОР
	                |		КОГДА уб_ВидыБСОСхемыРасчетаЗП.Агент = НЕОПРЕДЕЛЕНО
	                |			ТОГДА 0
	                |		КОГДА ТИПЗНАЧЕНИЯ(уб_ВидыБСОСхемыРасчетаЗП.Агент) = ТИП(Справочник.ПодразделенияОрганизаций)
	                |				И уб_ВидыБСОСхемыРасчетаЗП.Агент = ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
	                |			ТОГДА 1
	                |		КОГДА ТИПЗНАЧЕНИЯ(уб_ВидыБСОСхемыРасчетаЗП.Агент) = ТИП(Справочник.ПодразделенияОрганизаций)
	                |			ТОГДА 2
	                |		КОГДА ТИПЗНАЧЕНИЯ(уб_ВидыБСОСхемыРасчетаЗП.Агент) = ТИП(Справочник.ФизическиеЛица)
	                |				И уб_ВидыБСОСхемыРасчетаЗП.Агент = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	                |			ТОГДА 3
	                |		ИНАЧЕ 4
	                |	КОНЕЦ КАК ПорядокПрименения
	                |ПОМЕСТИТЬ Схемы
	                |ИЗ
	                |	Справочник.уб_ВидыБСО.СхемыРасчетаЗП КАК уб_ВидыБСОСхемыРасчетаЗП
	                |ГДЕ
	                |	уб_ВидыБСОСхемыРасчетаЗП.Ссылка = &ВидБСО
	                |	И уб_ВидыБСОСхемыРасчетаЗП.Период <= &тДата
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Схемы.Ссылка,
	                |	Схемы.Период,
	                |	Схемы.Агент,
	                |	Схемы.Схема,
	                |	Схемы.СхемаРОП,
	                |	Схемы.МинимальнаяСумма,
	                |	Схемы.Алгоритм,
	                |	Схемы.ПорядокПрименения,
	                |	Подразделения.Подразделение
	                |ИЗ
	                |	Схемы КАК Схемы
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Подразделения КАК Подразделения
	                |		ПО (Схемы.Агент = Подразделения.Агент
	                |				ИЛИ Схемы.Агент = Подразделения.Подразделение
	                |				ИЛИ Схемы.Агент = Подразделения.ПодразделениеРодитель)
	                |ГДЕ
	                |	(НЕ Подразделения.Подразделение ЕСТЬ NULL 
	                |			ИЛИ Схемы.ПорядокПрименения < 2)
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Схемы.ПорядокПрименения УБЫВ,
	                |	Схемы.Период УБЫВ";
					
	Результат = Запрос.Выполнить();
	Если какТз = Истина Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Ответ = Новый Структура ("Схема,СхемаРОП,МинимальнаяСумма,Алгоритм");
			ЗаполнитьЗначенияСвойств(Ответ,Выборка);
			Возврат Ответ;
		Иначе	
			Возврат Неопределено; 			
		КонецЕсли;	
	КонецЕсли;	
		
					
КонецФункции	

Процедура ПрименитьСебестоимость(ДляМенеджера,ДляБрокера,Параметры)
	
	Оп = Параметры.Документ;
	
	ДопУслуга = Справочники.уб_ВидыБСО.НайтиПоНаименованию("Дополнительная услуга");
	
	СтрокаДоп = Неопределено;
	
	Для каждого СтрокаУ из Оп.УслугиПоДокументу Цикл
		Если СтрокаУ.Вид = ДопУслуга Тогда
			 СтрокаДоп = СтрокаУ;
			 Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Если СтрокаДоп = Неопределено Тогда
		СтрокаДоп       = Оп.УслугиПоДокументу.Добавить();
		СтрокаДоп.Вид   = ДопУслуга; 
	КонецЕсли;
	
	УстЗнч(СтрокаДоп, "СхемаОплаты", ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль, Параметры.бЗаблокирована);
	
	УстЗнч(СтрокаДоп, "Сумма", Параметры.ОплаченоФакт-ДляМенеджера, Параметры.бЗаблокирована);
	
	
	Параметры.НачисленнаяСуммаВзноса = ДляМенеджера;
	Параметры.СуммаДоп               = Оп.УслугиПоДокументу.Итог("Сумма");
	Параметры.КВПроцентДляАгента     = 0;
	Параметры.КВСуммаДляАгента       = 0; 
	
	Параметры.НеМенятьКВ             = Истина;
	Параметры.НеМенятьАВ             = Истина;
	Параметры.КВСумма                = ДляБрокера; 
	Параметры.КВПроцент              = ?(ДляМенеджера=0,0,уб_ОКР(ДляБрокера*100/ДляМенеджера, ОП.РазрядностьОкругления,ОП.Знч("РежимОкругления")));
	Параметры.КВСуммаДляОтчета       = Параметры.КВСумма; 
	Параметры.КВПроцентДляОтчета     = Параметры.КВПроцент;
	
	//Параметры.ДанныеБланка.МинимальнаяСумма;	
	
	
КонецПроцедуры	

Функция ПараметрыСВС(Курьер,Дата) Экспорт
	
	ТипПодразделения = Перечисления.уб_ТипПодразделения.ТочкаПродаж;
	
	Если ЗначениеЗаполнено(Курьер) Тогда
		Уволен = Ложь;
		_СВС = уб_СС.ПолучитьПодразделениеАгента(Курьер, Дата, Истина, Уволен);
		
		МассивСтруктур = уб_КЭШируемые.ПолучитьПодразделенияВС(,Истина);
		флНайден = Ложь;
		Для каждого Структ из МассивСтруктур Цикл
			Если _СВС = Структ.Ссылка Тогда
				флНайден = Истина;	
				ТипПодразделения = Структ.ТипПодразделения;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Если флНайден = Ложь Тогда
			//_СВС = Справочники.ПодразделенияОрганизаций.ПустаяСсылка(); 	
			_СВС = ПараметрыСеанса.уб_Константы.уб_ПодразделениеСВС;
		КонецЕсли;	
		
	Иначе	
		_СВС = Справочники.ПодразделенияОрганизаций.ПустаяСсылка(); 
	КонецЕсли;	
	
	Результат = Новый Структура("Курьер,СВС,ТипПодразделения",Курьер,_СВС,ТипПодразделения);
	
	Возврат Результат;
КонецФункции


