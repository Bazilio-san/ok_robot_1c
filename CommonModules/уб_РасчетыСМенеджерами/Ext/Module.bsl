//КАСКО

Процедура ПолучитьВМдляСхемы_КАСКО_2500(ОП, Инфо, ВознаграждениеМенеджера, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	
	//Самая первая схема: 
	//КАСКО:
	//	2500р за страховку. За каждый процент скидки - минус 100р 
	//	При частичном платеже начисляется пропорциональная доля от ВМ
	ПолучитьВМдляСхемы_КАСКО_ФиксИ2500(ОП, Инфо, ВознаграждениеМенеджера, "2500", Стат, НЕДобавлятьСтатистикувИнфо);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_КАСКО_Фикс(ОП, Инфо, ВознаграждениеМенеджера, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	
	//Схема мотивации «Фикс за страховку»
	//При количестве новых договоров страхования КАСКО до 20 шт. в месяц
	//вознаграждение сотрудника составляет 2500руб. за одну страховку КАСКО. 
	//При частичной оплате страховки КАСКО, вознаграждение начисляется 
	//пропорционально доле платежа от полной премии.
	
	//Правила предоставления скидок: 2
	//Сотрудник вправе давать скидку до 5% от страховой премии по собственному усмотрению.
	//За каждый предоставленный % скидки из вознаграждения сотрудника вычитается 100руб.
	ПолучитьВМдляСхемы_КАСКО_ФиксИ2500(ОП, Инфо, ВознаграждениеМенеджера, "Фикс", Стат, НЕДобавлятьСтатистикувИнфо);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_КАСКО_ФиксИ2500(ОП, Инфо, ВознаграждениеМенеджера, СхемаРасчета, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	
	Ф = "ЧН=0; ЧГ=";	
	ФиксПоКАСКО = 2500; //руб.
	ВычетЗа1ПроцентСкидкиПоКАСКО = 100; //руб.	
	ДоляОплатыОтПолнойПремии = ДайДолюОтПолнойПремии(ОП);
	Если СхемаРасчета = "Фикс" Тогда
		Если ПроверитьПревышениеСуперПлана_ПоКоличествуНовыхКАСКО(ОП, ОП.Знч("ЗарплатныйПериод"), ОП.Знч("Агент"), Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО, ДоляОплатыОтПолнойПремии, ВознаграждениеМенеджера, Инфо, Стат) Тогда
			Инфо = Инфо + "
			|
			|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	//Схема "Фикс за КАСКО"	
	ЗаКАСКО = Окр(ФиксПоКАСКО * ДоляОплатыОтПолнойПремии,2);
	Если ОП.Знч("СтраховойПолис").БонусМенеджеру Тогда
		ВычетЗаСкидку = 0; 
	Иначе
		ВычетЗаСкидку = Окр(ОП.Знч("АВилиСкидкаПроцент") * ВычетЗа1ПроцентСкидкиПоКАСКО * ДоляОплатыОтПолнойПремии,2); 
	КонецЕсли;
	ВознаграждениеМенеджера = Окр(ЗаКАСКО - ВычетЗаСкидку,2);
	Если ДоляОплатыОтПолнойПремии < 1 Тогда
		ДоляИнфо1 = "Доля оплаты от полной премии: ДО = " + Строка(Окр(ДоляОплатыОтПолнойПремии*100,1)) + "%. "; 
		сДО = "р * ДО"; 
		сДО2 = сДО + " = " + Формат(ЗаКАСКО,Ф); 
	Иначе
		ДоляИнфо1 = ""; 
		сДО = ""; 
		сДО2 = ""; 
	КонецЕсли;
	Инфо = Инфо + "
	|" + ДоляИнфо1 + "За КАСКО: " + Формат(ФиксПоКАСКО,Ф) + сДО2 + "р. ";
	Если ОП.Знч("СтраховойПолис").БонусМенеджеру Тогда
		Инфо = Инфо + "
		|За скидку " + ОП.Знч("АВилиСкидкаПроцент") + "% вычет не начисляется, поскольку страховка вида '" 
		+ ОП.Знч("СтраховойПолис").ВидУчетаСтраховки + "'";
	Иначе
		Инфо = Инфо + "
		|Вычет за скидку: " + ОП.Знч("АВилиСкидкаПроцент") + "% * " + ВычетЗа1ПроцентСкидкиПоКАСКО 
		+ сДО + " = " + Формат(ВычетЗаСкидку,Ф) + "р.";
	КонецЕсли;
	Инфо = Инфо + "
	|Итого, ВМ=" + Формат(ЗаКАСКО,Ф) + " - " + Формат(ВычетЗаСкидку,Ф) 
	+ " = " + Формат(ВознаграждениеМенеджера,Ф) + "р.";
	ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера);
	Если НЕДобавлятьСтатистикувИнфо Тогда 
		Возврат;
	КонецЕсли;
	Если СхемаРасчета = "Фикс" Тогда
		Инфо = Инфо + "
		|
		|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
	Иначе
		ДобавитьСтатистикуПоКорпоративнымОплатамКАСКОЗаМесяц(ОП, Инфо);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_КАСКО_ОкладПремия(ОП, Инфо, ВознаграждениеМенеджера, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	
	//Схема мотивации «Оклад + Премия»
	
	//Вознаграждение сотрудника состоит из оклада и премиальной части.
	//Оклад – 20 000р выплачивается в полном размере при условии выполнения плана.
	//План: 10 новых договоров автострахования КАСКО в месяц.
	//Каждая страховка КАСКО сверх плана премируется из расчета 1500 руб. за страховку.
	
	//При невыполнении плана из оклада удерживается по 2000р за каждую страховку КАСКО, недостающую до планового количества.
	//Если сотрудник в течение отчетного периода (30 дней) не осуществит ни одной страховки КАСКО, 
	//его вознаграждение составит 3000 руб.
	
	//Правила предоставления скидок :
	//Сотрудник вправе давать скидку до 5% от страховой премии по собственному усмотрению.
	//За скидки свыше 5% из ЗП удерживается по 250р за каждый % скидки сверх 5%.
	
	//Начиная с 21-й новой страховки КАСКО (в отчетный месяц) вознаграждение сотрудника составляет 100% прибыли .
	
	Ф = "ЧН=0; ЧГ=";	
	ФиксПоКАСКО = 2000; //руб.
	ФиксПоКАСКОСверхПлана = 1500; //руб.
	ПланПоКАСКО = 10; //шт.
	ЛимитСкидки = 5; //%
	ВычетЗа1ПроцентСкидкиПоКАСКО = 250; //руб.	
	ДоляОплатыОтПолнойПремии = ДайДолюОтПолнойПремии(ОП);
	Если ПроверитьПревышениеСуперПлана_ПоКоличествуНовыхКАСКО(ОП, ОП.Знч("ЗарплатныйПериод"), ОП.Знч("Агент"), Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО, ДоляОплатыОтПолнойПремии, ВознаграждениеМенеджера, Инфо, Стат) Тогда
		Инфо = Инфо + "
		|
		|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
		Возврат;	
	КонецЕсли;
	//Схема «Оклад + Премия»
	ПревышениеПроцента = Макс(0,ОП.Знч("АВилиСкидкаПроцент") - ЛимитСкидки);
	ВычетЗаСкидку = Окр(ПревышениеПроцента * ВычетЗа1ПроцентСкидкиПоКАСКО * ДоляОплатыОтПолнойПремии,2); 
	ЗаКАСКО = Окр(ФиксПоКАСКО * ДоляОплатыОтПолнойПремии,2);
	ВознаграждениеМенеджера = Окр(ЗаКАСКО - ВычетЗаСкидку,2);
	сВычетЗаСкидку = Формат(ВычетЗаСкидку,Ф);	
	сЗаКАСКО = Формат(ЗаКАСКО,Ф);
	Если ДоляОплатыОтПолнойПремии < 1 Тогда
		ДоляИнфо1 = "Доля оплаты от полной премии: ДО = " + Строка(Окр(ДоляОплатыОтПолнойПремии*100,1)) + "%. "; 
		сДО = "р * ДО"; 
		сДО2 = сДО + " = " + сЗаКАСКО; 
	Иначе
		ДоляИнфо1 = ""; 
		сДО = ""; 
		сДО2 = ""; 
	КонецЕсли;
	Инфо = Инфо + "
	|" + ДоляИнфо1 + "За КАСКО: " + Формат(ФиксПоКАСКО,Ф) + сДО2 + "р. ";
	Если ВычетЗаСкидку > 0 Тогда
		Инфо = Инфо + "
		|Вычет за скидку: (" + Формат(ОП.Знч("АВилиСкидкаПроцент"),Ф) + "% - " + ЛимитСкидки + "%) = " 
		+ Формат(ПревышениеПроцента,Ф) + " * " + ВычетЗа1ПроцентСкидкиПоКАСКО + сДО + " = " + сВычетЗаСкидку + "р. "
	Иначе
		Инфо = Инфо + "
		|Скидка не более " + ЛимитСкидки + "%. Вычет за скидку: 0р. ";
	КонецЕсли;
	Инфо = Инфо + "
	|Итого, ВМ = " + ?(ВычетЗаСкидку > 0,сЗаКАСКО + "р - " + сВычетЗаСкидку + "р = ","") + Формат(ВознаграждениеМенеджера,Ф) + "р. ";
	ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера);
	Если НЕДобавлятьСтатистикувИнфо Тогда 
		Возврат;
	КонецЕсли;
	Инфо = Инфо + "
	|
	|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_КАСКО_Процент_от_СКВ_суперплан_по_количеству_новых_страховок(ОП, Инфо, ВознаграждениеМенеджера, ПодразделениеАгента = Неопределено, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	//Схема мотивации «Процент»
	//При количестве новых договоров страхования КАСКО до 20 шт в месяц
	//вознаграждение сотрудника составляет 30% от СКВ (собранное КВ = Сумма КВ - Скидка).
	//Прибыль со страховки равна сумме КВ брокера за вычетом суммы предоставленной скидки:
	//			СКВ = Сумма КВ - Скидка
	//			Вознаграждение сотрудника =  СКВ * 30%
	
	//Правила предоставления скидок:
	//Сотрудник вправе давать скидку до 10% от страховой премии по собственному усмотрению.
	
	//Примечание: в зависимости от эффективности работы сотрудника процент вознаграждения сотрудника 
	//может быть увеличен по усмотрению руководства до 33%.
	
	Ф = "ЧН=0; ЧГ=";	
	СП = ОП.Знч("СтраховойПолис");
	ПолнаяПремия = СП.СтраховаяПремия;	
	ДоляОплатыОтПолнойПремии = ДайДолюОтПолнойПремии(ОП);	
	_Агент = ОП.Знч("Агент");
	_ЗарплатныйПериод = ОП.Знч("ЗарплатныйПериод");
	
	Если ПроверитьПревышениеСуперПлана_ПоКоличествуНовыхКАСКО(ОП, _ЗарплатныйПериод, _Агент, Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО, ДоляОплатыОтПолнойПремии, ВознаграждениеМенеджера, Инфо, Стат) Тогда
		Инфо = Инфо + "
		|
		|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
		Возврат;	
	КонецЕсли;
	//Схема "Процент"	
	Если ПодразделениеАгента = Неопределено Тогда
		ПодразделениеАгента = уб_СС.ПолучитьПодразделениеАгента(_Агент, КонецМесяца(_ЗарплатныйПериод) - 1);
	КонецЕсли;
	_Организация = ПодразделениеАгента.Владелец;
	тзКВЗП = уб_СтраховойБрокер.ПолучитьПроцентнуюСтавкуДляСхемы_Процент_(ОП.Знч("ЗарплатныйПериод"), _Организация, ПодразделениеАгента, _Агент);
	Если тзКВЗП.Количество() > 0 Тогда
		КВЗП = тзКВЗП[0].Процент;
	Иначе
		КВЗП = 0;
		Сообщить("Ошибка при получении % вознаграждения для работающего по схеме ""Процент"".");
	КонецЕсли;
	Прибыль = ОП.Знч("КВСумма") - ОП.Знч("АВилиСкидкаСумма");
	ВознаграждениеМенеджера	= Окр(Прибыль * КВЗП / 100,2);
	Инфо = Инфо	+ "
	|Прибыль по оплате: " + Формат(Прибыль,Ф) + "р.
	|Процент от прибыли для сотрудника " + _Агент + ": " + КВЗП + "%.
	|ВМ = " + Формат(Прибыль,Ф) + "р * " + КВЗП + "% = " + Формат(ВознаграждениеМенеджера,Ф) + "р.";
	ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера);
	Если НЕДобавлятьСтатистикувИнфо Тогда 
		Возврат;
	КонецЕсли;	
	Инфо = Инфо + "
	|
	|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_ПланПоСКВ(ОП, Инфо, ВознаграждениеМенеджера, Стат = Неопределено, НЕДобавлятьСтатистикувИнфо = Ложь)
	
	//Схема мотивации «План по СКВ»
	//СКВ = Сумма КВ - Скидка
	//В расчетах используется формула:
	//СКВ =ПолученоОтКлиента-ВыплаченнаяСкидкаПослеОплаты-СуммаДляСК(за минусом КВ)
	//На отчетный месяц ставится План и СсуперПлан по сумме СКВ (уб_ЗП_Схема_ПланПоСКВ_Планы, уб_ЗП_Схема_ПланПоСКВ_СуперПланы)
	//При НЕ выполнении плана сотрудник получает процент ставки До Плана от СКВ  
	//При выполнении плана сотрудник получает процент ставки После Плана от минимальной из сумм СКВ и Размер СуперПлана  
	//При превышении СуперПлана, с суммы превышения суперплана менеджер получает по ставе превышения суперплана
	// Ставки До Плана, После Плана и Превышение Суперплана устанавливаются в уб_ЗП_Схема_ПланПоСКВ_ПроцентныеСтавки
	
	//расчет ВМ и ДБ для конкретной оплаты по этой схеме не производится, поскольку ВМ м ВР расчитываются по результатм ЗП периода
	Инфо = Инфо + "
	|
	|Расчет ВМ по отдельной оплате не производится.
	|СКВ определяется как: ПолученоОтКлиента-ВыплаченнаяСкидкаПослеОплаты-СуммаДляСК(за минусом КВ),
	|Общий расчет ВМ производится в конце месяца.";
	ВознаграждениеМенеджера = 0;
	Если НЕДобавлятьСтатистикувИнфо Тогда 
		Возврат;
	КонецЕсли;
	Если Стат = Неопределено Тогда
		Стат = ПолучитьСтруктуруСтатистики();
		Стат.ЗарплатныйПериод = ОП.Знч("ЗарплатныйПериод"); 
		Стат.Агент = ОП.Знч("Агент"); 
		Стат.ОП = ОП.Знч("Ссылка"); 
		ПолучитьСтатистикуПоКорпоративнымОплатамЗаМесяц(Стат);	
	КонецЕсли;
	Инфо = Инфо + "
	|
	|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
	
КонецПроцедуры

Процедура ПолучитьВМдляСхемы_СтраховойПродукт_Фикс(ОП, Инфо, ВознаграждениеМенеджера)
	
	ВознаграждениеМенеджера  = ОП.Знч("СтраховойПолис").СтраховойПродукт.ВознаграждениеМенеджера;
	
КонецПроцедуры	
