Функция СтруктураПолейДляРасчетаСКВ(Объект) Экспорт

	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Ссылка",											Объект.Знч("Ссылка"));
	СтруктураПолей.Вставить("ОплаченоФакт",										Объект.Знч("ОплаченоФакт"));
	СтруктураПолей.Вставить("СкидкаВыплаченаяКлиенту",							Объект.Знч("СкидкаВыплаченаяКлиенту"));
	СтруктураПолей.Вставить("НачисленнаяСуммаВзноса",							Объект.Знч("НачисленнаяСуммаВзноса"));
	СтруктураПолей.Вставить("ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику",	Объект.Знч("ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику"));
	СтруктураПолей.Вставить("КВСумма",											Объект.Знч("КВСумма"));
	СтруктураПолей.Вставить("КВСуммаДляАгента",									Объект.Знч("КВСуммаДляАгента"));
	СтруктураПолей.Вставить("КВСуммаУдержания",									Объект.Знч("КВСуммаУдержания"));
	СтруктураПолей.Вставить("КВСуммаДляОтчета",									Объект.Знч("КВСуммаДляОтчета"));
	СтруктураПолей.Вставить("АВИлиСкидкаСумма",									Объект.Знч("АВИлиСкидкаСумма"));
	СтруктураПолей.Вставить("ЗарплатныйПериод",									Объект.Знч("ЗарплатныйПериод"));
	СтруктураПолей.Вставить("СтраховойПолис",									Объект.Знч("СтраховойПолис"));
	СтруктураПолей.Вставить("Агент",											Объект.Знч("Агент"));
	СтруктураПолей.Вставить("ИсключитьИзРасчетаЗП",								Объект.Знч("ИсключитьИзРасчетаЗП"));
	СтруктураПолей.Вставить("ПометкаУдаления",									Объект.Знч("ПометкаУдаления"));
	СтруктураПолей.Вставить("ЭтоКрупнаяСделка",									Объект.Знч("ЭтоКрупнаяСделка"));
	СтруктураПолей.Вставить("СхемаРасчетаСМенеджером",							Объект.Знч("СхемаРасчетаСМенеджером"));
	СтруктураПолей.Вставить("ПроцентСКВ",							            Объект.Знч("ПроцентСКВ"));
	Возврат СтруктураПолей;

КонецФункции // СтруктураПолейДляРасчетаСКВ()
//Возвращает актуальность зарплатного периода, если переданы параметры производит ее изменение
Функция ЗарплатныйПериодАктуален(Период,ПараметрыЗаписи = Неопределено) Экспорт
	Отбор = Новый Структура ("РасчетныйПериод",НачалоМесяца(Период));
	
	ТаблицаАктуальности = РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП.СрезПоследних(ТекущаяДата(),Отбор);
	
	Актуален = Ложь;
	
	Если ТаблицаАктуальности.Количество() > 0 ТОгда
		//
		Актуален = ТаблицаАктуальности[0].Актуален;
	КонецЕсли;	
	Если ПравоДоступа("Изменение",Метаданные.РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП) = Истина и (НЕ ПараметрыЗаписи = Неопределено) И Актуален<>ПараметрыЗаписи.Актуален Тогда
		МЗ = РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП.СоздатьМенеджерЗаписи();
		МЗ.Актуален 		= ПараметрыЗаписи.Актуален;
		МЗ.РасчетныйПериод 	= Период;
		МЗ.Период 			= ТекущаяДата();
		МЗ.Объект 			= ПараметрыЗаписи.Объект;
		Попытка
			МЗ.Записать();
			Актуален = МЗ.Актуален;
		Исключение
			#Если Клиент Тогда
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка регистрации неактуальности периода расчета ЗП: " + ОписаниеОшибки());
			#КонецЕсли
		КонецПопытки;	
	КонецЕсли;
	Возврат Актуален;
КонецФункции

Функция ВернутьНеактуальныеПериоды() Экспорт
	ЗапросНеактуальныхПериодов = Новый Запрос("ВЫБРАТЬ
	                                          |	Вложенный.РасчетныйПериод КАК РасчетныйПериод
	                                          |ИЗ
	                                          |	(ВЫБРАТЬ
	                                          |		уб_АктуальностьРасчетаПериодовЗПСрезПоследних.РасчетныйПериод КАК РасчетныйПериод,
	                                          |		уб_АктуальностьРасчетаПериодовЗПСрезПоследних.Актуален КАК Актуален
	                                          |	ИЗ
	                                          |		РегистрСведений.уб_АктуальностьРасчетаПериодовЗП.СрезПоследних(, ) КАК уб_АктуальностьРасчетаПериодовЗПСрезПоследних) КАК Вложенный
	                                          |ГДЕ
	                                          |	НЕ Вложенный.Актуален
	                                          |	И Вложенный.РасчетныйПериод <> ДАТАВРЕМЯ(1, 1, 1)
	                                          |	И Вложенный.РасчетныйПериод >= ДАТАВРЕМЯ(2020, 1, 1)
	                                          |
	                                          |УПОРЯДОЧИТЬ ПО
	                                          |	РасчетныйПериод");
	//ЗапросНеактуальныхПериодов.УстановитьПараметр("ДатаВыплаты", ТекущаяДата());
	
	Возврат  ЗапросНеактуальныхПериодов.Выполнить().Выгрузить().ВыгрузитьКолонку("РасчетныйПериод");					  
КонецФункции	

Функция ПолучитьПараметрРасчетаЗП (ИмяПараметра,Сотрудник, Период = Неопределено,ЗначениеПоУмолчанию = Неопределено) Экспорт
	Если Период = Неопределено  Тогда
		Период = ТекущаяДата();
	КонецЕсли;	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Период,
