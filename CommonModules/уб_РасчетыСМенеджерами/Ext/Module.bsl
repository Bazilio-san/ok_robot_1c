	//Иначе
	//	Если ВКассу Тогда
	//		УстЗнч(ОП, "СкидкаВыплаченаяКлиенту", 0, бЗаблокирована);
	//	КонецЕсли;
	//	_ОплаченоФакт = ОП.Знч("ОплаченоФакт");
	//	_АВилиСкидкаСумма = Окр(ОП.Знч("НачисленнаяСуммаВзноса") - _ОплаченоФакт + ОП.Знч("СкидкаВыплаченаяКлиенту"), 2);				
	//	Если ОП.Знч("НачисленнаяСуммаВзноса") > 0 Тогда
	//		_АВилиСкидкаПроцент = Окр(_АВилиСкидкаСумма * 100 / ОП.Знч("НачисленнаяСуммаВзноса"), 2);
	//	Иначе	
	//		_АВилиСкидкаПроцент = 0;
