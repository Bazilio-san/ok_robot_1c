Процедура ОП_ПересчетСумм_КВ(ОП, Форма, ПараметрыПерерасчета, Параметры)

	РасчетныеПоля = Параметры.РасчетныеПоля;
	_Разрядность = ОП.Знч("РазрядностьОкругления");
	_РежимОкругления  = ОП.Знч("РежимОкругления");
	//НеМенятьАВ не может при виде расчета не при АВ
	//20260512 - удеражеие 3% блокируется этой кнопкой
	//Если Не РасчетныеПоля.РасчетПоАВ Тогда
	//Если Не ОП.Знч("ВидРасчетаСАгентом") = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда 
	//	УстЗнч(ОП, "НеМенятьАВ", Ложь, РасчетныеПоля.бЗаблокирована);
	//КонецЕсли;
	//УстановитьКВиАВ
	//ТребуетсяУстановкаКВ = (Не ОП.Знч("НеМенятьКВ") И ОП.Знч("КВПроцент") = 0 И ОП.Знч("КодКВ") = 0) Или Параметры.ОткрыватьФормуВыбораКВиАВ;
	Если Параметры.КВАгентаРавноКВ = Неопределено Тогда
		Если НЕ РасчетныеПоля.РасчетПоАВ 
			и НЕ (ОП.ВидС = Перечисления.уб_ВидыСтрахования.ВЗР
			ИЛИ ОП.ВидС = Перечисления.уб_ВидыСтрахования.Ипотека)
			и ОП.Знч("ЗарплатныйПериод")>=Дата(2026,1,1)	 
			и ОП.Знч("ФормаОплаты")     = Перечисления.уб_ФормыОплаты.Поставщику
			Тогда
			Если ОП.Знч("НеМенятьАВ") = ЛОЖЬ Тогда
				Если ОП.Знч("КВПроцентУдержания") < 3 Тогда
					ОП.УстЗнч("КВПроцентУдержания",Мин(3,ОП.Знч("КВПроцентДляАгента")));
					ОП.УстЗнч("КВСуммаУдержания",уб_ОКР(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцентУдержания") / 100, _Разрядность,_РежимОкругления));
				КонецЕсли;	
			КонецЕсли;	
			//Дельта = 3;
			//Параметры.КВАгентаРавноКВ = ЛОЖЬ; 
			//Если ОП.Знч("КВПроцент")- ОП.Знч("КВПроцентДляАгента")>Дельта Тогда
			//Иначе
			//	ОП.УстЗнч("КВПроцентДляАгента",Макс(0,ОП.Знч("КВПроцент")-Дельта));
			//КонецЕсли;	
		ИначеЕсли (РасчетныеПоля.РасчетПоАВ или ОП.ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ)
			и НЕ (ОП.ВидС = Перечисления.уб_ВидыСтрахования.ВЗР
			ИЛИ ОП.ВидС = Перечисления.уб_ВидыСтрахования.Ипотека)
			и ОП.Знч("ЗарплатныйПериод")>=Дата(2026,1,1)	 
			и ОП.Знч("ФормаОплаты")     = Перечисления.уб_ФормыОплаты.Поставщику
			Тогда
			
			Если ОП.Знч("НеМенятьАВ") = ЛОЖЬ Тогда
				Если ОП.Знч("КВПроцентУдержания") < 3 Тогда
					ОП.УстЗнч("КВПроцентУдержания",Мин(3,ОП.Знч("КВПроцентДляАгента")));
					ОП.УстЗнч("КВСуммаУдержания",уб_ОКР(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцентУдержания") / 100, _Разрядность,_РежимОкругления));
				КонецЕсли;	
			КонецЕсли;	
			
			Дельта = 6;
			Параметры.КВАгентаРавноКВ = ЛОЖЬ; 
			Если ОП.Знч("КВПроцент")- ОП.Знч("КВПроцентДляАгента")>Дельта Тогда
			Иначе
				ОП.УстЗнч("КВПроцентДляАгента",Макс(0,ОП.Знч("КВПроцент")-Дельта));
			КонецЕсли;		
		ИначеЕсли ОП.Знч("КВПроцентУдержания")>0 и ОП.Знч("НеМенятьАВ") = ЛОЖЬ Тогда
			//Поменяли
			ОП.УстЗнч("КВПроцентУдержания",0);
			ОП.УстЗнч("КВСуммаУдержания",0);
			
		Иначе	
			//Параметры.КВАгентаРавноКВ = ?(РасчетныеПоля.РасчетПоАВ, Ложь, ОП.Знч("КВПроцент") = ОП.Знч("КВПроцентДляАгента")); 
		КонецЕсли;	
	КонецЕсли;
	Если ОП.Знч("КВПроцентУдержания")>0  и ОП.Знч("КВПроцентДляАгента") = 0 Тогда
		ОП.УстЗнч("КВПроцентУдержания",0);
		ОП.УстЗнч("КВСуммаУдержания",0);
	ИначеЕсли ОП.Знч("КВПроцентУдержания")>=0 Тогда	
		//синхронизация суммы, могут исправить процент руками при заблокированном АВ
		ОП.УстЗнч("КВСуммаУдержания",уб_ОКР(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцентУдержания") / 100, _Разрядность,_РежимОкругления));
	КонецЕсли;	
	Параметры.КВАгентаРавноКВ = ?(РасчетныеПоля.РасчетПоАВ, Ложь, ОП.Знч("КВПроцент") = ОП.Знч("КВПроцентДляАгента")); 
	Если Параметры.ОтключитьВыравниваниеКВ = Неопределено Тогда
		Если РасчетныеПоля.бФорма Тогда
			Параметры.ОтключитьВыравниваниеКВ = Форма.ОтключитьВыравниваниеКВ
		Иначе
			Параметры.ОтключитьВыравниваниеКВ = ОП.Знч("КВПроцент") <> ОП.Знч("КВПроцентДляОтчета")
		КонецЕсли;
	КонецЕсли;
	//проверяем согласование оплаты - нужно ли менять КВПроцент
	//TODO почистить УстановитьКВиАВ от установки данных страхового полиса, подразделений и прочего - вывести сюда
	Если Параметры.УстанавливатьКВИАВ И Не ОплатаСогласована(ОП, 3) Тогда
		ТребуетсяУстановкаКВ =  Параметры.ОткрыватьФормуВыбораКВиАВ;//Ложь;//!!!! (Не ОП.Знч("НеМенятьКВ")) Или Параметры.ОткрыватьФормуВыбораКВиАВ;
		ТребуетсяУстановкаАВ = (Не ОП.Знч("НеМенятьАВ") И ОП.Знч("КВСуммаДляАгента") = 0 И РасчетныеПоля.РасчетПоАВ);
		Если Не ТребуетсяУстановкаКВ И ТребуетсяУстановкаАВ Тогда 	
			НеПереустанавливатьРанееВыбранноеКВ = ОП.Знч("КодКВ") <> 0;		
			ПроверятьАктуальностьКВ = Истина;		
			ОП.УстановитьКВиАВ(НеПереустанавливатьРанееВыбранноеКВ, ПроверятьАктуальностьКВ, Параметры);
			_АВилиСкидкаПроцент = ОП.Знч("АВилиСкидкаПроцент");
			_АВилиСкидкаСумма = Окр(ОП.Знч("НачисленнаяСуммаВзноса") * _АВилиСкидкаПроцент / 100, 2); 
		ИначеЕсли ТребуетсяУстановкаКВ Тогда
			ОП.УстановитьКВиАВ(,, Параметры);
		КонецЕсли;
	КонецЕсли;
	
	Если РасчетныеПоля.бФорма И Не Форма.ОтключитьВыравниваниеКВ Тогда //Может быть форма без этих реквизитов (взаиморасчетный диалог)
		Если УстЗнч(ОП, "КВПроцентДляОтчета", ОП.Знч("КВПроцент"), РасчетныеПоля.бЗаблокирована) Тогда
			ПараметрыПерерасчета.Поставщик = Истина
		КонецЕсли;
	КонецЕсли;
	
	КВСуммаРасчетное = уб_ОКР(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцент") / 100, _Разрядность,_РежимОкругления);
	ТекКВСумма   = ОП.Знч("КВСумма");
	ТекКВПроцент = ?(РасчетныеПоля.СуммаВзносаДляРасчетов = 0,999.99,// "Бесконечность" подумать может ли вызывать ложный пеерсчет или сброс
	ТекКВСумма*100/РасчетныеПоля.СуммаВзносаДляРасчетов);
	ПроцентРасхождения = Макс(ТекКВПроцент,ОП.Знч("КВПроцент"))-Мин(ТекКВПроцент,ОП.Знч("КВПроцент"));
	Если ОП.Знч("НеМенятьКВ") = Истина  и ПроцентРасхождения > 0.0145 Тогда
		//Если большое расхождение в процентах, то это не проблема округлений, замок неверно взведен
		//Попытка снять
		
		Если УстЗнч(ОП, "НеМенятьКВ", Ложь, РасчетныеПоля.бЗаблокирована) = Истина 
			и РасчетныеПоля.бФорма  Тогда //Если есть форма, то в ней тоже требуется обновление
			Форма.ОбновитьСостояниеФиксацииКВ();
		КонецЕсли;	
	КонецЕсли;	
	Если ОП.Знч("НеМенятьКВ") = Истина и ПроцентРасхождения <= 0.0145 Тогда //Расчитать надо правильно, даже если нельзя внести изменения
		КВСумма = ТекКВСумма; 
	Иначе
		КВСумма = КВСуммаРасчетное;//уб_ОКР(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцент") / 100, _Разрядность,_РежимОкругления);
		УстЗнч(ОП, "КВСумма", КВСумма, РасчетныеПоля.бЗаблокирована);
	КонецЕсли;
	
	КВСинхронизировано = Ложь;
	Если Параметры.УстанавливатьКВДляАгента Тогда
		Если Не РасчетныеПоля.РасчетПоАВ И Параметры.КВАгентаРавноКВ Тогда
			УстЗнч(ОП, "КВПроцентДляАгента", 	ОП.Знч("КВПроцент"), РасчетныеПоля.бЗаблокирована);
			УстЗнч(ОП, "КВСуммаДляАгента", 		ОП.Знч("КВСумма"), РасчетныеПоля.бЗаблокирована);
			КВСинхронизировано = Истина;
		КонецЕсли;
		//Если РасчетПоАВ Тогда
		//	//процент агента РАНЕЕ синхронизировался с АВ 
		//	//УстЗнч(ОП, "КВПроцентДляАгента", 	ОП.Знч("АВилиСкидкаПроцент"), бЗаблокирована);
		//	//УстЗнч(ОП, "КВСуммаДляАгента", 		ОП.Знч("АВилиСкидкаСумма"), бЗаблокирована);
		//ИначеЕсли Параметры.КВАгентаРавноКВ Тогда
		//	//КВ агента синхронизируется, только при их совпадении
		//	УстЗнч(ОП, "КВПроцентДляАгента", 	ОП.Знч("КВПроцент"), бЗаблокирована);
		//	УстЗнч(ОП, "КВСуммаДляАгента", 		ОП.Знч("КВСумма"), бЗаблокирована);
		//КонецЕсли;
	КонецЕсли;
	Если КВСинхронизировано= Истина или Параметры.КВАгентаРавноКВ=Ложь Тогда
		СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("СуммаФикс",ОП.Знч("Агент"),ОП.Знч("ЗарплатныйПериод"),-1);
		ПроцентФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ПроцентФикс",ОП.Знч("Агент"),ОП.Знч("ЗарплатныйПериод"),-1);
		
		
		Заявка= ОП.Знч("СтраховойПолис").Заявка;
		
		
		БезДоставки = ?(ЗначениеЗаполнено(Заявка)и ((Заявка.ЗаблокироватьАвторасчет = Истина и Заявка.ОплатитьВКассуЗаВыездКурьера =0) или Заявка.Самовыезд),Истина , Ложь);
		Если БезДоставки = Истина Тогда
			СуммаФикс =0;
		КонецЕсли;	
		
		Если РасчетныеПоля.РасчетПоАВ и (СуммаФикс>0 или ПроцентФикс>0) и ОП.НеМенятьАВ=Ложь Тогда
			 
			ЗаФиксПроцент = ?(ПроцентФикс>0,ОП.Знч("НачисленнаяСуммаВзноса")*ПроцентФикс/100,0);
			КВСуммаДляАгента =  Макс(ОП.Знч("КВСумма")- СуммаФикс-ЗаФиксПроцент,0);
			КВПроцентДляАгента = Окр(?(КВСуммаДляАгента=0,0,Окр(КВСуммаДляАгента*100/ОП.Знч("НачисленнаяСуммаВзноса"))),2);
			УстЗнч(ОП, "КВПроцентДляАгента", КВПроцентДляАгента, РасчетныеПоля.бЗаблокирована);
		ИначеЕсли Параметры.Свойство("КВАгентаУжеПосчитан") и Параметры.КВАгентаУжеПосчитан = Истина Тогда
			//ничего не делать
		Иначе
			КВСуммаДляАгента = Окр(ОП.Знч("НачисленнаяСуммаВзноса") * ОП.Знч("КВПроцентДляАгента") / 100, 2);
			// при изменении начисленной суммы взноса не происходил пересчет КВСуммаДляАгента
		КонецЕсли;
		УстЗнч(ОП, "КВСуммаДляАгента", КВСуммаДляАгента, РасчетныеПоля.бЗаблокирована);
	КонецЕсли;
	
	
	
	//Недостано средств
	//РасчетныйАВилиСумма	= Окр(ОП.Знч("НачисленнаяСуммаВзноса")+ОП.Знч("СуммаДоп") - ОП.Знч("ОплаченоФакт"), 2);
	
	// новая система. Пока привяжемся к константе направлений платежа для отладки
	Если РасчетныеПоля.СистемаНаправлениеПлатежа Тогда
		КВСуммаДляАгента = ОП.Знч("КВСуммаДляАгента");
		АВилиСкидкаСумма = ОП.Знч("АВилиСкидкаСумма");
		АВилиСкидкаПроцент = ОП.Знч("АВилиСкидкаПроцент");
		СкидкаВыплаченаяКлиенту = ОП.Знч("СкидкаВыплаченаяКлиенту");
		
		//Производится коррекция полей при изменении схемы оплаты, 
		//для сохранения цикличности значений, например при откате выбора назад, иначе может происходить изменение АВ менеджера 
		Если РасчетныеПоля.РасчетПоАВ  Тогда //Схема
			Разница = КВСуммаДляАгента - АВилиСкидкаСумма;
			Если Разница <> 0 Тогда 
				//Если ОП.Знч("ВидРасчетаСАгентом") <> Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда //Вид
					
					СкидкаВыплаченаяКлиенту = СкидкаВыплаченаяКлиенту + Разница;
				//Иначе
				//	Если КВСуммаДляАгента = ОП.Знч("КВСумма") Тогда 
				//		//Было синхронизировано с кв брокера, приравниваем к скидке/несданной сумме
				//		//АВилиСкидкаСумма = КВСуммаДляАгента;//
				//		КВСуммаДляАгента    = АВилиСкидкаСумма;
				//		//АВилиСкидкаПроцент = КВПроцентДляАгента;//
				//		КВПроцентДляАгента  = АВилиСкидкаПроцент;
				//	КонецЕсли;
				//	
				//КонецЕсли;
				
			КонецЕсли;	
		Иначе	
			Если ОП.Знч("ВидРасчетаСАгентом") = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда //Вид
				//Расчет по АВ, а схема СКВ
				Если КВСуммаДляАгента = АВилиСкидкаСумма и ОП.НеМенятьАВ = Ложь Тогда 
					
					Если ОП.Знч("СкидкаВыплаченаяКлиенту")<>0 Тогда
						//Значит в поле скидка была разница КВ и факт уплачено(то что менеджер должен был забрать позднее)
						СкидкаВыплаченаяКлиенту = 0;
					КонецЕсли;
					
					КВСуммаДляАгента   = ОП.Знч("КВСумма");
					КВПроцентДляАгента = ОП.Знч("КВПроцент");
					
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		УстЗнч(ОП, "КВСуммаДляАгента",   КВСуммаДляАгента, РасчетныеПоля.бЗаблокирована);
		Если УстЗнч(ОП, "КВПроцентДляАгента", КВПроцентДляАгента, РасчетныеПоля.бЗаблокирована) Тогда
			//требуется ниже досчитать КВ менеджера
			ПараметрыПерерасчета.Менеджер = Истина;
			Параметры.ПересчетВМ          = Истина;
		КонецЕсли;	
		
		УстЗнч(ОП,"ВМпоРезультатамПериодаЗП",ОП.Знч("СхемаРасчетаСМенеджером") = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ, РасчетныеПоля.бЗаблокирована);
		
		Если УстЗнч(ОП, "СкидкаВыплаченаяКлиенту", СкидкаВыплаченаяКлиенту, РасчетныеПоля.бЗаблокирована) Тогда
			ОП_ПересчетСумм_Страхователь(ОП, Форма, ПараметрыПерерасчета, Параметры);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОП_ПересчетСумм_Менеджер(ОП, Форма, ПараметрыПерерасчета, Параметры)

	РасчетныеПоля = Параметры.РасчетныеПоля;
	//--- в случае, если ДС недостаточно покрыть платежи поставщику или скидку клиенту, происходит удержание с менеджера
	//
	УстЗнч(ОП, "Подразделение", уб_СС.ПолучитьПодразделениеАгента(ОП.Знч("Агент"), ОП.Знч("ЗарплатныйПериод"), Ложь, Истина), РасчетныеПоля.бЗаблокирована);
	_ВознаграждениеМенеджера = 0;
	__ПримечаниеКОплатеАгентом = "";
	ПВР = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП;
	//_СхемаРасчетаСМенеджером = ПВР.БезРасчета; 
	__ВознаграждениеМенеджера = 0;
	СтруктураПолей = СтруктураПолейДляРасчетаСКВ(ОП);
	СтруктураСКВ = ПолучитьСКВ(СтруктураПолей, "структура");
	__СКВ 		= СтруктураСКВ.СКВ;
	__СКВАгента = СтруктураСКВ.СКВДляАгента;
	//Если __СКВ =0 и ОП.Знч("СуммаДоп") >0 и ОП.Знч("ОплаченоФакт") >= ОП.Знч("СуммаДоп") Тогда
	//	__СКВ = ОП.Знч("СуммаДоп");
	
	Если Окр(ОП.Знч("НачисленнаяСуммаВзноса")+ОП.Знч("СуммаДоп") - ОП.Знч("ОплаченоФакт"), 2)<=0 Тогда
		//Все оплачено
		//__СКВ = __СКВ+ОП.Знч("СуммаДоп");//Что-то неведомое убрал. скв посчитано выше уже верно, скорее всго артифакт
		//__СКВАгента !!! не меняем
	КонецЕсли;
			
	Если РасчетныеПоля.РасчетПоАВ Тогда
		_КОплатеАгентом = ОП.Знч("НачисленнаяСуммаВзноса") - ОП.Знч("ОплаченоФакт") - ОП.Знч("АВилиСкидкаСумма") + ОП.Знч("ВычетСАгента");
		//__ВознаграждениеМенеджера = ОП.Знч("АВилиСкидкаСумма") + ОП.Знч("ВычетСАгента");
		__ВознаграждениеМенеджера = ОП.Знч("КВСуммаДляАгента") + ОП.Знч("ВычетСАгента")- ОП.Знч("КВСуммаУдержания");
		__ДоходБрокера = ОП.Знч("КВСумма") - __ВознаграждениеМенеджера;
		ЗарплатныйПериод  = Оп.Знч("ЗарплатныйПериод");
		Если ЗарплатныйПериод<Дата(2016,1,1) или ЗначениеЗаполнено(ОП.Знч("СхемаРасчетаСМенеджером"))=Ложь  Тогда
			_СхемаРасчетаСМенеджером = ПВР.ПоАВ;
		КонецЕсли;
		
		//_ВознаграждениеМенеджера =//
		//Если ОП.Знч("НачисленнаяСуммаВзноса") <= 0 Тогда
			//__СКВ = 0;
			//__СКВАгента = 0;
		//Иначе	
			//__СКВ = ?(ОП.Знч("АВилиСкидкаСумма") > ОП.Знч("КВСумма"), 0, ОП.Знч("КВСумма") - ОП.Знч("АВилиСкидкаСумма"));//В расчет не попадает, но расчитаем и покажем в форме
			//__СКВАгента = ?(ОП.Знч("АВилиСкидкаСумма")>ОП.Знч("КВСуммаДляАгента"),0,ОП.Знч("КВСуммаДляАгента") - ОП.Знч("АВилиСкидкаСумма"));//В расчет не попадает, но расчитаем и покажем в форме
		//КонецЕсли;		
	Иначе
		Если ЗначениеЗаполнено(ОП.Знч("СхемаРасчетаСМенеджером")) = Ложь  Тогда
			_СхемаРасчетаСМенеджером = ПВР.ПланПоСКВ;
		КонецЕсли;

		//Расчет По Схеме - блокировка АВ не требуется
		//20260512 - На это значение завязана блокировка 3%
		//Если Не ОП.Знч("ВидРасчетаСАгентом") = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда 
		//	//Добавлено условие с учетом использования ПрименитьСебестоимость()
		//	УстЗнч(ОП, "НеМенятьАВ", Ложь, РасчетныеПоля.бЗаблокирована);
		//КонецЕсли;	
		Если ОП.Знч("ИсключитьИзРасчетаЗП") = ЛОЖЬ Тогда //Должно быть всегда
			//Параметры.СведенияОСквитованныхОплатах 	= Неопределено;
			//Параметры.СуммаПоПриемкам 				= 0;
			Если НЕ Параметры.СведенияОСквитованныхОплатах = Неопределено Тогда
				уб_СС.ОбновитьДанныеОплатыВКвитовке(Параметры.СведенияОСквитованныхОплатах,ОП);
			КонецЕсли;
			Параметры.НетКвитовкиПоСуммам = Не уб_СС.КвитовкаПоСуммам(
				?(Оп.ЭтоНовый(),Оп.ПолучитьСсылкуНового(),ОП.Знч("Ссылка")),
				,
				Параметры.СуммаПоПриемкам,
				,
				?(РасчетныеПоля.ЭтоФорма,ОП.Знч("ЭтотОбъект"),ОП), 
				Параметры.СведенияОСквитованныхОплатах,
				Параметры.СведенияОСквитованныхПриемках,
				Параметры.УИДГруппыКвитовки);
			    //
			ПолучитьВознаграждениеМенеджера(
				ОП,
				Параметры,
				_ВознаграждениеМенеджера, 
				_СхемаРасчетаСМенеджером, 
				Истина
				);
		КонецЕсли;
		_СуммаДляСК = РасчетныеПоля.СуммаВзносаДляРасчетов - ОП.Знч("КВСумма");
		_ПолученоОтКлиентаФакт = (ОП.Знч("ОплаченоФакт") - ОП.Знч("СкидкаВыплаченаяКлиенту"));
		Если _ПолученоОтКлиентаФакт < _СуммаДляСК Тогда
			//Это условие соответствует условию КВСумма < АВилиСкидкаСумма
			_КОплатеАгентом = _СуммаДляСК - _ПолученоОтКлиентаФакт;
			Если ОП.Знч("НаправлениеПлатежа") = Перечисления.уб_НаправленияПлатежа.ВБрокер Тогда
				__ПримечаниеКОплатеАгентом = "Сумма, которую брокер должен перечислить в СК (" + _СуммаДляСК + "р) больше фактически оплаченной суммы (" + ОП.Знч("ОплаченоФакт") + "р), поэтому в поле установлена максимальная из двух сумм.";
			Иначе
				__ПримечаниеКОплатеАгентом = "Сумма, которую брокер должен перечислить в СК (" + _СуммаДляСК + "р) меньше суммы, фактически переведенной брокеру (" + ОП.Знч("ОплаченоФакт") + "р), поэтому в поле установлена сумма недоплаты.";
			КонецЕсли;
			//_КОплатеАгентом = _СуммаДляСК - _ПолученоОтКлиентаФакт;
			//Если ВКассу Тогда
			//	__ПримечаниеКОплатеАгентом = "Сумма, которую брокер должен перечислить в СК (" + _СуммаДляСК + "р) больше фактически оплаченной суммы (" + ОП.Знч("ОплаченоФакт") + "р), поэтому в поле установлена максимальная из двух сумм.";
			//	_КОплатеАгентом = _СуммаДляСК;
			//Иначе
			//	__ПримечаниеКОплатеАгентом = "Сумма, которую брокер должен перечислить в СК (" + _СуммаДляСК + "р) меньше суммы, фактически переведенной брокеру (" + ОП.Знч("ОплаченоФакт") + "р), поэтому в поле установлена сумма недоплаты.";
			//	_КОплатеАгентом = _СуммаДляСК - _ПолученоОтКлиентаФакт;
			//КонецЕсли;
			//__СКВ = 0;
			//__СКВАгента = 0;
			__ДоходБрокера = 0;
			__ВознаграждениеМенеджера = ОП.Знч("ВознаграждениеМенеджера");
			//Случай когда средств недостаточно, они компенсируются за счет менеджера					
		Иначе
			//Если ВКассу Тогда
			//	_КОплатеАгентом = _ПолученоОтКлиентаФакт;
			//Иначе
			//	_КОплатеАгентом = 0;
			//КонецЕсли;
			_КОплатеАгентом = 0;
			//__СКВ = _ПолученоОтКлиентаФакт - _СуммаДляСК;                                                          
			//__СКВАгента = _ПолученоОтКлиентаФакт - (СуммаВзносаДляРасчетов - ОП.Знч("КВСуммаДляАгента")); 
			__ВознаграждениеМенеджера = 0;
			_вм =Неопределено;
			Если ОП.Знч("ВМпоРезультатамПериодаЗП")=Истина Тогда
				__ДоходБрокера = 0;
				//TODO Расчет выполнения плана
				Если Параметры.ПересчетВМ = ИСТИНА Тогда							
					//еще: получается, сейчас возможно поменять данные в оплате, которые не учтутся в быстром расчете до записи оплаты.
					Если Параметры.ДанныеПоЗПМенеджерам=Неопределено Тогда
						//тз = РасчетЗП_Быстро(ОП.Знч("ЗарплатныйПериод"),ОП.Знч("Агент"));
						//TODO при выборе агента, передавать строку или структуру?
						тз = уб_СЕРВЕРНЫЕ.РасчетЗП_Быстро(ОП.Знч("ЗарплатныйПериод"),ОП.Знч("Агент"));
						Если тз.Количество()=1  Тогда
							//ВМ по данной оплате
							_вм =тз[0];
						КонецЕсли; 
					Иначе
						тз = Параметры.ДанныеПоЗПМенеджерам.НайтиСтроки(НОвый Структура("Агент",ОП.Знч("Агент")));
						Если тз.Количество()>0 Тогда
							_вм =тз[0];
						КонецЕсли; 
					КонецЕсли;	 
					Если НЕ _вм =Неопределено Тогда
						_этоКС = НЕ _вм.СписокКС.Найти(ОП.Знч("Ссылка")) = Неопределено;
						__ВознаграждениеМенеджера = Окр(?(_вм.ЗП_СКВ=0 ИЛИ _этоКС,0,_вм.ЗП_СКВ*__СКВАгента/_вм.СКВ)+?(РасчетныеПоля.бЗаблокирована,ОП.Знч("ВознаграждениеМенеджера"),_ВознаграждениеМенеджера)+
						?(_вм.СКВ_КС=0 ИЛИ НЕ _этоКС,0,_вм.Бонус_КС*__СКВАгента/_вм.СКВ_КС),2);
					КонецЕсли;	
				Иначе
					__ВознаграждениеМенеджера = ОП.Знч("ВМРасчетное");
				КонецЕсли;	 
				__ДоходБрокера = __СКВ - __ВознаграждениеМенеджера;
			Иначе
				__ДоходБрокера = __СКВ - _ВознаграждениеМенеджера;
				__ВознаграждениеМенеджера = _ВознаграждениеМенеджера;
			КонецЕсли;
			
		КонецЕсли;				
	КонецЕсли;
	// вычитаем сумму подвязанных разниц
	Если РасчетныеПоля.РасчетПоАВ Тогда
		//Старый расчет  Сейчас в доходе уже вычтено полное АВ = АВВыплаченное+СкидкаВыплаченаяКлиенту
		//СуммаВзаиморасчетовСкидкаИлиАВ = Документы.уб_ВзаиморасчетСПоставщиком.СуммаПодвязкиПоСсылке(ОП.Знч("Ссылка"), Перечисления.уб_ВидОперацииВзаиморасчетов.СкидкаКлиенту);
		//__ДоходБрокера = __ДоходБрокера - (СуммаВзаиморасчетовСкидкаИлиАВ - ОП.Знч("СкидкаВыплаченаяКлиенту"));
	КонецЕсли;
	УстЗнч(ОП, "ДБ", 						Окр(__ДоходБрокера, 2), 			РасчетныеПоля.бЗаблокирована);
	УстЗнч(ОП, "ВМРасчетное", 				Окр(__ВознаграждениеМенеджера, 2), 	РасчетныеПоля.бЗаблокирована);
	УстЗнч(ОП, "СхемаРасчетаСМенеджером", 	_СхемаРасчетаСМенеджером, 			РасчетныеПоля.бЗаблокирована);			
	Если УстЗнч(ОП, "ВознаграждениеМенеджера", Окр(_ВознаграждениеМенеджера, 2), РасчетныеПоля.бЗаблокирована) = ИСТИНА 
		//И (Параметры.СведенияОСквитованныхОплатах <> Неопределено) И ТипЗнч(ОП) = Тип("ДокументОбъект.уб_ОплатаПолисов") 
		Тогда
		//НайденнаяСтрока = Параметры.СведенияОСквитованныхОплатах.Найти(ОП.Знч("Ссылка"), "ОплатаПолиса"); //TODO нужна ли ПолучитьСсылкуНового?
		//Если НайденнаяСтрока <> Неопределено Тогда
		//	НайденнаяСтрока.ВознаграждениеМенеджера = _ВознаграждениеМенеджера; 
		//КонецЕсли;
	ИначеЕсли РасчетныеПоля.бФорма и _ВознаграждениеМенеджера <> ОП.Знч("ВознаграждениеМенеджера") Тогда
		#Если Клиент Тогда
			Предупреждение("Рекомендуется пересчитать эту оплату. Отличается ВМ");
		#КонецЕсли
	КонецЕсли;
	Если РасчетныеПоля.бФорма Тогда
		Форма.лАгентВнешний = (ОП.Знч("Подразделение") = ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети);//Проверить зачем
		Форма.лИнфоКВМ 		= Параметры.ИнфоКВМ;	
		Если Не РасчетныеПоля.СистемаНаправлениеПлатежа Тогда
			Форма.лПримечаниеКОплатеАгентом = __ПримечаниеКОплатеАгентом;	
		КонецЕсли;
		Форма.лТекущееВознаграждениеМенеджера 	= _ВознаграждениеМенеджера;
		Форма.лСКВ 								= __СКВ;	
		Попытка
			Форма.лСКВАгента = __СКВАгента;
		Исключение
		КонецПопытки;	
		ЦветСКВ = ?(__СКВ = 0,Новый Цвет(255, 196, 196), Новый Цвет);
		РасчетныеПоля.ЭФ.СКВ.ЦветФонаПоля = ЦветСКВ;
		//Форма.ДоходБрокера = __ДоходБрокера; 	
		Форма.лСхемаРасчетаСМенеджером = "Схема расчета: " + ?(РасчетныеПоля.РасчетПоАВ,"по АВ",ОП.Знч("СхемаРасчетаСМенеджером")); 	
		РасчетныеПоля.ЭФ.нСхемаРасчетаСМенеджером.ЦветФона  = ЦветСКВ;
		РасчетныеПоля.ЭФ.нСхемаРасчетаСМенеджером.Подсказка = ?(__СКВ = 0, "СКВ по этой оплате = 0 ","");
	КонецЕсли;
	УстЗнч(ОП, "ВМпоРезультатамПериодаЗП", 	ОП.Знч("СхемаРасчетаСМенеджером") = ПВР.ПланПоСКВ, РасчетныеПоля.бЗаблокирована);			
	Если Не РасчетныеПоля.СистемаНаправлениеПлатежа Тогда
		УстЗнч(ОП, "КОплатеАгентом", Окр(_КОплатеАгентом, 2), РасчетныеПоля.бЗаблокирована);
	КонецЕсли;
	//Дополнение актуальными данными из объекта

КонецПроцедуры

Процедура ОП_ПересчетСумм_Поставщик(ОП, Форма, ПараметрыПерерасчета, Параметры)

	РасчетныеПоля = Параметры.РасчетныеПоля;
	_КВИзмененное = Окр(РасчетныеПоля.СуммаВзносаДляРасчетов, 2) - Окр(ОП.Знч("Баланс_Брокер_Поставщик"),2);
	Если ОП.Знч("ПересчетКВ") И _КВИзмененное > 0 И ОП.Знч("Баланс_Брокер_Поставщик") > 0 Тогда 
		_КВСуммаДляОтчета = _КВИзмененное;
	Иначе	
		_Разрядность = ОП.Знч("РазрядностьОкругления");
		_РежимОкругления  = ОП.Знч("РежимОкругления");
		Если ОП.Знч("НеМенятьКВ") = Истина Тогда
			Если Параметры.ОтключитьВыравниваниеКВ = Истина Тогда
				_КВСуммаДляОтчета = ОП.Знч("КВСуммаДляОтчета");
			Иначе
				_КВСуммаДляОтчета  = ОП.Знч("КВСумма");
			КонецЕсли;
			
		Иначе
			_КВСуммаДляОтчета = уб_Окр(РасчетныеПоля.СуммаВзносаДляРасчетов * ОП.Знч("КВПроцентДляОтчета") / 100, _Разрядность,_РежимОкругления); 
		КонецЕсли;
	
	КонецЕсли;
	УстЗнч(ОП, "КВСуммаДляОтчета", _КВСуммаДляОтчета, РасчетныеПоля.бЗаблокирована);
	СП = ОП.Знч("СтраховойПолис");
	Если РасчетныеПоля.бЕстьОП Тогда
		бДоговорБезУдержанияКВ = ОП.Знч("ОтчетПоставщику").ВидВзаиморасчета = ПараметрыСеанса.уб_Константы.ВидВзаиморасчетовБезУдержанияКВ;
		Если НЕ ЗначениеЗаполнено(бДоговорБезУдержанияКВ)Тогда
			бДоговорБезУдержанияКВ = Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если бДоговорБезУдержанияКВ = Неопределено Тогда //Нет ОП, либо в ОП не указан Вид взаиморасчетов
		Если Форма <> Неопределено Тогда
			Если Форма.лСУдержанием = Неопределено Тогда
				бДоговорБезУдержанияКВ = НЕ уб_СС.ОпределитьЭтоРасчетСУдержаниемКВ(СП.Поставщик, СП.ОрганизацияАгент, СП.Дата, Ложь);
				Форма.лСУдержанием =  бДоговорБезУдержанияКВ;
			Иначе
				бДоговорБезУдержанияКВ = Форма.лСУдержанием;
			КонецЕсли;	
		Иначе	
			бДоговорБезУдержанияКВ = НЕ уб_СС.ОпределитьЭтоРасчетСУдержаниемКВ(СП.Поставщик, СП.ОрганизацияАгент, СП.Дата, Ложь);
		КонецЕсли;
	КонецЕсли;	
	_Баланс_Брокер_Поставщик = РасчетныеПоля.СуммаВзносаДляРасчетов
	- ?(бДоговорБезУдержанияКВ И РасчетныеПоля.бОплаченоВБрокер, 0, ОП.Знч("КВСуммаДляОтчета"))
	- ?(РасчетныеПоля.бОплаченоВБрокер, 0, ОП.Знч("ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику"));
	УстЗнч(ОП, "Баланс_Брокер_Поставщик", _Баланс_Брокер_Поставщик, РасчетныеПоля.бЗаблокирована);
	Если _Баланс_Брокер_Поставщик >= 0 Тогда
		_СуммаКОплатеБрокеруДляОчетаПоставщику = 0;
		//_СуммаКОплатеПоставщикуДляОчетаПоставщику = _Баланс_Брокер_Поставщик;
	Иначе
		_СуммаКОплатеБрокеруДляОчетаПоставщику = - _Баланс_Брокер_Поставщик;
		//_СуммаКОплатеПоставщикуДляОчетаПоставщику = 0;
	КонецЕсли;
	УстЗнч(ОП, "СуммаКОплатеБрокеруДляОчетаПоставщику", Окр(_СуммаКОплатеБрокеруДляОчетаПоставщику, 2), РасчетныеПоля.бЗаблокирована);

КонецПроцедуры

Функция ОП_ПересчетСумм(
	ОП, 
	Форма 					= Неопределено, 
	ПараметрыПерерасчета 	= Неопределено,
	Параметры               = Неопределено
	) Экспорт
	
	ТЗИзменений = ОП.Знч("ТЗИзменений");
	#Если Клиент Тогда
		_ЭтоФорма = ТипЗнч(ОП)=Тип("Форма");
	#Иначе
		_ЭтоФорма = Ложь;
	#КонецЕсли
	_Модифицированность = ?(_ЭтоФорма,ОП.Модифицированность,ОП.Модифицированность());//Начальная Модифицированность
	Если ПараметрыПерерасчета = Неопределено Тогда
		ПараметрыПерерасчета = Новый Структура("Страхователь, КВ, Менеджер, Поставщик", Истина, Истина, Истина, Истина);
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Параметры = СтруктураПараметровОППересчетСуммПоУмолчанию()
	КонецЕсли;
	РасчетныеПоля = Параметры.РасчетныеПоля;
	РасчетныеПоля.СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	РасчетныеПоля.ЭтоФорма					= _ЭтоФорма;
	Если Форма = Неопределено Тогда
		РасчетныеПоля.бФорма = Ложь;
		//без формы разрешено редактирование пересчета всегда
		Попытка
			ОП.лРазрешеноРедактирование = Истина;
		Исключение
		КонецПопытки;	
	Иначе
		РасчетныеПоля.бФорма 	= Истина;
		РасчетныеПоля.ЭФ 		= Форма.ЭлементыФормы;
	КонецЕсли;
	РасчетныеПоля.бЗаблокирована = РасчетныеПоля.бФорма = Истина И Форма.лРазрешеноРедактирование = Ложь;
	//Убрано, потому что дергается 1001>0,0>1001
	//Если Параметры.ИзменятьКодКВ Тогда
	//	УстЗнч(ОП, "КодКВ", 0, бЗаблокирована);
	//КонецЕсли;
	//пропишем код, который вызывался в форме здесь - перед началом обработки, во избежание несоответствий вызова
	//TODO распределить по параметрам перерасчета
	//пока без параметров перерасчета вызывается только установка валюты,
	//кодКВ при установке параметра и ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	//ну и еще раскрашивается элемент формы КВПроцент в конце функции - убрать, или переместить код в форму TODO
	_СтраховойПолис = ОП.Знч("СтраховойПолис");
	УстЗнч(ОП, "Валюта", ?(_СтраховойПолис.Пустая(), ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета, _СтраховойПолис.ВалютаДокумента),РасчетныеПоля.бЗаблокирована, Истина);
	//Проверка итога по ТЧ
	СуммаДоп = ОП.Знч("УслугиПоДокументу").Итог("Сумма");
	УстЗнч(ОП, "СуммаДоп", СуммаДоп, РасчетныеПоля.бЗаблокирована);
	
	//Получаем данные бланка и корректируем схему при необходимости
	ВидБСО = ПолучитьБланкПолиса(Оп.Знч("Ссылка"));
	Если Не ВидБСО = Неопределено Тогда
		ДанныеБланка = ПолучитьСхемуИАлгоритмРасчета(ВидБСО,ОП.Знч("Агент"),ОП.Знч("ЗарплатныйПериод"));
		Если не ДанныеБланка = Неопределено Тогда
			Если ДанныеБланка.Схема = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ и НЕ Оп.Знч("ПроверенаЗП") Тогда
				//СхемаРасчетаСМенеджером = ОП.Знч("СхемаРасчетаСМенеджером");
				Если УстЗнч(ОП, "ВидРасчетаСАгентом",Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ,РасчетныеПоля.бЗаблокирована) Тогда
					//меняем только при начальной установке
					УстЗнч(ОП, "СхемаРасчетаСМенеджером",ДанныеБланка.Схема,РасчетныеПоля.бЗаблокирована);
				КонецЕсли;	
				
				Если Не ПустаяСтрока(ДанныеБланка.Алгоритм) Тогда
					
					флЕстьПравки = Ложь;
					
					//Считываем значения
					ПараметрыАлгоритма  = Новый Структура;
					
					ПараметрыАлгоритма.Вставить("Документ",Оп);
					ПараметрыАлгоритма.Вставить("НачисленнаяСуммаВзноса", Оп.Знч("НачисленнаяСуммаВзноса"));
					ПараметрыАлгоритма.Вставить("АВилиСкидкаПроцент",     Оп.Знч("АВилиСкидкаПроцент"));
					ПараметрыАлгоритма.Вставить("АВилиСкидкаСумма",       Оп.Знч("АВилиСкидкаСумма"));
					ПараметрыАлгоритма.Вставить("КВПроцент",              Оп.Знч("КВПроцент"));
					ПараметрыАлгоритма.Вставить("КВСумма",                Оп.Знч("КВСумма"));
					ПараметрыАлгоритма.Вставить("КВПроцентДляАгента",     Оп.Знч("КВПроцентДляАгента"));
					ПараметрыАлгоритма.Вставить("КВСуммаДляАгента",       Оп.Знч("КВСуммаДляАгента"));
					ПараметрыАлгоритма.Вставить("КВПроцентДляОтчета",     Оп.Знч("КВПроцентДляОтчета"));
					ПараметрыАлгоритма.Вставить("КВСуммаДляОтчета",       Оп.Знч("КВСуммаДляОтчета"));
					ПараметрыАлгоритма.Вставить("СуммаДоп",               Оп.Знч("СуммаДоп"));
					ПараметрыАлгоритма.Вставить("НеМенятьКВ",             Оп.Знч("НеМенятьКВ"));
					ПараметрыАлгоритма.Вставить("ОплаченоФакт",           Оп.Знч("ОплаченоФакт"));
					ПараметрыАлгоритма.Вставить("НеМенятьАВ",             Оп.Знч("НеМенятьАВ"));
					ПараметрыАлгоритма.Вставить("бЗаблокирована",         РасчетныеПоля.бЗаблокирована);
					
					
					
					
					ПараметрыАлгоритма.Вставить("ДанныеБланка",           ДанныеБланка);
					
					Попытка
						//здесь значения могут поменяться
						Выполнить(ДанныеБланка.Алгоритм);
						флЕстьПравки = Истина;
						
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка при алгоритмическом расчет"+ ОписаниеОшибки(),,Истина);
					КонецПопытки;
					
					Если флЕстьПравки Тогда
						//устанавливаем значения в объект
						УстЗнч(ОП, "НачисленнаяСуммаВзноса", ПараметрыАлгоритма.НачисленнаяСуммаВзноса, РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "АВилиСкидкаПроцент"    , ПараметрыАлгоритма.АВилиСкидкаПроцент    , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "АВилиСкидкаСумма"      , ПараметрыАлгоритма.АВилиСкидкаСумма      , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВПроцент"             , ПараметрыАлгоритма.КВПроцент             , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВСумма"               , ПараметрыАлгоритма.КВСумма               , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВПроцентДляАгента"    , ПараметрыАлгоритма.КВПроцентДляАгента    , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВСуммаДляАгента"      , ПараметрыАлгоритма.КВСуммаДляАгента      , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВПроцентДляОтчета"    , ПараметрыАлгоритма.КВПроцентДляОтчета    , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "КВСуммаДляОтчета"      , ПараметрыАлгоритма.КВСуммаДляОтчета      , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "НеМенятьКВ"            , ПараметрыАлгоритма.НеМенятьКВ            , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "СуммаДоп"              , ПараметрыАлгоритма.СуммаДоп              , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "ОплаченоФакт"          , ПараметрыАлгоритма.ОплаченоФакт          , РасчетныеПоля.бЗаблокирована);
						УстЗнч(ОП, "НеМенятьАВ"            , ПараметрыАлгоритма.НеМенятьАВ            , РасчетныеПоля.бЗаблокирована);
							
					Конецесли;	
					//далее применются стандартные алгоритмы
				КонецЕсли;	
			ИначеЕсли ДанныеБланка.Схема = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ и НЕ Оп.Знч("ПроверенаЗП") Тогда
				Если Не ПустаяСтрока(ДанныеБланка.Алгоритм) Тогда
					Попытка
						//здесь значения могут поменяться
						Выполнить(ДанныеБланка.Алгоритм);
						флЕстьПравки = Истина;
						
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка при алгоритмическом расчет"+ ОписаниеОшибки(),,Истина);
					КонецПопытки;
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;
	
	//РТ+
	Параметры.Вставить("КВАгентаУжеПосчитан",Ложь);
	
	Если Оп.Знч("ПроверенаЗП") = Ложь и ЗначениеЗаполнено(Оп.Знч("Куратор"))= Ложь Тогда
		//Куратор, это другая схема, когда проверена ЗП править уже нельзя
		Источник = ПолучитьИсточникЗаявки(Оп.Знч("СтраховойПолис"));
		Если ЗначениеЗаполнено(Источник) и Оп.Знч("Агент")<>Источник Тогда
			
			ВидСп = Оп.Знч("ВидСП");
			//Вариант 1
			Если ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО или ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО
				или ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КаскоПП
				Тогда
				_ВычетСАгента = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетПоИсточникуКАСКО",Источник,ОП.Знч("ЗарплатныйПериод"),0);
			ИначеЕсли ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО или ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО Тогда
				_ВычетСАгента = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетПоИсточникуОСАГО",Источник,ОП.Знч("ЗарплатныйПериод"),0);	
			Иначе
				//Если вычет установлен руками, он должен быть заблокирован "ПроверенаЗП", иначе вычет обнулится
				_ВычетСАгента = 0;
			КонецЕсли;	
			УстЗнч(ОП, "ВычетСАгента", _ВычетСАгента, РасчетныеПоля.бЗаблокирована);
			
			//Вариант 2
			Если ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО или ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО Тогда
				_СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетСКВПоИсточникуКАСКО",Источник,ОП.Знч("ЗарплатныйПериод"),-1);
			ИначеЕсли ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО или ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО Тогда
				_СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетСКВПоИсточникуОСАГО",Источник,ОП.Знч("ЗарплатныйПериод"),-1);
			Иначе
				_СуммаФикс = 0;
			КонецЕсли;	
			Если _СуммаФикс>0 и (Оп.Знч("ПроверенаЗП") = Ложь) Тогда
				_КВСуммаДляАгента =  Макс(ОП.Знч("КВСумма")- _СуммаФикс,0);
				_КВПроцентДляАгента = Окр(?(_КВСуммаДляАгента=0,0,_КВСуммаДляАгента*100/ОП.Знч("НачисленнаяСуммаВзноса")),2);
				УстЗнч(ОП, "КВПроцентДляАгента", _КВПроцентДляАгента, РасчетныеПоля.бЗаблокирована);	
				Параметры.Вставить("КВАгентаУжеПосчитан",УстЗнч(ОП, "КВСуммаДляАгента", _КВСуммаДляАгента, РасчетныеПоля.бЗаблокирована));	
				//УстЗнч(ОП, "НеМенятьАВ", Истина, РасчетныеПоля.бЗаблокирована);	//Блокировка расчета суммы по проценту/разница округления
			КонецЕсли;	
		//ПроцентФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ПроцентФикс",ОП.Знч("Агент"),ОП.Знч("ЗарплатныйПериод"),-1);
		//Если РасчетныеПоля.РасчетПоАВ и СуммаФикс>0 и ОП.НеМенятьАВ=Ложь Тогда
		//	 
		//	ЗаФиксПроцент = ?(ПроцентФикс>0,ОП.Знч("НачисленнаяСуммаВзноса")*ПроцентФикс/100,0);
