Функция ПолучитьВознаграждениеМенеджера(
	ОП,
	Параметры,
	ВознаграждениеМенеджера, 
	СхемаРасчета, 
	НЕДобавлятьСтатистикувИнфо 	= Ложь
	) Экспорт
	
	//ИнфоКВМ 						= "", 
	//СтатПоКАСКО 					= Неопределено,
	//СведенияОСквитованныхОплатах 	= Неопределено,
	//СуммаПоПриемкам 				= 0,
	//бНетКвитовкиПоСуммам 			= Неопределено
	Ф = "ЧН=0; ЧГ=";
	ВознаграждениеМенеджера = 0;
	//Если НЕ уб_СС.ОП_ВозможноРедактирование(ОП) Тогда
	//	Возврат 0;	
	//КонецЕсли;
	СведенияОСквитованныхОплатах = Параметры.СведенияОСквитованныхОплатах;
	Если СведенияОСквитованныхОплатах <> Неопределено Тогда
		БалансОплаты = СведенияОСквитованныхОплатах.Итог("НачисленнаяСуммаВзносаВКЛ")
		+ СведенияОСквитованныхОплатах.Итог("СуммаДоп")
		//- СведенияОСквитованныхОплатах.Итог("АВилиСкидкаСумма")
		- СведенияОСквитованныхОплатах.Итог("КВСумма")
		- Параметры.СуммаПоПриемкам
		+ СведенияОСквитованныхОплатах.Итог("СкидкаВыплаченаяКлиенту");
	Иначе
		БалансОплаты = 0;
	Конецесли;
	//Отрицательный баланс говорит о прибыли
	//Положительный об убытке, который требуется компенсировать
	
	//Если ОП.КВСумма < ОП.АВилиСкидкаСумма Тогда
	Если БалансОплаты>0 и СведенияОСквитованныхОплатах.Итог("НачисленнаяСуммаВзносаВКЛ")>0 Тогда
		//ВознаграждениеМенеджера = ОП.КВСумма - ОП.АВилиСкидкаСумма;
		УжеУчтено = -(СведенияОСквитованныхОплатах.Итог("ВознаграждениеМенеджера")-ОП.Знч("ВознаграждениеМенеджера"));
		ВознаграждениеМенеджера = Окр(-(БалансОплаты-УжеУчтено),2);
		Если ВознаграждениеМенеджера<>0 Тогда
			Параметры.ИнфоКВМ = "Недостаточно средств, которые надо оплатить поставщику " + Формат(-ВознаграждениеМенеджера,Ф) + "р, компенсируется менеджером.";
			//ИнфоКрасчетуВМ = "Сумма предоставленной скидки превышает КВ брокера на сумму " + Формат(-ВознаграждениеМенеджера,Ф) + "р, которая удерживается с сотрудника";
			//ДобавитьВычетСАгента(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера);//Не добавялем будет задвоение	
			Если ВознаграждениеМенеджера < 0 
				И ОП.Знч("СхемаРасчетаСМенеджером") = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ
				И Не ОП.Знч("ПроверенаЗП")
				Тогда
				// СКВ не должно аккумулироваться по этой оплате в расчете ВМ
				УстЗнч(ОП, "СхемаРасчетаСМенеджером", ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.БезРасчета, Параметры.РасчетныеПоля.бЗаблокирована);
			Иначе
				//Если ОП.УслугиПоДокументу.Итог("ВМ") Тогда
				//	
				//КонецЕсли;	
					
			КонецЕсли;
			Возврат ВознаграждениеМенеджера;	
		Иначе
			Для Каждого СтрокаУслуги Из ОП.УслугиПоДокументу Цикл
				Если СтрокаУслуги.СхемаОплаты = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль Тогда
					//
					ВознаграждениеМенеджера = ВознаграждениеМенеджера+СтрокаУслуги.ВМ;
				КонецЕсли;
			КонецЦикла;	
			Возврат ВознаграждениеМенеджера;	
		КонецЕсли;
	Иначе
		//УжеУчтено = -(СведенияОСквитованныхОплатах.Итог("ВознаграждениеМенеджера")-ОП.Знч("ВознаграждениеМенеджера"));
		//ВознаграждениеМенеджера = Окр(-(0-УжеУчтено),2);
		Если ОП.СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль Тогда
			Выручка = ОП.Знч("НачисленнаяСуммаВзноса") - ОП.Знч("АВилиСкидкаСумма");//-ОП.Знч("СуммаДоп");
			//ВознаграждениеМенеджера = Выручка - ПолучитьСебестоимость(Оп.Знч("Ссылка"));
			ВидБСО = ПолучитьБланкПолиса(Оп.Знч("Ссылка"));
			Если Не ВидБСО = Неопределено Тогда
				ДанныеБланка = ПолучитьСхемуИАлгоритмРасчета(ВидБСО,ОП.Знч("Агент"),ОП.Знч("ЗарплатныйПериод"));
				Если не ДанныеБланка = Неопределено Тогда
					ВознаграждениеМенеджера = Выручка - ДанныеБланка.МинимальнаяСумма;
				КонецЕсли;	
			КонецЕсли;	
				
		Иначе
			ВознаграждениеМенеджера = 0;
		КонецЕсли;	
		
		Для Каждого СтрокаУслуги Из ОП.УслугиПоДокументу Цикл
			Если СтрокаУслуги.СхемаОплаты = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль Тогда
				//
				ВознаграждениеМенеджера = ВознаграждениеМенеджера+СтрокаУслуги.ВМ;
			КонецЕсли;
		КонецЦикла;	
		Возврат ВознаграждениеМенеджера;	
	КонецЕсли;
	_ВидСП  = ОП.Знч("ВидСП");
	//Если _ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО Тогда 
	//	//Здесь ничего не делаем	
	//ИначеЕсли _ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО Тогда
	//	//Здесь ничего не делаем	
	//Иначе	
	//	ИнфоКрасчетуВМ = "ВМ по виду страховых продуктов '" + _ВидСП + "' по этой схеме расчетов не начисляется.";
	//	ВознаграждениеМенеджера = 0;
	//	Возврат  ВознаграждениеМенеджера;
	//КонецЕсли;
	//
	//20120607
	ПВР = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП;
	СтраховойПродукт = ОП.Знч("СтраховойПродукт"); 
	Если Оп.Знч("ПроверенаЗП") Тогда
		СхемаРасчета  = Оп.Знч("СхемаРасчетаСМенеджером");
	Иначе
		Если ЗначениеЗаполнено(СтраховойПродукт) = Ложь Тогда
			СхемаРасчета  = СтраховойПродукт.СхемаРасчетаСМенеджером; //Приоритетный в определении схемы оплаты
		Иначе
			СхемаРасчета = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПустаяСсылка();	
		КонецЕсли;	
	КонецЕсли;
	
	Если СхемаРасчета = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПустаяСсылка() Тогда
		тз = уб_СтраховойБрокер.ПолучитьСхемуРасчетаСМенеджером(ОП.Знч("ЗарплатныйПериод"), ОП.Знч("Подразделение").Владелец, ОП.Знч("Подразделение"), ОП.Знч("Агент"), ОП.Знч("ВидСП"));
		Если тз.Количество() > 0 Тогда
			СхемаРасчета = тз[0].СхемаРасчета;
		Иначе
			СхемаРасчета = ПВР.БезРасчета;
			Сообщить("Ошибка при получении вида расчета с менеджером.",СтатусСообщения.ОченьВажное);
			Возврат  ВознаграждениеМенеджера;
		КонецЕсли;
	КонецЕсли;
	
	Если СхемаРасчета = ПВР.БезРасчета Тогда
		Параметры.ИнфоКВМ = "Вознаграждение не начисляется (Схема 'Без Расчета'). ";
		ВознаграждениеМенеджера = 0;
	ИначеЕсли СхемаРасчета = ПВР.ПланПоСКВ Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'План по СКВ'. ";
		ПолучитьВМдляСхемы_ПланПоСКВ(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.ПоИнтерваламСКВ Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Интервалы СКВ'. ";
		Параметры.ИнфоКВМ = "Расчет ВМ по отдельной оплате не производится.
		|СКВ определяется как: КВ-ПолнаяСкидка,
		|ВМ рассчитывается как сумма вознаграждений за каждый интервал СКВ
		|Общий расчет ВМ производится в конце месяца.";
	//	ПолучитьВМдляСхемы_ПланПоСКВ(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);	
	ИначеЕсли СхемаРасчета = ПВР.СтраховойПродукт_Фикс Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Фиксированная сумма по страховому продукту'. ";
		ПолучитьВМдляСхемы_СтраховойПродукт_Фикс(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера);
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_2500 Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме '2500 за КАСКО'. ";
		ПолучитьВМдляСхемы_КАСКО_2500(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_ОкладПремия Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Оклад+Премия'. ";
		ПолучитьВМдляСхемы_КАСКО_ОкладПремия(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_Процент Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Процент'. ";
		ПолучитьВМдляСхемы_КАСКО_Процент_от_СКВ_суперплан_по_количеству_новых_страховок(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, ОП.Знч("Подразделение"), Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_Фикс Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Фикс за страховку'. ";
		ПолучитьВМдляСхемы_КАСКО_Фикс(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера, Параметры.СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.ОСАГО_Фикс Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Фикс за ОСАГО'. ";
		ПолучитьВМдляСхемы_ОСАГО_Фикс(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера);
	ИначеЕсли СхемаРасчета = ПВР.ОСАГО_Фикс_Администратор Тогда
		Параметры.ИнфоКВМ = "Расчет по схеме 'Фикс за ОСАГО для администратора'. ";
		ПолучитьВМдляСхемы_ОСАГО_Фикс_Администратор(ОП, Параметры.ИнфоКВМ, ВознаграждениеМенеджера);
	ИначеЕсли НЕ СхемаРасчета.Предопределенный Тогда
		Параметры.ИнфоКВМ = "Фиксированный процент от СКВ";
		ВознаграждениеМенеджера = СхемаРасчета.Показатель * (ОП.Знч("КВСуммаДляАгента") - ОП.Знч("СкидкаВыплаченаяКлиенту")) / 100;
	Иначе	
		Сообщить("Ошибка расчета ВМ (получена неизвестная схема расчета: '" + СхемаРасчета + "').",СтатусСообщения.ОченьВажное);
	КонецЕсли;
	Возврат ВознаграждениеМенеджера;
	
КонецФункции
///////////////////////////////////////////////////////////////////////////
//    процедуры расчета ВМ для различных видов (схем) расчета
///////////////////////////////////////////////////////////////////////////
Функция ПолучитьСтруктуруСтатистики() Экспорт
	
	Статистика = Новый Структура("ЗарплатныйПериод, Агент, ВидСП, ОП, Заявка");	
	Статистика.Вставить("ВсегоОплат",						0);
	Статистика.Вставить("ОплатДоПереданной",				0); 
	Статистика.Вставить("НовыхПолисовВсего",				0);
	Статистика.Вставить("НовыхПолисовДоПереданной",			0);
	Статистика.Вставить("НомерПереданнойОплаты",			0);	
	Статистика.Вставить("ПереданаТекущая",					Ложь);
	Статистика.Вставить("ПереданнаяНовая",					Ложь);
	Статистика.Вставить("СуммПрибыль",						0);
	Статистика.Вставить("СредПрибыль",						0);
	Статистика.Вставить("СуммПрибыль3",						0);
	Статистика.Вставить("СредПрибыль3",						0);
	Статистика.Вставить("СуммНачисленнаяПремия",			0);
	Статистика.Вставить("СредНачисленнаяПремия",			0);
	Статистика.Вставить("СуммОплаченоФакт",					0);
	Статистика.Вставить("СредОплаченоФакт",					0);
	Статистика.Вставить("СуммАВилиСкидкаСумма",				0);
	Статистика.Вставить("СредАВилиСкидкаСумма",				0);
	Статистика.Вставить("СредАВилиСкидкаПроцент",			0);
	Статистика.Вставить("СредАВилиСкидкаПроцентПоСуммам",	0);
	Статистика.Вставить("СуммПолнаяПремия",					0);
	Статистика.Вставить("СредПолнаяПремия",					0);
	Статистика.Вставить("СуммСтраховаяСумма",				0);
	Статистика.Вставить("СредСтраховаяСумма",				0);
	Статистика.Вставить("СуммКВСумма",						0);
	Статистика.Вставить("СредКВСумма",						0);
	Статистика.Вставить("СредКВПроцент",					0);
	Статистика.Вставить("СредКВПроцентПоСуммам",			0);
	Статистика.Вставить("СуммКВСумма3",						0);
	Статистика.Вставить("СредКВСумма3",						0);
	Статистика.Вставить("СредКВПроцент3",					0);
	Статистика.Вставить("СуммДоходБрокера",					0);
	Статистика.Вставить("СредДоходБрокера",					0);
	Возврат Статистика;
	
КонецФункции

//Получает статистику по оплатам за месяц по Агенту (не включая Личные страховки)
// Если указан вид страховых продуктов, то берется статистика по нему
// Если не указан - то по всем страховкам
// Если передан менеджер записи оплаты (ОП), то эта оплата не будет включена
// в статистику
//
// Если Агент не указан, то берется статистика по всем агентам
// Если Зарплатный Период не указан, то берется текущий месяц
// 
// Результат:
//
// КоличествоВсего - общее количество оплат за период
// КоличествоНовых - количество первичных оплат (полных или первых взносов)
// СредняяПрибыльНаСтраховкуПоКВминус3Процента (расчет ведется по КВ брокера - 3%)
//
Процедура ПолучитьСтатистикуПоКорпоративнымОплатамЗаМесяц(Статистика) Экспорт
	
	ОП = Статистика.ОП;
	кРасчетПоАВ = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ;	 
	Если ОП <> Неопределено Тогда
		Если ТипЗнч(ОП.СтраховойПолис.НомерЗаявки) = Тип("Число") И ОП.ВидРасчетаСАгентом <> кРасчетПоАВ Тогда
			Статистика.ЗарплатныйПериод = ОП.ЗарплатныйПериод;
			Статистика.Агент 			= ОП.Агент;
			Статистика.ПереданаТекущая 	= Истина;
			Статистика.ПереданнаяНовая 	= ОП.НомерВзноса = 1;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Статистика.ЗарплатныйПериод) Тогда
		Статистика.ЗарплатныйПериод = ТекущаяДата();	
	КонецЕсли;
	ДатаНачала = НачалоМесяца(Статистика.ЗарплатныйПериод);
	ДатаКонца = КонецМесяца(Статистика.ЗарплатныйПериод);
	Запрос = Новый Запрос;
	Если Статистика.ПереданаТекущая Тогда
		ВставкаПереданнойОплаты = "
		|ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ ПЕРВЫЕ 1
		|		&Дата,
		|		&Агент,
		|		&СтраховойПродуктВид,
		|		&СК,
		|		&Номер,
		|		&Ссылка,
		|		&НомерВзноса,
		//|		&ФормаОплаты,
		|		&НомерЗаявки,
		|		&ВидУчетаСтраховки,
		|		ВЫБОР
		|			КОГДА &ВидУчетаСтраховки = &Первичная
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Первичная,
		|		ВЫБОР
		|			КОГДА &ВидУчетаСтраховки = &Пролонгация
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Пролонгация,
		|		ВЫБОР
		|			КОГДА &ВидУчетаСтраховки = &Вторичная
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Вторичная,
		|		ВЫБОР
		|			КОГДА &ВидУчетаСтраховки = &Рекомендация
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Рекомендация,
		|		&ВидРасчетаСАгентом,
		|		ВЫБОР
		|			КОГДА &НомерВзноса = 1
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		0,
		|		0,
		|		1,
		|		&СтраховаяСумма,
		|		&СтраховаяПремия,
		|		&НачисленнаяСуммаВзноса,
		|		&ОплаченоФакт,
		|		&АВилиСкидкаСумма,
		|		&АВилиСкидкаПроцент,
		|		&КВПроцент,
		|		&КВПроцент - 3,
		|		&КВСумма,
		|		&НачисленнаяСуммаВзноса * (&КВПроцент - 3) / 100,
		|		&КВСумма - &АВилиСкидкаСумма,
		|		&НачисленнаяСуммаВзноса * (&КВПроцент - 3) / 100 - &АВилиСкидкаСумма
		|	ИЗ
		|		Документ.уб_ОплатаПолисов КАК ОП2";				   
		Запрос.УстановитьПараметр("Дата", 					ОП.Дата);
		Запрос.УстановитьПараметр("Агент", 					ОП.Агент);
		Запрос.УстановитьПараметр("СтраховойПродуктВид", 	ОП.ВидСП);
		Запрос.УстановитьПараметр("СК", 					ОП.СтраховойПолис.СК);
		Запрос.УстановитьПараметр("Номер", 					ОП.Номер);
		Запрос.УстановитьПараметр("Ссылка", 				ОП.Ссылка);
		Запрос.УстановитьПараметр("НомерВзноса", 			ОП.НомерВзноса);
		//Запрос.УстановитьПараметр("ФормаОплаты", 			ОП.ФормаОплаты);
		Запрос.УстановитьПараметр("НомерЗаявки", 			ОП.СтраховойПолис.НомерЗаявки);
		Запрос.УстановитьПараметр("ВидУчетаСтраховки", 		ОП.СтраховойПолис.ВидУчетаСтраховки);
		Запрос.УстановитьПараметр("ВидРасчетаСАгентом", 	ОП.ВидРасчетаСАгентом);
		Запрос.УстановитьПараметр("СтраховаяСумма", 		ОП.СтраховойПолис.СтраховаяСумма);
		Запрос.УстановитьПараметр("СтраховаяПремия", 		ОП.СтраховойПолис.СтраховаяПремия);
		Запрос.УстановитьПараметр("НачисленнаяСуммаВзноса", ОП.НачисленнаяСуммаВзноса);
		Запрос.УстановитьПараметр("ОплаченоФакт", 			ОП.ОплаченоФакт);
		Запрос.УстановитьПараметр("АВилиСкидкаСумма", 		ОП.АВилиСкидкаСумма);
		Запрос.УстановитьПараметр("АВилиСкидкаПроцент", 	ОП.АВилиСкидкаПроцент);
		Запрос.УстановитьПараметр("КВПроцент", 				ОП.КВПроцент);
		Запрос.УстановитьПараметр("КВСумма", 				ОП.КВСумма);
	Иначе
		Запрос.УстановитьПараметр("Дата", ДатаКонца);
	КонецЕсли;	
	УслГде = "";
	Если Статистика.Заявка = 1 Тогда
		УслГде = " И НЕ ОП.СтраховойПолис.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок";
	ИначеЕсли Статистика.Заявка = 2 Тогда 	
		УслГде = " И ОП.СтраховойПолис.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок";
	КонецЕсли;
	//прибыль рассчитывалась так:
	//|		ВЫБОР
	//|			КОГДА ОП.АВилиСкидкаСумма < ОП.КВСумма
	//|				ТОГДА ОП.КВСумма - ОП.АВилиСкидкаСумма
	//|			ИНАЧЕ 0
	//|		КОНЕЦ КАК Прибыль,
	ТекстЗапроса = "
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОП.Дата КАК Дата,
	|		ОП.Агент КАК Агент,
	|		ОП.ВидСП КАК ВидСП,
	|		ОП.СтраховойПолис.СК КАК СК,
	|		ОП.Номер,
	|		ОП.Ссылка,
	|		ОП.НомерВзноса КАК НомерВзноса,
	//|		ОП.ФормаОплаты КАК ФормаОплаты,
	|		ОП.СтраховойПолис.НомерЗаявки КАК НомерЗаявки,
	|		ОП.СтраховойПолис.ВидУчетаСтраховки КАК ВидУчетаСтраховки,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Первичная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Первичная,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Пролонгация
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Пролонгация,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Вторичная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Вторичная,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Рекомендация
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Рекомендация,
	|		ОП.ВидРасчетаСАгентом КАК ВидРасчетаСАгентом,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Новая,
	|		ВЫБОР
	|			КОГДА ОП.Дата <= &Дата
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОплатаДоПереданной,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|					И ОП.Дата <= &Дата
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НоваяОплатаДоПереданной,
	|		1 КАК ЭтоОплата,
	|		ОП.СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма,
	|		ОП.СтраховойПолис.СтраховаяПремия КАК СтраховаяПремия,
	|		ОП.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
	|		ОП.ОплаченоФакт КАК ОплаченоФакт,
	|		ОП.АВилиСкидкаСумма КАК АВилиСкидкаСумма,
	|		ОП.АВилиСкидкаПроцент КАК АВилиСкидкаПроцент,
	|		ОП.КВПроцент КАК КВПроцент,
	|		ОП.КВПроцент - 3 КАК КВПроцент3,
	|		ОП.КВСумма КАК КВСумма,
	|		ОП.НачисленнаяСуммаВзноса * (ОП.КВПроцент - 3) / 100 КАК КВСумма3,
	|		ВЫБОР
	|			КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|				КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|					ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|				ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|			КОНЕЦ - ОП.КВСумма
	|				ТОГДА 0
	|			ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|				КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|					ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|				ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|			КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|		КОНЕЦ КАК Прибыль,		
	|		ОП.НачисленнаяСуммаВзноса * (ОП.КВПроцент - 3) / 100 - ОП.АВилиСкидкаСумма КАК Прибыль3
	|	ИЗ
	|		Документ.уб_ОплатаПолисов КАК ОП
	|	ГДЕ НЕ ОП.ПометкаУдаления И
	|		ОП.ЗарплатныйПериод >= &ДатаНачала
	|		И ОП.ЗарплатныйПериод <= &ДатаКонца
	|		И ОП.ВидРасчетаСАгентом <> &РасчетПоАВ
	//|      И ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
	|		"+УслГде+"
	|";
	Запрос.УстановитьПараметр("ДатаНачала", 	ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", 		ДатаКонца);
	Запрос.УстановитьПараметр("РасчетПоАВ", 	кРасчетПоАВ);
	Запрос.УстановитьПараметр("Первичная", 		Перечисления.уб_ВидыУчетаСтраховок.Первичная);
	Запрос.УстановитьПараметр("Пролонгация", 	Перечисления.уб_ВидыУчетаСтраховок.Пролонгация);
	Запрос.УстановитьПараметр("Вторичная", 		Перечисления.уб_ВидыУчетаСтраховок.Вторичная);
	Запрос.УстановитьПараметр("Рекомендация", 	Перечисления.уб_ВидыУчетаСтраховок.Рекомендация);
	Если ЗначениеЗаполнено(Статистика.Агент) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Агент = &Агент";
		Запрос.УстановитьПараметр("Агент", Статистика.Агент);
	КонецЕсли;
	Если ОП <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса +  " И ОП.Номер <> &НомерОП";
		Запрос.УстановитьПараметр("НомерОП", Статистика.ОП.Номер);
	КонецЕсли;
	Если Статистика.ВидСП <> Неопределено И Статистика.ВидСП <> Перечисления.уб_ВидыСтраховыхПродуктов.ПустаяСсылка() Тогда
		ТекстЗапроса = ТекстЗапроса + " И ОП.ВидСП = &ВидСП";
		Запрос.УстановитьПараметр("ВидСП", Статистика.ВидСП);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|	" + ВставкаПереданнойОплаты + "
	|
	|	) КАК Т ";
	НачалоЗапроса = "ВЫБРАТЬ
	|	СУММА(Т.ЭтоОплата) КАК ВсегоОплат,
	|	СУММА(Т.Новая) КАК НовыхПолисов,
	|
	|	СУММА(Т.ОплатаДоПереданной) КАК ОплатДоПереданной,
	|	СУММА(Т.НоваяОплатаДоПереданной) КАК НовыхПолисовДоПереданной,
	|
	|	СУММА(Т.Первичная) КАК Первичных,
	|	СУММА(Т.Пролонгация) КАК Пролонгаций,
	|	СУММА(Т.Вторичная) КАК Вторичных,
	|	СУММА(Т.Рекомендация) КАК Рекомендаций,
	|
	|	СУММА(Т.СтраховаяСумма) КАК СтраховаяСумма,
	|	СУММА(Т.СтраховаяПремия) КАК СтраховаяПремия,
	|	СУММА(Т.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
	|	СУММА(Т.ОплаченоФакт) КАК ОплаченоФакт,
	|	СУММА(Т.АВилиСкидкаСумма) КАК АВилиСкидкаСумма,
	|	СУММА(Т.КВПроцент) КАК КВПроцент,
	|	СУММА(Т.КВПроцент3) КАК КВПроцент3,
	|	СУММА(Т.КВСумма) КАК КВСумма,
	|	СУММА(Т.КВСумма3) КАК КВСумма3,
	|	СУММА(Т.Прибыль) КАК Прибыль,
	|	СУММА(Т.Прибыль3) КАК Прибыль3,
	|	СРЕДНЕЕ(Т.СтраховаяСумма) КАК СрСтраховаяСумма,
	|	СРЕДНЕЕ(Т.СтраховаяПремия) КАК СрСтраховаяПремия,
	|	СРЕДНЕЕ(Т.НачисленнаяСуммаВзноса) КАК СрНачисленнаяСуммаВзноса,
	|	СРЕДНЕЕ(Т.ОплаченоФакт) КАК СрОплаченоФакт,
	|	СРЕДНЕЕ(Т.АВилиСкидкаСумма) КАК СрАВилиСкидкаСумма,
	|	СРЕДНЕЕ(Т.АВилиСкидкаПроцент) КАК СрАВилиСкидкаПроцент,
	|	СРЕДНЕЕ(Т.КВПроцент) КАК СрКВПроцент,
	|	СРЕДНЕЕ(Т.КВПроцент3) КАК СрКВПроцент3,
	|	СРЕДНЕЕ(Т.КВСумма) КАК СрКВСумма,
	|	СРЕДНЕЕ(Т.КВСумма3) КАК СрКВСумма3,
	|	СРЕДНЕЕ(Т.Прибыль) КАК СрПрибыль,
	|	СРЕДНЕЕ(Т.Прибыль3) КАК СрПрибыль3
	|	 ";		 
	/////  Проверочный запрос  ////////
	//Запрос.Текст = "ВЫБРАТЬ Т.* " + ТекстЗапроса;
	//Результат = Запрос.Выполнить();
	//ТЗЗ = Результат.Выгрузить();
	///////////////////////////////////
	Запрос.Текст = НачалоЗапроса + ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ВсегоОплат = Null Тогда
		Возврат;	
	КонецЕсли;
	Статистика.Вставить("ВсегоОплат",				Выборка.ВсегоОплат);
	Статистика.Вставить("ОплатДоПереданной",		Выборка.ОплатДоПереданной); 
	Статистика.Вставить("НовыхПолисовВсего",		Выборка.НовыхПолисов);
	Статистика.Вставить("НовыхПолисовДоПереданной",	Выборка.НовыхПолисовДоПереданной);
	Статистика.Вставить("НомерПереданнойОплаты",	Выборка.ОплатДоПереданной + 1);
	Статистика.Вставить("Первичных",				Выборка.Первичных);
	Статистика.Вставить("Пролонгаций",				Выборка.Пролонгаций);
	Статистика.Вставить("Вторичных",				Выборка.Вторичных);
	Статистика.Вставить("Рекомендаций",				Выборка.Рекомендаций);
	Статистика.Вставить("СуммПрибыль",				Окр(Выборка.Прибыль, 2));
	Статистика.Вставить("СредПрибыль",				Окр(Выборка.СрПрибыль, 2));
	Статистика.Вставить("СуммПрибыль3",				Окр(Выборка.Прибыль3, 2));
	Статистика.Вставить("СредПрибыль3",				Окр(Выборка.СрПрибыль3, 2));
	Статистика.Вставить("СуммНачисленнаяПремия",	Окр(Выборка.НачисленнаяСуммаВзноса, 2));
	Статистика.Вставить("СредНачисленнаяПремия",	Окр(Выборка.СрНачисленнаяСуммаВзноса, 2));
	Статистика.Вставить("СуммОплаченоФакт",			Окр(Выборка.ОплаченоФакт, 2));
	Статистика.Вставить("СредОплаченоФакт",			Окр(Выборка.СрОплаченоФакт, 2));
	Статистика.Вставить("СуммАВилиСкидкаСумма",		Окр(Выборка.АВилиСкидкаСумма, 2));
	Статистика.Вставить("СредАВилиСкидкаСумма",		Окр(Выборка.СрАВилиСкидкаСумма, 2));
	Статистика.Вставить("СредАВилиСкидкаПроцент",	Окр(Выборка.СрАВилиСкидкаПроцент,2));
	Статистика.Вставить("СуммПолнаяПремия",			Окр(Выборка.СтраховаяПремия, 2));
	Статистика.Вставить("СредПолнаяПремия",			Окр(Выборка.СрСтраховаяПремия, 2));
	Статистика.Вставить("СуммСтраховаяСумма",		Окр(Выборка.СтраховаяСумма, 2));
	Статистика.Вставить("СредСтраховаяСумма",		Окр(Выборка.СрСтраховаяСумма, 2));
	Статистика.Вставить("СуммКВСумма",				Окр(Выборка.КВСумма, 2));
	Статистика.Вставить("СредКВСумма",				Окр(Выборка.СрКВСумма, 2));
	Статистика.Вставить("СредКВПроцент",			Окр(Выборка.СрКВПроцент, 2));
	Если Выборка.НачисленнаяСуммаВзноса <> 0 Тогда
		Статистика.Вставить("СредАВилиСкидкаПроцентПоСуммам",	Окр(Выборка.АВилиСкидкаСумма / Выборка.НачисленнаяСуммаВзноса * 100, 2));
		Статистика.Вставить("СредКВПроцентПоСуммам",			Окр(Выборка.КВСумма / Выборка.НачисленнаяСуммаВзноса * 100, 2));
	КонецЕсли;
	Статистика.Вставить("СуммКВСумма3", 	Окр(Выборка.КВСумма3, 2));
	Статистика.Вставить("СредКВСумма3", 	Окр(Выборка.СрКВСумма3, 2));
	Статистика.Вставить("СредКВПроцент3",	Окр(Выборка.СрКВПроцент3, 2));
	
КонецПроцедуры

Функция ПолучитьСтрокуСтатистикиПоКАСКО(Стат)
	
	ИнфоСтат = "Статистика" + ?(ЗначениеНеЗаполнено(Стат.Агент),""," Агента " + Стат.Агент) 
	+ " по корпоративным страховкам КАСКО
	|за отчетный период """	+ Формат(Стат.ЗарплатныйПериод,"ДФ='ММMM yyyy'") + """:
	|
	|	Текущая оплата № " + Стат.НомерПереданнойОплаты + ", " + (?(Стат.ПереданнаяНовая,"первичная № " + (Стат.НовыхПолисовДоПереданной + 1),"вторичная")) + "
	|	Всего оплат: " + Стат.ВсегоОплат + ", из них первичных: " + Стат.НовыхПолисовВсего + "
	|	Средняя прибыль: " + Стат.СредПрибыль3;	
	Если Не уб_КЭШируемые.ДоступностьРоли("уб_МенеджерНаТочке") Тогда
		ИнфоСтат = ИнфоСтат + "
		|	Ср. прибыль (полое КВ): " + Стат.СредПрибыль + "
		|	Сумма по КВ брокера: " + Стат.СуммКВСумма + "
		|	Ср. сумма КВ брокера: " + Стат.СредКВСумма + "
		|	Ср. % КВ брокера: " + Стат.СредКВПроцент;
		Если Стат.СуммНачисленнаяПремия = 0 Тогда
			КвС = 0;
		Иначе
			КвС = Окр((Стат.СуммКВСумма / Стат.СуммНачисленнаяПремия * 100),2);
		КонецЕсли;
		ИнфоСтат = ИнфоСтат + "
		|	Ср. % КВ брокера (по суммам): " + КвС + "%
		|	Сумма начисленных премий: " + Стат.СуммНачисленнаяПремия + "
		|	Ср. начисленная премия: " + Стат.СредНачисленнаяПремия + "
		|	Ср. страховая сумма: " + Стат.СредСтраховаяСумма
		//|	Доход брокера: " + Стат.СуммДоходБрокера
		//|	Доход брокера на 1 оплату: " + Стат.СредДоходБрокера
		+ "";
	КонецЕсли;	
	Возврат ИнфоСтат;
	
КонецФункции

Функция ПроверитьПревышениеСуперПлана_ПоКоличествуНовыхКАСКО(ОП, ЗарплатныйПериод, Агент, ВидСП, ДоляОплатыОтПолнойПремии, ВознаграждениеМенеджера, Инфо, Стат = Неопределено)
	
	Ф = "ЧН=0; ЧГ=";	
	Если Стат = Неопределено Тогда
		Стат = ПолучитьСтруктуруСтатистики();
		Стат.ЗарплатныйПериод = ЗарплатныйПериод; 
		Стат.Агент = Агент; 
		Стат.ВидСП = ВидСП; 
		Стат.ОП = ОП.Знч("Ссылка"); 
		ПолучитьСтатистикуПоКорпоративнымОплатамЗаМесяц(Стат);	
	КонецЕсли;
	МаксКолКАСКО = 20;
	Если Стат.НовыхПолисовДоПереданной >= МаксКолКАСКО И ОП.Знч("НомерВзноса") = 1 Тогда
		Инфо = Инфо + "
		|Новая страховка № " + (Стат.НовыхПолисовДоПереданной + 1) + ".
		|Среднестатистическая прибыль на оплату по КАСКО за месяц: " + Формат(Стат.СредПрибыль3,Ф) + "р.";
		СреднестатистическаяПрибыль = Окр(Стат.СредПрибыль3 * ДоляОплатыОтПолнойПремии,2);
		Если ДоляОплатыОтПолнойПремии < 1 Тогда
			Инфо = Инфо + "
			|Доля оплаты от полной премии: ДО=" +  Строка(Окр(ДоляОплатыОтПолнойПремии*100,1)) + "%
			|Пропорциональная среднестатистическая премия на данную оплату = ДО*" 
			+ Формат(Стат.СредПрибыль3,Ф) + "р. = " 
			+ Формат(СреднестатистическаяПрибыль,Ф) + "р. 
			|";
		КонецЕсли;
		//Расчитываем фактическую прибыль со страховки (по КВ минус 3%)		
		ФактическаяПрибыльПоКВминус3Процента = ОП.Знч("НачисленнаяСуммаВзноса") * (ОП.Знч("КВПроцент") - 3) / 100 - ОП.Знч("АВилиСкидкаСумма");
		Инфо = Инфо + "
		|Фактическая прибыль по оплате = [Начисленная Сумма Взноса]*[КВ-3%]-[Скидка] = " 
		+ Формат(ОП.Знч("НачисленнаяСуммаВзноса"),Ф) + "р*" + (ОП.КВПроцент - 3) + "%-" 
		+ Формат(ОП.Знч("АВилиСкидкаСумма"),Ф) + "р = " + Формат(ФактическаяПрибыльПоКВминус3Процента,Ф) + "р.";
		Если ФактическаяПрибыльПоКВминус3Процента <= СреднестатистическаяПрибыль Тогда
			ВознаграждениеМенеджера = ФактическаяПрибыльПоКВминус3Процента;
			Инфо = Инфо + "
			|ВМ = " + Формат(ФактическаяПрибыльПоКВминус3Процента,Ф) + "р.";
		Иначе
			ВознаграждениеМенеджера = СреднестатистическаяПрибыль;
			Инфо = Инфо + "
			|По данной схеме расчета ВМ не превышает среднестатистическую прибыль за месяц.
			|ВМ = " + Формат(СреднестатистическаяПрибыль,Ф) + "р.";
		КонецЕсли;		
		ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера);	
		Возврат Истина;	
	КонецЕсли;
	Возврат Ложь;	
	
КонецФункции

Процедура ДобавитьВычетСАгента(ОП, Инфо, ВознаграждениеМенеджера)
	
	_Дата = ОП.Знч("Дата");
	_ВычетСАгента = ОП.Знч("ВычетСАгента");
	Если (_Дата>=Дата(2013,1,1) И _ВычетСАгента <> 0) //Возможность уменьшить компенсаацию агента при отрицательном вычете
		ИЛИ (_Дата<Дата(2013,1,1) И _ВычетСАгента > 0)//При отрицательном вычете не учитывается
		Тогда
		ВознаграждениеМенеджера = ВознаграждениеМенеджера - _ВычетСАгента;
		Инфо = Инфо + "
		|
		|С учетом вычета с агента, ВМ = " 	
		+ Формат(ВознаграждениеМенеджера,"ЧН=0; ЧГ=") + "р.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтатистикуПоКорпоративнымОплатамКАСКОЗаМесяц(ОП, Инфо, Стат = Неопределено)
	
	Если Стат = Неопределено Тогда
		Стат = ПолучитьСтруктуруСтатистики();
		Стат.ЗарплатныйПериод = ОП.Знч("ЗарплатныйПериод"); 
		Стат.Агент = ОП.Знч("Агент"); 
		Стат.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО; 
		ПолучитьСтатистикуПоКорпоративнымОплатамЗаМесяц(Стат);
	КонецЕсли;
	Инфо = Инфо + "
	|
	|" + ПолучитьСтрокуСтатистикиПоКАСКО(Стат);
	
КонецПроцедуры

Функция ДайДолюОтПолнойПремии(ОП)
	
	Если ОП.ПолнаяСтраховаяПремия = 0 Тогда
		Сообщить("Полная премия равна 0 в оплате : " + ОП.Номер, СтатусСообщения.ОченьВажное);	
		Возврат 1;
	Иначе	
		Возврат Окр(Мин(1 ,ОП.НачисленнаяСуммаВзносаВВалюте / ОП.ПолнаяСтраховаяПремия), 2);
	КонецЕсли;
	
КонецФункции

