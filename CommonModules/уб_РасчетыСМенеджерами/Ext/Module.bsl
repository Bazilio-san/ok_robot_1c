	Структура.Вставить("УИДГруппыКвитовки",							Неопределено);
	Структура.Вставить("ДанныеПоЗПМенеджерам",						Неопределено);
	Структура.Вставить("УстанавливатьКВДляАгента",					Истина);
	Структура.Вставить("ПеречитатьПоказателиГруппыВзаиморасчетов",	Ложь);
	Структура.Вставить("ПересчетВМ",								Истина);
	Структура.Вставить("РасчетРазницПоАВПослеСтрахователя",			Ложь);
	СтруктураРасчетныхПолей = Новый Структура;
	СтруктураРасчетныхПолей.Вставить("ВКассу");
	СтруктураРасчетныхПолей.Вставить("бЗаблокирована");
	СтруктураРасчетныхПолей.Вставить("СистемаНаправлениеПлатежа");
	СтруктураРасчетныхПолей.Вставить("СуммаВзносаДляРасчетов");
	СтруктураРасчетныхПолей.Вставить("бФорма");
	СтруктураРасчетныхПолей.Вставить("РасчетПоАВ");
	СтруктураРасчетныхПолей.Вставить("ЭФ");
	СтруктураРасчетныхПолей.Вставить("ЭтоФорма");
	СтруктураРасчетныхПолей.Вставить("бОплаченоВБрокер");
	СтруктураРасчетныхПолей.Вставить("бЕстьОП");
	Структура.Вставить("РасчетныеПоля", СтруктураРасчетныхПолей);
	Возврат Структура;
	
КонецФункции // СтруктураПараметровОППересчетСуммПоУмолчанию()

