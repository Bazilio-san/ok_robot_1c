Функция уб_ОКР(Значение,Знач Разрядность,Режим=Неопределено) Экспорт
	
	//взводится излишняя модифицированность
	//Режим = ?(ЗначениеЗаполнено(Режим), Режим, Перечисления.уб_РежимОкругления.Окр15как20);
	Если Не ЗначениеЗаполнено(Режим) Тогда
		Режим = Перечисления.уб_РежимОкругления.Окр15как20;
	КонецЕсли;
	Если Режим = Перечисления.уб_РежимОкругления.Отсечение Тогда
		//Отсечение
		Дельта =  pow(0.1,Разрядность+1)*5;
		Результат = Окр(Значение-Дельта,Разрядность,РежимОкругления.Окр15как20);
	ИначеЕсли Режим = Перечисления.уб_РежимОкругления.Вбольшую Тогда
		//В большую
		Результат = уб_Взаиморасчеты.ОкруглитьДоПорядка(Значение,pow(0.1,Разрядность),Истина);	
	Иначе
		Результат = Окр(Значение, Разрядность,?(Режим = Перечисления.уб_РежимОкругления.Окр15как20,РежимОкругления.Окр15как20,РежимОкругления.Окр15как10));
	КонецЕсли;	
	Возврат Результат;
	
КонецФункции	

//Исключена - исключена из расчета зп по различным причинам
Функция ПолучитьСКВ(Данные, Знач ТипРезультата = "стр", Параметры = Неопределено, ПоКрупнымСделкам = ЛОЖЬ) Экспорт

	Параметры = Новый Структура("СКВ, СКВДляАгента, СКВДляОтчета, ЭтоКрупнаяСделка, Исключена", 0, 0, 0, Ложь, Ложь);
	ТипЗнчДанные = ТипЗнч(Данные);
	ТипРезультата = СокрЛП(НРег(ТипРезультата));
	
	ЗапросСКВ = Новый Запрос;
	КоэффициентСКВ =  (100-Данные.ПроцентСКВ)/100;
	ЗапросСКВ.УстановитьПараметр("КоэффициентСКВ",КоэффициентСКВ);
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСумма > (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	|						ТОГДА ОП.КВСумма - (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт > 0
	|						И ОП.КВСумма > ОП.АВилиСкидкаСумма
	|					ТОГДА ОП.КВСумма - ОП.АВилиСкидкаСумма
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ*&КоэффициентСКВ КАК СКВ,
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСумма > (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	|						ТОГДА ОП.КВСумма - (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт > 0
	|						И (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания) > ОП.АВилиСкидкаСумма
	|					ТОГДА (ОП.КВСуммаДляАгента-ОП.КВСуммаУдержания) - ОП.АВилиСкидкаСумма
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ*&КоэффициентСКВ КАК СКВДляАгента,
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСуммаДляОтчета > ОП.КВСуммаДляАгента
	|						ТОГДА ОП.КВСуммаДляОтчета - ОП.КВСуммаДляАгента
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт > 0
	|						И ОП.КВСуммаДляОтчета > ОП.АВилиСкидкаСумма
	|					ТОГДА ОП.КВСуммаДляОтчета - ОП.АВилиСкидкаСумма
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СКВДляОтчета,
	|	ОП.ЗарплатныйПериод,
	|	ОП.Агент,
	|	ОП.СтраховойПолис,
	|	ОП.КВСумма,
	|	ОП.ЭтоКрупнаяСделка,
	|	ОП.ИсключитьИзРасчетаЗП,
	|	ОП.ПометкаУдаления
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&ИсточникДанных КАК ОП
	|ГДЕ
	|	ОП.Ссылка = &Ссылка";
	Если ПоКрупнымСделкам Тогда
		ТекстДопЗапроса = 
		"ВЫБРАТЬ
		|	ВТ_Данные.СКВ,
		|	ВТ_Данные.СКВДляАгента,
		|	ВТ_Данные.СКВДляОтчета,
		|	ВТ_Данные.ЗарплатныйПериод,
		|	ВТ_Данные.Агент,
		|	ВТ_Данные.СтраховойПолис,
		|	ВТ_СП.Страхователь КАК Страхователь,
		|	ВТ_Данные.КВСумма,
		|	ВТ_Данные.ЭтоКрупнаяСделка,
		|	ВЫБОР
		|		КОГДА ВТ_Данные.ИсключитьИзРасчетаЗП
		|				ИЛИ ВТ_Данные.ПометкаУдаления
		|				ИЛИ ВТ_СП.Ссылка ЕСТЬ NULL 
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Исключена
		|ПОМЕСТИТЬ ВТ_Оплата
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК ВТ_СП
		|		ПО ВТ_Данные.СтраховойПолис = ВТ_СП.Ссылка
		|			И (НЕ ВТ_СП.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЗП.РазмерКрупнойСделки,
		|	ПРЗП.Период
		|ПОМЕСТИТЬ ВТ_ПРЗП
		|ИЗ
		|	РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних КАК ПРЗП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОП.СтраховойПолис.Страхователь КАК Страхователь,
		|	СУММА(ОП.КВСумма) КАК СуммаКВСумма,
		|	ОП.Агент КАК Агент
		|ПОМЕСТИТЬ АВТО_КС
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК ОП
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПРЗП КАК ВТ_ПРЗП
		|		ПО ОП.ЗарплатныйПериод >= ВТ_ПРЗП.Период
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Оплата КАК ВТ_Оплата
		|		ПО (НЕ ВТ_Оплата.Исключена)
		|			И (НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ВТ_Оплата.ЗарплатныйПериод, МЕСЯЦ))
		|			И ОП.Агент = ВТ_Оплата.Агент
		|			И ОП.СтраховойПолис.Страхователь = ВТ_Оплата.Страхователь
		|			И (НЕ ВТ_Оплата.ЭтоКрупнаяСделка)
		|ГДЕ
		|	НЕ ОП.ИсключитьИзРасчетаЗП
		|	И НЕ ОП.ПометкаУдаления
		|	И НЕ ОП.СтраховойПолис = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
		|	И НЕ ОП.СтраховойПолис.ПометкаУдаления
		|	И НЕ ОП.СтраховойПолис.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок
		|
		|СГРУППИРОВАТЬ ПО
		|	ОП.СтраховойПолис.Страхователь,
		|	ВТ_ПРЗП.РазмерКрупнойСделки,
		|	ОП.Агент
		|
		|ИМЕЮЩИЕ
		|	СУММА(ОП.КВСумма) > ЕСТЬNULL(ВТ_ПРЗП.РазмерКрупнойСделки, 41900)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ПРЗП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Оплата.СКВ КАК СКВ,
		|	ВЫБОР
		|		КОГДА АВТО_КС.Страхователь ЕСТЬ NULL 
		|				И НЕ ВТ_Оплата.ЭтоКрупнаяСделка
		|				И НЕ ВТ_Оплата.Исключена
		|			ТОГДА ВТ_Оплата.СКВДляАгента
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СКВДляАгента,
		|	ВТ_Оплата.СКВДляОтчета КАК СКВДляОтчета,
		|	АВТО_КС.Страхователь КАК Страхователь,
		|	АВТО_КС.СуммаКВСумма КАК СуммаКВСумма,
		|	ВЫБОР
		|		КОГДА АВТО_КС.Страхователь ЕСТЬ NULL 
		|				И НЕ ВТ_Оплата.ЭтоКрупнаяСделка
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЭтоКрупнаяСделка
		|ИЗ
		|	ВТ_Оплата КАК ВТ_Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ АВТО_КС КАК АВТО_КС
		|		ПО (ВТ_Оплата.ЗарплатныйПериод >= ДАТАВРЕМЯ(2012, 10, 1, 0, 0, 0))";
	Иначе
		//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_Данные", "");
		ТекстДопЗапроса =
		"ВЫБРАТЬ
		|	ВТ_Данные.СКВ,
		|	ВТ_Данные.СКВДляОтчета,
		|	ВЫБОР
		|		КОГДА ВТ_Данные.ИсключитьИзРасчетаЗП
		|				ИЛИ ВТ_Данные.ПометкаУдаления
		|				ИЛИ ВТ_СП.Ссылка ЕСТЬ NULL 
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Данные.СКВДляАгента
		|	КОНЕЦ КАК СКВДляАгента
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК ВТ_СП
		|		ПО ВТ_Данные.СтраховойПолис = ВТ_СП.Ссылка
		|			И (НЕ ВТ_СП.ПометкаУдаления)";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + ТекстДопЗапроса;
	ЗапросСКВ.УстановитьПараметр("Ссылка", Данные.Ссылка);
	Если ТипЗнчДанные = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникДанных", "Документ.уб_ОплатаПолисов");
	Иначе
		ОписаниеТиповБулево = ОбщегоНазначения.ПолучитьОписаниеТиповБулево();
		ОписаничеЧисла	= ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 2);
		
		ИсточникДанных = Новый ТаблицаЗначений;
		ИсточникДанных.Колонки.Добавить("Ссылка",											уб_temp.СозданиеОписанияТиповПоТипу(Тип("ДокументСсылка.уб_ОплатаПолисов")));
		ИсточникДанных.Колонки.Добавить("ОплаченоФакт",										ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("СкидкаВыплаченаяКлиенту",							ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("НачисленнаяСуммаВзноса",							ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику",	ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("КВСумма",											ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 4));
		ИсточникДанных.Колонки.Добавить("КВСуммаДляАгента",									ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 4));
		ИсточникДанных.Колонки.Добавить("КВСуммаУдержания",									ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 4));
		ИсточникДанных.Колонки.Добавить("КВСуммаДляОтчета",									ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("АВилиСкидкаСумма",									ОписаничеЧисла);
		ИсточникДанных.Колонки.Добавить("ЗарплатныйПериод",									ОбщегоНазначения.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
		ИсточникДанных.Колонки.Добавить("СтраховойПолис",									уб_temp.СозданиеОписанияТиповПоТипу(Тип("ДокументСсылка.уб_СтраховойПолис")));
		ИсточникДанных.Колонки.Добавить("ИсключитьИзРасчетаЗП",								ОписаниеТиповБулево);
		ИсточникДанных.Колонки.Добавить("ПометкаУдаления",									ОписаниеТиповБулево);
		ИсточникДанных.Колонки.Добавить("ЭтоКрупнаяСделка",									ОписаниеТиповБулево);
		ИсточникДанных.Колонки.Добавить("СхемаРасчетаСМенеджером",						  	уб_temp.СозданиеОписанияТиповПоТипу(Тип("ПланВидовРасчетаСсылка.уб_РасчетЗарплатыМенеджерамОП")));

		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Контрагенты"));
		Массив.Добавить(Тип("СправочникСсылка.ФизическиеЛица"));
		Массив.Добавить(Тип("СправочникСсылка.ПодразделенияОрганизаций"));
		ИсточникДанных.Колонки.Добавить("Агент", Новый ОписаниеТипов(Массив));
		СтрокаТЗ = ИсточникДанных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, Данные);
		ЗапросСКВ.УстановитьПараметр("ИсточникДанных", ИсточникДанных); 
	КонецЕсли;
	ЗапросСКВ.Текст = ТекстЗапроса;
	Выборка = ЗапросСКВ.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Параметры, Выборка);
	КонецЕсли;
	//МассивИменКВ = Новый Массив;
	//МассивИменКВ.Добавить("");
	//МассивИменКВ.Добавить("ДляАгента");
	//МассивИменКВ.Добавить("ДляОтчета");
	//Для Каждого ЭлементМассиваИменКВ Из МассивИменКВ Цикл
	//	КлючПараметры = "СКВ" + ЭлементМассиваИменКВ;
	//	КВСумма = Данные["КВСумма" + ЭлементМассиваИменКВ];
	//	СуммаВзносаДляРасчетов = ?(Данные.НачисленнаяСуммаВзноса = 0, Данные.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику, Данные.НачисленнаяСуммаВзноса);
	//	Если Данные.ОплаченоФакт - Данные.СкидкаВыплаченаяКлиенту < СуммаВзносаДляРасчетов - КВСумма Тогда
	//		Параметры[КлючПараметры] = 0;
	//	Иначе
	//		Параметры[КлючПараметры] = Данные.ОплаченоФакт - СуммаВзносаДляРасчетов - Данные.СкидкаВыплаченаяКлиенту + КВСумма;
	//	КонецЕсли;
	//КонецЦикла;
	Если Лев(ТипРезультата, 3) = "стр" Тогда
		Результат = Параметры
	ИначеЕсли Лев(ТипРезультата, 2) = "кс" Тогда
		Результат = Параметры.ЭтоКрупнаяСделка
	ИначеЕсли Параметры.Свойство("СКВ" + ТипРезультата) Тогда
		Результат = Параметры["СКВ" + ТипРезультата]
	Иначе
		Результат = 0;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ПолучитьСКВ()

Функция ПолучитьСКВСтарый(Данные, Знач ТипРезультата = "стр", Параметры = Неопределено, ПоКрупнымСделкам = ЛОЖЬ) Экспорт

	Параметры = Новый Структура("СКВ, СКВДляАгента, СКВДляОтчета, ЭтоКрупнаяСделка, Исключена", 0, 0, 0, Ложь, Ложь);
	ТипЗнчДанные = ТипЗнч(Данные);
	ТипРезультата = СокрЛП(НРег(ТипРезультата));
	ЗапросСКВ = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСумма > ОП.КВСуммаДляАгента
	|						ТОГДА ОП.КВСумма - ОП.КВСуммаДляАгента
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.КВСумма
	|					ТОГДА 0
	|				ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|			КОНЕЦ
	|	КОНЕЦ КАК СКВ,
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСумма > ОП.КВСуммаДляАгента
	|						ТОГДА ОП.КВСумма - ОП.КВСуммаДляАгента
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.КВСуммаДляАгента
	|					ТОГДА 0
	|				ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСуммаДляАгента
	|			КОНЕЦ
	|	КОНЕЦ КАК СКВДляАгента,
	|	ВЫБОР
	|		КОГДА ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)
	|			ТОГДА ВЫБОР
	|					КОГДА ОП.КВСуммаДляОтчета > ОП.КВСуммаДляАгента
	|						ТОГДА ОП.КВСуммаДляОтчета - ОП.КВСуммаДляАгента
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.КВСуммаДляОтчета
	|					ТОГДА 0
	|				ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСуммаДляОтчета
	|			КОНЕЦ
	|	КОНЕЦ КАК СКВДляОтчета,
	|	ОП.ЗарплатныйПериод,
	|	ОП.Агент,
	|	ОП.СтраховойПолис,
	|	ОП.КВСумма,
	|	ОП.ЭтоКрупнаяСделка,
	|	ОП.ИсключитьИзРасчетаЗП,
	|	ОП.ПометкаУдаления
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&ИсточникДанных КАК ОП
	|ГДЕ
	|	ОП.Ссылка = &Ссылка";
	Если ПоКрупнымСделкам Тогда
		ТекстДопЗапроса = 
		"ВЫБРАТЬ
		|	ВТ_Данные.СКВ,
		|	ВТ_Данные.СКВДляАгента,
		|	ВТ_Данные.СКВДляОтчета,
		|	ВТ_Данные.ЗарплатныйПериод,
		|	ВТ_Данные.Агент,
		|	ВТ_Данные.СтраховойПолис,
		|	ВТ_СП.Страхователь КАК Страхователь,
		|	ВТ_Данные.КВСумма,
		|	ВТ_Данные.ЭтоКрупнаяСделка,
		|	ВЫБОР
		|		КОГДА ВТ_Данные.ИсключитьИзРасчетаЗП
		|				ИЛИ ВТ_Данные.ПометкаУдаления
		|				ИЛИ ВТ_СП.Ссылка ЕСТЬ NULL 
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Исключена
		|ПОМЕСТИТЬ ВТ_Оплата
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК ВТ_СП
		|		ПО ВТ_Данные.СтраховойПолис = ВТ_СП.Ссылка
		|			И (НЕ ВТ_СП.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЗП.РазмерКрупнойСделки,
		|	ПРЗП.Период
		|ПОМЕСТИТЬ ВТ_ПРЗП
		|ИЗ
		|	РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних КАК ПРЗП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОП.СтраховойПолис.Страхователь КАК Страхователь,
		|	СУММА(ОП.КВСумма) КАК СуммаКВСумма,
		|	ОП.Агент КАК Агент
		|ПОМЕСТИТЬ АВТО_КС
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК ОП
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПРЗП КАК ВТ_ПРЗП
		|		ПО ОП.ЗарплатныйПериод >= ВТ_ПРЗП.Период
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Оплата КАК ВТ_Оплата
		|		ПО (НЕ ВТ_Оплата.Исключена)
		|			И (НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ВТ_Оплата.ЗарплатныйПериод, МЕСЯЦ))
		|			И ОП.Агент = ВТ_Оплата.Агент
		|			И ОП.СтраховойПолис.Страхователь = ВТ_Оплата.Страхователь
		|			И (НЕ ВТ_Оплата.ЭтоКрупнаяСделка)
		|ГДЕ
		|	НЕ ОП.ИсключитьИзРасчетаЗП
		|	И НЕ ОП.ПометкаУдаления
		|	И НЕ ОП.СтраховойПолис = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
		|	И НЕ ОП.СтраховойПолис.ПометкаУдаления
		|	И НЕ ОП.СтраховойПолис.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок
		|
		|СГРУППИРОВАТЬ ПО
		|	ОП.СтраховойПолис.Страхователь,
		|	ВТ_ПРЗП.РазмерКрупнойСделки,
		|	ОП.Агент
		|
		|ИМЕЮЩИЕ
		|	СУММА(ОП.КВСумма) > ЕСТЬNULL(ВТ_ПРЗП.РазмерКрупнойСделки, 41900)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ПРЗП
		|;
