//т.к. пока не известно, что является признаком утвержденной оплаты - несколько параметров
//ОП - оплата полиса
//1: есть проведенный отчет
//2: есть дата согласования в отчете
//3: есть перечисление поставщику
Функция ОплатаСогласована(ОП, Вариант)
	
	ОтчетПоставщику = ОП.ОтчетПоставщику;
	Если Вариант = 1 Тогда
		Возврат ОтчетПоставщику.Проведен
	КонецЕсли;
	//также с учетом, что он должен быть проведен
	Если Вариант = 2 Тогда
		Результат = ЗначениеЗаполнено(ОтчетПоставщику.ДатаСогласования)
	ИначеЕсли Вариант = 3 Тогда
		//дата согласование у оплаченного может быть незаполнена
		//TODO закэшировать в модуле объекта результат этой функции
		СтруктураБлокировкиОтчета = уб_temp.СтруктураБлокировкиДокумента(ОП.Ссылка);
		//интересует сам факт перечисления средств, права и регистра разблокировки не влияет
		Результат = СтруктураБлокировкиОтчета.ЕстьПеречисление;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // СостояниеСогласованнойОплаты()

//функция установить значение для пересчета сумм с записью лога изменений
Функция УстЗнч(ОП, ИмяПоляДанных, НовоеЗначение, бЗаблокирована, ИгнорироватьБлокировкуОплаты = Ложь,ЕстьОтличия=Ложь)
	
	Попытка
		НачальноеЗначение = ОП.Знч(ИмяПоляДанных);
		ФлЕстьЗнч =Истина;
	Исключение
		НачальноеЗначение = ОП[ИмяПоляДанных];//Например строка ТЧ
		ФлЕстьЗнч = Ложь;
	КонецПопытки;	
	
	Если НачальноеЗначение <> НовоеЗначение И НовоеЗначение <> Неопределено Тогда
		//Таблицу заполняем всегда
		Если ФлЕстьЗнч Тогда
		ТЗИзменений = ОП.Знч("ТЗИзменений");
		ТипТаблицы = ТипЗнч(ТЗИзменений);
		Если ТипТаблицы = Тип("ТаблицаЗначений") Тогда
			МассивСтрок = ТЗИзменений.НайтиСтроки(Новый Структура("Реквизит",ИмяПоляДанных));
			Если МассивСтрок.Количество()>0 Тогда
				СтрокаТЗ = МассивСтрок[0];
				НачальноеЗначение = СтрокаТЗ.НачальноеЗначение;
			Иначе	
				СтрокаТЗ = ТЗИзменений.Добавить();
			КонецЕсли;	
			СтрокаТЗ.Реквизит 			= ИмяПоляДанных;
			СтрокаТЗ.НачальноеЗначение  = НачальноеЗначение;
			СтрокаТЗ.НовоеЗначение		= НовоеЗначение;
		Иначе
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не известный тип таблицы изменений "+ТипТаблицы, "НеСообщать", Истина);
		КонецЕсли;
		КонецЕсли;
		ЕстьОтличия = Истина;
		//Реквизит если только разрешено
		Если бЗаблокирована=ЛОЖЬ ИЛИ ИгнорироватьБлокировкуОплаты=ИСТИНА Тогда
			//
			Попытка
				ОП.УстЗнч(ИмяПоляДанных,НовоеЗначение);
			Исключение	
				уб_ВызовСервера._УстановитьЗначение(ОП,"ИмяПоляДанных",НовоеЗначение);
			КонецПопытки;	
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;
	Возврат Ложь;	
	
КонецФункции // УстЗнч()

//ИзменятьКодКВ 	- если Истина, сбрасывает КодКВ на 0
//КВАгентаРавноКВ   - при Неопределено рассчитает
