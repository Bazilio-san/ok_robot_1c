Функция ПолучитьВознаграждениеМенеджера2(ОП, 
	ВознаграждениеМенеджера, 
	ИнфоКрасчетуВМ, 
	СхемаРасчета, 
	СтатПоКАСКО = Неопределено, 
	НЕДобавлятьСтатистикувИнфо = Ложь,
	СведенияОСквитованныхОплатах = Неопределено,СуммаПоПриемкам=0) Экспорт
	
	Ф = "ЧН=0; ЧГ=";
	
	ВознаграждениеМенеджера = 0;
	
	//Если НЕ уб_СС.ОП_ВозможноРедактирование(ОП) Тогда
	//	Возврат 0;	
	//КонецЕсли;
	Если НЕ СведенияОСквитованныхОплатах = Неопределено Тогда
		БалансОплаты = СведенияОСквитованныхОплатах.Итог("НачисленнаяСуммаВзносаВКЛ")
		//- СведенияОСквитованныхОплатах.Итог("АВилиСкидкаСумма")
		- СведенияОСквитованныхОплатах.Итог("КВСумма")
		- СуммаПоПриемкам
		+ СведенияОСквитованныхОплатах.Итог("СкидкаВыплаченаяКлиенту");
	Иначе
		БалансОплаты = 0;
	Конецесли;
	//Если ОП.КВСумма < ОП.АВилиСкидкаСумма Тогда
	Если БалансОплаты>0 Тогда
		//ВознаграждениеМенеджера = ОП.КВСумма - ОП.АВилиСкидкаСумма;
		УжеУчтено = -(СведенияОСквитованныхОплатах.Итог("ВознаграждениеМенеджера")-ОП.Знч("ВознаграждениеМенеджера"));
		ВознаграждениеМенеджера = -(БалансОплаты-УжеУчтено);
		Если ВознаграждениеМенеджера<>0 Тогда
			ИнфоКрасчетуВМ = "Недостаточно средств, которые надо оплатить поставщику " + Формат(-ВознаграждениеМенеджера,Ф) + "р, компенсируется менеджером.";
			//ИнфоКрасчетуВМ = "Сумма предоставленной скидки превышает КВ брокера на сумму " + Формат(-ВознаграждениеМенеджера,Ф) + "р, которая удерживается с сотрудника";
			
			//ДобавитьВычетСАгента(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера);//Не добавялем будет задвоение	
			
			Возврат ВознаграждениеМенеджера;	
		КонецЕсли;
	КонецЕсли;
	
	//Если ОП.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО Тогда 
	//	//Здесь ничего не делаем	
	//ИначеЕсли ОП.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО Тогда
	//	//Здесь ничего не делаем	
	//Иначе	
	//	ИнфоКрасчетуВМ = "ВМ по виду страховых продуктов '" + ОП.ВидСП + "' по этой схеме расчетов не начисляется.";
	//	ВознаграждениеМенеджера = 0;
	//	Возврат  ВознаграждениеМенеджера;
	//КонецЕсли;
	
	//20120607
	//УстЗнач(ОП.Подразделение, уб_СС.ПолучитьПодразделениеАгента(ОП.Агент, ОП.ЗарплатныйПериод, Ложь, Истина), Неопределено);
	_Агент = ОП.Знч("Агент");
	_Подразделение = уб_СС.ПолучитьПодразделениеАгента(_Агент, ОП.Знч("Дата"), Ложь, Истина);
	Если Не УстЗнач(ОП,"Подразделение", _Подразделение, Неопределено) Тогда
		_Подразделение = ОП.Знч("Подразделение");//Раз не установили, запрашиваем текущее
	КонецЕсли;	
	ПВР = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП;
	
	тз = уб_СтраховойБрокер.ПолучитьСхемуРасчетаСМенеджером(ОП.Знч("ЗарплатныйПериод"), _Подразделение.Владелец, _Подразделение, _Агент, ОП.Знч("ВидСП"));
	Если тз.Количество() > 0 Тогда
		СхемаРасчета = тз[0].СхемаРасчета;
	Иначе
		СхемаРасчета = ПВР.БезРасчета;
		Сообщить("Ошибка при получении вида расчета с менеджером.",СтатусСообщения.ОченьВажное);
		Возврат  ВознаграждениеМенеджера;
	КонецЕсли;
	
	
	Если СхемаРасчета = ПВР.БезРасчета Тогда
		
		ИнфоКрасчетуВМ = "Вознаграждение не начисляется (Схема 'Без Расчета'). ";
		ВознаграждениеМенеджера = 0;
		
	ИначеЕсли СхемаРасчета = ПВР.ПланПоСКВ Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'План по СКВ'. ";
		ПолучитьВМдляСхемы_ПланПоСКВ(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера, СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
	ИначеЕсли СхемаРасчета = ПВР.СтраховойПродукт_Фикс Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Фиксированная сумма по страховому продукту'. ";
		ПолучитьВМдляСхемы_СтраховойПродукт_Фикс(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера);
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_2500 Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме '2500 за КАСКО'. ";
		ПолучитьВМдляСхемы_КАСКО_2500(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера, СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
		
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_ОкладПремия Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Оклад+Премия'. ";
		ПолучитьВМдляСхемы_КАСКО_ОкладПремия(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера, СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
		
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_Процент Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Процент'. ";
		ПолучитьВМдляСхемы_КАСКО_Процент_от_СКВ_суперплан_по_количеству_новых_страховок(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера, _Подразделение, СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
		
	ИначеЕсли СхемаРасчета = ПВР.КАСКО_Фикс Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Фикс за страховку'. ";
		ПолучитьВМдляСхемы_КАСКО_Фикс(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера, СтатПоКАСКО, НЕДобавлятьСтатистикувИнфо);
		
	ИначеЕсли СхемаРасчета = ПВР.ОСАГО_Фикс Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Фикс за ОСАГО'. ";
		ПолучитьВМдляСхемы_ОСАГО_Фикс(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера);
		
	ИначеЕсли СхемаРасчета = ПВР.ОСАГО_Фикс_Администратор Тогда
		
		ИнфоКрасчетуВМ = "Расчет по схеме 'Фикс за ОСАГО для администратора'. ";
		ПолучитьВМдляСхемы_ОСАГО_Фикс_Администратор(ОП, ИнфоКрасчетуВМ, ВознаграждениеМенеджера);
		
		
	ИначеЕсли НЕ СхемаРасчета.Предопределенный Тогда
		ИнфоКрасчетуВМ = "Фиксированный процент от СКВ";
		ВознаграждениеМенеджера = СхемаРасчета.Показатель*(ОП.Знач("КВСуммаДляАгента") - ОП.Знч("СкидкаВыплаченаяКлиенту"))/100;
	Иначе	
		
		Сообщить("Ошибка расчета ВМ (получена неизвестная схема расчета: '" + СхемаРасчета + "').",СтатусСообщения.ОченьВажное);
		
	КонецЕсли;
	
	Возврат  ВознаграждениеМенеджера;
