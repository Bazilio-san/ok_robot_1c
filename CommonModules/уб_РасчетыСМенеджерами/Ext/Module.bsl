			РасчетныйАВилиСумма	= Окр(ОП.Знч("НачисленнаяСуммаВзноса")+ОП.Знч("СуммаДоп") - ОП.Знч("ОплаченоФакт"), 2);
			Если ОП.Знч("НачисленнаяСуммаВзноса") > 0 Тогда
				РасчетныйАВилиПроцент = Окр(РасчетныйАВилиСумма * 100 / ОП.Знч("НачисленнаяСуммаВзноса"), 2);
			Иначе	
