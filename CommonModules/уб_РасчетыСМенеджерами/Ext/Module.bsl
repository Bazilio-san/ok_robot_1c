Функция  ПолучитьСетку(_Период,_Подразделение) Экспорт
	_Сетка = Новый ТаблицаЗначений;
	_Сетка.Колонки.Добавить("ПроцентОт",Новый ОписаниеТипов("Число"));
	_Сетка.Колонки.Добавить("СтавкаПролонгация",Новый ОписаниеТипов("Число"));
	_Сетка.Колонки.Добавить("СтавкаНБ",Новый ОписаниеТипов("Число"));
	ТекСтавка = 100;
	Пока ТекСтавка >= 0 Цикл
		СтрокаСетки = _Сетка.Добавить();
		СтрокаСетки.ПроцентОт = ТекСтавка;
		
		ТекСтавка = ТекСтавка-10;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подразделение",_Подразделение);
	Запрос.УстановитьПараметр("Период",_Период);
	Запрос.Текст  = "ВЫБРАТЬ
	|	уб_ЗП_СтавкиРОПСрезПоследних.Период,
	|	уб_ЗП_СтавкиРОПСрезПоследних.Подразделение,
	|	уб_ЗП_СтавкиРОПСрезПоследних.ВидМотивации,
	|	уб_ЗП_СтавкиРОПСрезПоследних.ПроцентОт,
	|	уб_ЗП_СтавкиРОПСрезПоследних.СтавкаВознаграждения
	|ИЗ
	|	РегистрСведений.уб_ЗП_СтавкиРОП.СрезПоследних(&Период,Подразделение = &Подразделение) КАК уб_ЗП_СтавкиРОПСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		нСтроки = _Сетка.НайтиСтроки(Новый Структура("ПроцентОт",Выборка.ПроцентОт));
		Если нСтроки.Количество() = 0 Тогда
			Сообщить("Не найден ПроцентОт "+Выборка.ПроцентОт);
			продолжить;
		КонецЕсли;	
		ТекСтрока = нСтроки[0];
		Если Выборка.ВидМотивации = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознПролонгация Тогда
			ТекСтрока.СтавкаПролонгация = Выборка.СтавкаВознаграждения;
		Иначе
			//Новый бизнес
			ТекСтрока.СтавкаНБ = Выборка.СтавкаВознаграждения;
		КонецЕсли;	
	КонецЦикла;	
	
	
	Возврат _Сетка;
	
КонецФункции	

Процедура ПолныйПерерасчетЗП() Экспорт
	перем ПротоколРасхождений;
	УстановитьПривилегированныйрежим(Истина);
	
	Организация = Справочники.Организации.НайтиПоКоду("000000001");
	Актуально = Истина;
	МассивДат = уб_РасчетыСМенеджерами.ВернутьНеактуальныеПериоды();
	ПрошлыйМесяц = НачалоМесяца(НачалоМесяца(ТекущаяДата())-1);
	Если МассивДат.Найти(ПрошлыйМесяц) = Неопределено Тогда
		МассивДат.Вставить(0,ПрошлыйМесяц);
	КонецЕсли;
	#Если Клиент Тогда
		Если ВвестиДату(ПрошлыйМесяц,"Выберите дату из нужного месяца",ЧастиДаты.Дата) = Истина Тогда
			ПрошлыйМесяц = НачалоМесяца(ПрошлыйМесяц);
			Если МассивДат.Найти(ПрошлыйМесяц) = Неопределено Тогда
				МассивДат.Вставить(0,ПрошлыйМесяц);
			КонецЕсли;	
		КонецЕсли;
	#КонецЕсли	
	
	Если МассивДат.Количество() > 0 Тогда
		Для Ит = 1 по МассивДат.Количество() Цикл
			ТекРасчетныйПериод = МассивДат[Ит-1];
			Если ЗначениеЗаполнено(ТекРасчетныйПериод) 
				И НачалоМесяца(ТекРасчетныйПериод) < НачалоМесяца(ТекущаяДата())
				Тогда
				СтрокаДат = Формат(ТекРасчетныйПериод,"ДФ='MMMM yyyy'")+";";
				//TODO пока нет модуля менеджера 1C 8.2 сделано так
				Если ТекРасчетныйПериод >= Дата(2020,1,1) Тогда
					Объект = Документы.уб_НачислениеЗП.ПолучитьДокументНачисленияЗаПериод(ТекРасчетныйПериод,Организация,Истина);
					#Если Клиент Тогда
					Состояние("Перерасчет периода:" + СтрокаДат);
					#КонецЕсли
					Объект.Перезаполнить(,, ПротоколРасхождений);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Если ПротоколРасхождений <> Неопределено Тогда
		ПротоколРасхождений.Показать();
	КонецЕсли;
	//Возврат Актуально;
	
КонецПроцедуры	

Процедура ПроверитьВидСтрахования(Объект,ВидСП = Неопределено) Экспорт
	Если ВидСП = Неопределено Тогда
		ВидСП = Объект.ВидСП;
	КонецЕсли;	
	Если ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО
		или ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО
		или ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КаскоПП
		Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.КАСКО;
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО
		или ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОсаго Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.ОСАГО;	
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ВЗР	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.ВЗР;		
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ГК	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.ГК;			
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ДМС	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.ДМС;				
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ДСАГО	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.ДСАГО;					
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Имущество	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.Имущество;						
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Ипотека	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.Ипотека;							
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.НС	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.НС;								
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Произвольный	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.Произвольный;									
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Бесполисные	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.Бесполисные;										
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Онкокоробка	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.Онкокоробка;												
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.КоробкаОтБПЛА	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.КоробкаОтБПЛА;													
	ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.АнтиКлещ	Тогда
		ВидСтрахования = Перечисления.уб_ВидыСтрахования.АнтиКлещ;													
	//ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Онкокоробка	Тогда
	//	ВидСтрахования = Перечисления.уб_ВидыСтрахования.Онкокоробка;													
	//ИначеЕсли ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.Онкокоробка	Тогда
	//	ВидСтрахования = Перечисления.уб_ВидыСтрахования.Онкокоробка;														
КонецЕсли;	
Если НЕ Объект.ВидС = ВидСтрахования Тогда
	Объект.ВидС = ВидСтрахования
	//УстановитьЗначение(Объект.ВидС, ВидСтрахования);
КонецЕсли;	
КонецПроцедуры	
