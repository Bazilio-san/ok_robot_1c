//переводит строку в режиме другого языка ввода (rus/eng).
//ПоПервым = 0, для полного инвертирования доступных символов
//НаКакой = "EN" "RU" - Если Неопределено - определяет язык перевода
Функция ПеревестиСтроку(Строка, ПоПервым = 3, НаКакой = "") Экспорт//, Транслит = Ложь
	
	Строка = СокрЛП(Строка);
	ДлинаМассива = Неопределено;
	//Если Транслит Тогда
	//	Массив = МассивАлфавитТранслит(ДлинаМассива);
	//Иначе
	//	Массив = МассивАлфавит(ДлинаМассива);
	//КонецЕсли;
	
	Массив = МассивАлфавит(ДлинаМассива);
	
	Если СтрДлина(Строка) >= ПоПервым Тогда
		Если Массив = Неопределено Тогда
			Возврат Строка;
		КонецЕсли;
		Если ПоПервым <> 0 Тогда
			// определяем доминирующий язык
			Если Найти(НаКакой, "ru") <> 0 Тогда
				ЯзыкОбработки = 0;
			ИначеЕсли Найти(НаКакой, "en") <> 0 Тогда
				ЯзыкОбработки = 1;
			Иначе
				ИндексПоиска = 1;
				МассивПоПервым = Новый Массив;
				МассивПоПервым.Добавить(0);
				МассивПоПервым.Добавить(0);
				// для определения языка первого значимого символа при равенстве количеств символов языков
				ПервыйВСписке = Неопределено;
				Для Индекс = 1 По ПоПервым Цикл
					ЯзыкСимвола = НайтиСимволВМассивАлфавит(Массив, Сред(Строка, Индекс, 1), ИндексПоиска, ДлинаМассива);
					Если ЯзыкСимвола <> Неопределено Тогда
						МассивПоПервым[ИндексПоиска] = МассивПоПервым[ИндексПоиска] + 1;
						Если ПервыйВСписке = Неопределено Тогда
							ПервыйВСписке = ИндексПоиска;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если МассивПоПервым[0] = 0 И МассивПоПервым[1] = 0 Тогда
					//если только символы - не меняем строку
					Возврат Строка;
				ИначеЕсли МассивПоПервым[0] = МассивПоПервым[1] Тогда
					//кол-во символов совпадает
					ЯзыкОбработки = ПервыйВСписке;
				Иначе 
					ЯзыкОбработки = ?(МассивПоПервым[0] > МассивПоПервым[1], 0, 1);
				КонецЕсли;
			КонецЕсли;			
			//переводим
			Перевод = "";
			ЯзыкПеревода = ?(ЯзыкОбработки = 1, 0, 1);
			Для Счетчик = 1 По СтрДлина(Строка) Цикл
				ИндексСимвола = Неопределено;
				Символ = Сред(Строка, Счетчик, 1);
				// Находим символ в колонке языка массива
				Для Индекс = 0 По ДлинаМассива Цикл
					Если Массив[ЯзыкОбработки][Индекс] = Символ Тогда
						ИндексСимвола = Индекс;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ИндексСимвола <> Неопределено Тогда
					Перевод = Перевод + Массив[ЯзыкПеревода][ИндексСимвола];
				Иначе
					Перевод = Перевод + Символ;
				КонецЕсли;
			КонецЦикла;
		Иначе
			//инвертируем все доступные символы
			ИндексПоиска = 1;
			Перевод = "";
			Для Счетчик = 1 По СтрДлина(СТрока) Цикл
				Символ = Сред(Строка, Счетчик, 1);
				Индекс = НайтиСимволВМассивАлфавит(Массив, Символ, ИндексПоиска, ДлинаМассива);
				Если Индекс <> Неопределено Тогда
					ЯзыкПеревода = ?(ИндексПоиска = 1, 0, 1);
					Перевод = Перевод + Массив[ЯзыкПеревода][Индекс];
				Иначе
					Перевод = Перевод + Символ;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Возврат Строка;
	КонецЕсли;
	
	Возврат Перевод;			
КонецФункции

//возвращает индекс символа в массиве алфавитов
//счетчиком вызовов можно запретить рекурсию
Функция НайтиСимволВМассивАлфавит(Массив, Символ, ИндексПоиска, ДлинаМассива, СчетчикВызовов = 0) Экспорт
	
	Результат = Неопределено;
	
	Для Индекс = 0 По ДлинаМассива Цикл
		Если Массив[ИндексПоиска][Индекс] = Символ Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено И СчетчикВызовов <> Неопределено Тогда
		СчетчикВызовов = СчетчикВызовов + 1;
		ИндексПоиска = ?(ИндексПоиска = 1, 0, 1);
		Если СчетчикВызовов < 2 Тогда
			Результат = НайтиСимволВМассивАлфавит(Массив, Символ, ИндексПоиска, ДлинаМассива, СчетчикВызовов);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НайтиСимволВМассивАлфавит()		


Процедура ВыпадающийСписокKeyDown(Элемент, KeyCode, Shift, ЭтаФорма, ЭлементДляАктивизации, СтруктураПараметровВсплывающегоСписка) Экспорт
	
	KeyCodeValue = KeyCode.Value;
	Если KeyCodeValue = 38 Тогда//верх
		Элемент.ListIndex = Макс(Элемент.ListIndex - 1, 0);
	ИначеЕсли KeyCodeValue = 40 Тогда//низ
		Элемент.ListIndex = Мин(Элемент.ListIndex + 1,Элемент.ListCount - 1);
	ИначеЕсли KeyCodeValue = 13 Тогда//enter
		уб_Фильтры.ОбработататьВыбранныйЭлементВыпадающегоСписка(Элемент, ЭтаФорма, ЭлементДляАктивизации, СтруктураПараметровВсплывающегоСписка);
	ИначеЕсли KeyCodeValue = 9 Или KeyCodeValue = 27 Тогда//tab Или esc
		Элемент.Видимость = Ложь;
		СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка = Неопределено;
		СтруктураПараметровВсплывающегоСписка.ТекущийСписокВсплывающегоСписка = Неопределено;
		Если KeyCodeValue = 27 Тогда
			//Подмена символа чтобы отключить последующую обработку
			KeyCode.Value = 19;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруПараметровВсплывающегоСписка() Экспорт
	Возврат Новый Структура("СписокМарокТС, СписокМоделейТС, ВладелецВсплывающегоСписка, ТекущийСписокВсплывающегоСписка, ВыбранныйЭлементТекущегоСписка, ПредставлениеВыбранныйЭлементТекущегоСписка, АктивироватьАвтоПодсказку, ЭлементСписок");
КонецФункции

Процедура ОчиститьФильтр(Элемент, Структура = Неопределено, КлючВСтруктуре = Неопределено) Экспорт
	
	Элемент.Значение = "";
	Если Структура <> Неопределено И КлючВСтруктуре <> Неопределено Тогда
		Структура[КлючВСтруктуре] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Функция УниверсальнаяОчисткаФильтра(ЭлементыФормы, ИмяКнопки, Структура = Неопределено, КлючВСтруктуре = Неопределено) Экспорт
	
	ИмяПоляФильтра = СтрЗаменить(ИмяКнопки, "Очистить", "");
	Элемент = ЭлементыФормы.Найти(ИмяПоляФильтра);
	Если Элемент <> Неопределено Тогда
		Элемент.Значение = "";
	КонецЕсли;
	Если Структура <> Неопределено И КлючВСтруктуре <> Неопределено Тогда
		Структура[КлючВСтруктуре] = Неопределено;
	КонецЕсли;
	
	Возврат Элемент;
КонецФункции

Процедура ОбработататьВыбранныйЭлементВыпадающегоСписка(ЭлементСписок, ЭтаФорма, ЭлементДляАктивизации = Неопределено, СтруктураПараметровВсплывающегоСписка) Экспорт
	
	ВыбранныйТекст = ЭлементСписок.Value;
	Если ЗначениеЗаполнено(ВыбранныйТекст) Тогда
		Если ЭлементДляАктивизации <> Неопределено Тогда
			ЭтаФорма.ТекущийЭлемент = ЭтаФорма.ЭлементыФормы[ЭлементДляАктивизации];
		КонецЕсли;
		ЭлементСпискаЗначение = НайтиЭлементСпискаПоПредставлению(СтруктураПараметровВсплывающегоСписка.ТекущийСписокВсплывающегоСписка,ВыбранныйТекст);
		Если ЭлементСпискаЗначение <> Неопределено Тогда
			СтруктураПараметровВсплывающегоСписка.ВыбранныйЭлементТекущегоСписка = ЭлементСпискаЗначение;
			СтруктураПараметровВсплывающегоСписка.ПредставлениеВыбранныйЭлементТекущегоСписка = ВыбранныйТекст;
		КонецЕсли;
		ЭлементСписок.Видимость = Ложь;
		Если СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка.Значение = ВыбранныйТекст Тогда
			СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка.Значение = " ";//чтобы вызвать событие onchange поля
			СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка.Значение = ВыбранныйТекст;
		Иначе
			СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка.Значение = ВыбранныйТекст;
		КонецЕсли;
		СтруктураПараметровВсплывающегоСписка.ВладелецВсплывающегоСписка = Неопределено;
		СтруктураПараметровВсплывающегоСписка.ТекущийСписокВсплывающегоСписка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры


//сначала нужно заблокировать поля фильтров, по данным котором нельзя менять отбор
Процедура ИсключитьНеВидимыеИлиНеДоступныеПоляВТЗФильтров(Форма) Экспорт
	
	ТЗФильтров = Форма.СтруктураФильтров.ТЗФильтров;
	МассивУдаляемыхИмен = Новый Массив;
	Для Каждого СтрокаТЗ Из ТЗФильтров ЦИкл
		Поле = Форма.ЭлементыФормы.Найти(СтрокаТЗ.ИмяПоля);
		Если Не ПроверитьДоступностьВводаВПоле(Поле) Тогда
			МассивУдаляемыхИмен.Добавить(СтрокаТЗ.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементМассива Из МассивУдаляемыхИмен Цикл
		МассивСтрокТЗ = ТЗФильтров.НайтиСтроки(Новый Структура("ИмяПоля", ЭлементМассива));
		Для Каждого ЭлементМассиваСтрок Из МассивСтрокТЗ Цикл
			ТЗФильтров.Удалить(ТЗФильтров.Индекс(ЭлементМассиваСтрок));
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

//истина, если поле доступно для ввода/изменения данных
//TODO добавить свойства блокировки элемента ActiveX
Функция ПроверитьДоступностьВводаВПоле(Поле)
	
	Возврат Поле <> Неопределено И Поле.Видимость И ?(ТипЗнч(Поле) <> Тип("ActiveX"), Поле.Доступность И Не Поле.ТолькоПросмотр, Не Поле.Locked)
	
КонецФункции // ПроверитьДоступностьВводаВПоле()


Функция НайтиЭлементСпискаПоПредставлению(Список, Текст)
	Для Каждого ЭлементСписка Из Список Цикл
		Если Текст = ЭлементСписка.Представление Тогда
			Возврат ЭлементСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции



Процедура ОбъектСписокПриАктивизацииСтроки(Элемент, ЭтаФорма, СтруктураФильтров) Экспорт
	
	Если Найти(СтруктураФильтров.ИмяСписка,"Документ")=0 Тогда
		ЭтаФорма.ОповеститьОбАктивизацииОбъекта(Элемент.ТекущаяСтрока);
	КонецЕсли;	
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	Если СтруктураФильтров.ВернутьФокусВПоле <> Неопределено Тогда
		ЭтаФорма.ТекущийЭлемент = ЭлементыФормы[СтруктураФильтров.ВернутьФокусВПоле];
		СтруктураФильтров.ВернутьФокусВПоле = Неопределено;
	КонецЕсли;
	
КонецПроцедуры



Процедура MouseMoveПоляФильтра(Элемент, Button, Shift, X, Y, ЭтаФорма, ПолеПодсказки, СтруктураПараметровВсплывающегоСписка, ИмяВСтруктуре) Экспорт
	
	Если СтруктураПараметровВсплывающегоСписка[ИмяВСтруктуре] <> Неопределено И СтруктураПараметровВсплывающегоСписка[ИмяВСтруктуре].Количество() = 1 Тогда
		ТекстПодсказки = СтруктураПараметровВсплывающегоСписка[ИмяВСтруктуре][0].Представление;
		//ПолеПодсказки.Clear();
		//ПолеПодсказки.AddItem(ТекстПодсказки);
		ПолеПодсказки.Значение = ТекстПодсказки;
		ПолеПодсказки.Видимость = Истина;
		//ПолеПодсказки.Лево = Элемент.Лево + 7;
		ПолеПодсказки.Лево = Элемент.Лево;
		ПолеПодсказки.Ширина = Элемент.Ширина + 22;
		ЭтаФорма.ПодключитьОбработчикОжидания("ВыключитьПодсказку", 0.3, Истина);
	Иначе
		ПолеПодсказки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры