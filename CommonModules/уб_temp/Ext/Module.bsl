// Для управления отборами в отчетах //

#Если Клиент Тогда
//Пустая ТЗ для обработки отбора
Функция СоздатьТЗОтбора() Экспорт
		
		ТЗ = Новый ТаблицаЗначений;
		
		ТЗ.Колонки.Добавить("ИмяПоля");
		ТЗ.Колонки.Добавить("ЗначениеОтбора");
		ТЗ.Колонки.Добавить("ВидСравнения");
		
		Возврат ТЗ;
		
	КонецФункции // СоздатьТЗОтбора()
	
//добавляет поле отбора для последующей обработки
	//ТЗ - ТЗ с помощью функции СоздатьТЗОтбора
	//ИмяПоля - строковое значение левого значения поля отбора
	//ЗначениеОтбора - правое значение поля отбора, если ЗначениеНеЗаполнено то отбор для поля не производится
	//ВидСравнения - строковое ВидСравненияКомпоновкиДанных
Процедура ДобавитьОтбор(ТЗ, ИмяПоля, ЗначениеОтбора, ВидСравнения = "Равно") Экспорт
		
		СтрокаТЗ = ТЗ.Добавить();
		СтрокаТЗ.ИмяПоля 			= ИмяПоля;
		СтрокаТЗ.ЗначениеОтбора 	= ЗначениеОтбора;
		СтрокаТЗ.ВидСравнения		= ВидСравнения;
		
	КонецПроцедуры // ДобавитьОтбор()
	
//обрабатывает поле отбора отчета
Процедура ОбработатьОтбор(Отбор, ТЗ) Экспорт
		
		//массив для проверки обработанных полей,
		//т.к. может быть несколько отборов по одному показателю
		ПолеУжеОбработано = Новый Массив();
		Для Счетчик = 0 По ?(ТЗ.Количество() > Отбор.Количество(), ТЗ.Количество(), Отбор.Количество()) Цикл
			ПолеУжеОбработано.Добавить(Ложь);
		КонецЦикла;
		
		Для Каждого Элемент из ТЗ Цикл
			ЭлементОтбора = Неопределено;
			
			Для Индекс = 0 По Отбор.Количество() - 1 Цикл
				Если Отбор[Индекс].ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элемент.ИмяПоля) И Не ПолеУжеОбработано[Индекс] Тогда
					ЭлементОтбора = Отбор[Индекс];
					ПолеУжеОбработано[Индекс] = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементОтбора = Неопределено Тогда
				ЭлементОтбора = Отбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных(Элемент.ИмяПоля);
			КонецЕсли;
			
			ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных[Элемент.ВидСравнения];
			ЭлементОтбора.Использование 	= ЗначениеЗаполнено(Элемент.ЗначениеОтбора);
			ЭлементОтбора.Представление		= Элемент.ЗначениеОтбора;
			ЭлементОтбора.ПравоеЗначение	= Элемент.ЗначениеОтбора;
		КонецЦикла;
		
	КонецПроцедуры
#КонецЕсли

