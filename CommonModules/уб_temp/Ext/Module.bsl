Функция ПолучитьТаблицуВсехДействий(ИмяОбъекта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	уб_Помощник.ПорядокДействия КАК ПорядокДействия,
	|	уб_Помощник.Действие,
	|	уб_Помощник.ИмяЭлементаФормы,
	|	уб_Помощник.Описание,
	|	уб_Помощник.ОбязательноКВыполнению,
	|	уб_Помощник.СетевойПутьККартинке
	|ИЗ
	|	РегистрСведений.уб_Помощник КАК уб_Помощник
	|ГДЕ
	|	уб_Помощник.Объект.Наименование = &ИмяОбъекта
	|	И НЕ уб_Помощник.Отключено
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокДействия";
	Запрос.УстановитьПараметр("ИмяОбъекта",ИмяОбъекта);
	Таблица = Запрос.Выполнить().Выгрузить();	
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Счетчик = 1;
	Для Каждого Строка Из Таблица Цикл
		Строка.НомерСтроки = Счетчик;		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДеревоЭлементовФормы(ЭтаФорма, ИмяОбъекта, Таблица) Экспорт
	
	Дерево = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	уб_Справка.ДеревоЭлементовФормы
	|ИЗ
	|	Справочник.уб_Справка КАК уб_Справка
	|ГДЕ
	|	уб_Справка.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Дерево = Выборка.ДеревоЭлементовФормы.Получить();
		//Дерево.Колонки.Добавить("Видимость", Новый ОписаниеТипов("Булево"));					
	КонецЕсли;
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Или Дерево.Строки.Количество() = 0 Тогда				
		Дерево=Новый ДеревоЗначений;		
		Дерево.Колонки.Добавить("ИмяЭлемента",Новый ОписаниеТипов("Строка"));
		Дерево.Колонки.Добавить("ПолноеИмя",Новый ОписаниеТипов("Строка"));
		Дерево.Колонки.Добавить("ТипЭлемента");		
		Дерево.Колонки.Добавить("НеУдалятьСтроки", Новый ОписаниеТипов("Булево"));
		Корень=Дерево.Строки.Добавить();	
		Корень.ИмяЭлемента="ЭтаФорма";
		Корень.ПолноеИмя="ЭтаФорма";
		Корень.ТипЭлемента=Тип("Форма");
		Корень.НеУдалятьСтроки = Истина;
	Иначе
		Дерево.Колонки.Добавить("НеУдалятьСтроки", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из Таблица Цикл		
		НайденнаяСтрока = Дерево.Строки.Найти(СтрокаТЗ.ИмяЭлементаФормы, "ИмяЭлемента", Истина);
		Если НайденнаяСтрока <> Неопределено И НайденнаяСтрока.Уровень() > 1 Тогда
			Пока НайденнаяСтрока <> Неопределено Цикл
				НайденнаяСтрока.НеУдалятьСтроки = Истина;
				НайденнаяСтрока = НайденнаяСтрока.Родитель;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	УдалитьЛишниеСтрокиДерева(Дерево.Строки);
	
	//ЗаполнениеКолонкиВидимость(ЭтаФорма.ЭлементыФормы, Дерево.Строки);
	
	Возврат Дерево;
	
Конецфункции	

