//функция возвращает последнее движение по виду и номеру БСО регистра сведений Движения БСО
//исключая страховые полисы и приемки оплат (для определения даты актуальности страхового полиса
//и оплаты полисов, чтобы БСО либо квитанция А7 соответственно делали движения корректной датой
Функция ПолучитьДатуПоследнегоДвижения(ВидБСО, НомерБСО,Агент = Неопределено) Экспорт
	
	Если ПустаяСтрока(НомерБСО) Или ВидБСО.Пустая() Тогда
		Возврат Неопределено
	КонецЕсли;
	Запрос = Новый Запрос;
	Если уб_СЛ.ОпределитьВедетсяКоличественныйУчет(ВидБСО) Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДБ.Период КАК Период,
		|	ДБ.Агент
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО.СрезПервых(
		|			,
		|			ВидБСО = &ВидБСО
		|				И НомерБСО = &НомерБСО
		|				И Регистратор ССЫЛКА Документ.уб_ПриемкаОплат
		|				) КАК ДБ";
		
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДБ.Период КАК Период,
		|	ДБ.Агент
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
		|			,
		|			ВидБСО = &ВидБСО
		|				И НомерБСО = &НомерБСО
		|				И Регистратор ССЫЛКА Документ.уб_ПеремещениеБСО
		|				) КАК ДБ";
	КонецЕсли;
	Запрос.УстановитьПараметр("НомерБСО", 	НомерБСО);
	Запрос.УстановитьПараметр("ВидБСО",		ВидБСО);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Агент = Выборка.Агент;
		Возврат Выборка.Период
	КонецЕсли;
	
КонецФункции // ДатаДвижения()

