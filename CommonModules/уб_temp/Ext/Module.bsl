Функция СписокМенеджеров(Знач Дата1 =  Неопределено,Знач  Дата2 =  Неопределено,КакМассив = Ложь) Экспорт
	
	Запрос = Новый Запрос();
	
	Если НЕ ЗначениеЗаполнено(Дата2) Тогда
		Дата2 = ТекущаяДата();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Дата1) Тогда
		Дата1 = Дата2-30*25*3600;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер КАК Менеджер
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= &Дата1
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата <= &Дата2
	               |	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалиста.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипВыезда.Административный)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер.Наименование";
	Запрос.УстановитьПараметр("Дата1",Дата1);
	Запрос.УстановитьПараметр("Дата2",Дата2);
	
	Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Менеджер");
	Если КакМассив = Истина Тогда
		Результат = Массив;
	Иначе
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(Массив);			
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

