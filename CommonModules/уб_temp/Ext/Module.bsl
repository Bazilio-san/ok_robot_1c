Процедура СкрытьПоказатьПоля(Кнопка, Форма)

	Параметры = Форма.ПараметрыСкрытьПоказатьПоля;
	Если Кнопка.Имя = "СкрытьПоказатьВсе" Тогда
		Подменю = Кнопка;
		Параметры.ПринудительныйФлаг = Не Параметры.ПринудительныйФлаг;
		Если Параметры.ПринудительныйФлаг Тогда
			Кнопка.Картинка = Параметры.КартинкаПоказатьВсе;
			ДопТекст		= "Показать";
		Иначе
			Кнопка.Картинка = Параметры.КартинкаСкрытьВсе;
			ДопТекст		= "Скрыть";
		КонецЕсли;
		Список = Новый СписокЗначений;
		Для Каждого СтрокаПодменю Из Параметры.Подменю Цикл
			СтрокаПодменю.Пометка = Параметры.ПринудительныйФлаг;
			СтрокаСЗ = Список.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСЗ, СтрокаПодменю);
			СтрокаСЗ.Представление  = ДопТекст + " " + СтрокаПодменю.Представление;
			КнопкаПодменю = Кнопка.Кнопки.Найти("СкрытьПоказать" + СтрокаПодменю.Значение.Элемент);
			Если КнопкаПодменю <> Неопределено Тогда
				КнопкаПодменю.Текст 	= СтрокаСЗ.Представление;
				КнопкаПодменю.Картинка 	= ?(СтрокаПодменю.Пометка, Параметры.КартинкаПоказать, Параметры.КартинкаСкрыть);
			КонецЕсли;
		КонецЦикла;
		Кнопка.Заголовок = ?(Параметры.ПринудительныйФлаг, "Показать поля", "Скрыть поля");
	Иначе
		Подменю = Форма.ЭлементыФормы.Найти("СкрытьПоказатьВсе");
		СтрокаСЗ = Неопределено;
		ИмяЭлемента = СтрЗаменить(Кнопка.Имя, "СкрытьПоказать", "");
		Для каждого ЭлементСписка Из Параметры.Подменю Цикл
			Если ЭлементСписка.Значение.Элемент = ИмяЭлемента Тогда
				СтрокаСЗ = ЭлементСписка;
			КонецЕсли;	
		КонецЦикла;
		
		Если СтрокаСЗ = Неопределено Тогда
			Возврат
		Иначе
			СтрокаСЗ.Пометка = Не СтрокаСЗ.Пометка
		КонецЕсли;
		Кнопка.Текст 	= ?(СтрокаСЗ.Пометка, "Показать", "Скрыть") + " " + СтрокаСЗ.Представление;
		Кнопка.Картинка = ?(СтрокаСЗ.Пометка, Параметры.КартинкаПоказать, Параметры.КартинкаСкрыть);
		Список = Новый СписокЗначений;
		Список.Добавить(СтрокаСЗ.Значение,, СтрокаСЗ.Пометка);
	КонецЕсли;
	Для Каждого СтрокаСЗ Из Список Цикл
		Поле = Форма.ЭлементыФормы.Найти(СтрокаСЗ.Значение.Элемент);
		Если Поле <> Неопределено Тогда
			Поле.Видимость = (Не СтрокаСЗ.Пометка) и СтрокаСЗ.Значение.УсловиеЗапрета = ЛОЖЬ;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
#КонецЕсли

Функция МассивОшибокВСтроку(Массив, Заголовок = "") Экспорт

	Результат = "";
	Для Каждого Строка Из Массив Цикл
		Результат = Результат + Строка + Символы.ПС;
	КонецЦикла;
	Результат = СокрП(Результат);
	Если Не ПустаяСтрока(Заголовок) И Не ПустаяСтрока(Результат) Тогда
		Результат = Заголовок + Символы.ПС + Результат;
	КонецЕсли;
	Возврат Результат;

КонецФункции // МассивОшибокВСтроку()

