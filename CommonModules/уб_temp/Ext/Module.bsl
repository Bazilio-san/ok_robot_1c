#Если Клиент Тогда
//добавляет или удаляет кнопку командной панели
	//Кнопки - КоманднаяПанель.Кнопки
	//ИмяКнопки - строка
	//СтруктураЗаполнения - структура реквитов кнопки для заполнения нужных свойств.
	//Удалить - удалить кнопку
	//Перезаписывать - если кнопку надо создать и она уже создана и структура реквизитов не совпадает - перезаписать реквизиты
	//ТипУдаленияДоступность - вместо удаления убирает доступность кнопки
Процедура ДобавитьИлиУдалитьКнопкуПанели(
	Кнопки, 
	СтруктураЗаполнения,
	Удалить,
	СРазделителем			= Ложь,
	Перезаписывать 			= Ложь,
	ТипУдаленияДоступность	= Ложь
	) Экспорт
	
	ИмяКнопки = СтруктураЗаполнения.Имя;
	Кнопка = Кнопки.Найти(ИмяКнопки);
	Если Удалить Тогда
		СоздаватьКнопку = Ложь;
		Если Кнопка <> Неопределено Тогда
			Если ТипУдаленияДоступность Тогда
				//если подменю убираем доступность всех вложенных кнопок в иерархии
				ДоступностьКнопкиРекурсивно(Кнопка, Ложь)
			Иначе
				Индекс = Кнопки.Индекс(Кнопка);
				Кнопки.Удалить(Индекс);
				Если СРазделителем И Индекс > 0 Тогда
					//удаляем связанный разделитель
					Разделитель = Кнопки.Получить(Индекс - 1);
					Если Разделитель.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель Тогда
						Кнопки.Удалить(Индекс - 1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипУдаленияДоступность Тогда
			//создаем кнопку, и снимаем доступность
			СоздаватьКнопку = Истина;
		КонецЕсли;
	Иначе
		СоздаватьКнопку = Истина;
	КонецЕсли;
	Если СоздаватьКнопку Тогда
		Если Кнопка = Неопределено Тогда
			Если СРазделителем Тогда
				Кнопка = Кнопки.Добавить();
				Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
			КонецЕсли;
			Кнопка = Кнопки.Добавить();
			Если СтруктураЗаполнения.Свойство("Действие") И ТипЗнч(СтруктураЗаполнения.Действие) = Тип("Строка") Тогда
				СтруктураЗаполнения.Действие = Новый Действие(СтруктураЗаполнения.Действие);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Кнопка, СтруктураЗаполнения);
			Если ТипУдаленияДоступность И Удалить Тогда
				ДоступностьКнопкиРекурсивно(Кнопка, Ложь);
			КонецЕсли;
			Если СтруктураЗаполнения.Свойство("Кнопки") И ТипЗнч(СтруктураЗаполнения.Кнопки) = Тип("Массив") Тогда
				Для Каждого СтруктураЗаполненияВложеннойКнопки Из СтруктураЗаполнения.Кнопки Цикл
					ДобавитьИлиУдалитьКнопкуПанели(
						Кнопка.Кнопки, 
						СтруктураЗаполненияВложеннойКнопки, 
						Удалить,
						СРазделителем,
						Перезаписывать,
						ТипУдаленияДоступность
					);
				КонецЦикла;
			КонецЕсли;
		Иначе
			Если Перезаписывать Тогда
				//TODO для вложенных кнопок
				ЗаполнитьЗначенияСвойств(Кнопка, СтруктураЗаполнения)
			КонецЕсли;
			Если ТипУдаленияДоступность Тогда
				ДоступностьКнопкиРекурсивно(Кнопка, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры//ДобавитьИлиУдалитьКнопкуПанели
	
Процедура ДоступностьКнопкиРекурсивно(Кнопка, Доступность)
	
	Если Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Действие Тогда
		Кнопка.Доступность = Доступность;
	ИначеЕсли Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю Тогда
		Для Каждого КнопкаПодменю Из Кнопка.Кнопки Цикл
			ДоступностьКнопкиРекурсивно(КнопкаПодменю, Доступность)
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	
