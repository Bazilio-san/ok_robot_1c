Функция ПолучитьКоординатыОшибкиВКоде(Знач СтрОшибки)	
	
	Результат = Новый Структура("НомерСтроки, НомерСимвола", 0, 0);
	
	// создаем объект для работы с регулярными выражениями
	RegExp = Новый COMОбъект("VBScript.RegExp");    
	
	//Параметры:
	RegExp.MultiLine  = Ложь; // Истина — текст многострочный,  Ложь — одна строка
	RegExp.Global     = Ложь; // Истина — поиск по всей строке, Ложь — до первого совпадения
	RegExp.IgnoreCase = Ложь; // Истина — игнорировать регистр строки при поиске
	
	RegExp.Pattern = "\{\(\d{1,}\,{0,1}\d{1,}\)\}";
    Код = RegExp.Execute (СтрОшибки);
	
	Если Код.Count = 1 Тогда
		Код = Код.Item(0).Value;
	Иначе
		Код = "";
	КонецЕсли;
	
	RegExp = Неопределено;
	
	Если Не ПустаяСтрока(Код) Тогда
		ПозицияЗапятой = Найти(Код, ",");
		Если ПозицияЗапятой > 3 Тогда
			НомерСтроки  = 0; 
			НомерСимвола = 0;			
			
			Стр = Сред(Код, 3, ПозицияЗапятой - 3);
			Попытка
				НомерСтроки = Число(Стр);
			Исключение
				НомерСтроки = 0;
			КонецПопытки;
			
			Стр = Сред(Код, ПозицияЗапятой + 1, СтрДлина(Код) - ПозицияЗапятой - 2);
			Попытка
				НомерСимвола = Число(Стр);
			Исключение
				НомерСимвола = 0;
			КонецПопытки;
			
			Результат.НомерСтроки  = НомерСтроки;
			Результат.НомерСимвола = НомерСимвола;
		Иначе
			ПозицияЗапятой = Найти(Код, ")}");
			Если ПозицияЗапятой > 3 Тогда
				НомерСтроки = 0; 
				
				Стр = Сред(Код, 3, ПозицияЗапятой - 3);
				Попытка
					НомерСтроки = Число(Стр);
				Исключение
					НомерСтроки = 0;
				КонецПопытки;
				
				Результат.НомерСтроки = НомерСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
