//рекурсивно ищет документ-основание определенного типа
Функция ДокументОснованиеПоТипуРекурсивно(Ссылка, Тип) Экспорт
	
	ДокументОснование = Ссылка.СозданНаОсновании;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) <> Тип Тогда
			ДокументОснование = ДокументОснованиеПоТипуРекурсивно(ДокументОснование, Тип)
		КонецЕсли;
		Возврат ДокументОснование;
	КонецЕсли;
	
КонецФункции // ДокументОснованиеПоТипуРекурсивно()

Функция СтруктураБлокировкиДокумента(Ссылка) Экспорт
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		ОтчетСсылка = Ссылка.ОтчетПоставщику;
		МассивОбъектов.Добавить(ОтчетСсылка);
	Иначе
		ОтчетСсылка = Ссылка;
	КонецЕсли;
	Структура = Новый Структура;
	Структура.Вставить("ЕстьПравоРазблокировки", ПолучитьПредопределеннуюНастройкуПользователя("ПравоРедактированияЗаблокированных", Ложь));
	Если ЗначениеЗаполнено(ОтчетСсылка) Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ИСТИНА КАК НеПустой
		|ИЗ
		|	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК ВЗ
		|ГДЕ
		|	ВЗ.ОтчетПоставщику = &Ссылка
		|	И ВЗ.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщику)");
		Запрос.УстановитьПараметр("Ссылка", 				ОтчетСсылка);
		Запрос.УстановитьПараметр("ЕстьПравоРазблокировки", Структура.ЕстьПравоРазблокировки);
		Результат = Запрос.Выполнить();
		Структура.Вставить("ЕстьПеречисление", 	Не Результат.Пустой());
		Структура.Вставить("Заблокирован",		Структура.ЕстьПеречисление И Не Структура.ЕстьПравоРазблокировки И РегистрыСведений.уб_РазблокировкаОбъектов.СостояниеБлокировки(МассивОбъектов));
	Иначе
		Структура.Вставить("ЕстьПеречисление", 	Ложь);
		Структура.Вставить("Заблокирован",		Ложь);
	КонецЕсли;
	Возврат Структура;
	
КонецФункции



