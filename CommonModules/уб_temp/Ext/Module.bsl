//получает список поставщиков по документу поступления БСО
Функция СписокПоставщиков(
	Знач Дата		= Неопределено,
	Знач Период     = Неопределено,
	ТолькоАктивные 	= Истина, 
	КакМассив 		= Ложь
	) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СобственныйКонтрагент", ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент);
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПБ.Поставщик
	|ИЗ
	|	Документ.уб_ПоступлениеБСО КАК ПБ
	|ГДЕ
	|	ПБ.Поставщик <> &СобственныйКонтрагент
	|	И ПБ.Проведен";
	Если ТолькоАктивные Тогда
		ТекстЗапроса = ТекстЗапроса + " И ПБ.Поставщик.Родитель.Наименование <> ""НЕ АКТИВНЫЕ"""
	КонецЕсли;
	Если Дата <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + " И ПБ.Дата <= &Дата";
		Запрос.УстановитьПараметр("Дата", Дата);
	Иначе
		Дата = ТекущаяДата();
	КонецЕсли;
	Если Период <> Неопределено Тогда
		Период = Дата - (Период * 24 * 60 * 60);
		ТекстЗапроса = ТекстЗапроса + " И ПБ.Дата >= &Период";
		Запрос.УстановитьПараметр("Период", Период);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	ПБ.Поставщик.Наименование";
	Запрос.Текст = ТекстЗапроса;
	Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Поставщик");
	Если КакМассив Тогда
		Результат = Массив
	Иначе
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(Массив);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // СписокПоставщиков()

