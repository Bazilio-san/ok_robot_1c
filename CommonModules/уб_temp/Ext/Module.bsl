//проверяет на битые ссылки измерения "Объект" РС уб_Предоставленные документы 
Процедура ПроверкаПустыхСсылокВПредоставленныхДокументах() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	уб_ПредоставленныеДокументыСП.Объект,
	|	уб_ПредоставленныеДокументыСП.ВидДокумента
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК уб_ПредоставленныеДокументыСП
	|ГДЕ
	|	(уб_ПредоставленныеДокументыСП.Объект.Ссылка ЕСТЬ NULL
	|			ИЛИ уб_ПредоставленныеДокументыСП.ВидДокумента = ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.ПустаяСсылка))";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//ЗаписатьОшибкуИСообщить("В регистре сведений уб_ПредоставленныеДокументы у измерения 'Объект' битая ссылка: " + Выборка.Объект, "НеСообщать", Истина);
		МенеджерЗаписи = РегистрыСведений.уб_ПредоставленныеДокументыСП.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Выборка.Объект;
		МенеджерЗаписи.ВидДокумента = Выборка.ВидДокумента;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

