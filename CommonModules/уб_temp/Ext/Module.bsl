//рекурсивный поиск кнопки по имени в дереве и по всем вложенным подменю
Функция НайтиКнопкуВПодменю(Корень, Имя)
	#Если Клиент Тогда
		Для Каждого Кнопка Из Корень Цикл
			Если Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю Тогда
				Если Кнопка.Имя = Имя Тогда
					Возврат Кнопка
				КонецЕсли;
				КнопкаПодч = НайтиКнопкуВПодменю(Кнопка.Кнопки, Имя);
				Если КнопкаПодч <> Неопределено Тогда
					Возврат КнопкаПодч
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	#КонецЕсли
КонецФункции // НайтиКнопкуВПодменю()

//Расчитывает количество БСО в ТЧ БСО 
Функция ПолучитьКоличествоБСОвТЧ(ТЧБСО) Экспорт
	СчетчикБСО = 0;
	тзБСО = ТЧБСО.Выгрузить();
	Для каждого СтрокаТЧ из тзБСО Цикл 
		тсВидБСО = СтрокаТЧ.ВидБСО;
		КоличественныйУчет = уб_СЛ.ОпределитьВедетсяКоличественныйУчет(тсВидБСО);
		Если КоличественныйУчет Тогда
			СчетчикБСО = СчетчикБСО + СтрокаТЧ.Количество;
		Иначе
			Если ЗначениеЗаполнено(СтрокаТЧ.НомерБСО) Тогда
				СчетчикБСО = СчетчикБСО + 1;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Возврат СчетчикБСО;
КонецФункции	

// Получает ФИО ФизЛица
Функция ПолучитьФИО(ФЛ,Полно = Истина) Экспорт
	
	#Если Клиент Тогда
		ОчиститьСообщения();
	#КонецЕсли
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество
	|ИЗ
	|	РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
	|ГДЕ
	|	ФИОФизЛицСрезПоследних.ФизЛицо = &ФизЛицо");
	
	Запрос.УстановитьПараметр("ФизЛицо", ФЛ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Фамилия = "" Тогда
			Сообщить("Некорректная фамилия физ.лица!");
		КонецЕсли;
		
		Фамилия = СокрЛП(Выборка.Фамилия);
		
		Если Выборка.Имя = "" Тогда
			Сообщить("Некорректное имя физ.лица!");
		КонецЕсли;
		
		Имя = СокрЛП(Выборка.Имя);
		
		Если Выборка.Отчество = "" Тогда
			Сообщить("Некорректное отчество физ.лица!");
		КонецЕсли;
		
		Отчество = СокрЛП(Выборка.Отчество);
		
	КонецЕсли;
	
	ФИО = "";
	
	Если Полно Тогда
		
		Если Фамилия <> "" Тогда
			ФИО = ФИО + ВРег(Лев(Фамилия, 1)) + СРед(Фамилия, 2);
			Если Имя <> "" Или Отчество <> "" Тогда
				ФИО = ФИО + " ";
			КонецЕсли;
		КонецЕсли;
		
		Если Имя <> "" Тогда
			ФИО = ФИО + ВРег(Лев(Имя, 1)) + СРед(Имя, 2);
			Если Отчество <> "" Тогда
				ФИО = ФИО + " ";
			КонецЕсли;
		КонецЕсли;
		
		ФИО = ФИО + ВРег(Лев(Отчество, 1)) + СРед(Отчество, 2);
		
	Иначе
		
		Если Фамилия <> "" Тогда
			ФИО = ВРег(Лев(Фамилия, 1)) + СРед(Фамилия, 2);
			Если Имя <> "" Или Отчество <> "" Тогда
				ФИО = ФИО + " ";
			КонецЕсли;
		КонецЕсли;
		
		Если Имя <> "" Тогда
			ФИО = ФИО + ВРег(Лев(Имя, 1)) + ".";
			Если Отчество <> "" Тогда
				ФИО = ФИО + " ";
			КонецЕсли;
		КонецЕсли;
		
		Если Отчество <> "" Тогда
			ФИО = ФИО + ВРег(Лев(Отчество, 1)) + ".";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФИО;
	
КонецФункции // ПолучитьФИО()

#Если Клиент Тогда
	Процедура ДобавитьКнопкиПанелиДействий(
		КнопкиПанели, 
		ИсточникВызова, 
		Форма 			= Неопределено, 
		Параметры		= Неопределено
		) Экспорт
		
		сИсточникДействий = РазделитьИсточникДействий(ИсточникВызова);
		//TODO исправить после исправления вызовов в оплате
		Если Параметры = Неопределено Тогда
			Параметры = СтруктураПараметровДобавленияКнопокДействийПоУмолчанию()
		КонецЕсли;
		ДобавлятьКнопкуРазблокировки 	= ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(Параметры, "КнопкаРазблокировки", 		Истина);
		ДобавлятьКнопкуСкрытыеРеквизиты = ОбщегоНазначения.СравнитьСоЗначениемВСтруктуре(Параметры, "КнопкаСкрытыеРеквизиты",   Истина);
		Если сИсточникДействий = Неопределено Тогда
			Сообщить("Источник действий неверен!");
			Возврат;
		КонецЕсли;	
		Если (сИсточникДействий.Тип = "Документ" И (Найти(сИсточникДействий.Форма, "ФормаСписка") <> 0 Или Найти(сИсточникДействий.Форма, "ФормаДокумента") <> 0))
			Или (сИсточникДействий.Тип = "Справочник" И (Найти(сИсточникДействий.Форма, "ФормаСписка") <> 0 Или Найти(сИсточникДействий.Форма, "ФормаЭлемента") <> 0)) Тогда
			СоздатьКнопкуПоискСсылок(КнопкиПанели);
		КонецЕсли;
		Если ДобавлятьКнопкуСкрытыеРеквизиты
			И (Найти(сИсточникДействий.Форма, "ФормаСписка") <> 0 ИЛИ Найти(сИсточникДействий.Форма, "ФормаВыбора") <> 0)
			И НЕ сИсточникДействий.Тип = "ЖурналДокументов"
			//To DO Реализовать исключения более универсальным способом
			И НЕ ИсточникВызова = "Справочник.уб_Справка.ФормаСписка" 
			И НЕ ИсточникВызова = "РегистрСведений.уб_ДвиженияБСО.ФормаСписка" 
			И НЕ ИсточникВызова = "РегистрНакопления.уб_ОстаткиБСО.ФормаСписка"
			Тогда
			СоздатьКнопкуСкрытыеРеквизиты(КнопкиПанели);
		КонецЕсли;	
		ЕстьКнопкаСправки = Ложь;
		//Для Каждого Кнопка Из КнопкиПанели Цикл
		//	Если Найти(Кнопка.Имя ,"ВызовСправкиHTML")= 1 Тогда
		//		ЕстьКнопкаСправки = Истина;
		//		Прервать;
		//	КонецЕсли;
		//КонецЦикла;
		//ЕстьКнопкаСправки = КнопкиПанели.Найти("ВызовСправкиHTML") <> Неопределено;
		//Если Не ЕстьКнопкаСправки И (Форма = Неопределено Или Не Форма.МодальныйРежим) Тогда
		//	СоздатьКнопкуВызоваСправки(КнопкиПанели, ИсточникВызова)
		//КонецЕсли;
		Если сИсточникДействий.Тип = "Документ" Или сИсточникДействий.Тип = "ЖурналДокументов" Тогда
			// Исключения документов, для которых не нужна структура подчиненности
			Массив = Новый Массив;
			Массив.Добавить("уб_ТабельУчетаРабочегоВремени");
			Массив.Добавить("уб_НачислениеЗП");
			Если Массив.Найти(сИсточникДействий.Имя) = Неопределено
				И (Найти(сИсточникДействий.Форма, "ФормаДокумента") <> 0 Или Найти(сИсточникДействий.Форма, "ФормаСписка") <> 0) Тогда
				СоздатьКнопкуСтруктураПодчиненности(КнопкиПанели);
			КонецЕсли
		КонецЕсли;
		Если ДобавлятьКнопкуРазблокировки Тогда
			//обрабатываем кнопку разблокировки
			//СтруктураБлокировкиОтчета = Документы.уб_ОтчетПоставщику.СтруктураБлокировкиОтчетаПоставщику(Неопределено);
			СтруктураБлокировки = уб_temp.СтруктураБлокировкиДокумента(Форма.Ссылка.ОтчетПоставщику);
			Структура = Новый Структура;
			Структура.Вставить("Имя", 			"Разблокировать");
			Структура.Вставить("ТипКнопки", 	ТипКнопкиКоманднойПанели.Действие);
			Структура.Вставить("Действие",		Новый Действие("ДействияФормыРазблокировать"));
			Структура.Вставить("Текст",			"Разблокировать");
			Структура.Вставить("Подсказка",		"Разблокирует объект для пользователя на определенную дату");
			Структура.Вставить("Пояснение",		"Разблокирует объект для пользователя на определенную дату");
			Структура.Вставить("Картинка",		БиблиотекаКартинок.уб_Unlock);
			Структура.Вставить("Отображение",   ОтображениеКнопкиКоманднойПанели.Картинка);
			уб_temp.ДобавитьИлиУдалитьКнопкуПанели(КнопкиПанели, Структура, Не (СтруктураБлокировки.ЕстьПравоРазблокировки И СтруктураБлокировки.ЕстьПеречисление), Истина);
		КонецЕсли;
		
		ЕстьСобытиеВхода(ИСТИНА);
		УстановитьПривилегированныйРежим(Истина);
		Если сИсточникДействий.Тип="Отчет" или сИсточникДействий.Тип="Обработка" Тогда
			
			журналСобытий = Справочники.журналСобытий.СоздатьЭлемент();
			журналСобытий.Дата = ТекущаяДата();
			журналСобытий.Событие = Справочники.ВидСобытия.Открытие;
			журналСобытий.Пользователь = ПараметрыСеанса.ТекущийПользователь;
			журналСобытий.Объект = ИсточникВызова;
			журналСобытий.Информация = "Открытие формы отчета";
			журналСобытий.Записать();
		ИначеЕсли Найти(сИсточникДействий.Форма, "ФормаСписка") <> 0 Тогда
			журналСобытий = Справочники.журналСобытий.СоздатьЭлемент();
			журналСобытий.Дата = ТекущаяДата();
			журналСобытий.Событие = Справочники.ВидСобытия.Открытие;
			журналСобытий.Пользователь = ПараметрыСеанса.ТекущийПользователь;
			журналСобытий.Объект = ИсточникВызова;
			журналСобытий.Информация = "Открытие списка";
			журналСобытий.Записать();

		КонецЕсли;	
		УстановитьПривилегированныйРежим(Ложь);
	КонецПроцедуры
#КонецЕсли

Функция ЕстьСобытиеВхода(Создавать = Истина) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если уб_Кэшируемые.ЕстьСобытиеВхода(НачалоДня(ТекущаяДата())) = ЛОЖЬ Тогда
		Если  Час(ТекущаяДата())>=4 Тогда
			журналСобытий = Справочники.журналСобытий.СоздатьЭлемент();
			журналСобытий.Дата = ТекущаяДата();
			журналСобытий.Событие = Справочники.ВидСобытия.Вход;
			журналСобытий.Пользователь = ПараметрыСеанса.ТекущийПользователь;
			журналСобытий.Информация = "Автовход";
			журналСобытий.Записать();
		КонецЕсли;
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;  
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции	

Процедура СоздатьКнопкуСкрытыеРеквизиты(ПутьККнопке) Экспорт
	#Если Клиент Тогда
		Разделитель = ПутьККнопке.Добавить();
		Разделитель.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		Кнопка = ПутьККнопке.Добавить();
		Кнопка.Доступность = Истина;
		Кнопка.Имя = "СкрытыеРеквизиты";
		Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Действие;
		Кнопка.Действие = Новый Действие("ОбработчикДопКнопокДействийФормы");
		Кнопка.Текст = "Показать/Отобразать данные по автору и модификатору ";
		Кнопка.Подсказка = 	"Показать/Отобразать колонки по автору, модификатору и датам событий изменения";
		Кнопка.Картинка = БиблиотекаКартинок.уб_ДопРеквизитыОтобразить;
	#КонецЕсли
КонецПроцедуры

Процедура СоздатьКнопкуВызоваСправки(КнопкиПанели, ИсточникВызова,КэшЗаменыУрл = Неопределено) Экспорт
	
	//Если ЗаписыватьЛог Тогда
	//	СоздатьЛогПользователя(ИсточникВызова, Ложь)
	//КонецЕсли;
	ОсновнаяКнопкаСправкиСоздана = Ложь;
	URL = ПолучитьURLПоНеURLМодуль(ИсточникВызова,КэшЗаменыУрл);
	#Если Клиент Тогда
		ВыборкаВсе = КэшЗаменыУрл.Получить("ЗапросКнопокСправки");
		Если  ВыборкаВсе = Неопределено Тогда
			ЗапросКнопокСправки = Новый Запрос;
			ЗапросКнопокСправки.Текст =
			"ВЫБРАТЬ
				|	уб_СправкаСтраницы.ТипКнопки,
				|	уб_СправкаСтраницы.Доступность,
				|	уб_СправкаСтраницы.Имя,
				|	уб_СправкаСтраницы.Действие,
				|	уб_СправкаСтраницы.Текст,
				|	уб_СправкаСтраницы.Картинка,
				|	уб_СправкаСтраницы.Подсказка,
				|	уб_СправкаСтраницы.Отображение,
				|	уб_СправкаСтраницы.Подменю,уб_СправкаСтраницы.Ссылка.Наименование как  Наименование
				|ИЗ
				|	Справочник.уб_Справка.Страницы КАК уб_СправкаСтраницы
				|ГДЕ
				//|	уб_СправкаСтраницы.Ссылка.Наименование = &ИсточникВызова
				//|	И 
				|	НЕ уб_СправкаСтраницы.Ссылка.ПометкаУдаления
				|
				|УПОРЯДОЧИТЬ ПО
			|	уб_СправкаСтраницы.НомерСтроки";
			ЗапросКнопокСправки.УстановитьПараметр("ИсточникВызова", ИсточникВызова);		
			ВыборкаВсе = ЗапросКнопокСправки.Выполнить().Выгрузить();		
			КэшЗаменыУрл.Вставить("ЗапросКнопокСправки",ВыборкаВсе);
		КонецЕсли;
		Выборки = ВыборкаВсе.Скопировать(Новый Структура("Наименование",ИсточникВызова));
		ТаблицаДействий =  Новый ТаблицаЗначений;
		ТаблицаДействий.Колонки.Добавить("ТипКнопки");
		ТаблицаДействий.Колонки.Добавить("Доступность");
		ТаблицаДействий.Колонки.Добавить("Имя");
		ТаблицаДействий.Колонки.Добавить("Действие");
		ТаблицаДействий.Колонки.Добавить("Текст");
		ТаблицаДействий.Колонки.Добавить("Картинка");
		ТаблицаДействий.Колонки.Добавить("Подсказка");
		ТаблицаДействий.Колонки.Добавить("Подменю");		
		
		ЕстьСправочникСправка = Ложь;
		Действие    = Перечисления.уб_ТипыКнопокКоманднойПанели.Действие;
		Разделитель = Перечисления.уб_ТипыКнопокКоманднойПанели.Разделитель;
		Подменю     = Перечисления.уб_ТипыКнопокКоманднойПанели.Подменю;
		кэшКартинок = Новый Соответствие;
		Для Каждого Выборка Из Выборки Цикл
		
			Если Не Выборка.Отображение Тогда
				Продолжить
			КонецЕсли;			
			СтрокаДействия = ТаблицаДействий.Добавить();			
			Если Выборка.ТипКнопки = Действие Тогда
				СтрокаДействия.ТипКнопки = ТипКнопкиКоманднойПанели.Действие
			ИначеЕсли Выборка.ТипКнопки = Разделитель Тогда
				СтрокаДействия.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель
			Иначе
				СтрокаДействия.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю
			КонецЕсли;
			СтрокаДействия.Имя 		= Выборка.Имя;
			СтрокаДействия.Подменю  = Выборка.Подменю;
			Если Выборка.ТипКнопки <> Перечисления.уб_ТипыКнопокКоманднойПанели.Разделитель Тогда
				СтрокаДействия.Текст = Выборка.Текст;
				СтрокаДействия.Подсказка = ?(Выборка.Подсказка = "", "Открывает Wiki-статью в отдельном окне", Выборка.Подсказка);
				Картинка = кэшКартинок.Получить(Выборка.Картинка);
				Если  Картинка = Неопределено  Тогда
					Если Выборка.Картинка = "" Тогда
						Картинка = Новый Картинка;
					Иначе
						Картинка = БиблиотекаКартинок[Выборка.Картинка];
					КонецЕсли;
					кэшКартинок.Вставить(Выборка.Картинка,Картинка);
				КонецЕсли;
				СтрокаДействия.Картинка = Картинка;
				
				Если Выборка.ТипКнопки <> Подменю Тогда
					СтрокаДействия.Доступность = Выборка.Доступность;
					Действие = ?(Выборка.Действие = "", Новый Действие("ОбработчикДопКнопокДействийФормы"), Новый Действие(Выборка.Действие));
					СтрокаДействия.Действие = Действие;
				КонецЕсли;			
				ЕстьСправочникСправка = Истина;
			КонецЕсли;	
		КонецЦикла;				
		Если ЕстьСправочникСправка Тогда
			ПутьККнопке = КнопкиПанели;
			Доступность = Истина;	
		Иначе
			ПутьККнопке = КнопкиПанели;
			Если URL = ИсточникВызова Тогда
				Доступность = ЛОЖЬ;
			Иначе	
				Доступность = НЕ (URL = "" или URL = Неопределено);
			КонецЕсли;	
			ТаблицаДействий = Неопределено;
		КонецЕсли;
		Разделитель = ПутьККнопке.Добавить();
		Разделитель.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		Если ТаблицаДействий = Неопределено Тогда
			Кнопка = ПутьККнопке.Добавить();
			Кнопка.Доступность = Истина;
			Кнопка.Имя = "ВызовСправкиHTML";//+СтрЗаменить(ИсточникВызова,".","__");
			Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Действие;
			Кнопка.Действие = Новый Действие("ОбработчикДопКнопокДействийФормы");
			Кнопка.Текст = "Вызвать справку HTML";
			Кнопка.Картинка = БиблиотекаКартинок.СправкаHTML;
			Кнопка.Подсказка = "Открывает Wiki-справку в отдельном окне";
			Кнопка.Доступность = Доступность;
			ОсновнаяКнопкаСправкиСоздана = Истина;
		Иначе
			НовыйПутьККнопке = ПутьККнопке;
			Если ТаблицаДействий.Количество() > 1  Тогда
				НовыйПутьККнопке = ПутьККнопке.Добавить();
				НовыйПутьККнопке.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю;
				НовыйПутьККнопке.Картинка = БиблиотекаКартинок.СправкаHTML;
				НовыйПутьККнопке.Подсказка = "Меню доступной Wiki-справки в отдельном окне";
				НовыйПутьККнопке.Доступность = Истина;
				НовыйПутьККнопке.Текст = "WIKI-справка";
				НовыйПутьККнопке.Имя = "ВызовСправкиHTML";
				ОсновнаяКнопкаСправкиСоздана = Истина;
				НовыйПутьККнопке = НовыйПутьККнопке.Кнопки;
			КонецЕсли;	
			//массив имен подменю
			мПодменю = Новый Массив;
			Для Каждого ПараметрыКнопки из ТаблицаДействий Цикл
				//если подменю - записываем имя в массив для последующего поиска и иерархии справки
				Если ПараметрыКнопки.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю Тогда
					мПодменю.Добавить(ПараметрыКнопки.Имя);
				КонецЕсли;
				Подменю = ПараметрыКнопки.Подменю;
				Если Подменю <> "" Тогда
					//если кнопка в подменю - проверяем наличие
					Если Найти(мПодменю, Подменю) <> Неопределено Тогда
						КнопкаПодменю = НайтиКнопкуВПодменю(НовыйПутьККнопке, Подменю);
						Если КнопкаПодменю = Неопределено Тогда
							Кнопка = НовыйПутьККнопке.Добавить();
						Иначе
							Кнопка = КнопкаПодменю.Кнопки.Добавить();
						КонецЕсли;
					Иначе
						Кнопка = НовыйПутьККнопке.Добавить();
					КонецЕсли;
				Иначе
					Кнопка = НовыйПутьККнопке.Добавить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(Кнопка,ПараметрыКнопки);
				Если ОсновнаяКнопкаСправкиСоздана = Истина Тогда
					Кнопка.Имя = ПараметрыКнопки.Имя;
				Иначе
					Кнопка.Имя = "ВызовСправкиHTML";
					ОсновнаяКнопкаСправкиСоздана = Истина;
				КонецЕсли;
				//если кнопка всего одна и у нее нет картинки - ставим стандартную
				Если ТаблицаДействий.Количество() = 1 И ПараметрыКнопки.Картинка.Вид = ВидКартинки.Пустая Тогда
					Кнопка.Картинка = БиблиотекаКартинок.СправкаHTML;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

