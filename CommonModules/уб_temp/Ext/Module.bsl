	Shell.SendKeys("%+(R)"); // вызов Alt+Shift+R
КонецПроцедуры

//получает серию и номер квитанции А7 отдельно по полному номеру
Процедура ПолучитьСериюИНомерКвитанцииА7(НомерА7, НомерКвитанции = "", СерияКвитанции = "") Экспорт
	
	НомерА7 = СокрЛП(НомерА7);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_ПоступлениеБСОБСО.НачНомерБСО,
	|	уб_ПоступлениеБСОБСО.КонНомерБСО,
	|	уб_ПоступлениеБСОБСО.СерияБСО
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК уб_ПоступлениеБСОБСО
	|ГДЕ
	|	уб_ПоступлениеБСОБСО.ВидБСО.Тип = &А7";
	
	Запрос.УстановитьПараметр("А7", Перечисления.уб_ТипыБСО.КвитанцияА7);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		СерияБСО	= СокрЛП(Выборка.СерияБСО);		
		Если СерияБСО <> Лев(НомерА7, СтрДлина(СерияБСО)) Тогда
			Продолжить
		КонецЕсли;
		
		КонНомерБСО = ?(Выборка.КонНомерБСО = "", Число(СокрЛП(Выборка.НачНомерБСО)), Число(СокрЛП(Выборка.КонНомерБСО)));
		НачНомерБСО	= Число(СокрЛП(Выборка.НачНомерБСО));
		
		//Серия равна началу номера с серией убираем ее - оставляем номер
		НомерБСО = Сред(НомерА7, СтрДлина(СерияБСО) + 1);
		
		Попытка
			чНомерБСО = Число(НомерБСО)
		Исключение
			Продолжить
		КонецПопытки;
		
		Если чНомерБСО >= НачНомерБСО И чНомерБСО <= КонНомерБСО Тогда
			//нашли
			НомерКвитанции = НомерБСО;
			СерияКвитанции = СерияБСО;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ПолучитьСериюИНомерКвитанцииА7()

