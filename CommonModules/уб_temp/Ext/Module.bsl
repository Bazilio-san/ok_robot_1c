Функция РуководительПодразделенияПоАгенту(Агент, Дата = Неопределено, Знач ТипРезультата = "структура") Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата()
	КонецЕсли;
	ТипРезультата = Лев(НРег(ТипРезультата), 3);
	Если ТипРезультата = "стр" Тогда
		Результат = Новый Структура;
		Результат.Вставить("Руководитель", 	Справочники.ФизическиеЛица.ПустаяСсылка());
		Результат.Вставить("Заместитель", 	Справочники.ФизическиеЛица.ПустаяСсылка());
	Иначе
		Результат = Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДФЛ.Подразделение
	|ПОМЕСТИТЬ ВТПодразделение
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&Период, Агент = &Агент) КАК ДФЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РП.Сотрудник,
	|	РП.Заместитель
	|ИЗ
	|	ВТПодразделение КАК ВТПодразделение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Период, &УсловиеВТ) КАК РП
	|		ПО (РП.Подразделение = ВТПодразделение.Подразделение)
	|ГДЕ
	|	НЕ РП.Уход";
	Если ТипРезультата = "стр" Тогда
		СтрокаЗаменыВТ = "ИСТИНА"
	ИначеЕсли ТипРезультата = "зам" Тогда
		СтрокаЗаменыВТ = "Заместитель"
	Иначе
		СтрокаЗаменыВТ = "НЕ Заместитель"
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеВТ", СтрокаЗаменыВТ);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Агент",	Агент);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ТипРезультата = "стр" Тогда
				Если Выборка.Заместитель Тогда
					Результат.Заместитель 	= Выборка.Сотрудник
				Иначе
					Результат.Руководитель  = Выборка.Сотрудник
				КонецЕсли;
			Иначе
				Результат = Выборка.Сотрудник
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // РуководительПодразделенияПоАгенту()

Функция КонтактнаяИнформация(Объект, ВидКИ, Знач Период = Неопределено, Предупреждать = Ложь, ВключаяУволенных = Ложь) Экспорт
	
	Рез = "";
	КИНезаполнено = Ложь;
	Если ЗначениеЗаполнено(Объект) И ЗначениеЗаполнено(ВидКИ) Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = "";
		ЭтоФизЛицо = ТипЗнч(Объект) = Тип("СправочникСсылка.ФизическиеЛица") И Не ВключаяУволенных;
		Если ЭтоФизЛицо Тогда
			Запрос.Текст =
			"ВЫБРАТЬ
			|	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
			|	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие КАК Выбытие
			|ПОМЕСТИТЬ ДвижениеФизлиц
			|ИЗ
			|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&Период, Агент = &Объект) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК Представление,
			|	ДвижениеФизлиц.Выбытие
			|ИЗ
			|	ДвижениеФизлиц КАК ДвижениеФизлиц
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|		ПО (КонтактнаяИнформация.Объект = ДвижениеФизлиц.Агент)
			|			И (КонтактнаяИнформация.Тип = &ВидКИ)";
			Если Период = Неопределено Тогда
				Период = ТекущаяДата()
			КонецЕсли;
			Запрос.УстановитьПараметр("Период", Период);
		Иначе
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтактнаяИнформация.Представление
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Объект = &Объект
			|	И КонтактнаяИнформация.Тип = &ВидКИ";
		КонецЕсли;
		Запрос.УстановитьПараметр("Объект", Объект);
		Запрос.УстановитьПараметр("ВидКИ",	ВидКИ);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ЭтоФизЛицо И Выборка.Выбытие Тогда
				Если Предупреждать Тогда
					#Если Клиент Тогда
						Предупреждение(Строка(Объект) + " не работает на дату " + ТекущаяДата());
					#КонецЕсли
				КонецЕсли;
			ИначеЕсли ПустаяСтрока(Выборка.Представление) Тогда
				КИНезаполнено = Истина
			Иначе
				Рез = Выборка.Представление;
			КонецЕсли;
		Иначе
			Если Не ЭтоФизЛицо Тогда
				КИНезаполнено = Истина
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	#Если Клиент Тогда
		Если Предупреждать И КИНезаполнено Тогда
			Заг = "Необходимо указать " + ВидКИ;
			СОО = "Не найден """ + ВидКИ + """ для '" + Объект + "'
			|
			|Зайдите в справочник объекта и внесите необходимые данные.
			|
			|Открыть форму?";
			Ответ = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Форма = Объект.ПолучитьФорму();
				//параметры, обрабатываемые самой формой для выделения поля с видом КИ при открытии
				Параметры = Новый Структура("ВыделитьКИ", ВидКИ);
				Форма.Параметры = Параметры;
				Форма.ОткрытьМодально();
				Рез = КонтактнаяИнформация(Объект, ВидКИ,, Ложь, ВключаяУволенных);
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
	Возврат Рез;
	
КонецФункции // КонтактнаяИнформацияФизлицаПоФизлицуИлиПользователю()

Функция СтруктураПараметровДобавленияКнопокДействийПоУмолчанию() Экспорт
	
	Возврат Новый Структура("КнопкаРазблокировки, КнопкаСкрытыеРеквизиты", Ложь, Истина);
	
