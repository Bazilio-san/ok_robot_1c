//записывает в параметр сеанса флаг об успешности инициализации компоненты падежей
Процедура ИнициализацияКомпонентыПадежей(Сообщить = Ложь) Экспорт
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьКомпонентуСклоненияПадежей = Истина Тогда
		Если ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина Тогда
			//Попытка инициализировать на клиенте, иначе на сервере не получится в любом случае
			Попытка
				Компонента = Новый COMОбъект("Padeg.Declension");
				ПараметрыСеанса.уб_КомпонентаПадежейИнициализирована = Истина;
				#Если Клиент Тогда
					Если Сообщить Тогда
						Предупреждение("Компонента падежей инициализирована.")
					КонецЕсли;
				#КонецЕсли
			Исключение
				//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось подключить компоненту склонения для ФИО", ?(Сообщить, "Предупреждение", "НеСообщать"),Истина,,,,"Не удалось подключить компоненту Padeg: " + ОписаниеОшибки());
				ПараметрыСеанса.уб_КомпонентаПадежейИнициализирована = Ложь;
			КонецПопытки;
		Иначе
			//отключаем
			уб_ВызовСервера.УстановитьЗначениеКонстанты("ИспользоватьКомпонентуСклоненияПадежей", Ложь);
			ПараметрыСеанса.уб_КомпонентаПадежейИнициализирована = Ложь;
		КонецЕсли;
	Иначе
		ПараметрыСеанса.уб_КомпонентаПадежейИнициализирована = Ложь
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокПодобныхБСО(СК, ВидБСО, НомерБСО) Экспорт
	
