//возвращает Истина если переданный код - цифра или управляющий символ
//Код 		- код символа
//Вернуть19 - Истина - возвращает код символа, если цифра или управляющий символ, иначе - возвращает код 19. Ложь -  возвращает булево
Функция ЭтоЦифраИлиУправляющийСимволПоКоду(Код, Вернуть19 = Истина, Shift = 0, ЭтоВставкаТекста = Ложь) Экспорт
	
	Если Shift = 2 И Код = 86 Или //если нажат ctrl + V
		Shift = 1 И Код = 45 Тогда //если нажат shift + ins
		ЭтоВставкаТекста = Истина;
		Возврат Код;
	ИначеЕсли Shift = 2 И Код = 65 //если нажат ctrl + A
		Или Shift = 2 И Код = 67 Тогда //если нажат ctrl + C
		Возврат Код;
	КонецЕсли;
	
	МассивУправляющихСимволов = Новый Массив;
	МассивУправляющихСимволов.Добавить(8);//backspace
	МассивУправляющихСимволов.Добавить(9);//tab
	МассивУправляющихСимволов.Добавить(13);//enter
	МассивУправляющихСимволов.Добавить(16);//shift
	МассивУправляющихСимволов.Добавить(17);//ctrl
	МассивУправляющихСимволов.Добавить(35);//end
	МассивУправляющихСимволов.Добавить(36);//home
	МассивУправляющихСимволов.Добавить(37);//←
	МассивУправляющихСимволов.Добавить(38);//↑
	МассивУправляющихСимволов.Добавить(39);//→
	МассивУправляющихСимволов.Добавить(40);//↓
	МассивУправляющихСимволов.Добавить(45);//ins
	МассивУправляющихСимволов.Добавить(46);//del
	
	Если МассивУправляющихСимволов.Найти(Код) <> Неопределено Тогда
		Возврат Код;
	КонецЕсли;
	
	ЭтоЦифра = Не ((Код < 48 Или Код > 57) И (Код < 96 Или Код > 105));//И Код <> 8 И Код <> 13 И Код <> 9
	Если Вернуть19 Тогда
		Результат = ?(ЭтоЦифра, Код, 19);
	Иначе
		Результат = ЭтоЦифра;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // ЭтоЧислоПоКоду()

//получает подменю печати или кнопку печати по умолчанию
//Кнопки - кнопки командной панели
//ТипРезультата. Неопределено - возвращает структурой, либо определить "Подменю" Или "ПоУмолчанию"
Функция КнопкаПечатиИзКнопокКП(Кнопки, ТипРезультата = Неопределено) Экспорт
	
	Если ТипРезультата = Неопределено Тогда
		ИскатьПодменю 		= Истина;
		ИскатьПоУмолчанию   = Истина;
		КнопкаПоУмолчанию	= Неопределено;
		КнопкаПодменю 		= Неопределено;
	ИначеЕсли ТипРезультата = "Подменю" Тогда
		ИскатьПодменю		= Истина;
		ИскатьПоУмолчанию	= Ложь;
		КнопкаПодменю 		= Неопределено;
	ИначеЕсли ТипРезультата = "ПоУмолчанию" Тогда
		ИскатьПодменю		= Ложь;
		ИскатьПоУмолчанию	= Истина;
		КнопкаПоУмолчанию	= Неопределено;
	КонецЕсли;
	Если ИскатьПодменю Или ИскатьПоУмолчанию Тогда
		Для Каждого Кнопка Из Кнопки Цикл
			Если ИскатьПодменю И Кнопка.Подсказка = "Меню выбора печатных форм" Тогда
				Если КнопкаПодменю = Неопределено Тогда
					КнопкаПодменю = Кнопка
				Иначе
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Дублирование подменю печати", ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина)
				КонецЕсли;
				Если Не ИскатьПоУмолчанию Или КнопкаПоУмолчанию <> Неопределено Тогда
					Прервать
				КонецЕсли;
			КонецЕсли;
			Если ИскатьПоУмолчанию И Кнопка.Подсказка = "Печать по умолчанию" Тогда
				Если КнопкаПоУмолчанию = Неопределено Тогда
					КнопкаПоУмолчанию = Кнопка
				Иначе	
					//TODO проверить, сейчас несколько кнопок, и дублирование вполне нормально?	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Дублирование печати по умолчанию", "НеСообщать", Истина)
				КонецЕсли;
				Если Не ИскатьПодменю Или КнопкаПодменю <> Неопределено Тогда
					Прервать
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ТипРезультата = Неопределено Тогда
			//возвращаем структуру
			Результат = Новый Структура("Подменю, ПоУмолчанию", КнопкаПодменю, КнопкаПоУмолчанию)
		ИначеЕсли ТипРезультата = "Подменю" Тогда
			Результат = КнопкаПодменю
		ИначеЕсли ТипРезультата = "ПоУмолчанию" Тогда
			Результат = КнопкаПоУмолчанию
		КонецЕсли
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // КнопкаПечати()



