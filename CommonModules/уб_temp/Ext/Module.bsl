	Функция НайтиПоКэшуВСправочнике(НомерКэша = 111, Подстрока, ВидСправочника = "Контрагенты", КоличествоВТопЛисте = 10, ТипВозвращаемого = "Массив", ВыводитьСообщения = Ложь, ИсключаемыйЭлемент = Неопределено, Соединение = Неопределено) Экспорт
		ОчиститьСообщения();
		
		
		Внешнее = НЕ Соединение=Неопределено;
		
		ЭтоМассив = ТипВозвращаемого ="Массив";
		Если ЭтоМассив Тогда
			Если Внешнее Тогда
				МассивДублей = Соединение.NewObject("Массив");
			Иначе	
				МассивДублей = Новый Массив;
			КонецЕсли;	
		Иначе
			Если Внешнее Тогда
				МассивДублей = Соединение.NewObject("СписокЗначений");
			Иначе	
				МассивДублей = Новый СписокЗначений;
			КонецЕсли;	
		КонецЕсли;
		
		strmatch = Расширение().strmatch;
		Если  strmatch = Неопределено Тогда
			Возврат МассивДублей;
		Иначе	
			strmatch.СравнитьСКэшем(НомерКэша, Строка(Подстрока), КоличествоВТопЛисте);
		КонецЕсли;	
		
		ВидСправочникаВКоде = ВидСправочника="";
		ДлинаКода = 9;
		
		Для СчПодбора = 1 по КоличествоВТопЛисте Цикл
			Имя ="";
			КоэффициентСхожести=0;
			Хэш = Strmatch.ПолучитьИзПодбора(СчПодбора,Имя,КоэффициентСхожести);
			Если ВидСправочникаВКоде Тогда
				ВидСправочника = СокрЛП(Сред(Имя,ДлинаКода+1));
				Код = Лев(Имя,ДлинаКода);
			Иначе	
				Код = Имя;
			КонецЕсли;	
			Если Внешнее Тогда
				Ссылка = Соединение.Справочники[ВидСправочника].НайтиПоКоду(Код);
			Иначе
				Ссылка = Справочники[ВидСправочника].НайтиПоКоду(Код);
			КонецЕсли;	
			
			Если ИсключаемыйЭлемент = Ссылка  Тогда
				Продолжить;
			КонецЕсли;	
			Если ЭтоМассив Тогда
				Если МассивДублей.Найти(Ссылка)= Неопределено Тогда
					
					Если Ссылка.Пустая() Тогда
					Иначе	
						Если ВыводитьСообщения Тогда
							уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("" + Ссылка + "(" + КоэффициентСхожести + ")");
						КонецЕсли;
						МассивДублей.Добавить(Ссылка);
					КонецЕсли;
				КонецЕсли;
			Иначе
				//СписокЗначений
				Если МассивДублей.НайтиПоЗначению(Ссылка)= Неопределено Тогда
					
					Если Ссылка.Пустая() Тогда
					Иначе	
						Если ВыводитьСообщения Тогда
							уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(""+Ссылка+"("+КоэффициентСхожести+")");
						КонецЕсли;	
						МассивДублей.Добавить(Ссылка,Ссылка.Наименование);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		Возврат МассивДублей;
	КонецФункции	
#КонецЕсли


Функция ПолучитьИмяБазыДанных(ПолноеИмя = Истина) Экспорт
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	Если Найти(Врег(СтрокаСоединения), "FILE=") Тогда
		//Файловая версия
		
		ИмяБазы = СтрЗаменить(Сред(СтрокаСоединения,6),";","");
		
	Иначе
		//SQL
		
		СтрокаСоединения = СтрЗаменить(СтрокаСоединения,";",Символы.ПС);
		ИмяСервера = Сред(СтрПолучитьСтроку(СтрокаСоединения,1),6);
		ИмяБазы = Сред(СтрПолучитьСтроку(СтрокаСоединения,2),5);
		
		Если ПолноеИмя Тогда 
			ИмяБазы = ИмяСервера + "/" + ИмяБазы;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИмяБазы;
	
КонецФункции

