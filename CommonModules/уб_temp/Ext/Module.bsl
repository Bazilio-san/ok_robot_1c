//ЧастнаяНастройка - структура для частного заполнения свойств кнопки 
Функция УстановитьСтатусДокумента(ЭтаФорма, ЭтоОткрытие = Ложь, ЧастнаяНастройка = Неопределено) Экспорт
	
	#Если Клиент Тогда		
		Объект = ЭтаФорма.ЭтотОбъект;
		ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
		нСтатус = ЭлементыФормы.Найти("НадписьСтатусДокумента");
		Если нСтатус = Неопределено Тогда
			нСтатус = ЭлементыФормы.Добавить(Тип("Надпись"), "НадписьСтатусДокумента");
			нСтатус.Ширина	= 185;
			нСтатус.Лево	= ЭтаФорма.Ширина - нСтатус.Ширина;
			нСтатус.Высота	= 23;
			нСтатус.Шрифт	= Новый Шрифт(, 10, Истина);
			нСтатус.ГоризонтальноеПоложение	= ГоризонтальноеПоложение.Центр;
			нСтатус.ВертикальноеПоложение	= ВертикальноеПоложение.Центр;
			нСтатус.УстановитьПривязку(ГраницаЭлементаУправления.Лево,	ЭтаФорма.Панель,	ГраницаЭлементаУправления.Право);
			нСтатус.УстановитьПривязку(ГраницаЭлементаУправления.Право,	ЭтаФорма.Панель,	ГраницаЭлементаУправления.Право);
			нСтатус.УстановитьПривязку(ГраницаЭлементаУправления.Верх,	ЭтаФорма.Панель,	ГраницаЭлементаУправления.Верх);
			нСтатус.УстановитьПривязку(ГраницаЭлементаУправления.Низ,	ЭтаФорма.Панель,	ГраницаЭлементаУправления.Верх);
		Иначе
			нСтатус.Шрифт	= Новый Шрифт(, 10, Истина);
			нСтатус.ГоризонтальноеПоложение	= ГоризонтальноеПоложение.Центр;
			нСтатус.ВертикальноеПоложение	= ВертикальноеПоложение.Центр;
			нСтатус.Высота	= 23;
			//нСтатус.Ширина	= 185;
			//нСтатус.Лево	= ЭтаФорма.Ширина - нСтатус.Ширина;
		КонецЕсли;
		Если нСтатус <> Неопределено Тогда
			Если ЧастнаяНастройка <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(нСтатус, ЧастнаяНастройка)
			ИначеЕсли Объект.Проведен Тогда
				Если НЕ ПравоДоступа("ИнтерактивноеИзменениеПроведенных", Объект.Метаданные()) Тогда
					нСтатус.Заголовок	= "Изменение запрещено!";
					нСтатус.ЦветТекста	= ЦветаСтиля["ЦветТекстаПроведен"];
					нСтатус.ЦветФона	= ЦветаСтиля["ЦветФонаПроведен"];
				Иначе	
					нСтатус.Заголовок	= "Проведен";
					нСтатус.ЦветТекста	= ЦветаСтиля["ЦветТекстаПроведен"];
					нСтатус.ЦветФона	= ЦветаСтиля["ЦветФонаПроведен"];
				КонецЕсли;	
				//ИначеЕсли Объект.Проведен И ) Тогда
			ИначеЕсли Объект.ПометкаУдаления Тогда
				нСтатус.Заголовок	= "Помечен на удаление!";
				нСтатус.ЦветТекста	= ЦветаСтиля["ЦветТекстаУдален"];
				нСтатус.ЦветФона	= ЦветаСтиля["ЦветФонаУдален"];
			ИначеЕсли Объект.ЭтоНовый() Тогда
				нСтатус.Заголовок	= "Не записан!";
				нСтатус.ЦветТекста	= ЦветаСтиля["ЦветТекстаНеЗаписан"];
				нСтатус.ЦветФона	= ЦветаСтиля["ЦветФонаНеЗаписан"];
			Иначе
				нСтатус.Заголовок	= "Не проведен!";
				нСтатус.ЦветТекста	= ЦветаСтиля["ЦветТекстаНеПроведен"];
				нСтатус.ЦветФона	= ЦветаСтиля["ЦветФонаНеПроведен"];
			КонецЕсли;
		КонецЕсли;	
	#КонецЕсли
	
КонецФункции	

