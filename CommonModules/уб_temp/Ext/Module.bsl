Функция ПолучитьТЗСерийПоступленияБСО(СК, Реквизит) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПБ." + Реквизит + " КАК Поле,
	|	ПБ.ВидБСО
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК ПБ
	|ГДЕ
	|	ПБ.Ссылка.Поставщик = &СК
	|	И ПБ." + Реквизит + " <> """"");
	Запрос.УстановитьПараметр("СК", СК);
	Возврат Запрос.Выполнить().Выгрузить();
	
