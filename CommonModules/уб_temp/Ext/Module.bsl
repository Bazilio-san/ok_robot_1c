Функция ПреобразоватьВерсиюКонфигурацииВЧисло(Знач Строка) Экспорт
	
	Строка = СокрЛП(Строка);
	ТекНомер = Лев(Строка, 1);
	//обрабатываем второй номер
	Обрез = Сред(Строка, 3);
	Для Индекс = 1 По 2 Цикл
		Инд = Найти(Обрез, ".");
		Если Инд = 2 Тогда
			ТекНомер = ТекНомер + "0" + Лев(Обрез, 1);
			Обрез = Сред(Обрез, 3);
		Иначе
			ТекНомер = ТекНомер + Лев(Обрез, 2);
			Обрез = Сред(Обрез, 4);
		КонецЕсли;
	КонецЦикла;
	ТекНомер = ТекНомер + Лев(Обрез, 1);
	Если СтрДлина(Обрез) = 6 Тогда
		ТекНомер = ТекНомер + Прав(Обрез, 4)
	КонецЕсли;
	Попытка
		Результат = Число(ТекНомер)
	Исключение
		Результат = 0
	КонецПопытки;
	Возврат Результат
	
КонецФункции // ПреобразоватьВерсиюКонфигурацииВЧисло()

Функция СсылкаСправочникаПоНаименованию(Вид,Наименование,Создать = Истина,Владелец =Неопределено,Свойства = Неопределено) Экспорт
	Попытка
		Если Владелец = Неопределено Тогда
			_Ссылка = Справочники[Вид].НайтиПоНаименованию(Наименование,Истина);
		Иначе
			_Ссылка = Справочники[Вид].НайтиПоНаименованию(Наименование,Истина,,Владелец);
		КонецЕсли;	
		Если _Ссылка.Пустая() Тогда
			Если Создать=Истина Тогда
				_Об =  Справочники[Вид].СоздатьЭлемент();
				_Об.Наименование = Наименование;
				Попытка
					Если Не Владелец =Неопределено Тогда
						_Об.Владелец = Владелец;
					КонецЕсли;
				Исключение
				КонецПопытки;	
				Попытка
					Если НЕ Свойства = Неопределено Тогда
						ЗаполнитьЗначенияСвойств(_Об,Свойства);
					КонецЕсли;	
				Исключение
				КонецПопытки;
				
				Попытка
					_Об.Записать();
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("При записи справочника " + Вид + " " + Наименование + " " + ОписаниеОшибки());
				КонецПопытки;
				_Ссылка = _Об.Ссылка;
			Иначе
				_Ссылка = Справочники[Вид].ПустаяСсылка;
			КонецЕсли;
			
		КонецЕсли;	
		Возврат _Ссылка;
	Исключение
	КонецПопытки;	
	
КонецФункции	

