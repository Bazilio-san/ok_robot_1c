#Если Клиент Тогда
	Функция ЕстьСтруктураБСО(СтруктураБСО, Строка) Экспорт
		
		Возврат СтруктураБСО.НомернойУчет И НЕ СтруктураБСО.Существует И СокрЛП(Строка.НомерБСО) <> ""
		
	КонецФункции // ЕстьСтруктураБСО()
	
	Функция ДатаАктуальностиОбъекта(Объект, НаДатуДокумента = Истина) Экспорт
		
		Если НаДатуДокумента Тогда
			Если Объект.ЭтоНовый() Тогда
				Результат = ТекущаяДата()
			Иначе	
				Результат = Объект.МоментВремени().Дата;
			КонецЕсли;
			//Если Ссылка.Пустая() Тогда
			//	Результат = ТекущаяДата()
			//Иначе
			//	Результат = Ссылка.МоментВремени().Дата
			//КонецЕсли;
		Иначе
			Результат = ТекущаяДата()
		КонецЕсли;
		Возврат Результат;
		
	КонецФункции // ДатаАктуальности()
	
	Функция ПолучитьСКДляЗаполнения(
		ИмяДокумента, 
		Поставщик, 
		ВернутьКакСписок 	= Ложь, 
		ПерваяСК 			= Неопределено, 
		НаДату 				= Неопределено
		) Экспорт
		
		//получаем список СК по документам для выбранного поставщика
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Док.СК КАК СК
		|ИЗ
		|	Документ." + ИмяДокумента + ".БСО КАК Док
		|ГДЕ
		|	Док.Ссылка.Поставщик = &Поставщик
		|	И Док.Ссылка.Проведен";
		Запрос.УстановитьПараметр("Поставщик", 	Поставщик);
		Если НаДату <> Неопределено Тогда
			//период актуальности - 1 год от даты документа (или текущей даты)
			Запрос.Текст = Запрос.Текст + "
			|	И Док.Ссылка.Дата > ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -12)";
			Запрос.УстановитьПараметр("Дата", НаДату);
		КонецЕсли;
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СК");
		ПерваяСК = ?(Массив.Количество() > 0, Массив[0], Неопределено);
		Если ВернутьКакСписок Тогда
			СписокЗначений = Новый СписокЗначений;
			СписокЗначений.ЗагрузитьЗначения(Массив);
			Возврат СписокЗначений;	
		Иначе		
			Возврат ПерваяСК;	
		КонецЕсли;	
		
	КонецФункции // ПолучитьСКДляЗаполнения()
	
	Функция ПроверитьНомерБСОНаДубли(БСО, СтруктураПоиска, НомерСтроки) Экспорт
		
		НайденныеСтроки = БСО.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаМ Из НайденныеСтроки Цикл
			Если СтрокаМ.НомерСтроки <> НомерСтроки Тогда
				Возврат Истина
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь
		
	КонецФункции
	
	Процедура СписокВыбораНомерБСО(Форма, Очистить = Ложь) Экспорт
		
		ЭУ = Форма.ТекущийЭлемент.ТекущаяКолонка.ЭлементУправления;
		Если Очистить Тогда
			ЭУ.КнопкаСпискаВыбора = Ложь;
			Возврат;
		КонецЕсли;
		ТекСтрока = Форма.ЭлементыФормы.БСО.ТекущаяСтрока;
		Попытка
			СК = ТекСтрока.СК
		Исключение
			СК = Форма.СК;
			ЭУ.КнопкаСпискаВыбора	= Ложь;
			Возврат;
		КонецПопытки;
		//СК = ?(ТекСтрока.Найти("СК") = Неопределено, Форма.СК, ТекСтрока.СК); 
		Если СК.Пустая() Или ТекСтрока.ВидБСО.Пустая() Или ПустаяСтрока(ТекСтрока.НомерБСО) Тогда
			ЭУ.КнопкаСпискаВыбора = Ложь;
		Иначе
			СписокНомеров = ПолучитьСписокПодобныхБСО(ТекСтрока.СК, ТекСтрока.ВидБСО, ТекСтрока.НомерБСО);
			//TODO заменить 21 на константу
			Если СписокНомеров.Количество() > 0 И СписокНомеров.Количество() < 21 Тогда
				ЭУ.СписокВыбора			= СписокНомеров;
				ЭУ.КнопкаСпискаВыбора 	= Истина;
			Иначе
				ЭУ.КнопкаСпискаВыбора	= Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецПроцедуры
	
	//у страхового полиса - частная процедура обработки активизации ячейки БСО
	Процедура ПриАктивизацииЯчейкиБСО(Форма) Экспорт
		
		ТекЭлемент 		= Форма.ТекущийЭлемент;
		эфБСО   		= Форма.ЭлементыФормы.БСО;
		Если Не Форма.Проведен И ТекЭлемент = эфБСО Тогда
			ТекСтрока 	= эфБСО.ТекущаяСтрока;
			Если ТекСтрока <> Неопределено Тогда
				ТекКолонка 		= эфБСО.ТекущаяКолонка;
				Колонки			= эфБСО.Колонки;
				МетаданныеИмя	= Форма.Ссылка.Метаданные().Имя;
				Если ТекКолонка = Колонки.НомерБСО Тогда
					СтруктураБСО = Форма.ПрочитатьТекущееСостояниеБСО(ТекСтрока); //TODO ПрочитатьТекущееСостояние в общий модуль
					СписокВыбораНомерБСО(Форма, СтруктураБСО = Неопределено Или Не ЕстьСтруктураБСО(СтруктураБСО, ТекСтрока))
				ИначеЕсли ТекКолонка = Колонки.ВидБСО Тогда
					ЭУ = Форма.ТекущийЭлемент.ТекущаяКолонка.ЭлементУправления;
					ЭУ.СписокВыбора = уб_СЛ.ПолучитьСписокВидовБСО(ТекСтрока.СК, Форма.Дата,,,Истина);
					ЭУ.КнопкаСпискаВыбора = ЭУ.СписокВыбора.Количество();
					ЭУ.КнопкаВыбора = Истина;
					ЭУ.ВысотаСпискаВыбора = 20;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецПроцедуры
	
	Процедура УстановитьАктивностьПоляВКолонке(Колонка, Активность)
		
		Колонка.ТолькоПросмотр = Не Активность;	
		Эу = Колонка.ЭлементУправления;
		Эу.ТолькоПросмотр 	= Не Активность;	
		Эу.Доступность 		= Активность;	
		Эу.КнопкаВыбора 	= Активность;	
		Эу.КнопкаОчистки 	= Активность;
		
	КонецПроцедуры
	
	Процедура ПроверитьОткрытиеИзДругойФормы(Форма, Параметр) Экспорт
		
		БСО = Форма.БСО;
		эфБСО = Форма.ЭлементыФормы.БСО;
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			НайденныеСтроки = БСО.НайтиСтроки(Параметр);
			Если НайденныеСтроки.Количество() = 1 Тогда
				эфБСО.ТекущаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
			Параметр = Неопределено;
		КонецЕсли;
		Форма.Активизировать();
	КонецПроцедуры
	
	Процедура УстановитьДоступностьЭлементовФормы2(ЭлементыФормы, Доступность, Общая = Истина) Экспорт
		
		ЭлементыФормы.ДействияФормы.Кнопки.ПодменюДействия.Кнопки.ПодменюУстановитьВремя.Кнопки.дУстановитьВремя.Доступность = Доступность; 
		Если Общая Тогда
			уб_СтраховойБрокер.УстановитьДоступностьЭлементовФормы(ЭлементыФормы, Доступность)
		КонецЕсли;
		
	КонецПроцедуры
	
	
	Процедура ДобавитьСтрокуБСО(Форма, СКДляЗаполнения) Экспорт
		
		ЭлементыФормы = Форма.ЭлементыФормы;
		СтрокаБСО = Форма.БСО.Добавить();
		СтрокаБСО.СК = СКДляЗаполнения;
		ЭлементыФормы.БСО.ТекущаяСтрока 	= СтрокаБСО;
		ЭлементыФормы.БСО.ТекущаяКолонка  	= ?(СКДляЗаполнения = Неопределено, ЭлементыФормы.БСО.Колонки.СК, ЭлементыФормы.БСО.Колонки.ВидБСО);
		
	КонецПроцедуры
	
	Процедура УдалитьСтарыеКнопкиПоУмолчанию(Форма, ОсновныеДействияФормы)
		
		ТабПФ = Форма.ТабПФ;
		КоличествоСтрок = ТабПФ.Количество();
		Для Счетчик = 1 По КоличествоСтрок Цикл
			СтрокаТЗ = ТабПФ[КоличествоСтрок - Счетчик];
			Если СтрокаТЗ.ПоУмолчанию = Истина Или СтрокаТЗ.СсылкаПФ = Неопределено Тогда
				Элемент = ОсновныеДействияФормы.Кнопки.Найти(СтрокаТЗ.КодПФ);
				Если Элемент <> Неопределено Тогда
					ОсновныеДействияФормы.Кнопки.Удалить(Элемент);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецПроцедуры
	
	//устанавливает кнопки печати, печати по умолчанию и формирует значения экспортных переменных печати формы
	//Форма 	- ЭтаФорма
	//Ссылка    - устанавливается вручную при использовании ПолучитьСсылкуНового(), например
	//ПолучатьСтруктуруПечатныхФормИзОбщегоМодуля - Истина - при использовании справочника печатных форм с помощью универсального запроса, Ложь - из модуля объекта формы
	Процедура УстановитьКнопкиПечати(
		Форма,
		Ссылка										= Неопределено,
		ПолучатьСтруктуруПечатныхФормИзОбщегоМодуля = Истина,
		УстановитьПодменюПечати                     = Истина,
		УстановитьПечатьПоУмолчанию					= Истина,
		ИмяНадписиАвтор								= "НадписьАвтор",
		ДобавлятьСубагентскиеПФ						= Ложь
		) Экспорт
		
		ОсновныеДействияФормы	= Форма.ЭлементыФормы.ОсновныеДействияФормы;
		Объект					= Форма.ЭтотОбъект;
		Если Ссылка = Неопределено Тогда
			Ссылка = Объект.Ссылка;
		КонецЕсли;
		//+расчет количества кнопок по умолчанию
		ШиринаОсновныхКнопокДокумента = 200;//Ширинка кнопок (Печать|Ок|Записать|Закрыть)
		ШиринаОднойКнопкиПоУмолчанию  = 100;
		ЭлементНадписьАвтор = Форма.ЭлементыФормы.Найти(ИмяНадписиАвтор);
		Если ЭлементНадписьАвтор <> Неопределено Тогда
			ШиринаНадписиАвтора = ЭлементНадписьАвтор.Ширина;
		Иначе
			ШиринаНадписиАвтора = 0;
		КонецЕсли;
		ШиринаДопЭлементов = 0;
		МаксимальноеКоличествоКнопокПоУмолчанию = Цел((Форма.Ширина - ШиринаНадписиАвтора - ШиринаОсновныхКнопокДокумента - ШиринаДопЭлементов) / ШиринаОднойКнопкиПоУмолчанию);
		МаксимальноеКоличествоКнопокПоУмолчанию = Макс(МаксимальноеКоличествоКнопокПоУмолчанию, 1);
		//-расчет количества кнопок по умолчанию
		Если МаксимальноеКоличествоКнопокПоУмолчанию > 1 И Форма.ТабПФ <> Неопределено Тогда
			УдалитьСтарыеКнопкиПоУмолчанию(Форма, ОсновныеДействияФормы);
		КонецЕсли;
		//Форма.ТабПФ = ?(ПолучатьСтруктуруПечатныхФормИзОбщегоМодуля, уб_ПФ.ПолучитьСтруктуруПечатныхФорм(Объект), Форма.ПолучитьСтруктуруПечатныхФорм());
		Если ПолучатьСтруктуруПечатныхФормИзОбщегоМодуля Тогда
			Форма.ТабПФ = уб_ПФ.ПолучитьСтруктуруПечатныхФорм(Объект,, ДобавлятьСубагентскиеПФ);
		Иначе
			Форма.ТабПФ = Форма.ПолучитьСтруктуруПечатныхФорм();
		КонецЕсли;
		Форма.мДеревоМакетов = РаботаСДиалогами.ПолучитьДеревоМакетовПечати(Ссылка, Форма.ТабПФ, Новый Действие("ОсновныеДействияФормыПечать"), Новый Действие("ОсновныеДействияФормыУстановитьПечатьПоУмолчанию"), Не МаксимальноеКоличествоКнопокПоУмолчанию > 1);
		Для каждого СтрокаДерева из Форма.мДеревоМакетов.Строки Цикл
			Если СтрокаДерева.ТипКнопки = ТипКнопкиКоманднойПанели.Действие Тогда
				Если Форма.ТабПФ.НайтиСтроки(Новый Структура("КодПФ",СтрокаДерева.Имя)).Количество() = 0 Тогда
					 //СтрТабПФ = Форма.ТабПФ.Добавить();
					 //СтрТабПФ.КодПФ			= СтрокаДерева.Имя;
					 //СтрТабПФ.Наименование	= СтрокаДерева.Текст;
					 //СтрТабПФ.ПоУмолчанию = Истина;
					 //СтрТабПФ.Действовала = Ложь;
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЦикла;
		Если УстановитьПодменюПечати Тогда
			//проверяем есть ли уже созданная кнопка печати по умолчанию для правильного расположения подменю и печати по умолчанию
			РаботаСДиалогами.УстановитьПодменюПечати(Форма.мПодменюПечати, ОсновныеДействияФормы, Форма.мДеревоМакетов.Строки.Количество() > 0);
			Если Форма.мПодменюПечати <> Неопределено Тогда
				РаботаСДиалогами.СформироватьПодменю(Форма.мДеревоМакетов, Форма.мПодменюПечати, Истина, Истина, Не МаксимальноеКоличествоКнопокПоУмолчанию > 1);
			КонецЕсли;
		Иначе
			//удаляем подменю если есть
			Кнопки = ОсновныеДействияФормы.Кнопки;
			Кнопка = КнопкаПечатиИзКнопокКП(Кнопки, "Подменю");
			Если Кнопка <> Неопределено Тогда
				Индекс = Кнопки.Индекс(Кнопка);
				Кнопки.Удалить(Индекс);
				//удаляем связанный разделитель
				Если Кнопки[Индекс].ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель Тогда
					Кнопки.Удалить(Индекс);
				КонецЕсли;
			КонецЕсли;
			Форма.мПодменюПечати = Неопределено;
		КонецЕсли;
		Если УстановитьПечатьПоУмолчанию Тогда
			Если МаксимальноеКоличествоКнопокПоУмолчанию > 1 Тогда
				РаботаСДиалогами.УстановитьКнопкиПечатьПоУмолчанию(ОсновныеДействияФормы, Форма.мДеревоМакетов, Объект.Метаданные().Имя, Новый Действие("ОсновныеДействияФормыПечатьПоУмолчанию"), МаксимальноеКоличествоКнопокПоУмолчанию, Форма);
			Иначе
				РаботаСДиалогами.УстановитьПечатьПоУмолчанию(Форма.мПечатьПоУмолчанию, ОсновныеДействияФормы, Форма.мДеревоМакетов, Объект.Метаданные().Имя, Новый Действие("ОсновныеДействияФормыПечатьПоУмолчанию"));
			КонецЕсли;
		Иначе
			//удаляем печать по умолчанию если есть
			Кнопки = ОсновныеДействияФормы.Кнопки;
			Кнопка = КнопкаПечатиИзКнопокКП(Кнопки, "ПоУмолчанию");
			Если Кнопка <> Неопределено Тогда
				Индекс = Кнопки.Индекс(Кнопка);
				Кнопки.Удалить(Индекс);
				//удаляем связанный разделитель
				Если Кнопки[Индекс].ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель Тогда
					Кнопки.Удалить(Индекс);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецПроцедуры
	
//чкн
// подбор номерных БСО

Процедура ПодборНомерныхБСО(Форма, СтрокаТЧ = Неопределено, Параметры) Экспорт
	
	ЭлементыФормы = Форма.ЭлементыФормы;
	ФормаВыбора = ПолучитьОбщуюФорму("уб_ПодборБСО", ЭлементыФормы.БСО);
	ОтображаемыеКолонки = Новый СписокЗначений;
	ОтображаемыеКолонки.Добавить("СостояниеБСО");	
	ОтображаемыеКолонки.Добавить("НомерПолиса");	
	ОтображаемыеКолонки.Добавить("Агент");	
	ОтображаемыеКолонки.Добавить("ПоложениеБСО");	
	ОтображаемыеКолонки.Добавить("Блокировка");	
	ОтображаемыеКолонки.Добавить("Поставщик");	
	ОтображаемыеКолонки.Добавить("ОрганизацияАгент");			
	НаМомент = ЭлементыФормы.Дата;
	СписокПоложений = ПолучитьСписокДоступныхПоложений();
	Параметры.Вставить("НаМомент", НаМомент);
	Параметры.Вставить("ПоложениеБСО", СписокПоложений);
	Если Параметры.Свойство("СостояниеБСО") тогда
		СписокСостояний = СписокДоступныхСостояний();
		Параметры.Вставить("СостояниеБСО", СписокСостояний);
	КонецЕсли;
	Если Параметры.Свойство("Агент") тогда
		Агент = ЭлементыФормы.Агент;
		Параметры.Вставить("Агент", Агент);
	КонецЕсли;	
	
	Если СтрокаТЧ = Неопределено Тогда
		Если ЭлементыФормы.Найти("СКДляЗаполнения") = Неопределено тогда
			Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("ОткрыватьФормуВыбораСКВВПеремещенииБСО", Ложь) Тогда
				ФвСК = ПолучитьОбщуюФорму("уб_ФормаВыбораСК");
				ФвСК.ОткрытьМодально();
				СК = ФвСК.СК;
				Если ЗначениеЗаполнено(СК) Тогда
					Параметры.Вставить("СК", СК);
				КонецЕсли;
			КонецЕсли;
			Параметры.Вставить("МножественныйВыбор", Истина);
		Иначе
			Если Не ЭлементыФормы.СКДляЗаполнения.Пустая() Тогда
				СК = ЭлементыФормы.СКДляЗаполнения
			ИначеЕсли уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("ОткрыватьФормуВыбораСКВВПеремещенииБСО", Ложь) Тогда
				ФвСК = ПолучитьОбщуюФорму("уб_ФормаВыбораСК");
				ФвСК.ОткрытьМодально();
				СК = ФвСК.СК;
			КонецЕсли;
			Если ЗначениеЗаполнено(СК) Тогда
				Параметры.Вставить("СК", СК);
			КонецЕсли;
			Параметры.Вставить("МножественныйВыбор", Истина);
		КонецЕсли;
	Иначе
		Параметры.Вставить("СК", СтрокаТЧ.СК);
		ТекКолонка = ЭлементыФормы.БСО.ТекущаяКолонка;
		УстанавливатьПараметрВидБСО = Истина;
		Если ЭлементыФормы.БСО.Колонки.Найти("НомерПолиса") = Неопределено тогда
			Параметры.Вставить("СК", 					СтрокаТЧ.СК);
			Параметры.Вставить("ВидБСО",    			СтрокаТЧ.ВидБСО);
			Параметры.Вставить("ТекНомерБСО",			СтрокаТЧ.НомерБСО);
			Параметры.Вставить("МножественныйВыбор", 	Ложь);
		Иначе
			Если ТекКолонка <> ЭлементыФормы.БСО.Колонки.НомерПолиса Тогда
				Если ПустаяСтрока(СтрокаТЧ.НомерПолиса) Тогда
					ТекНомерБСО = СтрокаТЧ.НомерБСО;
				Иначе
					ТекНомерБСО = СтрокаТЧ.НомерПолиса;
					УстанавливатьПараметрВидБСО = Ложь;
				КонецЕсли;
			Иначе
				ТекНомерБСО = СтрокаТЧ.НомерБСО
			КонецЕсли;
			Если УстанавливатьПараметрВидБСО Тогда
				Параметры.Вставить("ВидБСО", СтрокаТЧ.ВидБСО)
			КонецЕсли;
			Параметры.Вставить("ТекНомерБСО", ТекНомерБСО);
			Параметры.Вставить("МножественныйВыбор", Ложь);
		КонецЕсли;
	КонецЕсли;
	Параметры.Вставить("ОтображаемыеКолонки", ОтображаемыеКолонки);
	ФормаВыбора.Параметры = Параметры;
	ФормаВыбора.Открыть();
		
КонецПроцедуры

