Процедура СоздатьКнопкуПоискСсылок(ПутьККнопке)
	
	#Если Клиент Тогда
		Разделитель = ПутьККнопке.Добавить();
		Разделитель.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		Кнопка = ПутьККнопке.Добавить();
		Кнопка.Доступность 	= Истина;
		Кнопка.Имя 			= "ПоискСсылокНаОбъект";
		Кнопка.ТипКнопки 	= ТипКнопкиКоманднойПанели.Действие;
		Кнопка.Действие 	= Новый Действие("ОбработчикДопКнопокДействийФормы");
		Кнопка.Текст		= "Поиск ссылок на объект";
		Кнопка.Картинка 	= БиблиотекаКартинок.Найти;
		Кнопка.Подсказка	= "Поиск ссылок на объект";
	#КонецЕсли
	
КонецПроцедуры

Процедура СоздатьКнопкуСтруктураПодчиненности(ПутьККнопке) Экспорт
	
	#Если Клиент Тогда
		
		Разделитель = ПутьККнопке.Добавить();
		Разделитель.ТипКнопки = ТипКнопкиКоманднойПанели.Разделитель;
		
		Кнопка = ПутьККнопке.Добавить();
		Кнопка.Доступность = Истина;
		Кнопка.Имя = "СтруктураПодчиненности";
		Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Действие;
		Кнопка.Действие = Новый Действие("ОбработчикДопКнопокДействийФормы");
		Кнопка.Текст = "Структура подчиненности";
		Кнопка.Картинка = БиблиотекаКартинок.СтруктураПодчиненностиДокумента;
		Кнопка.Подсказка = "Открывает структуру подчиненности документа";
		Кнопка.Доступность = Истина;
		
	#КонецЕсли
	
КонецПроцедуры

#Если Клиент Тогда
Процедура ОбработатьСобытиеДействийФормы(Кнопка, ТабличноеПолеСсылка, ФормаИсточник, ИдентификаторИсточника) Экспорт
	
	ИмяКнопки = Кнопка.Имя;	
	Если ИмяКнопки = "СкрытыеРеквизиты" Тогда
		Попытка
			ВидимостьКолонок(ТабличноеПолеСсылка,Кнопка);
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка при установке видимости колонок "
			+ ФормаИсточник + Символы.ПС + "Технические детали ошибки: " + ОписаниеОшибки());				
		КонецПопытки;	
	ИначеЕсли ИмяКнопки = "СтруктураПодчиненности" Тогда
		Если ТипЗнч(ТабличноеПолеСсылка) = Тип("ТабличноеПоле") Тогда
			Если Не ТабличноеПолеСсылка.ТекущиеДанные = Неопределено Тогда
				Ссылка = ТабличноеПолеСсылка.ТекущиеДанные.Ссылка
			Иначе
				Ссылка = Неопределено;
			КонецЕсли;	
		Иначе
			Ссылка = ТабличноеПолеСсылка
		КонецЕсли;		
		Если Ссылка <> Неопределено Тогда
			РаботаСДиалогами.ПоказатьСтруктуруПодчиненностиДокумента(Ссылка);
		КонецЕсли
	ИначеЕсли Лев(ИмяКнопки, 9)= "Помощник_" Тогда
		ОбработатьНажатиеКнопкиПомощника(Кнопка, ФормаИсточник);
	ИначеЕсли Лев(ИмяКнопки, 14) = "СкрытьПоказать" Тогда
		СкрытьПоказатьПоля(Кнопка, ФормаИсточник);
	ИначеЕсли Найти(ИмяКнопки,"ВызовСправкиHTML")= 1 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	уб_СправкаСтраницы.URL,
		|	уб_СправкаСтраницы.Имя,
		|	уб_СправкаСтраницы.СетевойПутьКСтранице
		|ИЗ
		|	Справочник.уб_Справка.Страницы КАК уб_СправкаСтраницы
		|ГДЕ
		|	уб_СправкаСтраницы.Ссылка.Наименование = &ИдентификаторИсточника
		|	И НЕ уб_СправкаСтраницы.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	уб_СправкаСтраницы.НомерСтроки";
		Запрос.УстановитьПараметр("ИдентификаторИсточника", ИдентификаторИсточника);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СправкаHTML(Выборка.URL, Истина, Выборка.СетевойПутьКСтранице);
		Иначе
			СправкаHTML(ИдентификаторИсточника);
		КонецЕсли;
	ИначеЕсли ИмяКнопки = "СканерШК" Тогда
		Кнопка.Пометка = НЕ Кнопка.Пометка;
		уб_ШК.УстановитьСостояниеСканераШК(Кнопка);	
	ИначеЕсли ИмяКнопки = "РучнойВводШтрихкода" Тогда
		уб_ШК.РучнойВводШтрихкода(ФормаИсточник, Ложь);
	ИначеЕсли ИмяКнопки = "ПоискСсылокНаОбъект" Тогда
		Если ТипЗнч(ТабличноеПолеСсылка) = Тип("ТабличноеПоле") Тогда
			Если Не ТабличноеПолеСсылка.ТекущиеДанные = Неопределено Тогда
				Ссылка = ТабличноеПолеСсылка.ТекущиеДанные.Ссылка
			КонецЕсли;
		Иначе
			Ссылка = ТабличноеПолеСсылка
		КонецЕсли;		
		Если Ссылка <> Неопределено Тогда
			Массив = Новый Массив;
			Массив.Добавить(Ссылка);
			//при отсутствии права чтения на какойлибо объект вызывается исключение
			Попытка
				ТЗБезФильтра = НайтиПоСсылкам(Массив);
			Исключение
			КонецПопытки;
			Если ТЗБезФильтра <> Неопределено Тогда
				ТЗ = ТЗБезФильтра.СкопироватьКолонки();
				Для Каждого СтрокаТЗ Из ТЗБезФильтра Цикл
					Если Найти(СтрокаТЗ.Данные, "РегистрСведенийКлючЗаписи") = 0 Тогда
						Стр = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(Стр, СтрокаТЗ);
					КонецЕсли;
				КонецЦикла;
				Фрм = ПолучитьОбщуюФорму("уб_ФормаПросмотраТЗ");
				Фрм.ТаблицаЗначений = ТЗ;
				Фрм.ТолькоПросмотр 	= Истина;
				Фрм.ОткрытьМодально();
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли Лев(ИмяКнопки,4)="xxx_" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	уб_СправкаСтраницы.URL,
		|	уб_СправкаСтраницы.Имя,
		|	уб_СправкаСтраницы.СетевойПутьКСтранице
		|ИЗ
		|	Справочник.уб_Справка.Страницы КАК уб_СправкаСтраницы
		|ГДЕ
		|	уб_СправкаСтраницы.Имя ПОДОБНО &ИмяКнопки
		|	И НЕ уб_СправкаСтраницы.Ссылка.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИмяКнопки", ИмяКнопки);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СправкаHTML(Выборка.URL, Истина, Выборка.СетевойПутьКСтранице);
		КонецЕсли;	
	ИначеЕсли Лев(ИмяКнопки, 3) = "кн_" Тогда
		//это кнопка определенной группировки
		Уровень = Число(Кнопка.Заголовок); // здесь записан нужный уровень
		ФормаИсточник.ЭлементыФормы[ТабличноеПолеСсылка].ПоказатьУровеньГруппировокСтрок(Уровень - 1);
		ФормаИсточник.ТекущийЭлемент = ФормаИсточник.ЭлементыФормы[ТабличноеПолеСсылка];
	КонецЕсли;
	
КонецПроцедуры
#КонецЕсли

//Функция производит поисх похожих по наименованию Физлиц с учетом веса вхождения
Функция ПолучитьСписокПохожихФизлиц (ФИО, КакМассив = Ложь, ЗапроС = Неопределено, Получатель = Неопределено) Экспорт
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос;
	Конецесли;	
	МассивПодстрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ФИО," ");		
	ТекстЗапроса = "ВЫБРАТЬ
	|	Вложенный.Ссылка,
	|	Вложенный.Вес
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1000
	|		ФизическиеЛица.Ссылка КАК Ссылка,
	|		ВЫБОР
	|			КОГДА ФизическиеЛица.Наименование ПОДОБНО &Фамилия
	|				ТОГДА 3
	|			ИНАЧЕ 0
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ФизическиеЛица.Наименование ПОДОБНО &Имя
	|				ТОГДА 2
	|			ИНАЧЕ 0
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ФизическиеЛица.Наименование ПОДОБНО &Отчество
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Вес
	|	ИЗ
	|		Справочник.ФизическиеЛица КАК ФизическиеЛица
	|	ГДЕ (ФизическиеЛица.Наименование ПОДОБНО &Фамилия
	|				ИЛИ ФизическиеЛица.Наименование ПОДОБНО &Имя
	|				ИЛИ ФизическиеЛица.Наименование ПОДОБНО &Отчество)
	|		
	|	
	|	УПОРЯДОЧИТЬ ПО
	|		Вес УБЫВ) КАК Вложенный
	|ГДЕ
	|	Вложенный.Вес >= &Вес";
	ВсегоПодСтрок = МассивПодстрок.Количество();
	Если ВсегоПодСтрок >=3 Тогда
		//
		Запрос.УстановитьПараметр("Фамилия",  МассивПодстрок[0]+"%");
		Запрос.УстановитьПараметр("Имя",      "%"+МассивПодстрок[1]+"%");
		Запрос.УстановитьПараметр("Отчество", "%"+МассивПодстрок[2]+"%");
		Запрос.УстановитьПараметр("Вес",4);
	ИначеЕсли ВсегоПодСтрок = 2 Тогда		   
		//
		Запрос.УстановитьПараметр("Фамилия",  МассивПодстрок[0]+"%");
		Запрос.УстановитьПараметр("Имя",      "%"+МассивПодстрок[1]+"%");
		Запрос.УстановитьПараметр("Отчество", "9876");
		Запрос.УстановитьПараметр("Вес",3);
	ИначеЕсли ВсегоПодСтрок = 1 Тогда		   		
		Запрос.УстановитьПараметр("Фамилия",  МассивПодстрок[0]+"%");
		Запрос.УстановитьПараметр("Имя",      "9876");
		Запрос.УстановитьПараметр("Отчество", "9876");
		Запрос.УстановитьПараметр("Вес",3);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;		   
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Массив = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Ссылка);
		Если НЕ Получатель = НЕопределено и КакМассив Тогда
			Получатель.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;	
	
	Если НЕ КакМассив Тогда
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(Массив);
		Если НЕ Получатель = НЕопределено Тогда
			Для каждого ЭлемЗнч из Список Цикл
				Получатель.Добавить(ЭлемЗнч.Значение,ЭлемЗнч.Представление,ЭлемЗнч.Пометка);
			КонецЦикла;	
		КонецЕсли;
		Возврат Список;
	Иначе	
		Возврат Массив;
	КонецЕсли;	
	
КонецФункции	

#Если Клиент Тогда	
	Процедура СгенерироватьКнопкиУправленияГруппировкой(ЭлементыФормы, ИмяТабличногоДокумента, Панель = "") Экспорт
		
		НачалоВерх = 0;
		НачалоЛево = 0;
		
		Если Панель <> "" Тогда
			НачалоВерх = ЭлементыФормы[Панель].Верх + ЭлементыФормы[ИмяТабличногоДокумента].Верх + 3;
			НачалоЛево = ЭлементыФормы[Панель].Лево + ЭлементыФормы[ИмяТабличногоДокумента].Лево + 3;
		Иначе
			НачалоВерх = ЭлементыФормы[ИмяТабличногоДокумента].Верх + 3; // Привязка к верхнему левому углу ПоляТабличногоДокумента
			НачалоЛево = ЭлементыФормы[ИмяТабличногоДокумента].Лево + 3; // Привязка к верхнему левому углу ПоляТабличногоДокумента
		КонецЕсли;
		
		ШагКнопок      = 13;
		ПрефиксИмениКн = "кн_";
		
		// Удалить старые кнопки
		Сч = 0;
		Пока Сч < ЭлементыФормы.Количество() Цикл
			ТекЭлемент = ЭлементыФормы.Получить(Сч);
			Если Найти(ТекЭлемент.Имя, ПрефиксИмениКн) > 0 Тогда
				ЭлементыФормы.Удалить(ТекЭлемент);
			Иначе
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
		
		// Добавить новые кнопки по количеству группировок
		КоличествоГруппировок = ЭлементыФормы[ИмяТабличногоДокумента].КоличествоУровнейГруппировокСтрок();
		Для Сч = 1 По КоличествоГруппировок Цикл
			НоваяКнопка = ЭлементыФормы.Добавить(Тип("Кнопка"), ПрефиксИмениКн + Сч + "_" + ИмяТабличногоДокумента);
			НоваяКнопка.Верх      = НачалоВерх;
			НоваяКнопка.Лево      = НачалоЛево + (ШагКнопок * (Сч - 1));
			НоваяКнопка.Высота    = 12;
			НоваяКнопка.Ширина    = 12;
			НоваяКнопка.Шрифт     = Новый Шрифт("Шрифт диалогов и меню", 7);
			НоваяКнопка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			НоваяКнопка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
			НоваяКнопка.Заголовок = "" + Сч;
			НоваяКнопка.СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша["_"+сч], Истина, Ложь, Ложь);  
			НоваяКнопка.УстановитьДействие("Нажатие", Новый Действие("ОбработчикДопКнопокДействийФормы"));
			НоваяКнопка.УстановитьПривязку(ГраницаЭлементаУправления.Верх, ЭлементыФормы[ИмяТабличногоДокумента], ГраницаЭлементаУправления.Верх);
			НоваяКнопка.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ЭлементыФормы[ИмяТабличногоДокумента], ГраницаЭлементаУправления.Верх);
			НоваяКнопка.УстановитьПривязку(ГраницаЭлементаУправления.Право, ЭлементыФормы[ИмяТабличногоДокумента], ГраницаЭлементаУправления.Лево);
			НоваяКнопка.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ЭлементыФормы[ИмяТабличногоДокумента], ГраницаЭлементаУправления.Лево);
		КонецЦикла;
		
	КонецПроцедуры //СгенерироватьКнопкиУправленияГруппировкой()
	
	Процедура ДобавитьКолонтитулыВТабличныйДокумент(ТабличноеПоле) Экспорт
		
		ТабличноеПоле.РазмерКолонтитулаСверху = 6;
		ВКлн = ТабличноеПоле.ВерхнийКолонтитул;
		ВКлн.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ВКлн.НачальнаяСтраница = 1;
		ВКлн.Выводить = Истина;
		
		ВКлн.ТекстСправа = " стр. [&НомерСтраницы] из [&СтраницВсего]";
		ВКлн.Шрифт = Новый Шрифт(,7);
		
		ТабличноеПоле.РазмерКолонтитулаСнизу = 8;
		HКлн = ТабличноеПоле.НижнийКолонтитул;
		HКлн.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
		HКлн.НачальнаяСтраница = 1;
		HКлн.Выводить = Истина;
		HКлн.ТекстСправа = "ITC:УБ v." + Метаданные.Версия + "." + Формат(ТекущаяДата(),"ДФ=yyMMdd.HHmm");
		HКлн.Шрифт = Новый Шрифт(,7);
		
	КонецПроцедуры
#КонецЕсли

