Функция ПроверитьНаличиеНомераПолиса(Период, СК, ВидБСО, НомерПолиса, УбратьЭтотПараметр = Истина) Экспорт
	
	//Возврат Истина;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Вложенный.НомерПолиса,
	|	МАКСИМУМ(Вложенный.ЕстьСвободныйНомер) КАК ЕстьСвободныйНомер,
	|	МАКСИМУМ(Вложенный.ЕстьВРегистреДвижений) КАК ЕстьВРегистреДвижений,
	|	ЕСТЬNULL(уб_ВидыБСО.Ссылка, &ВидБСО) КАК ВидБСО,
	|	ЕСТЬNULL(уб_ВидыБСО.Тип, ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис)) КАК Тип,
	|	ЕСТЬNULL(уб_ВидыБСО.ТипУчетаБСО, ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.НомернойПолисВручную)) КАК ТипУчетаБСО,
	|	ЕСТЬNULL(уб_ВидыБСО.УниверсальноеБСО, ЛОЖЬ) КАК УниверсальноеБСО
	|ИЗ
	|	(ВЫБРАТЬ
	|		"""" КАК ВидБСО,
	|		уб_СвободныеНомераПолисов.НомерПолиса КАК НомерПолиса,
	|		ИСТИНА КАК ЕстьСвободныйНомер,
	|		ЛОЖЬ КАК ЕстьВРегистреДвижений
	|	ИЗ
	|		РегистрСведений.уб_СвободныеНомераПолисов КАК уб_СвободныеНомераПолисов
	|	ГДЕ
	|		уб_СвободныеНомераПолисов.Период < &Дата
	|		И уб_СвободныеНомераПолисов.НомерПолиса = &НомерПолиса
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		уб_ДвиженияБСО.ВидБСО,
	|		уб_ДвиженияБСО.НомерПолиса,
	|		ЛОЖЬ,
	|		ИСТИНА
	|	ИЗ
	|		РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	|	ГДЕ
	|		уб_ДвиженияБСО.ВидБСО = &ВидБСО
	|		И уб_ДвиженияБСО.НомерПолиса = &НомерПолиса
	|		И уб_ДвиженияБСО.Период < &Дата) КАК Вложенный
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.уб_ВидыБСО КАК уб_ВидыБСО
	|		ПО (уб_ВидыБСО.Ссылка = Вложенный.ВидБСО)
	|
	|СГРУППИРОВАТЬ ПО
	|	Вложенный.НомерПолиса,
	|	уб_ВидыБСО.Ссылка,
	|	ЕСТЬNULL(уб_ВидыБСО.Тип, ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис)),
	|	ЕСТЬNULL(уб_ВидыБСО.ТипУчетаБСО, ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.НомернойПолисВручную)),
	|	ЕСТЬNULL(уб_ВидыБСО.УниверсальноеБСО, ЛОЖЬ)");
	Запрос.УстановитьПараметр("Дата", 		Период);
	Запрос.УстановитьПараметр("ВидБСО",		ВидБСО);
	Запрос.УстановитьПараметр("НомерПолиса",НомерПолиса);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Структура("ЕстьСвободныйНомер, ЕстьВРегистреДвижений", Ложь, Ложь);
	Результат.Вставить("Тип");
	Результат.Вставить("ТипУчетаБСО");
	Результат.Вставить("УниверсальноеБСО", Ложь);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ТипУчетаБСО = Выборка.ТипУчетаБСО;
	КонецЕсли;
	Если ТипУчетаБСО = Неопределено 
		и ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
		ТипУчетаБСО = ВидБСО.ТипУчетаБСО
	Иначе
		Результат.Вставить("НомерНеТребуется",ЛОЖЬ);
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("НомерНеТребуется", 	ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.КоличественныйПолисВручную 
	Или ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.НомернойПолисВручную
	Или ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.УчетНеВедетсяПолисВручную);	
	Возврат Результат;
	
КонецФункции



//проверка на наличие данных элементов основных форм документов в конфигурации (пока только они глючат)

// Функция переводит десятичное число в шестнадцатеричное
// Параметры:  _Число                - Число                - Десятичное число
// Возвращаемое значение:  Строка - Шестнадцатеричное число
Функция DecToHex(Знач _Число) Экспорт
	
	База = 16;
	Результат = "";
	Пока _Число <> 0 Цикл
		Поз =_Число % База;
		Результат = Сред("0123456789ABCDEF", Поз + 1, 1) + Результат;
		_Число = Цел(_Число / База);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции // DecToHex()

// Функция переводит шестнадцатеричное число в десятичное
// Параметры: _Hex     - Строка              - Шестнадцатеричное число
// Возвращаемое значение: Число   - Десятичное число
Функция HexToDec(Знач _Hex) Экспорт
	
	База = 16;
	_Hex = СокрЛП(_Hex);
	СтаршаяСтепень = СтрДлина(_Hex) - 1;
	Результат = 0;
	счСимволов = 1;
	Пока СтаршаяСтепень >= 0 Цикл
		_HexСимвол 		= Сред(_Hex, счСимволов, 1);
		Представление 	= Найти("0123456789ABCDEF", _HexСимвол) - 1;
		Результат 		= Результат + Представление * ВозвестиВСтепень(База, СтаршаяСтепень);
		СтаршаяСтепень 	= СтаршаяСтепень - 1;
		СчСимволов 		= СчСимволов + 1;
	КонецЦикла;   
	Возврат Результат;
	
КонецФункции // HexToDec()

Функция ВозвестиВСтепень(Число, Степень) Экспорт
	
	Результат = 1;
	Для Индекс = 1 по Степень Цикл
		Результат = Результат * Число;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

