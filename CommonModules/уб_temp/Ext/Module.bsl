		Результат.Вставить("Срочные",	0);
		Возврат Результат;
	КонецЕсли;
	ОбъектОтчет = Отчеты.уб_ОшибкиПолиса.Создать();
	ФормаОтчетаОшибок = ОбъектОтчет.ПолучитьФорму();
	Если ПараметрыСеанса.ТекущийПользователь = уб_КЭШируемые.ПолучитьМОЛпоБСО(ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО) Тогда
		ФормаОтчетаОшибок.ТипПодразделения = Перечисления.уб_ТипыПодразделений.ОУБСО;
	КонецЕсли;
	Отказ = ФормаОтчетаОшибок.ПриИзмененииУсловий(,"Неинтерактивный вызов");
	Если Не Отказ Тогда
		ФормаОтчетаОшибок.СК 				= Справочники.Контрагенты.ПустаяСсылка();
		ФормаОтчетаОшибок.Организация		= Справочники.Организации.ПустаяСсылка();
		ФормаОтчетаОшибок.ДатаС				= Дата(1,1,1);
		ФормаОтчетаОшибок.ДатаПо			= Дата(1,1,1);
		ФормаОтчетаОшибок.Статус 			= Справочники.уб_СостоянияОшибок.НеРешено;
		ФормаОтчетаОшибок.Состояние 		= Неопределено;
		ФормаОтчетаОшибок.ТипОшибок 		= 0;
		ФормаОтчетаОшибок.ИзмененаНастройка	= Ложь;
		Результат = ФормаОтчетаОшибок.КоличествоОшибок(Истина);
	Иначе
		Результат = Новый Структура;
		Результат.Вставить("Все", 		0);
		Результат.Вставить("Срочные",	0);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // КоличествоОшибокТекущегоПользователя()


