//получает список оргагентов для поставщика по активным договорам
Функция СписокОргагентовДляПоставщика(Поставщик, Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата()
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДК.Организация КАК ОрганизацияАгент
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|ГДЕ
	|	ДК.Владелец = &Поставщик
	|	И НЕ ДК.ПометкаУдаления
	|	И ДК.ДатаЗаключенияДоговора >= &Дата
	|	И (ДК.ДатаОкончанияДействияДоговора <= &Дата
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора ЕСТЬ NULL 
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора = &ПустаяДата)";
	Запрос.УстановитьПараметр("Поставщик", 	Поставщик);
	Запрос.УстановитьПараметр("Дата",		Дата);
	Запрос.УстановитьПараметр("ПустаяДата",	'00010101');
	СЗ = Новый СписокЗначений;
	СЗ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОрганизацияАгент"));
	Возврат СЗ;
	
КонецФункции // СписокОргагентовДляПоставщика()

