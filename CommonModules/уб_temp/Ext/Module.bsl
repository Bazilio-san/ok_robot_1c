Функция МассивИменПроверяемыхПолей(Знач Тип) Экспорт
	
	МассивИменПолей = Новый Массив;
	Если ТипЗнч(Тип) <> Тип("Тип") Тогда
		Тип = ТипЗнч(Тип)
	КонецЕсли;
	Если Тип = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
		МассивИменПолей.Добавить("Менеджер");
		// из-за добавления курьера руководитель СВС считается руководителем по любой заявке
		// и имеет право менять флаг ТребуетсяПроверкаРуководителем
		//МассивИменПолей.Добавить("Курьер");
	ИначеЕсли Тип = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
		МассивИменПолей.Добавить("Агент");
	ИначеЕсли Тип = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
		МассивИменПолей.Добавить("Агент");
		МассивИменПолей.Добавить("АгентКуда");
	ИначеЕсли Тип = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда
		МассивИменПолей.Добавить("Агент");
	КонецЕсли;
	Возврат МассивИменПолей;
	
КонецФункции // МассивИменПроверяемыхПолей()

Процедура Пауза(ИнтервалОжидания) Экспорт
	
	ИмяФайла = "sleep.js";
	Если Не ФайлСуществует(КаталогВременныхФайлов(), ИмяФайла) Тогда
		Если ПравоДоступа("Вывод", Метаданные) Тогда
			Скрипт = Новый ТекстовыйДокумент();
			Скрипт.УстановитьТекст
			(
			"if (WScript.Arguments.Count()==0)
			|    WScript.Quit();
			|else
			|    if (isNaN(parseInt(WScript.Arguments(0))))
			|        WScript.Quit();
			|WScript.Sleep(WScript.Arguments(0));"
			);
			Путь = КаталогВременныхФайлов() + ИмяФайла;
			Скрипт.Записать(Путь, КодировкаТекста.ANSI);
		Иначе
			КаталогВнешнихКомпонент = ПараметрыСеанса.уб_Константы.КаталогВнешнихКомпонент;
			Если ТипЗнч(КаталогВнешнихКомпонент) = Тип("Строка") Тогда
				КаталогВнешнихКомпонент = СокрЛП(КаталогВнешнихКомпонент);
				Если Прав(КаталогВнешнихКомпонент, 1) <> "\" Тогда
					КаталогВнешнихКомпонент = КаталогВнешнихКомпонент + "\"
				КонецЕсли;
				Если ФайлСуществует(КаталогВнешнихКомпонент, ИмяФайла) Тогда
					Путь = КаталогВнешнихКомпонент + ИмяФайла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Путь = КаталогВременныхФайлов() + ИмяФайла;
	КонецЕсли;
	Если Путь <> Неопределено Тогда
		WshShell = Новый COMОбъект("WScript.Shell");
		WshShell.Run("WScript.exe """ + Путь + """ " + Формат(ИнтервалОжидания, "ЧГ=0"), 0, -1);
	КонецЕсли;
	
КонецПроцедуры // Пауза

Функция ФайлСуществует(ПутьКПапке, ИмяФайла) Экспорт
	
	objShellApp = Новый COMОбъект("Shell.Application");
	objFolder = objShellApp.NameSpace(ПутьКПапке);
	objItem = objFolder.ParseName(ИмяФайла);
	Если objItem = Неопределено Тогда
		Возврат Ложь;
	Иначе
		objItem = Неопределено;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПроверитьФайлНаКлиенте(ИмяФайла, СтруктураФайла = Неопределено) Экспорт
	
	Файл = Новый Файл(ИмяФайла);
	СтруктураФайла = Новый Структура("Расширение, Размер, ВремяИзменения");
	Если Файл.Существует() Тогда
		СтруктураФайла.Расширение = Файл.Расширение;
		Если НЕ Файл.ЭтоКаталог() Тогда
			СтруктураФайла.Размер = Файл.Размер();
			СтруктураФайла.ВремяИзменения = Файл.ПолучитьВремяИзменения();
		КонецЕсли;
		Файл = Неопределено;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ДоговорПоВидуБСО(ВидБСО, Знач Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПБ.Ссылка.Поставщик КАК Поставщик
	|ПОМЕСТИТЬ ВТ_Поставщик
	|ИЗ
	|	Документ.уб_ПоступлениеБСО.БСО КАК ПБ
	|ГДЕ
	|	ПБ.Ссылка.Проведен
	|	И ПБ.ВидБСО = &ВидБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СП.ВидБСО,
	|	СП.Ссылка.Вид
	|ИЗ
	|	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК СП
	|ГДЕ
	|	НЕ СП.Ссылка.ПометкаУдаления
	|	И СП.ВидБСО = &ВидБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДК.Ссылка,
	|	ДК.Владелец КАК Владелец,
	|	ДК.ВидСП,
	|	ДК.ДатаЗаключенияДоговора,
	|	ДК.Наименование
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Поставщик КАК ВТ_Поставщик
	|		ПО ДК.Владелец = ВТ_Поставщик.Поставщик
	|ГДЕ
	|	(ДК.ДатаОкончанияДействияДоговора = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ДК.ДатаОкончанияДействияДоговора > &Дата)
	|	И ДК.ДатаЗаключенияДоговора <= &Дата
	|	И ДК.РасширениеНазвания <> ""---""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДК.ВидСП
	|ИТОГИ ПО
	|	Владелец");
	Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
	Запрос.УстановитьПараметр("Дата",	Дата);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Результат = "";
	Если Выборка.Количество() = 1 Тогда
		ВыборкаВидСП = Пакет[1].Выбрать();
		Если ВыборкаВидСП.Количество() = 1 Тогда
			ВыборкаВидСП.Следующий();
			ТекущийВидСП = ВыборкаВидСП.Вид;
		КонецЕсли;
		Выборка.Следующий();
		Выборка = Выборка.Выбрать();
		Если ТекущийВидСП <> Неопределено Тогда
			//ищем по виду сп
			Пока Выборка.Следующий() Цикл
				Если Выборка.ВидСП = ТекущийВидСП Тогда
					Результат = Выборка.Наименование + ?(ЗначениеЗаполнено(Выборка.ДатаЗаключенияДоговора), " от " + Формат(Выборка.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy"), "");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Результат = "" Тогда
			//берем первый пустой
			Выборка.Сбросить();
			Если Выборка.Следующий() Тогда
				Результат = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат
	
КонецФункции

