Процедура ОбновитьНомерТекущегоДействия(ЭтаФорма, АктивизироватьНовыйЭлементФормы = Ложь, Знач НомерСтрокиДляПерехода = Неопределено) Экспорт
	
	//Если ЭтаФорма.ДополнительныеСвойства.Свойство("ТаблицаВсехДействий") 
	//	И ЭтаФорма.ДополнительныеСвойства.Свойство("КоличествоСтрокТаблицыДействий") 
	//	И ЭтаФорма.ДополнительныеСвойства.Свойство("НомерТекущегоДействия") Тогда
	ТаблицаВсехДействий = ЭтаФорма.ДополнительныеСвойства.ТаблицаВсехДействий;
	КоличествоСтрокТаблицыДействий = ЭтаФорма.ДополнительныеСвойства.КоличествоСтрокТаблицыДействий;
	НомерТекущегоДействия = ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия;
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	
	Если НомерСтрокиДляПерехода = Неопределено Тогда						
		
		НомерНовойСтрокаДействия = -1;//если нет невыполненных
		//ИндексНовойСтрокиДействия = КоличествоСтрокТаблицыДействий-1;//если нет невыполненных из обязательных, по перейти на последнее действие
		Для Каждого СтрокаТЗ Из ТаблицаВсехДействий Цикл
			//Если СтрокаТЗ.НомерСтроки > НомерТекущегоДействия Тогда//незаполненные ранее в игнорируются
			Если ЗначениеЗаполнено(СтрокаТЗ.ИмяЭлементаФормы) Тогда//И СтрокаТЗ.ОбязательноКВыполнению 				
				
				Если Не ДействиеВыполнено(ЭтаФорма, СтрокаТЗ) Тогда
					НомерНовойСтрокаДействия = СтрокаТЗ.НомерСтроки;						
					ИмяЭлементФормыДляАктивизации = СтрокаТЗ.ИмяЭлементаФормы;
					Прервать;
				КонецЕсли;											
			КонецЕсли;	
			//КонецЕсли;				
		КонецЦикла;
		ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия = НомерНовойСтрокаДействия;	
		Если АктивизироватьНовыйЭлементФормы И ЗначениеЗаполнено(ИмяЭлементФормыДляАктивизации) Тогда
			Элемент = ЭлементыФормы.Найти(ИмяЭлементФормыДляАктивизации);
			Если Элемент <> Неопределено Тогда
				ЭтаФорма.ТекущийЭлемент = Элемент;
			КонецЕсли;
		КонецЕсли;	
	Иначе										
		Если НомерСтрокиДляПерехода > КоличествоСтрокТаблицыДействий Тогда
			НомерСтрокиДляПерехода = КоличествоСтрокТаблицыДействий;
		КонецЕсли;	
		ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия = НомерСтрокиДляПерехода;	
		Если НомерСтрокиДляПерехода > 0 Тогда					
			ИмяЭлементФормыДляАктивизации = ТаблицаВсехДействий[НомерСтрокиДляПерехода-1].ИмяЭлементаФормы;
			Если АктивизироватьНовыйЭлементФормы И ЗначениеЗаполнено(ИмяЭлементФормыДляАктивизации) Тогда
				Элемент = ЭлементыФормы.Найти(ИмяЭлементФормыДляАктивизации);
				Если Элемент <> Неопределено Тогда
					ЭтаФорма.ТекущийЭлемент = Элемент;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	//КонецЕсли;
	
КонецПроцедуры	

Функция ДействиеВыполнено(ЭтаФорма, СтрокаТЗ)
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	Если Не ЗначениеЗаполнено(СтрокаТЗ.ИмяЭлементаФормы) Тогда
		Возврат Ложь;
	КонецЕсли;
	Элемент = ЭлементыФормы.Найти(СтрокаТЗ.ИмяЭлементаФормы);
	Если Элемент <> Неопределено Тогда
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Попытка
				Если ЗначениеЗаполнено(Элемент.ТекущаяСтрока)
					Или ЭтаФорма[СтрокаТЗ.ИмяЭлементаФормы].Количество() > 0 
					Или Не ВидимостьЭлементаФормы(ЭтаФорма,СтрокаТЗ.ИмяЭлементаФормы) Тогда						
					Возврат Истина;
				Иначе 	
					Возврат Ложь;
				КонецЕсли;	
			Исключение
				Возврат Ложь;
			КонецПопытки;
		Иначе
			Если ЗначениеЗаполнено(Элемент.Значение) Или Не ВидимостьЭлементаФормы(ЭтаФорма,СтрокаТЗ.ИмяЭлементаФормы) Тогда 
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;		
		КонецЕсли;
	Иначе 
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция ПолучитьНомерСледующего(ЭтаФорма, ЭтоАвтоматическоеОбновление = Ложь)
	
	Номер = -1;
	
	//Если ЭтаФорма.ДополнительныеСвойства.Свойство("ТаблицаВсехДействий")
	//	И ЭтаФорма.ДополнительныеСвойства.Свойство("НомерТекущегоДействия") 
	//	И ЭтаФорма.ДополнительныеСвойства.Свойство("КоличествоСтрокТаблицыДействий") Тогда
	
	НомерТекущегоДействия = ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия;
	ТаблицаВсехДействий = ЭтаФорма.ДополнительныеСвойства.ТаблицаВсехДействий;		
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	Для Каждого СтрокаТЧ Из ТаблицаВсехДействий Цикл
		Выполнено = ДействиеВыполнено(ЭтаФорма, СтрокаТЧ);
		Если (СтрокаТЧ.ОбязательноКВыполнению И Не Выполнено И (ЭлементДоступенДляРедактирования(ЭтаФорма, СтрокаТЧ.ИмяЭлементаФормы) Или (СтрокаТЧ.НомерСтроки > НомерТекущегоДействия И Не ЭтоАвтоматическоеОбновление)))
			Или (Не СтрокаТЧ.ОбязательноКВыполнению И Не Выполнено И СтрокаТЧ.НомерСтроки > НомерТекущегоДействия) 
			Или (ЭтоАвтоматическоеОбновление И СтрокаТЧ.НомерСтроки = НомерТекущегоДействия И Не Выполнено) Тогда
			
			Возврат СтрокаТЧ.НомерСтроки;
			
		КонецЕсли;	
	КонецЦикла;
	Если Номер = - 1 Тогда
		Для Каждого СтрокаТЧ Из ТаблицаВсехДействий Цикл
			Если Не ДействиеВыполнено(ЭтаФорма, СтрокаТЧ) Тогда//И Не ЭтоАвтоматическоеОбновление 
				
				Возврат СтрокаТЧ.НомерСтроки;
				
			КонецЕсли;	
		КонецЦикла;		
	КонецЕсли;
	//КонецЕсли;
	
	Возврат Номер;
	
КонецФункции	

Функция ЭлементДоступенДляРедактирования(ЭтаФорма, ИмяЭлементаФормы)
	
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	Элемент = ЭлементыФормы.Найти(ИмяЭлементаФормы);
	Если Элемент <> Неопределено Тогда
		Если Элемент.ТолькоПросмотр Или Не Элемент.Доступность Тогда//Или Не ВидимостьЭлементаФормы(ЭтаФорма,ИмяЭлементаФормы)
			Возврат Ложь;                                                                                              
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	

Процедура ОбработатьНажатиеКнопкиПомощника(Элемент, ЭтаФорма) Экспорт
	#Если Клиент Тогда		
		//Если ЭтаФорма.ДополнительныеСвойства.Свойство("ТаблицаВсехДействий")
		//	И ЭтаФорма.ДополнительныеСвойства.Свойство("ИмяОбъекта") 
		//	И ЭтаФорма.ДополнительныеСвойства.Свойство("НомерТекущегоДействия")
		//	И ЭтаФорма.ДополнительныеСвойства.Свойство("КоличествоСтрокТаблицыДействий") Тогда
		
		ТаблицаВсехДействий = ЭтаФорма.ДополнительныеСвойства.ТаблицаВсехДействий;			
		Если Элемент.Имя = "Помощник_ПерейтиКСледующемуНеВыполненному" Или Элемент.Имя = "Помощник_ОсновнаяКнопка" Тогда
			Следующий = ПолучитьНомерСледующего(ЭтаФорма);
			ОбновитьНомерТекущегоДействия(ЭтаФорма, Истина, Следующий);
			ОбновитьТекстНадписиПомощника(ЭтаФорма);
			//Если ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия = -1 Тогда
			//	Сообщение = Новый СообщениеПользователю;
			//	Сообщение.Текст = "Все обязательные действия уже выполнены.";
			//	Сообщение.Сообщить();
			//КонецЕсли;
		ИначеЕсли Элемент.Имя = "Помощник_ПоказатьСписокНевыполненных" Тогда
			ТаблицаНеВыполненных = ПодготовитьТаблицуНеВыполненных(ЭтаФорма,ТаблицаВсехДействий);
			Если ТаблицаНеВыполненных.Количество() > 0 Тогда
				
				//ВыбраннаяСтрока = ТаблицаНеВыполненных.ВыбратьСтроку("Список невыполненных обязательных действий",);
				ФормаВыбораСтроки = ПолучитьОбщуюФорму("уб_ФормаВыбораСтрокиТЗ",ЭтаФорма);
				ФормаВыбораСтроки.Заголовок = "Список обязательных невыполненных действий";
				ФормаВыбораСтроки.ТаблицаЗначений = ТаблицаНеВыполненных;
				ТЗНаФорме = ФормаВыбораСтроки.ЭлементыФормы.ТаблицаЗначений;
				ТЗНаФорме.СоздатьКолонки();					
				Для Каждого Колонка Из ТЗНаФорме.Колонки Цикл											
					Колонка.Ширина = 40;
					Колонка.ВысотаЯчейки = 3;
					Колонка.АвтоВысотаЯчейки = Истина;
					Колонка.ИзменениеРазмера = ИзменениеРазмераКолонки.Изменять;
					Колонка.ЭлементУправления.МногострочныйРежим = Истина;
					Колонка.ЭлементУправления.АвтоПереносСтрок = Истина;					
				КонецЦикла;	
				ТЗНаФорме.ТолькоПросмотр = Истина;					
				
				ВыбраннаяСтрока = ФормаВыбораСтроки.ОткрытьМодально();
				Если ВыбраннаяСтрока <> Неопределено Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Действие",ВыбраннаяСтрока.Действие);
					Отбор.Вставить("Описание",ВыбраннаяСтрока.Описание);
					СтрокиТаблицыДействий = ТаблицаВсехДействий.НайтиСтроки(Отбор);
					Если СтрокиТаблицыДействий.Количество() > 0 Тогда
						ОбновитьНомерТекущегоДействия(ЭтаФорма, Истина, СтрокиТаблицыДействий[0].НомерСтроки);
						ОбновитьТекстНадписиПомощника(ЭтаФорма);
					КонецЕсли;
				КонецЕсли;
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Все обязательные действия уже выполнены.";
				Сообщение.Сообщить();
			КонецЕсли;
		ИначеЕсли Элемент.Имя = "Помощник_ОткрытьФормуПомощника" Тогда
			Фрм = ПолучитьОбщуюФорму("уб_ФормаПомощника",ЭтаФорма);
			Если Фрм.Открыта() Тогда
				Фрм.Свернуто = Ложь;
				Фрм.Активизировать();
			Иначе
				Фрм.РазрешитьСостояниеПрикрепленное=Истина;
				Фрм.РазрешитьСоединятьОкно = Истина;
				Фрм.РазрешитьСостояниеОбычное = Истина;
				Фрм.РазрешитьСостояниеСвободное = Истина;
				Фрм.СоединяемоеОкно = Истина;
				Фрм.СостояниеОкна = ВариантСостоянияОкна.Прикрепленное;
				Фрм.ПоложениеПрикрепленногоОкна = ВариантПрикрепленияОкна.Право;
				Если Фрм.Ширина < 300 Тогда
					Фрм.Ширина = 300;
				КонецЕсли;
				Если Фрм.Высота < 700 Тогда
					Фрм.Высота = 700;
				КонецЕсли;			
				Фрм.ИмяОбъекта = ЭтаФорма.ДополнительныеСвойства.ИмяОбъекта;		
				Фрм.СсылкаНаОбъект = ЭтаФорма.ЭтотОбъект;
				Фрм.Свернуто = Ложь;			
				Фрм.Открыть();
			КонецЕсли;			
		ИначеЕсли Элемент.Имя = "Помощник_НадписьПомощник" Тогда
			ОбновитьНомерТекущегоДействия(ЭтаФорма, Истина, ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия);
		КонецЕсли;	
		
		//КонецЕсли;
	#КонецЕсли
КонецПроцедуры	

Функция ПодготовитьТаблицуНеВыполненных(ЭтаФорма, Таблица)
	
	ТЗ = Таблица.СкопироватьКолонки("Действие, Описание");
	Для Каждого СтрокаТЧ Из Таблица Цикл 
		Если СтрокаТЧ.ОбязательноКВыполнению И Не ДействиеВыполнено(ЭтаФорма, СтрокаТЧ) И ЭлементДоступенДляРедактирования(ЭтаФорма, СтрокаТЧ.ИмяЭлементаФормы) Тогда
			НоваяСтрока = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);
		КонецЕсли;					
	КонецЦикла;	
	Возврат ТЗ;
	
КонецФункции	

Процедура УдалитьЛишниеСтрокиДерева(Строки)
	
	КоличествоСтрок = Строки.Количество();
	Если КоличествоСтрок > 0 Тогда
		Для Счетчик = 1 По КоличествоСтрок Цикл //Для Каждого Строка из Строки Цикл     					
			Если Строки[КоличествоСтрок - Счетчик].НеУдалятьСтроки Тогда			
				УдалитьЛишниеСтрокиДерева(Строки[КоличествоСтрок - Счетчик].Строки);
			Иначе
				Строки.Удалить(КоличествоСтрок - Счетчик);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

Функция ВидимостьЭлементаФормы(ЭтаФорма,ИмяЭлементаФормы)
	
	ДеревоЭлементовФормы = ЭтаФорма.ДополнительныеСвойства.ДеревоЭлементовФормы;	
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	Элемент = ЭлементыФормы.Найти(ИмяЭлементаФормы);
	Если Элемент <> Неопределено Тогда		
		ТекВидимость = Элемент.Видимость;
		Если ТекВидимость Тогда		
			ТекВидимость = ВидимостьЭлементаВДеревеЭлементов(ЭлементыФормы, ДеревоЭлементовФормы.Строки, ИмяЭлементаФормы);			
		КонецЕсли;	
	Иначе	
		Возврат Ложь;	
	КонецЕсли;
	Возврат ТекВидимость;
	
КонецФункции

Функция ВидимостьЭлементаВДеревеЭлементов(ЭлементыФормы, Строки, ИмяЭлементаФормы,Панель = Неопределено)
	
	Результат = Истина;
	НайденнаяСтрока = Строки.Найти(ИмяЭлементаФормы, "ИмяЭлемента", Истина);		
	Пока НайденнаяСтрока <> Неопределено Цикл		
		Если НайденнаяСтрока.ТипЭлемента = Тип("СтраницаПанели") Тогда
			Результат = ЭлементыФормы[НайденнаяСтрока.Родитель.ИмяЭлемента].Страницы.Найти(НайденнаяСтрока.ИмяЭлемента).Видимость;
		ИначеЕсли НайденнаяСтрока.ТипЭлемента <> Тип("Форма") Тогда		
			Результат = ЭлементыФормы[НайденнаяСтрока.ИмяЭлемента].Видимость;
		КонецЕсли;
		Если Не Результат Тогда
			Возврат Результат;
		КонецЕсли;	
		НайденнаяСтрока = НайденнаяСтрока.Родитель;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции	

