Процедура ОбновитьТекстНадписиПомощника(ЭтаФорма) Экспорт	
	ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
	нПомощник = ЭлементыФормы.Найти("Помощник_НадписьПомощник");
	Если нПомощник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаВсехДействий = ЭтаФорма.ДополнительныеСвойства.ТаблицаВсехДействий;
	КоличествоСтрокТаблицыДействий = ЭтаФорма.ДополнительныеСвойства.КоличествоСтрокТаблицыДействий;
	НомерТекущегоДействия = ЭтаФорма.ДополнительныеСвойства.НомерТекущегоДействия;
	Если НомерТекущегоДействия > КоличествоСтрокТаблицыДействий Тогда
		НомерТекущегоДействия  = КоличествоСтрокТаблицыДействий;
	КонецЕсли;	
	
	Если НомерТекущегоДействия > 0 Тогда			
		ТекСтрТЗ = ТаблицаВсехДействий[НомерТекущегоДействия-1];						
		нПомощник.Картинка = Новый Картинка;
		нПомощник.Заголовок = ТекСтрТЗ.Действие;
		Если ТекСтрТЗ.ОбязательноКВыполнению Тогда
			нПомощник.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;
		Иначе
			нПомощник.ЦветТекста = ЦветаСтиля.ЦветФонаВыделенияПоля;
		КонецЕсли;
		нПомощник.Подсказка = ТекСтрТЗ.Описание;			
		Если ЗначениеЗаполнено(ТекСтрТЗ.ИмяЭлементаФормы) Тогда
			нПомощник.Гиперссылка = Истина;
			Элемент = ЭлементыФормы.Найти(ТекСтрТЗ.ИмяЭлементаФормы);
			Если Элемент <> Неопределено Тогда
				Если Элемент.ТолькоПросмотр 
					Или Не Элемент.Доступность Тогда//Или Не ВидимостьЭлементаФормы(ЭтаФорма,ТекСтрТЗ.ИмяЭлементаФормы)  
					
					КартинкаЗамок = БиблиотекаКартинок.уб_ЗамокЗакрыт;
					Если нПомощник.Картинка <> КартинкаЗамок Тогда
						нПомощник.Картинка = КартинкаЗамок;
					КонецЕсли;	
				КонецЕсли;
			Иначе
				нПомощник.Гиперссылка = Ложь;
				КартинкаЗамок = БиблиотекаКартинок.уб_ЗамокЗакрыт;
				Если нПомощник.Картинка <> КартинкаЗамок Тогда
					нПомощник.Картинка = КартинкаЗамок;
				КонецЕсли;
			КонецЕсли;
		Иначе
			нПомощник.Гиперссылка = Ложь;
		КонецЕсли;				
	ИначеЕсли ЭтаФорма.Модифицированность Или ЭтаФорма.ЭтоНовый() Тогда
		нПомощник.Картинка = Новый Картинка;
		нПомощник.Гиперссылка = Ложь;
		нПомощник.ЦветТекста = ЦветаСтиля.ЦветОтрицательногоЧисла;			
		нПомощник.Заголовок = "Объект не записан!";
		нПомощник.Подсказка = "Изменения в объекте не записаны!";			
	Иначе	
		нПомощник.Заголовок = "";
		нПомощник.Подсказка = "";
		КартинкаВыполнено = БиблиотекаКартинок.ВыполненоУспешно32;
		Если нПомощник.Картинка <> КартинкаВыполнено Тогда
			нПомощник.Картинка = КартинкаВыполнено;
		КонецЕсли;	
	КонецЕсли;				
КонецПроцедуры

Процедура ПодготовитьПомощника(ЭтаФорма, СтруктураПараметров) Экспорт
	Если УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "НеИспользоватьПомощникаЗаполненияОбъектов") Тогда
		Возврат;
	КонецЕсли;	
	ТаблицаВсехДействий = ПолучитьТаблицуВсехДействий(СтруктураПараметров.ИмяОбъекта);
	КоличествоСтрок = ТаблицаВсехДействий.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;		
	ДеревоЭлементовФормы = ПолучитьДеревоЭлементовФормы(ЭтаФорма, СтруктураПараметров.ИмяОбъекта, ТаблицаВсехДействий);
	
	ЭтаФорма.ДополнительныеСвойства.Вставить("ДеревоЭлементовФормы", ДеревоЭлементовФормы);
	ЭтаФорма.ДополнительныеСвойства.Вставить("ТаблицаВсехДействий", ТаблицаВсехДействий);
	ЭтаФорма.ДополнительныеСвойства.Вставить("КоличествоСтрокТаблицыДействий", КоличествоСтрок);
	ЭтаФорма.ДополнительныеСвойства.Вставить("НомерТекущегоДействия", 0);
	ЭтаФорма.ДополнительныеСвойства.Вставить("ИмяОбъекта", СтруктураПараметров.ИмяОбъекта);
	
	УстановитьАвтоотметкиНеЗаполненных(ЭтаФорма, ТаблицаВсехДействий);
	УстановитьРазмерНадписиПомощника(ЭтаФорма, СтруктураПараметров.ПозицияЛевойГраницыНадписиПомощника, СтруктураПараметров.ПозицияВерхнейГраницыКнопкиПомощника,?(СтруктураПараметров.Свойство("ШиринаНадписиСтатусаДокумента"),СтруктураПараметров.ШиринаНадписиСтатусаДокумента,0));
	Следующий = ПолучитьНомерСледующего(ЭтаФорма);
	ОбновитьНомерТекущегоДействия(ЭтаФорма, Истина, Следующий);
	ОбновитьТекстНадписиПомощника(ЭтаФорма);
	ДобавитьКнопкуПомощника(ЭтаФорма, СтруктураПараметров.ПозицияЛевойГраницыКнопкиПомощника, СтруктураПараметров.ПозицияВерхнейГраницыКнопкиПомощника);		
	ЭтаФорма.ПодключитьОбработчикОжидания("АвтоматическоеОбновлениеФормы", СтруктураПараметров.ИнтервалАвтоматическогоОбновления);
КонецПроцедуры	

Процедура УстановитьАвтоотметкиНеЗаполненных(ЭтаФорма, ТаблицаВсехДействий)
	Для Каждого СтрокаТЧ Из ТаблицаВсехДействий Цикл
		Если СтрокаТЧ.ОбязательноКВыполнению И ЗначениеЗаполнено(СтрокаТЧ.ИмяЭлементаФормы) Тогда
			ЭлементыФормы = ЭтаФорма.ЭлементыФормы;
			Элемент = ЭлементыФормы.Найти(СтрокаТЧ.ИмяЭлементаФормы);
			Если Элемент <> Неопределено Тогда
				Если ТипЗнч(Элемент) = Тип("ПолеВвода") Тогда 
					Элемент.АвтоОтметкаНезаполненного = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

