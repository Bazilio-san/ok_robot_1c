Процедура УдалитьБуквыИзСтроки(Элемент, ДопустимыеСимволы = "0123456789") Экспорт
	
	Цифры = ДопустимыеСимволы;
	Результат = "";
	ЭтоПолеВвода = ?(ТипЗнч(Элемент) = Тип("Строка"),Ложь,Истина);
	Если ЭтоПолеВвода Тогда
		ЭлементЗначение = Элемент.Значение;
	Иначе
		ЭлементЗначение = Элемент;
	КонецЕсли;
	Если ДопустимыеСимволы = "0123456789." Тогда//число с дробной частью
		Текст = СтрЗаменить(ЭлементЗначение,",",".");
		Текст = УдалитьЛишниеТочкиВСтроке(Текст);
	Иначе
		Текст = ЭлементЗначение;
	КонецЕсли;
	ДлинаТекста = СтрДлина(Текст);
	Для Сч = 0 По ДлинаТекста - 1 Цикл
		Символ = Сред(Текст,ДлинаТекста - Сч, 1);
		Если Найти(Цифры, Символ) <> 0 Тогда
			Результат = Символ + Результат;
		КонецЕсли;
	КонецЦикла;
	//Если Элемент.Значение <> Результат Тогда
	Если ЭтоПолеВвода Тогда
		Элемент.Значение = Результат;
	Иначе
		Элемент = Результат;
	КонецЕсли;
	//КонецЕсли;
КонецПроцедуры

Функция УдалитьЛишниеТочкиВСтроке(Знач Текст)
	
	Позиция = Найти(Текст, ".");
	Если Позиция <> 0 Тогда
		ЛеваяЧасть = Лев(Текст, Позиция);
		ПраваяЧасть = Сред(Текст, Позиция + 1);
		Возврат ЛеваяЧасть + СтрЗаменить(ПраваяЧасть, ".", "");
	Иначе
		Возврат Текст;
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьАбсолютныйЦвет(Red, Green, Blue) Экспорт
	
	Возврат Red + Green * 256 + Blue * 65536
	
КонецФункции // АбсолютныйЦвет()

Функция РазложитьАбсолютныйЦвет(АбсолютныйЦвет) Экспорт
	
	Blue 	= Цел(АбсолютныйЦвет / 65536);
	Цвет 	= АбсолютныйЦвет - Blue * 65536;
	Green   = Цел(Цвет / 256);
	Red		= Цвет - Green * 256;
	Возврат Новый Структура("Красный, Зеленый, Синий", Red, Green, Blue);
	
КонецФункции // РазложитьАбсолютныйЦвет()

