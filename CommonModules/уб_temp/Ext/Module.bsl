//получает раздельно данные по типу "Документ.ИмяДокумента.ИмяФормы" в структуре
Функция РазделитьИсточникДействий(Знач Строка) Экспорт
	
	Строка = СокрЛП(Строка);
	Поз = Найти(Строка, ".");
	Если Поз <> 0 Тогда
		Структура = Новый Структура;
		Структура.Вставить("Тип", Лев(Строка, Поз - 1));
		Стр = Сред(Строка, Поз + 1);
		Поз = Найти(Стр, ".");
		//учитывая ОбщиеФормы (например ОбщаяФорма.Форма)
		Структура.Вставить("Имя",	?(Поз <> 0, Лев(Стр, Поз - 1),	Неопределено));
		Структура.Вставить("Форма", ?(Поз <> 0, Сред(Стр, Поз + 1),	Стр));
		//учитывая имя поля (например Отчет.уб_Отчет.ФормаДокумента.ДатаНачала
		Стр = Сред(Строка, Поз + 1);
		Поз = Найти(Стр, ".");
		Если Поз <> 0 Тогда
			Структура.Вставить("Поле", Сред(Стр, Поз + 1));
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

//получает остатки номерных БСО.
Функция ПолучитьОстаткиБСО(Знач СК, Знач ВидБСО) Экспорт
	
	Если ЗначениеНеЗаполнено(СК) Или ЗначениеНеЗаполнено(ВидБСО) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если уб_СЛ.ОпределитьВедетсяНомернойУчет(ВидБСО) Тогда
		СписокПоложенийБСО = Новый СписокЗначений;
		СписокПоложенийБСО.Добавить(Перечисления.уб_ПоложенияБСО.ПолученИзСК);
		СписокПоложенийБСО.Добавить(Перечисления.уб_ПоложенияБСО.ВозвращенИзСК);
		//СписокПоложенийБСО.Добавить(Перечисления.уб_ПоложенияБСО.ПереданНаТочку);
		СписокПоложенийБСО.Добавить(Перечисления.уб_ПоложенияБСО.ВозвращенСТочки);
		
		СписокСостоянийБСО = Новый СписокЗначений;
		СписокСостоянийБСО.Добавить(Перечисления.уб_СостоянияБСО.ПустойБланк);
		СписокСостоянийБСО.Добавить(Перечисления.уб_СостоянияБСО.НеиспользованныйБланк);
		
		СписокАгентыМолПоБСО = ВернутьСписокСотрудниковОУБСО();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	уб_ОперОстаткиБСО.Количество
		|ИЗ
		|	РегистрСведений.уб_УпрОстаткиБСО КАК уб_ОперОстаткиБСО
		|ГДЕ
		|	уб_ОперОстаткиБСО.ВидБСО = &ВидБСО";
		Запрос.УстановитьПараметр("ВидБСО",				ВидБСО);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество;
		Иначе
			Возврат 0;
		КонецЕсли;	
	ИначеЕсли уб_СЛ.ОпределитьВедетсяКоличественныйУчет(ВидБСО) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уб_ОстаткиБСООстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.уб_ОстаткиБСО.Остатки КАК уб_ОстаткиБСООстатки
		|ГДЕ
		|	уб_ОстаткиБСООстатки.СК = &СК
		|	И уб_ОстаткиБСООстатки.ВидБСО = &ВидБСО";
		
		Запрос.УстановитьПараметр("СК",		СК);
		Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество
		Иначе
			Возврат 0
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции // ПолучитьОстаткиБСО()

//добавляет числа к кодам символов строки
Функция ШифрСтроки(Строка, Зашифровать = Истина) Экспорт
	
	Стр = СокрЛП(Строка);
	Сдвиг = 20;
	Результат = "";
	Для Индекс = 1 По СтрДлина(Стр) Цикл
		Если Сдвиг = 10 Тогда 
			Сдвиг = 20 
		КонецЕсли;
		Код = КодСимвола(Сред(Стр, Индекс, 1));
		Результат = Результат + Символ(Код + ?(Зашифровать, + Сдвиг, - Сдвиг));
		Сдвиг = Сдвиг - 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ЗашифроватьСтроку()

//получает значение предопределенного права либо настройки из ПВХ Настройки пользователей для текущего пользователя
Функция ПолучитьПредопределеннуюНастройкуПользователя(Знач Настройка, ЗначениеПоУмолчанию) Экспорт
	
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат ЗначениеПоУмолчанию
	ИначеЕсли ТипЗнч(Настройка) = Тип("Строка") Тогда
		ЗначениеНастройки = Неопределено;
		Попытка
			Если ПараметрыСеанса.уб_Константы.Свойство(Настройка,ЗначениеНастройки) Тогда
				Возврат ЗначениеНастройки;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Настройка = ПланыВидовХарактеристик.НастройкиПользователей[Настройка]
		Исключение
			Настройка = ПланыВидовХарактеристик.НастройкиПользователей.НайтиПоНаименованию(Настройка);
			Если Настройка.Пустая() Тогда
				Возврат ЗначениеПоУмолчанию
			КонецЕсли;	
		КонецПопытки;
	КонецЕсли;
	КэшДополнительныхПрав = глЗначениеПеременной("ЗначенияДополнительныхПравПользователя");
	ЗначениеНастройки = КэшДополнительныхПрав[Настройка];
	Если ЗначениеНастройки <> Неопределено Тогда
		Возврат ЗначениеНастройки
	КонецЕсли;
	ЗапросПредопределеннойНастройки = Новый Запрос;
	ЗапросПредопределеннойНастройки.Текст =
	"ВЫБРАТЬ
	|	НП.Значение
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК НП
	|ГДЕ
	|	НП.Настройка = &Настройка
	|	И НП.Пользователь = &Пользователь";			
	ЗапросПредопределеннойНастройки.УстановитьПараметр("Настройка",		Настройка);
	ЗапросПредопределеннойНастройки.УстановитьПараметр("Пользователь",	ПолучитьПользователяИлиПрофиль(Настройка.ДобавлятьВПрофили));
	Выборка = ЗапросПредопределеннойНастройки.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Значение;	
	Иначе
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	КэшДополнительныхПрав[Настройка] = Результат;
	//#Если Сервер Тогда
	глЗначениеПеременнойУстановить("ЗначенияДополнительныхПравПользователя", КэшДополнительныхПрав, Истина);
	//#КонецЕсли
	Возврат Результат;
	
КонецФункции

//сохраняет значение предопределенного права либо настройки из ПВХ Настройки пользователей для текущего пользователя
Процедура СохранитьПредопределеннуюНастройкуПользователя(Настройка, Значение) Экспорт
	
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Набор = РегистрыСведений.НастройкиПользователей.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.Настройка.Установить(Настройка);
	Запись = Набор.Добавить();
	Запись.Пользователь = Пользователь;
	Запись.Настройка	= Настройка;
	Запись.Значение		= Значение;
	Попытка
		Набор.Записать()
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не записан набор записей регистра сведений настроек пользователей!
		|Пользователь: " + Пользователь + ", Настройка: " + Настройка + ", Значение: " + Значение + "
		|" + ОписаниеОшибки())
	КонецПопытки;
	
КонецПроцедуры

//получает значения полей (непредопределенных) в регистре настроек при открытии формы
//ТекущееЗначение - если параметр заполнен, тогда данные из регистра не берутся (в случаях передачи в реквизит каких-либо параметров)
Функция ПолучитьЗначениеИзНастроекПользователя(
	ИмяПоля, 
	ИмяОбъекта, 
	ЗначениеПоУмолчанию,
	ТекущееЗначение = Неопределено
	) Экспорт
	
	Если ЗначениеНеЗаполнено(ТекущееЗначение) Тогда
		ПолноеИмя	    = ИмяОбъекта + "." + ИмяПоля;
		Пользователь	= ПараметрыСеанса.ТекущийПользователь;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиПользователей.Настройка,
		|	НастройкиПользователей.Значение
		|ИЗ
		|	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НастройкиПользователей.Ссылка КАК Ссылка
		|		ИЗ
		|			ПланВидовХарактеристик.НастройкиПользователей КАК НастройкиПользователей
		|		ГДЕ
		|			НастройкиПользователей.Наименование = &Наименование
		|			И НастройкиПользователей.ВидНастройки = &ЗначениеПоля) КАК ВложенныйЗапрос
		|		ПО НастройкиПользователей.Настройка = ВложенныйЗапрос.Ссылка
		|ГДЕ
		|	НастройкиПользователей.Пользователь = &Пользователь
		|	И НастройкиПользователей.Настройка = ВложенныйЗапрос.Ссылка";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("ЗначениеПоля", Перечисления.уб_ВидыНастроекПользователей.ЗначениеПоля);
		Запрос.УстановитьПараметр("Наименование", ПолноеИмя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Значение
		Иначе
			Результат = ЗначениеПоУмолчанию
		КонецЕсли;
	Иначе
		Результат = ТекущееЗначение
	КонецЕсли;
	Возврат Результат
	
КонецФункции

//сохраняет значения полей (непредопределенных) в регистре настроек при закрытии формы
Процедура СохранитьЗначениеВНастройкахПользователя(ИмяПоля, ИмяОбъекта, Значение, ОписаниеТипов, ДобавлятьВПрофили = Ложь) Экспорт
	
	ПолноеИмя = ИмяОбъекта + "." + ИмяПоля;
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	//запрос на получение данных из ПВХ из списка полей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиПользователей.Наименование,
	|	НастройкиПользователей.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.НастройкиПользователей КАК НастройкиПользователей
	|ГДЕ
	|	НастройкиПользователей.Наименование = &Наименование
	|	И НастройкиПользователей.ВидНастройки = &ЗначениеПоля";
	Запрос.УстановитьПараметр("ЗначениеПоля",	Перечисления.уб_ВидыНастроекПользователей.ЗначениеПоля);
	Запрос.УстановитьПараметр("Наименование",	ПолноеИмя);
	Выборка = Запрос.Выполнить().Выбрать();	
	ОбъектПолучен = Ложь;
	Если Выборка.Следующий() Тогда
		Если ОписаниеТипов.Типы().Количество() <> 0 Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_temp.СохранитьЗначениеВНастройкахПользователя(): нет объекта по ссылке" + Выборка.Ссылка, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
				Возврат;
			Иначе
				Попытка
					Объект.ТипЗначения = ОписаниеТипов;
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("уб_temp.СохранитьЗначениеВНастройкахПользователя(): " + ОписаниеОшибки() + ". Полное имя поля: " + ПолноеИмя, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина);
					Возврат
				КонецПопытки;
				ОбъектПолучен = Истина;
			КонецЕсли;
		Иначе
			Ссылка = Выборка.Ссылка
		КонецЕсли;
	Иначе
		Объект = ПланыВидовХарактеристик.НастройкиПользователей.СоздатьЭлемент();
		Объект.Родитель				= ПланыВидовХарактеристик.НастройкиПользователей.ЗначенияПолей;
		Объект.ВидНастройки			= Перечисления.уб_ВидыНастроекПользователей.ЗначениеПоля;
		Объект.ДобавлятьВПрофили	= ДобавлятьВПрофили;
		Объект.Наименование			= ПолноеИмя;
		ОбъектПолучен = Истина;
	КонецЕсли;
	Если ОбъектПолучен Тогда
		Попытка
			Объект.Записать();
			Ссылка = Объект.Ссылка;
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не записан элемент " + ПолноеИмя + "
			|СохранениеДанныхПолейВНастройках: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецЕсли;	
	Запись = РегистрыСведений.НастройкиПользователей.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.Настройка	= Ссылка;
	Запись.Значение		= Значение;
	Запись.Записать();
	
КонецПроцедуры



//для получения настройки по пользователю или профилю, получает пользователя либо профиль
Функция ПолучитьПользователяИлиПрофиль(Настройка = Неопределено, Пользователь = Неопределено) Экспорт
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
		Профиль = ПараметрыСеанса.уб_ТекущийПрофиль;
	ИначеЕсли Пользователь = ПараметрыСеанса.ТекущийПользователь Тогда
		Профиль = ПараметрыСеанса.уб_ТекущийПрофиль;
	Иначе
		Профиль = Пользователь.Профиль;
	КонецЕсли;
	ПустойПрофиль = Справочники.уб_ПрофилиНастроекПользователей.ПустаяСсылка();
	
	ТипНастройки = ТипЗнч(Настройка);
	//Если Настройка = Неопределено Тогда
	Если ТипНастройки = Тип("Неопределено") Тогда
		Возврат ?(Профиль <> ПустойПрофиль, Профиль, Пользователь.Ссылка);
	Иначе
		Если ТипНастройки = Тип("Булево") Тогда
			ДобавлятьВПрофили = Настройка;
		ИначеЕсли ТипНастройки = Тип("ПланВидовХарактеристикСсылка.НастройкиПользователей") Тогда
			ДобавлятьВПрофили = Настройка.ДобавлятьВПрофили;
		ИначеЕсли ТипНастройки = Тип("Строка") Тогда
			ДобавлятьВПрофили = ПланыВидовХарактеристик.НастройкиПользователей[Настройка].ДобавлятьВПрофили;
		Иначе
			ДобавлятьВПрофили = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если ДобавлятьВПрофили Тогда
		Возврат ?(Профиль <> ПустойПрофиль, Профиль, Пользователь.Ссылка);
	Иначе
		Возврат Пользователь.Ссылка;
	КонецЕсли;
	
КонецФункции // ПолучитьПользователяИлиПрофиль()

//
Процедура ПроверитьНезаполненныеКонстанты()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уб_Константы.Ссылка,
	|	уб_Константы.ЗначениеКонстанты
	|ИЗ
	|	Справочник.уб_Константы КАК уб_Константы
	|ГДЕ
	|	НЕ уб_Константы.ЭтоГруппа
	|	И уб_Константы.Предопределенный";
	Выборка = Запрос.Выполнить().Выбрать();
	СЗ = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеНеЗаполнено(Выборка.ЗначениеКонстанты) Тогда
			СЗ.Добавить(Выборка.Ссылка)
		КонецЕсли;
	КонецЦикла;
	Если СЗ.Количество() > 0 Тогда
		//открываем форму списка констант с отбором по незаполненным
		ФС = Справочники.уб_Константы.ПолучитьФормуСписка();
		ОтборСсылка = ФС.СправочникСписок.Отбор.Ссылка;
		ОтборСсылка.Использование 	= Истина;
		ОтборСсылка.ВидСравнения	= ВидСравнения.ВСписке;
		ОтборСсылка.Значение		= СЗ;
		ФС.Заголовок = ФС.Заголовок + ": Не заполненные константы";
		ФС.ЭлементыФормы.СправочникСписок.ИерархическийПросмотр = Ложь;
		Если Не ФС.Открыта() Тогда
			ФС.Открыть()
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

