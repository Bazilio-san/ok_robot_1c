Функция ПолучитьСписокЗначенийСвойства(ЭлементСправочника, ИмяСвойства = "", ВключаяНеИспользуемые = Ложь, ТипЗначенияРезультата = "СписокЗначений",ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА СпрТЧ.Ссылка.ЕстьЗначения
	               |			ТОГДА СпрТЧ.Значение
	               |		ИНАЧЕ СпрТЧ.ИмяСвойства
	               |	КОНЕЦ КАК Значение,
	               |	СпрТЧ.НомерСтроки КАК НомерСтроки,
	               |	СпрТЧ.Ссылка,
	               |	СпрТЧ.Ссылка.ЗначениеПоУмолчанию как ЗначениеПоУмолчанию,
	               |	СпрТЧ.ИмяСвойства
	               |ИЗ
	               |	Справочник.уб_СвойстваИЗначения.ЗначенияСвойств КАК СпрТЧ
	               |ГДЕ
	               |	(СпрТЧ.Используется = ИСТИНА
	               |			ИЛИ &ВключаяНеИспользуемые = ИСТИНА)
	               |	И &ТекстУсловия
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("ВключаяНеИспользуемые", ВключаяНеИспользуемые);
	
	Если ТипЗнч(ЭлементСправочника) = Тип("Строка") Тогда
		Запрос.УстановитьПараметр("Наименование", ЭлементСправочника);
		ТекстУсловия = "СпрТЧ.Ссылка.Наименование = &Наименование";
	Иначе
		Запрос.УстановитьПараметр("Ссылка", ЭлементСправочника);
		ТекстУсловия = "СпрТЧ.Ссылка = &Ссылка";
	КонецЕсли;
	
	Если Не ИмяСвойства = "" Тогда
		ТекстУсловия = ТекстУсловия + " И СпрТЧ.ИмяСвойства = &ИмяСвойства";
		Запрос.УстановитьПараметр("ИмяСвойства", ИмяСвойства);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстУсловия", ТекстУсловия);
	
	//ЭтоСписок = ТипЗначенияРезультата = "СписокЗначений";
	//Если ЭтоСписок Тогда
	Если ТипЗначенияРезультата = "СписокЗначений" Тогда
		Результат = Новый СписокЗначений;
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ТипЗначенияРезультата = "СписокЗначений" Тогда
			Результат.Добавить(Выборка.Значение, Выборка.ИмяСвойства);
		Иначе
		    Результат.Добавить(Выборка.Значение);
		КонецЕсли;	
	КонецЦикла;
	Выборка.Сбросить();
	Пока выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.ЗначениеПоУмолчанию) Тогда
			Прервать;
		КонецЕсли;	
		Если Выборка.ЗначениеПоУмолчанию = 	Выборка.ИмяСвойства Тогда
			ЗначениеПоУмолчанию =  Выборка.Значение;
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыйСимволДляСтрок(Символ, ВключаяСимволыUID = Ложь)

	Код = КодСимвола(Символ);
	Возврат (ВключаяСимволыUID И ((Код >= 32 И Код <= 64) Или (Код >= 123 И Код <= 126)))
		Или (Код >= 48 		И Код <= 57) 	// цифры
		Или (Код >= 65 		И Код <= 90) 	// заглавные английские
		Или (Код >= 97 		И Код <= 122) 	// строчные английские
		Или (Код >= 1040 	И Код <= 1103) 	// кириллица

КонецФункции // ДопустимыйСимволДляСтрок()
	
Функция УбратьНедопустимыеСимволыДляСтрок(Знач Строка, ВключаяСимволыUID = Ложь) Экспорт

	Рез = "";
	Строка = СокрЛП(Строка);
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если ДопустимыйСимволДляСтрок(Символ, ВключаяСимволыUID) Тогда
			Рез = Рез + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;

КонецФункции // УбратьНедопустимыеСимволыДляСтрок()

