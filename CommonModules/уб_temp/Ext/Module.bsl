Функция ПолучитьРискиПоСтраховомуПродукту(СтраховойПродукт, КакМассив = Ложь) Экспорт
	
	
	Если ЗначениеЗаполнено(СтраховойПродукт) Тогда
		Если ТипЗнч(СтраховойПродукт) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
			МассивРисков = Новый Массив;
			МассивРисков.Добавить(СтраховойПродукт);
		Иначе	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	уб_СтраховыеПродуктыТипыОбъектовИРиски.Риск КАК Ссылка
			|ИЗ
			|	Справочник.уб_СтраховыеПродукты.ТипыОбъектовИРиски КАК уб_СтраховыеПродуктыТипыОбъектовИРиски
			|ГДЕ
			|	уб_СтраховыеПродуктыТипыОбъектовИРиски.Ссылка = &СтраховойПродукт
			|
			|УПОРЯДОЧИТЬ ПО
			|	уб_СтраховыеПродуктыТипыОбъектовИРиски.Риск.Наименование";
			
			Запрос.УстановитьПараметр("СтраховойПродукт", СтраховойПродукт);
			
			МассивРисков = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		КонецЕсли;
	Иначе
		МассивРисков = Новый Массив;
