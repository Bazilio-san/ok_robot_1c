Процедура ДополнитьСписокСотрудниковПредшественниками(СписокИлиМассив) Экспорт
	
	//ЗапросДополненияПреемниками = Новый Запрос;
	//ЗапросДополненияПреемниками.Текст = 
	//"ВЫБРАТЬ
	//|	ФЛ.Ссылка,
	//|	ФЛ.Наименование,
	//|	ФЛ.Преемник
	//|ИЗ
	//|	Справочник.ФизическиеЛица КАК ФЛ
	//|ГДЕ
	//|	ФЛ.Ссылка <> ФЛ.Преемник
	//|	И НЕ ФЛ.ПометкаУдаления
	//|	И НЕ ФЛ.Преемник.ПометкаУдаления";
	//Выборка = ЗапросДополненияПреемниками.Выполнить().Выгрузить();//Выбрать();
	Выборка = уб_КЭШируемые.Приемники();
	МассивПроверенныхЭлементов = Новый Массив;
	//МассивЭлементов = СписокЗначений.ВыгрузитьЗначения();
	ЭтоСЗ = ТипЗнч(СписокИлиМассив) = Тип("СписокЗначений");
	Для Каждого ЭлементСпискаИлиМассива Из СписокИлиМассив Цикл
		ПредшественникиРекурсивно(?(ЭтоСЗ, ЭлементСпискаИлиМассива.Значение, ЭлементСпискаИлиМассива), СписокИлиМассив, Выборка, МассивПроверенныхЭлементов, ЭтоСЗ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПредшественникиРекурсивно(Знач Предшественник, СписокИлиМассив, Выборка, МассивПроверенныхЭлементов, ЭтоСЗ)
	
	Если МассивПроверенныхЭлементов.Найти(Предшественник) = Неопределено Тогда
		МассивПроверенныхЭлементов.Добавить(Предшественник);
	Иначе
		Возврат;
	КонецЕсли;
	// если параметр Предшественник не Знач, то значение параметра Предшественник сбрасывается при сбросе выборки
	//Выборка.Сбросить();
	СтруктураПоиска = Новый Структура("Преемник", Предшественник);
	//Пока Выборка.НайтиСледующий(СтруктураПоиска) Цикл
	//Пока Выборка.СледующийПоЗначениюПоля()
	Для каждого Строка из Выборка.НайтиСтроки(СтруктураПоиска) Цикл
		Если ЭтоСЗ Тогда
			Если СписокИлиМассив.НайтиПоЗначению(Строка.Ссылка) = Неопределено Тогда
				СписокИлиМассив.Добавить(Строка.Ссылка, Строка.Наименование);
			КонецЕсли;
		Иначе
			Если СписокИлиМассив.Найти(Строка.Ссылка) = Неопределено Тогда
				СписокИлиМассив.Добавить(Строка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		ПредшественникиРекурсивно(Строка.Ссылка, СписокИлиМассив, Выборка, МассивПроверенныхЭлементов, ЭтоСЗ);
	КонецЦикла;
	
КонецПроцедуры

//Источник - Таблица значений или физ. лицо.
//Если источник - таблица, то параметр МассивИменКолонокСотрудников - строка или массив имен колонок, в которых заменить физ. лицо на преемника


Функция ПолучитьПреемникаСотрудника(
	Источник, 
	МассивИменКолонокСотрудников 	= Неопределено, 
	ВыборкаПреемников 				= Неопределено,
	КэшРекурсии 					= Неопределено,	//Это цепочка преемников от изначального до текущего/пополняется
	СоответcтвиеСотрудников 		= Неопределено 	//Это соответствие всех сотрудников конечному преемнику, для ускорения перебора в таблице с повторениями сотрудников/Пополняется при проверки "ЭтоФизлицо"
	) Экспорт
	
	//|ВЫБРАТЬ
	//|ФизическиеЛицаОсновная.Ссылка,
	//|ФизическиеЛицаОсновная.Преемник,
	//|ФизическиеЛицаПреемник.Преемник КАК ПреемникПреемник
	//|ИЗ
	//|Справочник.ФизическиеЛица КАК ФизическиеЛицаОсновная
	//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛицаПреемник
	//|ПО ФизическиеЛицаОсновная.Преемник = ФизическиеЛицаПреемник.Ссылка
	ТипИсточника = ТипЗнч(Источник);
	ЭтоФизЛицо = ТипИсточника = Тип("СправочникСсылка.ФизическиеЛица");
	Если Не ЭтоФизЛицо Тогда
		ЭтоТаблицаЗначений = ТипИсточника = Тип("ТаблицаЗначений");
	Иначе
		ЭтоТаблицаЗначений = Ложь;
	КонецЕсли;
	Если СоответcтвиеСотрудников = Неопределено Тогда
		СоответcтвиеСотрудников = Новый Соответствие;
	КонецЕсли;	
	Если ЭтоФизЛицо Или ЭтоТаблицаЗначений Тогда
		Если ВыборкаПреемников = Неопределено Тогда
			ЗапросПоПреемникам = Новый Запрос;
			ЗапросПоПреемникам.Текст = "ВЫБРАТЬ
			|	ФизическиеЛица.Ссылка,
			|	ФизическиеЛица.Преемник
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизическиеЛица
			|ГДЕ
			|	НЕ ФизическиеЛица.Преемник = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|	И ФизическиеЛица.Ссылка <> ФизическиеЛица.Преемник";
			ВыборкаПреемников = ЗапросПоПреемникам.Выполнить().Выбрать();
		КонецЕсли;
		Если КэшРекурсии = Неопределено Тогда
			КэшРекурсии = Новый Массив;
		КонецЕсли;	
		СтруктураПоиска = Новый Структура("Ссылка");
		
		Если ЭтоФизЛицо Тогда
			
			ИзУжеПроверенных = СоответcтвиеСотрудников.Получить(Источник);
			Если ИзУжеПроверенных = Неопределено Тогда
				//Для этого сотрудника преемника еще не искали
				СтруктураПоиска.Ссылка = Источник;
				ВыборкаПреемников.Сбросить();
				Если ВыборкаПреемников.НайтиСледующий(СтруктураПоиска) И Не Источник = Null И Не Источник = Неопределено Тогда
					ТекПреемник = ВыборкаПреемников.Преемник.Ссылка;
					Если КэшРекурсии.Найти(ТекПреемник)= Неопределено Тогда
						//Раскручиваем дальше
						КэшРекурсии.Добавить(ТекПреемник);
						Преемник = ПолучитьПреемникаСотрудника(ВыборкаПреемников.Преемник.Ссылка,,ВыборкаПреемников,КэшРекурсии,СоответcтвиеСотрудников);
					Иначе
						//Зацикливание
						Преемник = Источник;	
						ДополнитьПреемниковПоКэшу(СоответcтвиеСотрудников,КэшРекурсии,Преемник);
					КонецЕсли;	
				Иначе 
					//Нет преемника
					Преемник = Источник;
					КэшРекурсии.Добавить(Преемник);
					ДополнитьПреемниковПоКэшу(СоответcтвиеСотрудников,КэшРекурсии,Преемник);
				КонецЕсли;
			Иначе
				//Уже нашли
				Преемник = ИзУжеПроверенных;
			КонецЕсли;
			
			//Источник = Преемник;
			Возврат Преемник;
		Иначе //Если ЭтоТаблицаЗначений Тогда
			Если ТипЗнч(МассивИменКолонокСотрудников) = Тип("Строка") Тогда
				Массив = Новый Массив;
				Массив.Добавить(МассивИменКолонокСотрудников);
				МассивИменКолонокСотрудников = Массив;
			КонецЕсли;
			ЕстьКолонкаТипПодразделения = Источник.Колонки.Найти("ТипПодразделения") <> Неопределено;
			Для Каждого СтрокаТЗ Из Источник Цикл
				ТЗ = Новый ТаблицаЗначений;
				Если ЕстьКолонкаТипПодразделения И СтрокаТЗ.ТипПодразделения = Перечисления.уб_ТипыПодразделений.Курьеры Тогда
					Продолжить;
				КонецЕсли;	
				Для Каждого ИмяКолонкиСотрудника Из МассивИменКолонокСотрудников Цикл
					ТекСотрудник = СтрокаТЗ[ИмяКолонкиСотрудника];
					СтрокаТЗ[ИмяКолонкиСотрудника] = ПолучитьПреемникаСотрудника(ТекСотрудник,, ВыборкаПреемников, КэшРекурсии, СоответcтвиеСотрудников);
					КэшРекурсии = Неопределено;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	Иначе
		// любой другой тип
		Возврат Источник;
	КонецЕсли;
	
КонецФункции

