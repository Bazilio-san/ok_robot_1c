КонецПроцедуры

Процедура ПроверитьУникальностьНомеровОбъектаМетаданных(ОбъектМетаданных, ТипМетаданных)
	
	СоотТипов = СоответствиеСтрокТиповМетаданных();
	Тип = СоотТипов.Получить(ТипМетаданных);
	Если ОбъектМетаданных.ДлинаКода > 0 Тогда 
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Объект.Код
		|ПОМЕСТИТЬ ВТ_Кодов
		|ИЗ
		|	" + Тип + "." + ОбъектМетаданных.Имя + " КАК Объект
		|ГДЕ
		|	Объект.Предопределенный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Объект.Ссылка,
		|	Объект.Код
		|ИЗ
		|	" + Тип + "." + ОбъектМетаданных.Имя + " КАК Объект
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Кодов КАК ВТ_Кодов
		|		ПО Объект.Код = ВТ_Кодов.Код
		|ГДЕ
		|	НЕ Объект.Предопределенный");
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.УстановитьНовыйКод();
				Попытка
					Объект.Записать()
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка записи ПроверитьУникальностьНомеровОбъектаМетаданных(): " + ОбъектМетаданных + ", Описание: " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина)
				КонецПопытки;
				#Если Клиент Тогда
					Сообщить(Строка(Выборка.Ссылка) + ", Старый код: " + Выборка.Код + ", Новый код: " + Объект.Код)
				#КонецЕсли
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

//убирает из строки символы, запрещенные в именовании файлов
//инфо из википедии
//Многие операционные системы запрещают использование некоторых служебных символов. Запрещенные символы Windows:
// \ - разделитель подкаталогов
// / - разделитель ключей командного интерпретатора
// : - отделяет букву диска или имя альтернативного потока данных
// * - заменяющий символ (маска "любое количество любых символов")
// ? - заменяющий символ (маска "один любой символ")
// " - используется для указания путей, содержащих пробелы
// < - перенаправление ввода
// > - перенаправление вывода
// | - обозначает конвейер
//
//TODO специальные символы
Функция УбратьЗапрещенныеСимволыИзИмениФайла(Знач Строка) Экспорт
	
	Строка = СтрЗаменить(Строка, "\", "");
	Строка = СтрЗаменить(Строка, "/", "");
	Строка = СтрЗаменить(Строка, ":", "");
	Строка = СтрЗаменить(Строка, "*", "");
	Строка = СтрЗаменить(Строка, "?", "");
	Строка = СтрЗаменить(Строка, """", "");
	Строка = СтрЗаменить(Строка, "<", "");
	Строка = СтрЗаменить(Строка, ">", "");
	Строка = СтрЗаменить(Строка, "|", "");
	Возврат Строка;
	
КонецФункции // УбратьЗапрещенныеСимволыИзИмениФайла()

Функция СтруктураНастроекДвиженийДокументов(Имя) Экспорт
	
	Результат = Новый Структура;
	//проверки
	Структура = Новый Структура;
	Стр = Новый Структура;
	Стр.Вставить("Использование", 	Истина);
	Стр.Вставить("Текст",			"ВТ_ТЧ.Номерной И ВТ_ТЧ.НомерБСО = """"");
	Стр.Вставить("Ошибка",			"Не указан &СОО");
	Структура.Вставить("НеУказанНомерБСО", Стр);
	Стр = Новый Структура;
	Стр.Вставить("Использование", 	Истина);
	Стр.Вставить("Текст",			"ВТ_ТЧ.Поставщик <> ДБ.Поставщик");
	Стр.Вставить("Ошибка",			" поступало от поставщика '&РСПоставщик'. В документе указан другой поставщик: '&Поставщик'.");
	Структура.Вставить("НесоответствиеПоставщиков",	Стр);
	Стр = Новый Структура;
	Стр.Вставить("Использование", 	Истина);
	Стр.Вставить("Текст",			"ВТ_ТЧ.ОрганизацияАгент <> ДБ.ОрганизацияАгент");
	Стр.Вставить("Ошибка",			" поступало от ОргАгент '&РСОргАгент'. В документе указан другой ОргАгент: '&ОргАгент'.");
	Структура.Вставить("НесоответствиеОргАгентов", Стр);
	Стр = Новый Структура;
	Стр.Вставить("Использование", 	Истина);
	Стр.Вставить("Текст",			"ДБ.Период ЕСТЬ NULL");
	Стр.Вставить("Ошибка",			"&СОО не поступало!");
	Структура.Вставить("НеПоступало", Стр);
	Стр = Новый Структура;
	Стр.Вставить("Использование", 	Истина);
	Стр.Вставить("Текст",			"ДБ.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданВСК)");
	Стр.Вставить("Ошибка",			"&СОО имеет положение: '&РСПоложение'.");
	Структура.Вставить("НеверноеПоложение",	Стр);
	Результат.Вставить("СтруктураЗапроса", 	Структура);
	ТЗПолей = Новый ТаблицаЗначений;
	ТЗПолей.Колонки.Добавить("Реквизит");
	ТЗПолей.Колонки.Добавить("Источник");
	ТЗПолей.Колонки.Добавить("Значение");
	ТЗПолей.Колонки.Добавить("ЧастныйКод");
	//соответствие полей
	//TODO расположить в соответствии количества записей регистра движений
	Если Имя = "уб_СписаниеБСО" Тогда
		СтруктураЗапроса = Результат.СтруктураЗапроса;
		СтруктураЗапроса.НеверноеПоложение.Использование = Ложь;
		//поля
		СтрокаТЗ = ТЗПолей.Добавить();
		СтрокаТЗ.Реквизит = "Период";
		СтрокаТЗ.Источник = "Объект";
		СтрокаТЗ.Значение = "Дата";
		СтрокаТЗ = ТЗПолей.Добавить();
		СтрокаТЗ.Реквизит = "ВидБСО";
		СтрокаТЗ.Источник = "ТЧ";
		СтрокаТЗ.Значение = "ВидБСО";
		СтрокаТЗ = ТЗПолей.Добавить();
		СтрокаТЗ.Реквизит = "НомерБСО";
		СтрокаТЗ.Источник = "ТЧ";
		СтрокаТЗ.Значение = "НомерБСО";
		СтрокаТЗ.ЧастныйКод = "СокрЛП(Значение)";
		
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // СтруктураНастроекДвиженийДокументов()

Процедура ДвиженияПоРегистрам3(
	Объект, 
	Отказ,
	Параметры
	) Экспорт
	
	МассивДанныхРС = Новый Массив;
	МассивДанныхРС.Добавить("Измерения");
	МассивДанныхРС.Добавить("Ресурсы");
	МассивДанныхРС.Добавить("Реквизиты");
	//
	Движения = Объект.Движения;
	ИмяДокумента = Объект.Метаданные().Имя;
	НастройкиДокумента = уб_temp.СтруктураНастроекДвиженийДокументов(ИмяДокумента);
	СтруктураЗапроса 	= НастройкиДокумента.СтруктураЗапроса;
	ТЗПолей				= НастройкиДокумента.ТЗПолей;
	Период = Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТЧ.*,
	|	ВЫБОР
	|		КОГДА ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.КоличественныйПолисИзСвободных)
	|				ИЛИ ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.КоличественныйПолисВручную)
	|				ИЛИ ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.КоличественныйНетПолиса)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Номерной,
	|	НЕ(ТЧ.Ссылка.Проведен
	|			И ТЧ.Подтверждено) КАК Инфозапись
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	Документ." + ИмяДокумента + "." + Параметры.ИмяТЧ + " КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|	И НЕ(ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.УчетНеВедетсяПолисИзСвободных)
	|				ИЛИ ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.УчетНеВедетсяПолисВручную)
	|				ИЛИ ТЧ.ВидБСО.ТипУчетаБСО = ЗНАЧЕНИЕ(Перечисление.уб_ТипыУчетаБСО.УчетНеВедетсяНетПолиса))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.*,
	|	ДБ.Период КАК ДБПериод,
	|	ДБ.ВидБСО КАК ДБВидБСО,
	|	ДБ.НомерБСО КАК ДБНомерБСО,
	|	ДБ.ДопНомерБСО КАК ДБДопНомерБСО,
	|	ДБ.Подтверждено КАК ДБПодтверждено,
	|	ДБ.СК КАК ДБСК,
	|	ДБ.Поставщик КАК ДБПостащик,
	|	ДБ.ОрганизацияАгент КАК ДБОрганизацияАгент,
	|	ДБ.АгентОтправитель КАК ДБАгентОтправитель,
	|	ДБ.Агент КАК ДБАгент,
	|	ДБ.ПоложениеБСО КАК ДБПоложениеБСО,
	|	ДБ.СостояниеБСО КАК ДБСостояниеБСО,
	|	ДБ.НомерПолиса КАК ДБНомерПолиса,
	|	ДБ.ГодПолиса КАК ДБГодПолиса,
	|	ДБ.СтраховойПолис КАК ДБСтраховойПолис,
	|	ДБ.НаОснованииБумажногоДокумента КАК ДБНаОснованииБумажногоДокумента,
	|	ДБ.ДатаВозврата КАК ДБДатаВозврата,
	|	ДБ.Заявка КАК ДБЗаявка,
	|	ДБ.КодОперации КАК ДБКодОперации,
	|	ДБ.Комментарий КАК ДБКомментарий,
	|	ДБ.Активность КАК ДБАктивность,
	|	ВЫБОР
	|		КОГДА &НеИспользоватьБлокировкиБСО = ИСТИНА
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ)
	|	КОНЕЦ КАК Блокировка,
	|	&Отказ,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТЧ.ВидБСО) КАК ВидБСОСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТЧ.СК) КАК СКСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТЧ.Поставщик) КАК ПоставщикСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ДБ.Поставщик) КАК ДБПоставщикСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ТЧ.ОрганизацияАгент) КАК ОргАгентСтрока,
	|	ПРЕДСТАВЛЕНИЕ(ДБ.ОрганизацияАгент) КАК ДБОргАгентСтрока
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
	|				&Период,
	|				Подтверждено
	|					) КАК ДБ
	|		ПО ВТ_ТЧ.ВидБСО = ДБ.ВидБСО
	|			И ВТ_ТЧ.НомерБСО = ДБ.НомерБСО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних(&Период, ) КАК уб_БлокировкаБСОСрезПоследних
	|		ПО ВТ_ТЧ.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
	|			И ВТ_ТЧ.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО
	|
	|УПОРЯДОЧИТЬ ПО
	|	Отказ УБЫВ,
	|	ВТ_ТЧ.НомерСтроки,
	|	ДБ.Период УБЫВ");
	
	ДопТекстОтказ = "";
	ДопТекст = "";
	Для Каждого КлючИЗначение Из СтруктураЗапроса Цикл
		Значение = КлючИЗначение.Значение;
		Если Значение.Использование Тогда
			Текст = Значение.Текст;
			ДопТекстОтказ = ДопТекстОтказ + "(" + Текст + ") ИЛИ ";
			ДопТекст = ДопТекст +
			"
			|ВЫБОР
			|		КОГДА " + Текст + "
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК " + КлючИЗначение.Ключ + ",";
		КонецЕсли;
	КонецЦикла;
	ДопТекстОтказ = 
	"ВЫБОР 
	|	КОГДА " + Лев(ДопТекстОтказ, СтрДлина(ДопТекстОтказ) - 5) + " ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Отказ,";
	ДопТекст = Лев(ДопТекст, СтрДлина(ДопТекст) - 1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отказ", ДопТекстОтказ + ДопТекст);
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("Ссылка", 						Объект.Ссылка);
	Запрос.УстановитьПараметр("НеИспользоватьБлокировкиБСО", 	ПараметрыСеанса.уб_Константы.уб_НеИспользоватьБлокировкиБСО = Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	СообщениеОшибки = Новый СообщениеПользователю;
	Пока Выборка.СледующийПоЗначениюПоля("НомерСтроки") Цикл
		Если Выборка.Отказ Тогда
			Отказ = Истина;
			СОО = "БСО № '" + Выборка.НомерБСО + "' [" + Выборка.ВидБСОСтрока + "], СК: '" + Выборка.СКСтрока + "', Строка: '" + Выборка.НомерСтроки + "' ";
			Для Каждого КлючИЗначение Из СтруктураЗапроса Цикл
				Стр = КлючИЗначение.Значение;
				Если Стр.Использование И Выборка[КлючИЗначение.Ключ] Тогда
					Текст = Стр.Ошибка;
					Текст = СтрЗаменить(Текст, "&СОО", 			СОО);
					Текст = СтрЗаменить(Текст, "&РСПоставщик",	Выборка.ДБПоставщикСтрока);
					Текст = СтрЗаменить(Текст, "&Поставщик",	Выборка.ПоставщикСтрока);
					Текст = СтрЗаменить(Текст, "&РСОргАгент",	Выборка.ДБОргАгентСтрока);
					Текст = СтрЗаменить(Текст, "&ОргАгент",		Выборка.ОргАгентСтрока);
					Текст = СтрЗаменить(Текст, "&РСПоложение",	Выборка.ПоложениеБСО);
					СообщениеОшибки.Текст = СообщениеОшибки.Текст + Текст;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Не Отказ Тогда
			Если Выборка.Номерной Тогда
				Движение = Движения.уб_ДвиженияБСО.Добавить();
				ДобавитьДвижение(Движение, "Период", ТЗПолей, Выборка);
				Для Каждого Элемент Из МассивДанныхРС Цикл
					Для Каждого Реквизит Из Метаданные.РегистрыСведений.уб_ДвиженияБСО[Элемент] Цикл
						ДобавитьДвижение(Движение, Реквизит.Имя, ТЗПолей, Выборка);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не Отказ Тогда
