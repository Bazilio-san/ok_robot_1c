Функция  ОшибкаПоИсходномуКоду(ИсходныйКод, СообщениеОшибки) Экспорт
	СтрокаОшибки     = "";
	КоординатыОшибки = ПолучитьКоординатыОшибкиВКоде(СообщениеОшибки);
	
	Если КоординатыОшибки.НомерСтроки > 0 Тогда
		
		Если СтрЧислоСтрок(ИсходныйКод) >= КоординатыОшибки.НомерСтроки Тогда
			
			СтрокаОшибки = СтрПолучитьСтроку(ИсходныйКод, КоординатыОшибки.НомерСтроки);
			
			Если КоординатыОшибки.НомерСимвола > 0 Тогда
				
				СтрокаОшибки = Лев(СтрокаОшибки, КоординатыОшибки.НомерСимвола - 1) + 
				               "<<?>>" +
				               Прав(СтрокаОшибки, СтрДлина(СтрокаОшибки) - КоординатыОшибки.НомерСимвола + 1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	Возврат "Описание ошибки: '" + СообщениеОшибки + "'" + Символы.ПС +  
	            ?(Не КоординатыОшибки.НомерСтроки  = 0, "Номер строки = "  + КоординатыОшибки.НомерСтроки  + "" + Символы.ПС, "") + 
	            ?(Не КоординатыОшибки.НомерСимвола = 0, "Номер позиции = " + КоординатыОшибки.НомерСимвола + "" + Символы.ПС, "") + 
	            ?(Не ПустаяСтрока(СтрокаОшибки), "Исходная строка: '" + СтрокаОшибки + "'" + Символы.ПС, "") + "";
	 
КонецФункции	
