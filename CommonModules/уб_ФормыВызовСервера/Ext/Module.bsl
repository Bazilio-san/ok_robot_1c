Процедура УдалитьСтарыеКнопкиПоУмолчанию(Форма, ОсновныеДействияФормы)
	
	ТабПФ = Форма.ТабПФ;
	КоличествоСтрок = ТабПФ.Количество();
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТЗ = ТабПФ[КоличествоСтрок - Счетчик];
		Если СтрокаТЗ.ПоУмолчанию = Истина Или СтрокаТЗ.СсылкаПФ = Неопределено Тогда
			Элемент = ОсновныеДействияФормы.Кнопки.Найти(СтрокаТЗ.КодПФ);
			Если Элемент <> Неопределено Тогда
				ОсновныеДействияФормы.Кнопки.Удалить(Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
