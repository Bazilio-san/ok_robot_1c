#Область ОтборыСписков
//Для форм списка
Процедура ОтборПоПолю(Форма,ИмяПоля,ВыбВидсравнения = Неопределено,ИмяПоляДанные="")Экспорт
	ЕСли ИмяПоляДанные ="" Тогда
		ИмяПоляДанные = ИмяПоля;
	КонецЕсли;	
	Если ВыбВидсравнения = Неопределено Тогда  
		ВыбВидсравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;	
	флНайден = Ложь;
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяПоляДанные);
	ДЛя каждого Эл из Форма.Список.Отбор.Элементы Цикл 
		Если Эл.ЛевоеЗначение = ИскомоеПоле тогда
			элНаим = Эл;
			флНайден = истина;
		КонецЕсли;	
	КонецЦикла;	
	
	Если флНайден = Ложь тогда
		элНаим = Форма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		элНаим.ЛевоеЗначение  = ИскомоеПоле;
	КонецЕсли;
	Поле = Форма[ИмяПоля];
	элНаим.ПравоеЗначение = Поле;
	элНаим.Использование = ЗначениеЗаполнено(Поле);
	
Конецпроцедуры

Процедура УстановитьОтборыСписка(Список,Отборы,ЭтоИЛИ = ЛОЖЬ) Экспорт
	Для каждого Отбор из Отборы Цикл
		ОтборВидСравнения = Неопределено;
		Если НЕ Отбор.Свойство("ВидСравнения",ОтборВидСравнения) Тогда;
			ОтборВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;	
		ОтборПредставление = "";
		Если НЕ Отбор.Свойство("Представление",ОтборПредставление) Тогда;
			ОтборПредставление = "";
		КонецЕсли;	
		
		УстановитьОтборСписка(Список,Отбор.ИмяПоля, Отбор.Значение,ОтборВидСравнения,Отбор.Использование,ОтборПредставление,ЭтоИЛИ);
	КонецЦикла;	
КонецПроцедуры		


Процедура УстановитьОтборСписка(Список,ИмяПоляДанные, Значение,ВыбВидсравнения = Неопределено,Использование = Неопределено,Представление = "",ЭтоИЛИ = ЛОЖЬ) Экспорт
	Если ВыбВидсравнения = Неопределено Тогда  
		ВыбВидсравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;	
	
	Если ЭтоИли = Истина Тогда
		НайденаГруппа = Ложь;
		Группа = Неопределено;
		ДЛя каждого Элемент из Список.Отбор.Элементы Цикл 
			Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
				и  Элемент.ТипГруппы= ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли
				Тогда
				Группа = Элемент;
				НайденаГруппа = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;		
		Если НайденаГруппа = Ложь Тогда
			Группа = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			Группа.ТипГруппы= ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			Группа.Использование = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	
	ОтборНайден = Ложь;
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяПоляДанные);
	Если ЭтоИли = Истина Тогда
		МестоПоиска = Группа.Элементы;
	Иначе
		МестоПоиска = Список.Отбор.Элементы;
	КонецЕсли;	
	ДЛя каждого Элемент из МестоПоиска  Цикл 
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если Элемент.ЛевоеЗначение = ИскомоеПоле и Элемент.Представление = Представление тогда
				ОтборНайден = истина;
				Прервать
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Если ОтборНайден = Ложь тогда
		Элемент = МестоПоиска.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение  = ИскомоеПоле;
		Элемент.Представление  = Представление;
	КонецЕсли;
	
	Элемент.ВидСравнения = ВыбВидсравнения;
	Если Использование = Неопределено Тогда
		Элемент.Использование = ЗначениеЗаполнено(Значение);
	Иначе
		Элемент.Использование = Использование;
	КонецЕсли;	
	
	Элемент.ПравоеЗначение = Значение;
	
Конецпроцедуры
#КонецОбласти

#Область КнопкиПечати

Процедура УстановитьКнопкиПечати(
	Форма,
	Ссылка										= Неопределено,
	ПолучатьСтруктуруПечатныхФормИзОбщегоМодуля = Истина,
	УстановитьПодменюПечати                     = Истина,
	УстановитьПечатьПоУмолчанию					= Истина,
	ИмяНадписиАвтор								= "НадписьАвтор",
	ДобавлятьСубагентскиеПФ						= Ложь
	) Экспорт
	
	ОсновныеДействияФормы	= Форма.Элементы.Найти("ОсновныеДействияФормы");
	Если ОсновныеДействияФормы = Неопределено Тогда
		ОсновныеДействияФормы = Форма.Элементы.Добавить("ОсновныеДействияФормы",Тип("ГруппаФормы"),Форма.КоманднаяПанель);
		ОсновныеДействияФормы.Вид       = ВидГруппыФормы.ГруппаКнопок;
		ОсновныеДействияФормы.Заголовок = "Печать";
		
