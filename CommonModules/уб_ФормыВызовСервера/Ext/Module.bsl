
Процедура ДобавитьОбщиеРеквизиты(Форма,Объект) Экспорт
	ЭлементыИмени = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Форма.ИмяФормы,".");
	
	Если ЭлементыИмени[0] = "Справочник" или ЭлементыИмени[0] = "Документ" Тогда
		Используется  = Метаданные.ОбщиеРеквизиты.Автор.Состав.Найти(Объект.Метаданные());
		Используется = Используется<>Неопределено и Строка(Используется.Использование) = "Использовать"; 
		ИмяОбъекта = "Объект";
	Иначе
		Используется = Ложь;
	КонецЕсли;	
	Если Используется = Истина Тогда
		Если Найти(ЭлементыИмени[3], "ФормаЭлемента")>0 Тогда
			Группа = Форма.Элементы.Добавить("ГруппаОбщиеРеквизитыПодвал",Тип("ГруппаФормы"),Форма);
			Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			
			Элемент = Форма.Элементы.Добавить("ОбщиеРеквизитыАвтор",Тип("ПолеФормы"),Группа);
			Элемент.Вид = ВидПоляФормы.ПолеНадписи;
			Элемент.ПутьКДанным = ИмяОбъекта+".Автор";
			Элемент.ЦветТекста          = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаКУДА;
			
			Элемент = Форма.Элементы.Добавить("ОбщиеРеквизитыДатаСоздания",Тип("ПолеФормы"),Группа);
			Элемент.Вид = ВидПоляФормы.ПолеНадписи;
			Элемент.ПутьКДанным = ИмяОбъекта+".ДатаСоздания";
			Элемент.Формат = "ДФ='dd.MM.yyyy HH:mm'";
			Элемент.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаКУДА;
			
			Элемент = Форма.Элементы.Добавить("ОбщиеРеквизитыМодификатор",Тип("ПолеФормы"),Группа);
			Элемент.Вид = ВидПоляФормы.ПолеНадписи;
			Элемент.ПутьКДанным = ИмяОбъекта+".Модификатор";
			Элемент.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаКУДА;
			
			Элемент = Форма.Элементы.Добавить("ОбщиеРеквизитыДатаИзменения",Тип("ПолеФормы"),Группа);
			Элемент.Вид = ВидПоляФормы.ПолеНадписи;
			Элемент.ПутьКДанным = ИмяОбъекта+".ДатаИзменения";
			Элемент.Формат = "ДФ='dd.MM.yyyy HH:mm'";
			Элемент.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаКУДА;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	


#Область КонтактнаяИнформация
Процедура ДобавитьКонтактнуюИнформацию(Форма,Объект,ИмяОбъекта = "Объект",Группа = Неопределено,Использование = 1) Экспорт
	ЭлементыИмени = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Форма.ИмяФормы,".");
	
	Если ЭлементыИмени[1] = "Организации" Тогда
		ВидыКонтактнойИнформации = УправлениеКонтактнойИнформациейВызовСервера.ВидыКонтактнойИнформации(Перечисления.ВидыОбъектовКонтактнойИнформации.Организации,Использование);
	ИначеЕсли ЭлементыИмени[1] = "Контрагенты" Тогда
		ВидыКонтактнойИнформации = УправлениеКонтактнойИнформациейВызовСервера.ВидыКонтактнойИнформации(Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты,Использование);	
	ИначеЕсли ЭлементыИмени[1] = "ФизическиеЛица" Тогда
		ВидыКонтактнойИнформации = УправлениеКонтактнойИнформациейВызовСервера.ВидыКонтактнойИнформации(Перечисления.ВидыОбъектовКонтактнойИнформации.ФизическиеЛица,Использование);		
	ИначеЕсли ЭлементыИмени[1] = "КонтактныеЛица" Тогда
		ВидыКонтактнойИнформации = УправлениеКонтактнойИнформациейВызовСервера.ВидыКонтактнойИнформации(Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица,Использование);			
	Иначе
		ВидыКонтактнойИнформации = Новый Массив;
	КонецЕсли;	
	
	Если ВидыКонтактнойИнформации.Количество() = 0 Тогда
		Возврат
	КонецЕсли;
	
	Если Группа = Неопределено Тогда
		Группа = Форма.Элементы.Добавить("ГруппаКонтактнойИнформации",Тип("ГруппаФормы"),Форма);
		Группа.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Заголовок   = "Контактная информация";
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	МассивРеквизитов = Новый Массив;
	
	ПравоИзменения = ПравоДоступа("Изменение",Метаданные.Справочники[ЭлементыИмени[1]]);
	
	//Создание реквизитов для хранения КИ
	Для каждого ВидКонтактнойИнформации из ВидыКонтактнойИнформации Цикл
		УИД = СтрЗаменить(Строка(ВидКонтактнойИнформации.УникальныйИдентификатор()),"-","_");
		Если ВидКонтактнойИнформации.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
			Длина = 200;
		ИначеЕсли ВидКонтактнойИнформации.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Длина = 30;
		ИначеЕсли ВидКонтактнойИнформации.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			Длина = 50;	
		ИначеЕсли ВидКонтактнойИнформации.Тип = Перечисления.ТипыКонтактнойИнформации.ВебСтраница Тогда
			Длина = 100;		
		Иначе
			Длина = 30;			
		КонецЕсли;	
		Квалификаторы  = Новый КвалификаторыСтроки(Длина,ДопустимаяДлина.Переменная);  
		
		МассивРеквизитов.Добавить(Новый РеквизитФормы("КИ_"+УИД,Новый ОписаниеТипов("Строка",,,,Квалификаторы)));
		
	КонецЦикла;	
	Форма.ИзменитьРеквизиты(МассивРеквизитов);
	
	//Создаем поля формы
	Для каждого ВидКонтактнойИнформации из ВидыКонтактнойИнформации Цикл
		УИД = СтрЗаменить(Строка(ВидКонтактнойИнформации.УникальныйИдентификатор()),"-","_");
		
		Элемент = Форма.Элементы.Добавить("КИ_"+УИД,Тип("ПолеФормы"),Группа);
		Элемент.Вид            = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным    = Элемент.Имя;
		Элемент.Заголовок      = ВидКонтактнойИнформации;
		Элемент.ТолькоПросмотр = НЕ ПравоИзменения;
		Если ВидКонтактнойИнформации.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Элемент.РастягиватьПоГоризонтали = Ложь; 
			Элемент.Ширина = 20;
		КонецЕсли;	
	КонецЦикла;	
	
	
	
	//Заполнение значениями из базы
	Значения = УправлениеКонтактнойИнформациейВызовСервера.ПрочитатьКонтактнуюИнформацию(Форма[ИмяОбъекта].Ссылка);	
	Для каждого ВидКонтактнойИнформации из ВидыКонтактнойИнформации Цикл
		нСтроки = Значения.НайтиСтроки(Новый Структура("Вид",ВидКонтактнойИнформации));
		Для каждого ЗначениеКИ из нСтроки Цикл
			Если Не ПустаяСтрока(ЗначениеКИ.Представление) Тогда
				УИД              = СтрЗаменить(Строка(ВидКонтактнойИнформации.УникальныйИдентификатор()),"-","_");
				Форма["КИ_"+УИД] = ЗначениеКИ.Представление;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	
КонецПроцедуры

//Считываем из базы значения, переписываем их значениями из формы и записываем в базу
Процедура ЗаписатьКонтактнуюИнформацию(Форма,ИмяОбъекта = "Объект",Отказ) Экспорт
	
	Значения = УправлениеКонтактнойИнформациейВызовСервера.ПрочитатьКонтактнуюИнформацию(Форма[ИмяОбъекта].Ссылка);	
	Для каждого Значение из Значения Цикл
		Попытка 
			Значение.Представление = Форма["КИ_"+СтрЗаменить(Строка(Значение.Вид.УникальныйИдентификатор()),"-","_")];
		Исключение
		КонецПопытки;	
	КонецЦикла;	
	
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Значения);
	
	УправлениеКонтактнойИнформациейВызовСервера.ЗаписатьКонтактнуюИнформацию(НаборЗаписей,Форма[ИмяОбъекта].Ссылка,Отказ);
КонецПроцедуры 	


