//получает подменю печати или кнопку печати по умолчанию
//Кнопки - кнопки командной панели
//ТипРезультата. Неопределено - возвращает структурой, либо определить "Подменю" Или "ПоУмолчанию"
Функция КнопкаПечатиИзКнопокКП(Кнопки, ТипРезультата = Неопределено) Экспорт
	
	Если ТипРезультата = Неопределено Тогда
		ИскатьПодменю 		= Истина;
		ИскатьПоУмолчанию   = Истина;
		КнопкаПоУмолчанию	= Неопределено;
		КнопкаПодменю 		= Неопределено;
	ИначеЕсли ТипРезультата = "Подменю" Тогда
		ИскатьПодменю		= Истина;
		ИскатьПоУмолчанию	= Ложь;
		КнопкаПодменю 		= Неопределено;
	ИначеЕсли ТипРезультата = "ПоУмолчанию" Тогда
		ИскатьПодменю		= Ложь;
		ИскатьПоУмолчанию	= Истина;
		КнопкаПоУмолчанию	= Неопределено;
	КонецЕсли;
	Если ИскатьПодменю Или ИскатьПоУмолчанию Тогда
		Для Каждого Кнопка Из Кнопки Цикл
			Если ИскатьПодменю И Кнопка.Подсказка = "Меню выбора печатных форм" Тогда
				Если КнопкаПодменю = Неопределено Тогда
					КнопкаПодменю = Кнопка
				Иначе
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Дублирование подменю печати", ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина)
				КонецЕсли;
				Если Не ИскатьПоУмолчанию Или КнопкаПоУмолчанию <> Неопределено Тогда
					Прервать
				КонецЕсли;
			КонецЕсли;
			Если ИскатьПоУмолчанию И Кнопка.Подсказка = "Печать по умолчанию" Тогда
				Если КнопкаПоУмолчанию = Неопределено Тогда
					КнопкаПоУмолчанию = Кнопка
				Иначе	
					//TODO проверить, сейчас несколько кнопок, и дублирование вполне нормально?	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Дублирование печати по умолчанию", "НеСообщать", Истина)
				КонецЕсли;
				Если Не ИскатьПодменю Или КнопкаПодменю <> Неопределено Тогда
					Прервать
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ТипРезультата = Неопределено Тогда
			//возвращаем структуру
			Результат = Новый Структура("Подменю, ПоУмолчанию", КнопкаПодменю, КнопкаПоУмолчанию)
		ИначеЕсли ТипРезультата = "Подменю" Тогда
			Результат = КнопкаПодменю
		ИначеЕсли ТипРезультата = "ПоУмолчанию" Тогда
			Результат = КнопкаПоУмолчанию
		КонецЕсли
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // КнопкаПечати()

