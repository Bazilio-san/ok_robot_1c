Процедура ДобавитьТаблицуПечатныхФорм(Форма)
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПечатныеФормы",Новый ОписаниеТипов("ТаблицаЗначений"),""));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("КодПФ",Новый ОписаниеТипов("Строка"),"ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Наименование",Новый ОписаниеТипов("Строка"),"ПечатныеФормы"));
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Новый ОписаниеТипов("СправочникСсылка.ВнешниеОбработки"));
	МассивТипов.Добавить(Новый ОписаниеТипов("СправочникСсылка.уб_ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СсылкаПФ",Новый ОписаниеТипов(МассивТипов),"ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ДобавлятьВМенюПечати",Новый ОписаниеТипов("Булево"),"ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Статус",Новый ОписаниеТипов("Строка"),"ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Действовала",Новый ОписаниеТипов("Булево"),"ПечатныеФормы"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПоУмолчанию",Новый ОписаниеТипов("Булево"),"ПечатныеФормы"));
	
	
	Форма.ИзменитьРеквизиты(МассивРеквизитов);
КонецПроцедуры	

