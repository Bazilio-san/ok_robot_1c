//Получение МОЛ по БСО (!Ссылку на ФизЛицо!) для переданного подразделения
// начиная с переданного подразделения
// по иерархии подразделений вверх, ищем такое, у которого одновременно 
// указано "Учет БСО" и установлен МОЛ по БСО
Функция ПолучитьМОЛпоБСО(Подразделение) Экспорт
	
	ИскомоеПодразделение = уб_СС.ПолучитьПодразделениеМОЛпоБСО(Подразделение);
	Если ИскомоеПодразделение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИскомоеПодразделение.МОЛпоБСО;
	
КонецФункции

Функция ДоступностьРоли(Роль, ТипСравненияИ = Ложь) Экспорт
	
	МассивРолей = РазложитьСтрокуВМассивПодстрок(Роль);
	Результат = ?(МассивРолей.Количество() = 0, Ложь, ТипСравненияИ);
	Для Каждого ЭлементМассива Из МассивРолей Цикл
		Если ТипСравненияИ Тогда
			Попытка
				Если Не РольДоступна(СокрЛП(ЭлементМассива)) Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;
			Исключение
				Результат = Ложь;
			КонецПопытки	
		Иначе
			//Или
			Попытка
				Если РольДоступна(СокрЛП(ЭлементМассива)) Тогда
					Результат = Истина;
					Прервать;
				КонецЕсли;
			Исключение
				Результат = Ложь;
			КонецПопытки	
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",")
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // глРазложить

Функция ЦветаСправочникаЦветов(Знач Цвета, ПроверятьКоличество = Истина, ИскатьПоРодителю = Ложь) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ц.Красный,
	|	Ц.Зеленый,
	|	Ц.Синий,
	|	Ц.Абсолютный,
	|	Ц.Ссылка,
	|	ВЫБОР
	|		КОГДА Ц.Web = """"
	|			ТОГДА ""000000""
	|		ИНАЧЕ Ц.Web
	|	КОНЕЦ КАК Web
	|ИЗ
	|	Справочник.уб_Цвета КАК Ц
	|ГДЕ
	|	Ц.Предопределенный
	|	И &Условие");
	ТипЗнчЦвета = ТипЗнч(Цвета);
	ИмяСправочника  = "Ц";
	ИмяПоляЗамены 	= ?(ИскатьПоРодителю, "Родитель", "Ссылка");
	Если ТипЗнчЦвета = Тип("Строка") Тогда
		Попытка
			Условие = Справочники.уб_Цвета[Цвета];
		Исключение
			Возврат Неопределено;
		КонецПопытки;	
		Замена = ИмяСправочника + "." + ИмяПоляЗамены + " = &Условие";
		Если Не ИскатьПоРодителю Тогда
			Количество = 1
		КонецЕсли;
	ИначеЕсли ТипЗнчЦвета = Тип("СправочникСсылка.уб_Цвета") Тогда
		Условие = Цвета;
		Замена = ИмяСправочника + "." + ИмяПоляЗамены + " = &Условие";
		Если Не ИскатьПоРодителю Тогда
			Количество = 1
		КонецЕсли;
	Иначе
		//массив или список значений
		Массив = Новый Массив;
		Для Каждого Элемент Из Цвета Цикл
			Массив.Добавить(Справочники.уб_Цвета[Элемент.Ключ]);
		КонецЦикла;
		Условие = Массив;
		Замена = ИмяСправочника + "." + ИмяПоляЗамены + " В (&Условие)";
		Если Не ИскатьПоРодителю Тогда
			Количество = Цвета.Количество()
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Замена);
	Запрос.УстановитьПараметр("Условие", Условие);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ПроверятьКоличество И Количество <> Неопределено И ТЗ.Количество() <> Количество Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не найдены все необходимые данные справочника цветов!", ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина)
	Иначе
		ТЗ.Колонки.Добавить("Имя");
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			СтрокаТЗ.Имя = Справочники.уб_Цвета.ПолучитьИмяПредопределенного(СтрокаТЗ.Ссылка)
		КонецЦикла;
		Возврат ТЗ
	КонецЕсли;

КонецФункции // ЦветаСправочникаЦветов()

