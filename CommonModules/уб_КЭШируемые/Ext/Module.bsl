Функция СписокПоставщиков(СК = Неопределено) Экспорт
	Запрос = Новый Запрос;	
	УстановитьПривилегированныйРежим(Истина);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	уб_ПоступлениеБСО.Ссылка.Поставщик КАК Поставщик,
	               |	уб_ПоступлениеБСО.Ссылка.Поставщик.Наименование КАК Наименование
	               |ПОМЕСТИТЬ Врем
	               |ИЗ
	               |	Документ.уб_ПоступлениеБСО.БСО КАК уб_ПоступлениеБСО
	               |ГДЕ
	               |	уб_ПоступлениеБСО.Ссылка.Дата >= &Дата
	               |	И (уб_ПоступлениеБСО.СК = &СК
	               |			ИЛИ &СК = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	               |ОБЪЕДИНИТЬ 
				   |Выбрать Ссылка,
				   |	Ссылка.Наименование
				   | из справочник.Контрагенты где ссылка =&СК
				   |
				   //|ОБЪЕДИНИТЬ ВСЕ
				   //|
				   //|ВЫБРАТЬ РАЗЛИЧНЫЕ
				   //|	уб_ПоступлениеБСО.Поставщик,
				   //|	уб_ПоступлениеБСО.Поставщик.Наименование
				   //|ИЗ
				   //|	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПоступлениеБСО
				   //|ГДЕ
				   //|	уб_ПоступлениеБСО.Ссылка.Дата >= &Дата2
				   //|	И (уб_ПоступлениеБСО.СК = &СК
				   //|			ИЛИ &СК = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Врем.Поставщик,
	               |	Врем.Наименование КАК Наименование
	               |ИЗ
	               |	Врем КАК Врем
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
				   
   Запрос.УстановитьПараметр("Дата", Дата(2023,3,1));
   Запрос.УстановитьПараметр("Дата2", Дата(2023,3,1));
   
   Если СК = Неопределено Тогда
	    Запрос.УстановитьПараметр("СК", Справочники.Контрагенты.ПустаяСсылка());
   Иначе
	    Запрос.УстановитьПараметр("СК", СК);
   КонецЕсли;
	
   Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Поставщик");
   УстановитьПривилегированныйРежим(Ложь);
   возврат Массив;	
КонецФункции

Функция СписокКонтролеров(КакМассив = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НастройкиПользователей.Пользователь.ФизЛицо КАК ФизЛицо
	               |ИЗ
	               |	РегистрСведений.НастройкиПользователей КАК НастройкиПользователей
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	               |		ПО НастройкиПользователей.Пользователь.ФизЛицо = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент и уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ЛОЖЬ
	               |ГДЕ
	               |	НастройкиПользователей.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиПользователей.КонтрольЗаявок)
	               |	И ЕСТЬNULL(НастройкиПользователей.Значение, ЛОЖЬ) = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ГрафикДежурства.Сотрудник
	               |ИЗ
	               |	РегистрСведений.ГрафикДежурства КАК ГрафикДежурства
	               |ГДЕ
	               |	ГрафикДежурства.ПравоКонтроля
	               |	И ГрафикДежурства.ДатаДежурства = &ТекДата";
				   
Запрос.УстановитьПараметр("ТекДата",НачалоДня(ТекущаяДата()));				   
    МассивКонтролеров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ФизЛицо");//Пользователь");
	
	Если  КакМассив = Ложь Тогда
		
		Список = Новый СписокЗначений;				   
		Список.ЗагрузитьЗначения(МассивКонтролеров);
		
		Возврат Список;		
	Иначе
		Возврат МассивКонтролеров;
	КонецЕсли;	
	
	
КонецФункции


Функция ЕстьСобытиеВхода(Дата) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	журналСобытий.Ссылка
	|ИЗ
	|	Справочник.журналСобытий КАК журналСобытий
	|ГДЕ
	|	журналСобытий.Событие = &Событие
	|	И НачалоПериода(журналСобытий.Дата,ДЕНЬ) = &Дата  
	|	И журналСобытий.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь",ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Событие",Справочники.ВидСобытия.Вход);
	Запрос.УстановитьПараметр("Дата",Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина
	Иначе
		Возврат Ложь;
	КонецЕсли;  
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции	


Функция СписокГородов() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АК.Наименование КАК Наименование,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА АК.ТипАдресногоЭлемента = 3
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоГород
	|ИЗ
	|	РегистрСведений.АдресныйКлассификатор КАК АК
	|ГДЕ
	|	АК.КодРегионаВКоде В (50, 77)
	|	И АК.ТипАдресногоЭлемента В (3, 4)
	|	И АК.Наименование <> ""Москва""
	|
	|СГРУППИРОВАТЬ ПО
	|	АК.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	СписокВыбора 	= Новый Массив;
	СписокВыбора.Добавить("Москва");
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГород Тогда
			СписокВыбора.Добавить(Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокВыбора;

КонецФункции	


