	КонецЕсли;	
	//Пока Выборка.Следующий() Цикл
	//	СписокСотрудниковАктуальныхВЭтомМесяце.Добавить(Выборка.Агент, Выборка.НаименованиеАгента);
	//КонецЦикла;
	
