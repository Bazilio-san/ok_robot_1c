	                                    |	ВН.Агент.Наименование";
	ЗапросАктуальныхСотрудников.УстановитьПараметр("ФактическаяОрганизация", 	ФактическаяОрганизация);			   
	                          
	ЗапросАктуальныхСотрудников.УстановитьПараметр("ДатаИзПериода", 	Месяц);
	
