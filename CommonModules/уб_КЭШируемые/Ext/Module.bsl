//ВИДЫ БСО
&НаСервере
Функция ВидБСОТипаКвА7ДляСК(СК, Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВБ.Ссылка КАК ВидБСО,
	|	ВБ.ТипУчетаБСО КАК ТипУчетаБСО
	|ИЗ
	|	Справочник.уб_ВидыБСО КАК ВБ
	|ГДЕ
	|	ВБ.Владелец = &Владелец
	|	И ВБ.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.КвитанцияА7)
	|	И (ВБ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ВБ.ДатаОкончанияДействия >= &Дата)
	|	И (ВБ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ВБ.ДатаНачалаДействия <= &Дата)";	
	Запрос.УстановитьПараметр("Владелец", 	СК);
	Запрос.УстановитьПараметр("Дата",		Дата);
	Результат = Новый Структура("ВидБСО, ТипУчетаБСО");	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат.ВидБСО 		= Справочники.уб_ВидыБСО.ПустаяСсылка();
		Результат.ТипУчетаБСО 	= Перечисления.уб_ТипыУчетаБСО.ПустаяСсылка();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;	
	
КонецФункции

