	//ОбъектXML.ЗаписатьАтрибут("hash", "b22be856-b27a-4ee2-beae-2491403c2a85");//УИД ЖЕЛЕЗА ВРЕМЕННЫЙ!!!
	ОбъектXML.ЗаписатьАтрибут("type","stat");
