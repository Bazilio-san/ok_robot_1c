Функция ПолучитьОбертку() Экспорт
 
    ХТМЛ = Новый COMОбъект("htmlfile");
 
    ХТМЛ.Open("text/html");
 
    //<-- Подготовим нужные методы
 
    ХТМЛ.Write("<script>
 
    |var ХТМЛ;
 
    |Опция=function(x,y,z){var ret=x.Option(y);if(z) x.Option(y)=z; return ret};
 
    |Записать=function(x,y){x.Write(y.responseBody())};
 
    |</script>");
 
    Док=ХТМЛ.documentElement.document;
 
    // Внедрение объекта Скрипта в самого себя, для сохранности контекста
 
    Док.script.ХТМЛ=ХТМЛ;
 
    // Все подготовке -->
 
    Возврат Док.script;
 
КонецФункции    // ПолучитьОбертку(Это)

Функция ВернутьСтатусSMSСообщения (id, ИмяСервиса = "iqsms.ru") Экспорт
	
	Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
	Параметры.Вставить("ИмяСервиса",ИмяСервиса);	
	ДополнитьПараметрыУчетнойЗаписью(Параметры);
	Если ИмяСервиса = "iqsms.ru" Тогда
		Если Параметры.Активна Тогда
			Запрос = "http://gate.iqsms.ru/status/?id="+id; //Состояние отправленного сообщения
			Ответ = ВыполнитьHttpЗапрос(Запрос, Параметры.login, Параметры.Password,, "СМС-статус","?id="+id);
			Ответ = Сред(Ответ,Найти(Ответ,"=")+1);
			Если Ответ = "queued" Тогда
				Ответ = "Сообщение находится в очереди";
			ИначеЕсли Ответ = "delivered" Тогда
				Ответ = "Сообщение доставлено";
			ИначеЕсли Ответ = "delivery error" Тогда
				Ответ = "Ошибка доставки SMS (абонент в течение времени доставки находился вне зоны действия сети или номер абонента заблокирован)";
			ИначеЕсли Ответ = "smsc submit" Тогда
				Ответ = "Сообщение доставлено в SMSC";
			ИначеЕсли Ответ = "smsc reject" Тогда	
				Ответ = "Сообщение отвергнуто SMSC (номер заблокирован или не существует)";
			ИначеЕсли Ответ = "incorrect id" Тогда		
				Ответ = "Неверный идентификатор сообщения";
			КонецЕсли;			
			Возврат Ответ;
		Иначе//Не активная учетка
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Пропущен запрос для неактивной учетной записи: "+Запрос;
			//Сообщение.Сообщить();
		КонецЕсли;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не известен сервис для которого необходимо проверить состояние: "+Имясервиса;
		Сообщение.Сообщить();
	КонецЕсли;

КонецФункции	

Функция ПараметрыСообщенияEMailПоУмолчанию(Знач УчетнаяЗапись = Неопределено, ПолучениеПочты = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	Справочник.уб_УчетныеЗаписи КАК УЗ
	|ГДЕ
	|	УЗ.Ссылка = &УчетнаяЗапись";
	Если УчетнаяЗапись = Неопределено Тогда
		УчетнаяЗапись = ПараметрыСеанса.уб_Константы.SystemEMail;
	КонецЕсли;
	Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.уб_УчетныеЗаписи") Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Некорректный тип параметры УчетныеЗаписи функции ПараметрыСообщенияEMailПоУмолчанию(), тип: " + ТипЗнч(УчетнаяЗапись), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
		УчетнаяЗапись = Справочники.уб_УчетныеЗаписи.ПустаяСсылка();
	КонецЕсли;
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
	КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить("УчетнаяЗапись",					УчетнаяЗапись);
	СтруктураВыборки = Новый Структура;
	Для каждого КолонкаРезультата из РезультатЗапроса.Колонки Цикл
		СтруктураВыборки.Вставить(КолонкаРезультата.Имя,Выборка[КолонкаРезультата.Имя]);		
	КонецЦикла;	
	
	Параметры.Вставить("ВыборкаУчетнойЗаписи",			СтруктураВыборки);
	Параметры.Вставить("ПисатьВЖурналТемуПриОшибке",	Ложь);
	Параметры.Вставить("ТипСообщенияПриИсключении",		"Сообщить");
	// любого типа для добавления в сообщение ошибки для конкретизации чего-либо
	Параметры.Вставить("ДопИнформацияПриВыводеОшибки");
	Если ПолучениеПочты Тогда
		Параметры.Вставить("ПараметрыОтбораIMAP", Новый Структура);
	Иначе
		Если Выборка = Неопределено Тогда
			Отправитель 	= "";
			КопияСебе		= Ложь;
			Представление	= "";
		Иначе
			Отправитель 	= Выборка.EMail;
			КопияСебе		= Выборка.КопияСебе;
			Представление   = Выборка.Представление2;
		КонецЕсли;
		Параметры.Вставить("Отправитель",						Отправитель);
		Параметры.Вставить("ОбратныйАдрес",						Отправитель);
		Параметры.Вставить("КопияСебе",							КопияСебе);
		Параметры.Вставить("Получатели", 						"");
		Параметры.Вставить("Тема",								"");
		Параметры.Вставить("Сообщение",							"");
		Параметры.Вставить("Вложения",							"");
		Параметры.Вставить("ИмяОтправителя",					Представление);
		Параметры.Вставить("Организация",						"");
		Параметры.Вставить("Сокращенное",						Ложь);
		Параметры.Вставить("ТекстHTML",							"");
		Параметры.Вставить("ПроверятьНаличиеФайловВложений", 	Истина);
		// 8 Мб (8 * 1024 * 1024) 
		//	проверяется только при условии ПроверятьНаличиеФайловВложений = Истина
		//	Если = 0 тогда не проверяется размер файлов вложений
		Параметры.Вставить("МаксимальныйРазмерФайловВложений",	8388608); // 8 Мб (8 * 1024 * 1024)
	КонецЕсли;
	Возврат Параметры;
	
КонецФункции // ПараметрыСообщенияEMailПоУмолчанию()

Функция ПодключитьСоединение (Соединение, СтрокаПодключения,Версия = "",ТекстОшибки = "Ошибка подключения!") Экспорт
	//
	Если Соединение = Неопределено Или Соединение = "" Или Соединение=0 Тогда
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
	Если Версия = "" Тогда
		Версия = ПолучитьВерсиюПоИдентификатору(СтрокаПодключения);
	КонецЕсли;
	
	Попытка
		V8 = Новый COMОбъект(Версия + ".COMConnector");	
		ФактСтрокаПодключения = ПолучитьСтрокуПодключения(СтрокаПодключения);
		Если Найти(ФактСтрокаПодключения, "=")>0 Тогда
			#Если Клиент Тогда
				Соединение = Расширение().мСоединения.Получить(СтрокаПодключения);
				Если Соединение = Неопределено Тогда
					Соединение = V8.Connect(ФактСтрокаПодключения);
					Расширение().мСоединения.Вставить(СтрокаПодключения,Соединение);
				КонецЕсли;
			#Иначе
				Соединение = V8.Connect(ФактСтрокаПодключения);
			#КонецЕсли 
		Иначе
			//Строка подключения не задана или некорректна
			//Сообщение об этом не выводим, это не ошибка подключения
			//TO DO при думать способ информирования о незаполненной строке подключения
			//В заголовке системы показывать наличие активных сторонних подключений?
			Возврат Ложь;	
		КонецЕсли;
		Возврат Истина;
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ТекстОшибки + ОписаниеОшибки(), "Сообщить");
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции


