	ОбъектXML.ЗаписатьАтрибут("uid", УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "MarkerUsrID"));
	ОбъектXML.ЗаписатьАтрибут("sessid", "");
	ОбъектXML.ЗаписатьАтрибут("comp_name", ИмяКомпьютера());
	ОбъектXML.ЗаписатьКонецЭлемента();
	
	ОбъектXML.ЗаписатьБезОбработки("");
	ОбъектXML.Закрыть();
	
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "text/xml;");
	
	Сервер = "www.sluice";
	Порт = 80 ;
	
	HTTP = Новый HTTPСоединение(Сервер, Порт);
	
	ИмяПолученногоФайла = ПолучитьИмяВременногоФайла("tmp");
	Попытка
		HTTP.ОтправитьДляОбработки(ИмяФайлаОтправки, "", ИмяПолученногоФайла, ЗаголовокHTTP);
	Исключение
		УдалитьФайлы(ИмяФайлаОтправки,);
		
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СформироватьТекстОшибки(ОписаниеОшибки()),"Предупреждение");
	КонецПопытки;
	
	Текст = Новый ТекстовыйДокумент; 
	Текст.Прочитать(ИмяПолученногоФайла); 
	
	//Стр = "";
