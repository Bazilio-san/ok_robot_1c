//Возвращает ссылку в текущей базе, соответствующую переданной ссылке в удаленной базе, через запрос регистра соответствий в "Консолидации"

Функция ЛокальнаяСсылка (ВнешняяСсылка,УдаленноеСоединение, ИдентификаторУдаленнойБазы="",Консолидация = Неопределено,КодЭтойБазы = "УБ") Экспорт
	
	//Если ИдентификаторУдаленнойБазы="" Тогда
	//Иначе
	//КонецЕсли;	
	
	Если НЕ ПодключитьСоединение(Консолидация,"Консолидация") Тогда
		Возврат Неопределено;
	Конецесли;	
	
	Запрос = Консолидация.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ
	|Источник.УзелИнформационнойБазы,
	|Источник.ТипИсточника,
	|Источник.ПредставлениеОбъектаПриемника,
	|Источник.УникальныйИдентификаторПриемника,
	|Получатель.УникальныйИдентификаторПриемника КАК УникальныйИдентификаторПриемника,
	|Получатель.ТипПриемника КАК ТипПриемника
	|ИЗ
	|	РегистрСведений.СоответствиеОбъектовИнформационныхБаз КАК Источник
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеОбъектовИнформационныхБаз КАК Получатель
	|		ПО Источник.УникальныйИдентификаторИсточника = Получатель.УникальныйИдентификаторИсточника
	|			И (Получатель.УзелИнформационнойБазы.Код = &КодПолучателя)
	|ГДЕ
	|	Источник.УзелИнформационнойБазы.Код = &КодИсточника
	|	И Источник.УникальныйИдентификаторПриемника = &УникальныйИдентификаторИсточника";
	Запрос.УстановитьПараметр("КодИсточника",ИдентификаторУдаленнойБазы);
	Запрос.УстановитьПараметр("КодПолучателя",КодЭтойБазы);
	Запрос.УстановитьПараметр("УникальныйИдентификаторИсточника",УдаленноеСоединение.String(ВнешняяСсылка.UUID()));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		//	
		
		Ссылка = Справочники[ВыделитьВидИзСтрокиТипа(Выборка.ТипПриемника)].ПолучитьСсылку(Новый УникальныйИдентификатор(Выборка.УникальныйИдентификаторПриемника));
		Если Ссылка.Пустая() Тогда
			Возврат Неопределено;
		Иначе
			Возврат Ссылка;
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецФункции	

