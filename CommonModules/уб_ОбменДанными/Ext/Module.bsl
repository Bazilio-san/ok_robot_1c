		Если не Адрес = Неопределено Тогда
			ПоместитьВоВременноеХранилище(Ответ,Адрес);
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить( "Помещено в хранилище", ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина, УровеньЖурналаРегистрации.Информация,,,ИмяЗапроса+".OK");
		КонецЕсли;
		
		Возврат Ответ;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибочный статус при отправке " + ИмяЗапроса + " " + XMLHttp.Status + "/" + XMLHttp.statusText + "(" + Запрос + ") - "+XMLHttp.ResponseText;
		Сообщение.Сообщить();
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(Сообщение.Текст, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина,,,, ИмяЗапроса+"Error.Status");
		Возврат Ложь;	
	КонецЕсли;

