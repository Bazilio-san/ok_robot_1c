// Параметры.ПараметрыОтбораIMAP
//		не работают
// виснет 1с через IMAP, если есть хоть одно сообщение без темы (как на клиенте, так и на сервере)
Функция ПолучитьПочту(
	УчетнаяЗапись 	= Неопределено,
	Параметры 		= Неопределено
	) Экспорт

	ТекстОшибки = "";
	Результат = Новый Массив;
	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыСообщенияEMailПоУмолчанию(УчетнаяЗапись, Истина);
	КонецЕсли;
	Если Параметры.ВыборкаУчетнойЗаписи = Неопределено Тогда
		ТекстОшибки = "Ошибка при получении данных справочника учетных записей: незаполнены данные учетной записи";
		Перейти ~НаВыход;
	Иначе
		Выборка = Параметры.ВыборкаУчетнойЗаписи
	КонецЕсли;
	Почта 	= Новый ИнтернетПочта;
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.ИспользоватьSSLIMAP = Выборка.ИспользоватьSSLIMAP;
	Если Профиль.ИспользоватьSSLIMAP Тогда
		Профиль.АдресСервераIMAP 	= Выборка.АдресСервераIMAP;
		Профиль.ПарольIMAP			= Выборка.POP3Password;//Выборка.ПарольIMAP;
		Профиль.ПортIMAP			= Выборка.ПортIMAP;
		Профиль.ПользовательIMAP	= Выборка.POP3User;//Выборка.ПользовательIMAP;
	Иначе
		Профиль.АдресСервераPOP3	= Выборка.POP3Server;
		Профиль.Пользователь		= Выборка.POP3User;
		Профиль.Пароль				= Выборка.POP3Password;
		Профиль.ПортPOP3			= Выборка.POP3Port;
	КонецЕсли;
	Попытка
		Почта.Подключиться(Профиль, ?(Профиль.ИспользоватьSSLIMAP, ПротоколИнтернетПочты.IMAP, ПротоколИнтернетПочты.POP3));
	Исключение
		ТекстОшибки = "Ошибка подключения к почте ПолучитьПочту(), описание ошибки: " + ОписаниеОшибки();
		Перейти ~НаВыход;
	КонецПопытки;
	//Если Профиль.ИспользоватьSSLIMAP Тогда
	//	Почта.ТекущийПочтовыйЯщик = "Inbox";
	//КонецЕсли;
	Результат = Почта.ПолучитьЗаголовки(Параметры.ПараметрыОтбораIMAP);
	Почта.Отключиться();
	
	~НаВыход:

	Если ТекстОшибки <> "" Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ТекстОшибки, Параметры.ТипСообщенияПриИсключении, Параметры.ПисатьВЖурналТемуПриОшибке);
	КонецЕсли;
	Возврат Результат;

КонецФункции // ПолучитьПочту()

Функция ПолучитьПочтуOld(
	АдресСервераPOP3, 
	Пользователь, 
	Пароль, 
	КаталогВыгрузки = "", 
	НеВыгружатьВложения = Ложь
	) Экспорт
	
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		КаталогВыгрузки = КаталогВременныхФайлов();
	КонецЕсли;
	// Подключение к почте
	Почта = Новый ИнтернетПочта;
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераPOP3 	= АдресСервераPOP3;
	Профиль.Пользователь 		= Пользователь;
	Профиль.Пароль 				= Пароль;
	Попытка
		Почта.Подключиться(Профиль);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Новый Массив;
	КонецПопытки;
	Заголовки = Почта.ПолучитьЗаголовки();
	Сообщить("В почтовом ящике " + Заголовки.Количество() + " сообщений");
	//  Загрузка сообщений в массив
	МассивСообщений = Почта.Выбрать(Ложь,Заголовки);
	Если НеВыгружатьВложения = ИСТИНА Тогда
	ИНАЧЕ	
		Для Индекс = 0 по МассивСообщений.Количество()-1 Цикл 
			Для каждого Вложения из МассивСообщений[Индекс].Вложения Цикл
				Если Найти(ВРег(Вложения.Имя),"DOC_") > 0 тогда
					Сообщить("В письме № "+(Индекс+1)+" есть файл DOC");
					Попытка
						Вложения.Данные.Записать(КаталогВыгрузки+Вложения.Имя);
					Исключение
						Сообщить("Не удалось записать файл " + Вложения.Имя + " в каталог " + КаталогВыгрузки + " из-за " + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	// отключение
	Почта.Отключиться();
	Возврат МассивСообщений;
	
КонецФункции

Функция URLEncode(Стр1)
             
    СтрокаСимволов = " @№#%?/$&+";    
	Hex = Новый Массив(16);
	Hex[0]="0";
	Hex[1]="1";
	Hex[2]="2";
	Hex[3]="3";
	Hex[4]="4";
	Hex[5]="5";
	Hex[6]="6";
	Hex[7]="7";
	Hex[8]="8";
	Hex[9]="9";
	Hex[10]="A";
	Hex[11]="B";
	Hex[12]="C";
	Hex[13]="D";
	Hex[14]="E";
	Hex[15]="F";
    Рез = ""; 
    Стр= СокрЛП(Стр1);
    Для Сч=1 По СтрДлина(Стр) Цикл

        Символ = Сред(Стр, Сч, 1);
        КС = КодСимвола(Символ);
        // Перевод из UNICODE в ASCII
        Если ((КС > 1039) И (КС < 1104)) Тогда 
            КС = КС - 848; 
        ИначеЕсли КС = 8470 Тогда 
            КС =  185; 
        ИначеЕсли КС = 1105 Тогда 
            КС =  184; 
        ИначеЕсли КС = 1025 Тогда 
            КС =  168; 
        КонецЕсли; 
    
        флЗаменили = 0;    
        Если Найти(СтрокаСимволов, Символ) > 0 Тогда

            Рез = Рез + "%"+ Hex[Цел(КС/16)] + Hex[Цел(КС%16)];
            флЗаменили = 1;
            
        КонецЕсли;

        Если (КС <= 127) и (флЗаменили = 0) Тогда 
            Рез = Рез + Символ; 
        ИначеЕсли флЗаменили = 0 Тогда
            Рез = Рез + "%"+ Hex[Цел(КС/16)] + Hex[Цел(КС%16)];
        КонецЕсли;
        
    КонецЦикла;

    Возврат Рез;
КонецФункции // URLEncode()  

