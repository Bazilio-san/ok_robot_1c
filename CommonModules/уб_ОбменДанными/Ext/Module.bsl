Функция ПолучитьВерсиюПоИдентификатору (Идентификатор) Экспорт
	Версия = "V83";
	Если Идентификатор = "Консолидация" Тогда
		Версия = "V82";
	ИначеЕсли Идентификатор = "БП81" Тогда
		Версия = "V81";
	ИначеЕсли Идентификатор = "БП82" Тогда
		Версия = "V83";
	ИначеЕсли Идентификатор = "БП16" Тогда
		Версия = "V81";
	ИначеЕсли Идентификатор = "БП20" Тогда
		Версия = "V83";	
	ИначеЕсли Идентификатор = "Деньги" Тогда	
		Версия = "V83";	
	КонецЕсли;	
	
	Возврат Версия;
КонецФункции	

Функция ПолучитьСтрокуПодключения (Идентификатор)  Экспорт
	
	СтрокаПодключения = Идентификатор;
	Если Идентификатор = "Консолидация" Тогда
		СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияККонсолидации;
	ИначеЕсли Идентификатор = "БП81" Тогда
		СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияКБухгалтерии81;
	ИначеЕсли Идентификатор = "БП16" Тогда
		СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияКБухгалтерии81;	
	ИначеЕсли Идентификатор = "БП82" Тогда
		СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияКБухгалтерии82;	
	ИначеЕсли Идентификатор = "БП20" Тогда
		СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияКБухгалтерии82;		
	ИначеЕсли Идентификатор = "Деньги" Тогда	
		//СтрокаПодключения = ПараметрыСеанса.уб_Константы.СтрокаПодключенияК1СДеньги;		
		Если ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина Тогда
