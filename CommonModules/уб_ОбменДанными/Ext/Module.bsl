Функция ПолучитьПоРазностиВремениПредставлениеДляПользователя(РазностьВремени) Экспорт
	
	Если РазностьВремени = 0 Тогда
		Возврат "00:00:00";
	КонецЕсли;
	
	ОстатокВремени = РазностьВремени;
	
	КоличествоДней = Цел(ОстатокВремени /(60 * 60 * 24));
	ОстатокВремени = РазностьВремени - КоличествоДней * 60 * 60 * 24;
	
	КоличествоЧасов = Цел(ОстатокВремени /(60 * 60));
	ОстатокВремени = РазностьВремени - КоличествоЧасов * 60 * 60;
	
	КоличествоМинут = Цел(ОстатокВремени /(60));
	ОстатокВремени = РазностьВремени - КоличествоМинут * 60;
	
	КоличествоСекунд = ОстатокВремени;
	
	
	ВремяСтрокой = Прав("00" + Строка(КоличествоЧасов), 2) + ":" + Прав("00" + Строка(КоличествоМинут), 2) + ":" + Прав("00" + Строка(КоличествоСекунд), 2);
	
	Если КоличествоДней <> 0 тогда
		
		ВремяСтрокой = Строка(КоличествоДней) + " дней " + ВремяСтрокой;
		
	КонецЕсли;
	
	Возврат ВремяСтрокой;
	
КонецФункции

Функция ПолучитьИмяДняНедели(Дата = Неопределено,НомерДняНедели = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		НомерДняНедели = ДеньНедели(ТекущаяДата());
	Иначе
		НомерДняНедели = ДеньНедели(Дата);
	КонецЕсли;
	
	Если НомерДняНедели = 1 Тогда
		Возврат "Понедельник";
	ИначеЕсли НомерДняНедели = 2 Тогда
		Возврат "Вторник";
	ИначеЕсли НомерДняНедели = 3 Тогда
		Возврат "Среда";
	ИначеЕсли НомерДняНедели = 4 Тогда
		Возврат "Четверг";
	ИначеЕсли НомерДняНедели = 5 Тогда
		Возврат "Пятница";
	ИначеЕсли НомерДняНедели = 6 Тогда
		Возврат "Суббота";
	Иначе
		Возврат "Воскресенье";	
	КонецЕсли;
	
КонецФункции

// функция возвращает часть строки после последнего встреченного символа в строке
Функция ПолучитьСтрокуОтделеннойСимволом(Знач ИсходнаяСтрока, Знач СимволПоиска)
	
	ПозицияСимвола = СтрДлина(ИсходнаяСтрока);
	Пока ПозицияСимвола >= 1 Цикл
		
		Если Сред(ИсходнаяСтрока, ПозицияСимвола, 1) = СимволПоиска Тогда
			
			Возврат Сред(ИсходнаяСтрока, ПозицияСимвола + 1); 
			
		КонецЕсли;
		
		ПозицияСимвола = ПозицияСимвола - 1;	
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьРасширениеИмениФайла(Знач ИмяФайла) Экспорт
	
	Расширение = ПолучитьСтрокуОтделеннойСимволом(ИмяФайла, ".");
	Возврат Расширение;
	
КонецФункции

Функция ПолучитьИмяПротоколаЗагрузки(ИмяФайлаПротоколаОбмена) Экспорт
	
	РасширениеФайлаПротокола = ПолучитьРасширениеИмениФайла(ИмяФайлаПротоколаОбмена);
	
	Если Не ПустаяСтрока(РасширениеФайлаПротокола) Тогда
		
		ИмяФайлаПротоколаЗагрузки = СтрЗаменить(ИмяФайлаПротоколаОбмена, "." + РасширениеФайлаПротокола, "");
		
	Иначе
		
		ИмяФайлаПротоколаЗагрузки = ИмяФайлаПротоколаОбмена;
		
	КонецЕсли;
	
	ИмяФайлаПротоколаЗагрузки = ИмяФайлаПротоколаЗагрузки + "_Загрузка";
	
	Если Не ПустаяСтрока(РасширениеФайлаПротокола) Тогда
		
		ИмяФайлаПротоколаЗагрузки = ИмяФайлаПротоколаЗагрузки + "." + РасширениеФайлаПротокола;	
		
	КонецЕсли;
	
	Возврат ИмяФайлаПротоколаЗагрузки;
	
КонецФункции

//Используется для передачи элементов конфигурации используя xml
//Парметры:
//	ИмяФайла - полное имя файла для сохранения (C:\exchange.xml)
//	Данные - объект конфигурации для передачи (ЭтотОбъект)
Функция ПередатьДанныеXML(ИмяФайла, Данные) Экспорт
	// Создаем объект записи XML
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписатьXML(ЗаписьXML, Данные);
	
	// Выводим диагностическое сообщение о записанных данных
	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Записаны данные '" + Строка(Данные.Метаданные()) + ": " + Строка(Данные) + "' в файл " + ИмяФайла,"Сообщить");
	// Завершаем запись сообщения
	ЗаписьXML.Закрыть();
КонецФункции //ПередатьДанныеXML

//Используется для передачи элементов конфигурации используя xml
//Парметры:
//	ИмяФайла - полное имя файла для чтения (C:\exchange.xml)
Функция ПолучитьДанныеXML(ИмяФайла) Экспорт
	// Создаем объект чтения XML
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Данные = ПрочитатьXML(ЧтениеXML);
	
	Если НЕ Данные.ЭтоГруппа Тогда
		Если Данные.Родитель.ПолучитьОбъект() = Неопределено Тогда
			Данные.Родитель = "";
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Данные.Записать();
	Исключение
		Если Данные.Ссылка.Пустая() Тогда
			Данные.УстановитьНовыйКод();
		Иначе
			Данные.Код = Данные.Ссылка.Код;
		КонецЕсли;
		Данные.Записать();
	КонецПопытки;
	
	// Выводим диагностическое сообщение о записанных данных
	уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("- " + Строка(Данные.Метаданные()) + ": " + Строка(Данные),"Сообщить");
	// Запись перенесенных данных
	Данные.Записать();
	ЧтениеXML.Закрыть();
	
	Возврат Данные.Ссылка;
	
КонецФункции //ПолучитьДанныеXML

//Используется для отправки почтового сообщения
//Параметры: заполняются с помощью функции ПараметрыСообщенияEMailПоУмолчанию()
//Все настройки хранятся в справочнике уб_Константы
Функция SendMail(Параметры) Экспорт
	
	ТекстОшибки = "";
	Если Параметры.ВыборкаУчетнойЗаписи = Неопределено Тогда
		ТекстОшибки = "Ошибка при получении данных справочника учетных записей: незаполнены данные учетной записи";
		Перейти ~НаВыход;
	Иначе
		Выборка = Параметры.ВыборкаУчетнойЗаписи
	КонецЕсли;
	//Если Выборка.Количество() = 0 Тогда
	//	ТекстОшибки = "Не найдена системная учетная запись электронной почты";
	//	ПисатьВЖурналПриОшибке = Истина;
	//	Перейти ~НаВыход;
	//КонецЕсли;
	Получатели				= Параметры.Получатели;
	ТипЗнчПолучатели		= ТипЗнч(Получатели);
	Если (ТипЗнчПолучатели <> Тип("Строка") И ТипЗнчПолучатели <> Тип("Массив") И ТипЗнчПолучатели <> Тип("СписокЗначений"))
		Или (ТипЗнчПолучатели = Тип("Строка") И ПустаяСтрока(Получатели))
		Или (ТипЗнчПолучатели <> Тип("Строка") И Получатели.Количество() = 0) Тогда
		ТекстОшибки = "Не заполнены получатели сообщения!";
		Перейти ~НаВыход;
	КонецЕсли;
	// вложения
	МассивВложений = Новый Массив;
	Если ТипЗнч(Параметры.Вложения) = Тип("Массив") Тогда
		МассивВложений = Параметры.Вложения;
	ИначеЕсли ТипЗнч(Параметры.Вложения) = Тип("Строка") Тогда
		Если Не ПустаяСтрока(Параметры.Вложения) Тогда
			МассивВложений.Добавить(Параметры.Вложения);
		КонецЕсли;
	КонецЕсли;
	Вложения = Новый Массив;
	РазмерВложений = 0;
	Если Параметры.ПроверятьНаличиеФайловВложений Тогда
		Для Каждого Вложение Из МассивВложений Цикл
			Файл = Новый Файл(Вложение);
			Если Файл.Существует() Тогда
				Вложения.Добавить(Вложение);
				Если Параметры.МаксимальныйРазмерФайловВложений > 0 Тогда
					РазмерВложений = РазмерВложений + Файл.Размер();
				КонецЕсли;
			КонецЕсли;
			Файл = Неопределено;
		КонецЦикла;
	Иначе
		Вложения = МассивВложений;
	КонецЕсли;
	Если Параметры.МаксимальныйРазмерФайловВложений > 0 И Параметры.МаксимальныйРазмерФайловВложений < РазмерВложений Тогда
		ТекстОшибки = "Превышен предел размера вложенных файлов. Максимальный размер 8 Мб. Размер файлов " + Окр(РазмерВложений / 1048576, 2) + " Мб";
		Перейти ~НаВыход;
	КонецЕсли;
	ПисатьВЖурналПриОшибке 	= Параметры.ПисатьВЖурналТемуПриОшибке;
	Получатели 				= Параметры.Получатели;
	Тема 					= Параметры.Тема;
	ТекстHTML				= Параметры.ТекстHTML;
	Сокращенное				= Параметры.Сокращенное;                                    
	Тело 					= Параметры.Сообщение;
	Если Не Сокращенное Тогда
		ТекстПисьма = Тело + "
		|База: " + СтрокаСоединенияИнформационнойБазы() + "
		|
		|====================================================================================
		|Это письмо сформированно автоматически в конфигурации 1C ""ITC:Управление Брокером"",
		|Отвечать на него не нужно. По всем возникшим вопросам обращаться к администратору."; 						
	Иначе
		ТекстПисьма = Тело;
	КонецЕсли;
	//Выборка.Следующий();
	ВремяОжидания 	= Выборка.Timeout;
	POP3ПередSMTP	= Выборка.POP3BeforeSMTP;
	Если ТипЗнч(ВремяОжидания) <> Тип("Число") Или ВремяОжидания < 0 Тогда
		ВремяОжидания = 30;
	КонецЕсли;
	ПортPOP3 = Выборка.POP3Port;
	Если ТипЗнч(ПортPOP3) <> Тип("Число") Или ПортPOP3 <= 0 Тогда
		ПортPOP3 = 110;
	КонецЕсли;
	ПортSMTP = Выборка.SMTPPort;
	Если ТипЗнч(ПортSMTP) <> Тип("Число") Или ПортSMTP <= 0 Тогда
		ПортSMTP = 25;
	КонецЕсли;
	Если Выборка.ЧерезCDO Тогда
		// отправка через SSL с помощью COM CDO.Message
		Попытка
			CDO = Новый COMОбъект("CDO.Message");
		Исключение
			ТекстОшибки = "Ошибка при создании объекта CDO.Message";
			ПисатьВЖурналПриОшибке = Истина;
			Перейти ~НаВыход;
		КонецПопытки;
		Попытка
			// проверочный корректный код
			//CDO_СерверSMTP			= "smtp.mail.ru";
			//Аутентификация			= 1;
			//CDO_ПользовательSMTP	= "itclabs.1c@mail.ru";
			//CDO_ПарольSMTP			= "Kf,elfKf,elf";
			//CDO_ПортSMTP			= 25;
			//CDO_ПортSMTP			= 465; //add SSL
			//Отправитель = CDO_ПользовательSMTP;
			//Письмо = Новый COMОбъект("CDO.Message");
			//Письмо.from		= CDO_ПользовательSMTP;
			//Письмо.Subject	= "Тема письма";
			//Письмо.TextBody	= "Автоматически сгенереный текст письма " + ТекущаяДата();
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/sendusing").Value 			= 2;
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/smtpserver").Value 		= CDO_СерверSMTP;
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/smtpauthenticate").Value 	= Аутентификация;
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/sendusername").Value 		= CDO_ПользовательSMTP;
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/sendpassword").Value 		= CDO_ПарольSMTP;
			//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/smtpserverport").Value 	= CDO_ПортSMTP;
    		//Письмо.Configuration.Fields.Item("http://schemas.microsoft.com/cdo/configuration/smtpusessl").Value 		= 1;//add SSL
			//Письмо.Configuration.Fields.Update();
			//Письмо.Send();
			//CDO.DSNOptions = 2; // http://msdn.microsoft.com/en-us/library/ms526567(v=exchg.10).aspx
			// -- проверочный корректный код 
			URL = "http://schemas.microsoft.com/cdo/configuration/";
			CDO.Configuration.Fields.Item(URL + "sendusing").Value 		= 2; //?
			CDO.Configuration.Fields.Item(URL + "smtpserver").Value 	= Выборка.SMTPServer;
			CDO.Configuration.Fields.Item(URL + "smtpserverport").Value = ПортSMTP;
			// 0 - Do not authenticate; 1 - basic (clear-text) authentication; 2 - NTLM
			CDO.Configuration.Fields.Item(URL + "smtpauthenticate").Value 		= Выборка.SMTPAuthentication;
			CDO.Configuration.Fields.Item(URL + "smtpconnectiontimeout").Value 	= ВремяОжидания;
			CDO.Configuration.Fields.Item(URL + "sendusername").Value 			= Выборка.SMTPUser;
			CDO.Configuration.Fields.Item(URL + "sendpassword").Value 			= Выборка.SMTPPassword;
			CDO.Configuration.Fields.Item(URL + "smtpusessl").Value 			= Истина; //?
			Попытка
				CDO.Configuration.Fields.Update();
			Исключение
				ТекстОшибки = "Ошибка обновления полей объекта CDO.Message";
				ПисатьВЖурналПриОшибке = Истина;
				CDO = Неопределено;
				Перейти ~НаВыход;
			КонецПопытки;
			Для Каждого Вложение Из Вложения Цикл
				CDO.addAttachment(Вложение);
			КонецЦикла;
			Если ТипЗнч(Получатели) = Тип("Массив") Тогда
				СтрокаПолучателей = "";
				Для Каждого ЭлементМассива Из Получатели Цикл
					СтрокаПолучателей = СтрокаПолучателей + "," + ЭлементМассива;
				КонецЦикла;
				СтрокаПолучателей = Сред(СтрокаПолучателей, 2);
			Иначе
				СтрокаПолучателей = Получатели;
			КонецЕсли;
			CDO.To 		= СтрокаПолучателей;
			CDO.From    = Выборка.EMail;
			CDO.ReplyTo	= Параметры.ОбратныйАдрес;
			CDO.FollowUpTo = Параметры.ОбратныйАдрес;
			CDO.Subject = Тема;
			Если Не ПустаяСтрока(ТекстHTML) Тогда
				Попытка
					CDO.TextBody = ТекстПисьма; 
					CDO.HTMLBody = ТекстHTML;
					CDO.HTMLBodyPart.Charset = "windows-1251";
				Исключение
				КонецПопытки;
			Иначе
				CDO.TextBody = ТекстПисьма; 
			КонецЕсли;
		Исключение
			ТекстОшибки = "Ошибка при заполнении объекта CDO.Message "+ОписаниеОшибки();
			ПисатьВЖурналПриОшибке = Истина;
			CDO = Неопределено;
		КонецПопытки;
		//Для каждого Вложение из МассивВложений Цикл
		//	CDO.addAttachment(Вложение);
		//КонецЦикла;

		Если CDO <> Неопределено Тогда
			Попытка
				CDO.Send();
			Исключение
				ТекстОшибки = "Возникли проблемы при отправке почтового сообщения через SSL с темой: " + Параметры.Тема+"/"+ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		CDO = Неопределено;
	Иначе
		// отправка без SSL
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Если ТипЗнч(Получатели) = Тип("Строка") Тогда
			Получатели = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Получатели)
		КонецЕсли;
		Для Каждого Получатель Из Получатели Цикл
			Письмо.Получатели.Добавить(Получатель)
		КонецЦикла;
		Отправитель 	= Параметры.Отправитель;
		ИмяОтправителя  = Параметры.ИмяОтправителя;
		Организация		= Параметры.Организация;
		ОбратныйАдрес	= Параметры.ОбратныйАдрес;
		КопияСебе		= Параметры.КопияСебе;		
		//Создаем профиль
		Профиль = Новый ИнтернетПочтовыйПрофиль;
		Профиль.POP3ПередSMTP 		= POP3ПередSMTP;
		Профиль.ВремяОжидания 		= ВремяОжидания;
		Профиль.ПортPOP3 			= ПортPOP3;
		Профиль.АдресСервераPOP3	= Выборка.POP3Server;
		Профиль.Пользователь		= Выборка.POP3User;
		Профиль.Пароль				= Выборка.POP3Password;
		Профиль.ПортSMTP			= ПортSMTP;
		Профиль.АдресСервераSMTP	= Выборка.SMTPServer;
		Профиль.ПользовательSMTP	= Выборка.SMTPUser;
		Профиль.ПарольSMTP			= Выборка.SMTPPassword;
		Профиль.ИспользоватьSSLIMAP	= Выборка.ИспользоватьSSLIMAP;
		//Если Профиль.ИспользоватьSSLIMAP Тогда
		Профиль.АдресСервераIMAP 	= Выборка.АдресСервераIMAP;
		Профиль.ПарольIMAP			= Выборка.POP3Password;//Выборка.ПарольIMAP;
		Профиль.ПортIMAP			= Выборка.ПортIMAP;
		Профиль.ПользовательIMAP	= Выборка.POP3User;//Выборка.ПользовательIMAP;
	//Иначе

		чАутентификацияSMTP 		= Выборка.SMTPAuthentication;
		Если чАутентификацияSMTP = 0 Тогда
			АутентификацияSMTP = СпособSMTPАутентификации.CramMD5;
		ИначеЕсли чАутентификацияSMTP = 1 Тогда
			АутентификацияSMTP = СпособSMTPАутентификации.Login;
		ИначеЕсли чАутентификацияSMTP = 2 Тогда
			АутентификацияSMTP = СпособSMTPАутентификации.Plain;
		ИначеЕсли чАутентификацияSMTP = 3 Тогда
			АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
		ИначеЕсли чАутентификацияSMTP = 4 Тогда
			АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
		Иначе
			АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
		КонецЕсли;
		чАутентификацияPOP3 = Выборка.POP3Authentication;
		Если чАутентификацияPOP3 = 0 Тогда
			АутентификацияPOP3 = СпособPOP3Аутентификации.APOP;
		ИначеЕсли чАутентификацияPOP3 = 1 Тогда
			АутентификацияPOP3 = СпособPOP3Аутентификации.CramMD5;
		ИначеЕсли чАутентификацияPOP3 = 2 Тогда
			АутентификацияPOP3 = СпособPOP3Аутентификации.Обычная;
		Иначе
			АутентификацияPOP3 = СпособPOP3Аутентификации.Обычная;
		КонецЕсли;
		Профиль.АутентификацияSMTP	= АутентификацияSMTP;
		Профиль.АутентификацияPOP3	= АутентификацияPOP3;	
		// Если надо, то отправляем копию себе
		Если КопияСебе Тогда
			Письмо.Получатели.Добавить(?(ЗначениеЗаполнено(ОбратныйАдрес), Отправитель, Выборка.EMail));
		КонецЕсли;
		Для Каждого Вложение Из Вложения Цикл					
			Письмо.Вложения.Добавить(Вложение);
		КонецЦикла;
		Письмо.ИмяОтправителя 	= ИмяОтправителя;
		Письмо.Отправитель 		= Отправитель;
		Письмо.ОбратныйАдрес.Добавить(ОбратныйАдрес);
		Если Не ПустаяСтрока(Организация) Тогда
			Письмо.Организация = Организация;
		КонецЕсли;
		Письмо.Кодировка 	= "windows-1251"; 
		Письмо.Тема 		= Тема; 
		//TODO сейчас отправляется либо html, либо текст.
		Если Не ПустаяСтрока(ТекстHTML) Тогда
			Письмо.Тексты.Добавить(ТекстHTML, ТипТекстаПочтовогоСообщения.HTML);
			Письмо.ОбработатьТексты();
		Иначе
			Письмо.Тексты.Добавить(ТекстПисьма);
		КонецЕсли;
		//Отправляем
		Почта = Новый ИнтернетПочта; 
		//ошибочно считает размер - лучше не использовать
		// проверка на размер файлов вложений есть выше
		//Если Письмо.Размер > ПараметрыСеанса.уб_Константы.МаксимальныйРазмерСообщения * 1024 * 1024 Тогда //в Мб Тогда
		//	Сообщение = Новый СообщениеПользователю;
		//	Сообщение.Текст = "Размер сообщения больше максимально установленного (" + ПараметрыСеанса.уб_Константы.МаксимальныйРазмерСообщения + " MB)";
		//	Сообщение.Сообщить();
		//	Возврат 0;
		//КонецЕсли;
		Попытка
			Почта.Подключиться(Профиль);
			Почта.Послать(Письмо);
			Почта.Отключиться();
		Исключение
			ТекстОшибки = "Возникли проблемы при отправке почтового сообщения с темой: " + Параметры.Тема+"/"+ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	~НаВыход:

	Если ТекстОшибки <> "" Тогда
		ТекстОшибки = ТекстОшибки + "
		|Почта не была отправлена!" + ?(ЗначениеЗаполнено(Параметры.ДопИнформацияПриВыводеОшибки), " " + Параметры.ДопИнформацияПриВыводеОшибки, "");
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ТекстОшибки, Параметры.ТипСообщенияПриИсключении, Параметры.ПисатьВЖурналТемуПриОшибке);
		Результат = Ложь;
	Иначе
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция SendSMS (Параметры,Ответы = "") Экспорт
	Получатели = Параметры.Получатели;
	Если ТипЗнч(Получатели) = Тип("Строка") Тогда
		Получатели = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Получатели,";");
	КонецЕсли;
	Если Получатели.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнены получатели сообщения!";
		Сообщение.Сообщить();
		Возврат Ложь;
	Иначе
		МассивПолучателей = Новый Массив;
		
		ТолькоОдномуПолучателю = Ложь;
		Параметры.Свойство("ТолькоОдномуПолучателю",ТолькоОдномуПолучателю);
		
		Для Каждого Получатель Из Получатели Цикл
			_ДлинаСтроки = 0;
			Получатель = уб_СтраховойБрокер.ТолькоЦифрыСтроки(Получатель,_ДлинаСтроки);
			_Лев2  = Лев  (Получатель,2);
			//_Сред3 = Сред (Получатель,3,1);"+7" случаи +7 запрещаем на уровне ввода номера
			Если _Лев2<>"89" и (_Лев2)<>"79" Тогда
				Продолжить;
			КонецЕсли;
			Если _ДлинаСтроки = 11 Тогда
				ПриведенныйНомер = ?(_Лев2="89","7"+Сред(Получатель,2),Получатель);
				МассивПолучателей.Добавить(ПриведенныйНомер);
				Если ТолькоОдномуПолучателю = Истина Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		Если МассивПолучателей.Количество()=0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не обнаружены подходящие номера телефонов!";
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Параметры.ИмяСервиса = Нрег(Параметры.ИмяСервиса);
	
	Если Параметры.ИмяСервиса = "iqsms.ru" Тогда
		ДополнитьПараметрыУчетнойЗаписью(Параметры);
		Если Параметры.Режим ="email" Тогда
			ТекстПисьма = "login: "    + Параметры.login     + Символы.ПС +
			"password: " + Параметры.Password   + Символы.ПС +
			Параметры.Сообщение + Символы.ПС +
			"sender: "   + Параметры.Подпись;
			//Сообщить(ТекстПисьма);
			//			ПараметрыEmail = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
			Получатели = "";
			ВсегоПолучателей = МассивПолучателей.Количество();
			ТекПолучатель = 0;
			Для Каждого Получатель из МассивПолучателей Цикл
				ТекПолучатель = ТекПолучатель+1;
				Получатели = Получатели +Получатель+ "@iqsms.ru"+?(ТекПолучатель=ВсегоПолучателей,"",",");
			КонецЦикла;
			Параметры.Получатели 	= Получатели;
			
			Параметры.Тема			= "Рассылка СМС";
			Параметры.Сообщение		= ТекстПисьма;
			Параметры.Сокращенное = ИСТИНА; //Без подписи откуда отправлено
			Если Параметры.Активна Тогда
				уб_ОбменДанными.SendMail(Параметры);
			КонецЕсли;	
		ИначеЕсли Параметры.Режим ="REST" Тогда	
			//Запрос = "http://gate.iqsms.ru/senders/"; //Подписи
			Запрос = "http://gate.iqsms.ru/credits/"; //Баланс количества СМС
			//Запрос = "http://gate.iqsms.ru/status/?id=A132571BC"; //Состояние отправленного сообщения
			//Запрос = "http://gate.iqsms.ru/statusQueue/?statusQueueName=svs&limit=50"; //Очередь статуса отправленных 
			
			//Запрос ="http://gate.iqsms.ru/send/?phone=%2B79133616124&text=testovoe%20pismо&sender=tretyakov&statusQueueName=svs";
			
			//phone	Обязательно	Номер телефона, в формате +71234567890
			//text	Обязательно	Текст сообщения, в UTF-8 кодировке
			//wapurl		Wap-push ссылка, в случае, если вы хотите передать wap-push сообщение (например wap.yousite.ru)
			//sender		Подпись отправителя (например TEST) 
			//flash		Flash SMS – сообщение, которое сразу отображается на экране и не сохраняется в памяти телефона (1 – активировано)
			//scheduleTime		Дата для отложенной отправки сообщения, в UTC (2009-01-01T12:30:01+00:00) 
			//statusQueueName
			Попытка
				XMLHttp = GetCOMObject("", "Microsoft.XMLHTTP");
			Исключение
				Ошибка = ОписаниеОшибки();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Ошибка создания  Microsoft.XMLHTTP "+Ошибка+"("+Запрос+")";
				Сообщение.Сообщить();
			КонецПопытки;
			
			
			//Инициируем запрос, который вернет управление программе только после получения ответа
			Для Каждого Получатель из МассивПолучателей Цикл
				_Сообщение = Параметры.Сообщение;
				Запрос= "http://gate.iqsms.ru/send/"         +
				"?phone="  + URI("+"+Получатель)   +
				"&text="   + URI(_Сообщение)       +
				//"&sender=" + URI(Параметры.Подпись)+
				"&statusQueueName=svs";
				Если Параметры.Активна Тогда
					Ответ = ВыполнитьHttpЗапрос(Запрос, Параметры.login, Параметры.Password, XMLHttp, "СМС-рассылка","?phone="+Получатель);
					Ответы = Ответы+Ответ+"; "
				Иначе//Не активная учетка
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Пропущен запрос для неактивной учетной записи: "+Запрос;
					//Сообщение.Сообщить();
				КонецЕсли;


			КонецЦикла;
		//ИначеЕсли Параметры.Режим ="json" Тогда//
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Неизвестный режим отправки SMS: "+Параметры.Режим;
			Сообщение.Сообщить();
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(Сообщение.Текст, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"),Истина,,,,"СМС-рассылка.Error.Режим");
			Возврат Ложь;	
		Конецесли;	
		
	ИначеЕсли Параметры.ИмяСервиса = "smsc.ru" Тогда	
		ДополнитьПараметрыУчетнойЗаписью(Параметры);
		Если Параметры.Режим ="HTTP" Тогда	
			//Запрос = "http://gate.iqsms.ru/senders/"; //Подписи
			Запрос = "http://smsc.ru/sys/balance.php?login=<login>&psw=<password>"; //Баланс количества СМС
			Попытка
				XMLHttp = GetCOMObject("", "Microsoft.XMLHTTP");
			Исключение
				Ошибка = ОписаниеОшибки();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Ошибка создания  Microsoft.XMLHTTP "+Ошибка+"("+Запрос+")";
				Сообщение.Сообщить();
			КонецПопытки;
			//Инициируем запрос, который вернет управление программе только после получения ответа
			Для Каждого Получатель из МассивПолучателей Цикл
				_Сообщение = Параметры.Сообщение;
				//http://smsc.ru/sys/send.php?login=<login>&psw=<password>&phones=<phones>&mes=<message>
				Запрос= "http://smsc.ru/sys/send.php"         +
				"?login="  + Параметры.login   +
				"&psw="    + Параметры.Password   +
				"&phones="  + URI("+"+Получатель)   +
				"&mes="   + URLEncode(_Сообщение)       +
				"&sender=" + URI(Параметры.Подпись)+
				"&cost=3"+//В ответе цену
				"&fmt=0"+//Формат ответа сервера об успешной отправке.
				//0 – (по умолчанию) в виде строки (OK - 1 SMS, ID - 1234).
				//1 – вернуть ответ в виде чисел: ID и количество SMS через запятую (1234,1), при cost = 2 еще стоимость через запятую (1234,1,1.40), при cost = 3 еще новый баланс Клиента (1234,1,1.40,100.50), при cost = 1 стоимость и количество SMS через запятую (1.40,1).
				//2 – ответ в xml формате.
				//3 – ответ в json формате.
				"";
				//"&statusQueueName=svs";
				Если Параметры.Активна Тогда
					Ответ = ВыполнитьHttpЗапрос(Запрос, Параметры.login, Параметры.Password, XMLHttp, "СМС-рассылка","?phones="+Получатель);
					Ответы = Ответы+Ответ+"; "
				Иначе//Не активная учетка
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Пропущен запрос для неактивной учетной записи: "+Запрос;
					//Сообщение.Сообщить();
				КонецЕсли;
			КонецЦикла;
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Неизвестный режим отправки SMS: "+Параметры.Режим;
			Сообщение.Сообщить();
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(Сообщение.Текст, ?(ПараметрыСеанса.уб_РежимОтладки > 4, "Сообщить", "НеСообщать"), Истина,,,,"СМС-рассылка.Error.Режим");
			Возврат Ложь;	
		Конецесли;	
	ИначеЕсли Параметры.ИмяСервиса = "www.sluice" Тогда	
			ДополнитьПараметрыУчетнойЗаписью(Параметры);	
			Запрос = "";
			MD5 = Обработки.уб_MD5.Создать();
			
			//http://sluice.loc/
			//"?type=sms_gate&task=send&phones=79235687059&message=%D0%A2%D0%B5%D1%81%D1%82+%D0%A1%D0%9CC&sender=for-ins.ru&signature=909ffaf2026ae9d19820797495f785c4"
			type      = "sms_gate";
			task      = "send";
			Для Каждого Получатель из МассивПолучателей Цикл
				_Сообщение = Параметры.Сообщение;
				
				phones    = Получатель;
				message   = _Сообщение;//URI(_Сообщение);
				sender    = URI(Параметры.Подпись);
				//sender    = "for-ins.ru";
				secretkey = "F89HpuEv0R";//"qweasdzxc";
				signature = НРЕГ(MD5.РасчетХЭШ(
				НРЕГ(MD5.РасчетХЭШ(secretkey))
				+НРЕГ(MD5.РасчетХЭШ(sender))
				+НРЕГ(MD5.РасчетХЭШ(type))
				+НРЕГ(MD5.РасчетХЭШ(task))
				+НРЕГ(MD5.РасчетХЭШ(""))
				+НРЕГ(MD5.РасчетХЭШ(phones))
				));
				Message = уб_обменДанными.URI(Message);
				Запрос=
				"http://www.sluice/?type=" + type     +
				"&task="            + task     +
				"&phones="          + phones   +
				"&message="         + message  +
				"&sender="          + sender   +
				"&signature="       + signature;
				
				Если Параметры.Активна Тогда
					Ответ = ВыполнитьHttpЗапрос(Запрос, Параметры.login, Параметры.Password, XMLHttp, "СМС-рассылка","?phones="+Получатель);
					Ответы = Ответы+Ответ+"; "
				Иначе//Не активная учетка
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Пропущен запрос для неактивной учетной записи: "+Запрос;
					//Сообщение.Сообщить();
				КонецЕсли;
			КонецЦикла;	
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Неизвестный SMS сервис:"+Параметры.ИмяСервиса;
		Сообщение.Сообщить();
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(Сообщение.Текст,"",Истина,,,,"СМС-рассылка.Error.Провайдер");
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

Процедура ДополнитьПараметрыУчетнойЗаписью(Параметры, НаименованиеУчетнойЗаписи = Неопределено)
	
	Запрос = Новый Запрос (
	"ВЫБРАТЬ
	|	УЗ.Ссылка,
	|	УЗ.ПометкаУдаления,
	|	НЕ УЗ.НеАктивна КАК Активна,
	|	УЗ.Предопределенный,
	|	УЗ.Код,
	|	УЗ.Наименование,
	|	УЗ.POP3Authentication,
	|	УЗ.POP3User,
	|	УЗ.POP3Password,
	|	УЗ.POP3BeforeSMTP,
	|	УЗ.POP3Port,
	|	УЗ.POP3Server,
	|	УЗ.SMTPAuthentication,
	|	УЗ.SMTPUser,
	|	УЗ.SMTPPassword,
	|	УЗ.SMTPPort,
	|	УЗ.SMTPServer,
	|	УЗ.Timeout,
	|	УЗ.КопияСебе,
	|	УЗ.МаксимальныйРазмерСообщения,
	|	УЗ.EMail,
	|	УЗ.Представление
	|ИЗ
	|	Справочник.уб_УчетныеЗаписи КАК УЗ
	|ГДЕ
	|	УЗ.Наименование = &Наименование");	
	Запрос.УстановитьПараметр("Наименование",?(НаименованиеУчетнойЗаписи = Неопределено, Параметры.ИмяСервиса, НаименованиеУчетнойЗаписи));
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Параметры.Вставить("Login",  	Выборка.POP3User);
		Параметры.Вставить("Password", 	Выборка.POP3Password);
		Параметры.Вставить("Подпись", 	Выборка.EMail);
		Параметры.Вставить("Активна", 	Выборка.Активна);
	Иначе	
		Параметры.Вставить("Активна", 	Ложь);
		Параметры.Вставить("Login",  	"");
		Параметры.Вставить("Password", 	"");
		Параметры.Вставить("Подпись", 	"");
	КонецЕсли;
	
КонецПроцедуры	

