Процедура ОбработатьПолучитьДанныеЗаявкиИзБазы(НомерЗаявки,Владелец = Неопределено,Элемент=Неопределено) Экспорт
	
	
	_НомерЗаявкиПодходит = Типзнч(НомерЗаявки) = Тип("Число");
	Если _НомерЗаявкиПодходит = ЛОЖЬ Тогда
		Сообщение = "Номер заявки не число!"; 
		Состояние_(Сообщение,2000);
		Если (ТипЗнч(Элемент) = Тип("Кнопка")) Тогда
			Элемент.Подсказка = Сообщение;
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	Если Элемент = Неопределено Тогда
		Источник = Неопределено;
	Иначе
		 Попытка
		 	Источник = Элемент.Имя;
		 Исключение
			Источник = Неопределено;
		 КонецПопытки;
	КонецЕсли;	
		
		
	ДоступенШлюзCRM = ПараметрыСеанса.уб_ВнешниеСервисы.ДоступенШлюзCRM;
	Если Не ДоступенШлюзCRM Тогда
		Сообщение = "Шлюз CRM не доступен!";
		Состояние_(Сообщение,2000);
		Если (ТипЗнч(Элемент) = Тип("Кнопка")) Тогда
			Элемент.Подсказка = Сообщение;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Состояние_("Получение данных из базы.");
	ТекстHtml = ПолучитьДанныеЗаявкиИзБазы(НомерЗаявки,Источник);
	Если НЕ ТекстHtml = "" Тогда
		Если Владелец = Неопределено Тогда
			Браузер = ПолучитьОбщуюФорму("уб_Браузер", ,);	
		Иначе
			Браузер = ПолучитьОбщуюФорму("уб_Браузер", Владелец ,);	
		КонецЕсли;	
		Если Браузер.Открыта() Тогда
			Браузер.Активизировать();
		Иначе	
			Браузер.Открыть();
		КонецЕсли;
		Браузер.Заголовок = "Данные заявки №" + НомерЗаявки + " из базы ";
		Браузер.ЭлементыФормы.ПолеHTMLДокумента.УстановитьТекст(ТекстHtml);
	Конецесли;
	Сообщение = "Показать данные из базы по заявке";
    Если (ТипЗнч(Элемент) = Тип("Кнопка")) Тогда
		Элемент.Подсказка = Сообщение;
	КонецЕсли;

КонецПроцедуры	

