		ДокументДолженБытьПеренесен = СсылкаЗдесь.Проведен И СсылкаЗдесь.Подтверждено И СсылкаЗдесь.Дата > Дата(2012,4,1) и СсылкаЗдесь.НеОтражатьРасчетыВ1СДеньги = Ложь;
		Запрос = Новый Запрос;
		СистемаТЧПлатежи = ПараметрыСеанса.уб_Константы.СистемаТЧПлатежейВПриемкеОплат = Истина;
		Если СистемаТЧПлатежи Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	П.Ссылка.Категория КАК Категория,
			|	ЕСТЬNULL(СУММА(П.Сумма), 0) КАК Сумма,
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА П.ОбоснованиеРазницы = ""Оплата выезда клиентом""
			|					ТОГДА П.Сумма
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК СуммаВознагражденияКурьераКлиентом,
			|	ЕСТЬNULL(СУММА(П.Сумма) - СУММА(ВЫБОР
			|				КОГДА П.ОбоснованиеРазницы = ""Оплата выезда клиентом""
			|					ТОГДА П.Сумма
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК СуммаПоСтраховкам
			|ИЗ
			|	Документ.уб_ОтчетКассира КАК ОК
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК П
			|		ПО (П.Ссылка.ОтчетКассира = ОК.Ссылка)
			|			И (П.Ссылка.Проведен)
			|			И (П.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
			|				ИЛИ (П.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
			|					И П.Ссылка.Дата > ДАТАВРЕМЯ(2023, 7, 1)))
			|ГДЕ
			|	ОК.Ссылка = &ОтчетКассира
			|
			|СГРУППИРОВАТЬ ПО
			|	П.Ссылка.Категория";
		Иначе
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.уб_КатегорииДенежныхСредств.ПустаяСсылка) КАК Категория,
			|	СУММА(ЕСТЬNULL(уб_ПриемкаОплат.Сумма, 0)) КАК Сумма,
			|	СУММА(ЕСТЬNULL(уб_ПриемкаОплат.СуммаВВалюте, 0)) КАК СуммаВВалюте,
			|	СУММА(ЕСТЬNULL(уб_ПриемкаОплат.ВознаграждениеКурьераКлиентом, 0)) КАК СуммаВознагражденияКурьераКлиентом,
			|	СУММА(ЕСТЬNULL(уб_ПриемкаОплат.Сумма, 0)) - СУММА(ЕСТЬNULL(уб_ПриемкаОплат.ВознаграждениеКурьераКлиентом, 0)) КАК СуммаПоСтраховкам
			|ИЗ
			|	Документ.уб_ОтчетКассира КАК уб_ОтчетКассира
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат КАК уб_ПриемкаОплат
			|		ПО (уб_ПриемкаОплат.ОтчетКассира = уб_ОтчетКассира.Ссылка)
			|			И (уб_ПриемкаОплат.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
			|				ИЛИ (уб_ПриемкаОплат.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
			|					И уб_ПриемкаОплат.Дата > ДАТАВРЕМЯ(2023, 7, 1)))
			|ГДЕ
			|	уб_ОтчетКассира.Ссылка = &ОтчетКассира";
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ОтчетКассира", СсылкаЗдесь);
		ОтчетыКассиру = Запрос.Выполнить().Выгрузить();
		Если ОтчетыКассиру.НайтиСтроки(Новый Структура("Категория",Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка())).Количество()= 0 Тогда
			итОтчетаКассиру = ОтчетыКассиру.Вставить(0);
			итОтчетаКассиру.Категория = Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка();
			итОтчетаКассиру.Сумма = 0;
			итОтчетаКассиру.СуммаВознагражденияКурьераКлиентом= 0;
			итОтчетаКассиру.СуммаПоСтраховкам= 0;
		КонецЕсли;	
		
		_СуммаВыплаты = 0;
		Для каждого итОтчетаКассиру из ОтчетыКассиру Цикл
			СуммаВыплаты = итОтчетаКассиру.Сумма;
			СуммаВознагражденияКурьераКлиентом = итОтчетаКассиру.СуммаВознагражденияКурьераКлиентом;
			СуммаПоСтраховкам = итОтчетаКассиру.СуммаПоСтраховкам;
			
			ОбъектТам = ПолучитьОбъектВ1СДеньгиПоУИН(Соединение, СсылкаЗдесь, ?(СуммаВыплаты >= 0, "Приход", "Расход"), ДокументДолженБытьПеренесен,итОтчетаКассиру.Категория);	
			Если ОбъектТам = Неопределено 
				ИЛИ (СуммаВыплаты = 0 и СуммаВознагражденияКурьераКлиентом=0 и СуммаПоСтраховкам = 0) //В этом документе нет наличных приемок
				Тогда
				Возврат;
			КонецЕсли;	
			Если ДокументДолженБытьПеренесен Тогда 
				ОбъектТам.ПометкаУдаления 	= Ложь;
				ОбъектТам.Загружен 			= Истина;
				Проект = "";
				Если СсылкаЗдесь.Дата >Дата(2018,8,8) 
					и ЗначениеЗаполнено(СсылкаЗдесь.Подразделение) 
					и СсылкаЗдесь.Подразделение.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя Тогда
					Если итОтчетаКассиру.Категория = Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка() или ПустаяСтрока(итОтчетаКассиру.Категория.НаименованиеКошелька) Тогда
						ОбъектТам.Кошелек = Соединение.Справочники.КошелькиИСчета.НайтиПоНаименованию(Соединение.string(СсылкаЗдесь.Подразделение.КодПоОКАТО), Истина);
						Если ОбъектТам.Кошелек.Пустая() Тогда
							Сообщить("Проверьте название кошелька "+СсылкаЗдесь.Подразделение.КодПоОКАТО+ " в поле 'Код по ОКАТО' подразделения, пропущена загрузка");
							Возврат;
						КонецЕсли;
						Проект = СсылкаЗдесь.Подразделение.Проект;

					Иначе
						ОбъектТам.Кошелек = Соединение.Справочники.КошелькиИСчета.НайтиПоНаименованию(Соединение.string(итОтчетаКассиру.Категория.НаименованиеКошелька), Истина);
						Если ОбъектТам.Кошелек.Пустая() Тогда
							Сообщить("Проверьте название кошелька "+итОтчетаКассиру.Категория.НаименованиеКошелька+ " в категории денежных средств "+итОтчетаКассиру.Категория);
							Возврат;
						КонецЕсли;	
					КонецЕсли;	
						
					
				Иначе	
					ОбъектТам.Кошелек			= Соединение.Справочники.КошелькиИСчета.НайтиПоНаименованию("СЕЙФ", Истина);
				КонецЕсли;	
				ОбъектТам.ОднострочныйРежим = Ложь;
				ОбъектТам.Дата              = СсылкаЗдесь.Дата;
				ОбъектТам.Комментарий	    = "";
				ОбъектТам.ОписаниеОперации  = "";
				ЭтоПриход = СуммаВыплаты > 0;
				Если ЭтоПриход Тогда 
					ОбъектТам.ВалютаПриход				= Соединение.Справочники.Валюты.НайтиПоНаименованию("руб.");
					ОбъектТам.НаправлениеДвиженияДенег	= Соединение.Перечисления.НаправленияДвиженияДенег.Доход;
					ОбъектТам.ВидОперации				= Соединение.Справочники.ВидыОпераций.Доход;
				Иначе
					СуммаВыплаты 						= - СуммаВыплаты;
					СуммаПоСтраховкам 					= - СуммаПоСтраховкам;
					СуммаВознагражденияКурьераКлиентом  = - СуммаВознагражденияКурьераКлиентом;
					ОбъектТам.СуммаВВалютеКошелька      = СуммаВыплаты;
					ОбъектТам.ВидОперации				= Соединение.Справочники.ВидыОпераций.Расход;
					ОбъектТам.ВалютаРасход				= Соединение.Справочники.Валюты.НайтиПоНаименованию("руб.");
					ОбъектТам.НаправлениеДвиженияДенег	= Соединение.Перечисления.НаправленияДвиженияДенег.Расход;
					ОбъектТам.СуммаРасход               = СуммаВыплаты;
					ОбъектТам.ВалютаДвижения            = ОбъектТам.ВалютаРасход;
					ОбъектТам.СуммаВВалютеДвижения      = СуммаВыплаты;
					ОбъектТам.КурсКошелекДвижения       = 1;
					ОбъектТам.КратностьДвиженияКошелек  = 1;
					ОбъектТам.СуммаБезСкидкиВВалютеДвижения  = СуммаВыплаты;
					ОбъектТам.ЦеныВДругойВалюте         = Ложь;
				КонецЕсли;
				ДвиженияДенег = ОбъектТам.ДвиженияДенег;
				//заполняем уины строк
				МассивУИН = Новый Массив;
				МассивУИН.Добавить(Неопределено);
				МассивУИН.Добавить(Неопределено);
				Для Каждого СтрокаТЧ Из ДвиженияДенег Цикл
					МассивУИН.Добавить(СтрокаТЧ.УИН)
				КонецЦикла;
				Для Индекс = 1 По 2 - МассивУИН.Количество() Цикл
					МассивУИН.Добавить(Неопределено)
				КонецЦикла;
				ДвиженияДенег.Очистить();
				ОбъектТам.СвойстваДокумента.Очистить();
				ОбъектТам.СвойстваДокументаПострочно.Очистить();
				//Движение
				//по продажам страховок или возврату премии
				НоваяСтрокаДвижение = ДвиженияДенег.Добавить();
				Если ЭтоПриход Тогда 
					НоваяСтрокаДвижение.Статья		= Соединение.Справочники.СтатьиДоходов.НайтиПоНаименованию("Продажа страховок");
				Иначе
					НоваяСтрокаДвижение.Статья	   	= Соединение.Справочники.СтатьиРасходов.НайтиПоНаименованию("Возврат премии");
					НоваяСтрокаДвижение.Цена       	= СуммаПоСтраховкам;
					НоваяСтрокаДвижение.Количество 	= 1;
					НоваяСтрокаДвижение.КОплате    	= СуммаПоСтраховкам;
				КонецЕсли;	
				НоваяСтрокаДвижение.УИН         = ?(МассивУИН[0] = Неопределено, СокрЛП(Новый УникальныйИдентификатор), МассивУИН[0]);
				НоваяСтрокаДвижение.Сумма	    = СуммаПоСтраховкам;
				НоваяСтрокаДвижение.Комментарий = "Отчет кассиру № " + СсылкаЗдесь.Номер + " " + СокрЛП(СсылкаЗдесь.Период);
				
				Если НЕ ПустаяСтрока(Проект) Тогда
					ПроектТам = Соединение.Справочники.СвойстваДокументов.НайтиПоНаименованию(Проект,,,Соединение.ПланыВидовХарактеристик.СвойстваДокументов.Проект);
					Если Не ПроектТам.Пустая() Тогда
						НоваяСтрокаДвижение.Проект = ПроектТам;
					КонецЕсли;	
				КонецЕсли;	
				
				Если СуммаВознагражденияКурьераКлиентом <> 0 Тогда
					НоваяСтрокаДвижение = ДвиженияДенег.Добавить();
					Если ЭтоПриход Тогда
						НоваяСтрокаДвижение.Статья = Соединение.Справочники.СтатьиДоходов.НайтиПоНаименованию("Оплата выезда клиентом")
					Иначе
						НоваяСтрокаДвижение.Статья 		= Соединение.Справочники.СтатьиРасходов.НайтиПоНаименованию("Неопределенные расходы");
						НоваяСтрокаДвижение.Цена		= СуммаВознагражденияКурьераКлиентом;
						НоваяСтрокаДвижение.Количество  = 1;
						НоваяСтрокаДвижение.КОплате		= СуммаВознагражденияКурьераКлиентом;
					КонецЕсли;
					НоваяСтрокаДвижение.УИН			= ?(МассивУИН[1] = Неопределено, СокрЛП(Новый УникальныйИдентификатор), МассивУИН[1]);
					НоваяСтрокаДвижение.Сумма		= СуммаВознагражденияКурьераКлиентом;
					НоваяСтрокаДвижение.Комментарий = "Отчет кассиру № " + СсылкаЗдесь.Номер + " " + СокрЛП(СсылкаЗдесь.Период);
				КонецЕсли;
				//Аналитика
				//СтрокаСвойства                    = ОбъектТам.СвойстваДокументаПострочно.Добавить();
				//СтрокаСвойства.УИН                = НоваяСтрокаДвижение.УИН;
				//СтрокаСвойства.СвойствоДокумента  = Соединение.ПланыВидовХарактеристик.СвойстваДокументов.НайтиПоНаименованию("");	
				//СтрокаСвойства.Значение           = Соединение.Справочники.СвойстваДокументов.НайтиПоНаименованию("");
				ОбъектТам.Записать(Соединение.РежимЗаписиДокумента.Проведение);
			Иначе	
				Если Не ОбъектТам.ЭтоНовый() Тогда
					ОбъектТам.Удалить();
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		УстановитьПривилегированныйРежим(Истина);
		МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = СсылкаЗдесь;
		МенеджерЗаписи.ТипОчереди = Перечисления.уб_ТипыОчереди.ВыгрузкаВоВнешнююСистему;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		
	Исключение
		Сообщить("При синхронизации 1C:Управление брокером и 1С:Деньги 8.2" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьОбъектВ1СДеньгиПоУИН(Соединение,СсылкаЗдесь,ТипДокумента,ДокументДолженБытьПеренесен,Категория = Неопределено)
	
	УИНСтрокой = Строка (СсылкаЗдесь.УникальныйИдентификатор());
	Если Категория = Неопределено или Категория = Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка() Тогда
	Иначе
		УИНСтрокой = Строка (СсылкаЗдесь.УникальныйИдентификатор());
		УИНСтрокой = ОбщегоНазначения.MD5Хэш(УИНСтрокой+Категория.УникальныйИдентификатор());
		УИНСтрокой = Сред(УИНСтрокой,1,8)+"-"+Сред(УИНСтрокой,9,4)+"-"+Сред(УИНСтрокой,13,4)+"-"+Сред(УИНСтрокой,17,4)+"-"+Сред(УИНСтрокой,21,12);
	КонецЕсли;	
	МенеджерДокумента = Соединение.Документы[ТипДокумента];
	ДокументВ1СДеньги = МенеджерДокумента.НайтиПоРеквизиту("УИН", УИНСтрокой);	
	Если ДокументВ1СДеньги.Пустая() Тогда
		//есть возможность изменения типа документа (Приход/Расход)
		//TODO сделать запросом для нахождения всех документов по уину
		ОбратныйТип = ?(ТипДокумента = "Приход", "Расход", "Приход");
		ОбратныйДокументВ1СДеньги = Соединение.Документы[ОбратныйТип].НайтиПоРеквизиту("УИН", УИНСтрокой);
		Если Не ОбратныйДокументВ1СДеньги.Пустая() Тогда
			//удаляем не актуальный документ
			ОбратныйДокументВ1СДеньги.Удалить()
		КонецЕсли;
		Если ДокументДолженБытьПеренесен Тогда
			ОбъектТам = МенеджерДокумента.СоздатьДокумент();
			СсылкаТам = МенеджерДокумента.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор",УИНСтрокой));
			ОбъектТам.УстановитьСсылкуНового(СсылкаТам);
			ОбъектТам.УИН = УИНСтрокой;
			ОбъектТам.Дата = СсылкаЗдесь.Дата;
		Иначе
			//Документа нет и не надо создавать
			Возврат Неопределено;
		КонецЕсли;	
	Иначе
		ОбъектТам = ДокументВ1СДеньги.ПолучитьОбъект();
	КонецЕсли;
	Возврат ОбъектТам;
	
КонецФункции

Функция ПолучитьДанныеОДокументеИзБухгалтерии(УИДСтрокой,СтрокаСоединения="БП82") Экспорт
	//
	Результат = "";
	Соединение = Неопределено;
	Если Не уб_ОбменДанными.ПодключитьСоединение (Соединение, СтрокаСоединения,, "Ошибка подключения к 1С Бухгалтерии!") Тогда
		Возврат "Нет соединения с бухгалтерией";
		//"C:\Users\Roman1C\Documents\Money"
	КонецЕсли;

	Попытка
		СсылкаТам = Соединение.Документы.ОтчетКомиссионераОПродажах.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор",УИДСтрокой));
	Исключение
		Возврат "Ошибка преобразование УИД из бухгалтерии "+УИДСтрокой;
	КонецПопытки;
	ТекстЗапроса = "";
	Запрос = Соединение.NewObject("Запрос");
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтчетКомиссионераОПродажах.Ссылка,
