	//	Стр = Стр + Текст.ПолучитьСтроку(НомерСтроки) + "
	//	|"; 
	//КонецЦикла; 
	
	УдалитьФайлы(ИмяФайлаОтправки,);
	УдалитьФайлы(ИмяПолученногоФайла,);
	
	Возврат Текст;
	
КонецФункции

//Сервисная для ПолучитьДанныеЗаявкиИзБазы
Функция СформироватьТекстОшибки (ОписаниеОшибки)
	
	Если Найти(ОписаниеОшибки,"Couldn't resolve host name")>0 Тогда
		Возврат "Не известен адрес шлюза. Невозможно получить внешние данные по заявке.";
	Иначе
		Возврат ОписаниеОшибки;
	КонецЕсли;	
	
