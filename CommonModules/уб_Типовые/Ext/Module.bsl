//Быстрый простой запрос
Функция Запрос(Текст,Параметр=Неопределено,ЗначениеПоУмолчанию = Неопределено,ИмяПоля="Значение") Экспорт
	ТипПараметра = типЗнч(Параметр); 
	Запрос  =  Новый Запрос(Текст);
	Если ТипПараметра = Тип ("Структура") Тогда
		Если Параметр.Свойство("Параметры") тогда
			Для каждого ЭлПарметра из Параметр.параметры Цикл
				Запрос.УстановитьПараметр(ЭлПарметра.Ключ,ЭлПарметра.Значение);	
			КонецЦикла;	
		КонецЕсли;	
	Иначе
		Запрос.УстановитьПараметр ("Параметр",Параметр);
	КонецЕсли;	
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			//
			Возврат ЗначениеПоУмолчанию;
		Иначе
			//
			Выборка = РезультатЗапроса.Выбрать();
			Если Выборка.Количество()=1 тогда
				Выборка.Следующий();
				Возврат Выборка[ИмяПоля];
			Иначе	
				Результат = Новый СписокЗначений;
				Пока Выборка.Следующий() Цикл
					Результат.Добавить(Выборка[ИмяПоля]);
				КонецЦикла;	
				Возврат Результат;
			КонецЕсли;	
			
		КонецЕсли
		
	Исключение
		Сообщить("При запросе "+ОписаниеОшибки()+"");
		Возврат ЗначениеПоУмолчанию
	КонецПопытки;	
КонецФункции	



