// Открывает общую форму СообщениеОбОшибках и передает туда начальные параметры
//
// Параметры
//  Тз  – ТаблицаЗначений – таблица с описанием ошибок.
//                 
//  Форма  – Форма – ссылка на форму вызвавщую СообщениеОбОшибках
//
Процедура ОткрытьСообщениеОбОшибках(Тз, Форма = Неопределено) Экспорт
	
	ОбФорма = ПолучитьОбщуюФорму("уб_СообщениеОбОшибках", Форма);
	ОбФорма.ТаблицаОшибок = Тз.Скопировать();
	Если ОбФорма.Открыта() Тогда
		ОбФорма.Активизировать();
	Иначе
		ОбФорма.Открыть();
	КонецЕсли;
	
КонецПроцедуры // ОткрытьСообщениеОбОшибках()

// Создает пустую ТаблицуЗначений для описания ошибок
//
// Возвращаемое значение:
//   ТаблицаЗначений   – пустая таблица состоящая из 4 колонок:
//                       Ошибка, Элемент, Строка, ИмяОбработки
//
Функция СоздатьТаблицуОшибок() Экспорт
	ТзОшибки = Новый ТаблицаЗначений;
	ТзОшибки.Колонки.Добавить("Ошибка");
	ТзОшибки.Колонки.Добавить("Элемент");
	ТзОшибки.Колонки.Добавить("Строка");
	ТзОшибки.Колонки.Добавить("ИмяОбработки");
	ТзОшибки.Колонки.Добавить("Панель");
	ТзОшибки.Колонки.Добавить("Страница");
	ТзОшибки.Колонки.Добавить("Статус");
	Возврат ТзОшибки;
КонецФункции // СоздатьТаблицуОшибок

Функция СообщитьСОО(Тз) Экспорт
	Для Каждого COO из Тз Цикл
		Сообщить(COO.Ошибка,COO.Статус);
	КонецЦикла;
КонецФункции

