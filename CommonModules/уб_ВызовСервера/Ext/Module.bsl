Функция ИмяФайлаИзАдреса(Адрес,Разделитель = "/") Экспорт
	ДлинаАдреса = СтрДлина(Адрес);
	ИндексРазделителя = 0;
	Для Счетчик = 1 по СтрДлина(Адрес) цикл
		Если Сред(Адрес,Счетчик,1) = Разделитель Тогда
			ИндексРазделителя = Счетчик;	
		КонецЕсли;	
	КонецЦикла;	
	Если ИндексРазделителя = 0 Тогда
		ИмяФайла = Адрес;
	Иначе	
		ИмяФайла = СокрЛП(Сред(Адрес,ИндексРазделителя+1));
	КонецЕсли;	
	Возврат ИмяФайла;
КонецФункции	


Функция ПривестиНомерБСО(ВыборкаНомерБСО,ЕстьОшибка = ЛОЖЬ) Экспорт
	РазрешенныеСимволы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789/\-_ ()'";
	Длина = СтрДлина(ВыборкаНомерБСО);
	Слово = нрег(ВыборкаНомерБСО);
	НомерБСО = ВыборкаНомерБСО;
	ЕстьОшибка = ЛОЖЬ;
	ДЛя счетчик = 1 по Длина Цикл
		ТекСимвол  = Сред(Слово,Счетчик,1);
		СимволыСОшибками= Новый Массив;
		Если Найти(РазрешенныеСимволы,ТекСимвол) = 0 Тогда
			//Сообщить("'"+ТекСимвол+"'");
			//Сообщить(Выборка.НомерБСО);
			СимволыСОшибками.Добавить(ТекСимвол);
			ЕстьОшибка = Истина;
			//Прервать
		КонецЕсли;	
		Если ЕстьОшибка Тогда
			//Сообщить(Выборка.НомерБСО);
			Для каждого текСимвол из СимволыСОшибками Цикл
				Если текСимвол = "№" Тогда
					Если Лев(НомерБСО,2) = "№ " Тогда
						НомерБСО = СтрЗаменить(НомерБСО,"№ ","");
					ИначеЕсли Лев(НомерБСО,1) = "№" Тогда
						НомерБСО = СтрЗаменить(НомерБСО,"№","");	
					Иначе	
						НомерБСО = СтрЗаменить(НомерБСО,текСимвол,"-");
					КонецЕсли;	
				ИначеЕсли текСимвол = "¶" Тогда
					Если Лев(НомерБСО,2) = "¶-" Тогда
						НомерБСО = СтрЗаменить(НомерБСО,"¶-","");
						//ИначеЕсли Лев(НомерБСО,1) = "¶" Тогда
						//	НомерБСО = СтрЗаменить(НомерБСО,"№ ","");	
					Иначе	
						НомерБСО = СтрЗаменить(НомерБСО,текСимвол,"-");
					КонецЕсли;	
				ИначеЕсли Тексимвол = "–" или Тексимвол = "‑" Тогда	
					НомерБСО = СтрЗаменить(НомерБСО,текСимвол,"-");
				Иначе	
					НомерБСО = СтрЗаменить(НомерБСО,текСимвол,"");
				КонецЕсли;	
			КонецЦикла;	
			
			//Сообщить(НомерБСО);
		
		КонецЕсли;
	КонецЦикла;
	НомерБСО = СтрЗаменить(НомерБСО," - ","-");
	НомерБСО = СтрЗаменить(НомерБСО,"--","-");
	НомерБСО = СтрЗаменить(НомерБСО,"//","/");
	НомерБСО = СтрЗаменить(НомерБСО,"\\","\");
	НомерБСО = СтрЗаменить(НомерБСО,"я ","");
	НомерБСО = СокрЛП(врег(НомерБСО));
	Возврат НомерБСО;
КонецФункции	

