Функция ПечатьВнешнейФормы(Ссылка,КодФормы,Параметры) Экспорт
	
	
	СсылкаНаВнешнююОбработку = Справочники.ВнешниеОбработки.НайтиПоКоду(КодФормы);
	Если СсылкаНаВнешнююОбработку.Пустая() = ЛОЖЬ Тогда
		СтруктураПечати  = Новый Структура("СсылкаНаВнешнююОбработку,НомерСтроки",СсылкаНаВнешнююОбработку,1);
		ТабДокумент = НапечататьВнешнююФорму(Ссылка, СтруктураПечати,Параметры);
		Возврат ТабДокумент
	Иначе
		СсылкаНаВнешнююОбработку = Справочники.уб_ПечатныеФормы.НайтиПоКоду(КодФормы);
		
		//
	КонецЕсли;
КонецФункции	


Функция НапечататьВнешнююФорму(Ссылка, ИсточникМакета, Параметры = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ДвоичныеДанные = ИсточникМакета.СсылкаНаВнешнююОбработку.Принадлежность[ИсточникМакета.НомерСтроки - 1].ХранилищеВнешнейОбработки.Получить();
	// Получить дополнительные параметры внешней обработки
	ДополнительныеПараметры = ИсточникМакета.СсылкаНаВнешнююОбработку.Принадлежность[ИсточникМакета.НомерСтроки - 1].ДополнительныеПараметрыОбработки.Получить();
	ИсточникМакета.Свойство("ДополнительныеПараметрыОбработки", ДополнительныеПараметры);
	Если ДвоичныеДанные = Неопределено Тогда
		ДвоичныеДанные = ИсточникМакета.СсылкаНаВнешнююОбработку.ХранилищеВнешнейОбработки.Получить();
	КонецЕсли;
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТабДокумент = Неопределено;	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
		Обработка = ВнешниеОбработки.Создать(ИмяФайла);
		Обработка.СсылкаНаОбъект = Ссылка;
		// Передать внешней обработке дополнительные параметры
		Если ДополнительныеПараметры <> Неопределено Тогда			
			// Если у внешней обработки есть реквизит для дополнительных параметров, присвоить ему значение
			Если Не Обработка.Метаданные().Реквизиты.Найти("ДополнительныеПараметры") = Неопределено Тогда
				Обработка.ДополнительныеПараметры = ДополнительныеПараметры;
			КонецЕсли;			
		КонецЕсли;		
		Если Параметры = Неопределено Тогда
			ТабДокумент = Обработка.Печать()
		Иначе
			ТабДокумент = Обработка.Печать(Параметры)
		КонецЕсли;
		//перенес ниже, так как при вызове исключения не удалится временный файл
		//УдалитьФайлы(ИмяФайла);
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось сформировать внешнюю печатную форму. " + ОписаниеОшибки());
	КонецПопытки;
	Если Обработка <> Неопределено Тогда
		Попытка
			УдалитьФайлы(ИмяФайла)
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат ТабДокумент
	
КонецФункции


Функция ПолучитьСписокМарок(ТекстПоиска) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_МаркиТС.Ссылка,
	               |	уб_МаркиТС.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.уб_МаркиТС КАК уб_МаркиТС
	               |ГДЕ
	               |	уб_МаркиТС.Неактуальная = ЛОЖЬ
	               |	И уб_МаркиТС.ПометкаУдаления = ЛОЖЬ
	               |	И уб_МаркиТС.Наименование ПОДОБНО &Наименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Запрос.УстановитьПараметр("Наименование","%"+ТекстПоиска+"%");
	СписокМарок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокМарок.Добавить(Новый Структура("Значение,Представление",Выборка.Ссылка,Выборка.Наименование));
	КонецЦикла;	
	
	Возврат СписокМарок

КонецФункции	


