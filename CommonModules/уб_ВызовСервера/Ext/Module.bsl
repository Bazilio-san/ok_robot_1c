	Расширение = МЗ.ФайлРасширение;
	ИмяФайлаЧасть = Лев(ИмяФайла,СтрДлина(ИмяФайла)-?(Расширение="",0,СтрДлина(Расширение)+?(Лев(Расширение,1)=".",0,1)));
	//Если Интерактивно = Истина тогда
	//	Если ВвестиСтроку(ИмяФайлаЧасть,"Введите новое имя файла") = Истина Тогда
	//	Иначе
	//		Возврат;
	//	КонецЕсли;	
	//	ИмяФайлаНовое = ИмяФайлаЧасть+?(Лев(Расширение,1)=".",Расширение,"."+Расширение);
	//	НовоеИмяВХранилище = ""+мз.Хранилище.Путь+"\"+мз.ПутьКПапке+"\"+ИмяФайлаНовое;
	//Иначе
		ВидФайла = ""+ТекущаяСтрока.ВидДокумента;
		_Страхователь = ТекущаяСтрока.Страхователь;
		Если ТипЗнч(_Страхователь) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			_Страхователь = ОбщегоНазначения.ФИО_ФизЛица(_Страхователь.Наименование, , , , Истина);
		КонецЕсли;	
		_Страхователь = уб_temp.УбратьСимволы(_Страхователь);
		
		Если НЕ ЗначениеЗаполнено(ВидФайла) Тогда
			Возврат Ложь;
		КонецЕсли;	
		ВидФайла = СтрЗаменить(ВидФайла," ","_");
		ВидФайла = СтрЗаменить(ВидФайла,"__","_");
		Если Найти(ИмяФайлаЧасть,ВидФайла)=0 Тогда
			СчетчикПоиска = 0;
			Файл = Неопределено;
			Пока СчетчикПоиска = 0 или Файл.Существует() Цикл
				ИмяФайлаЧасть = Формат(ТекущаяСтрока.Номер,"ЧГ=")+"_"+_Страхователь+"_"+ВидФайла+?(СчетчикПоиска=0,"","_"+Формат(СчетчикПоиска,"ЧГ="));
				ИмяФайлаНовое = ИмяФайлаЧасть+?(Лев(Расширение,1)=".",Расширение,"."+Расширение);
				НовоеИмяВХранилище = ""+мз.Хранилище.Путь+"\"+мз.ПутьКПапке+"\"+ИмяФайлаНовое;
				Файл = Новый Файл (НовоеИмяВХранилище);
				СчетчикПоиска = СчетчикПоиска+1;
			КонецЦикла;	
			
		Иначе	
			ИмяФайлаНовое = ИмяФайлаЧасть+?(Лев(Расширение,1)=".",Расширение,"."+Расширение);
			НовоеИмяВХранилище = ""+мз.Хранилище.Путь+"\"+мз.ПутьКПапке+"\"+ИмяФайлаНовое;
		КонецЕсли;	
	//КонецЕсли;
	
	ИмяВХранилище = ""+мз.Хранилище.Путь+"\"+мз.ПутьКПапке+"\"+ИмяФайла;
	Если уб_Серверные._КопироватьФайл(ИмяВХранилище,НовоеИмяВХранилище) Тогда
		
		//
		КаталогДляЗаявки_ = КаталогДляЗаявки_(ТекущаяСтрока.ДокументСсылка);
		
		ФайлДСП = КаталогДляЗаявки_+"\";
		НовыйФайлДСП = ""+ФайлДСП;
		ФайлДСП      = ФайлДСП+ИмяФайла;
		НовыйФайлДСП = НовыйФайлДСП+ИмяФайлаНовое;
		Файл = Новый Файл(ФайлДСП);
		Если Файл.Существует() Тогда
			уб_Серверные._КопироватьФайл(ФайлДСП,НовыйФайлДСП);
			уб_Серверные._УдалитьФайлы(ФайлДСП);
		КонецЕсли;
		
		уб_Серверные._УдалитьФайлы(ИмяВХранилище);
		МЗ.ФайлИмя = ИмяФайлаНовое;
		ФлЕстьПравки = Истина;
		
		ТекущаяСтрока.Имя = ИмяФайлаНовое;
		ТекущаяСтрока.ПолноеИмя =СтрЗаменить(ТекущаяСтрока.ПолноеИмя,ИмяФайла,ИмяФайлаНовое);
	КонецЕсли;	
	Возврат Истина
КонецФункции


Функция КаталогДляЗаявки_(ДокументСсылка) Экспорт
	НомерСтроки = 1;
	ВидБСО = "";
	Парам=Новый Структура("Номер,Ссылка,Страхователь,Менеджер,Файлы,ВидБСО",ДокументСсылка.Номер,ДокументСсылка.Ссылка,ДокументСсылка.Страхователь,ДокументСсылка.Менеджер,Новый Массив,ВидБСО);
	КаталогДляЗаявки  = уб_Серверные.КаталогДляЗаявки(Парам);
	Если ДокументСсылка.Номер>111023 Тогда
		КаталогДляЗаявки_ = КаталогДляЗаявки+"\"+уб_B2B.УбратьСимволы(ВидБСО,"")+?(НомерСтроки=1,"",НомерСтроки);
	Иначе
		КаталогДляЗаявки_ = КаталогДляЗаявки;
	КонецЕсли;	
	
	Файл = Новый Файл(КаталогДляЗаявки_);
	Если НЕ Файл.Существует() Тогда
		уб_Серверные._СоздатьКаталог(КаталогДляЗаявки_);
	КонецЕсли;
	Возврат КаталогДляЗаявки_			
КонецФункции


