#Область Константы

Функция ПолучитьЗначениеКонстанты(Имя) Экспорт
	ЗначениеНастройки = Неопределено;
	Если ПараметрыСеанса.уб_Константы.Свойство(Имя,ЗначениеНастройки) Тогда
		Возврат ЗначениеНастройки;
	КонецЕсли;
	Возврат ЗначениеНастройки;
КонецФункции	

Процедура УстановитьЗначениеКонстанты(ИмяКонстанты, Значение, ПерезаполнятьПараметрыСеанса = Истина) Экспорт
	
	Объект = Справочники.уб_Константы[ИмяКонстанты].ПолучитьОбъект();
	Объект.ЗначениеКонстанты = Значение;
	Попытка
		Объект.Записать();
		Если ПерезаполнятьПараметрыСеанса Тогда
			УстановитьПараметрыСеансаКонстант();
		КонецЕсли;	
	Исключение
		#Если клиент Тогда
			Сообщить("Ошибка при записи константы «" + ИмяКонстанты + "» " + ОписаниеОшибки());
		#КонецЕсли	
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьПараметрыСеансаКонстант() Экспорт
	
	Структура = Новый Структура;
	ЗапросПоКонстантам = Новый Запрос;
	ЗапросПоКонстантам.Текст =
	"ВЫБРАТЬ
	|	уб_Константы.Ссылка,
	|	уб_Константы.ЗначениеКонстанты
	|ИЗ
	|	Справочник.уб_Константы КАК уб_Константы
	|ГДЕ
	|	уб_Константы.Предопределенный
	|	И НЕ уб_Константы.ЭтоГруппа";
	Выборка = ЗапросПоКонстантам.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Структура.Вставить(Справочники.уб_Константы.ПолучитьИмяПредопределенного(Выборка.Ссылка), Выборка.ЗначениеКонстанты);
	КонецЦикла;
	
	ОсновнаяОрганизация  = Справочники.Организации.ОсновнаяОрганизация();
	Если ЗначениеЗаполнено(ОсновнаяОрганизация ) Тогда
		Структура.Вставить("ОсновнаяОрганизация", ОсновнаяОрганизация);
	КонецЕсли;	
	
	//Структура.Вставить("ВалютаРегламентированногоУчета", 	Константы.ВалютаРегламентированногоУчета.Получить());	
	//#Если Клиент Тогда
	//Форма = ПолучитьОбщуюФорму("уб_БоковоеМеню");
	//#Иначе
	//Форма = Неопределено;
	//#КонецЕсли
	//Структура.Вставить("ЭтоРабочаяБаза", ?(Форма <> Неопределено И Форма.Открыта(), Форма.ЭтоРабочаяБаза, Найти(уб_temp.ПолучитьИмяБазыДанных(), "TAU") > 0));
	//Если Не Структура.ЭтоРабочаяБаза Тогда
	Если Структура.ЭтоРабочаяБаза <> Истина Тогда
		Структура.Вставить("СерверB2B", "b2b");
	КонецЕсли;	
	
	Если Структура.ПроверкаЗаявокОтделомКонтроля = Неопределено Тогда
		Структура.Вставить("ПроверкаЗаявокОтделомКонтроля", Ложь);
	КонецЕсли;	
	
	ДополнитьНастройкамиПользователя(Структура,ПараметрыСеанса.ТекущийПользователь);
	
	//#Если Не ВнешнееСоединение  Тогда
	//	//Медленно выполняется
	//	Если НЕ ПараметрыСеанса.ТекущийПользователь.Наименование = "WebService system account" Тогда 
	//		Структура.Вставить("SID", уб_СЕРВЕРные.SID());
	//	КонецЕсли;	
	//#КонецЕсли
	//МАСТЕР
	Структура.Вставить("ЭтоМастер", Найти(ПараметрыСеанса.уб_ОсновноеПодразделение,"М-ОП")=1);
	Структура.Вставить("ЭтоМастерРуководитель", Строка(ПараметрыСеанса.уб_ТекущееФизЛицо)= "Медков Артем");
	//
	ПараметрыСеанса.уб_Константы = Новый ФиксированнаяСтруктура(Структура);
	
КонецПроцедуры


Процедура ДополнитьНастройкамиПользователя(Структура,ТекущийПользователь)
	ЗапросНастройкиПользователя = Новый Запрос;
	ЗапросНастройкиПользователя.УстановитьПараметр("Пользователь", ТекущийПользователь);
	
	ЗапросНастройкиПользователя.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь,
	|	Пользователи.Профиль,
	|	ВЫБОР
	|		КОГДА Пользователи.Профиль = ЗНАЧЕНИЕ(Справочник.уб_ПрофилиНастроекПользователей.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьПрофиль
	|ПОМЕСТИТЬ Пользователи
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистрЗначениеПрав.Значение,
	|	РегистрЗначениеПрав.Настройка.Наименование КАК Наименование,
	|	РегистрЗначениеПрав.Настройка.ДобавлятьВПрофили,
	|	РегистрЗначениеПрав.Настройка.Ссылка КАК Ссылка,
	|	РегистрЗначениеПрав.Настройка.Предопределенный КАК Предопределенный,
	|	РегистрЗначениеПрав.Настройка.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	РегистрСведений.НастройкиПользователей КАК РегистрЗначениеПрав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Пользователи КАК Пользователи
	|		ПО (ВЫБОР
	|				КОГДА РегистрЗначениеПрав.Настройка.ДобавлятьВПрофили = ИСТИНА
	|						И Пользователи.ЕстьПрофиль = ИСТИНА
	|					ТОГДА РегистрЗначениеПрав.Пользователь = Пользователи.Профиль
	|				ИНАЧЕ РегистрЗначениеПрав.Пользователь = Пользователи.Пользователь
	|			КОНЕЦ)
	|			И (НЕ РегистрЗначениеПрав.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиПользователей.ПустаяСсылка))";
	
	Настройки = ПланыВидовХарактеристик.НастройкиПользователей;
	Выборка = ЗапросНастройкиПользователя.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			ПустоеЗначение = Выборка.ТипЗначения.ПривестиЗначение();
			Значение =  ПустоеЗначение;
		Иначе
			Значение = Выборка.Значение;
		КонецЕсли;
		
		Если Выборка.Предопределенный = Истина Тогда
			ИмяНастройки = Настройки.ПолучитьИмяПредопределенного(Выборка.Ссылка);
			//На примере ОсновнаяОрганизация, если задана выше она приоритетна, 
			//иначе берется из пользователя
			Если Структура.Свойство(ИмяНастройки) = ЛОЖЬ Тогда 
				Структура.Вставить(ИмяНастройки,Значение);		
			КонецЕсли;	
		Иначе
			Попытка
				Структура.Вставить(Выборка.Наименование,Значение);		
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		//Иначе
		//	ПустоеЗначение = Выборка.Настройка.ТипЗначения.ПривестиЗначение();
		//	Возврат ПустоеЗначение;
	КонецЦикла;
	
КонецПроцедуры

