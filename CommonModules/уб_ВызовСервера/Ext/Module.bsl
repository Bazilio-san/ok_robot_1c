Функция ДобавитьФайлИзВременногоХранилища(АдресФайла,СтруктураЗаполнения) Экспорт
//	Сообщить("Отладка 3");
	ДокументОбъект = СтруктураЗаполнения.СтраховойПолис.ПолучитьОбъект();
	
	ДанныеИзХранилища = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеИзХранилища) = Тип("ДвоичныеДанные") Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(СтруктураЗаполнения.ФайлРасширение);
		ДанныеИзХранилища.Записать(ИмяВременногоФайла);
		СтруктураЗаполнения.Вставить("ПолноеИмяФайла",ИмяВременногоФайла);
		СтруктураЗаполнения.Вставить("ИмяВременногоФайла",Истина);
	Иначе
		Сообщить("Получены ошибочные данные");
		Возврат Ложь
	КонецЕсли;

	//Сообщить("Отладка 4");	
	
	ДобавитьФайлКЗаявке(ДокументОбъект,СтруктураЗаполнения);
	УдалитьФайлы(ИмяВременногоФайла);
	Возврат Истина
КонецФункции					

Функция ЭтоИзображение(ФайлРасширение) Экспорт
	
	Индекс = 1;
	Для Индекс = 1 По СтрДлина(ФайлРасширение) Цикл
		Если Сред(ФайлРасширение, Индекс, 1) <> "." Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Расширение = Сред(ФайлРасширение, Индекс);
	СписокРасширений = Новый СписокЗначений;
	СписокРасширений.Добавить("bmp");
	СписокРасширений.Добавить("dib");
	СписокРасширений.Добавить("rle");
	СписокРасширений.Добавить("jpg");
	СписокРасширений.Добавить("jpeg");
	СписокРасширений.Добавить("jfif");	
	СписокРасширений.Добавить("tif");
	СписокРасширений.Добавить("gif");
	СписокРасширений.Добавить("png");
	СписокРасширений.Добавить("wmf");
	СписокРасширений.Добавить("emf");
	Возврат СписокРасширений.НайтиПоЗначению(НРег(Расширение)) <> Неопределено;
	
КонецФункции

Функция ИзменениеРазмещенияФайла(ТекущаяСтрока,ИмяКолонки,ДокументСсылка,СтруктураЗаполнения) Экспорт
	Отбор = Новый Структура;
	Отбор.Вставить("СсылкаСправочника",);
	Если НЕ СтруктураЗаполнения = Неопределено Тогда
		Попытка
			Для каждого Зн из СтруктураЗаполнения Цикл
				Отбор.Вставить(Зн.Ключ,Зн.Значение);		
			КонецЦикла;		
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Документ = ДокументСсылка.ПолучитьОбъект();
    ЕстьИзменения = Ложь;
	
	какСправочник = ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА;
	Если ИмяКолонки = "Размещен"  Тогда
		Если ТекущаяСтрока.Размещен тогда
			НоваяСтрока = Документ.СписокФайлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.ДатаПубликации = ТекущаяДата();
			ТекущаяСтрока.ДатаПубликации = НоваяСтрока.ДатаПубликации;
			
			Если какСправочник Тогда
				Если НоваяСтрока.СсылкаСправочника.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					НоваяСтрока.Опубликован = ИСТИНА;
					ТекущаяСтрока.Опубликован = НоваяСтрока.Опубликован;
				КонецЕсли;
				НоваяСтрока.Размещен = ИСТИНА;
				мСпрФайл = НоваяСтрока.СсылкаСправочника.ПолучитьОбъект();
				мСпрФайл.Опубликован = НоваяСтрока.Опубликован;
				Попытка
					мСпрФайл.Записать();
				Исключение
					Сообщить(ОписаниеОшибки());
					возврат ЛОЖЬ;
				КонецПопытки;
			КонецЕсли;
			Если НЕ СтруктураЗаполнения = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураЗаполнения);
			КонецЕсли;
		Иначе
			
			ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);
			ТекущаяСтрока.ДатаПубликации = Дата(0001,01,01);
			Массив = Документ.СписокФайлов.НайтиСтроки(Отбор);
			Если Массив.Количество()>0 тогда
				Документ.СписокФайлов.Удалить(Массив[0]);
				ЕстьИзменения = Истина;
			КонецЕсли;
			Если какСправочник = Ложь Тогда
				Если ТипЗнч(Документ) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
					КаталогДляЗаявки_ = уб_ВызовСервера.КаталогДляЗаявки_(Документ);
				Иначе
					КаталогДляЗаявки_ = "";	
				КонецЕсли;	
				
				Набор = РегистрыСведений.уб_ФайлыКПолисам.СоздатьНаборЗаписей();
				Набор.Отбор.УИД.Установить(ТекущаяСтрока.СсылкаСправочника);
				Набор.Прочитать();
				Если Набор.Количество() = 1 Тогда
					Для каждого МЗ Из Набор  Цикл
						МЗ.Размещен = Ложь;
						ЕстьИзменения = Истина;
					КонецЦикла;
					Набор.Записать();
					
					Если Не ПустаяСтрока(КаталогДляЗаявки_) Тогда
						//здесь дублируются данные
						ФайлДСП = КаталогДляЗаявки_+"\"+МЗ.ФайлИмя;
						Файл = Новый Файл(ФайлДСП);
						Если Файл.Существует() Тогда
							//Удаление
							уб_Серверные._УдалитьФайлы(ФайлДСП);
						Иначе
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
				Если ЕстьИзменения = Истина Тогда
					Документ.ОбменДанными.Загрузка = Истина;
					Документ.Записать();
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли ИмяКолонки = "Опубликован" Тогда
		ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);
		Массив = Документ.СписокФайлов.НайтиСтроки(Отбор);
		Если Массив.Количество()>0 тогда
			
			Строка = Массив[0];
			Строка.Опубликован = ТекущаяСтрока.Опубликован;
			ЕстьИзменения = Истина;
		КонецЕсли;
		Если ЕстьИзменения = Истина Тогда
			Документ.ОбменДанными.Загрузка = Истина;
			Документ.Записать();
		КонецЕсли;	
	КонецЕсли;
возврат ЕстьИзменения;
КонецФункции	


Функция ИзменениеВидаДокумента (ТекущаяСтрока) Экспорт
	ЕстьИзменения =  Ложь;
	Набор = РегистрыСведений.уб_ФайлыКПолисам.СоздатьНаборЗаписей();
	Набор.Отбор.УИД.Установить(ТекущаяСтрока.СсылкаСправочника);
	Набор.Прочитать();
	Если Набор.Количество() = 1 Тогда
		//Если файл в документе есть, то должен быть опубликован в регистре
		Для каждого МЗ Из Набор  Цикл
			//Если Не МЗ.Размещен = Истина Тогда
			//МЗ.Архив = НЕ МЗ.Архив;
			МЗ.ВидДокумента = ТекущаяСтрока.ВидДокумента;
			Если ЗначениеЗаполнено(ТекущаяСтрока.ВидДокумента) Тогда
				МЗ.ВидФайлаB2B  = ТекущаяСтрока.ВидДокумента.ВидФайлаB2B;
				ЕстьИзменения = ПереименоватьФайл(мз,ТекущаяСтрока);
				Если ТекущаяСтрока.ВидДокумента.Код = 74 Тогда
					//!!! это в форме насколько актуально
					ТекущаяСтрока.Вставить("НеобходимоВыбратьКошелек",  Истина);
				КонецЕсли;	
			Иначе
				МЗ.ВидФайлаB2B  = перечисления.уб_ВидыФайловB2B.ПРОЧЕЕ;
			КонецЕсли;	
			Набор.Записать();
			//КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	Возврат ЕстьИзменения;
КонецФункции

Функция  ПереименоватьФайл(мз,ТекущаяСтрока)
