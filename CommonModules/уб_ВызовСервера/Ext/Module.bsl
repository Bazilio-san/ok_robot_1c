Функция ДобавитьФайлКЗаявке(Документ,СтруктураЗаполнения  = Неопределено,Хранилище = Неопределено)   Экспорт
//	Сообщить("Отладка 5");
	Если Хранилище = Неопределено Тогда
		Хранилище = Справочники.уб_ХранилищаФайловБ2Б.ЗаявкаНаПечать;
	КонецЕсли;	
	
	Добавлено = Ложь;
	Попытка
		Страхователь = Документ.Страхователь;
	Исключение
		Если ТипЗнч(Документ) = Тип("ДокументОбъект.уб_ОтчетПоставщику") Тогда
			Страхователь	 = Документ.Поставщик;
		Иначе
			Страхователь = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;	
	КонецПопытки;
	Попытка
		ОбъектСтрахования = Документ.ОбъектСтрахования;	
	Исключение
		ОбъектСтрахования = Справочники.уб_ОбъектыСтрахования.ПустаяСсылка();
	КонецПопытки;
	
	ТЗФайлов = Новый ТаблицаЗначений;
	ТЗФайлов.Колонки.Добавить("Справочник");
	ТЗФайлов.Колонки.Добавить("ВидФайлаB2B");
	
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(СтруктураЗаполнения.ПолноеИмяФайла);
	
	Сч = 0;
	
	какСправочник = ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА;
	
	ВидДокумента = СтруктураЗаполнения.ВидДокумента;
	
	Для Каждого Строка Из МассивФайлов Цикл 
		ПолноеИмяФайла = Строка;
		Сч = Сч +1;
		Если НЕ ЗначениеЗаполнено(ПолноеИмяФайла) Тогда 
			Продолжить;
		КонецЕсли;
		
		оФайлОткуда = Новый Файл(ПолноеИмяФайла);
		Если СтруктураЗаполнения.Свойство("ИмяВременногоФайла") Тогда
			Если СтруктураЗаполнения.Свойство("ФайлИмя") Тогда
				ИмяИсходящегоФайла             = СтруктураЗаполнения.ФайлИмя;
				ИмяКонечногоФайлаБезРасширения = СтрЗаменить(СтруктураЗаполнения.ФайлИмя,СтруктураЗаполнения.ФайлРасширение,"");
			Иначе
				ИмяИсходящегоФайла             = СтрЗаменить(уб_temp.УбратьСимволы(СокрЛП(Документ.Номер)), Символ(160), "") + "_" + оФайлОткуда.Имя;
				ИмяКонечногоФайлаБезРасширения = оФайлОткуда.ИмяБезРасширения;
			КонецЕсли;	
		Иначе	
			ИмяИсходящегоФайла             = СтрЗаменить(уб_temp.УбратьСимволы(СокрЛП(Документ.Номер)), Символ(160), "") + "_" + оФайлОткуда.Имя;
			ИмяКонечногоФайлаБезРасширения = оФайлОткуда.ИмяБезРасширения;
		КонецЕсли;	
		
		
		Если какСправочник = Истина Тогда 
			//проверем наличие
			мЗапрос = Новый Запрос;
			мЗапрос.Текст = "ВЫБРАТЬ
			|	уб_ФайлыКПолисам.Ссылка,
			|	уб_ФайлыКПолисам.ВидФайлаB2B
			|ИЗ
			|	Справочник.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
			|ГДЕ
			|	уб_ФайлыКПолисам.ФайлРазмер = &ФайлРазмер
			|	И уб_ФайлыКПолисам.ФайлРасширение = &ФайлРасширение
			|	И уб_ФайлыКПолисам.Страхователь = &Страхователь";
			мЗапрос.УстановитьПараметр("Страхователь", Страхователь);
			мЗапрос.УстановитьПараметр("ФайлРазмер", оФайлОткуда.Размер());
			мЗапрос.УстановитьПараметр("ФайлРасширение", Сред(оФайлОткуда.Расширение, 2));
			
			Результат = мЗапрос.Выполнить().Выбрать();
			Если Результат.Следующий() Тогда 
				Запись = Результат.Ссылка;
				мВидФайлаB2B = Результат.ВидФайлаB2B;
			Иначе 
				
				мВидФайлаB2B = ВидДокумента.ВидФайлаB2B;
				// получить путь новой папки файла
				Если ТипЗнч(Страхователь) = Тип("СправочникСсылка.Контрагенты") Тогда
					НаименованиеСтрахователя = Страхователь.folder;
				ИначеЕсли ТипЗнч(Страхователь) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
					НаименованиеСтрахователя = ОбщегоНазначения.ФИО_ФизЛица(Страхователь.Наименование, , , , Истина);
				Иначе
					НаименованиеСтрахователя = "НЕИЗВЕСТНЫЙ_СТРАХОВАТЕЛЬ";
				КонецЕсли;
				КлПапка = уб_temp.УбратьСимволы(НаименованиеСтрахователя);
				
				Если мВидФайлаB2B = Перечисления.уб_ВидыФайловB2B.ФОТО Тогда 
					КатНазнач = Справочники.уб_ХранилищаФайловБ2Б.FOTO.Путь + "\" + КлПапка;
					Хранилище = Справочники.уб_ХранилищаФайловБ2Б.FOTO;
				Иначе
					КлПапка = КлПапка + ?(мВидФайлаB2B = Перечисления.уб_ВидыФайловB2B.БСО_ДОК,"", "\" + мВидФайлаB2B);
					КатНазнач = Справочники.уб_ХранилищаФайловБ2Б.DOC.Путь + "\" + КлПапка;
					Хранилище = Справочники.уб_ХранилищаФайловБ2Б.DOC; 
				КонецЕсли;
				
				оКаталогКуда = Новый Файл(КатНазнач);
				ИмяКонечногоФайлаБезРасширения = ?(ЭтоИзображение(оФайлОткуда.Расширение), КлПапка, ИмяКонечногоФайлаБезРасширения) 
				+ ?(Не ЗначениеЗаполнено(ВидДокумента), "", "_[" + Строка(ВидДокумента) + "]_"+Сч+"");	
				ИмяКонечногоФайлаБезРасширения = уб_temp.УбратьЗапрещенныеСимволыИзИмениФайла(ИмяКонечногоФайлаБезРасширения);
				
				оФайлКуда = Новый Файл(КатНазнач + "\" + ИмяКонечногоФайлаБезРасширения + оФайлОткуда.Расширение);
				
				Если НЕ оФайлКуда.Существует() Тогда
					оФайлКуда = Новый Файл(КатНазнач + "\" + ИмяКонечногоФайлаБезРасширения+"2"+ оФайлОткуда.Расширение);
					Если НЕ оФайлКуда.Существует() Тогда
						оФайлКуда = Новый Файл(КатНазнач + "\" + ИмяКонечногоФайлаБезРасширения+"3"+ оФайлОткуда.Расширение);
						Если НЕ оФайлКуда.Существует() Тогда
							оФайлКуда = Новый Файл(КатНазнач + "\" + ИмяКонечногоФайлаБезРасширения+"4"+ оФайлОткуда.Расширение);
							Если НЕ оФайлКуда.Существует() Тогда
								оФайлКуда = Новый Файл(КатНазнач + "\" + ИмяКонечногоФайлаБезРасширения+"5"+ оФайлОткуда.Расширение);
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
				
				
				Если НЕ оКаталогКуда.Существует() Тогда
					уб_Серверные._СоздатьКаталог(КатНазнач);
				КонецЕсли;
				
				
				уб_серверные._КопироватьФайл(ПолноеИмяФайла, оФайлКуда.ПолноеИмя);
				
