Функция СтрахователиПоНаименованию(Наименование) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ФизическиеЛица.Ссылка КАК Ссылка,
	               |	ФизическиеЛица.ПометкаУдаления КАК ПометкаУдаления
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	               |ГДЕ
	               |	(ФизическиеЛица.Наименование ПОДОБНО &Наименование
				   |     ИЛИ ФизическиеЛица.КлючПоиска ПОДОБНО &КлючПоиска )
	               |			//ИЛИ ФизическиеЛица.Наименование ПОДОБНО &Перевод)
	               |	И ФизическиеЛица.ЭтоГруппа = ЛОЖЬ
				   |	И ПометкаУдаления = Ложь
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Контрагенты.Ссылка,
	               |	ПометкаУдаления
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ЭтоГруппа = ЛОЖЬ
				   |	И ПометкаУдаления = Ложь
	               |	И (Контрагенты.Наименование ПОДОБНО &Наименование
	               |			ИЛИ Контрагенты.ИНН ПОДОБНО &Наименование
	               |			ИЛИ ПОДСТРОКА(Контрагенты.НаименованиеПолное, 1, 255) ПОДОБНО &Наименование)
	               |			//ИЛИ Контрагенты.Наименование ПОДОБНО &Перевод
	               |		//	ИЛИ ПОДСТРОКА(Контрагенты.НаименованиеПолное, 1, 255) ПОДОБНО &Перевод)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование","%"+Наименование+"%");
	Запрос.УстановитьПараметр("Перевод","%"+уб_Фильтры.ПеревестиСтроку(Наименование)+"%");
	Запрос.УстановитьПараметр("КлючПоиска",уб_ВызовСервера.КлючПоискаНаименования(Наименование)+"%");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	



