Функция ПолучитьРезультатЗапросаПоиска(ИмяСправочника, ТекстДляПоиска, ТранслитТекстДляПоиска, ТекстВДругойРаскладке, ТранслитТекстВДругойРаскладке, Владелец, ОграничениеКоличества = 30) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + СтрЗаменить(Строка(ОграничениеКоличества),Символы.НПП, "") + "
	|	Спр.Ссылка,
	|	Спр.Наименование,
	|	Спр.Код
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ
	|	1 = 1 И (Спр.Наименование ПОДОБНО ""%"" + &Наименование + ""%""
	|			ИЛИ Спр.Наименование ПОДОБНО ""%"" + &НаименованиеТранслит + ""%""
	|			ИЛИ Спр.Наименование ПОДОБНО ""%"" + &ПереводРаскладки + ""%""
	|			ИЛИ Спр.Наименование ПОДОБНО ""%"" + &ПереводРаскладкиТранслит + ""%"")";	
	Запрос.УстановитьПараметр("Наименование", ТекстДляПоиска);
	Запрос.УстановитьПараметр("НаименованиеТранслит", ТранслитТекстДляПоиска);
	Запрос.УстановитьПараметр("ПереводРаскладки", ТекстВДругойРаскладке);
	Запрос.УстановитьПараметр("ПереводРаскладкиТранслит", ТранслитТекстВДругойРаскладке);
	
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Спр.Владелец В (&Владелец)");
		Если ТипЗнч(Владелец) <> Тип("СписокЗначений") Тогда
			ПараметрВладелец = Новый СписокЗначений;
			ПараметрВладелец.Добавить(Владелец);
		Иначе
			ПараметрВладелец = Владелец;
		КонецЕсли;
		Запрос.УстановитьПараметр("Владелец", ПараметрВладелец);
	КонецЕсли;
	ТЗ =  Запрос.Выполнить().Выгрузить();
	Массив = Новый Массив;
	Для каждого Выборка из ТЗ Цикл
		Массив.Добавить(Новый Структура("Ссылка,Наименование,Код",Выборка.Ссылка,Выборка.Наименование,Выборка.Код));
	КонецЦикла;	
	Возврат Массив;
КонецФункции
	

Функция ПроверкаНаШаблон(Текст, Шаблон) Экспорт
	
	Если Текст <> "" Тогда
		RegExp = Новый COMОбъект("VBScript.RegExp");
		RegExp.MultiLine 	= Истина; // истина — текст многострочный, ложь — одна строка
		RegExp.Global 		= Истина; // истина — поиск по всей строке, ложь — до первого совпадения
		RegExp.IgnoreCase 	= Истина; // истина — игнорировать регистр строки при поиске
		RegExp.Pattern 		= Шаблон ; // шаблон (регулярное выражение) для поиска параметра
		мНайд = RegExp.Execute(Текст); 
		Если мНайд.count>0 Тогда 
			Возврат Ложь
		КонецЕсли;
	КонецЕсли;
	Возврат Истина
	
КонецФункции // ПроверкаНаШаблон()


