Функция НайтиОбъектСтрахования(ВидБСО,vin,МаркаТС,МодельТС) Экспорт
	Попытка
		Если Не ПустаяСтрока(vin)
			и ЗначениеЗаполнено(МаркаТС)
			и ЗначениеЗаполнено(МодельТС)
			Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	уб_ОбъектыСтрахования.Ссылка
			|ИЗ
			|	Справочник.уб_ОбъектыСтрахования КАК уб_ОбъектыСтрахования
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
			|		ПО уб_ТранспортныеСредства.Объект = уб_ОбъектыСтрахования.Ссылка
			|ГДЕ
			|	//уб_ТранспортныеСредства.МаркаТС = &МаркаТС
			//|	И уб_ТранспортныеСредства.МодельТС = &МодельТС
			|	уб_ТранспортныеСредства.ИдентификационныйНомер подобно &ИдентификационныйНомер и уб_ОбъектыСтрахования.ПометкаУдаления = ЛОЖЬ";
			Запрос.УстановитьПараметр("МаркаТС",МаркаТС);
			Запрос.УстановитьПараметр("МодельТС",МодельТС);
			Запрос.УстановитьПараметр("ИдентификационныйНомер",vin);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			Иначе
				//
				Если СтрДлина(VIN) = 17 Тогда
					
					НовыйОбъект = Справочники.уб_ОбъектыСтрахования.СоздатьЭлемент();
					НовыйОбъект.Тип = Справочники.уб_ТипыОбъектовСтрахования.НайтиПоНаименованию("Автомобиль");
					НовыйОбъект.Наименование = ""+МаркаТС+" "+МодельТС;
					НовыйОбъект.Записать();
					мз = РегистрыСведений.уб_ТранспортныеСредства.СоздатьМенеджерЗаписи();
					мз.Объект = НовыйОбъект.Ссылка; 
					мз.МаркаТС = МаркаТС;
					мз.МодельТС = МодельТС;
					мз.ИдентификационныйНомер = VIN;
					мз.Записать();
					//Предупреждение("Создали новый объект",2);
					Возврат НовыйОбъект.Ссылка;
				Иначе
					Сообщить("Длина vin не верна, автоматическое создание невозможно"); 
				КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;	
	Исключение
	КонецПопытки;
КонецФункции

Функция ПолучитьДействующиеКартыПодразделения(ПодразделениеМенеджера,Менеджер) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Вложенный.Карта КАК Карта,
	|	ПРЕДСТАВЛЕНИЕ(Вложенный.Карта) КАК Представление,
	|	Вложенный.Сортировка КАК Сортировка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодразделенияОрганизацийКарточкиСотрудников.Карта КАК Карта,
	|		ВЫБОР
	|			КОГДА ПодразделенияОрганизацийКарточкиСотрудников.Карта.Сотрудник = &Менеджер
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК Сортировка
	|	ИЗ
	|		Справочник.ПодразделенияОрганизаций.КарточкиСотрудников КАК ПодразделенияОрганизацийКарточкиСотрудников
	|	ГДЕ
	|		ПодразделенияОрганизацийКарточкиСотрудников.Ссылка = &Подразделение
	|		И ПодразделенияОрганизацийКарточкиСотрудников.Карта.ПометкаУдаления = ЛОЖЬ
	|		И ПодразделенияОрганизацийКарточкиСотрудников.Карта.Актуальность = ИСТИНА
	|		И ПодразделенияОрганизацийКарточкиСотрудников.Карта.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
	|		И НЕ ПодразделенияОрганизацийКарточкиСотрудников.Карта.Сотрудник В
	|					(ВЫБРАТЬ
	|						уб_ДвижениеФизлицПоПодразделениям.Агент
	|					ИЗ
	|						регистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениям
	|					ГДЕ
	|						уб_ДвижениеФизлицПоПодразделениям.Выбытие = ИСТИНА)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		Сотрудники.Ссылка,
	|		0
	|	ИЗ
	|		Справочник.Кошельки.Сотрудники КАК Сотрудники
	|	ГДЕ
	|		Сотрудники.Сотрудник = &Менеджер
	|		И Сотрудники.Ссылка.ПометкаУдаления = ЛОЖЬ
	|		И Сотрудники.Ссылка.Актуальность = ИСТИНА
	|		И Сотрудники.Ссылка.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)) КАК Вложенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вложенный.Сортировка";
	Запрос.УстановитьПараметр("Подразделение",ПодразделениеМенеджера);
	Запрос.УстановитьПараметр("Менеджер",Менеджер);
	Выборка =  Запрос.Выполнить().Выбрать();
	МассивКарт = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивКарт.Добавить(Новый Структура("Карта,Представление",Выборка.Карта,Выборка.Представление));
	КонецЦикла;
	Возврат МассивКарт;
КонецФункции	

