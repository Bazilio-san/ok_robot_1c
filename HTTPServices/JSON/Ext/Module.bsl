				Если ТипЗНч(Данные.params.tg_id) = Тип("Число") Тогда
					Запрос.УстановитьПараметр("tg_id", Формат(Данные.params.tg_id,"ЧГ="));
				Иначе
					Запрос.УстановитьПараметр("tg_id", Строка(Данные.params.tg_id));
				КонецЕсли;	
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда

				
				ИмяВременнногоФайла = ПолучитьИмяВременногоФайла("pdf");
				ИмяВременнногоФайла = СтрЗаменить(ИмяВременнногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"\"),"sup_"+request_id+".pdf");
				
				Таб = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПечатьДоговораПоддержки(Новый Структура,Выборка.Ссылка);
				Таб.Записать(ИмяВременнногоФайла,ТипФайлаТабличногоДокумента.PDF);
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.УстановитьИмяФайлаТела(ИмяВременнногоФайла);				
				Иначе
					Ответ = Ответ(407,"Ошибка при формировании");
				
				КонецЕсли;
				Возврат Ответ;
			Иначе
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции	


