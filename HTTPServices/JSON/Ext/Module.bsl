Функция ОтветНаList(Данные,Вид)
	Дата1 = НачалоДня(ТекущаяДата());
	name = "";
	ЕстьЧек = Ложь;
	
		
	Если Вид = "today" Тогда
		Дата2 = КонецДня(Дата1);
	ИначеЕсли Вид = "tomorrow" Тогда
		Дата1 = КонецДня(Дата1)+1;
		Дата2 = КонецДня(Дата1);
	ИначеЕсли Вид = "week" Тогда
		Дата2 = КонецДня(Дата1+7*24*3600);
	ИначеЕсли Вид = "lastweek" Тогда
		Дата2 = КонецДня(Дата1);
		Дата1 = НачалоДня(Дата1-8*24*3600);
	ИначеЕсли Вид = "w_check" Тогда
		Дата2 = КонецДня(Дата1);
		//Дата1 = НачалоМесяца(НачалоМесяца(Дата1)-1);
		Дата1 = НачалоДня(Дата1-60*24*3600);
		ЕстьЧек = Истина;
	ИначеЕсли Вид = "list" Тогда
		Дата2 = КонецДня(Дата1+7*24*3600);
		Дата1 = НачалоДня(Дата1-60*24*3600);
		
	Иначе
		Ответ = Ответ(407,"Параметры имеют неизвестный формат");
		Возврат Ответ	
	КонецЕсли;	
	
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("name") Тогда
				Если Найти(Данные.params.name,"%") = 0 и СтрДлина(Данные.params.name)>4 тогда
					name = "%"+Данные.params.name+"%"
				КонецЕсли;	
			КонецЕсли;
			
			Если Данные.params.Свойство("date1") Тогда
				Дата1 =  ДатаИзСтроки(Данные.params.date1);
			КонецЕсли;
			
			Если Данные.params.Свойство("date2") Тогда
				Дата2 =  ДатаИзСтроки(Данные.params.date2);
			КонецЕсли;
			
			Если Данные.params.Свойство("w_check") Тогда
				ЕстьЧек =  Данные.params.w_check = Истина или Данные.params.w_check = "true" или Данные.params.w_check = "True";
			КонецЕсли;
			
		КонецЕсли;	
    КонецЕсли;

	
	
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("tg_id")  Тогда
				tg_id = Формат(Данные.params.tg_id,"ЧГ=");
				
				
				Парам = Новый Структура;
				
				Если Вид ="w_check" или ЕстьЧек = Истина Тогда
					Условие = " Ссылка.Дата >= &Дата1 И Ссылка.Дата <= &Дата2
					//| И Чеки.УидСтроки есть null  
					|и уб_ИсторияСтатусовЗаявокСрезПоследних.Статус в (Значение(Перечисление.уб_СтатусыЗаявок.БСОНаРукахУКурьера),Значение(Перечисление.уб_СтатусыЗаявок.СтраховкаСостоялась),Значение(Перечисление.уб_СтатусыЗаявок.ЗаявкаОтработана),Значение(Перечисление.уб_СтатусыЗаявок.КомплектНаХраненииВБухгалтерии) ,Значение(Перечисление.уб_СтатусыЗаявок.ДеньгиВКомпании)) ";
				ИначеЕсли Вид ="list" Тогда	
					Условие = " Ссылка.Дата >= &Дата1 И Ссылка.Дата <= &Дата2 ";
					//Если пустаяСтрока(name) Тогда
					//	name = "Не будем искать";
					//КонецЕсли	
				Иначе	
					Условие = " Ссылка.Дата >= &Дата1 И Ссылка.Дата <= &Дата2";
				КонецЕсли;
				
				Если не пустаяСтрока(name) Тогда
					Условие =  Условие + " И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Страхователь.Наименование подобно &name ";
				КонецЕсли;	
				
				Условие2 = " Ссылка.Дата >= &Дата1 И Ссылка.Дата <= &Дата2";
				Парам.Вставить("Условие", Условие );
				Парам.Вставить("Условие2", Условие2 );
				Парам.Вставить("Параметры", Новый Структура("tg_id,Дата1,Дата2,name",tg_id,Дата1,Дата2,name));
				
				Ответ = Новый Массив;
				Данные = ПолучитьВыборку(Парам);
				Выборка     = Данные.Заявки;
				Чеки = Данные.Чеки;
				Сообщения = Данные.Сообщения;

				Пока Выборка.Следующий() Цикл
					Если (Вид ="w_check" или ЕстьЧек = Истина) и Выборка.ЕстьЧек  = Истина Тогда
						Продолжить;
					КонецЕсли;	
						
						
					Структура = ВыборкаВструктуру(Выборка,Чеки,Сообщения);
					
					
					Ответ.Добавить(Структура);
				КонецЦикла;	
				Возврат Ответ(200,уб_СЕРВЕРные.JSON(Ответ));
				
			Иначе
				Ответ = Ответ(404,"Не найдена заявка");
				Возврат Ответ
			КонецЕсли;	
	Иначе	
		Ответ = Ответ(407,"Параметры имеют неизвестный формат");
		Возврат Ответ	
	КонецЕсли;	
Иначе
	Ответ = Ответ(406,"Отсутствуют параметры");
	Возврат Ответ 	
КонецЕсли;	

КонецФункции


Функция ВыборкаВСтруктуру(Выборка,Чеки,Сообщения)
	Структура = Новый Структура;
	Структура.Вставить("Номер",Выборка.Номер);
	Структура.Вставить("Дата",Выборка.Дата);
	Структура.Вставить("Страхователь",Выборка.Страхователь);
	Структура.Вставить("Статус",Выборка.Статус);
	Структура.Вставить("userid",Выборка.userid);
	Структура.Вставить("tg_id",Выборка.tg_id);
	Структура.Вставить("userid",Выборка.userid);
	Структура.Вставить("ВремяНачало",Выборка.ВремяНачало);
	Структура.Вставить("ВремяОкончания",Выборка.ВремяОкончания);
	Структура.Вставить("Адрес",Выборка.Адрес);
	Структура.Вставить("Комментарий",Выборка.Комментарий);
	Структура.Вставить("СтанцияМетро",Строка(Выборка.СтанцияМетро));
	Структура.Вставить("Менеджер",Строка(Выборка.Менеджер));
	Структура.Вставить("man_id",Строка(Выборка.man_id));	
	Структура.Вставить("НомерАМО",Выборка.НомерАМО);
	
	Структура.Вставить("НеобходимостьОсмотра",Выборка.НеобходимостьОсмотра);
	
	Структура.Вставить("КонтактноеЛицо",Выборка.КонтактноеЛицо);
	Структура.Вставить("ЕстьЧек",Выборка.ЕстьЧек);
	Структура.Вставить("ФормаОплаты",Строка(Выборка.ФормаОплаты));
	Структура.Вставить("СуммаИтого",Формат(Выборка.СуммаИтого,"ЧДЦ=2; ЧГ="));
	
	МассивБСО = Новый Массив;
	Для каждого СтрокаБСО из Выборка.Ссылка.БСО.Выгрузить() Цикл
		СтруктураБСО = Новый Структура;
		СтруктураБСО.Вставить("Вид",Строка(СтрокаБСО.ВидБСО));
		СтруктураБСО.Вставить("СтраховаяКомпания",Строка(СтрокаБСО.СК));
		СтруктураБСО.Вставить("Премия",СтрокаБСО.ИтогСтраховаяПремия-СтрокаБСО.ИтогПредоставленнаяСкидка);
		СтруктураБСО.Вставить("ДатаНачала",СтрокаБСО.ДатаНачала);
		СтруктураБСО.Вставить("ДатаОкончания",СтрокаБСО.ДатаОкончания);
		СтруктураБСО.Вставить("УидСтроки",СтрокаБСО.УидСтроки);		
		нСтроки = Чеки.НайтиСтроки(Новый Структура("УидСтроки",СтрокаБСО.УидСтроки));
		
		СтруктураБСО.Вставить("ЕстьЧек",нСтроки.Количество()>0);		
		
		МассивБСО.Добавить(СтруктураБСО);
	КонецЦикла;	
	
	Структура.Вставить("БСО",МассивБСО);
	
	Префикс = Префикс();
	
	Структура.Вставить("ref",Префикс+ПолучитьНавигационнуюСсылку(Выборка.Ссылка));
	
	
	Структура.Вставить("Сообщения",Сообщения(Сообщения.Скопировать(Новый Структура("Ссылка",Выборка.Ссылка))));
	Структура.Вставить("КоличествоСообщений",Структура.Сообщения.Количество());
	
	
	
	Попытка
		Структура.Вставить("refСтрахователь",Префикс+ПолучитьНавигационнуюСсылку(Выборка.refСтрахователь));
	Исключение
		Структура.Вставить("refСтрахователь","");
	КонецПопытки;	
	Возврат Структура
КонецФункции

