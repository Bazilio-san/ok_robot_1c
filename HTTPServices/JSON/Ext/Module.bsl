Функция НайтиПользователя(id)
	 Запрос = Новый Запрос;
	 Запрос.УстановитьПараметр("tg_id", id);
	 Запрос.Текст = "ВЫБРАТЬ
	                |	Пользователи.Ссылка КАК Ссылка,
	                |	Пользователи.ФизЛицо.tg_id КАК ФизЛицоtg_id
	                |ИЗ
	                |	Справочник.Пользователи КАК Пользователи
	                |ГДЕ
	                |	Пользователи.ФизЛицо.tg_id = &tg_id";
	 Выборка = Запрос.Выполнить().Выбрать();
	 Если Выборка.Следующий() Тогда
		 Возврат Выборка.Ссылка;
	 Иначе
		 Возврат Справочники.Пользователи.ПустаяСсылка();
	 КонецЕсли; 
 КонецФункции	
 
Процедура ОбработатьПериодСообщения(МЗ)
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	уб_Чат_Сообщения.Период КАК Период,
	                |	уб_Чат_Сообщения.Отправитель КАК Отправитель,
	                |	уб_Чат_Сообщения.Получатель КАК Получатель,
	                |	уб_Чат_Сообщения.ИмяКанала КАК ИмяКанала,
	                |	уб_Чат_Сообщения.ИДСообщения КАК ИДСообщения,
	                |	уб_Чат_Сообщения.Заголовок КАК Заголовок,
	                |	уб_Чат_Сообщения.Сообщение КАК Сообщение,
	                |	уб_Чат_Сообщения.Вложения КАК Вложения,
	                |	уб_Чат_Сообщения.НеОтображатьНаWeb КАК НеОтображатьНаWeb,
	                |	уб_Чат_Сообщения.ДатаОбновления КАК ДатаОбновления,
	                |	уб_Чат_Сообщения.ИмяИконки КАК ИмяИконки,
	                |	уб_Чат_Сообщения.ЕстьВложения КАК ЕстьВложения,
	                |	уб_Чат_Сообщения.ВОтчет КАК ВОтчет,
	                |	уб_Чат_Сообщения.SMS КАК SMS,
	                |	уб_Чат_Сообщения.Руководителю КАК Руководителю
	                |ИЗ
	                |	РегистрСведений.уб_Чат_Сообщения КАК уб_Чат_Сообщения
	                |ГДЕ
	                |	уб_Чат_Сообщения.Отправитель = &Отправитель
	                |	И уб_Чат_Сообщения.Получатель = &Получатель
	                |	И уб_Чат_Сообщения.ИмяКанала = &ИмяКанала
	                |	И уб_Чат_Сообщения.ИДСообщения = &ИДСообщения
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Период";
	 Запрос.УстановитьПараметр("Отправитель",МЗ.Отправитель);
	 Запрос.УстановитьПараметр("Получатель",МЗ.Получатель);
	 Запрос.УстановитьПараметр("ИмяКанала",МЗ.ИмяКанала);
	 Запрос.УстановитьПараметр("ИДСообщения",МЗ.ИДСообщения);
	 Выборка = Запрос.Выполнить().Выбрать();
	 Если Выборка.Следующий() Тогда
		 МЗ.Период = Выборка.Период;
	КонецЕсли; 
