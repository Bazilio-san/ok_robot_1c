Функция ОтветНаЗаявка(Данные)
	
	Ошибка = "";
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("Номер") Тогда
				
				Если ТипЗНч(Данные.params.Номер) = Тип("Число") Тогда
					request_id = Формат(Данные.params.Номер,"ЧГ=");
				Иначе
					request_id = Строка(Данные.params.Номер);
				КонецЕсли;	
			Иначе
				request_id = "";
			КонецЕсли;	
			
			Если Данные.params.Свойство("НомерАМО") Тогда
				НомерАМО = Данные.params.НомерАМО;
			Иначе	
				НомерАМО = Перечисления.уб_ВидыЗаявок.Личная;
			КонецЕсли;	
			
			Если Данные.params.Свойство("Дата") Тогда
				Дата = ДатаИзСтроки(Данные.params.Дата);
			Иначе
				Дата = ТекущаяДата();
			КонецЕсли;	
			
			Если Данные.params.Свойство("Страхователь") Тогда
				Страхователь = Данные.params.Страхователь;
				Если Страхователь.Свойство("ФИО") Тогда
					СтраховательНаименование = Страхователь.ФИО;
				ИначеЕсли Страхователь.Свойство("Наименование") Тогда
					СтраховательНаименование = Страхователь.Наименование;	
				КонецЕсли;	
			Иначе
				СтраховательНаименование = "";
			КонецЕсли;	
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Заявки.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК Заявки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
			|		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = Заявки.Ссылка)
			|ГДЕ
			|	Заявки.Менеджер.tg_id = &man_id
			|	И Заявки.ПометкаУдаления = ЛОЖЬ
			|	И 1 = 1";
			Если НЕ НомерАМО = Перечисления.уб_ВидыЗаявок.Личная Тогда
				Запрос.УстановитьПараметр("НомерЗаявки", НомерАМО);
				УсловиеПоиска =  "Заявки.НомерЗаявки = &НомерЗаявки";
			ИначеЕсли ПустаяСтрока(request_id) = ЛОЖЬ Тогда
				Запрос.УстановитьПараметр("Номер", request_id);
				УсловиеПоиска =  "Заявки.Номер = &Номер"
			Иначе	
				Запрос.УстановитьПараметр("Страхователь", СтраховательНаименование);
				Запрос.УстановитьПараметр("Дата",         НачалоДня(Дата));
				УсловиеПоиска =  
				"Заявки.Страхователь.Наименование = &Страхователь
				| и (НачалоПериода(Заявки.ДатаСоздания,ДЕНЬ) = &Дата или НачалоПериода(Заявки.Дата,ДЕНЬ) = &Дата)";
			КонецЕсли;
			
			Запрос.Текст = СТрЗаменить(Запрос.Текст,"1 = 1",УсловиеПоиска);
			
			Если ТипЗНч(Данные.params.man_id) = Тип("Число") Тогда
				man_id =  Формат(Данные.params.man_id,"ЧГ=");
			Иначе
				man_id =  Строка(Данные.params.man_id);
			КонецЕсли;	
			Запрос.УстановитьПараметр("man_id", man_id);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОбъектЗаявка = Выборка.Ссылка.ПолучитьОбъект();			
			Иначе
				ОбъектЗаявка = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СоздатьДокумент();
				ОбъектЗаявка.Дата         = Дата;
				ОбъектЗаявка.ДатаСоздания = Дата;
			КонецЕсли;
			
			//МЕНЕДЖЕР
			ОбъектЗаявка.Менеджер = Справочники.ФизическиеЛица.НайтиПоРеквизиту("tg_id",man_id);
			Если ОбъектЗаявка.Менеджер.Пустая() Тогда
				Ошибка = Ошибка+"Не найден менеджер с id = "+man_id+Символы.ПС;				
			КонецЕсли;	
			
			//КУРЬЕР
			Если Данные.params.Свойство("tg_id") = ЛОЖЬ  Тогда
				tg_id = "";
			ИначеЕсли ТипЗНч(Данные.params.tg_id) = Тип("Число") Тогда
				tg_id =  Формат(Данные.params.tg_id,"ЧГ=");
			Иначе
				tg_id =  Строка(Данные.params.tg_id);
			КонецЕсли;	
			Если НЕ tg_id = "" Тогда
				ОбъектЗаявка.Курьер = Справочники.ФизическиеЛица.НайтиПоРеквизиту("tg_id",tg_id);
				Если ОбъектЗаявка.Курьер.Пустая() Тогда
					Ошибка = Ошибка+"Не найден курьер с id ="+tg_id+Символы.ПС;				
				КонецЕсли;	
			КонецЕсли;	
			
			//СТРАХОВАТЕЛЬ
			СсылкаСтрахователь = "";
			ОтветНаСтрахователь(Страхователь,СсылкаСтрахователь);
			Если ЗначениеЗаполнено(СсылкаСтрахователь) Тогда
				ОбъектЗаявка.Страхователь = СсылкаСтрахователь;
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(ОбъектЗаявка.Страхователь) Тогда
				Ошибка = Ошибка+"Не найден страхователь"+Символы.ПС;				
			КонецЕсли;	
			//
			Если ОбъектЗаявка.ВремяНачало = Дата(1,1,1) Тогда
				Если Данные.params.Свойство("ВремяНачало") Тогда
					ВремяНачало = ДатаИзСтроки(Данные.params.ВремяНачало);
				Иначе
					ВремяНачало = КонецДня(Дата)+8*3600;
				КонецЕсли;	
				ОбъектЗаявка.ВремяНачало = ВремяНачало;
			КонецЕсли;	
			//
			Если ОбъектЗаявка.ВремяОкончания = Дата(1,1,1) Тогда
				Если Данные.params.Свойство("ВремяОкончания") Тогда
					ВремяОкончания = ДатаИзСтроки(Данные.params.ВремяОкончания);
				Иначе
					ВремяОкончания = ВремяНачало+2*3600;
				КонецЕсли;	
				ОбъектЗаявка.ВремяОкончания = ВремяОкончания;
			КонецЕсли;	
			//
			Если Данные.params.Свойство("Адрес") Тогда
				Адрес = Данные.params.Адрес;
				ОбъектЗаявка.Адрес = Адрес;
			Иначе
				Адрес = "Офис";
			КонецЕсли;	
			
			//
			Если Данные.params.Свойство("Комментарий") Тогда
				Комментарий = Данные.params.Комментарий;
				ОбъектЗаявка.Комментарий = Комментарий;
			Иначе
				Комментарий = "";
			КонецЕсли;	
			
			//
			Если Данные.params.Свойство("СтанцияМетро") Тогда
				СтанцияМетроСтрока = Данные.params.СтанцияМетро;
			ИначеЕсли ЗначениеЗаполнено(ОбъектЗаявка.СтанцияМетро) Тогда
				СтанцияМетроСтрока = Строка(ОбъектЗаявка.СтанцияМетро);	
			Иначе
				СтанцияМетроСтрока = "Дмитровская";
			КонецЕсли;	
			СтанцияМетро = Справочники.уб_СтанцииМетро.НайтиПоНаименованию(СтанцияМетроСтрока);
			ОбъектЗаявка.СтанцияМетро = СтанцияМетро;
			
			//
			
			Если ЗначениеЗаполнено(ОбъектЗаявка.НомерЗаявки) Тогда
				НомерАМО = ОбъектЗаявка.НомерЗаявки;
			КонецЕсли;
			ОбъектЗаявка.НомерЗаявки = НомерАМО;
			//
			Если Данные.params.Свойство("НеобходимостьОсмотра") Тогда
				НеобходимостьОсмотра = Данные.params.НеобходимостьОсмотра;
				НеобходимостьОсмотра = НайтиПеречислениеПоСинонимуИлиИмени("НеобходимостьОсмотра",НеобходимостьОсмотра);
			Иначе
				НеобходимостьОсмотра = Перечисления.НеобходимостьОсмотра.БезОсмотра;
			КонецЕсли;	
			ОбъектЗаявка.НеобходимостьОсмотра = НеобходимостьОсмотра;
			//
			
			Если Данные.params.Свойство("ТипСтраховки") Тогда
				ТипСтраховки = Данные.params.ТипСтраховки;
				ТипСтраховки = НайтиПеречислениеПоСинонимуИлиИмени("уб_ТипВыезда",ТипСтраховки);
			Иначе
				ТипСтраховки = Перечисления.уб_ТипВыезда.Страховка;
			КонецЕсли;	
			ОбъектЗаявка.Тип = ТипСтраховки;
			//
			Если Данные.params.Свойство("НеобходимостьДоставки") Тогда
				НеобходимостьДоставки = Данные.params.НеобходимостьДоставки;
				Если НеобходимостьДоставки = "Без доставки" Тогда
					ТипВыезда = 1;
				Иначе
					ТипВыезда = 0;
				КонецЕсли;	
			Иначе
				ТипВыезда = 1;
			КонецЕсли;	
			ОбъектЗаявка.ТипВыезда = ТипВыезда;
			
			//
			Если Данные.params.Свойство("Источник") Тогда
				Источник = Данные.params.Источник;
				СсылкаИсточник = Справочники.ИсточникиЗаявок.НайтиПоНаименованию(Лев(Источник,25),Истина);
				Если СсылкаИсточник.Пустая() Тогда
					ОбъектИсточник = Справочники.ИсточникиЗаявок.СоздатьЭлемент();
					ОбъектИсточник.Наименование = Источник;
					ОбъектИсточник.Записать();
					СсылкаИсточник = ОбъектИсточник.Ссылка;
				КонецЕсли;	
				ОбъектЗаявка.Источник = СсылкаИсточник;
			КонецЕсли;	
			
			//
			Если Данные.params.Свойство("КонтактноеЛицо") Тогда
				КонтактноеЛицо = Данные.params.КонтактноеЛицо;
				ОбъектЗаявка.КонтактноеЛицо = КонтактноеЛицо;
			КонецЕсли;	
			
			//
			Если Данные.params.Свойство("КонтактноеЛицоТелефон") Тогда
				КонтактноеЛицоТелефон = Данные.params.КонтактноеЛицоТелефон;
				ОбъектЗаявка.Контакты = КонтактноеЛицоТелефон;
			КонецЕсли;	
			
			//
			Если Данные.params.Свойство("КонтактноеЛицоemail") Тогда
				email = Данные.params.КонтактноеЛицоemail;
				ОбъектЗаявка.email = email;
			КонецЕсли;	
			
			Если Данные.params.Свойство("БСО") Тогда
				СтарыеСтроки = 	ОбъектЗаявка.БСО.Выгрузить();
				ОбъектЗаявка.БСО.Очистить();
				Для каждого СтрокаБСО из Данные.params.БСО Цикл
					СтрокаНайдена = Ложь;
					Если СтрокаБСО.Свойство("УидСтроки") Тогда
						
						Для каждого СтараяСтрока из СтарыеСтроки Цикл
							Если Нрег(СтараяСтрока.УидСтроки) = Нрег(СтрокаБСО.УидСтроки) Тогда
								СтрокаНайдена = Истина;
								Прервать;
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;	
					Если СтрокаНайдена = Ложь Тогда
						Для каждого СтараяСтрока из СтарыеСтроки Цикл
							Если Нрег(СтараяСтрока.ВидБСО) = Нрег(СтрокаБСО.Вид)
								и СтараяСтрока.СтраховаяПремия = Число(СтрокаБСО.Премия)
								Тогда
								СтрокаНайдена = Истина;
								Прервать;
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;	
					
					НоваяСтрока = ОбъектЗаявка.БСО.Добавить();
					Если СтрокаНайдена = Истина Тогда
						ЗаполнитьЗначенияСвойств(НоваяСтрока,СтараяСтрока);
						СтарыеСтроки.Удалить(СтараяСтрока);
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("Вид") Тогда
						Вид = СтрокаБСО.Вид;
						Вид = НайтиПеречислениеПоСинонимуИлиИмени("уб_ВидыСтраховыхПродуктов",Вид);
						НоваяСтрока.ВидБСО = Вид;
						Если Найти(нрег(СтрокаБСО.Вид), "осаго")>0 тогда
							НоваяСтрока.ЛимитОтветственности = 400000;
						КонецЕсли;	
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("СтраховаяКомпания") Тогда
						НоваяСтрока.СК = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаБСО.СтраховаяКомпания,Истина);
					КонецЕсли;	
					Если ЗначениеЗаполнено(НоваяСтрока.Поставщик) = ЛОЖЬ Тогда
						НоваяСтрока.Поставщик = НоваяСтрока.СК;
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("Премия") Тогда
						НоваяСтрока.СтраховаяПремия = Число(СтрокаБСО.Премия);   
						НоваяСтрока.СуммаВзноса      = НоваяСтрока.СтраховаяПремия;
						НоваяСтрока.ИтогСуммаВзноса     = НоваяСтрока.СтраховаяПремия;  
						НоваяСтрока.ИтогСтраховаяПремия = НоваяСтрока.СтраховаяПремия;
						НоваяСтрока.Количество = 1;
					КонецЕсли;	
					
					Если НоваяСтрока.ДатаОформления = Дата(1,1,1) Тогда
						НоваяСтрока.ДатаОформления  = ОбъектЗаявка.Дата;
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("СтраховаяСумма") Тогда
						НоваяСтрока.ЛимитОтветственности = Число(СтрокаБСО.СтраховаяСумма);
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("КВ") Тогда
						НоваяСтрока.КВБрокераПлан = Число(СтрокаБСО.КВ);
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("ВидОплаты") Тогда
						ВидОплаты = СтрокаБСО.ВидОплаты;
						НоваяСтрока.ФормаОплатыСтрока = НайтиПеречислениеПоСинонимуИлиИмени("уб_ФормыОплаты",ВидОплаты);						 
					КонецЕсли;	
					//
					Если ЗначениеЗаполнено(НоваяСтрока.ДатаНачала) = ЛОЖЬ и СтрокаБСО.Свойство("ДатаНачала") Тогда
						НоваяСтрока.ДатаНачала = ДатаИзСтроки(СтрокаБСО.ДатаНачала);
					КонецЕсли;	
					//
					Если ЗначениеЗаполнено(НоваяСтрока.ДатаОкончания) = ЛОЖЬ и СтрокаБСО.Свойство("ДатаОкончания") Тогда
						НоваяСтрока.ДатаОкончания = ДатаИзСтроки(СтрокаБСО.ДатаОкончания);
					КонецЕсли;	
					
					Если СтрокаБСО.Свойство("Автомобиль") Тогда
						ОбъектСтрахования = Неопределено;
						Vin = "";
						
						Марка = Справочники.уб_МаркиТС.ПустаяСсылка();
						Модель = Справочники.уб_МоделиТС.ПустаяСсылка();
						
						Ответ = ОтветНаАвтомобиль(СтрокаБСО.Автомобиль,ОбъектСтрахования,Vin,Марка,Модель);	
						Если ЗначениеЗаполнено(ОбъектСтрахования) Тогда
							НоваяСтрока.ОбъектСтрахования = ОбъектСтрахования;
							Если ЗначениеЗаполнено(Марка) Тогда
								НоваяСтрока.МаркаТС = Марка;
							КонецЕсли;	
							Если ЗначениеЗаполнено(Модель) Тогда
								НоваяСтрока.МодельТС = Модель;
							КонецЕсли;	
							
						КонецЕсли;	
						Если Не ПустаяСтрока(Vin) Тогда
							НоваяСтрока.Vin = Vin;
						КонецЕсли;	
					КонецЕсли;	
					
					
					
					Если ПустаяСтрока(НоваяСтрока.УидСтроки) = Истина Тогда
						Если СтрокаБСО.Свойство("УидСтроки") Тогда
							НоваяСтрока.УидСтроки = СтрокаБСО.УидСтроки;
						КонецЕсли;	
						Если ПустаяСтрока(НоваяСтрока.УидСтроки) = Истина Тогда
							НоваяСтрока.УидСтроки = Строка(Новый УникальныйИдентификатор);
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
			
			
			ОбъектЗаявка.Записать();
			Ответ = Новый Структура;
			Ответ.Вставить("ref",Префикс()+ПолучитьНавигационнуюСсылку(ОбъектЗаявка.Ссылка));
			Ответ.Вставить("error",Ошибка);
			Ответ.Вставить("Номер",ОбъектЗаявка.Номер);
			Возврат Ответ(200,уб_СЕРВЕРные.JSON(Ответ));
			
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции	


Функция ОтветНаdelete(Данные)
	Структура = Новый Структура;
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("request_id") Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Страхователь.Наименование КАК Страхователь,
				               |	ПРЕДСТАВЛЕНИЕ(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус) КАК Статус,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.Наименование КАК userid,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.tg_id КАК tg_id,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВремяВстречиКлиент как ВремяВстречи,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Оператор,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия - уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка КАК Премия,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Адрес,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО.(
				               |		ВидБСО,
				               |		ИтогСтраховаяПремия,
				               |		ИтогПредоставленнаяСкидка,
				               |		ДатаНачала,
				               |		ДатаОкончания,
				               |		УидСтроки
				               |	),
				               |	Список.УидСтроки,
				               |	Список.СсылкаСправочника,
				               |	уб_ФайлыКПолисам.ВидДокумента
				               |ИЗ
				               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
				               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
				               |		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК Список
				               |		ПО (Список.Ссылка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
				               |		ПО (уб_ФайлыКПолисам.УИД = Список.СсылкаСправочника)
				               |			И (Список.Ссылка = уб_ФайлыКПолисам.СтраховойПолис)
				               |			И (уб_ФайлыКПолисам.ВидДокумента = &ВидДокумента)
				               |ГДЕ
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &Номер";
				Запрос.УстановитьПараметр("Номер", Данные.params.request_id);
				
				
				Если Данные.params.Свойство("doc_type") Тогда
					doc_type = Данные.params.doc_type;
					ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
					Если ВидДокумента.Пустая() Тогда
						doc_type = 74;
						ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
					КонецЕсли;	
				Иначе	
					doc_type = 74;
					ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
				КонецЕсли;	
				Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
				
				ДокументОбъект =  Неопределено;
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Если ДокументОбъект = Неопределено Тогда
						ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
					КонецЕсли; 
					
					 ЕстьИзменения = УдалитьСтрокуФайла(ДокументОбъект,Выборка) или УдалитьСтрокуФайла(ДокументОбъект,Выборка);
					 
				 КонецЦикла;
				Если ЕстьИзменения = Истина Тогда 
					ДокументОбъект.Записать();
				КонецЕсли;	
				
				Если Выборка.Количество() = 0 Тогда
					Ответ = Ответ(404,"Не найдены файлы в заявке с видом "+doc_type);
					Возврат Ответ
				Иначе
					Возврат Ответ(200,уб_СЕРВЕРные.JSON(Структура));
				КонецЕсли;	
			Иначе
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции




Функция ОтветНаdownload(Данные)
	Структура = Новый Структура;
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("request_id") Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата КАК Дата,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Страхователь.Наименование КАК Страхователь,
				               |	ПРЕДСТАВЛЕНИЕ(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус) КАК Статус,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.Наименование КАК userid,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.tg_id КАК tg_id,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВремяВстречиКлиент КАК ВремяВстречи,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Оператор,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия - уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка КАК Премия,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Адрес,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО.(
				               |		ВидБСО,
				               |		ИтогСтраховаяПремия,
				               |		ИтогПредоставленнаяСкидка,
				               |		ДатаНачала,
				               |		ДатаОкончания,
				               |		УидСтроки
				               |	),
				               |	Список.УидСтроки,
				               |	Список.СсылкаСправочника,
				               |	уб_ФайлыКПолисам.ВидДокумента,
				               |	уб_ФайлыКПолисам.ФайлРасширение,
				               |	уб_ФайлыКПолисам.ФайлИмя,
				               |	уб_ФайлыКПолисам.Хранилище.Путь,
				               |	уб_ФайлыКПолисам.ПутьКПапке
				               |ИЗ
				               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
				               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
				               |		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК Список
				               |		ПО (Список.Ссылка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
				               |		ПО (уб_ФайлыКПолисам.УИД = Список.СсылкаСправочника)
				               |			И (Список.Ссылка = уб_ФайлыКПолисам.СтраховойПолис)
				               //|			И (уб_ФайлыКПолисам.ВидДокумента = &ВидДокумента)
				               |ГДЕ
				               |	уб_ФайлыКПолисам.ФайлРасширение ПОДОБНО &Расширение
				               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &Номер
				               |	И уб_ФайлыКПолисам.ДатаПубликации >= &ДатаПубликации";
				Запрос.УстановитьПараметр("Номер", Данные.params.request_id);
				Запрос.УстановитьПараметр("Расширение", "%PDF");
				Запрос.УстановитьПараметр("ДатаПубликации", ТекущаяДата()-31*24*3600);
				
				
				Если Данные.params.Свойство("doc_type") Тогда
					doc_type = Данные.params.doc_type;
					ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
					Если ВидДокумента.Пустая() Тогда
						doc_type = 60;
						ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
					КонецЕсли;	
				Иначе	
					doc_type = 60;
					ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(doc_type);
				КонецЕсли;	
				Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
				
				
				ИмяАрхивногоФайла = ПолучитьИмяВременногоФайла("zip");
				НомерЗаявки = Формат(Данные.params.request_id,"ЧГ=");
				ИмяАрхивногоФайла = СтрЗаменить(ИмяАрхивногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяАрхивногоФайла,"/"),НомерЗаявки+".zip");
				//КаталогВременныхФайлов = СтрЗаменить(ИмяВременнногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"/"),"");
				
				//уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"/")
				
				КаталогВременныхФайлов = КаталогВременныхФайлов();					 
				
				ЗаписьZIP = Новый ЗаписьZipФайла(ИмяАрхивногоФайла);


				Выборка = Запрос.Выполнить().Выбрать();
				ФайлыКУдалению = Новый Массив;
				счетчик = 0;
				
				Пока Выборка.Следующий() Цикл
					
					ИмяВХранилище = ""+Выборка.ХранилищеПуть+"\"+Выборка.ПутьКПапке+"\"+Выборка.ФайлИмя;
					ФайлХ = Новый Файл(ИмяВХранилище);
					Если ФайлХ.Существует() = Истина Тогда
						
						счетчик = счетчик+1;
						
						ИмяНовогоФайла = КаталогВременныхФайлов+""+НомерЗаявки+"_"+Счетчик+".pdf";
						Попытка
							КопироватьФайл(ИмяВХранилище,ИмяНовогоФайла);
							ФайлыКУдалению.Добавить(ИмяНовогоФайла);
						Исключение
							
						КонецПопытки;	
					Иначе
						Продолжить
					КонецЕсли;
					
					ЗаписьZIP.Добавить(ИмяНовогоФайла, РежимСохраненияПутейZIP.НеСохранятьПути);				
				КонецЦикла;
				
				
				Если счетчик = 0 Тогда
					Ответ = Ответ(404,"За последние 30 дней в заявке нет вложенных полисов");//Не найдены файлы в заявке с видом "+doc_type);
					Возврат Ответ
				Иначе
					ФайлыКУдалению.Добавить(ИмяАрхивногоФайла);
					ЗаписьZIP.Записать();
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.УстановитьИмяФайлаТела(ИмяАрхивногоФайла);				
					ЗаписьZIP = Неопределено;
					Для каждого ИмяФайла из ФайлыКУдалению Цикл
						Попытка
							УдалитьФайлы(ИмяФайла);
						Исключение
							Ошибка = ОписаниеОшибки();
						КонецПопытки;	
					КонецЦикла;	
					Возврат Ответ;
				КонецЕсли;	
			Иначе
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции






Функция ОтветНаdoc_type_list(Данные)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_ВидыДокументовКПолисам.Код,
