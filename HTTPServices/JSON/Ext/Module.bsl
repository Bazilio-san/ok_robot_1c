			               |	Контрагенты.Наименование подобно ""%"+Источник.Наименование+"""%
						   |	И НЕ Контрагенты.Ссылка В ИЕРАРХИИ (&Ссылка)
				           |	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
			КонецЕсли;	
			Запрос.УстановитьПараметр("Ссылка",Справочники.Контрагенты.НайтиПоКоду("000000005"));
			ЕстьПравки = Ложь;
			Выборка= Запрос.Выполнить().Выбрать();
			Обновлено  = 0;
			ЕстьСтрахователи = Ложь;
			Пока Выборка.Следующий() Цикл
				ЕстьСтрахователи = Истина;
				Если Ссылка = Неопределено Тогда
					Ссылка= Выборка.Ссылка;
				КонецЕсли;	
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если НЕ Объект.Наименование =  Источник.Наименование Тогда
					Объект.Наименование =  Источник.Наименование;
					ЕстьПравки = Истина;
				КонецЕсли;	
				Если ПустаяСтрока(ИНН) = ЛОЖЬ и  НЕ Объект.ИНН =  ИНН Тогда
					Объект.ИНН =  ИНН;
					ЕстьПравки = Истина;
				КонецЕсли;	
				
				Если Источник.Свойство("КПП") и ПустаяСтрока(Источник.КПП) = ЛОЖЬ и  НЕ Объект.КПП =  Источник.КПП Тогда
					Объект.КПП =  Источник.КПП;
					ЕстьПравки = Истина;
				КонецЕсли;	

				
				Если ЕстьПравки = Истина Тогда
					Обновлено = Обновлено+1;
					Объект.Записать();
				КонецЕсли;	
			КонецЦикла;	
			Если ЕстьСтрахователи = Ложь Тогда
				Объект = Справочники.Контрагенты.СоздатьЭлемент();
				
				Если Источник.Свойство("Наименование") и ПустаяСтрока(Источник.Наименование) = ЛОЖЬ и  НЕ Объект.Наименование =  Источник.Наименование Тогда
					Объект.Наименование =  Источник.Наименование;
					Объект.НаименованиеПолное  = Источник.Наименование;
					Объект.НаименованиеКраткое = Источник.Наименование;
				КонецЕсли;	
				Если ЛЕв(Объект.Наименование,2) = "ИП" или Найти(Объект.Наименование,"ндивидуальный") = 2 Тогда
					Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
				Иначе	
					Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
				КонецЕсли;	
				Если Источник.Свойство("ИНН") и ПустаяСтрока(Источник.ИНН) = ЛОЖЬ и  НЕ Объект.ИНН =  Источник.ИНН Тогда
					Объект.ИНН =  Источник.ИНН;
				КонецЕсли;	
				Если Источник.Свойство("КПП") и ПустаяСтрока(Источник.КПП) = ЛОЖЬ и  НЕ Объект.КПП =  Источник.КПП Тогда
					Объект.КПП =  Источник.КПП;
				КонецЕсли;
				Попытка 
					Объект.Записать();
					Ссылка = Объект.Ссылка;
				Исключение
				КонецПопытки;	
				
				Ответ = Ответ(200,"Создан страхователь "+Источник.Наименование);
				Возврат Ответ
			КонецЕсли;	
			Если Обновлено >0 Тогда
				Ответ = Ответ(200,"Обновлено "+Обновлено);
			ИначеЕсли  ЕстьСтрахователи =Истина Тогда
				Ответ = Ответ(200,"Нечего обновлять. Найден "+Выборка.Количество());
			Иначе
				Ответ = Ответ(200,"Не найдены страхователи ");
			КонецЕсли;	
		Иначе	
			Ответ = Ответ(406,"Отсутствуют обязательные поля поиска страхователя");
		КонецЕсли;
	Иначе
		Ответ = Ответ(406,"Некорректные параметры ");
	КонецЕсли;	
	
	Возврат Ответ
КонецФункции

Функция СрезПаспорта(Физлицо)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПаспортныеДанныеФизЛицСрезПоследних.Период КАК Период,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо КАК ФизЛицо,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ДокументВид,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства
	               |ИЗ
	               |	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ПаспортныеДанныеФизЛицСрезПоследних";
	Запрос.УстановитьПараметр("ФизЛицо",ФизЛицо);
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции	

