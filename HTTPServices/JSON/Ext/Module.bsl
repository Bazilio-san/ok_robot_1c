Функция ОтветНаАвтомобиль(Данные,СсылкаОбъект = Неопределено,VIN = "",СпрМарка = "",СпрМодель="")
	//
	//{"apikey":"fce6566b-7754-4764-ade3-ac4fdff9e226","command":"Автомобиль","params":{"VIN":"XW8ZZZ5NZDG103171", "ГосНомер" :"0350ОСВ22","Марка":"Жигули", "Модель" :"Тигуан" , "ГодВыпуска" :"2012" , "Мощность" :"170"}}
	VIN     = "";
	
	
	Если Данные.Свойство("params") Тогда
		Источник = Данные.params;
	Иначе
		Источник = Данные;
	КонецЕсли;	
	
		Если ТипЗнч(Источник) = Тип("Структура") Тогда
			Если Источник.Свойство("VIN") Тогда
				VIN = СокрЛП(Источник.VIN);
			Иначе
				Ответ = Ответ(406,"Отсутствует VIN");
				Возврат Ответ 		
			КонецЕсли;
			Если Источник.Свойство("Марка") Тогда
				Марка = СокрЛП(Источник.Марка);
			КонецЕсли;
			Если Источник.Свойство("Модель") Тогда
				Модель = СокрЛП(Источник.Модель);
			КонецЕсли;	
			
			Если Источник.Свойство("ГосНомер") Тогда
				ГосНомер = СокрЛП(Источник.ГосНомер);
			КонецЕсли;	
			
			Если Источник.Свойство("Мощность") Тогда
				Мощность = СокрЛП(Источник.Мощность);
			КонецЕсли;	
			
			Если Источник.Свойство("ГодВыпуска") Тогда
				ГодВыпуска = СокрЛП(Источник.ГодВыпуска);
			КонецЕсли;	
			Если ПустаяСтрока(VIN) Тогда
				Ответ = Ответ(406,"Пустой VIN");
				Возврат Ответ 		
			КонецЕсли;	
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	уб_ТранспортныеСредства.Объект КАК Объект,
			               |	уб_ТранспортныеСредства.РегистрационныйЗнак КАК РегистрационныйЗнак,
			               |	уб_ТранспортныеСредства.ИдентификационныйНомер КАК ИдентификационныйНомер,
			               |	уб_ТранспортныеСредства.МаркаТС КАК МаркаТС,
			               |	уб_ТранспортныеСредства.МодельТС КАК МодельТС,
			               |	уб_ТранспортныеСредства.ТипТС КАК ТипТС,
			               |	уб_ТранспортныеСредства.Категория КАК Категория,
			               |	уб_ТранспортныеСредства.ГодВыпуска КАК ГодВыпуска,
			               |	уб_ТранспортныеСредства.ДвигательНомер КАК ДвигательНомер,
			               |	уб_ТранспортныеСредства.ШассиНомер КАК ШассиНомер,
			               |	уб_ТранспортныеСредства.КузовНомер КАК КузовНомер,
			               |	уб_ТранспортныеСредства.Цвет КАК Цвет,
			               |	уб_ТранспортныеСредства.МощностьДвигателя КАК МощностьДвигателя,
			               |	уб_ТранспортныеСредства.МаксМасса КАК МаксМасса,
			               |	уб_ТранспортныеСредства.КолПассажирскихМест КАК КолПассажирскихМест,
			               |	уб_ТранспортныеСредства.Грузоподъемность КАК Грузоподъемность,
			               |	уб_ТранспортныеСредства.ПротивоугоннаяСистема КАК ПротивоугоннаяСистема,
			               |	уб_ТранспортныеСредства.ПаспортСерия КАК ПаспортСерия,
			               |	уб_ТранспортныеСредства.ПаспортНомер КАК ПаспортНомер,
			               |	уб_ТранспортныеСредства.ПаспортДатаВыдачи КАК ПаспортДатаВыдачи
			               |ИЗ
			               |	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
			               |ГДЕ
			               |	уб_ТранспортныеСредства.ИдентификационныйНомер ПОДОБНО &vin";
			Запрос.УстановитьПараметр("VIN",VIN);
			СтрокаОбновления = "";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				МЗ = РегистрыСведений.уб_ТранспортныеСредства.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ,Выборка);
				
				
				
				НеобходимоОбновитьНаименование = Ложь;
				Если ПустаяСтрока(Марка) Тогда
					СтрокаОбновления = СтрокаОбновления
					+"Пустая марка"
					+Символы.ПС;
				Иначе
					СпрМарка = Справочники.уб_МаркиТС.НайтиПоНаименованию(Марка);
					
					Если СпрМарка.Пустая() Тогда
						СтрокаОбновления = СтрокаОбновления
						+"Не найдена марка"
						+Символы.ПС;
					Иначе
						СтрокаОбновления = СтрокаОбновления
						+"Обновлена марка"
						+Символы.ПС;

						МЗ.МаркаТС = СпрМарка;
						НеобходимоОбновитьНаименование = Истина;
					КонецЕсли;	
					
				КонецЕсли;
				
				Если ПустаяСтрока(Модель) Тогда
					СтрокаОбновления = СтрокаОбновления
					+"Пустая модель"
					+Символы.ПС;
				Иначе
					СпрМодель = Справочники.уб_МоделиТС.НайтиПоНаименованию(Модель);
					
					Если СпрМодель.Пустая() Тогда
						СтрокаОбновления = СтрокаОбновления
						+"Не найдена модель"
						+Символы.ПС;
					Иначе
						Мз.МодельТС = СпрМодель;
						НеобходимоОбновитьНаименование = Истина;
						СтрокаОбновления = СтрокаОбновления
						+"Обновлена модель"
						+Символы.ПС;

					КонецЕсли;	
					
				КонецЕсли;	
				Если ЗначениеЗаполнено(ГодВыпуска) и не Мз.ГодВыпуска = ГодВыпуска Тогда
					СтрокаОбновления = СтрокаОбновления
						+"Обновлен год " +Мз.ГодВыпуска +"=>"+ГодВыпуска
						+Символы.ПС;

					Мз.ГодВыпуска = ГодВыпуска;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(Мощность) и не Мз.МощностьДвигателя = Мощность Тогда
					СтрокаОбновления = СтрокаОбновления
						+"Обновлена мощность " +Мз.МощностьДвигателя +"=>"+Мощность
						+Символы.ПС;

					Мз.МощностьДвигателя = Мощность;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(Госномер) и не Мз.РегистрационныйЗнак = Госномер Тогда
					СтрокаОбновления = СтрокаОбновления
						+"Обновлен госномер " +Мз.РегистрационныйЗнак +"=>"+Госномер
						+Символы.ПС;

					Мз.РегистрационныйЗнак = Госномер;
				КонецЕсли;	
				
				Если не пустаяСтрока(СтрокаОбновления) Тогда
					Мз.Записать();
				КонецЕсли;	
				Ответ = Ответ(200,"Найден "+vin+" обновлено: "+СтрокаОбновления);	
				Если НеобходимоОбновитьНаименование = Истина Тогда
					ОбъектСтрахования = Выборка.объект.ПолучитьОбъект();
					ОбъектСтрахования.Тип = Справочники.уб_ТипыОбъектовСтрахования.НайтиПоНаименованию("Автомобиль");
					ОбъектСтрахования.Наименование = Марка+" "+Модель;
					ОбъектСтрахования.Записать();
					СсылкаОбъект = Выборка.объект;
				Иначе
					СсылкаОбъект = Выборка.Объект;
				КонецЕсли;	
			КонецЦикла;
			Если Выборка.Количество() = 0 Тогда
				//Ответ = Ответ(200,"Не найден "+vin);	
				СпрМарка = Справочники.уб_МаркиТС.НайтиПоНаименованию(Марка);
				СпрМодель = Справочники.уб_МоделиТС.НайтиПоНаименованию(Модель);
				
				ОбъектСтрахования = СПравочники.уб_ОбъектыСтрахования.СоздатьЭлемент();
				ОбъектСтрахования.Наименование = ""+СпрМарка+" "+СпрМодель;
				ОбъектСтрахования.Тип = Справочники.уб_ТипыОбъектовСтрахования.НайтиПоНаименованию("Автомобиль");
				ОбъектСтрахования.Записать();
				СсылкаОбъект = ОбъектСтрахования.Ссылка;
				МЗ = РегистрыСведений.уб_ТранспортныеСредства.СоздатьМенеджерЗаписи();     
				МЗ.Объект = ОбъектСтрахования.Ссылка;
				Мз.ИдентификационныйНомер = VIN;
				Мз.РегистрационныйЗнак = Госномер;
				МЗ.МаркаТС = СпрМарка;
				
				Мз.МодельТС = СпрМодель;
				
				Мз.МощностьДвигателя = Мощность;
				Мз.РегистрационныйЗнак = Госномер;
				Мз.ГодВыпуска = ГодВыпуска;
				Мз.Записать();
				Ответ = Ответ(200,"Создан "+vin);	
			КонецЕсли;	
			
		Иначе
			Ответ = Ответ(406,"Некорректные параметры ");
		КонецЕсли;	
	
Возврат Ответ
КонецФункции

