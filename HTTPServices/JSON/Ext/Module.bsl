Функция ОтветНаupload(Данные)
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("request_id") Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Страхователь.Наименование КАК Страхователь,
				               |	ПРЕДСТАВЛЕНИЕ(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус) КАК Статус,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.Наименование КАК userid,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.tg_id КАК tg_id,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВремяВстречиКлиент как ВремяВстречи,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
							    |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер.tg_id КАК man_id,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Оператор,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия - уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка КАК Премия,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Адрес,
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО.(
				               |		ВидБСО,
				               |		ИтогСтраховаяПремия,
				               |		ИтогПредоставленнаяСкидка,
				               |		ДатаНачала,
				               |		ДатаОкончания,
				               |		УидСтроки
				               |	)
				               |ИЗ
				               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
				               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
				               |		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				               |ГДЕ
				               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &Номер";
				Запрос.УстановитьПараметр("Номер", Данные.params.request_id);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
					Структура = Новый Структура;
										
					МассивБСО = Новый Массив;
					Если Данные.params.Свойство("file") Тогда
						
						ssl = Новый ЗащищенноеСоединениеOpenSSL;
						Соединение = Новый httpСоединение("kupipolis.ru",,,,,15,ssl);
						Адрес = СтрЗаменить(Данные.params.file,"https://kupipolis.ru/","");
						//http://work.kupipolis.ru:16789/IB83/hs/json/doc
						httpЗапрос = новый httpЗапрос(Адрес);
						//httpЗапрос.УстановитьТелоИзСтроки(Строка,КодировкаТекста.UTF8);
						//https://kupipolis.ru/upload/form/287953.jpg;
						ДлинаАдреса = СтрДлина(Адрес);
						Расширение = "jpg";
						Для Счетчик = 0 по ДлинаАдреса Цикл
							Если Сред(Адрес,ДлинаАдреса-Счетчик,1) = "." Тогда
								Расширение = Сред(Адрес,ДлинаАдреса-Счетчик+1);
								Прервать;
							КонецЕсли;	
						КонецЦикла;	
						
						ИмяВременнногоФайла = ПолучитьИмяВременногоФайла(Расширение);
						ИмяВременнногоФайла = СтрЗаменить(ИмяВременнногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"/"),уб_ВызовСервера.ИмяФайлаИзАдреса(Адрес,"/"));
						Попытка
							Ответ = Соединение.Получить(httpЗапрос,ИмяВременнногоФайла);
							Если Ответ.КодСостояния = 200 Тогда
								
							Иначе
								Ответ = Ответ(405,"Ошибка при скачивании файла "+Ответ.КодСостояния);
								Возврат Ответ
							КонецЕсли;	
						Исключение
							Ответ = Ответ(405,"Ошибка при скачивании файла "+ОписаниеОшибки());
							Возврат Ответ
						КонецПопытки;
						

					Иначе
						Ответ = Ответ(404,"Отсутствует ссылка на файл");
						Возврат Ответ
					КонецЕсли;	
					
					Если Данные.params.Свойство("УидСтроки") Тогда
						УидСтроки = Данные.params.УидСтроки;
					Иначе	
						Для каждого СтрокаБСО из Выборка.БСО.Выгрузить() Цикл
							УидСтроки = СтрокаБСО.УидСтроки;
							Прервать
						КонецЦикла;	
					КонецЕсли;
					
					Если Данные.params.Свойство("doc_type") Тогда
						ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(Данные.params.doc_type);
						Если ВидДокумента.Пустая() Тогда
							ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(74);
						КонецЕсли;	
					Иначе	
						ВидДокумента = Справочники.уб_ВидыДокументовКПолисам.НайтиПоКоду(74);
					КонецЕсли;	
					
					Попытка
						уб_ВызовСервера.ДобавитьФайлКЗаявке(ДокументОбъект,Новый Структура("УидСтроки,ПолноеИмяФайла,ВидДокумента",УидСтроки,ИмяВременнногоФайла,ВидДокумента));
						Ответ = Ответ(200,"Успешно добавлен к заявке "+ДокументОбъект.Номер);
						Возврат Ответ
					Исключение
						Возврат Ответ(500,ОписаниеОшибки());
					КонецПопытки;	
					УдалитьФайлы(ИмяВременнногоФайла);
					//Структура.Вставить("БСО",МассивБСО);
					
					Возврат Ответ(200,уб_СЕРВЕРные.JSON(Структура));
				Иначе
					Ответ = Ответ(404,"Не найдена заявка");
					Возврат Ответ
				КонецЕсли;	
			Иначе
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции



Функция ОтветНаpay_slip(Данные)
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("tg_id") Тогда
				
				Если ТипЗНч(Данные.params.tg_id) = Тип("Число") Тогда
					tg_id = Формат(Данные.params.tg_id,"ЧГ=");
				Иначе
					tg_id = Строка(Данные.params.tg_id);
				КонецЕсли;	
				
				ИмяВременнногоФайла = ПолучитьИмяВременногоФайла("pdf");
				ИмяВременнногоФайла = СтрЗаменить(ИмяВременнногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"\"),tg_id+".pdf");
				ФизЛицо = Справочники.ФизическиеЛица.НайтиПоРеквизиту("tg_id",tg_id);
				Если ФизЛицо.Пустая() Тогда
					Возврат Ответ(404,"Не найден сотрудник");
				КонецЕсли;	
				Сформирован = Обработки.уб_РасчетныеЛистки.СформироватьРасчетныйЛисток(ФизЛицо,ИмяВременнногоФайла,Истина);	
				Если Сформирован = Истина Тогда
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.УстановитьИмяФайлаТела(ИмяВременнногоФайла);				
				Иначе
					Ответ = Ответ(407,"Ошибка при формировании: "+Сформирован);
				КонецЕсли;	
				Возврат Ответ;
			Иначе
				Ответ = Ответ(407,"Отсутствует tg_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции


Функция ОтветНаFoto(Данные)
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("tg_id") Тогда
				
				Если ТипЗНч(Данные.params.tg_id) = Тип("Число") Тогда
					tg_id = Формат(Данные.params.tg_id,"ЧГ=");
				Иначе
					tg_id = Строка(Данные.params.tg_id);
				КонецЕсли;	
				
				
				ФизЛицо = Справочники.ФизическиеЛица.НайтиПоРеквизиту("tg_id",tg_id);
				Если ФизЛицо.Пустая() Тогда
					Возврат Ответ(404,"Не найден сотрудник");
				КонецЕсли;	
				
				ФизЛицоОбъект = ФизЛицо.ПолучитьОбъект();
				Фото = ФизЛицоОбъект.Фотография.Получить();
				Если Фото<>неопределено и  Фото.Количество() >0 Тогда
					ТекущееФото = Фото[0];
					ИмяВременнногоФайла = ПолучитьИмяВременногоФайла(ТекущееФото.Расширение);
					ИмяВременнногоФайла = СтрЗаменить(ИмяВременнногоФайла,уб_ВызовСервера.ИмяФайлаИзАдреса(ИмяВременнногоФайла,"\"),"foto_"+tg_id+"."+ТекущееФото.Расширение);
					ИмяВременнногоФайла = СтрЗаменить(ИмяВременнногоФайла,"..",".");
					
					ДД = Фото[0].Фото;
					ДД.Записать(ИмяВременнногоФайла);
					
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.УстановитьИмяФайлаТела(ИмяВременнногоФайла);				
				Иначе
					Ответ = Ответ(407,"Отсутствует фото");
				КонецЕсли;	
				Возврат Ответ;
			Иначе
				Ответ = Ответ(407,"Отсутствует tg_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
