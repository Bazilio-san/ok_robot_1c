				               |	ЕСТЬNULL(Сообщения.Получатель.ФизЛицо.Наименование, """") КАК ПолучательФизЛицоНаименование,
				               |	ЕСТЬNULL(Сообщения.Получатель.ФизЛицо.tg_id, """") КАК ПолучательФизЛицоtg_id,
				               |	ЕСТЬNULL(Сообщения.Сообщение, """") КАК Сообщение,
				               |	ЕСТЬNULL(Сообщения.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
				               |	ЕСТЬNULL(Сообщения.Руководителю, ЛОЖЬ) КАК Руководителю,
				               |	ЕСТЬNULL(Сообщения.SMS, ЛОЖЬ) КАК SMS,
				               |	ЕСТЬNULL(Сообщения.ИДСообщения, """") КАК УИД,
								|	ЕСТЬNULL(Сообщения.Заголовок,"""") КАК Заголовок
				               |ИЗ
				               |	ЗаявкиНомера КАК ЗаявкиНомера
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_Чат_Сообщения КАК Сообщения
				               |		ПО (""З-"" + ЗаявкиНомера.Номер = Сообщения.ИмяКанала)";
				Выборка     = Запрос.Выполнить();
				
				Если НЕ Выборка.Пустой() Тогда
					Сообщения = Сообщения(Выборка.Выгрузить());
					
					Возврат Ответ(200,уб_СЕРВЕРные.JSON(Сообщения));
				
				//	Структура.Вставить("БСО",МассивБСО);
					
					//Возврат Ответ(200,уб_СЕРВЕРные.JSON(Структура));
				Иначе
					Ответ = Ответ(404,"Не найдена заявка проверьте пользователя или номер");
					Возврат Ответ
				КонецЕсли;	
			Иначе
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
