Функция Сообщения(Таблица)
	Сообщения = Новый Массив;
	Для каждого Сообщение из Таблица Цикл
		
		//Структура.Вставить("Руководителю",Сообщение.Руководителю);
		//Структура.Вставить("SMS",Сообщение.SMS);
		Сообщения.Добавить(Сообщение(Сообщение,Сообщение.Ссылка));
	КонецЦикла;	
	Возврат Сообщения; 
КонецФункции	
Функция Сообщение(Сообщение,Ссылка)
	Структура = Новый Структура;
	
	
	Структура.Вставить("ref",Префикс()+ПолучитьНавигационнуюСсылку(Ссылка));
	Если ТипЗнч(Сообщение) = тип("РегистрСведенийМенеджерЗаписи.уб_Чат_Сообщения") Тогда
		Структура.Вставить("УИД",Сообщение.ИДСообщения);
		Структура.Вставить("Заявка",Формат(Ссылка.Номер,"ЧГ="));	
		Структура.Вставить("Отправитель",Новый Структура("Имя,tg_id",Сообщение.Отправитель.ФизЛицо.Наименование,Сообщение.Отправитель.ФизЛицо.tg_id));
		Структура.Вставить("Получатель",Новый Структура("Имя,tg_id",Сообщение.Получатель.ФизЛицо.Наименование,Сообщение.Получатель.ФизЛицо.tg_id));
	Иначе	
		Структура.Вставить("УИД",Сообщение.УИД);
		Структура.Вставить("Заявка",Формат(Сообщение.Номер,"ЧГ="));	
		Структура.Вставить("Отправитель",Новый Структура("Имя,tg_id",Сообщение.ОтправительФизЛицоНаименование,Сообщение.ОтправительФизЛицоtg_id));
		Структура.Вставить("Получатель",Новый Структура("Имя,tg_id",Сообщение.ПолучательФизЛицоНаименование,Сообщение.ПолучательФизЛицоtg_id));
	КонецЕсли;	
	Структура.Вставить("Сообщение",Сообщение.Сообщение);
	Структура.Вставить("Заголовок",Сообщение.Заголовок);
	Структура.Вставить("Дата",Сообщение.Период);
	Возврат Структура
КонецФункции	

Функция ПреобразоватьПаспорт(ПАСПОРТ)
	Серия = "";
	Номер = "";
	Длина = СтрДлина(ПАСПОРТ);
	Для счетчик = 1 по Длина Цикл
		
		Символ = Сред(Паспорт,Счетчик,1);
		Если Найти("0123456789",Символ) = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрДлина(Серия) = 4 Тогда
			Номер = Номер+Символ;
		Иначе
			Серия = Серия+Символ;
		КонецЕсли;	
		
	КонецЦикла;	
	Возврат Новый Структура("Серия,Номер",Серия,Номер);
	
КонецФункции	

Функция ОтветНаСообщение(Данные) 
	
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("Заявка") Тогда
				
				//Если ТипЗНч(Данные.params.tg_id) = Тип("Число") Тогда
				//	tg_id = Формат(Данные.params.tg_id,"ЧГ=");
				//Иначе
				//	tg_id =  Строка(Данные.params.tg_id);
				//КонецЕсли;	
				
				НовыйКанал = "З-"+Формат(Данные.params.Заявка,"ЧГ=");
				ЗаявкаСсылка = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.НайтиПоНомеру(Данные.params.Заявка);
				Если НЕ ЗаявкаСсылка.Пустая() Тогда
					МЗ = РегистрыСведений.уб_Чат_Сообщения.СоздатьМенеджерЗаписи(); 
					МЗ.Период      = ТекущаяДата();
					Мз.ИмяКанала   = НовыйКанал;
					Мз.Отправитель = НайтиПользователя(Данные.params.Отправитель);
					Если Мз.Отправитель.Пустая() Тогда
						Ответ = Ответ(404,"Не найден отправитель");
						Возврат Ответ
					КонецЕсли;	
					Мз.Получатель  = НайтиПользователя(Данные.params.Получатель);
					Если Мз.Получатель.Пустая() Тогда
						Ответ = Ответ(404,"Не найден Получатель");
						Возврат Ответ
					КонецЕсли;	
					Если Данные.params.Свойство("УИД") Тогда
						МЗ.ИДСообщения = Новый УникальныйИдентификатор(Данные.params.УИД);
					Иначе
						МЗ.ИДСообщения = Новый УникальныйИдентификатор;
					КонецЕсли;	
					ОбработатьПериодСообщения(МЗ);
					
					Мз.Заголовок  = "Заявка "+Формат(Данные.params.Заявка,"ЧГ=")+", страхователь: "+ЗаявкаСсылка.Страхователь;					
					Мз.Сообщение = Данные.params.Сообщение;
					Мз.Записать();
					Сообщение = Сообщение(Мз,ЗаявкаСсылка);
					Если ЗначениеЗаполнено(Сообщение.Получатель.tg_id) Тогда
						СообщениеСтрокой = уб_СЕРВЕРные.JSON(Сообщение);
					КонецЕсли;	
					
					//https://kupipolis.ru/webhook.php?chat_push=true
					ssl = Новый ЗащищенноеСоединениеOpenSSL;
					Соединение = Новый httpСоединение("kupipolis.ru",,,,,,ssl);
					httpЗапрос = новый httpЗапрос("webhook.php?chat_push=true");
					httpЗапрос.УстановитьТелоИзСтроки(СообщениеСтрокой,КодировкаТекста.UTF8);
					
					
					Попытка
						Ответ = Соединение.ОтправитьДляОбработки(httpЗапрос);
						Сообщить(Ответ.ПолучитьТелоКакСтроку());
						Возврат Ответ(200,"Записано.Отправка боту: "+Ответ.ПолучитьТелоКакСтроку());
					Исключение
						Ответ = Ответ(500,"Записано.Отправка боту: "+ОписаниеОшибки());
					КонецПопытки;	
					
					Возврат Ответ(200,"");
				Иначе	
					Ответ = Ответ(404,"Не найдена заявка");
					Возврат Ответ
				КонецЕсли;
				
				Ответ = Ответ(407,"Отсутствует request_id");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
