Функция Ответ(КодОшибки,Строка= "")
	Ответ = Новый HTTPСервисОтвет(КодОшибки);
	Если Найти(Строка,"{") = Ложь Тогда
		СтрокаОтвет = уб_СЕРВЕРные.JSON(Новый Структура("error",Строка));
	Иначе
		СтрокаОтвет = Строка
	КонецЕсли;	
	Ответ.УстановитьТелоИзСтроки(СтрокаОтвет,"UTF-8");
	Возврат Ответ
КонецФункции	

Функция ОтветНаcheck(Данные)
	Если Данные.Свойство("params") Тогда
		Если ТипЗнч(Данные.params) = Тип("Структура") Тогда
			Если Данные.params.Свойство("taskid") Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Страхователь.Наименование как  Страхователь,
				|	ПРЕДСТАВЛЕНИЕ(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус) КАК Статус,
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.Наименование как userid,
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.tg_id как tg_id
				|ИЗ
				|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
				|		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				|ГДЕ
				|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &Номер";
				Запрос.УстановитьПараметр("Номер", Данные.params.taskid);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Структура = Новый Структура;
					Структура.Вставить("Номер",Выборка.Номер);
					Структура.Вставить("Дата",Выборка.Дата);
					Структура.Вставить("Страхователь",Выборка.Страхователь);
					Структура.Вставить("Статус",Выборка.Статус);
					Структура.Вставить("userid",Выборка.userid);
					Структура.Вставить("tg_id",Выборка.tg_id);
					
					Возврат Ответ(200,уб_СЕРВЕРные.JSON(Структура));
				Иначе
					Ответ = Ответ(404,"Не найдена заявка");
					Возврат Ответ
				КонецЕсли;	
			Иначе
				Ответ = Ответ(407,"Отсутствует taskid");
				Возврат Ответ
			КонецЕсли;
		Иначе	
			Ответ = Ответ(407,"Параметры имеют неизвестный формат");
			Возврат Ответ	
		КонецЕсли;	
	Иначе
		Ответ = Ответ(406,"Отсутствуют параметры");
		Возврат Ответ 	
	КонецЕсли;	
	
КонецФункции


