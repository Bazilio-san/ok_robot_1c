Функция docpost(Запрос)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());          //Входящий запрос JSON  
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ОтветНазапрос = "";
	ГотовыйОтвет = "";
	ГотовыйJSONpost(Данные, ГотовыйОтвет ,ОтветНазапрос);
	
	Возврат  ГотовыйОтвет;
	
КонецФункции


