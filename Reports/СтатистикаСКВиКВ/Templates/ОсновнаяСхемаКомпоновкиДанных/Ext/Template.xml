		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Т.ЗППериод,
	Т.СКВ_аг_КАСКО_НеЛички + Т.СКВ_аг_ОСАГО_НеЛички
	+Т.ДБ_аг_КАСКО_НеЛички
	+Т.ДБ_аг_ОСАГО_НеЛички 
	КАК СКВ_Все_МОТОРы,
	Т.ДБ_аг_КАСКО_НеЛички,
	Т.ДБ_аг_ОСАГО_НеЛички,
	Т.ОСАГО_Лички,
	Т.ОСАГО_НеЛички,
	Т.КАСКО_Лички,
	Т.КАСКО_НеЛички,
	Т.ДМС_Лички,
	Т.ДМС_НеЛички,
	Т.ПРОЧЕЕ_Лички,
	Т.ПРОЧЕЕ_НеЛички,
	Т.Оплат_ВСЕГО,
	Т.Премия_ОСАГО_Лички,
	Т.Премия_ОСАГО_НеЛички,
	Т.Премия_КАСКО_Лички,
	Т.Премия_КАСКО_НеЛички,
	Т.Премия_ДМС_Лички,
	Т.Премия_ДМС_НеЛички,
	Т.Премия_ПРОЧЕЕ_Лички,
	Т.Премия_ПРОЧЕЕ_НеЛички,
	Т.НачисленнаяСуммаВзноса КАК Премия,
	Т.СКВ_аг_ОСАГО_Лички,
	Т.СКВ_аг_КАСКО_Лички,
	Т.СКВ_аг_ДМС_Лички,
	Т.СКВ_аг_ПРОЧЕЕ_Лички,
	Т.СКВ_аг_ОСАГО_НеЛички,
	Т.СКВ_аг_КАСКО_НеЛички,
	Т.СКВ_аг_ДМС_НеЛички,
	Т.СКВ_аг_ПРОЧЕЕ_НеЛички,
	Т.СКВ_по_КВ_Для_Агента,
	Т.СКВ_по_КВ_Для_Брокера,
	Т.Скидка_ОСАГО,
	ВЫБОР
		КОГДА Т.Премия_ОСАГО_НеЛички = 0
			ТОГДА 0
		ИНАЧЕ Т.Скидка_ОСАГО / Т.Премия_ОСАГО_НеЛички
	КОНЕЦ КАК Скидка_ОСАГО_процент,
	Т.Скидка_КАСКО,
	ВЫБОР
		КОГДА Т.Премия_КАСКО_НеЛички = 0
			ТОГДА 0
		ИНАЧЕ Т.Скидка_КАСКО / Т.Премия_КАСКО_НеЛички
	КОНЕЦ КАК Скидка_КАСКО_процент,
	Т.Скидка_ПРОЧЕЕ,
	ВЫБОР
		КОГДА Т.Премия_ПРОЧЕЕ_НеЛички = 0
			ТОГДА 0
		ИНАЧЕ Т.Скидка_ПРОЧЕЕ / Т.Премия_ПРОЧЕЕ_НеЛички
	КОНЕЦ КАК Скидка_ПРОЧЕЕ_процент,
	Т.Скидка,
	ВЫБОР
		КОГДА Т.Премия_ОСАГО_НеЛички + Т.Премия_КАСКО_НеЛички + Т.Премия_ПРОЧЕЕ_НеЛички = 0
			ТОГДА 0
		ИНАЧЕ Т.Скидка / (Т.Премия_ОСАГО_НеЛички + Т.Премия_КАСКО_НеЛички + Т.Премия_ПРОЧЕЕ_НеЛички)
	КОНЕЦ КАК Скидка_процент,
	Т.КВ_Вкл_в_ОП,
	Т.Премия_Вкл_в_ОП,
	ВЫБОР
		КОГДА Т.Премия_Вкл_в_ОП = 0
			ТОГДА 0
		ИНАЧЕ Т.КВ_Вкл_в_ОП / Т.Премия_Вкл_в_ОП
	КОНЕЦ КАК КВ_Проц_Вкл_в_ОП,
	ВЫБОР
		КОГДА Т.НачисленнаяСуммаВзноса_По_Моторам = 0
			ТОГДА 0
		ИНАЧЕ Т.КВ_для_Агента_По_Моторам / Т.НачисленнаяСуммаВзноса_По_Моторам
	КОНЕЦ КАК СрКВ_для_Агента_По_Моторам,
	ВЫБОР
		КОГДА Т.НачисленнаяСуммаВзноса_По_НЕ_Моторам = 0
			ТОГДА 0
		ИНАЧЕ Т.КВ_для_Агента_По_НЕ_Моторам / Т.НачисленнаяСуммаВзноса_По_НЕ_Моторам
	КОНЕЦ КАК СрКВ_для_Агента_По_НЕ_Моторам,
	ВЫБОР
		КОГДА Т.НачисленнаяСуммаВзноса = 0
			ТОГДА 0
		ИНАЧЕ Т.КВСуммаДляАгента / Т.НачисленнаяСуммаВзноса
	КОНЕЦ КАК СрКВ_для_Агента,
	ВЫБОР
		КОГДА Т.НачисленнаяСуммаВзноса = 0
			ТОГДА 0
		ИНАЧЕ Т.КВСумма / Т.НачисленнаяСуммаВзноса
	КОНЕЦ КАК СрКВ_для_Брокера,
	Т.СКВ_Не_вкл_в_ОП,
	Т.Скидка_Не_вкл_в_ОП	
ИЗ
	(ВЫБРАТЬ
		О.ЗППериод КАК ЗППериод,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ОСАГО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ОСАГО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК КАСКО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК КАСКО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ДМС_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И НЕ О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ДМС_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ПРОЧЕЕ_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И НЕ О.ЛИЧНАЯ
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ) КАК ПРОЧЕЕ_НеЛички,
		СУММА(О.Оплат) КАК Оплат_ВСЕГО,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ОСАГО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ОСАГО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_КАСКО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_КАСКО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ДМС_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ДМС_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ПРОЧЕЕ_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК Премия_ПРОЧЕЕ_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ОСАГО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_КАСКО_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ПРОЧЕЕ_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ДМС_Лички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ОСАГО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_КАСКО_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И О.Агентская
					ТОГДА О.ДБ
				ИНАЧЕ 0
			КОНЕЦ) КАК ДБ_аг_КАСКО_НеЛички,	
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И О.Агентская
					ТОГДА О.ДБ
				ИНАЧЕ 0
			КОНЕЦ) КАК ДБ_аг_ОСАГО_НеЛички,		
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ДМС"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ДМС_НеЛички,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_аг_ПРОЧЕЕ_НеЛички,
		СУММА(О.СКВ_по_КВ_Для_Агента) КАК СКВ_по_КВ_Для_Агента,
		СУММА(О.СКВ_по_КВ_Для_Брокера) КАК СКВ_по_КВ_Для_Брокера,
		СУММА(ВЫБОР
				КОГДА О.НеВключатьВОтчетыПоставщикам = ИСТИНА
					ТОГДА О.СКВ_по_КВ_Для_Агента
				ИНАЧЕ 0
			КОНЕЦ) КАК СКВ_Не_вкл_в_ОП,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ОСАГО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Скидка_ОСАГО,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "КАСКО"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Скидка_КАСКО,
		СУММА(ВЫБОР
				КОГДА О.ВидСп = "ПРОЧЕЕ"
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Скидка_ПРОЧЕЕ,
		СУММА(ВЫБОР
				КОГДА НЕ О.ЛИЧНАЯ
					ТОГДА О.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Скидка,
		СУММА(ВЫБОР
				КОГДА НЕ О.ЛИЧНАЯ
						И О.НеВключатьВОтчетыПоставщикам = ИСТИНА
					ТОГДА О.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Скидка_Не_вкл_в_ОП,
		СУММА(ВЫБОР
				КОГДА О.НеВключатьВОтчетыПоставщикам = ИСТИНА
					ТОГДА 0
				ИНАЧЕ О.КВСумма
			КОНЕЦ) КАК КВ_Вкл_в_ОП,
		СУММА(ВЫБОР
				КОГДА О.НеВключатьВОтчетыПоставщикам = ИСТИНА
					ТОГДА 0
				ИНАЧЕ О.НачисленнаяСуммаВзноса
			КОНЕЦ) КАК Премия_Вкл_в_ОП,
		СУММА(О.КВСуммаДляАгента) КАК КВСуммаДляАгента,
		СУММА(О.КВСумма) КАК КВСумма,
		СУММА(О.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
		СУММА(ВЫБОР
				КОГДА (О.ВидСп = "ОСАГО"
						ИЛИ О.ВидСп = "КАСКО")
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.КВСуммаДляАгента
				ИНАЧЕ 0
			КОНЕЦ) КАК КВ_для_Агента_По_Моторам,
		СУММА(ВЫБОР
				КОГДА (О.ВидСп = "ОСАГО"
						ИЛИ О.ВидСп = "КАСКО")
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК НачисленнаяСуммаВзноса_По_Моторам,
		СУММА(ВЫБОР
				КОГДА НЕ(О.ВидСп = "ОСАГО"
								ИЛИ О.ВидСп = "КАСКО")
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.КВСуммаДляАгента
				ИНАЧЕ 0
			КОНЕЦ) КАК КВ_для_Агента_По_НЕ_Моторам,
		СУММА(ВЫБОР
				КОГДА НЕ(О.ВидСп = "ОСАГО"
								ИЛИ О.ВидСп = "КАСКО")
						И НЕ О.ЛИЧНАЯ
					ТОГДА О.НачисленнаяСуммаВзноса
				ИНАЧЕ 0
			КОНЕЦ) КАК НачисленнаяСуммаВзноса_По_НЕ_Моторам
	ИЗ
		(ВЫБРАТЬ
			НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) КАК ЗППериод,
			ВЫБОР
				КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО)
				или ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕОСАГО)
					ТОГДА "ОСАГО"
				КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО)
				или ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕКАСКО)
					ТОГДА "КАСКО"
				КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ДМС)
					ТОГДА "ДМС"
				ИНАЧЕ "ПРОЧЕЕ"
			КОНЕЦ КАК ВидСп,
			ВЫБОР
				КОГДА ОП.СтраховойПолис.НомерЗаявки = ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная) или (Оп.ЗарплатныйПериод&gt;=ДатаВремя(2018,5,1) и Isnull(ОП.Подразделение.КОД,"321") В("000000017","000000037"))
					ТОГДА ИСТИНА
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ КАК ЛИЧНАЯ,
			ВЫБОР
				КОГДА Оп.ЗарплатныйПериод&gt;=ДатаВремя(2018,5,1) и Isnull(ОП.Подразделение.КОД,"321") В("000000017","000000037")
					ТОГДА ИСТИНА
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ КАК Агентская,
			ВЫБОР
				КОГДА ОП.ОплаченоФакт &gt; 0
						И ОП.КВСуммаДляАгента &gt;= ОП.АВилиСкидкаСумма
						И ОП.СхемаРасчетаСМенеджером &lt;&gt; ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.БезРасчета)
					ТОГДА ОП.КВСуммаДляАгента - ОП.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ * (100 - ОП.ПроцентСКВ) / 100 КАК СКВ_по_КВ_Для_Агента,
			ВЫБОР
				КОГДА ОП.ОплаченоФакт &gt; 0
						И ОП.КВСумма &gt;= ОП.АВилиСкидкаСумма
						И ОП.СхемаРасчетаСМенеджером &lt;&gt; ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.БезРасчета)
					ТОГДА ОП.КВСумма - ОП.АВилиСкидкаСумма
				ИНАЧЕ 0
			КОНЕЦ * (100 - ОП.ПроцентСКВ) / 100 КАК СКВ_по_КВ_Для_Брокера,
			1 КАК Оплат,
			ОП.Ссылка КАК Ссылка,
			ОП.АВилиСкидкаПроцент КАК АВилиСкидкаПроцент,
			ОП.АВилиСкидкаСумма КАК АВилиСкидкаСумма,
			ОП.Баланс_Брокер_Поставщик КАК Баланс_Брокер_Поставщик,
			ОП.ВидРасчетаСАгентом КАК ВидРасчетаСАгентом,
			ОП.ВидСП КАК Вид_СП,
			ОП.ВМпоРезультатамПериодаЗП КАК ВМпоРезультатамПериодаЗП,
			ОП.ВознаграждениеМенеджера КАК ВознаграждениеМенеджера,
			ОП.ВычетСАгента КАК ВычетСАгента,
			ОП.ЗарплатныйПериод КАК ЗарплатныйПериод,
			ОП.ИсключенаИзВзаиморасчетов КАК ИсключенаИзВзаиморасчетов,
			ОП.ИсключитьИзРасчетаЗП КАК ИсключитьИзРасчетаЗП,
			ОП.КВПодВопросом КАК КВПодВопросом,
			ОП.КВПроцент КАК КВПроцент,
			ОП.КВПроцентДляАгента КАК КВПроцентДляАгента,
			ОП.КВПроцентДляОтчета КАК КВПроцентДляОтчета,
			ОП.КВСумма КАК КВСумма,
			ОП.КВСуммаДляАгента КАК КВСуммаДляАгента,
			ОП.КВСуммаДляОтчета КАК КВСуммаДляОтчета,
			ОП.КодКВ КАК КодКВ,
			ОП.КОплатеАгентом КАК КОплатеАгентом,
			ОП.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
			ВЫБОР
				КОГДА ОП.НачисленнаяСуммаВзноса = 0
					ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
				ИНАЧЕ ОП.НачисленнаяСуммаВзноса
			КОНЕЦ КАК СуммаВзноса,
			ОП.НеВключатьВОтчетыПоставщикам КАК НеВключатьВОтчетыПоставщикам,
			ОП.НомерВзноса КАК НомерВзноса,
			ОП.ОплаченоФакт КАК ОплаченоФакт,
			ОП.ПолисАннулирован КАК ПолисАннулирован,
			ОП.ПолнаяСтраховаяПремия КАК ПолнаяСтраховаяПремия,
			ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику КАК ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,
			ОП.Проблемная КАК Проблемная,
			ОП.СкидкаВыплаченаяКлиенту КАК СкидкаВыплаченаяКлиенту,
			ОП.СуммаКОплатеБрокеруДляОчетаПоставщику КАК СуммаКОплатеБрокеруДляОчетаПоставщику,
			ОП.СхемаРасчетаСМенеджером КАК СхемаРасчетаСМенеджером,
			ОП.ФормаОплаты КАК ФормаОплаты,
			ОП.ДБ КАК ДБ,
			ОП.СуммаДоп КАК СуммаДоп,
			ОП.УдержаноСК КАК УдержаноСК,
			ОП.ПроцентСКВ КАК ПроцентСКВ,
			ОП.Подразделение КАК Подразделение
		ИЗ
			Документ.уб_ОплатаПолисов КАК ОП
		ГДЕ
			ОП.ЗарплатныйПериод &gt;= &amp;ДатаНачала
			И ОП.ЗарплатныйПериод &lt;= &amp;ДатаКонца
			И ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
			И НЕ ОП.СтраховойПолис.Ссылка = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
			И ОП.СтраховойПолис.ПометкаУдаления = ЛОЖЬ
			и НЕ Isnull(ОП.Подразделение.Наименование,"")="Технопарк"
			и НЕ Isnull(ОП.Подразделение.Наименование,"")="Особисты"
			И (НЕ(ОП.СтраховойПолис.Страхователь.Наименование ПОДОБНО "%ЕРМОЛИНО МОЛОКО%"
							ИЛИ ОП.СтраховойПолис.Страхователь.Наименование ПОДОБНО "%Инвест Альянс%"
							ИЛИ ОП.СтраховойПолис.Страхователь.Наименование ПОДОБНО "%Итера%")
					ИЛИ &amp;ВключитьЗаводы)) КАК О
	
	СГРУППИРОВАТЬ ПО
		О.ЗППериод) КАК Т

УПОРЯДОЧИТЬ ПО
	Т.ЗППериод</query>
	</dataSet>
