		<query>ВЫБРАТЬ
	уб_ИсторияРеквизитСрезПоследних.Период,
	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории
ПОМЕСТИТЬ ВТ_История
ИЗ
	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(, РеквизитОбъекта = &amp;Реквизит) КАК уб_ИсторияРеквизитСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
ПОМЕСТИТЬ ВТ_ДвижениеФЛ
ИЗ
	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДвижениеФЛ.Выбытие КАК АгентУволен,
	ОП.Ссылка КАК Ссылка,
	ОП.ЗарплатныйПериод,
	ОП.КВСумма - ОП.КВСуммаДляАгента КАК РазницаКВСумма,
	ОП.Агент КАК Агент,
	ОП.СК КАК СК,
	ОП.КВПроцент,
	ОП.КВПроцентДляАгента,
	ОП.КВСумма,
	ОП.КВСуммаДляАгента,
	ВЫБОР
		КОГДА ОП.КВСумма - ОП.КВСуммаДляАгента &lt; 0
			ТОГДА ОП.КВСуммаДляАгента - ОП.КВСумма
		ИНАЧЕ ОП.КВСумма - ОП.КВСуммаДляАгента
	КОНЕЦ КАК РазницаМодуль,
	ВТ_История.Период
ИЗ
	Документ.уб_ОплатаПолисов КАК ОП
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_История КАК ВТ_История
		ПО ОП.Ссылка = ВТ_История.ОбъектИстории
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДвижениеФЛ КАК ВТ_ДвижениеФЛ
		ПО ОП.Агент = ВТ_ДвижениеФЛ.Агент
ГДЕ
	НЕ ОП.ПометкаУдаления
	И (ОП.КВСуммаДляАгента &lt;&gt; ОП.КВСумма
			ИЛИ ОП.КВПроцентДляАгента &lt;&gt; ОП.КВПроцент)
	И ОП.ВидРасчетаСАгентом &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ)
	И ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	И НЕ(ОП.КВСумма = 0
				И ОП.КВСуммаДляАгента = 0)
	И (ОП.ПроверенаЗП = ЛОЖЬ
			ИЛИ &amp;ПоказыватьПроверенные = ИСТИНА)
	И (ВТ_ДвижениеФЛ.Выбытие = ЛОЖЬ
			ИЛИ &amp;ПоказыватьПоУволенным = ИСТИНА)

УПОРЯДОЧИТЬ ПО
	РазницаМодуль УБЫВ,
	ОП.Дата УБЫВ</query>
