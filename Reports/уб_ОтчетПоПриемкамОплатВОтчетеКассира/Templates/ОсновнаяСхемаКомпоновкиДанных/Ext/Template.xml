		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	уб_ПриемкаОплат.Ссылка
ПОМЕСТИТЬ ВТ_ТекущиеПриемкиВОтчетеКассира
ИЗ
	Документ.уб_ПриемкаОплат КАК уб_ПриемкаОплат
ГДЕ
	уб_ПриемкаОплат.ОтчетКассира = &amp;ОтчетКассира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	уб_ИсторияРеквизит.ОбъектИстории КАК ПриемкаОплат,
	уб_ИсторияРеквизит.ОбъектИстории.ПринятоОТ,
	уб_ИсторияРеквизит.ОбъектИстории.Сумма,
	уб_ИсторияРеквизит.ОбъектИстории.СуммаПоСтрокам,
	ВЫБОР
		КОГДА ВТ_ТекущиеПриемкиВОтчетеКассира.Ссылка ЕСТЬ NULL 
			ТОГДА Ложь
		ИНАЧЕ Истина
	КОНЕЦ КАК ЕстьВОтчетеКассираВТекущейВерсии
ИЗ
	РегистрСведений.уб_ИсторияРеквизит КАК уб_ИсторияРеквизит
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеПриемкиВОтчетеКассира КАК ВТ_ТекущиеПриемкиВОтчетеКассира
		ПО уб_ИсторияРеквизит.ОбъектИстории = ВТ_ТекущиеПриемкиВОтчетеКассира.Ссылка
ГДЕ
	уб_ИсторияРеквизит.ОбъектИстории ССЫЛКА Документ.уб_ПриемкаОплат
	И уб_ИсторияРеквизит.РеквизитОбъекта.Наименование = "ОтчетКассира"
	И уб_ИсторияРеквизит.ЗначениеРеквизита = &amp;ОтчетКассира</query>
	</dataSet>
	<totalField>
