		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВложенныйЗапрос2.НачисСуммаВзноса,
	ВложенныйЗапрос2.Скидка,
	ВложенныйЗапрос2.НачисСуммаВзносаСреднее,
	ВложенныйЗапрос2.СкидкаСреднее,
	ВложенныйЗапрос2.Количество,
	ВложенныйЗапрос2.СтраховаяПремия,
	ВложенныйЗапрос2.СтраховаяПремияСредняя,
	ВложенныйЗапрос1.КоличествоВсего,
	ВложенныйЗапрос2.Количество * 100 / ВложенныйЗапрос1.КоличествоВсего КАК Процент
ИЗ
	(ВЫБРАТЬ
		КОЛИЧЕСТВО(1) КАК КоличествоВсего
	ИЗ
		Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				уб_СтраховойПолисРиски.СтраховаяПремия КАК СтраховаяПремия,
				уб_СтраховойПолисРиски.Ссылка КАК Ссылка
			ИЗ
				Документ.уб_СтраховойПолис.Риски КАК уб_СтраховойПолисРиски
			ГДЕ
				уб_СтраховойПолисРиски.Ссылка.НомерЗаявки &lt;&gt; &amp;Заявка) КАК ВложенныйЗапрос
			ПО уб_ОплатаПолисов.СтраховойПолис = ВложенныйЗапрос.Ссылка
	ГДЕ
		уб_ОплатаПолисов.СтраховойПолис.НомерЗаявки &lt;&gt; &amp;Заявка
		И уб_ОплатаПолисов.ЗарплатныйПериод МЕЖДУ &amp;ДатаНач И &amp;ДатаКон
		И уб_ОплатаПолисов.СтраховойПолис.СтраховойПродукт.Вид.Ссылка = &amp;Вид) КАК ВложенныйЗапрос1,
	(ВЫБРАТЬ
		СУММА(уб_ОплатаПолисов.НачисленнаяСуммаВзноса) КАК НачисСуммаВзноса,
		СУММА(уб_ОплатаПолисов.АВилиСкидкаСумма) КАК Скидка,
		СРЕДНЕЕ(уб_ОплатаПолисов.НачисленнаяСуммаВзноса) КАК НачисСуммаВзносаСреднее,
		СРЕДНЕЕ(уб_ОплатаПолисов.АВилиСкидкаСумма) КАК СкидкаСреднее,
		КОЛИЧЕСТВО(1) КАК Количество,
		СУММА(ВложенныйЗапрос.СтраховаяПремия) КАК СтраховаяПремия,
		СРЕДНЕЕ(ВложенныйЗапрос.СтраховаяПремия) КАК СтраховаяПремияСредняя
	ИЗ
		Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				уб_СтраховойПолисРиски.СтраховаяПремия КАК СтраховаяПремия,
				уб_СтраховойПолисРиски.Ссылка КАК Ссылка
			ИЗ
				Документ.уб_СтраховойПолис.Риски КАК уб_СтраховойПолисРиски
			ГДЕ
				уб_СтраховойПолисРиски.Ссылка.НомерЗаявки &lt;&gt; &amp;Заявка) КАК ВложенныйЗапрос
			ПО уб_ОплатаПолисов.СтраховойПолис = ВложенныйЗапрос.Ссылка
	ГДЕ
		уб_ОплатаПолисов.СтраховойПолис.НомерЗаявки &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная)
		И уб_ОплатаПолисов.ЗарплатныйПериод МЕЖДУ &amp;ДатаНач И &amp;ДатаКон
		И уб_ОплатаПолисов.СтраховойПолис.СтраховойПродукт.Вид.Ссылка = &amp;Вид
		И уб_ОплатаПолисов.АВилиСкидкаСумма &gt; 0) КАК ВложенныйЗапрос2</query>
