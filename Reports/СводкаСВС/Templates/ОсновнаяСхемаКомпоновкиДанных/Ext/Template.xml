		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ ПЕРВЫЕ 300000
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	НАЧАЛОПЕРИОДА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата, ДЕНЬ) КАК День,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСуммаВзноса,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСуммаВзноса - уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка КАК СКлиента,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер КАК Курьер,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Утверждено,
	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.СВС,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ФормаОплаты,
	ЕСТЬNULL(уб_ОплатыЗаявок.Оплачено, ЛОЖЬ) КАК Принято
ПОМЕСТИТЬ Заявки
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних(, ) КАК уб_ИсторияСтатусовЗаявокСрезПоследних
		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ОплатыЗаявок КАК уб_ОплатыЗаявок
	               		ПО уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка = уб_ОплатыЗаявок.Заявка
ГДЕ
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &gt;= &amp;Дата1
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &lt;= КонецПериода(&amp;Дата2,ДЕНЬ)
	//И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд = ЛОЖЬ
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Утверждено

УПОРЯДОЧИТЬ ПО
	Курьер,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ПриемкаОплатПолисы.Заявка,
	МАКСИМУМ(уб_ПриемкаОплатПолисы.Ссылка.Подразделение) КАК Подразделение,
	СУММА(уб_ПриемкаОплатПолисы.Сумма) КАК Сумма
ПОМЕСТИТЬ Приемки
ИЗ
	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
ГДЕ
	уб_ПриемкаОплатПолисы.Заявка В
			(ВЫБРАТЬ
				заявки.Ссылка
			ИЗ
				заявки)

СГРУППИРОВАТЬ ПО
	уб_ПриемкаОплатПолисы.Заявка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Заявки.Курьер,
	Заявки.День,
	Заявки.Ссылка,
	Заявки.ФормаОплаты,
	Заявки.Утверждено,
	Заявки.Статус,
	ЕСТЬNULL(Заявки.СВС,приемки.Подразделение) КАК СВС,
	ВЫБОР
		КОГДА Заявки.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась)
			ТОГДА 0
		ИНАЧЕ Заявки.СКлиента
	КОНЕЦ КАК СКлиента,
	ЕСТЬNULL(приемки.Сумма, 0) КАК Принято,
	Заявки.ИтогСтраховаяПремия,
	Заявки.ИтогПредоставленнаяСкидка,
	Заявки.ИтогСуммаВзноса,
	Выбор когда приемки.Заявка есть Null тогда Заявки.Принято иначе Ложь Конец как ОтметкаПринято,
	Выбор когда приемки.Заявка есть Null и Заявки.Принято тогда ВЫБОР
		КОГДА Заявки.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась)
			ТОГДА 0
		ИНАЧЕ Заявки.СКлиента
	КОНЕЦ иначе 0 Конец как Резерв
ИЗ
	Заявки КАК Заявки
		ЛЕВОЕ СОЕДИНЕНИЕ Приемки КАК приемки
		ПО Заявки.Ссылка = приемки.Заявка</query>
