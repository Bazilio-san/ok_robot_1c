		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	уб_ТранспортныеСредства.ГодВыпуска,
	уб_ТранспортныеСредства.Объект,
	уб_ТранспортныеСредства.МаркаТС,
	уб_ТранспортныеСредства.МодельТС
ПОМЕСТИТЬ изРегистра
ИЗ
	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	изРегистра.ГодВыпуска,
	изРегистра.МаркаТС,
	изРегистра.МодельТС,
	уб_СтраховойПолис.Номер,
	уб_СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма,
	уб_СтраховойПолис.Дата,
	1 КАК КоличествоВГруппе
ИЗ
	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ изРегистра КАК изРегистра
		ПО уб_СтраховойПолис.ОбъектСтрахования = изРегистра.Объект
ГДЕ
	уб_СтраховойПолис.Дата &gt;= &amp;НачалоПериода
	И уб_СтраховойПолис.Дата &lt;= &amp;КонецПериода</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоВГруппе</dataPath>
		<expression>Сумма(КоличествоВГруппе)</expression>
	</totalField>
	<totalField>
