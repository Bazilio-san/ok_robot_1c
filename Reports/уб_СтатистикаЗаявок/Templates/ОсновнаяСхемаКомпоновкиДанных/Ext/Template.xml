		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СУММА(ВЫБОР
			КОГДА (уб_ОплатаПолисов.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
					ИЛИ уб_ОплатаПолисов.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоИнтерваламСКВ))
					И уб_ОплатаПолисов.КВСуммаДляАгента &gt; уб_ОплатаПолисов.АВилиСкидкаСумма
					И уб_ОплатаПолисов.ОплаченоФакт &gt; 0
				ТОГДА уб_ОплатаПолисов.КВСуммаДляАгента - уб_ОплатаПолисов.АВилиСкидкаСумма
			ИНАЧЕ 0
		КОНЕЦ * (100 - уб_ОплатаПолисов.ПроцентСКВ) / 100) КАК СКВ,
	уб_ОплатаПолисов.СтраховойПолис,
	СУММА(уб_ОплатаПолисов.КВСуммаДляАгента) КАК КВ,
	СУММА(уб_ОплатаПолисов.АВилиСкидкаСумма) КАК Скидка
ПОМЕСТИТЬ ОплатыПериода
ИЗ
	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
ГДЕ
	уб_ОплатаПолисов.ПометкаУдаления = ЛОЖЬ
	И уб_ОплатаПолисов.СтраховойПолис.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	уб_ОплатаПолисов.СтраховойПолис
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Вложенный.Курьер,
	Вложенный.Вид,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
	СУММА(Вложенный.СтраховаяПремия) КАК ПремияПлан,
	СУММА(Вложенный.СтраховаяСумма) КАК СтраховаяСумма,
	СУММА(Вложенный.СуммаПремийПоОплатам) КАК ПремияФактически,
	Вложенный.Ссылка,
	Вложенный.Ссылка КАК Полис,
	Вложенный.КВ,
	Вложенный.СКВ,
	Вложенный.Скидка
ИЗ
	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		ВЫБОР
			КОГДА &amp;ПоАгентам = ИСТИНА
				ТОГДА ВЫБОР
						КОГДА ТИПЗНАЧЕНИЯ(уб_СтраховойПолис.Агент) &lt;&gt; ТИП(Справочник.ФизическиеЛица)
							ТОГДА уб_СтраховойПолис.Курьер
						ИНАЧЕ уб_СтраховойПолис.Агент
					КОНЕЦ
			ИНАЧЕ ВЫБОР
					КОГДА уб_СтраховойПолис.Курьер.Код ЕСТЬ NULL 
						ТОГДА уб_СтраховойПолис.Агент
					ИНАЧЕ уб_СтраховойПолис.Курьер
				КОНЕЦ
		КОНЕЦ КАК Курьер,
		уб_СтраховойПолис.ВидС КАК Вид,
		уб_СтраховойПолис.Подразделение КАК Подразделение,
		уб_СтраховойПолис.НомерЗаявки КАК НомерЗаявки,
		уб_СтраховойПолис.СтраховаяПремия КАК СтраховаяПремия,
		уб_СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма,
		уб_СтраховойПолис.СуммаПремийПоОплатам КАК СуммаПремийПоОплатам,
		уб_СтраховойПолис.Ссылка КАК Ссылка,
		ОплатыПериода.СКВ КАК СКВ,
		ОплатыПериода.КВ КАК КВ,
		ОплатыПериода.Скидка КАК Скидка
	ИЗ
		Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
			ЛЕВОЕ СОЕДИНЕНИЕ ОплатыПериода КАК ОплатыПериода
			ПО (ОплатыПериода.СтраховойПолис = уб_СтраховойПолис.Ссылка)
	ГДЕ
		уб_СтраховойПолис.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.Действует), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.ДействиеОкончено), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.ПрекращенДосрочно))
		И уб_СтраховойПолис.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода) КАК Вложенный
		Левое СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		ПО Вложенный.Курьер = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент

СГРУППИРОВАТЬ ПО
	Вложенный.Курьер,
	Вложенный.Вид,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
	Вложенный.Ссылка,
	Вложенный.Ссылка,
	Вложенный.КВ,
	Вложенный.СКВ,
	Вложенный.Скидка</query>
