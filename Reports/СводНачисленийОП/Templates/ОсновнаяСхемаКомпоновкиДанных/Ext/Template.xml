			<field>ПрочиеНачисления</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НачисленияВсе.Сотрудник,
	СУММА(НачисленияВсе.Результат) КАК Результат,
	НачисленияВсе.Дата
	Поместить ПрочиеНачисления
ИЗ
	(ВЫБРАТЬ
		уб_НачислениеЗПНачисления.Сотрудник КАК Сотрудник,
		уб_НачислениеЗПНачисления.Результат КАК Результат,
		уб_НачислениеЗПНачисления.Ссылка.Дата КАК Дата
	ИЗ
		Документ.уб_НачислениеЗП.Начисления КАК уб_НачислениеЗПНачисления
	ГДЕ
		уб_НачислениеЗПНачисления.Ссылка.Дата &gt;= &amp;ДатаНачала
		И уб_НачислениеЗПНачисления.Ссылка.Дата &lt;= &amp;ДатаОкончания
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		уб_НачислениеЗПНачисления.Сотрудник,
		уб_НачислениеЗПНачисления.Результат,
		уб_НачислениеЗПНачисления.Ссылка.Дата
	ИЗ
		Документ.уб_НачислениеЗП.НачисленияРазовые КАК уб_НачислениеЗПНачисления
	ГДЕ
		уб_НачислениеЗПНачисления.Ссылка.Дата &gt;= &amp;ДатаНачала
		И уб_НачислениеЗПНачисления.Ссылка.Дата &lt;= &amp;ДатаОкончания) КАК НачисленияВсе

СГРУППИРОВАТЬ ПО
	НачисленияВсе.Дата,
	НачисленияВсе.Сотрудник
;	
ВЫБРАТЬ
	уб_ПараметрыРасчетаЗарплатыСотрудников.Период,
	уб_ПараметрыРасчетаЗарплатыСотрудников.Сотрудник,
	уб_ПараметрыРасчетаЗарплатыСотрудников.ТипПараметра,
	уб_ПараметрыРасчетаЗарплатыСотрудников.ЗначениеПараметра
ПОМЕСТИТЬ Исходные
ИЗ
	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников КАК уб_ПараметрыРасчетаЗарплатыСотрудников
ГДЕ
	(уб_ПараметрыРасчетаЗарплатыСотрудников.ТипПараметра В ("""План по СКВ""", "План", "По АВ", "Без расчета", "СКВ", "СуммаВознаграждения_РОП")
			ИЛИ уб_ПараметрыРасчетаЗарплатыСотрудников.ЗначениеПараметра = 3.1)
	И уб_ПараметрыРасчетаЗарплатыСотрудников.ЗначениеПараметра &lt;&gt; 0
	и уб_ПараметрыРасчетаЗарплатыСотрудников.Период&gt;=&amp;ДатаНачала
	и уб_ПараметрыРасчетаЗарплатыСотрудников.Период&lt;=&amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Исходные.Сотрудник КАК Менеджер,
	Исходные.Период как ЗарплатныйПериод,
	Подразделения.ТипПараметра КАК Подразделение,
	ЕСТЬNULL(Планы.ЗначениеПараметра, 0) КАК План,
	ЕСТЬNULL(Сборы.ЗначениеПараметра, 0) КАК СКВ, 0 Как СКВЛички,
	ЕСТЬNULL(ЗА_СКВ.ЗначениеПараметра, 0) КАК выплачено,
	ЕСТЬNULL(ЗА_АВ.ЗначениеПараметра, 0) КАК ЗаЛички,
	ЕСТЬNULL(ЗА_РОП.ЗначениеПараметра, 0) КАК ВыплаченоРОП,
	ЕСТЬNULL(ПрочиеНачисления.Результат, 0) КАК ПрочиеНачисления
ИЗ
	Исходные КАК Исходные
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК Подразделения
		ПО Исходные.Сотрудник = Подразделения.Сотрудник
			И Исходные.Период = Подразделения.Период
			И (Подразделения.ЗначениеПараметра = 3.1)
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК Планы
		ПО Исходные.Сотрудник = Планы.Сотрудник
			И Исходные.Период = Планы.Период
			И (Планы.ТипПараметра = "План")
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК Сборы
		ПО Исходные.Сотрудник = Сборы.Сотрудник
			И Исходные.Период = Сборы.Период
			И (Сборы.ТипПараметра = "СКВ")
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК ЗА_СКВ
		ПО (ЗА_СКВ.Сотрудник = Исходные.Сотрудник)
			И (ЗА_СКВ.Период = Исходные.Период)
			И (ЗА_СКВ.ТипПараметра = """План по СКВ""")
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК ЗА_АВ
		ПО (ЗА_АВ.Сотрудник = Исходные.Сотрудник)
			И (ЗА_АВ.Период = Исходные.Период)
			И (ЗА_АВ.ТипПараметра = "По АВ")	
		ЛЕВОЕ СОЕДИНЕНИЕ Исходные КАК ЗА_РОП
		ПО (ЗА_РОП.Сотрудник = Исходные.Сотрудник)
			И (ЗА_РОП.Период = Исходные.Период)
			И (ЗА_РОП.ТипПараметра = "СуммаВознаграждения_РОП")	
		ЛЕВОЕ СОЕДИНЕНИЕ ПрочиеНачисления КАК ПрочиеНачисления
		ПО (ПрочиеНачисления.Сотрудник = Исходные.Сотрудник)
			И (ПрочиеНачисления.Дата = Исходные.Период)
			
			
ГДЕ
	Исходные.Сотрудник &lt;&gt; ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)

</query>
