//Перем СчетчикМесяцев;

Функция ПолучитьТЗ() Экспорт
	
	тз = Отчеты.уб_СтатистикаПоСтраховкам.ПустаяТЗ();
	
	СчетчикМесяцев = 1;
	//получаем количество месяцев установленных периодов
	Пока Истина Цикл
		Если НачалоПериода < ДобавитьМесяц(НачалоМесяца(КонецПериода), - (СчетчикМесяцев - 1)) Тогда
			СчетчикМесяцев = СчетчикМесяцев + 1
		ИначеЕсли НачалоПериода = ДобавитьМесяц(НачалоМесяца(КонецПериода), - (СчетчикМесяцев - 1)) Тогда
			Прервать
		Иначе
			Сообщить("Неверный зарплатный период!");
			Возврат тз;
		КонецЕсли;
	КонецЦикла;
	
	кЛичнаяЗаявка = Перечисления.уб_ВидыЗаявок.Личная;	 
	кРасчетПоАВ = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ;	 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.ЗарплатныйПериод КАК Период,
	|	СУММА(Т.ЭтоОплата) КАК ВсегоОплат,
	|	СУММА(Т.Новая) КАК НовыхПолисов,
	|	СУММА(Т.ОплатаДоПереданной) КАК ОплатДоПереданной,
	|	СУММА(Т.НоваяОплатаДоПереданной) КАК НовыхПолисовДоПереданной,
	|	СУММА(Т.Первичная) КАК Первичных,
	|	СУММА(Т.Пролонгация) КАК Пролонгаций,
	|	СУММА(Т.Вторичная) КАК Вторичных,
	|	СУММА(Т.Рекомендация) КАК Рекомендаций,
	|	СУММА(Т.СтраховаяСумма) КАК СтраховаяСумма,
	|	СУММА(Т.СтраховаяПремия) КАК СтраховаяПремия,
	|	СУММА(Т.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
	|	СУММА(Т.ОплаченоФакт) КАК ОплаченоФакт,
	|	СУММА(Т.АВилиСкидкаСумма) КАК АВилиСкидкаСумма,
	|	СУММА(Т.КВСумма) КАК КВСумма,
	|	СУММА(Т.КВСуммаДляОтчета) КАК КВСуммаДляОтчета,
	|	СУММА(Т.Прибыль) КАК СКВ,
	|	СРЕДНЕЕ(Т.СтраховаяСумма) КАК СрСтраховаяСумма,
	|	СРЕДНЕЕ(Т.СтраховаяПремия) КАК СрСтраховаяПремия,
	|	СРЕДНЕЕ(Т.НачисленнаяСуммаВзноса) КАК СрНачисленнаяСуммаВзноса,
	|	СРЕДНЕЕ(Т.ОплаченоФакт) КАК СрОплаченоФакт,
	|	СРЕДНЕЕ(Т.АВилиСкидкаСумма) КАК СрАВилиСкидкаСумма,
	|	СРЕДНЕЕ(Т.АВилиСкидкаПроцент) КАК СрАВилиСкидкаПроцент,
	|	СРЕДНЕЕ(Т.КВПроцент) КАК СрКВПроцент,
	|	СРЕДНЕЕ(Т.КВПроцентДляОтчета) КАК СрКВПроцентДляОтчета,
	|	СРЕДНЕЕ(Т.КВСумма) КАК СрКВСумма,
	|	СРЕДНЕЕ(Т.Прибыль) КАК СрПрибыль,
	|	Т.ВидСП,
	|	Т.Личная,
	|	Т.Агент,
	|	Т.Подразделение,
	|	Т.НаправлениеПлатежа,
	|	Т.ОрганизацияАгент КАК Организация,
	|	СУММА(Т.СКВПервогоВзноса) КАК СКВПервогоВзноса,
	|	СУММА(Т.СКВНеПервогоВзноса) КАК СКВНеПервогоВзноса,
	|	СУММА(Т.КоличествоНеПервых) КАК КоличествоНеПервых,
	|	СУММА(Т.ПриведеннаяСтраховаяСумма) КАК ПриведеннаяСтраховаяСумма,
	|	СУММА(Т.ПриведеннаяСуммаНеПервых) КАК ПриведеннаяСуммаНеПервых,
	|	СУММА(Т.СКВПервогоВзносаПриведенное) КАК СКВПервогоВзносаПриведенное,
	|	СУММА(Т.ПриведеннаяСтраховаяПремияПервых) КАК ПриведеннаяСтраховаяПремияПервых,
	|	СУММА(Т.СкидкаНаПремию) КАК СкидкаНаПремию,
	|	СУММА(Т.КВНаПремию) КАК КВНаПремию,
	|	СУММА(Т.НачисленнаяСуммаВзносаПервых) КАК НачисленнаяСуммаВзносаПервых,
	|	СУММА(Т.СкидкаПервых) КАК СкидкаПервых,
	|	СУММА(Т.НачисленнаяСуммаВзносаВторых),
	|	СУММА(Т.СкидкаВторых),
	|	СУММА(Т.КоличествоПролонгаций) КАК КоличествоПролонгаций
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОП.Дата КАК Дата,
	|		ОП.Агент КАК Агент,
	|		ОП.ВидСП КАК ВидСП,
	|		ОП.СтраховойПолис.СК КАК СК,
	|		ОП.Номер КАК Номер,
	|		ОП.Ссылка КАК Ссылка,
	|		ОП.НомерВзноса КАК НомерВзноса,
	|		ОП.НаправлениеПлатежа КАК НаправлениеПлатежа,
	|		ОП.СтраховойПолис.НомерЗаявки КАК НомерЗаявки,
	|		ОП.СтраховойПолис.ВидУчетаСтраховки КАК ВидУчетаСтраховки,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Первичная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Первичная,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Пролонгация
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Пролонгация,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Вторичная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Вторичная,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.ВидУчетаСтраховки = &Рекомендация
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Рекомендация,
	|		ОП.ВидРасчетаСАгентом КАК ВидРасчетаСАгентом,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Новая,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса <> 1
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК КоличествоНеПервых,
	|		ВЫБОР
	|			КОГДА ОП.Дата <= &КонецПериода
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОплатаДоПереданной,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|					И ОП.Дата <= &КонецПериода
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НоваяОплатаДоПереданной,
	|		1 КАК ЭтоОплата,
	|		ОП.СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма,
	|		ОП.СтраховойПолис.СтраховаяПремия КАК СтраховаяПремия,
	|		ОП.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА ОП.НачисленнаяСуммаВзноса
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НачисленнаяСуммаВзносаПервых,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса <> 1
	|				ТОГДА ОП.НачисленнаяСуммаВзноса
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НачисленнаяСуммаВзносаВторых,
	|		ОП.ОплаченоФакт КАК ОплаченоФакт,
	|		ОП.АВилиСкидкаСумма КАК АВилиСкидкаСумма,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА ОП.АВилиСкидкаПроцент * ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) / 100
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СкидкаНаПремию,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА ОП.АВилиСкидкаСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СкидкаПервых,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса <> 1
	|				ТОГДА ОП.АВилиСкидкаСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СкидкаВторых,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА ОП.КВПроцент * ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) / 100
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК КВНаПремию,
	|		ОП.АВилиСкидкаПроцент КАК АВилиСкидкаПроцент,
	|		ОП.КВПроцент КАК КВПроцент,
	|		ОП.КВСумма КАК КВСумма,
	|		ВЫБОР
	|			КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|					КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|						ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|					ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|				КОНЕЦ - ОП.КВСумма
	|				ТОГДА 0
	|			ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|					КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|						ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|					ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|				КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|		КОНЕЦ КАК Прибыль,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|				ТОГДА ВЫБОР
	|						КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.КВСумма
	|							ТОГДА 0
	|						ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СКВПервогоВзноса,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|					И ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ <> 0
	|				ТОГДА ВЫБОР
	|						КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.КВСумма
	|							ТОГДА 0
	|						ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|					КОНЕЦ * (ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) / ВЫБОР
	|						КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|							ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|						ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|					КОНЕЦ)
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СКВПервогоВзносаПриведенное,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса <> 1
	|				ТОГДА ВЫБОР
	|						КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.КВСумма
	|							ТОГДА 0
	|						ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	|								КОГДА ОП.НачисленнаяСуммаВзноса = 0
	|									ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	|								ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	|							КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СКВНеПервогоВзноса,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса = 1
	|					И ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) <> 0
	|				ТОГДА ОП.СтраховойПолис.СтраховаяПремия
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ПриведеннаяСтраховаяПремияПервых,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) <> 0
	|				ТОГДА ОП.СтраховойПолис.СтраховаяСумма * ОП.НачисленнаяСуммаВзноса / ОП.СтраховойПолис.СтраховаяПремия
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ПриведеннаяСтраховаяСумма,
	|		ВЫБОР
	|			КОГДА ОП.НомерВзноса <> 1
	|					И ЕСТЬNULL(ОП.СтраховойПолис.СтраховаяПремия, 0) <> 0
	|				ТОГДА ОП.СтраховойПолис.СтраховаяСумма * ОП.НачисленнаяСуммаВзноса / ОП.СтраховойПолис.СтраховаяПремия
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ПриведеннаяСуммаНеПервых,
	|		НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) КАК ЗарплатныйПериод,
	|		ВЫБОР
	|			КОГДА ОП.СтраховойПолис.НомерЗаявки = &ЛичнаяСтраховка  ИЛИ ОП.СтраховойПолис.НомерЗаявки = &Агентская 
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Личная,
	|		ОП.ОрганизацияАгент КАК ОрганизацияАгент,
	|		ОП.КВСуммаДляОтчета КАК КВСуммаДляОтчета,
	|		ОП.КВПроцентДляОтчета КАК КВПроцентДляОтчета,
	|		ОП.Подразделение КАК Подразделение,
	|		ВЫБОР
	|			КОГДА Пролонгации.НовыйПолис ЕСТЬ NULL 
	|					ИЛИ ОП.НомерВзноса <> 1
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК КоличествоПролонгаций
	|	ИЗ
	|		Документ.уб_ОплатаПолисов КАК ОП
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|				уб_ЗаданияНаПролонгацию.СтраховойПолис КАК Значение,
	//|				уб_ЗаданияНаПролонгацию.ТекущийСтатус КАК ТекущийСтатус,
	//|				уб_ЗаданияНаПролонгацию.ДатаЗакрытия КАК ДатаЗакрытия,
	|				уб_ЗаданияНаПролонгацию.НовыйПолис КАК НовыйПолис
	|			ИЗ
	|				РегистрСведений.уб_ЗаданияНаПролонгацию КАК уб_ЗаданияНаПролонгацию
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	|					ПО уб_ЗаданияНаПролонгацию.СтраховойПолис = уб_СтраховойПолис.Ссылка
	|						И (уб_ЗаданияНаПролонгацию.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыПролонгирования.Пролонгирован))
	|						И (уб_ЗаданияНаПролонгацию.ТипЗадания = ЛОЖЬ)) КАК Пролонгации
	|			ПО (Пролонгации.НовыйПолис = ОП.СтраховойПолис)
	|	ГДЕ
	|		НЕ ОП.ПометкаУдаления
	|		И ОП.ВидРасчетаСАгентом <> &РасчетПоАВ
	|		И 1 = 1) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ЗарплатныйПериод,
	|	Т.ВидСП,
	|	Т.Личная,
	|	Т.Агент,
	|	Т.Подразделение,
	|	Т.НаправлениеПлатежа,
	|	Т.ОрганизацияАгент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";		 	
	//дополнительные периоды для динамики показателей.
	Если Динамика Тогда
		НачалоПериодаМинусГод 	= ДобавитьМесяц(НачалоПериода, 	-12);
		КонецПериодаМинусГод	= ДобавитьМесяц(КонецПериода,	-12);
		НачалоПериодаМинусМесяц = ДобавитьМесяц(НачалоПериода,	-1);
		Если НачалоМесяца(КонецПериодаМинусГод) >= НачалоПериодаМинусМесяц Тогда
			ДопТекст = "ОП.ЗарплатныйПериод >= &НачалоПериода И ОП.ЗарплатныйПериод <= &КонецПериода";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаМинусГод);
		Иначе
			ДопТекст = "((ОП.ЗарплатныйПериод >= &НачалоПериода И ОП.ЗарплатныйПериод <= &КонецПериода) ИЛИ (ОП.ЗарплатныйПериод >= &НачалоПериодаМинусГод И ОП.ЗарплатныйПериод <= &КонецПериодаМинусГод))";
			Запрос.УстановитьПараметр("НачалоПериодаМинусГод", 	НачалоПериодаМинусГод);
			Запрос.УстановитьПараметр("КонецПериодаМинусГод",	КонецПериодаМинусГод);
			Запрос.УстановитьПараметр("НачалоПериода",			НачалоПериодаМинусМесяц);
		КонецЕсли;
	Иначе
		ДопТекст = "ОП.ЗарплатныйПериод >= &НачалоПериода И ОП.ЗарплатныйПериод <= &КонецПериода";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	КонецЕсли;		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", ДопТекст);
	Запрос.УстановитьПараметр("ЛичнаяСтраховка",кЛичнаяЗаявка);
	Запрос.УстановитьПараметр("Агентская",Перечисления.уб_ВидыЗаявок.Агентская);
	
	Запрос.УстановитьПараметр("РасчетПоАВ", 	кРасчетПоАВ);	
	Запрос.УстановитьПараметр("Первичная", 		Перечисления.уб_ВидыУчетаСтраховок.Первичная);
	Запрос.УстановитьПараметр("Пролонгация", 	Перечисления.уб_ВидыУчетаСтраховок.Пролонгация);
	Запрос.УстановитьПараметр("Вторичная", 		Перечисления.уб_ВидыУчетаСтраховок.Вторичная);
	Запрос.УстановитьПараметр("Рекомендация", 	Перечисления.уб_ВидыУчетаСтраховок.Рекомендация);
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);	
	
	Выборка = Запрос.Выполнить().Выбрать();	
	ЗаполнитьТЗ(Выборка,ТЗ);	
	МассивТЗАгентов = Неопределено;
	Если ПоЗП Тогда	
		ТЗ1 = Новый ТаблицаЗначений;
		ТЗАгентов = Новый ТаблицаЗначений;
		тзПодразделений = Новый ТаблицаЗначений;
		тзСхемаРасчетаДляАгентов = Новый ТаблицаЗначений; 			
		Обработка = Обработки.уб_РасчетВМ.Создать();
		МассивТЗАгентов = Новый Массив;
		Для Счетчик = 1 По СчетчикМесяцев Цикл
			Обработка.ЗарплатныйПериод = ДобавитьМесяц(НачалоДня(КонецМесяца(НачалоПериода)), Счетчик - 1);
			Обработка.ДатаСреза = Неопределено;
			Обработка.РассчитатьТаблицы(ТЗ1, ТЗАгентов, тзПодразделений, тзСхемаРасчетаДляАгентов);
			МассивТЗАгентов.Добавить(ТЗАгентов);
		КонецЦикла;		
		Для Индекс = 0 По МассивТЗАгентов.Количество() - 1 Цикл
			Период = ДобавитьМесяц(НачалоМесяца(НачалоПериода), Индекс);
			Для Каждого СтрокаТЗАгентов Из МассивТЗАгентов[Индекс] Цикл
				ЗаполнитьПоТЗАгента(ТЗ, СтрокаТЗАгентов, Период);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	Если Динамика Тогда		
		НачалоПер = НачалоМесяца(НачалоПериода);
		_ТЗ = Новый ТаблицаЗначений;
		_ТЗ = ТЗ.СкопироватьКолонки();
		Массив = Новый Массив;		
		Для Каждого СтрокаТЗ из ТЗ Цикл
			Если СтрокаТЗ.Динамика <> Истина Или Массив.Найти(СтрокаТЗ.Показатель + СтрокаТЗ.Агент + СтрокаТЗ.ВидСП + СтрокаТЗ.Личная + СтрокаТЗ.Организация + СтрокаТЗ.Подразделение + СтрокаТЗ.НаправлениеПлатежа) <> Неопределено Тогда 
				Продолжить
			КонецЕсли;			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Показатель");
			ПараметрыОтбора.Вставить("Агент");
			ПараметрыОтбора.Вставить("ВидСП");
			ПараметрыОтбора.Вставить("Личная");
			ПараметрыОтбора.Вставить("Организация");
			ПараметрыОтбора.Вставить("Агент");
			ПараметрыОтбора.Вставить("Подразделение");
			ПараметрыОтбора.Вставить("НаправлениеПлатежа");			
			ПараметрыОтбора.Показатель 			= СтрокаТЗ.Показатель;
			ПараметрыОтбора.Агент				= СтрокаТЗ.Агент;
			ПараметрыОтбора.ВидСП				= СтрокаТЗ.ВидСП;
			ПараметрыОтбора.Личная				= СтрокаТЗ.Личная;
			ПараметрыОтбора.Организация 		= СтрокаТЗ.Организация;
			ПараметрыОтбора.Подразделение 		= СтрокаТЗ.Подразделение;
			ПараметрыОтбора.НаправлениеПлатежа 	= СтрокаТЗ.НаправлениеПлатежа;
			ТЗД = Новый ТаблицаЗначений;
			ТЗД = ТЗ.Скопировать(ПараметрыОтбора);
			ТЗД.Сортировать("Период УБЫВ");				
			//3 типа периодов: 
			//1) конечный (не добавляет данные для сравнения в будущие периоды
			//2) меньше начала периода (только для сравнения)
			//3) общий 1 + 2
			Для Индекс = 0 По ТЗД.Количество() - 1 Цикл
				Если ТЗД[Индекс].Период = НачалоМесяца(КонецПериода) Тогда
					РасчетныйМесяц(_ТЗ, ТЗД, Индекс);
				ИначеЕсли ТЗД[Индекс].Период < НачалоМесяца(НачалоПериода) Тогда
					СравниваемыйМесяц(_ТЗ, ТЗД, Индекс);
				Иначе
					РасчетныйМесяц(_ТЗ, ТЗД, Индекс);
					СравниваемыйМесяц(_ТЗ, ТЗД, Индекс);
				КонецЕсли;
			КонецЦикла;
			Массив.Добавить(СтрокаТЗ.Показатель + СтрокаТЗ.Агент + СтрокаТЗ.ВидСП + СтрокаТЗ.Личная + СтрокаТЗ.Организация + СтрокаТЗ.Подразделение + СтрокаТЗ.НаправлениеПлатежа);
		КонецЦикла;
		ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(_ТЗ, ТЗ);
	КонецЕсли;		
	Если ЗапроситьДанныеБазы = Истина Тогда
		ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ДанныеИзБазы(), ТЗ);
	КонецЕсли;	
	ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ДанныеПоПролонгациям(), ТЗ);
	
	
	СписокАгентов = Тз.Скопировать();
	СписокАгентов.Свернуть("Агент");
	//Пустышки для расчетов
	ТекДата  = НачалоПериода;
	Пока ТекДата <= КонецПериода Цикл
		//Сообщить(ТекДата);
		Для каждого СтрокаА из СписокАгентов Цикл
			Агент = СтрокаА.Агент;
			Строка2 = ТЗ.Добавить();
			Строка2.Агент = Агент;
		
		Строка2.Период = ТекДата;
		//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Количество вторых взносов";
		Строка2.Значение		= 0;
		Строка2.Сортировка 	= "^Количество_Вторых";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
		
		Строка2 = ТЗ.Добавить();
		Строка2.Агент = Агент;
		Строка2.Период = ТекДата;
		//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Количество пролонгаций по 1С";
		Строка2.Значение		= 0;
		Строка2.Сортировка 	= "#Количество_Пролонгаций";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
		
		Строка2 = ТЗ.Добавить();
		Строка2.Агент = Агент;
		Строка2.Период = ТекДата;
		//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Количество оплат";
		Строка2.Значение		= 0;
		Строка2.Сортировка 	= "$Количество__Оплат";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
		
		Строка2 = ТЗ.Добавить();
		Строка2.Период = ТекДата;
		Строка2.Агент = Агент;
		//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Обработано новых заявок";
		Строка2.Значение		= 0;
		Строка2.Сортировка 	= "$ОбработаноНовыхЗаявок";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
        КонецЦикла;
		ТекДата = ДобавитьМесяц(ТекДата,1);
		
	КонецЦикла;

	//Для каждого Строка из ТЗ цикл
	//	Если ТипЗнч(Строка.Значение) <> Тип("Число") Тогда
	//		Сообщить(ТипЗнч(Строка.Значение));
	//	КонецЕсли;	
	//КонецЦикла;	
	//Тз.Индексы.Добавить("Фильтр");
	Возврат ТЗ;
	
КонецФункции

//заполнение плюсом
Процедура РасчетныйМесяц(_ТЗ, ТЗД, Индекс)
	
	//проверка чтобы не добавлялись расчеты прошлого года в таблицу
	Если ТЗД[Индекс].Период >= НачалоПериода Тогда
		Строка_ТЗ = _ТЗ.Добавить();
		ЗаполнитьСвойства(Строка_ТЗ, ТЗД[Индекс]);
		Строка_ТЗ.Показатель = "Разница количества оплат от пред. месяца";
		Строка_ТЗ.Значение 	 = ТЗД[Индекс].Значение;
		Строка_ТЗ.Сортировка = "1000";
		Строка_ТЗ.ТипЗначения = "Количественные";
		Строка_ТЗ.РасчетПо	 = 0;
		Строка_ТЗ.Период	 = ТЗД[Индекс].Период;		
		Строка_ТЗ = _ТЗ.Добавить();
		ЗаполнитьСвойства(Строка_ТЗ, ТЗД[Индекс]);
		Строка_ТЗ.Показатель = "Разница количества оплат от пред. года";
		Строка_ТЗ.Значение 	 = ТЗД[Индекс].Значение;
		Строка_ТЗ.Сортировка = "1100";
		Строка_ТЗ.ТипЗначения = "Количественные";
		Строка_ТЗ.РасчетПо	 = 0;
		Строка_ТЗ.Период	 = ТЗД[Индекс].Период;
	КонецЕсли;
	
КонецПроцедуры


Процедура СравниваемыйМесяц(_ТЗ, ТЗД, Индекс)
	
	//Динамика - месяц
	//проверка чтобы не добавлялись расчеты прошлого года в следующий месяц
	ПериодПлюсМесяц = ДобавитьМесяц(ТЗД[Индекс].Период, 1);
	Если ПериодПлюсМесяц >= НачалоПериода Тогда
		Строка_ТЗ = _ТЗ.Добавить();
		ЗаполнитьСвойства(Строка_ТЗ, ТЗД[Индекс]);
		Строка_ТЗ.Показатель = "Разница количества оплат от пред. месяца";
		Строка_ТЗ.Значение 	 = -ТЗД[Индекс].Значение;
		Строка_ТЗ.Сортировка = "1000";
		Строка_ТЗ.ТипЗначения = "Количественные";
		Строка_ТЗ.РасчетПо	 = 0;
		Строка_ТЗ.Период	 = ПериодПлюсМесяц;
	КонецЕсли;	
	//Динамика - год
	//проверка чтобы расчет не уходил в будущее
	ПериодПлюсГод = ДобавитьМесяц(ТЗД[Индекс].Период, 12);
	Если ПериодПлюсГод <= КонецПериода Тогда
		Строка_ТЗ = _ТЗ.Добавить();
		ЗаполнитьСвойства(Строка_ТЗ, ТЗД[Индекс]);
		Строка_ТЗ.Показатель = "Разница количества оплат от пред. года";
		Строка_ТЗ.Значение = -ТЗД[Индекс].Значение;
		Строка_ТЗ.Сортировка = "1100";
		Строка_ТЗ.ТипЗначения = "Количественные";
		Строка_ТЗ.РасчетПо	 = 0;
		Строка_ТЗ.Период	 = ПериодПлюсГод;
	КонецЕсли;
	
КонецПроцедуры
Процедура ЗаполнитьСвойства(Строка, Выборка)
	
	ЗаполнитьЗначенияСвойств(Строка, Выборка, "Период, Агент, Личная, ВидСП, Подразделение, НаправлениеПлатежа, Организация");	
	
КонецПроцедуры

Процедура ЗаполнитьТЗ(Выборка, ТЗ)
	
	кп = "Количественные";
	сп = "Суммовые";
	пп = "Процентные";	
	Эффективность = ВО  = "ДляЭффективности";
	Пока Выборка.Следующий() Цикл		
		Если НЕ ВидСП.Пустая() Тогда
			Если Выборка.ВидСП<>ВидСП Тогда
				продолжить
			КонецЕсли;	
		КонецЕсли;	
		Если Эффективность Тогда
			Строка = ТЗ.Добавить();		
			ЗаполнитьСвойства(Строка, Выборка);		
			Строка.Показатель	= "Количество оплат";
			Строка.Значение 	= Выборка.ВсегоОплат;
			Строка.Сортировка	= "$Количество__Оплат";
			Строка.ТипЗначения	= кп;
			Строка.РасчетПо		= 0;
			Строка.Динамика		= Истина;		
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Общая сумма начисленных взносов";
			Строка.Значение		= Выборка.НачисленнаяСуммаВзноса;
			Строка.Сортировка 	= "!СуммаНачисленнаяВзноса";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Скидка*Премия";
			Строка.Значение		= Окр(Выборка.СкидкаНаПремию, 2);
			Строка.Сортировка 	= "___СкидкаНаПремию";
			Строка.ТипЗначения	= Кп;
			Строка.РасчетПо		= 0;
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Общая сумма скидки";
			Строка.Значение		= Выборка.АВилиСкидкаСумма;
			Строка.Сортировка 	= "!СкидкаОбщаяСумма";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Сумма взноса первых";
			Строка.Значение		= Окр(Выборка.НачисленнаяСуммаВзносаПервых, 2);
			Строка.Сортировка 	= "_1СуммаНачисленнаяВзноса_Первых";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Сумма взноса вторых";
			Строка.Значение		= Окр(Выборка.НачисленнаяСуммаВзносаВторых, 2);
			Строка.Сортировка 	= "_2СуммаНачисленнаяВзносаВторых";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Скидка первых взносов";
			Строка.Значение		= Окр(Выборка.СкидкаПервых, 2);
			Строка.Сортировка 	= "_1СкидкаПервых";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			Строка = ТЗ.Добавить();
			ЗаполнитьСвойства(Строка, Выборка);
			Строка.Показатель	= "Скидка остальных взносов";
			Строка.Значение		= Окр(Выборка.СкидкаВторых, 2);
			Строка.Сортировка 	= "_2СкидкаВторых";
			Строка.ТипЗначения	= сп;
			Строка.РасчетПо		= 0;
			
			Строка = ТЗ.Добавить();
