Функция ДанныеПоПролонгациям()
	тз = Отчеты.уб_СтатистикаПоСтраховкам.ПустаяТЗ();	
	КэшСотрудников = Неопределено;
	ДатаКЭША = Неопределено;
	ЗапросПролонгации = Новый Запрос("ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Статус.Период, МЕСЯЦ) КАК Период,
	|	уб_ЗаданияНаПролонгацию.Ответственный КАК Агент,
	|	СУММА(ВЫБОР
	|			КОГДА уб_ЗаданияНаПролонгацию.ТипЗадания = ЛОЖЬ
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВсегоПролонгаций,
	|	СУММА(ВЫБОР
	|			КОГДА уб_ЗаданияНаПролонгацию.ТипЗадания = ИСТИНА
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоВторыхВзносов,
	|	СУММА(ВЫБОР
	|			КОГДА уб_ЗаданияНаПролонгацию.ТипЗадания = ЛОЖЬ
	|					И уб_ЗаданияНаПролонгацию.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыПролонгирования.Пролонгирован)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПролонгировано,
	|	СУММА(ВЫБОР
	|			КОГДА уб_ЗаданияНаПролонгацию.ТипЗадания = ИСТИНА
	|					И уб_ЗаданияНаПролонгацию.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыПролонгирования.Пролонгирован)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПринятоВзносов,
	|	уб_СтраховойПолис.СтраховойПродукт КАК ВидСП
	|ИЗ
	|	РегистрСведений.уб_ЗаданияНаПролонгацию КАК уб_ЗаданияНаПролонгацию
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	|		ПО уб_ЗаданияНаПролонгацию.СтраховойПолис = уб_СтраховойПолис.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_СтатусыПролонгации.СрезПоследних КАК Статус
	|		ПО (Статус.СтраховойПолис = уб_ЗаданияНаПролонгацию.СтраховойПолис)
	|			И (Статус.ТипЗадания = уб_ЗаданияНаПролонгацию.ТипЗадания)
	|ГДЕ
	|	уб_ЗаданияНаПролонгацию.ТекущийСтатус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыПролонгирования.Пролонгирован), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыПролонгирования.Отказ))
	|
	|СГРУППИРОВАТЬ ПО
	|	уб_ЗаданияНаПролонгацию.Ответственный,
	|	уб_СтраховойПолис.СтраховойПродукт.Вид,
	|	НАЧАЛОПЕРИОДА(Статус.Период, МЕСЯЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период");
	Выборка = ЗапросПролонгации.Выполнить().Выбрать();								
	Пока Выборка.Следующий() Цикл
		Период = Выборка.Период;
		Если Период = Null Или НЕ(Период>=НачалоПериода И Период<=КонецПериода) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ВидСП.Пустая() Тогда
			Если Выборка.ВидСП<>ВидСП Тогда
				продолжить
			КонецЕсли;	
		КонецЕсли;	
		Строка = тз.Добавить();	
		Строка.Показатель 			= "Обработано пролонгаций по 1С всего";
		Строка.Значение 			= Выборка.ВсегоПролонгаций;
		Строка.Период 				= Выборка.Период;
		Строка.Агент 				= Выборка.Агент;
		Строка.Личная 				= Ложь;
		Строка.ВидСП 				= Выборка.ВидСП;
		Строка.НаправлениеПлатежа 	= Перечисления.уб_НаправленияПлатежа.ВБрокер;
		Строка.ТипЗначения 			= "Количественные";
		Если КэшСотрудников = Неопределено ИЛИ ДатаКЭША <> Строка.Период Тогда
			КэшСотрудников = уб_КЭШируемые.ПолучитьСписокСотрудниковАктуальныхВМесяце(НачалоМесяца(Строка.Период),Истина);
			ДатаКЭША = Строка.Период;
		КонецЕсли;	
		
		МассивПодразделений = КэшСотрудников.НайтиСтроки(Новый Структура("Агент",Строка.Агент));
		Если МассивПодразделений.Количество()>0 Тогда
			
			СтрокаПодразделения = МассивПодразделений[0];
			
			Строка.Подразделение = СтрокаПодразделения.Подразделение;
			Строка.Организация   = СтрокаПодразделения.Организация
		Иначе
			Строка.Подразделение = "<Неизвестно>";
		КонецЕсли;
		//Если ФизЛицо.Пустая() Тогда
		//	Строка.Агент = Массив[КолонкаФИО];
		//КонецЕсли;	
		
		Строка.РасчетПо = 0;  // 0 - по сумме, 1 - по средней
		Строка.Сортировка = "#ОбработаноПролонгаций1С";
		
		Строка2 = тз.Добавить();	
		ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.ТипЗначения = "Количественные";
		Строка2.Значение = Выборка.КоличествоВторыхВзносов;
		Строка2.Показатель = "Обработано вторых взносов по 1С всего";
		Строка2.Сортировка = "^ОбработаноВторыхВзносов1С";
		
		//
		Строка2 = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Количество пролонгаций по 1С";
		Строка2.Значение		= Выборка.КоличествоПролонгировано;
		Строка2.Сортировка 	= "#Количество_Пролонгаций";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
		//
		Строка2 = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
		Строка2.Показатель	= "Количество вторых взносов";
		Строка2.Значение		= Окр(Выборка.КоличествоПринятоВзносов, 2);
		Строка2.Сортировка 	= "^Количество_Вторых";
		Строка2.ТипЗначения	= "Количественные";
		Строка2.РасчетПо		= 0;
		
	КонецЦикла;
	Строка2 = ТЗ.Добавить();
	//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
	Строка2.Показатель	= "Количество вторых взносов";
	Строка2.Значение		= 0;
	Строка2.Сортировка 	= "^Количество_Вторых";
	Строка2.ТипЗначения	= "Количественные";
	Строка2.РасчетПо		= 0;
	Строка2 = ТЗ.Добавить();
	//ЗаполнитьЗначенияСвойств(Строка2,Строка,,"ТипЗначения,Значение,Показатель,Сортировка");
	Строка2.Показатель	= "Количество пролонгаций по 1С";
	Строка2.Значение		= 0;
	Строка2.Сортировка 	= "#Количество_Пролонгаций";
	Строка2.ТипЗначения	= "Количественные";
	Строка2.РасчетПо		= 0;
	//тз.выбратьСтроку();
	Возврат тз;
