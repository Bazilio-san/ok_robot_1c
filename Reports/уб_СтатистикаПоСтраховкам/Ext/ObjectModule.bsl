Функция ДатаИзСтроки(дата,Вариант=1)
	Попытка
		Если Вариант=1 Тогда
			Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Дата,"-","")," ",""),":",""))
		Иначе
			Возврат Дата( Сред (Дата,7,4)+Сред (Дата,4,2)+Сред (Дата,1,2));
		КонецЕсли;	
	Исключение
		Возврат Дата(1,1,1);
	КонецПопытки;
