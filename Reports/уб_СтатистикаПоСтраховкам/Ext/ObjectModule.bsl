Функция ПолучитьСтатистикуИзБазы(dateStart,dateEnd) Экспорт
	
	ИмяФайлаОтправки = ПолучитьИмяВременногоФайла("tmp");
	
	ОбъектXML = Новый ЗаписьXML;
