		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	уб_ПеремещениеБСОБСО.СК,
	уб_ПеремещениеБСОБСО.ВидБСО,
	уб_ПеремещениеБСОБСО.НомерБСО,
	уб_ПеремещениеБСОБСО.ОрганизацияАгент,
	уб_ПеремещениеБСОБСО.Поставщик,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
ПОМЕСТИТЬ ЗаявкиСБСО
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПеремещениеБСО.БСО КАК уб_ПеремещениеБСОБСО
		ПО уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка = уб_ПеремещениеБСОБСО.Ссылка.СозданНаОсновании
ГДЕ
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &gt;= &amp;Дата1
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &lt;= &amp;Дата2
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаявкиСБСО.СК,
	ЗаявкиСБСО.ВидБСО,
	ЗаявкиСБСО.НомерБСО,
	ЗаявкиСБСО.ОрганизацияАгент,
	ЗаявкиСБСО.Поставщик,
	уб_ДвиженияБСОСрезПоследних.Регистратор,
	уб_ДвиженияБСОСрезПоследних.АгентОтправитель,
	уб_ДвиженияБСОСрезПоследних.Агент,
	уб_ДвиженияБСОСрезПоследних.ПоложениеБСО,
	уб_ДвиженияБСОСрезПоследних.СостояниеБСО,
	ЕСТЬNULL(уб_БлокировкаБСОСрезПоследних.Блокировка, ЛОЖЬ) КАК Блокировка,
	уб_ДвиженияБСОСрезПоследних.НомерПолиса,
	уб_ДвиженияБСОСрезПоследних.ГодПолиса,
	уб_ДвиженияБСОСрезПоследних.СтраховойПолис,
	уб_ДвиженияБСОСрезПоследних.НаОснованииБумажногоДокумента,
	уб_ДвиженияБСОСрезПоследних.ДатаВозврата,
	уб_ДвиженияБСОСрезПоследних.КодОперации,
	уб_ДвиженияБСОСрезПоследних.Комментарий,
	ЗаявкиСБСО.Ссылка КАК Заявка,
	1 КАК Количество
ИЗ
	ЗаявкиСБСО КАК ЗаявкиСБСО
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО.СрезПоследних КАК уб_ДвиженияБСОСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_БлокировкаБСО.СрезПоследних КАК уб_БлокировкаБСОСрезПоследних
			ПО уб_ДвиженияБСОСрезПоследних.ВидБСО = уб_БлокировкаБСОСрезПоследних.ВидБСО
				И уб_ДвиженияБСОСрезПоследних.СК = уб_БлокировкаБСОСрезПоследних.СК
				И уб_ДвиженияБСОСрезПоследних.НомерБСО = уб_БлокировкаБСОСрезПоследних.НомерБСО
		ПО ЗаявкиСБСО.ВидБСО = уб_ДвиженияБСОСрезПоследних.ВидБСО
			И ЗаявкиСБСО.НомерБСО = уб_ДвиженияБСОСрезПоследних.НомерБСО
			И ЗаявкиСБСО.СК = уб_ДвиженияБСОСрезПоследних.СК
			И ЗаявкиСБСО.Поставщик = уб_ДвиженияБСОСрезПоследних.Поставщик
			И (уб_ДвиженияБСОСрезПоследних.Подтверждено)
ГДЕ
	(НЕ уб_ДвиженияБСОСрезПоследних.Агент В (&amp;Агент)
				И 1 = 1
			ИЛИ уб_ДвиженияБСОСрезПоследних.СостояниеБСО = &amp;Оформлен)
	И ВЫБОР
			КОГДА &amp;ТолькоНеОформленные
				ТОГДА НЕ уб_ДвиженияБСОСрезПоследних.СостояниеБСО = &amp;Оформлен
						И НЕ уб_ДвиженияБСОСрезПоследних.СостояниеБСО = &amp;Испорчен
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
