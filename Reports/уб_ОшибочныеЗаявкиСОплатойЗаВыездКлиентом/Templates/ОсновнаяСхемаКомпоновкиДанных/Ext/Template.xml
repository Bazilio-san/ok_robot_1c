			<field>СуммаПоСтрокам</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	З.Ссылка,
	СЗ.Статус
ПОМЕСТИТЬ ВТ_Ошибочные
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК З
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК ПОП
		ПО З.Ссылка = ПОП.Заявка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат КАК П
		ПО З.Ссылка = П.Заявка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК СЗ
		ПО (СЗ.Заявка = З.Ссылка)
ГДЕ
	З.Проведен
	И НЕ З.Самовыезд
	И З.Утверждено
	И З.ИсточникФинансирования = ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Клиент)
	И (З.Дата &lt; ДАТАВРЕМЯ(2013, 11, 1, 0, 0, 0)
			ИЛИ НЕ СЗ.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗапросНаУдаление), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.Удалена)))
	И З.Дата &lt; &amp;Дата
	И НЕ ЕСТЬNULL(ПОП.Ссылка.ПометкаУдаления, ЛОЖЬ)
	И НЕ ЕСТЬNULL(П.ПометкаУдаления, ЛОЖЬ)
	И (&amp;ПолныеПрава
			ИЛИ З.Менеджер В (&amp;СписокПодчиненных))

СГРУППИРОВАТЬ ПО
	З.Ссылка,
	СЗ.Статус

ИМЕЮЩИЕ
	МАКСИМУМ(ВЫБОР
			КОГДА ПОП.Ссылка.ВознаграждениеКурьераКлиентом = З.ВознаграждениеКурьера
					ИЛИ П.ВознаграждениеКурьераКлиентом = З.ВознаграждениеКурьера
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Ошибочные.Ссылка КАК Заявка,
	П.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВТ_Приемки
ИЗ
	ВТ_Ошибочные КАК ВТ_Ошибочные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат КАК П
		ПО ВТ_Ошибочные.Ссылка = П.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_Ошибочные.Ссылка,
	П.Ссылка

ИМЕЮЩИЕ
	КОЛИЧЕСТВО(П.Полисы.НомерСтроки) = 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТ_Ошибочные.Ссылка,
	ПОП.Ссылка
ИЗ
	ВТ_Ошибочные КАК ВТ_Ошибочные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК ПОП
		ПО (ПОП.Заявка = ВТ_Ошибочные.Ссылка)

СГРУППИРОВАТЬ ПО
	ВТ_Ошибочные.Ссылка,
	ПОП.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Ошибочные.Ссылка КАК Заявка,
	ЕСТЬNULL(ВТ_Приемки.Ссылка, ЗНАЧЕНИЕ(Документ.уб_ПриемкаОплат.ПустаяСсылка)) КАК Приемка,
	ВТ_Ошибочные.Статус КАК Статус,
	ЕСТЬNULL(ВТ_Приемки.Ссылка.Сумма, 0) КАК Сумма,
	ЕСТЬNULL(СУММА(ПОП.Сумма), 0) КАК СуммаПоСтрокам,
	ЕСТЬNULL(ВТ_Приемки.Ссылка.ВознаграждениеКурьераКлиентом, 0) КАК ВознаграждениеКурьераКлиентом,
	ВТ_Ошибочные.Ссылка.ВознаграждениеКурьера КАК ВознаграждениеКурьера,
	ВЫБОР
		КОГДА ВТ_Приемки.Ссылка ЕСТЬ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК НетПриемок,
	ВТ_Ошибочные.Ссылка.Менеджер КАК Менеджер,
	ВТ_Ошибочные.Ссылка.Курьер КАК Курьер
ИЗ
	ВТ_Ошибочные КАК ВТ_Ошибочные
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Приемки КАК ВТ_Приемки
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК ПОП
			ПО ВТ_Приемки.Ссылка = ПОП.Ссылка
		ПО ВТ_Ошибочные.Ссылка = ВТ_Приемки.Заявка

СГРУППИРОВАТЬ ПО
	ВТ_Ошибочные.Ссылка,
	ЕСТЬNULL(ВТ_Приемки.Ссылка, ЗНАЧЕНИЕ(Документ.уб_ПриемкаОплат.ПустаяСсылка)),
	ВТ_Ошибочные.Статус,
	ЕСТЬNULL(ВТ_Приемки.Ссылка.Сумма, 0),
	ЕСТЬNULL(ВТ_Приемки.Ссылка.ВознаграждениеКурьераКлиентом, 0),
	ВТ_Ошибочные.Ссылка.ВознаграждениеКурьера,
	ВЫБОР
		КОГДА ВТ_Приемки.Ссылка ЕСТЬ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	ВТ_Ошибочные.Ссылка.Менеджер,
	ВТ_Ошибочные.Ссылка.Курьер</query>
