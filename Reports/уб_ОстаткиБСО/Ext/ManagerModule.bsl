Функция УстановитьПоложениеБСО(Тип = "Все") Экспорт

СписокПоложений = Новый СписокЗначений;
Если Тип = "Все" или Тип = "БСО" Тогда
	СписокПоложений.Добавить(Перечисления.уб_ПоложенияБСО.ПолученИзСК);
	СписокПоложений.Добавить(Перечисления.уб_ПоложенияБСО.ВозвращенИзСК);
	СписокПоложений.Добавить(Перечисления.уб_ПоложенияБСО.ВозвращенСТочки);	
КонецЕсли;

Если Тип = "Все" или Тип = "Агенты" Тогда
	СписокПоложений.Добавить(Перечисления.уб_ПоложенияБСО.ПереданНаТочку);
КонецЕсли;	
ПоложениеБСО = СписокПоложений;
Возврат ПоложениеБСО;

КонецФункции //

Функция УстановитьТипУчетаБСО(Тип = "Все") Экспорт

СписокПоложений = Новый СписокЗначений;
Если Тип = "Все" Тогда
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.НомернойЕстьПолис);
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.НомернойНетПолиса);
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.НомернойПолисВручную);	
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.НомернойПолисИзСвободных);
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.НомернойПолисСоответствуетНомеруБСО);	
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.УчетНеВедетсяПолисВручную);
	СписокПоложений.Добавить(Перечисления.уб_ТипыУчетаБСО.УчетНеВедетсяПолисИзСвободных);	
КонецЕсли;

ПоложениеБСО = СписокПоложений;
Возврат ПоложениеБСО;

КонецФункции //


