		<query>ВЫБРАТЬ
	уб_РасчетыСПоставщиками.Контрагент,
	уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику КАК ОтчетПоставщику,
	СУММА(уб_РасчетыСПоставщиками.Сумма) КАК СуммаПоВзносам,
	СУММА(ВЫБОР
			КОГДА уб_РасчетыСПоставщиками.СуммаКВ &gt; 0
					И уб_РасчетыСПоставщиками.Сумма &gt; 0
				ТОГДА уб_РасчетыСПоставщиками.СуммаКВ
			ИНАЧЕ 0
		КОНЕЦ) КАК КВПоВзносам,
	СУММА(ВЫБОР
			КОГДА уб_РасчетыСПоставщиками.СуммаКВ &gt; 0
					И уб_РасчетыСПоставщиками.Сумма = 0
				ТОГДА уб_РасчетыСПоставщиками.СуммаКВ
			ИНАЧЕ 0
		КОНЕЦ) КАК КВПоВзносамОплаченнымПоставщику,
	СУММА(0) КАК ПеречисленоПоставщику,
	СУММА(0) КАК ПоступилоОтПоставщика,
	ВЫБОР
		КОГДА уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
			ТОГДА уб_РасчетыСПоставщиками.Регистратор
		ИНАЧЕ уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику
	КОНЕЦ КАК Регистратор
ИЗ
	РегистрНакопления.уб_РасчетыСПоставщиками КАК уб_РасчетыСПоставщиками
ГДЕ
	уб_РасчетыСПоставщиками.Активность
	И уб_РасчетыСПоставщиками.Контрагент = &amp;Контрагент
	И уб_РасчетыСПоставщиками.Регистратор ССЫЛКА Документ.уб_ОплатаПолисов
	И ВЫБОР
			КОГДА уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
				ТОГДА уб_РасчетыСПоставщиками.Период &lt;= &amp;ДоДаты
			ИНАЧЕ уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику.Дата &lt;= &amp;ДоДаты
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	уб_РасчетыСПоставщиками.Контрагент,
	уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику,
	ВЫБОР
		КОГДА уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
			ТОГДА уб_РасчетыСПоставщиками.Регистратор
		ИНАЧЕ уб_РасчетыСПоставщиками.Регистратор.ОтчетПоставщику
	КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	уб_РасчетыСПоставщиками.Контрагент,
	ЕСТЬNULL(ЕСТЬNULL(уб_ОтчетПоставщикуПлатежныйДокумент.Ссылка, уб_ОтчетПоставщику.Ссылка), ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)),
	СУММА(0),
	СУММА(0),
	СУММА(0),
	СУММА(ВЫБОР
			КОГДА уб_РасчетыСПоставщиками.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА уб_РасчетыСПоставщиками.Сумма
			ИНАЧЕ -уб_РасчетыСПоставщиками.Сумма
		КОНЕЦ),
	СУММА(ВЫБОР
			КОГДА уб_РасчетыСПоставщиками.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА уб_РасчетыСПоставщиками.СуммаКВ
			ИНАЧЕ -уб_РасчетыСПоставщиками.СуммаКВ
		КОНЕЦ),
	уб_РасчетыСПоставщиками.Регистратор
ИЗ
	РегистрНакопления.уб_РасчетыСПоставщиками КАК уб_РасчетыСПоставщиками
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ОтчетПоставщику.ПлатежныйДокумент КАК уб_ОтчетПоставщикуПлатежныйДокумент
		ПО уб_РасчетыСПоставщиками.Регистратор = уб_ОтчетПоставщикуПлатежныйДокумент.ПлатежныйДокумент
			И (уб_ОтчетПоставщикуПлатежныйДокумент.Ссылка.Проведен)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ОтчетПоставщику КАК уб_ОтчетПоставщику
		ПО (уб_РасчетыСПоставщиками.Регистратор.СуммаКВ - уб_ОтчетПоставщику.ИтогОС_КВ &lt;= 0.05)
			И (уб_РасчетыСПоставщиками.Регистратор.СуммаКВ - уб_ОтчетПоставщику.ИтогОС_КВ &gt;= -0.05)
			И (уб_РасчетыСПоставщиками.Регистратор.СуммаКВ &gt; 0)
			И (уб_ОтчетПоставщику.ИтогОС_КВ &gt; 0)
			И (уб_ОтчетПоставщику.Проведен)
ГДЕ
	уб_РасчетыСПоставщиками.Активность
	И уб_РасчетыСПоставщиками.Контрагент = &amp;Контрагент
	И уб_РасчетыСПоставщиками.Регистратор ССЫЛКА Документ.уб_ПлатежнаяВедомость
	И уб_РасчетыСПоставщиками.Период &lt;= &amp;ДоДаты

СГРУППИРОВАТЬ ПО
	уб_РасчетыСПоставщиками.Контрагент,
	ЕСТЬNULL(ЕСТЬNULL(уб_ОтчетПоставщикуПлатежныйДокумент.Ссылка, уб_ОтчетПоставщику.Ссылка), ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)),
	уб_РасчетыСПоставщиками.Регистратор</query>
