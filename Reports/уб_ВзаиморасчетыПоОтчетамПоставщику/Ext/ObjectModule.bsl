	//								|	И НЕ ПлатежныеВедомости.Ссылка.ИсключитьИзВзаиморасчетов
	//								|	И ВЫБОР
	//								|			КОГДА ПлатежныеВедомости.Ссылка.Контрагент.ДатаВеденияВзаиморасчётов = ДАТАВРЕМЯ(1, 1, 1)
	//								|				ТОГДА ИСТИНА
	//								|			КОГДА ПлатежныеВедомости.ОтчетПоставщику ССЫЛКА Документ.уб_ОтчетПоставщику
	//								|					И НЕ ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|				ТОГДА ПлатежныеВедомости.ОтчетПоставщику.Дата >= ПлатежныеВедомости.Ссылка.Контрагент.ДатаВеденияВзаиморасчётов
	//								|			ИНАЧЕ ПлатежныеВедомости.Ссылка.Дата >= ПлатежныеВедомости.Ссылка.Контрагент.ДатаВеденияВзаиморасчётов
	//								|		КОНЕЦ
	//								|	И НЕ ПлатежныеВедомости.Ссылка.НаправлениеРасчетов В (ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.СкидкаКлиенту),ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.БрокеруПоБезналу),ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ОтБрокераПоБезналу))
	//								|
	//								|СГРУППИРОВАТЬ ПО
	//								|	ПлатежныеВедомости.Ссылка.Контрагент,
	//								|	ВЫБОР
	//								|		КОГДА ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|			ТОГДА ПлатежныеВедомости.Ссылка.Дата
	//								|		ИНАЧЕ ПлатежныеВедомости.ОтчетПоставщику.Дата
	//								|	КОНЕЦ,
	//								|	ПлатежныеВедомости.ОтчетПоставщику,
	//								|	ВЫБОР
	//								|		КОГДА ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|			ТОГДА ПлатежныеВедомости.Ссылка
	//								|		ИНАЧЕ ПлатежныеВедомости.ОтчетПоставщику
	//								|	КОНЕЦ,
	//								|	ПлатежныеВедомости.Ссылка,
	//								|	ВЫБОР
	//								|		КОГДА ПлатежныеВедомости.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.НачальныйОстаток)
	//								|			ТОГДА ""Начальный остаток""
	//								|		ИНАЧЕ ВЫБОР
	//								|				КОГДА ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|					ТОГДА ПлатежныеВедомости.Ссылка
	//								|				ИНАЧЕ ПлатежныеВедомости.ОтчетПоставщику
	//								|			КОНЕЦ
	//								|	КОНЕЦ,
	//								|	ПлатежныеВедомости.Ссылка.ОрганизацияАгент,
	//								|	ПлатежныеВедомости.ОтчетПоставщику.НомерОтчетаПоставщику,
	//								|	ПлатежныеВедомости.ОтчетПоставщику.Номер,
	//								|	ВЫБОР
	//								|		КОГДА ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка)
	//								|		ИНАЧЕ ПлатежныеВедомости.ОтчетПоставщику.ВидСП
	//								|	КОНЕЦ,
	//								|	ПлатежныеВедомости.Ссылка.ФормаОплаты,
	//								|	ПлатежныеВедомости.Ссылка.НаправлениеРасчетов,
	//								|	ПлатежныеВедомости.Ссылка.НомерВходящегоДокумента,
	//								|	ПлатежныеВедомости.Ссылка.ДатаВходящегоДокумента,
	//								|	ПлатежныеВедомости.Ссылка.Дата,
	//								|	ПлатежныеВедомости.Ссылка.Номер,
	//								|	ВЫБОР
	//								|		КОГДА ПлатежныеВедомости.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	//								|			ТОГДА ПлатежныеВедомости.Ссылка.Дата
	//								|		ИНАЧЕ ПлатежныеВедомости.ОтчетПоставщику.Дата
	//								|	КОНЕЦ
	//								|;
	//								|
	//								|////////////////////////////////////////////////////////////////////////////////
	//								|ВЫБРАТЬ
	//								|	ВзаиморасчетыПоПлатежам.Организация,
	//								|	ВзаиморасчетыПоПлатежам.Контрагент,
	//								|	ВзаиморасчетыПоПлатежам.ОтчетПоставщику,
	//								|	ВзаиморасчетыПоПлатежам.Сортировка,
	//								|	ВзаиморасчетыПоПлатежам.Представление,
	//								|	ВзаиморасчетыПоПлатежам.ЗадолженностьПередПоставщиком,
	//								|	ВзаиморасчетыПоПлатежам.СуммаПоВзносам,
	//								|	ВзаиморасчетыПоПлатежам.КВПоВзносам,
	//								//|	ВзаиморасчетыПоПлатежам.КВПоВзносамОплаченнымПоставщику,
	//							 //   |	ВзаиморасчетыПоПлатежам.КВ,
	//								|	ВзаиморасчетыПоПлатежам.КВДоп,
	//								|	ВзаиморасчетыПоПлатежам.ПеречисленоПоставщику,
	//								|	ВзаиморасчетыПоПлатежам.ПоступилоОтПоставщика,
	//								|	ВзаиморасчетыПоПлатежам.ПоступилоОтПоставщика - ВзаиморасчетыПоПлатежам.ПеречисленоПоставщику КАК Задолженность2,
	//								|	ВзаиморасчетыПоПлатежам.Регистратор,
	//								|	ЕСТЬNULL(уб_КомментарииКВзаиморасчетам.КомментарийДляСК, """") КАК КомментарийДляСК,
	//								|	ЕСТЬNULL(уб_КомментарииКВзаиморасчетам.КомментарийВнутренний, """") КАК КомментарийВнутренний,
	//								//|	ВзаиморасчетыПоПлатежам.КоличествоВГруппе КАК Элементов,
	//								|	ВзаиморасчетыПоПлатежам.ОтчетПоставщикуНомерОтчетаПоставщику,
	//								|	ВзаиморасчетыПоПлатежам.ОтчетПоставщикуНомер,
	//								|	ВзаиморасчетыПоПлатежам.ОтчетПоставщикуДата,
	//								|	ВзаиморасчетыПоПлатежам.ВидСП,
	//								|	ВзаиморасчетыПоПлатежам.ФормаОплаты,
	//								|	ВзаиморасчетыПоПлатежам.НаправлениеРасчетов,
	//								|	ВзаиморасчетыПоПлатежам.НомерВходящегоДокумента,
	//								|	ВзаиморасчетыПоПлатежам.ДатаВходящегоДокумента,
	//								|	ВзаиморасчетыПоПлатежам.Дата,
	//								|	ВзаиморасчетыПоПлатежам.Номер
	//								|ИЗ
	//								|	ВзаиморасчетыПоПлатежам КАК ВзаиморасчетыПоПлатежам
	//								|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_КомментарииКВзаиморасчетам КАК уб_КомментарииКВзаиморасчетам
	//								|		ПО ВзаиморасчетыПоПлатежам.ОтчетПоставщику = уб_КомментарииКВзаиморасчетам.Документ";	
	Если ВыбранКонтрагент Тогда
		ТекстБазовый = Стрзаменить(ТекстБазовый,"2 = 2","ПлатежныеВедомости.Ссылка.Контрагент = &Контрагент");
		ТекстБазовый = Стрзаменить(ТекстБазовый,"3 = 3","ДВОУ.Поставщик = &Контрагент");
	КонецЕсли;
	Возврат ТекстБазовый;//+"
