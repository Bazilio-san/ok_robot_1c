Функция ПолучитьДанныеДляКомпоновки(Параметры) Экспорт 
	//----Группировки----
	//Организация
	//Контрагент
	//ОтчетПоставщику
	//Представление
	//Сортировка
	//Регистратор
	//ПредставлениеРегистратора
	//----Используемые поля----
	//Пустышка
	//Элементов2
	//ЗадолженностьПередПоставщиком
	//СуммаПоВзносам
	//КВПоВзносам
	//КВДоп
	//ПеречисленоПоставщику
	//ПоступилоОтПоставщика
	//Задолженность
	//Задолженность2
	//КомментарийВнутренний
	//КомментарийДляСК
	//---Для отборов
	//ОтчетПоставщикуДата
	//ВидСП
	
	//СуммаПоВзносам-КВПоВзносам-КВДоп-ПеречисленоПоставщику+ПоступилоОтПоставщика//Задолженность
	//СуммаПоВзносам-КВПоВзносам-ЗадолженностьПередПоставщиком                    //Разница
	ПоказыватьЗакрытыеВзаиморасчеты = Параметры.ПоказыватьЗакрытыеВзаиморасчеты;
	Диапазон  = Параметры.Диапазон;
	СтадииДанных  = Параметры.СтадииДанных;
	Поставщик  = Параметры.Поставщик;
	ОрганизацияАгент  = Параметры.ОрганизацияАгент;
	ДатаДо  = Параметры.ДатаДо;
	БезДопКВ  = Параметры.БезДопКВ;
	ДетализироватьОП = Параметры.ДетализироватьОП;
	НеПоказыватьОтчетыБезЗадолженности = Параметры.НеПоказыватьОтчетыБезЗадолженности;
	ИсключатьНесогласованные = Параметры.ИсключатьНесогласованные;
	ВидСП = Параметры.ВидСП;
	НамДолжны = Параметры.НамДолжны;
	МыДолжны = Параметры.МыДолжны;
	
	ТолькоПоставщику = Параметры.ТолькоПоставщику;
	ТолькоОплатыБрокеру = Параметры.ТолькоОплатыБрокеру;
	//Если ТолькоПоставщику = Истина Тогда
	//	ДетализироватьОП = Истина;
	//КонецЕсли;
	
	
	
	ЗапросПоВзаиморасчетам = Новый Запрос();
	ЗапросПоВзаиморасчетам.Текст = ТекстЗапроса(Параметры);
	ЗапросПоВзаиморасчетам.УстановитьПараметр("ПоказыватьЗакрытыеВзаиморасчеты",ПоказыватьЗакрытыеВзаиморасчеты);
	
	
	Если СтадииДанных = "Только актуальные ОП" Тогда
		Стадия = 2;
	ИначеЕсли СтадииДанных = "Только ОП (актуальные  и неактуальные)" Тогда
		Стадия = 1;
	ИначеЕсли СтадииДанных = "Все ОП + оплаты не вошедшие в отчеты" Тогда
		Стадия = 0;
	КонецЕсли;	
	
	ЗапросПоВзаиморасчетам.УстановитьПараметр("Стадия",						Стадия);
	ЗапросПоВзаиморасчетам.УстановитьПараметр("Контрагент",					Поставщик);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("Организации",				ОрганизацияАгент);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("ДоДаты",						ДатаДо);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("ИсключатьНесогласованные",	ИсключатьНесогласованные);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("БезДопКВ",					БезДопКВ);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("ДетализироватьОП",			ДетализироватьОП);								   
	ЗапросПоВзаиморасчетам.УстановитьПараметр("ДатаСреза",			КонецДня(ТекущаяДата()));								   
	#Если Клиент Тогда
	Состояние("Получение данных");
	#КонецЕсли
	Результат = ЗапросПоВзаиморасчетам.Выполнить();	
	
	ТаблицаЗначений = Результат.Выгрузить();
	ТаблицаЗначений.Колонки.Добавить("ПредставлениеРегистратора");	
	
	ТипОплата = Тип("ДокументСсылка.уб_ОплатаПолисов");
	ТипОП     = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	ТипПлатеж = Тип("ДокументСсылка.уб_ВзаиморасчетСПоставщиком");
	ТипДВОУ = Тип("ДокументСсылка.уб_ДополнительныеРасчетыСПоставщикомДВОУШтрафы");
	пВидОперации = Перечисления.уб_ВидОперацииВзаиморасчетов;
	//Выборка = Результат.Выбрать();
	//Пока Выборка.Следующий() Цикл
	ТаблицаЗначений.Индексы.Добавить("ОтчетПоставщику");//Добавляем индекс для быстрого поиска
	//Для оптимизации Представления
	ПредОтчет = Неопределено;
	ПредПредставлениеОтчета = Неопределено;
	
	#Если Клиент Тогда
//		Состояние("Обработка данных");
	Состояние("Контроль задолженностей");
	#КонецЕсли	
	ТаблицаЗначений.Индексы.Добавить("Регистратор");	
	
	ВремТЗ = ТаблицаЗначений.Скопировать(,"ОтчетПоставщику,ОтчетПоставщикуДата,ТипПоляОтчетПоставщику,Задолженность2,ЗадолженностьПередПоставщиком,СуммаПоВзносам,КВПоВзносам,КВДоп,ПеречисленоПоставщику,ПоступилоОтПоставщика");
	
	//		ВремТЗ.СОртировать("ОтчетПоставщику");
	//ВремТЗ.Свернуть("ОтчетПоставщику,ВидСП","Задолженность2");
	ВремТЗ.Свернуть("ОтчетПоставщику,ОтчетПоставщикуДата,ТипПоляОтчетПоставщику","Задолженность2,ЗадолженностьПередПоставщиком,СуммаПоВзносам,КВПоВзносам,КВДоп,ПеречисленоПоставщику,ПоступилоОтПоставщика");
	ТаблицаЗначений.Индексы.Добавить("ОтчетПоставщику");
	//ТаблицаЗначений.Индексы.Добавить("ВидСП");
	
	ТаблицаЗначений.Колонки.Добавить("ЗадолженностьОтчета");
//	ТаблицаЗначений.Колонки.Добавить("ФормаОплаты");
	
	МассивУчтенныхОП = Новый Массив;
	Для каждого строка из ВремТЗ Цикл
		УдаляемСтроку = Ложь;
		ФактЗадолженность = строка.Задолженность2;
		УдаляемСтроку  = (НеПоказыватьОтчетыБезЗадолженности И ФактЗадолженность >= -Диапазон И ФактЗадолженность <= Диапазон) ИЛИ (ЗначениеЗаполнено(ВидСП)И(Строка.ВидСП <> ВидСП));
		//Если НЕ УдаляемСтроку и НамДолжны = ИСТИНА Тогда
		//	Если строка.Задолженность2<0 и (строка.Задолженность2+  строка.КВПоВзносам+строка.КВДоп) = 0 Тогда
		//	Иначе	
		//		УдаляемСтроку  =Истина;
		//	КонецЕсли	
		//КонецЕсли;	
		//
		//Если НЕ УдаляемСтроку и МыДолжны = ИСТИНА Тогда
		//	Если строка.Задолженность2<0 и (строка.Задолженность2+  строка.КВПоВзносам+строка.КВДоп) = 0 Тогда
		//	Иначе	
		//		УдаляемСтроку  =Истина;
		//	КонецЕсли	
		//КонецЕсли;	
		Если НЕ УдаляемСтроку Тогда
			
			//Если строка.Задолженность2<0 и (строка.Задолженность2+  строка.КВПоВзносам+строка.КВДоп) = 0 и НамДолжны = ИСТИНА Тогда
			Если строка.Задолженность2<0 и НамДолжны = ИСТИНА Тогда
			ИначеЕсли строка.Задолженность2>0 и МыДолжны = ИСТИНА Тогда	
			Иначе
				УдаляемСтроку = Истина;
			КонецЕсли;	
			
		КонецЕсли;	
		
				
		Если УдаляемСтроку Тогда
			ПозОтчета = ТаблицаЗначений.Найти(Строка.ОтчетПоставщику, "ОтчетПоставщику");
			Если ПозОтчета = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			Пока НЕ ПозОтчета = Неопределено Цикл
				ТаблицаЗначений.Удалить(ПозОтчета);
				ПозОтчета = ТаблицаЗначений.Найти(Строка.ОтчетПоставщику,  "ОтчетПоставщику");
			КонецЦикла;	
		Иначе
			//Если МассивУчтенныхОП.Найти(Строка.ОтчетПоставщику) = Неопределено Тогда
			//	МассивУчтенныхОП.Добавить(Строка.ОтчетПоставщику);
	//			Строки = ТаблицаЗначений.НайтиСтроки(Новый Структура("ОтчетПоставщику,ВидСП", Строка.ОтчетПоставщику,Строка.ВидСП));
				Строки = ТаблицаЗначений.НайтиСтроки(Новый Структура("ОтчетПоставщику", Строка.ОтчетПоставщику));
				ТипПоляОтчетПоставщику =  Строка.ТипПоляОтчетПоставщику;
				Если ТипПоляОтчетПоставщику = Тип("Строка") или Строка.ОтчетПоставщику.Пустая() Тогда
					НоваяДатаОтчета  = ТекущаяДата();
				Иначе		
					Попытка
						НоваяДатаОтчета = Строка.ОтчетПоставщикуДата;
					Исключение
						НоваяДатаОтчета  = ТекущаяДата();
					КонецПопытки;	
				КонецЕсли;
				//!Тут
				// в перем Строка нет доп. реквизитов, получение расширенных данных представления сложно, сделал в цикле
				ПредПредставлениеОтчета = Неопределено;
				
				ИтогиПоОплатам = Новый Структура("СуммаПоВзносам,КВПоВзносам,КВДоп,ПеречисленоПоставщику,ПоступилоОтПоставщика",
				0,0,0,0,0);
				КлючиПоОплатам = Новый ФиксированнаяСтруктура(ИтогиПоОплатам);
				Для каждого ПодСтрока из Строки Цикл
					
					ПодСтрока.ЗадолженностьОтчета 	= ФактЗадолженность;
					ПодСтрока.ОтчетПоставщикуДата 	= НоваяДатаОтчета;
					//ПодСтрока.Представление 		= "Отчет № " + СокрП(ПодСтрока.ОтчетПоставщикуНомерОтчетаПоставщику) + " (№ " + СтрЗаменить(ПодСтрока.ОтчетПоставщикуНомер, Символ(160),"") + ")" + " от " + Формат(НоваяДатаОтчета,"ДФ=dd.MM.yyyy");;
					Выборка = ПодСтрока;
					//Если ТаблицаЗначений.Найти(Выборка.Регистратор,"Регистратор") = Неопределено Тогда
					//НоваяСтрока = ТаблицаЗначений.Добавить();
					//ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);		
					//ТипПоляРегистратора = ТипЗНЧ(Выборка.Регистратор);
					ТипПоляРегистратора = Выборка.ТипПоляРегистратора;
					
					Если ПредОтчет = Выборка.ОтчетПоставщику Тогда
						ПодСтрока.Представление = ПредПредставлениеОтчета;
					ИначеЕсли ТипПоляОтчетПоставщику = ТипОП Тогда
						ПодСтрока.Представление = "№ "+СокрП(Выборка.ОтчетПоставщикуНомерОтчетаПоставщику)+" (№ "+СтрЗаменить(Выборка.ОтчетПоставщикуНомер,Символ(160),"")+")"+" от "+Формат(Выборка.ОтчетПоставщикуДата,"ДФ=dd.MM.yy");
					ИначеЕсли ТипПоляОтчетПоставщику = ТипПлатеж И Выборка.ОтчетПоставщику = Выборка.Регистратор Тогда	
						ПодСтрока.Представление = ПредставлениеПлатежа(Выборка);
					КонецЕсли;	
					ПредОтчет = Выборка.ОтчетПоставщику;
					ПредПредставлениеОтчета = ПодСтрока.Представление;
					Если ТипПоляРегистратора = ТипПлатеж Тогда
						ПодСтрока.ПредставлениеРегистратора= ПредставлениеПлатежа(Выборка);
						//Если ТипПоляОтчетПоставщику = ТипПлатеж и НЕ Выборка.ОтчетПоставщику = Выборка.Регистратор Тогда
						//Возвраты ошибочно перечисленные, связаны друг с другом
						нСтроки = ТаблицаЗначений.НайтиСтроки(Новый Структура("ОтчетПоставщику",Выборка.Регистратор));
						Для каждого нСтрока из нСтроки Цикл
							нСтрока.Представление = ПодСтрока.ПредставлениеРегистратора;
						КонецЦикла;	
						
						//Иначе	
						//КонецЕсли;	
					ИначеЕсли ДетализироватьОП И ТипПоляРегистратора = ТипОплата Тогда
						Если ТолькоПоставщику Тогда
							ПодСтрока.ПредставлениеРегистратора = "Оплата полиса № "+СокрЛП(Выборка.НОмерПолиса)+" ("+Выборка.НомерОплаты+" от "+Формат(Выборка.Дата,"ДФ=dd.MM.yyyy")+") "+Выборка.Страхователь;
						Иначе	
							ПодСтрока.ПредставлениеРегистратора = "Оплата полиса № "+СокрЛП(Выборка.НОмерПолиса)+" ("+Выборка.НомерОплаты+") "+Выборка.Страхователь;
						КонецЕсли;	
						
						
						ИдетВИтоги = Ложь;
						
						Если ТолькоПоставщику = Истина Тогда
							//дСтрока.ФормаОплаты = Выборка.ФормаОплаты;
							Если ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику Тогда 
								ИдетВИтоги = Истина;
							КонецЕсли;	
						ИначеЕсли ТолькоОплатыБрокеру Тогда
							//ПодСтрока.ФормаОплаты = Выборка.ФормаОплаты;
							Если ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Безнал 
								//или ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ВКредит
								или ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.НаКарту
								или ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Терминал
								или ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПоСсылкеБрокеру
								Тогда
								//подмена формы
								ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса; 
								ИдетВИтоги = Истина;
							ИначеЕсли ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Тогда	
								ИдетВИтоги = Истина;
							КонецЕсли;	
						КонецЕсли;	
						
						Если ИдетВИтоги  Тогда
							Для каждого Ключ из КлючиПоОплатам Цикл
								ИтогиПоОплатам[Ключ.Ключ] = ИтогиПоОплатам[Ключ.Ключ]+ ПодСтрока[Ключ.Ключ];
							КонецЦикла;
						КонецЕсли;
					Иначе 
						Если ТипПоляРегистратора = ТипОП Тогда
							Если Выборка.Регистратор = Выборка.ОтчетПоставщику Тогда
								ПодСтрока.ПредставлениеРегистратора = ПредПредставлениеОтчета;
							Иначе	
								ПодСтрока.ПредставлениеРегистратора= "Отчет № "+СокрП(Выборка.ОтчетПоставщикуНомерОтчетаПоставщику)+" (№ "+СтрЗаменить(Выборка.ОтчетПоставщикуНомер,Символ(160),"")+")";
							КонецЕсли;	
						Иначе	
							ПодСтрока.ПредставлениеРегистратора	= Выборка.Регистратор;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;	
				//
				//Если ДетализироватьОП = Истина Тогда
				Если ТолькоПоставщику = Истина или ТолькоОплатыБрокеру Тогда
					Если ИтогиПоОплатам.СуммаПоВзносам = 0 Тогда
						Алго=1;
					ИначеЕсли ИтогиПоОплатам.СуммаПоВзносам = Строка.СуммаПоВзносам  Тогда
						//Все взносы совпали значит все перечисления относятся к виду
						Алго=2;
						Для каждого ПодСтрока из Строки Цикл
							Если ПодСтрока.ПеречисленоПоставщику<>0  или ПодСтрока.ПоступилоОтПоставщика<>0 Тогда
								Если ТолькоПоставщику = Истина Тогда
									ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику;
								ИначеЕсли ТолькоОплатыБрокеру Тогда
									ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса;
								КонецЕсли;	
							КонецЕсли;	
						КонецЦикла;	
					Иначе
						Если Строка.ПеречисленоПоставщику = 0 Тогда
						ИначеЕсли Строка.ПеречисленоПоставщику = ИтогиПоОплатам.СуммаПоВзносам Тогда
							Алго = 3;
							Для каждого ПодСтрока из Строки Цикл
								Если ПодСтрока.ПеречисленоПоставщику<>0 и ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка() Тогда
									Если ТолькоПоставщику = Истина Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику;
									ИначеЕсли ТолькоОплатыБрокеру Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса;
									КонецЕсли;	
								КонецЕсли;	
							КонецЦикла;		
						//ИначеЕсли (Строка.СуммаПоВзносам-Строка.КВПоВзносам)= Строка.ПеречисленоПоставщику Тогда
						//	Алго = 7;
						//	//перечислили все, но взносов по выбраному виду меньше
						ИначеЕсли Строка.ПеречисленоПоставщику <>0 Тогда
							Алго = 8; //что-то перечислили берем пропорционально
							КоэффициентПеречисления = ИтогиПоОплатам.СуммаПоВзносам/Строка.СуммаПоВзносам;
							Для каждого ПодСтрока из Строки Цикл
								Если ПодСтрока.ПеречисленоПоставщику<>0 и ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка() Тогда
									Если ТолькоПоставщику = Истина Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику;
									ИначеЕсли ТолькоОплатыБрокеру Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса;
									КонецЕсли;	
									ПодСтрока.ПеречисленоПоставщику = ПодСтрока.ПеречисленоПоставщику*КоэффициентПеречисления;
								КонецЕсли;	
							КонецЦикла;
						Иначе
							Алго = 4;
						КонецЕсли;
						Если Строка.ПоступилоОтПоставщика = 0 Тогда
							
						ИначеЕсли Строка.ПоступилоОтПоставщика = ИтогиПоОплатам.КВПоВзносам 
							//или (ИтогиПоОплатам.СуммаПоВзносам+Строка.ПоступилоОтПоставщика) = 0 трудно исключить в другом режиме пусть пропорционально, хоть и не точно
							Тогда
							Для каждого ПодСтрока из Строки Цикл
								Если ПодСтрока.ПоступилоОтПоставщика<>0 и ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка() Тогда
									Алго = 5; 
									Если ТолькоПоставщику = Истина Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику;
									ИначеЕсли ТолькоОплатыБрокеру Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса;
									КонецЕсли;	
								КонецЕсли;
							КонецЦикла
					//	ИначеЕсли (ИтогиПоОплатам.СуммаПоВзносам+Строка.ПоступилоОтПоставщика) = 0   Тогда	
						ИначеЕсли Строка.ПоступилоОтПоставщика <>0 Тогда
							Алго = 9; //что-то перечислили берем пропорционально
							КоэффициентПеречисления = ИтогиПоОплатам.СуммаПоВзносам/Строка.СуммаПоВзносам;
							Для каждого ПодСтрока из Строки Цикл
								Если ПодСтрока.ПоступилоОтПоставщика<>0 и ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка() Тогда
									Если ТолькоПоставщику = Истина Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику;
									ИначеЕсли ТолькоОплатыБрокеру Тогда
										ПодСтрока.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса;
									КонецЕсли;	
									ПодСтрока.ПоступилоОтПоставщика = ПодСтрока.ПоступилоОтПоставщика*КоэффициентПеречисления;
								КонецЕсли;	
							КонецЦикла
	
						Иначе
							Алго = 6; 
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			//КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	Если ТолькоПоставщику = Истина Тогда
		ТаблицаЗначений = ТаблицаЗначений.Скопировать(Новый Структура("ФормаОплаты",Перечисления.уб_ФормыОплаты.Поставщику));	
	ИначеЕсли ТолькоОплатыБрокеру = Истина Тогда
		
		ТаблицаЗначений = ТаблицаЗначений.Скопировать(Новый Структура("ФормаОплаты",Перечисления.уб_ФормыОплаты.Касса));	
	КонецЕсли;	
	Если Не ОрганизацияАгент.Пустая() Тогда
		Возврат ТаблицаЗначений.Скопировать(Новый Структура("Организация",ОрганизацияАгент));	
	КонецЕсли;	
	#Если Клиент Тогда
	Состояние("Вывод формы");
	#КонецЕсли
	
	Возврат ТаблицаЗначений;
	
