Функция ТекстЗапроса(Параметры)
	//БезОрганизации
	ТекстБазовый = "ВЫБРАТЬ
	               |	СпрОрганизации.Ссылка
	               |ПОМЕСТИТЬ Организации
	               |ИЗ
	               |	Справочник.Организации КАК СпрОрганизации
	               |ГДЕ
	               |	СпрОрганизации.СкрыватьВБалансах = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	               |	ОплатыПолисов.Поставщик КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ОплатыПолисов.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
	               |						ТОГДА ПОДСТРОКА(""По оплатам в СК не включенным в отчет"", 1, 255)
	               |					ИНАЧЕ ПОДСТРОКА(""По оплатам брокеру не включенным в отчет"", 1, 255)
	               |				КОНЕЦ
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику
	               |	КОНЕЦ КАК ОтчетПоставщику,
	               |	ВЫБОР
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА &ДоДаты
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику.Дата
	               |	КОНЕЦ КАК Сортировка,
	               |	ВЫБОР
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ОплатыПолисов.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
	               |						ТОГДА ПОДСТРОКА(""По оплатам в СК не включенным в отчет"", 1, 255)
	               |					ИНАЧЕ ПОДСТРОКА(""По оплатам брокеру не включенным в отчет"", 1, 255)
	               |				КОНЕЦ
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику
	               |	КОНЕЦ КАК Представление,
	               |	СУММА(ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику - ВЫБОР
	               |			КОГДА &БезДопКВ
	               |				ТОГДА ВЫРАЗИТЬ(ОплатыПолисов.КВСуммаДляОтчета КАК ЧИСЛО(15, 2))
	               |			ИНАЧЕ ВЫРАЗИТЬ(ОплатыПолисов.КВСумма КАК ЧИСЛО(15, 2))
	               |		КОНЕЦ) КАК ЗадолженностьПередПоставщиком,
	               |	СУММА(ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику) КАК СуммаПоВзносам,
	               |	СУММА(ВЫРАЗИТЬ(ОплатыПолисов.КВСуммаДляОтчета КАК ЧИСЛО(15, 2))) КАК КВПоВзносам,
	               |	СУММА(ВЫБОР
	               |			КОГДА &БезДопКВ
	               |				ТОГДА 0
	               |			ИНАЧЕ ВЫРАЗИТЬ(ОплатыПолисов.КВСумма - ОплатыПолисов.КВСуммаДляОтчета КАК ЧИСЛО(15, 2))
	               |		КОНЕЦ) КАК КВДоп,
	               |	СУММА(ВЫБОР
	               |			КОГДА ОплатыПолисов.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
	               |				ТОГДА ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК ПеречисленоПоставщику,
	               |	СУММА(0) КАК ПоступилоОтПоставщика,
	               |	ВЫБОР
	               |		КОГДА &ДетализироватьОП = ИСТИНА
	               |			ТОГДА ОплатыПолисов.Ссылка
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА ОплатыПолисов.Ссылка
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику
	               |	КОНЕЦ КАК Регистратор,
	               |	1 КАК КоличествоВГруппе,
	               |	ВЫБОР
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА 0
	               |		КОГДА НЕ ЕСТЬNULL(уб_ИсторияОбъектСрезПоследних.ВерсияАктуальна, ЛОЖЬ)
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Стадия,
	               |	ОплатыПолисов.ОтчетПоставщику.Номер,
	               |	ОплатыПолисов.ОтчетПоставщику.НомерОтчетаПоставщику,
	               |	ВЫБОР
	               |		КОГДА &ДетализироватьОП = ИСТИНА
	               |			ТОГДА ОплатыПолисов.Дата
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА ОплатыПолисов.Дата
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику.Дата
	               |	КОНЕЦ КАК ОтчетПоставщикуДата,
	               |	ВЫБОР
	               |		КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка)
	               |		ИНАЧЕ ОплатыПолисов.ОтчетПоставщику.ВидСП
	               |	КОНЕЦ КАК ВидСП,
	               |	ОплатыПолисов.ОтчетПоставщику.ВидОперации КАК НаправлениеРасчетов,
	               |	"""" КАК НомерВходящегоДокумента,
	               |	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаВходящегоДокумента,
	               |	ОплатыПолисов.Номер КАК НомерОплаты,
	               |	ОплатыПолисов.Дата,
	               |	ПРЕДСТАВЛЕНИЕ(ОплатыПолисов.СтраховойПолис.Страхователь) КАК Страхователь,
	               |	ВЫБОР
	               |		КОГДА &ДетализироватьОП = ИСТИНА
	               |			ТОГДА ОплатыПолисов.ФормаОплаты
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.ПустаяСсылка)
	               |	КОНЕЦ КАК ФормаОплаты,
	               |	ОплатыПолисов.СтраховойПолис.Номер КАК НомерПолиса
	               |ПОМЕСТИТЬ ВТ_Взаиморасчеты
	               |ИЗ
	               |	Документ.уб_ОплатаПолисов КАК ОплатыПолисов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияОбъект.СрезПоследних КАК уб_ИсторияОбъектСрезПоследних
	               |		ПО ОплатыПолисов.ОтчетПоставщику = уб_ИсторияОбъектСрезПоследних.ОбъектИстории
	               |ГДЕ
	               |	1 = 1
	               |	И ВЫБОР
	               |			КОГДА &Организации = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |					ИЛИ ОплатыПолисов.ОрганизацияАгент = &Организации
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ
	               |	И НЕ ОплатыПолисов.ПометкаУдаления
	               |	И ВЫБОР
	               |			КОГДА &ИсключатьНесогласованные = ИСТИНА
	               |					И ВЫБОР
	               |						КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ОплатыПолисов.ОтчетПоставщику.Дата > ДАТАВРЕМЯ(2013, 8, 1)
	               |					КОНЕЦ
	               |				ТОГДА ВЫБОР
	               |						КОГДА ОплатыПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	               |							ТОГДА ЛОЖЬ
	               |						ИНАЧЕ ВЫБОР
	               |								КОГДА ЕСТЬNULL(ОплатыПолисов.ОтчетПоставщику.ДатаСогласования, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	               |									ТОГДА ЛОЖЬ
	               |								ИНАЧЕ ИСТИНА
	               |							КОНЕЦ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ ОплатыПолисов.НеВключатьВОтчетыПоставщикам
	               |	И НЕ ОплатыПолисов.ИсключенаИзВзаиморасчетов
	               |	И ВЫБОР
	               |			КОГДА ОплатыПолисов.Поставщик.ДатаВеденияВзаиморасчётов = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ВЫБОР
