Функция ПредставлениеПлатежа(Данные)
	
	Префикс = "Платеж";
	пВидОперации = Перечисления.уб_ВидОперацииВзаиморасчетов;
	Если Данные.НаправлениеРасчетов = пВидОперации.ПеречислениеПоставщику Тогда
		Префикс = "Платеж поставщику";
	ИначеЕсли Данные.НаправлениеРасчетов = пВидОперации.ПеречислениеПоставщикуСтрахователем Тогда		
		Префикс = "Оплата страхователем напрямую";
	ИначеЕсли Данные.НаправлениеРасчетов = пВидОперации.ПоступлениеКВОтПоставщика Тогда			
		Префикс = "Возврат КВ";
	ИначеЕсли Данные.НаправлениеРасчетов = пВидОперации.НачальныйОстаток Тогда			
		Префикс = "Начальный остаток";
	ИначеЕсли Данные.НаправлениеРасчетов = пВидОперации.Корректировка Тогда	
		Префикс = "Корректировка";
	КонецЕсли;	
	Номер=?(ЗначениеЗаполнено(Данные.НомерВходящегоДокумента)," № "+СокрЛП(Данные.НомерВходящегоДокумента),"");
	Возврат  Префикс + Номер +" от " + Формат(Данные.ДатаВходящегоДокумента,"ДФ=dd.MM.yyyy");
	
КонецФункции	




