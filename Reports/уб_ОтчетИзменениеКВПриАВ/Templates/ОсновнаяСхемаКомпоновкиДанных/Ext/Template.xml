				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Начальное значение</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъектИстории</dataPath>
			<field>ОбъектИстории</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	уб_ИсторияРеквизитСрезПервых.Период,
	уб_ИсторияРеквизитСрезПервых.ОбъектИстории
ПОМЕСТИТЬ ВТ_Исключаемые
ИЗ
	РегистрСведений.уб_ИсторияРеквизит.СрезПервых(
			,
			ОбъектИстории ССЫЛКА Документ.уб_ОплатаПолисов
				И ОбъектИстории.ВидРасчетаСАгентом = ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ)
				И РеквизитОбъекта = &amp;РеквизитКВПроцент) КАК уб_ИсторияРеквизитСрезПервых
ГДЕ
	(ВЫРАЗИТЬ(уб_ИсторияРеквизитСрезПервых.ЗначениеРеквизита КАК ЧИСЛО)) = 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	уб_ИсторияРеквизитСрезПоследних.Период,
	уб_ИсторияРеквизитСрезПоследних.ОбъектИстории
ИЗ
	РегистрСведений.уб_ИсторияРеквизит.СрезПоследних(
			,
			ОбъектИстории ССЫЛКА Документ.уб_ОплатаПолисов
				И ОбъектИстории.ВидРасчетаСАгентом = ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ)
				И РеквизитОбъекта = &amp;РеквизитКВПроцент) КАК уб_ИсторияРеквизитСрезПоследних
ГДЕ
	(ВЫРАЗИТЬ(уб_ИсторияРеквизитСрезПоследних.ЗначениеРеквизита КАК ЧИСЛО)) = уб_ИсторияРеквизитСрезПоследних.ОбъектИстории.КВПроцент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ИсторияРеквизит.Период КАК НачДата,
	уб_ИсторияРеквизит.ОбъектИстории КАК ОбъектИстории,
	ВЫРАЗИТЬ(уб_ИсторияРеквизит.ЗначениеРеквизита КАК ЧИСЛО(15, 4)) КАК НачЗначение,
	Объект.КВПроцент КАК КВПроцент,
	Объект.Агент КАК Менеджер
ИЗ
	РегистрСведений.уб_ИсторияРеквизит КАК уб_ИсторияРеквизит
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК Объект
		ПО (Объект.Ссылка = уб_ИсторияРеквизит.ОбъектИстории)
			И (уб_ИсторияРеквизит.ОбъектИстории.ВидРасчетаСАгентом = ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПоАВ))
			И (уб_ИсторияРеквизит.РеквизитОбъекта = &amp;РеквизитКВПроцент)
			И (уб_ИсторияРеквизит.Период МЕЖДУ &amp;НачПериода И &amp;КонПериода)
ГДЕ
	НЕ (уб_ИсторияРеквизит.Период, уб_ИсторияРеквизит.ОбъектИстории) В
				(ВЫБРАТЬ
					Т.Период,
					Т.ОбъектИстории
				ИЗ
					ВТ_Исключаемые КАК Т)

УПОРЯДОЧИТЬ ПО
	Менеджер,
	ОбъектИстории,
	НачДата</query>
