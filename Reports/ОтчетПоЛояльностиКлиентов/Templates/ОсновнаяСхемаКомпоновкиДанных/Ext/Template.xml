		<query>ВЫБРАТЬ
	Сп.Агент,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Сп.Ссылка) КАК КоличествоПолисов,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Сп.Страхователь) КАК КоличествоКлиентов,
	НАЧАЛОПЕРИОДА(Сп.ДатаНачала, МЕСЯЦ) КАК Месяц
ПОМЕСТИТЬ СтатистикаЗаключения
ИЗ
	Документ.уб_СтраховойПолис КАК Сп
ГДЕ
	Сп.Дата &gt;= ДОБАВИТЬКДАТЕ(&amp;Дата1, МЕСЯЦ, -12)
	И НЕ Сп.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью))
	И Сп.ПометкаУдаления = ЛОЖЬ
	И Сп.НомерЗаявки &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная)

СГРУППИРОВАТЬ ПО
	Сп.Агент,
	НАЧАЛОПЕРИОДА(Сп.ДатаНачала, МЕСЯЦ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(уб_ОпросникДоговоров.ДатаСоздания, МЕСЯЦ) КАК МесяцОпроса,
	НАЧАЛОПЕРИОДА(уб_ОпросникДоговоров.Заявка.Дата, МЕСЯЦ) КАК МесяцДокумента,
	уб_ОпросникДоговоров.Заявка КАК Документ,
	ВЫБОР
		КОГДА уб_ОпросникДоговоров.ДатаИзменения &gt; ДАТАВРЕМЯ(2016, 3, 25)
			ТОГДА уб_ОпросникДоговоров.ОценкаКомпании
		ИНАЧЕ уб_ОпросникДоговоров.ОценкаКомпании * 2
	КОНЕЦ КАК ОцКомпании,
	уб_ОпросникДоговоров.Рекомендация КАК Рекомендации,
	уб_ОпросникДоговоров.ПричинаКомпания,
	ВЫБОР
		КОГДА уб_ОпросникДоговоров.ОценкаКомпании = 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК мОтказОпрос,
	уб_ОпросникДоговоров.ПричинаОтказаРекомендации,
	уб_ОпросникДоговоров.ДатаИзменения,
	уб_ОпросникДоговоров.ДатаСоздания,
	уб_ОпросникДоговоров.Заявка.Менеджер КАК Менеджер
ПОМЕСТИТЬ Опросы
ИЗ
	РегистрСведений.уб_ОпросникДоговоров КАК уб_ОпросникДоговоров
ГДЕ
	(&amp;Режим2 = 1
				И уб_ОпросникДоговоров.ДатаСоздания &gt;= &amp;Дата1
				И уб_ОпросникДоговоров.ДатаСоздания &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, МЕСЯЦ)
			ИЛИ &amp;Режим2 = 2
				И уб_ОпросникДоговоров.Заявка.Дата &gt;= &amp;Дата1
				И уб_ОпросникДоговоров.Заявка.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, МЕСЯЦ))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ ПЕРВЫЕ 10000
	опросы.Менеджер КАК Менеджер,
	СУММА(1) КАК всего,
	СУММА(ВЫБОР
			КОГДА опросы.ОцКомпании &gt;= 9
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Лояльны,
	СУММА(ВЫБОР
			КОГДА опросы.ОцКомпании = 7
					ИЛИ опросы.ОцКомпании = 8
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Нейтральны,
	СУММА(ВЫБОР
			КОГДА опросы.ОцКомпании &lt;= 6
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Критики,
	опросы.МесяцОпроса
ПОМЕСТИТЬ Обработка
ИЗ
	Опросы КАК опросы

СГРУППИРОВАТЬ ПО
	опросы.Менеджер,
	опросы.МесяцОпроса

УПОРЯДОЧИТЬ ПО
	опросы.Менеджер.Наименование
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ДФ.Агент,Обработка.Менеджер) КАК Менеджер,
	ЕСТЬNULL(Обработка.всего,0) как всего,
	ЕСТЬNULL(Обработка.Лояльны,0) как Лояльны,
	ЕСТЬNULL(ВЫБОР
		КОГДА Обработка.всего = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(100 * Обработка.Лояльны / Обработка.всего КАК ЧИСЛО(10, 0))
	КОНЕЦ ,0) как ЛояльныПроцент,
	ЕСТЬNULL(Обработка.Нейтральны,0) как Нейтральны,
	ЕСТЬNULL(ВЫБОР
		КОГДА Обработка.всего = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(100 * Обработка.Нейтральны / Обработка.всего КАК ЧИСЛО(10, 0))
	КОНЕЦ ,0) как  НейтральныПроцент,
	ЕСТЬNULL(Обработка.Критики,0) как Критики,
	ЕСТЬNULL(ВЫБОР
		КОГДА Обработка.всего = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(100 * Обработка.Критики / Обработка.всего КАК ЧИСЛО(10, 0))
	КОНЕЦ,0) как КритикиПроцент,
	ЕСТЬNULL(ВЫБОР
		КОГДА Обработка.всего = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(100 * Обработка.Лояльны / Обработка.всего КАК ЧИСЛО(10, 0))
	КОНЕЦ - ВЫБОР
		КОГДА Обработка.всего = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ(100 * Обработка.Критики / Обработка.всего КАК ЧИСЛО(10, 0))
	КОНЕЦ ,0) как  NPS,
	ЕСТЬNULL(Обработка.МесяцОпроса,НачалоПЕРИОДА(&amp;Дата2, МЕСЯЦ)) КАК МесяцОпроса,
	ДОБАВИТЬКДАТЕ(ЕСТЬNULL(Обработка.МесяцОпроса,НачалоПЕРИОДА(&amp;Дата2, МЕСЯЦ)), МЕСЯЦ, -1) КАК ПрошлыйМесяц,
	ДФ.Подразделение КАК Подразделение,
	ЕСТЬNULL(СтатистикаЗаключения.КоличествоПолисов, 0) КАК КоличествоПолисов,
	ЕСТЬNULL(СтатистикаЗаключения.КоличествоКлиентов, 0) КАК КоличествоКлиентов
ИЗ
	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних({(КОНЕЦПЕРИОДА(&amp;Дата2, МЕСЯЦ)) КАК Поле2}, ) КАК ДФ
		ЛЕВОЕ СОЕДИНЕНИЕ Обработка КАК Обработка
		ПО (Обработка.Менеджер = ДФ.Агент)
		ЛЕВОЕ СОЕДИНЕНИЕ СтатистикаЗаключения КАК СтатистикаЗаключения
		ПО (Обработка.Менеджер = СтатистикаЗаключения.Агент)
			И (ДОБАВИТЬКДАТЕ(Обработка.МесяцОпроса, МЕСЯЦ, -1) = СтатистикаЗаключения.Месяц)
	ГДЕ дФ.Выбытие = ложь и дФ.Подразделение.ТипПодразделения = Значение(Перечисление.уб_ТипПодразделения.ТочкаПродаж) 		
	и (&amp;Менеджеры = 0 или ДФ.Агент В (&amp;Менеджеры))

УПОРЯДОЧИТЬ ПО
	Подразделение,
	Менеджер,
	МесяцОпроса</query>
