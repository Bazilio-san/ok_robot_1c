		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	уб_ДвиженияБСО.Период КАК ДатаПередачи,
	уб_ДвиженияБСО.СК,
	уб_ДвиженияБСО.ВидБСО,
	уб_ДвиженияБСО.Поставщик,
	уб_ДвиженияБСО.НомерБСО КАК НомерБСО,
	уб_ДвиженияБСО.СостояниеБСО,
	уб_ДвиженияБСО.Заявка.Номер КАК НомерЗаявки,
	уб_ДвиженияБСО.ОрганизацияАгент,
	уб_ДвиженияБСО.Регистратор КАК Регистратор,
	уб_ДвиженияБСО.Агент КАК Агент,
	1 КАК Количество
ИЗ
	РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
ГДЕ
	ВЫБОР
			КОГДА &amp;СК = НЕОПРЕДЕЛЕНО
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ДвиженияБСО.СК = &amp;СК
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;Поставщик = НЕОПРЕДЕЛЕНО
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ДвиженияБСО.Поставщик = &amp;Поставщик
		КОНЕЦ
	И уб_ДвиженияБСО.Период &gt;= &amp;НачалоПериода
	И ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ДвиженияБСО.Период &lt;= &amp;КонецПериода
		КОНЕЦ
	И уб_ДвиженияБСО.Подтверждено
	И уб_ДвиженияБСО.Активность
	И уб_ДвиженияБСО.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданВСК)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	уб_ОстаткиБСО.Период,
	уб_ОстаткиБСО.СК,
	уб_ОстаткиБСО.ВидБСО,
	уб_ОстаткиБСО.Поставщик,
	NULL,
	NULL,
	NULL,
	уб_ОстаткиБСО.ОрганизацияАгент,
	уб_ОстаткиБСО.Регистратор,
	уб_ОстаткиБСО.Агент,
	уб_ОстаткиБСО.Количество
ИЗ
	РегистрНакопления.уб_ОстаткиБСО КАК уб_ОстаткиБСО
ГДЕ
	ВЫБОР
			КОГДА &amp;Поставщик = НЕОПРЕДЕЛЕНО
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ОстаткиБСО.Поставщик = &amp;Поставщик
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;СК = НЕОПРЕДЕЛЕНО
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ОстаткиБСО.СК = &amp;СК
		КОНЕЦ
	И уб_ОстаткиБСО.Период &gt;= &amp;НачалоПериода
	И ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ уб_ОстаткиБСО.Период &lt;= &amp;КонецПериода
		КОНЕЦ
	И уб_ОстаткиБСО.Активность
	И уб_ОстаткиБСО.КодОперации = ЗНАЧЕНИЕ(Перечисление.уб_КодыОперацийБСО.ПередачаБСОПоставщику)</query>
