		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЕСТЬNULL(уб_ОплатаПолисов.КВСумма, 0) КАК КВСумма,
	ЕСТЬNULL(уб_ОплатаПолисов.КВСуммаДляОтчета, 0) КАК КВСуммаДляОтчета,
	уб_ОплатаПолисов.КВСумма - уб_ОплатаПолисов.КВСуммаДляОтчета КАК Разница,
	уб_ОплатаПолисов.Ссылка,
	уб_ОплатаПолисов.СтраховойПолис.Ссылка,
	уб_ОплатаПолисов.Агент,
	ВЫБОР
		КОГДА уб_ОплатаПолисов.КВСумма &gt; уб_ОплатаПолисов.АВилиСкидкаСумма
				И уб_ОплатаПолисов.ОплаченоФакт &gt; 0
			ТОГДА уб_ОплатаПолисов.КВСумма - уб_ОплатаПолисов.АВилиСкидкаСумма
		ИНАЧЕ 0
	КОНЕЦ КАК СКВ
ИЗ
	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
ГДЕ
	уб_ОплатаПолисов.КВСумма &lt;&gt; уб_ОплатаПолисов.КВСуммаДляОтчета
	И уб_ОплатаПолисов.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
