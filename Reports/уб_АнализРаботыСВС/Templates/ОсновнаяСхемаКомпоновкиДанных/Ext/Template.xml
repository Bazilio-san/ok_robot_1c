<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Полис</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Номер</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Баллов</dataPath>
			<field>Баллов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Источник</dataPath>
			<field>Источник</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Курьер</dataPath>
			<field>Курьер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	уб_СтраховойПолис.Курьер,
	ВЫБОР
		КОГДА уб_СтраховойПолис.СтраховойПродукт.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско)
			ТОГДА "За КАСКО"
		КОГДА уб_СтраховойПолис.СтраховойПродукт.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго)
			ТОГДА "За ОСАГО"
		ИНАЧЕ ""
	КОНЕЦ КАК Источник,
	СУММА(5) КАК Баллов,
	уб_СтраховойПолис.Ссылка,
	уб_СтраховойПолис.Номер
ИЗ
	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
ГДЕ
	уб_СтраховойПолис.Дата &gt;= &amp;Дата1
	И уб_СтраховойПолис.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, ДЕНЬ)
	И НЕ уб_СтраховойПолис.Курьер В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	И НЕ уб_СтраховойПолис.Курьер = уб_СтраховойПолис.Агент
	И НЕ уб_СтраховойПолис.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
	И уб_СтраховойПолис.СтраховойПродукт.Вид В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго))

СГРУППИРОВАТЬ ПО
	уб_СтраховойПолис.Курьер,
	уб_СтраховойПолис.Ссылка,
	ВЫБОР
		КОГДА уб_СтраховойПолис.СтраховойПродукт.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско)
			ТОГДА "За КАСКО"
		КОГДА уб_СтраховойПолис.СтраховойПродукт.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго)
			ТОГДА "За ОСАГО"
		ИНАЧЕ ""
	КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	Док.Объект.Курьер,
	"За документы",
	-1,
	Док.Объект,
	
	Док.Объект.Номер

ИЗ
	РегистрСведений.уб_ПредоставленныеДокументыСП КАК Док
ГДЕ
	Док.Объект.Дата &gt;= &amp;Дата1
	И Док.Объект.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, ДЕНЬ)
	И Док.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипыПодразделений.Курьеры)
	И Док.Объект.Курьер &lt;&gt; Док.Объект.Агент
	И Док.Предоставлен = ЛОЖЬ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	уб_ОшибкиСрезПоследних.Менеджер,
	"За ошибки",
	-уб_ОшибкиСрезПоследних.Приоритет,
	уб_Ошибки.Объект,
	уб_Ошибки.Объект.Номер
ИЗ
	РегистрСведений.уб_Ошибки КАК уб_Ошибки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_Ошибки.СрезПоследних КАК уб_ОшибкиСрезПоследних
		ПО уб_Ошибки.Объект = уб_ОшибкиСрезПоследних.Объект
			И уб_Ошибки.УИД = уб_ОшибкиСрезПоследних.УИД
ГДЕ
	уб_Ошибки.Период &gt;= &amp;Дата1
	И уб_Ошибки.Период &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, ДЕНЬ)
	И уб_Ошибки.Статус = ЗНАЧЕНИЕ(Справочник.уб_СостоянияОшибок.Новый)
	И уб_Ошибки.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипыПодразделений.Курьеры)
	И уб_ОшибкиСрезПоследних.Приоритет &lt;&gt; 0
	И уб_ОшибкиСрезПоследних.Менеджер &lt;&gt; уб_Ошибки.Объект.Агент</query>
