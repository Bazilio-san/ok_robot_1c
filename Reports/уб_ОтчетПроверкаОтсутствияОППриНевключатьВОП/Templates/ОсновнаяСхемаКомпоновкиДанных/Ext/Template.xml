		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Оплата полисов</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НеВключатьВОтчетыПоставщикам</dataPath>
			<field>НеВключатьВОтчетыПоставщикам</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>ГоризонтальноеПоложение</dcscor:parameter>
					<dcscor:value xsi:type="v8ui:HorizontalAlign">Center</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">БИ=Да</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтчетПоставщику</dataPath>
			<field>ОтчетПоставщику</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	уб_ОплатаПолисов.Ссылка,
	уб_ОплатаПолисов.ОтчетПоставщику,
	уб_ОплатаПолисов.НеВключатьВОтчетыПоставщикам
ИЗ
	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
ГДЕ
	//НЕ уб_ОплатаПолисов.ОтчетПоставщику.Номер ЕСТЬ NULL 
	НЕ уб_ОплатаПолисов.ОтчетПоставщику =  Значение(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	И уб_ОплатаПолисов.НеВключатьВОтчетыПоставщикам
	И уб_ОплатаПолисов.Проведен</query>
	</dataSet>
