			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Итог</dataPath>
			<field>Итог</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПремияПоЗаявкам</dataPath>
			<field>ПремияПоЗаявкам</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СкидкаПоЗаявкам</dataPath>
			<field>СкидкаПоЗаявкам</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоОплат</dataPath>
			<field>КоличествоОплат</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПремияПоОплатам</dataPath>
			<field>ПремияПоОплатам</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидСП</dataPath>
			<field>ВидСП</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ДОБАВИТЬКДАТЕ(&amp;НачалоПериода, ДЕНЬ, Единицы.Номер + 10 * Десятики.Номер + 100 * Сотни.Номер) КАК Дата
ПОМЕСТИТЬ ВТ_ЗапросДат
ИЗ
	(ВЫБРАТЬ
		0 КАК Номер
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		1
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		2
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		3
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		4
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		5
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		6
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		7
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		8
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		9) КАК Единицы,
	(ВЫБРАТЬ
		0 КАК Номер
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		1
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		2
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		3
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		4
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		5
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		6
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		7
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		8
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		9) КАК Десятики,
	(ВЫБРАТЬ
		0 КАК Номер
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		1
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		2
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		3
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		4
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		5
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		6
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		7
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		8
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		9) КАК Сотни
ГДЕ
	ДОБАВИТЬКДАТЕ(&amp;НачалоПериода, ДЕНЬ, Единицы.Номер + 10 * Десятики.Номер + 100 * Сотни.Номер) &lt;= &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
ПОМЕСТИТЬ ВТ_ДвиженияАгентов
ИЗ
	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&amp;КонецПериода, ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолис.Ссылка) КАК Количество,
	уб_СтраховойПолис.Агент,
	уб_СтраховойПолис.Подразделение,
	ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса) КАК ФормаОплаты,
	НАЧАЛОПЕРИОДА(уб_СтраховойПолис.Дата, ДЕНЬ) КАК День,
	уб_СтраховойПолис.СтраховойПродукт.Вид КАК ВидСП
ПОМЕСТИТЬ ВТ_СтраховыеПолисы
ИЗ
	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
ГДЕ
	уб_СтраховойПолис.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	уб_СтраховойПолис.Агент,
	уб_СтраховойПолис.Подразделение,
	НАЧАЛОПЕРИОДА(уб_СтраховойПолис.Дата, ДЕНЬ),
	уб_СтраховойПолис.СтраховойПродукт.Вид
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка) КАК Количество,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер КАК Агент,
	ВТ_ДвиженияАгентов.Подразделение,
	НАЧАЛОПЕРИОДА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата, ДЕНЬ) КАК День,
	ВЫБОР
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалиста.СуммаПоКарте &gt; 0
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Безнал)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
	КОНЕЦ КАК ФормаОплаты,
	СУММА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия) КАК ПремияПоЗаявкам,
	СУММА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка) КАК СкидкаПоЗаявкам,
	ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско) КАК ВидСП
ПОМЕСТИТЬ ВТ_Заявки
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДвиженияАгентов КАК ВТ_ДвиженияАгентов
		ПО уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер = ВТ_ДвиженияАгентов.Агент
ГДЕ
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
	ВТ_ДвиженияАгентов.Подразделение,
	НАЧАЛОПЕРИОДА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата, ДЕНЬ),
	ВЫБОР
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалиста.СуммаПоКарте &gt; 0
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Безнал)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ПриемкаОплатПолисы.Ссылка КАК Документ,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента = ЗНАЧЕНИЕ(Документ.уб_ОплатаПолисов.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.Агент
		ИНАЧЕ уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента.Агент
	КОНЕЦ КАК Агент,
	ВЫБОР
		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПП.ФормаОплаты) = 1
			ТОГДА МИНИМУМ(ПП.ФормаОплаты)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.ПустаяСсылка)
	КОНЕЦ КАК ФормаОплаты,
	НАЧАЛОПЕРИОДА(уб_ПриемкаОплатПолисы.Ссылка.Дата, ДЕНЬ) КАК День,
	уб_ПриемкаОплатПолисы.Сумма КАК Сумма,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.Заявка = ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.НомерЗаявки
		ИНАЧЕ уб_ПриемкаОплатПолисы.Заявка.НомерЗаявки
	КОНЕЦ КАК НомерЗаявки,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента = ЗНАЧЕНИЕ(Документ.уб_ОплатаПолисов.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.СтраховойПродукт.Вид
		ИНАЧЕ уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента.ВидСП
	КОНЕЦ КАК ВидСП
ПОМЕСТИТЬ ВТ_ПриемкаОплат
ИЗ
	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ВременныеДанныеПолисаКПриемкеОплат КАК уб_ВременныеДанныеПолисаКПриемкеОплат
		ПО уб_ПриемкаОплатПолисы.УИДСтроки = уб_ВременныеДанныеПолисаКПриемкеОплат.УИДСтрокиТЧ
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК ПП
		ПО уб_ПриемкаОплатПолисы.Ссылка = ПП.Ссылка
ГДЕ
	уб_ПриемкаОплатПолисы.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ВЫБОР
			КОГДА &amp;ИсключитьФормуОплатыПоставщику
				ТОГДА ПП.ФормаОплаты &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	уб_ПриемкаОплатПолисы.Ссылка,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента = ЗНАЧЕНИЕ(Документ.уб_ОплатаПолисов.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.Агент
		ИНАЧЕ уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента.Агент
	КОНЕЦ,
	НАЧАЛОПЕРИОДА(уб_ПриемкаОплатПолисы.Ссылка.Дата, ДЕНЬ),
	уб_ПриемкаОплатПолисы.Сумма,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.Заявка = ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.НомерЗаявки
		ИНАЧЕ уб_ПриемкаОплатПолисы.Заявка.НомерЗаявки
	КОНЕЦ,
	ВЫБОР
		КОГДА уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента = ЗНАЧЕНИЕ(Документ.уб_ОплатаПолисов.ПустаяСсылка)
			ТОГДА уб_ВременныеДанныеПолисаКПриемкеОплат.СтраховойПродукт.Вид
		ИНАЧЕ уб_ПриемкаОплатПолисы.ОплатаПолисаДляОтчетаАгента.ВидСП
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПриемкаОплат.Документ,
	ВТ_ПриемкаОплат.Агент,
	ВТ_ПриемкаОплат.ФормаОплаты,
	ВТ_ПриемкаОплат.День,
	ВТ_ПриемкаОплат.Сумма,
	ВТ_ДвиженияАгентов.Подразделение,
	ВТ_ПриемкаОплат.ВидСП
ПОМЕСТИТЬ ВТ_ПриемкаСПодразделением
ИЗ
	ВТ_ПриемкаОплат КАК ВТ_ПриемкаОплат
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДвиженияАгентов КАК ВТ_ДвиженияАгентов
		ПО ВТ_ПриемкаОплат.Агент = ВТ_ДвиженияАгентов.Агент
ГДЕ
	ВЫБОР
			КОГДА &amp;ИсключитьВидРасчетовАВ
				ТОГДА ВТ_ПриемкаОплат.НомерЗаявки &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_ВидыЗаявок.Личная)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ОплатаПолисов.Ссылка) КАК КоличествоОплат,
	уб_ОплатаПолисов.Агент,
	уб_ОплатаПолисов.Подразделение,
	уб_ОплатаПолисов.КВСумма - уб_ОплатаПолисов.АВилиСкидкаСумма КАК СКВ,
	уб_ОплатаПолисов.КВСумма,
	уб_ОплатаПолисов.АВилиСкидкаСумма,
	НАЧАЛОПЕРИОДА(уб_ОплатаПолисов.Дата, ДЕНЬ) КАК День,
	уб_ОплатаПолисов.НачисленнаяСуммаВзноса КАК Премия,
	уб_ОплатаПолисов.ВидСП
ПОМЕСТИТЬ ВТ_Оплаты
ИЗ
	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
ГДЕ
