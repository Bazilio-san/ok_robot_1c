				ТОГДА уб_ОплатаПолисов.НаправлениеПлатежа &lt;&gt; ЗНАЧЕНИЕ(Перечисление.уб_НаправленияПлатежа.Поставщику)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	уб_ОплатаПолисов.Агент,
	уб_ОплатаПолисов.Подразделение,
	уб_ОплатаПолисов.КВСумма - уб_ОплатаПолисов.АВилиСкидкаСумма,
	уб_ОплатаПолисов.КВСумма,
	уб_ОплатаПолисов.АВилиСкидкаСумма,
	НАЧАЛОПЕРИОДА(уб_ОплатаПолисов.Дата, ДЕНЬ),
	уб_ОплатаПолисов.НачисленнаяСуммаВзноса,
	уб_ОплатаПолисов.ВидСП
;

