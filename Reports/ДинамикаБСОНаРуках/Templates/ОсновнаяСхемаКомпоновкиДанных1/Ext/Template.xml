		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	НАЧАЛОПЕРИОДА(уб_ИнвентаризацияБСОСостояниеЛимитов.Ссылка.Дата, ДЕНЬ) КАК Дата,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Ссылка.Агент КАК Сотрудник,
	уб_ИнвентаризацияБСОСостояниеЛимитов.ВидСП,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Количество,
	уб_ИнвентаризацияБСОСостояниеЛимитов.КоличествоФакт,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Сумма,
	уб_ИнвентаризацияБСОСостояниеЛимитов.СуммаФакт,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Дней,
	уб_ИнвентаризацияБСОСостояниеЛимитов.ДнейФакт,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Ссылка.Подразделение КАК Отдел,
	уб_ИнвентаризацияБСОСостояниеЛимитов.Ссылка КАК Документ
ИЗ
	Документ.уб_ИнвентаризацияБСО.СостояниеЛимитов КАК уб_ИнвентаризацияБСОСостояниеЛимитов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			НАЧАЛОПЕРИОДА(уб_ИнвентаризацияБСО.Дата, ДЕНЬ) КАК День,
			уб_ИнвентаризацияБСО.Агент КАК Агент,
			МАКСИМУМ(уб_ИнвентаризацияБСО.Ссылка) КАК Документ
		ИЗ
			Документ.уб_ИнвентаризацияБСО КАК уб_ИнвентаризацияБСО
		ГДЕ
			уб_ИнвентаризацияБСО.Проведен = ИСТИНА
			И уб_ИнвентаризацияБСО.Дата &gt;= &amp;Дата1
			И уб_ИнвентаризацияБСО.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, ДЕНЬ)
		
		СГРУППИРОВАТЬ ПО
			уб_ИнвентаризацияБСО.Агент,
			НАЧАЛОПЕРИОДА(уб_ИнвентаризацияБСО.Дата, ДЕНЬ)) КАК Инвентаризации
		ПО уб_ИнвентаризацияБСОСостояниеЛимитов.Ссылка = Инвентаризации.Документ</query>
