	Данные.НомерКвитанции,
	Данные.Сумма,
	Данные.Заявка,
	Данные.Разница,
	Данные.ДатаПриемки,
	Данные.ДатаОтчета,
	Данные.Курьер,
	Данные.Отчет,
	Данные.НомерОтчета,
	Данные.ФормаОплаты,
	ВЫБОР
		КОГДА Данные.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
				ИЛИ Данные.ФормаОплаты ЕСТЬ NULL 
			ТОГДА Данные.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Налично,
	Данные.Страхователь,
	Данные.Номер,
	Данные.Ответственный,
	Данные.ОтветственныйФинансы
ИЗ
	Данные КАК Данные</query>
