		<query>ВЫБРАТЬ
	Полисы.Поставщик,
	Полисы.ОрганизацияАгент,
	ВЫБОР
		КОГДА Полисы.ОрганизацияАгент.ОрганизацияОтчетаКассира = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА Полисы.ОрганизацияАгент
		ИНАЧЕ Полисы.ОрганизацияАгент.ОрганизацияОтчетаКассира
	КОНЕЦ КАК ОрганизацияАгентОтчет,
	Полисы.СК,
	Полисы.ВидБСО,
	Полисы.НомерБСО,
	Полисы.НомерПолиса,
	Полисы.НомерКвитанции,
	Полисы.Сумма,
	Полисы.Заявка,
	Полисы.Разница,
	Полисы.Ссылка.Дата КАК ДатаПриемки,
	Полисы.Ссылка.ОтчетКассира.Дата КАК ДатаОтчета,
	Полисы.Ссылка.ПринятоОТ КАК Курьер,
	Полисы.Ссылка.ОтчетКассира КАК Отчет,
	Полисы.Ссылка.ОтчетКассира.Номер КАК НомерОтчета,
	МАКСИМУМ(ЕСТЬNULL(уб_КвитовкаОплат.ОплатаПолиса.ФормаОплаты, уб_ВременныеДанныеПолисаКПриемкеОплат.ФормаОплаты)) КАК ФормаОплаты,
	МАКСИМУМ(ЕСТЬNULL(уб_КвитовкаОплат.ОплатаПолиса.СтраховойПолис.Страхователь, уб_ВременныеДанныеПолисаКПриемкеОплат.Страхователь)) КАК Страхователь,
	Полисы.Ссылка.Номер,
	Полисы.Ссылка.Автор.Наименование КАК Ответственный,
	Полисы.Ссылка.ОтчетКассира.ОтветственныйФинансы КАК ОтветственныйФинансы
ПОМЕСТИТЬ Данные
ИЗ
	Документ.уб_ПриемкаОплат.Полисы КАК Полисы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ВременныеДанныеПолисаКПриемкеОплат КАК уб_ВременныеДанныеПолисаКПриемкеОплат
		ПО Полисы.УИДСтроки = уб_ВременныеДанныеПолисаКПриемкеОплат.УИДСтрокиТЧ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_КвитовкаОплат КАК уб_КвитовкаОплат
		ПО Полисы.УИДСтроки = уб_КвитовкаОплат.УИДСтрокиТЧ
ГДЕ
	Полисы.Ссылка.Дата &gt;= &amp;Дата1
	И Полисы.Ссылка.Дата &lt;= &amp;Дата2
	И Полисы.Ссылка.Подразделение.ТипПодразделения = &amp;ТипПодразделения

СГРУППИРОВАТЬ ПО
	Полисы.Поставщик,
	Полисы.ОрганизацияАгент,
	Полисы.СК,
	Полисы.ВидБСО,
	Полисы.НомерБСО,
	Полисы.НомерПолиса,
	Полисы.НомерКвитанции,
	Полисы.Сумма,
	Полисы.Заявка,
	Полисы.Разница,
	Полисы.Ссылка.Дата,
	Полисы.Ссылка.ОтчетКассира.Дата,
	Полисы.Ссылка.ПринятоОТ,
	Полисы.Ссылка.ОтчетКассира,
	Полисы.Ссылка.ОтчетКассира.Номер,
	ВЫБОР
		КОГДА Полисы.ОрганизацияАгент.ОрганизацияОтчетаКассира = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			ТОГДА Полисы.ОрганизацияАгент
		ИНАЧЕ Полисы.ОрганизацияАгент.ОрганизацияОтчетаКассира
	КОНЕЦ,
	Полисы.Ссылка.Номер,
	Полисы.Ссылка.Автор.Наименование,
	Полисы.Ссылка.ОтчетКассира.ОтветственныйФинансы
;

