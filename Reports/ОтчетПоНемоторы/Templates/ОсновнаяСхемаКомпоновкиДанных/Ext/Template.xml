		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.СК,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование КАК ВидБСОНаименование,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.НомерЗаявки,
	ВЫБОР
		КОГДА уб_ИсторияСтатусовЗаявокСрезПоследних.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗаявкаОтработана), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.КурьерПриехалВОфис), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.КомплектНаХраненииВБухгалтерии), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.КомплектИДеньгиУКассира), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ДеньгиВКомпании))
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СданаВБухгалтерию,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.МаркаТС
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
			ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
ГДЕ
	НЕ уб_ИсторияСтатусовЗаявокСрезПоследних.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СогласованиеСКлиентом), 
	ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО), 
	//ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.НазначениеКурьера),
	ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.БСОНаРукахУКурьера),
	ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗапросНаУдаление), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.Удалена))
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%ОСАГО%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%КАСКО%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%квит%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%купиполис%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%ДК%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%СРАВНИ%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%ДСАГО%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "ГО%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "Бланк универсальный"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%сертификат%"
	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%приглашение%"
	
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &gt; ДАТАВРЕМЯ(2018, 10, 1)
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &gt;= НАЧАЛОПЕРИОДА(&amp;Дата1, ДЕНЬ)
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Дата2, ДЕНЬ)
	И (&amp;Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			ИЛИ уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер = &amp;Менеджер)</query>
	</dataSet>
