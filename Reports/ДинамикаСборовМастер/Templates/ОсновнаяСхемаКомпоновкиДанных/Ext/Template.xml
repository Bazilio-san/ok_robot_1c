		<query>ВЫБРАТЬ
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
ПОМЕСТИТЬ Агенты
ИЗ
	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&amp;Дата2, ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
ГДЕ
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Наименование ПОДОБНО "М-%"
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Дата, ДЕНЬ) КАК День,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка КАК Документ,
	СУММА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия) КАК ПремияПлан,
	СУММА(ВЫРАЗИТЬ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.КВБрокераПлан * уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия / 100 КАК ЧИСЛО(15, 2))) КАК КВПлан,
	СУММА((ВЫРАЗИТЬ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.КВБрокераПлан * уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия / 100 КАК ЧИСЛО(15, 2))) - уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогПредоставленнаяСкидка) КАК СКВПлан,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка) КАК КолВыездов,
	0 КАК Премия,
	0 КАК КВ,
	0 КАК СКВ,
	0 КАК КолОплат,
	АГЕНТЫ.Подразделение
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Агенты КАК АГЕНТЫ
		ПО уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Менеджер = АГЕНТЫ.Агент
ГДЕ
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Дата &gt;= &amp;Дата1
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Утверждено = ИСТИНА
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Дата &lt; &amp;Дата2
	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.ИтогСтраховаяПремия &gt; 0

СГРУППИРОВАТЬ ПО
	АГЕНТЫ.Подразделение,
	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	НАЧАЛОПЕРИОДА(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Дата, ДЕНЬ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(уб_ОплатаПолисов.Дата, ДЕНЬ),
	уб_ОплатаПолисов.Ссылка,
	0,
	0,
	0,
	0,
	уб_ОплатаПолисов.НачисленнаяСуммаВзноса,
	уб_ОплатаПолисов.КВСуммаДляАгента,
	уб_ОплатаПолисов.КВСуммаДляАгента - уб_ОплатаПолисов.АВилиСкидкаСумма,
	1,
	уб_ОплатаПолисов.Подразделение
ИЗ
	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
ГДЕ
	уб_ОплатаПолисов.Подразделение.Наименование ПОДОБНО "М-%"
	И уб_ОплатаПолисов.ПометкаУдаления = ЛОЖЬ
	И уб_ОплатаПолисов.Дата &gt;= &amp;Дата1
	И уб_ОплатаПолисов.Дата &lt; &amp;Дата2</query>
