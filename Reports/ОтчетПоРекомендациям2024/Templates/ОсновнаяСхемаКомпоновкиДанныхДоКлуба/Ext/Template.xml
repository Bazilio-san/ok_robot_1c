		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	полис.Страхователь,
	МИНИМУМ(полис.ДатаНачала) КАК ДатаНачала,
	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис
ПОМЕСТИТЬ ДатыПервыхПолисов
ИЗ
	Документ.уб_СтраховойПолис КАК полис
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗаменаПолисов.СрезПоследних КАК уб_ЗаменаПолисовСрезПоследних
		ПО (уб_ЗаменаПолисовСрезПоследних.НовыйПолис = полис.Ссылка)
ГДЕ
	НЕ полис.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
	И полис.СтраховаяПремия &gt; 0
	И уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис ЕСТЬ NULL

СГРУППИРОВАТЬ ПО
	полис.Страхователь,
	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОП.Ссылка КАК Оплата,
	ОП.СтраховойПолис.Заявка КАК Заявка,
	ОП.СтраховойПолис.Заявка.Менеджер КАК Менеджер,
	ОП.СтраховойПолис.Заявка.Страхователь КАК Страхователь,
	ОП.СтраховойПолис.Заявка,
	ОП.СтраховойПолис.Заявка.Источник КАК Источник,
	ОП.СтраховойПолис.Заявка.ДатаСоздания КАК ДатаСоздания,
	ОП.СтраховойПолис.Номер КАК НомерПолиса,
	СУММА(ОП.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
	СУММА(ВЫБОР
			КОГДА ОП.ОплаченоФакт &gt; 0
					И ОП.КВСумма &gt;= ОП.АВилиСкидкаСумма
				ТОГДА ОП.КВСумма - ОП.АВилиСкидкаСумма
			ИНАЧЕ 0
		КОНЕЦ * (100 - ОП.ПроцентСКВ) / 100) КАК СКВ,
	СУММА(ОП.КВСумма) КАК КВСумма,
	ВЫРАЗИТЬ(ВЫБОР
			КОГДА СУММА(ОП.НачисленнаяСуммаВзноса) = 0
				ТОГДА 0
			ИНАЧЕ СУММА(ОП.КВСумма) * 100 / СУММА(ОП.НачисленнаяСуммаВзноса)
		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК КВПроцент,
	ВЫБОР
		КОГДА ОП.НомерВзноса = 1
				И РАЗНОСТЬДАТ(ДатыПервыхПолисов.ДатаНачала, ОП.СтраховойПолис.Заявка.ДатаСоздания, МЕСЯЦ) &lt; 3
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК НовыйКлиент,
	ОП.ВидСП
ПОМЕСТИТЬ Оплаты
ИЗ
	Документ.уб_ОплатаПолисов КАК ОП
		ЛЕВОЕ СОЕДИНЕНИЕ ДатыПервыхПолисов КАК ДатыПервыхПолисов
		ПО ОП.СтраховойПолис.Страхователь = ДатыПервыхПолисов.Страхователь
ГДЕ
	ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
	И НЕ ОП.СтраховойПолис.Ссылка = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
	И ОП.СтраховойПолис.ПометкаУдаления = ЛОЖЬ
	И ОП.ПометкаУдаления = ЛОЖЬ
	И ОП.НеВключатьВОтчетыПоставщикам = ЛОЖЬ
	И ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	И ОП.СтраховойПолис.Заявка.Дата &gt;= &amp;ДатаНачала
	И ОП.СтраховойПолис.Заявка.Дата &lt;= &amp;ДатаОкончания
	И ОП.СтраховойПолис.Заявка.Источник = "Рекомендация"
	И ОП.СтраховойПолис.Заявка.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипВыезда.Страховка)
	И ОП.СК.Наименование &lt;&gt; "-- КупиПолис --"
	И ОП.НомерВзноса = 1
	И ОП.НачисленнаяСуммаВзноса &gt;= 1000

СГРУППИРОВАТЬ ПО
	ОП.Ссылка,
	ОП.СтраховойПолис.Заявка.Менеджер,
	ОП.СтраховойПолис.Заявка.Страхователь,
	ОП.СтраховойПолис.Заявка,
	ОП.СтраховойПолис.Номер,
	ОП.СтраховойПолис.Заявка.Источник,
	ОП.СтраховойПолис.Заявка.ДатаСоздания,
	ВЫБОР
		КОГДА ОП.НомерВзноса = 1
				И РАЗНОСТЬДАТ(ДатыПервыхПолисов.ДатаНачала, ОП.СтраховойПолис.Заявка.ДатаСоздания, МЕСЯЦ) &lt; 3
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	ОП.ВидСП,
	ОП.СтраховойПолис.Заявка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОП.Заявка,
	ОП.Менеджер,
	СУММА(ВЫБОР
			КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго)
					ИЛИ ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕОсаго)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОСАГО,
	МАКСИМУМ(ВЫБОР
			КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго)
					ИЛИ ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕОсаго)
				ТОГДА ОП.НомерПолиса
			ИНАЧЕ ""
		КОНЕЦ) КАК ОСАГОНомер,
	СУММА(ВЫБОР
			КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско)
					ИЛИ ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕКаско)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Каско,
	МАКСИМУМ(ВЫБОР
			КОГДА ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско)
					ИЛИ ОП.ВидСП = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕКаско)
				ТОГДА ОП.НомерПолиса
			ИНАЧЕ ""
		КОНЕЦ) КАК КаскоНомер,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
ПОМЕСТИТЬ Данные
ИЗ
	Оплаты КАК ОП
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		ПО ОП.Менеджер = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
ГДЕ
	ОП.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕКаско), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ЕОсаго))
	И ВЫБОР
			КОГДА ОП.Заявка.Дата &gt;= ДАТАВРЕМЯ(2024, 5, 1)
				ТОГДА ВЫБОР
						КОГДА ОП.НовыйКлиент = 1
							ТОГДА ИСТИНА
						ИНАЧЕ ЛОЖЬ
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	ОП.Заявка,
	ОП.Менеджер,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Данные.Заявка,
	1 КАК Количество,
	Данные.Менеджер,
	Данные.ОСАГО,
	Данные.ОСАГОНомер,
	Данные.Каско,
	Данные.КаскоНомер,
	Данные.Подразделение,
	уб_ЗП_ПоказателиРасчетаЗП.РекомендацияКаско,
	уб_ЗП_ПоказателиРасчетаЗП.РекомендацияОсаго,
	уб_ЗП_ПоказателиРасчетаЗП.РекомендацияКаскоПлюсОсаго,
	ВЫБОР
		КОГДА Данные.ОСАГО &gt; 0
				И Данные.Каско &gt; 0
			ТОГДА уб_ЗП_ПоказателиРасчетаЗП.РекомендацияКаскоПлюсОсаго
		КОГДА Данные.Каско &gt; 0
			ТОГДА уб_ЗП_ПоказателиРасчетаЗП.РекомендацияКаско
		КОГДА Данные.ОСАГО &gt; 0
			ТОГДА уб_ЗП_ПоказателиРасчетаЗП.РекомендацияОсаго
		ИНАЧЕ 0
	КОНЕЦ КАК Вознаграждение
ИЗ
	Данные КАК Данные
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних(&amp;ДатаОкончания, ) КАК уб_ЗП_ПоказателиРасчетаЗП
		ПО (ИСТИНА)</query>
	</dataSet>
