&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если День(ТекущаяДата())>10 Тогда
		Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ЭтотМесяц);
	Иначе
		Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПрошлыйМесяц);
	КонецЕсли;
		
	
	ПараметрыФункции = Неопределено;
	уб_СС.ПодчиненныеРуководителя(, ТекущаяДата(), ПараметрыФункции);
	Если РольДоступна("ПолныеПрава") Тогда
		СписокСотрудников = 	уб_СС.ПолучитьСписокСотрудниковАктуальныхВМесяце(ТекущаяДата());
	Иначе
		СписокСотрудников = ПараметрыФункции.СписокСотрудников;
		Элементы.НастройкиОтчета.Доступность = Ложь;
	КонецЕсли;
	
	Если Не РольДоступна("ПолныеПрава") Тогда
		Если СписокСотрудников.Количество() = 0 Тогда
			СписокСотрудников.Добавить(ПараметрыСеанса.уб_ТекущееФизЛицо);
		КонецЕсли;	
	КонецЕсли;	
	Если СписокСотрудников.Количество() = 1 Тогда
		Менеджер = СписокСотрудников[0].Значение ;
		Элементы.Менеджер.ТолькоПросмотр = Истина;
		Элементы.Подразделение.Видимость = Ложь;
	КонецЕсли;	
	
	Элементы.Менеджер.СписокВыбора.ЗагрузитьЗначения(СписокСотрудников.ВыгрузитьЗначения());

	Элементы.Подразделение.СписокВыбора.ЗагрузитьЗначения(уб_temp.ПолучитьСписокАктуальныхПодразделений().ВыгрузитьЗначения());

	
КонецПроцедуры


