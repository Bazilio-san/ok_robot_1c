&НаСервере
Процедура УстановитьОтбор()
	Обработка = РеквизитФормыВЗначение("Отчет");
	
	
	СписокСотрудников = Элементы.Менеджер.СписокВыбора.ВыгрузитьЗначения();	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Менеджер");
	Настройка = Обработка.КомпоновщикНастроек.Настройки;
	
	ТекПараметр = Настройка.ПараметрыДанных.Элементы.Найти("ДатаНачала");
	ТекПараметр.Использование = Истина;
	ТекПараметр.Значение      = Период.ДатаНачала;
	//
	ТекПараметр = Настройка.ПараметрыДанных.Элементы.Найти("ДатаОкончания");
	ТекПараметр.Использование = Истина;
	ТекПараметр.Значение      = Период.ДатаОкончания;
	
	//Отбор по доступным менеджера 
	Если  СписокСотрудников.Количество()>0 Тогда
		
		ФлЕстьОтбор = Ложь;
		Для каждого ЭлементОтбора из Настройка.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ПолеОтбора
				и ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке Тогда
				ФлЕстьОтбор = Истина;
				Прервать
			КонецЕсли;
		КонецЦикла;	
		Если ФлЕстьОтбор = ЛОЖЬ Тогда
			ЭлементОтбора = Настройка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		КонецЕсли;	
		ЭлементОтбора.ЛевоеЗначение		= ПолеОтбора;
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование 	= Истина;
		//ЭлементОтбора.ПравоеЗначение 	= Справочники.ФизическиеЛица.ПустаяСсылка();
		ЭлементОтбора.Представление		= ""+СписокСотрудников;
		ЭлементОтбора.ПравоеЗначение	= СписокСотрудников;
		
		
	КонецЕсли;	
	
	
	//Отбор по менеджеру
	ФлЕстьОтбор = Ложь;
	Для каждого ЭлементОтбора из Настройка.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = ПолеОтбора
			и ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно Тогда
			ФлЕстьОтбор = Истина;
			Прервать
		КонецЕсли;
	КонецЦикла;	
	Если ФлЕстьОтбор = ЛОЖЬ Тогда
		ЭлементОтбора = Настройка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	
	ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Менеджер");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование 	= ЗначениеЗаполнено(Менеджер);
	//ЭлементОтбора.Представление		= Поставщик;
	ЭлементОтбора.ПравоеЗначение	= Менеджер;
	ЗначениеВРеквизитФормы(Обработка,"Отчет");
КонецПроцедуры	

