		<query>ВЫБРАТЬ
	уб_ИсторияСтатусовЗаявок.Период,
	уб_ИсторияСтатусовЗаявок.Заявка,
	уб_ИсторияСтатусовЗаявок.Статус
	//,
	//уб_ИсторияСтатусовЗаявок.Доработка,
	//уб_ИсторияСтатусовЗаявок.ТребуетсяВозвратБСО,
	//уб_ИсторияСтатусовЗаявок.Автор,
	//уб_ИсторияСтатусовЗаявок.ДатаСоздания,
	//уб_ИсторияСтатусовЗаявок.Модификатор,
	//уб_ИсторияСтатусовЗаявок.ДатаИзменения
ПОМЕСТИТЬ ИсторияСтатусов
ИЗ
	РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних({ДатаВремя(1,1,1)}
			,
			Заявка В
				(ВЫБРАТЬ
					уб_ИсторияСтатусовЗаявок.Заявка
				ИЗ
					РегистрСведений.уб_ИсторияСтатусовЗаявок КАК уб_ИсторияСтатусовЗаявок
				ГДЕ
					уб_ИсторияСтатусовЗаявок.Период &gt;= &amp;Дата1
					И уб_ИсторияСтатусовЗаявок.Период &lt;= &amp;Дата2
					И уб_ИсторияСтатусовЗаявок.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО))) КАК уб_ИсторияСтатусовЗаявок
ОБЪЕДИНИТЬ

ВЫБРАТЬ
	уб_ИсторияСтатусовЗаявок.Период,
	уб_ИсторияСтатусовЗаявок.Заявка,
	уб_ИсторияСтатусовЗаявок.Статус//,
	//уб_ИсторияСтатусовЗаявок.Доработка,
	//уб_ИсторияСтатусовЗаявок.ТребуетсяВозвратБСО,
	//уб_ИсторияСтатусовЗаявок.Автор,
	//уб_ИсторияСтатусовЗаявок.ДатаСоздания,
	//уб_ИсторияСтатусовЗаявок.Модификатор,
	//уб_ИсторияСтатусовЗаявок.ДатаИзменения
ИЗ
	РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних({ДатаВремя(1,1,1)}) КАК уб_ИсторияСтатусовЗаявок
ГДЕ
	уб_ИсторияСтатусовЗаявок.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО,
	ВЫБОР
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%каско%"
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Каско)
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%осаго%"
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Осаго)
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%Имущество%"
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Имущество)
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%ДМС%"
			ТОГДА ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ДМС)
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%Техосмотр%"
			ТОГДА "ДК"
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО "%ДК%"
			ТОГДА "ДК"
		ИНАЧЕ "Прочее"
	КОНЕЦ КАК видСп,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка,
	Выбор когда уб_ИсторияСтатусовЗаявокСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО) Тогда 1 Иначе 0 Конец  КАК Количество,
	Выбор когда уб_ИсторияСтатусовЗаявокСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО) Тогда 0 Иначе 1 Конец  КАК Выполнено,
	ВЫБОР
		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Оператор = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			ТОГДА уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка.СтаршийОператор
		ИНАЧЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Оператор
	КОНЕЦ КАК Оператор,
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Состояние,
	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус
ИЗ
	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсторияСтатусов КАК уб_ИсторияСтатусовЗаявокСрезПоследних
		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка = уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка
			И (уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Тип В (ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис), ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОСАГО), ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.КвитанцияА7)))
			//И (уб_ИсторияСтатусовЗаявокСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ФормированиеКомплектаБСО))
ГДЕ
	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка.РезультатПроверки В (ЗНАЧЕНИЕ(Перечисление.уб_РезультатПроверкиЗаявки.ПринятоВРаботу), ЗНАЧЕНИЕ(Перечисление.уб_РезультатПроверкиЗаявки.ПринятоСДоработкой))
	И НЕ(уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Оператор = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				И уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка.СтаршийОператор = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))</query>
	</dataSet>
