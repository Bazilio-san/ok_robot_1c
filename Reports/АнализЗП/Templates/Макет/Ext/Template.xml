		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипПодразделения.ТочкаПродаж)
				И НЕ уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Наименование = "СВС"
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ОтделПродаж,
	уб_Начисления.Сотрудник КАК Сотрудник,
	уб_Начисления.Результат КАК Результат,
	уб_Начисления.Ссылка.Дата КАК Дата,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Владелец.Наименование КАК Организация,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение КАК Подразделение,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Период КАК Период,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие КАК Выбытие
ПОМЕСТИТЬ Начисления
ИЗ
	Документ.уб_НачислениеЗП.Начисления КАК уб_Начисления
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		ПО уб_Начисления.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
ГДЕ
	уб_Начисления.Ссылка.Дата &gt;= &amp;ДатаНачала
	И уб_Начисления.Ссылка.Дата &lt;= &amp;ДатаКонца

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ИСТИНА,
	уб_НачислениеЗПВознаграждениеЗаПродажи.Сотрудник,
	уб_НачислениеЗПВознаграждениеЗаПродажи.Результат,
	уб_НачислениеЗПВознаграждениеЗаПродажи.Ссылка.Дата,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Владелец.Наименование,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Период,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
ИЗ
	Документ.уб_НачислениеЗП.ВознаграждениеЗаПродажи КАК уб_НачислениеЗПВознаграждениеЗаПродажи
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		ПО уб_НачислениеЗПВознаграждениеЗаПродажи.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
ГДЕ
	уб_НачислениеЗПВознаграждениеЗаПродажи.Ссылка.Дата &gt;= &amp;ДатаНачала
	И уб_НачислениеЗПВознаграждениеЗаПродажи.Ссылка.Дата &lt;= &amp;ДатаКонца
	И уб_НачислениеЗПВознаграждениеЗаПродажи.Сотрудник.Код &lt;&gt; "000046790"
	И ВЫБОР
			КОГДА &amp;БезЛичек = ИСТИНА
				ТОГДА ВЫБОР
						КОГДА уб_НачислениеЗПВознаграждениеЗаПродажи.Начисление = Значение(ПланВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознПродВМ)
							ТОГДА ЛОЖЬ
						ИНАЧЕ ИСТИНА
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипПодразделения.ТочкаПродаж)
				И НЕ уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Наименование = "СВС"
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	НачисленияРазовые.Сотрудник,
	НачисленияРазовые.Результат,
	НачисленияРазовые.Ссылка.Дата,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Владелец.Наименование,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Период,
	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
ИЗ
	Документ.уб_НачислениеЗП.НачисленияРазовые КАК НачисленияРазовые
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		ПО НачисленияРазовые.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
ГДЕ
	НачисленияРазовые.Ссылка.Дата &gt;= &amp;ДатаНачала
	И НачисленияРазовые.Ссылка.Дата &lt;= &amp;ДатаКонца

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипПодразделения.ТочкаПродаж)
				И НЕ уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение.Наименование = "СВС"
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	НачисленияРазовые.Сотрудник,
	НачисленияРазовые.Результат,
	НачисленияРазовые.Ссылка.Дата,
