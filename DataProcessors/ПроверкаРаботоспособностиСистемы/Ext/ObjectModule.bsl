Перем ПараметрыОбработки Экспорт;

Процедура ВыполнитьОбработку() Экспорт
	
	Если ПараметрыОбработки = Неопределено  Тогда
		ИнициализироватьПараметры();
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("ПодсчетКоличестваФайловВЗаявке") Тогда
		ПодсчетКоличестваФайловВЗаявке();
	КонецЕсли;	
	
	//Проверка итогов отчеты без включенных оплат
	Если ПараметрыОбработки.Свойство("ИсправитьИтогиОтчетовПоставщику") Тогда
		ИсправитьИтогиОтчетовПоставщику();
	КонецЕсли;	
	
	Если ПараметрыОбработки.Свойство("СинхронизироватьЕстьЧек") тогда
		СинхронизироватьЕстьЧек();
	КонецЕсли;	

	
	Если ПараметрыОбработки.Свойство("ПроверкаСКВ") Тогда
		ПроверкаСКВ();
	КонецЕсли;	
	
	
	Если ПараметрыОбработки.Свойство("ПроверкаНаличияПеремещений") Тогда
		ПроверкаНаличияПеремещений();
	КонецЕсли;	
	
	Если ПараметрыОбработки.Свойство("АнализРекомендаций") Тогда
		Если Минута(ТекущаяДата())<6 или РольДоступна("уб_ЗП_ПолныйДоступ") Тогда
			АнализРекомендаций();
		КонецЕсли;	
	КонецЕсли;	
	Если ПараметрыОбработки.Свойство("АнализРекомендацийСразу") Тогда
		АнализРекомендаций();
	КонецЕсли;	
	
	Если ПараметрыОбработки.Свойство("СинхронизироватьАгентаВПеремещениях") Тогда
		СинхронизироватьАгентаВПеремещениях();
	КонецЕсли;	
	
	Если ПараметрыОбработки.Свойство("ОбработатьСтраховойПолисВДвижениях") Тогда
		ОбработатьСтраховойПолисВДвижениях();
	КонецЕсли;
		
	Если ПараметрыОбработки.Свойство("ПроверитьШтрафыЗаОпоздание") Тогда
		ПроверитьШтрафыЗаОпоздание();
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("ЗаполнитьВДокументахОплатаПолисовСхемуРасчетаСМенеджером") Тогда
		ЗаполнитьВДокументахОплатаПолисовСхемуРасчетаСМенеджером();
	КонецЕсли;
	Если ПараметрыОбработки.Свойство("УдалитьЛишниеВзаиморасчетыВСК") Тогда
		УдалитьЛишниеВзаиморасчетыВСК();
	КонецЕсли;
	Если ПараметрыОбработки.Свойство("ДобавитьОтсутствующиеОплатыВСК") Тогда
		ДобавитьОтсутствующиеОплатыВСК();
	КонецЕсли;	
	//Исправляется дата движения БСО
	Если ПараметрыОбработки.Свойство("ПроверкаОплатСПоступлениемПоКвитанцииПозжеДвижения") Тогда
		ПроверкаОплатСПоступлениемПоКвитанцииПозжеДвижения();
	КонецЕсли;	
	//Если ПараметрыОбработки.Свойство("ПроверкаЗависшихСоединений") Тогда
	//	ПроверкаЗависшихСоединений(Истина,"1640");
	//КонецЕсли;	
	//Если ПараметрыОбработки.Свойство("ПроверкаПерезапускаРабочихПроцессовСервера") Тогда
	//	ПроверкаПерезапускаРабочихПроцессовСервера(Истина, "1640");
	//КонецЕсли;	
	//Если ПараметрыОбработки.Свойство("ПроверитьЗаполнитьПредопределенные") Тогда
	//	ПроверитьЗаполнитьПредопределенные();
	//КонецЕсли;	
	Если ПараметрыОбработки.Свойство("ПроверкаНаличияДанныхКонфигурации") Тогда
		#Если Клиент Тогда
			ПроверкаНаличияДанныхКонфигурации();
		#КонецЕсли	
	КонецЕсли;	
	
		
	Если ПараметрыОбработки.Свойство("ПроверкаОплатПолисовБезИстории") Тогда
		ПроверкаОплатПолисовБезИстории();
	КонецЕсли;
	
	
	Если ПараметрыОбработки.Свойство("Оплаты_Поставщику_С_НулевойСуммой") Тогда
		Оплаты_Поставщику_С_НулевойСуммой();  // в дальнейшем исправление руками
	КонецЕсли;	
	
	
	Если ПараметрыОбработки.Свойство("ПроверкаКорректностиПВХНастройкиПользователя") Тогда
		ПроверкаКорректностиПВХНастройкиПользователя();
	КонецЕсли;
	
	
	Если ПараметрыОбработки.Свойство("ПроверкаАутентификацииПользователей") Тогда
		ПроверкаАутентификацииПользователей();
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("ПровестиСтатусыПриемок") тогда
		ПровестиСтатусыПриемок();
	КонецЕсли;	
	
	Если ПараметрыОбработки.Свойство("ПроверкаЗаявокСОтказом") тогда
		ПроверкаЗаявокСОтказом();
	КонецЕсли;	
	
	
	Если ПараметрыОбработки.Свойство("ОбновитьМарки") 
		и ДеньНедели(ТекущаяДата())=1
		и Час(ТекущаяДата())=5
		тогда
		//Обработка = Обработки.ЗагрузкаМарокИМоделей.Создать();
		//Обработка.Обновить();
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("ПроставитьБонусыРекомендаций") и ПараметрыОбработки.ПроставитьБонусыРекомендаций = Истина Тогда
		ПроставитьБонусыРекомендаций();
	КонецЕсли;	
	Если ПараметрыОбработки.Свойство("ПроставитьБонусыКоробок") и ПараметрыОбработки.ПроставитьБонусыКоробок = Истина Тогда
		ПроставитьБонусыКоробок();
	КонецЕсли;	
			
КонецПроцедуры


Процедура ИнициализироватьПараметры() Экспорт 
	Час = Час(ТекущаяДата());
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ЗаполнитьВДокументахОплатаПолисовСхемуРасчетаСМенеджером",Истина);
	ПараметрыОбработки.Вставить("ПроверкаКорректностиПВХНастройкиПользователя",Истина);
	ПараметрыОбработки.Вставить("ПроверкаОплатПолисовБезИстории",Истина);
	ПараметрыОбработки.Вставить("УдалитьЛишниеВзаиморасчетыВСК",Истина);
	ПараметрыОбработки.Вставить("ДобавитьОтсутствующиеОплатыВСК",Истина);
	//ПараметрыОбработки.Вставить("ПроверкаОплатСПоступлениемПоКвитанцииПозжеДвижения",ЛОЖЬ);
	ПараметрыОбработки.Вставить("Оплаты_Поставщику_С_НулевойСуммой",Истина);
	ПараметрыОбработки.Вставить("ПроверкаЗависшихСоединений",Истина);
	//ПараметрыОбработки.Вставить("ПроверкаПерезапускаРабочихПроцессовСервера",Истина);
	//ПараметрыОбработки.Вставить("ПроверитьЗаполнитьПредопределенные",Истина);
	//ПараметрыОбработки.Вставить("ПроверкаНаличияДанныхКонфигурации",Истина);
	ПараметрыОбработки.Вставить("ИсправитьИтогиОтчетовПоставщику",Истина);	
	ПараметрыОбработки.Вставить("ПроверкаСКВ",Истина);	
	ПараметрыОбработки.Вставить("ОбновитьМарки",Истина);	
	ПараметрыОбработки.Вставить("ПроверкаНаличияПеремещений",Истина);	
	
	
	ПараметрыОбработки.Вставить("ПроверитьШтрафыЗаОпоздание",Истина);
	ПараметрыОбработки.Вставить("ПодсчетКоличестваФайловВЗаявке",Истина);
	//ПараметрыОбработки.Вставить("АнализРекомендаций",ЛОЖЬ);
	ПараметрыОбработки.Вставить("СинхронизироватьАгентаВПеремещениях",Истина);
	Если Час >2 и Час<4 Тогда
		ПараметрыОбработки.Вставить("ОбработатьСтраховойПолисВДвижениях",Истина);
	КонецЕсли;	
	ПараметрыОбработки.Вставить("ПровестиСтатусыПриемок",Истина);
	ПараметрыОбработки.Вставить("ПроверкаЗаявокСОтказом",Истина);
	ПараметрыОбработки.Вставить("ПроставитьБонусыРекомендаций",Истина);
	ПараметрыОбработки.Вставить("ПроставитьБонусыКоробок",Истина);
	ПараметрыОбработки.Вставить("СинхронизироватьЕстьЧек",Истина);
	
	
	
КонецПроцедуры	


