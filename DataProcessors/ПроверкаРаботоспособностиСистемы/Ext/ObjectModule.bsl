Функция ПроверкаКорректностиПВХНастройкиПользователя() Экспорт
	
	//при начале работы системы проверяет корректность реквизита вид настройки у ПВХ Настройки пользователи при несовпадении меняет по родителю
	Если уб_КЭШируемые.ДоступностьРоли("ПолныеПрава, ПравоАдминистрирования") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиПользователей.Ссылка,
		|	НастройкиПользователей.Родитель.ВидНастройки
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиПользователей КАК НастройкиПользователей
		|ГДЕ
		|	НастройкиПользователей.Родитель.ВидНастройки <> НастройкиПользователей.ВидНастройки";		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.ВидНастройки = Выборка.РодительВидНастройки;
			Попытка
				Объект.Записать();
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось записать ""РодительВидНастройки"" в объект " + Объект, ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
			КонецПопытки;
		КонецЦикла;
		//удалить после первого запуска
		Массив = Новый Массив;
		Массив.Добавить(Перечисления.уб_ВидыНастроекПользователей.Настройка);
		Массив.Добавить(Перечисления.уб_ВидыНастроекПользователей.Полномочие);
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиПользователей.Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиПользователей КАК НастройкиПользователей
		|ГДЕ
		|	НастройкиПользователей.ВидНастройки В(&НастройкаПолномочие)
		|	И НастройкиПользователей.ДобавлятьВПрофили";
		Запрос.УстановитьПараметр("НастройкаПолномочие", Массив);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	НастройкиПользователей.Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.НастройкиПользователей КАК НастройкиПользователей
			|ГДЕ
			|	НастройкиПользователей.ВидНастройки В(&НастройкаПолномочие)
			|	И НастройкиПользователей.Ссылка <> &ОсновнойОтветственный
			|	И НЕ НастройкиПользователей.ЭтоГруппа";
			Запрос.УстановитьПараметр("НастройкаПолномочие",	Массив);
			Запрос.УстановитьПараметр("ОсновнойОтветственный",  ПланыВидовХарактеристик.НастройкиПользователей.ОсновнойОтветственный);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Объект.ДобавлятьВПрофили = Истина;
				Попытка
					Объект.Записать()
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не записан " + Выборка.Ссылка + "
					|уб_temp.ПроверкаКорректностиПВХНастройкиПользователя");
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		//удалять до этой строки
	КонецЕсли;
КонецФункции




Процедура ПроверкаЗависшихСоединений(ТолькоНочью=Истина, ПортСервера = "1640") Экспорт
	
	Попытка
		ИмяСервера = "";
		ИмяЦентральногоСервера = "";
		ИмяБазы = "";
		ТекДата = ТекущаяДата();
		Если ТолькоНочью Тогда
			ЧасОт = 0;
			ЧасДо = 6;		
			НачалоТекДня = НачалоДня(ТекДата);
			ТекВремя = ТекДата - НачалоТекДня;
			Если НЕ ((ТекВремя >= 3600 * ЧасОт) И (ТекВремя <= 3600 * ЧасДо)) Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		
		КоличествоЧасовДляУдаленияСоединения = ПараметрыСеанса.уб_Константы.уб_КоличествоЧасовДляУдаленияСоединения;	
		Если (ТипЗнч(КоличествоЧасовДляУдаленияСоединения) = Тип("Число") И КоличествоЧасовДляУдаленияСоединения > 0) Или Не ТолькоНочью Тогда									
			Если Не ПолучитьДанныеПодключенияКБазе(СтрокаСоединенияИнформационнойБазы(), ИмяСервера, ИмяБазы, ПортСервера, ИмяЦентральногоСервера) Тогда
				Возврат;
			КонецЕсли;	
			
			Коннектор = Новый COMОбъект("v82.COMConnector");
			Агент = Коннектор.ConnectAgent(ИмяЦентральногоСервера);
			Кластеры = Агент.GetClusters();		
			Для каждого Кластер из Кластеры Цикл
				АдминистраторКластера = "";
				ПарольКластера = "";
				Агент.Authenticate(Кластер, АдминистраторКластера, ПарольКластера);
				Процессы = Агент.GetWorkingProcesses(Кластер);
				Для каждого Процесс из Процессы Цикл
					Если Не Процесс.Running Тогда
						Продолжить;
					КонецЕсли;	
					Порт = Процесс.MainPort;					
					// теперь есть адрес и порт для подключения к рабочему процессу
					РабПроц = Коннектор.ConnectWorkingProcess(ИмяСервера + ":" + СтрЗаменить(Порт, Символы.НПП, ""));
					ИмяАдминистратораБД = "";
					ПарольАдминистратораБД = "";			
					РабПроц.AddAuthentication(ИмяАдминистратораБД, ПарольАдминистратораБД);
					ИнформационнаяБаза = "";
					
					Базы = Агент.GetInfoBases(Кластер);
					Для каждого База из Базы Цикл
						Если НРег(База.Name) = НРег(ИмяБазы) Тогда
							ИнформационнаяБаза = База;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ИнформационнаяБаза = "" Тогда
						Продолжить;// база не найдена
					КонецЕсли;
					
					//Сеансы = Агент.GetInfoBaseSessions(Кластер, ИнформационнаяБаза);
					//Для каждого Сеанс из Сеансы Цикл
					//	Если нРег(Сеанс.AppID) = "backgroundjob" ИЛИ нРег(Сеанс.AppID) = "designer" Или нРег(Соединение.Application) = "srvrconsole" Тогда
					//		// если это сеансы конфигуратора или фонового задания или консоль сервера, то не отключаем
					//		Продолжить;
					//	КонецЕсли;
					//	Если Сеанс.UserName = ИмяПользователя() Тогда
					//		// это текущий пользователь
					//		Продолжить;
					//	КонецЕсли;
					//	
					//	Агент.TerminateSession(Кластер, Сеанс);
					//КонецЦикла;
					
					СоединенияБазы = Агент.GetInfoBaseConnections(Кластер, ИнформационнаяБаза);
					Для Каждого Соединение Из СоединенияБазы Цикл
						Если Найти(НРег(Соединение.Application), "web") <> 0 Тогда //если слово web в названии приложения										
							Если ТекДата - Соединение.ConnectedAt > 3600 * КоличествоЧасовДляУдаленияСоединения Тогда														
								РабПроц.Disconnect(Соединение);
							КонецЕсли;				
						КонецЕсли;																
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;		
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка при выполнении процедуры ПроверкаЗависшихСоединений", 
		УровеньЖурналаРегистрации.Ошибка, , ,
		ОписаниеОшибки() + " Имя сервера: " + ИмяСервера + ". Порт центрального сервера: " + ПортСервера +". Имя базы: " + ИмяБазы + ".");
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьДанныеПодключенияКБазе(СтрокаСоединенияИнформационнойБазы, ИмяСервера, ИмяБазы, ПортСервера, ИмяЦентральногоСервера)
	
	Если Найти(СтрокаСоединенияИнформационнойБазы, "Srvr") > 0 Тогда
		//серверный вариант
		Поиск1 = Найти(СтрокаСоединенияИнформационнойБазы, "Srvr=");
		ПодстрокаПоиска = Сред(СтрокаСоединенияИнформационнойБазы, Поиск1 + 6);
		ИмяСервера = Лев(ПодстрокаПоиска, Найти(ПодстрокаПоиска, """") - 1);
		Поиск2 = Найти(ИмяСервера, ":");//если указан порт кластера, то в имени центрального сервера нужно заменить на порт центрального сервера
		Если Поиск2 <> 0 Тогда
			ИмяЦентральногоСервера = Лев(ИмяСервера,Поиск2) + ПортСервера;	
		Иначе
			ИмяЦентральногоСервера = ИмяСервера +":" + ПортСервера;	
		КонецЕсли;
		//ищем имя базы
		Поиск1 = Найти(СтрокаСоединенияИнформационнойБазы, "Ref=");
		ПодстрокаПоиска = Сред(СтрокаСоединенияИнформационнойБазы, Поиск1 + 5);
		ИмяБазы = Лев(ПодстрокаПоиска, Найти(ПодстрокаПоиска, """") - 1);
		Если ИмяСервера = "" Или ИмяБазы = "" Тогда
			Возврат Ложь;
		Иначе	
			Возврат Истина;
		КонецЕсли;	
	Иначе
		// для других способов подключения алгоритм не актуален
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	

Процедура ПроверкаПерезапускаРабочихПроцессовСервера(ТолькоНочью=Истина, ПортСервера = "1640") Экспорт
	
	Попытка 
		ИмяСервера = "";
		ИмяБазы = "";
		ИмяЦентральногоСервера = "";
		ТекДата = ТекущаяДата();
		Если ТолькоНочью Тогда
			ЧасОт = 0;
			ЧасДо = 6;	
			НачалоТекДня = НачалоДня(ТекДата);
			ТекВремя = ТекДата - НачалоТекДня;
			Если НЕ ((ТекВремя >= 3600 * ЧасОт) И (ТекВремя <= 3600 * ЧасДо)) Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		
		КоличествоЧасовДляУдаленияСоединения = ПараметрыСеанса.уб_Константы.уб_КоличествоЧасовДляУдаленияСоединения;	
		Если (ТипЗнч(КоличествоЧасовДляУдаленияСоединения) = Тип("Число") И КоличествоЧасовДляУдаленияСоединения > 0) Или Не ТолькоНочью Тогда //процессы не перезапускаются если константа равна нулю
			                                                          
			Если Не ПолучитьДанныеПодключенияКБазе(СтрокаСоединенияИнформационнойБазы(), ИмяСервера, ИмяБазы, ПортСервера, ИмяЦентральногоСервера) Тогда
				Возврат;
			КонецЕсли;
			
			Коннектор = Новый COMОбъект("v82.COMConnector");
			Агент = Коннектор.ConnectAgent(ИмяЦентральногоСервера);
			Кластеры = Агент.GetClusters();
			Для каждого Кластер из Кластеры Цикл			
				
				АдминистраторКластера = "";
				ПарольКластера = "";
				Агент.Authenticate(Кластер, АдминистраторКластера, ПарольКластера);
				
				ИнформационнаяБаза = "";
				Базы = Агент.GetInfoBases(Кластер);
				Для каждого База из Базы Цикл
					Если НРег(База.Name) = НРег(ИмяБазы) Тогда
						ИнформационнаяБаза = База;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ИнформационнаяБаза = "" Тогда
					Продолжить;// база не найдена в этом кластере
				КонецЕсли;
				
				Процессы = Агент.GetWorkingProcesses(Кластер);										
				ЕстьАктивныеВыключенныеПроцессы = Ложь;
				Для каждого Процесс из Процессы Цикл
					Если Процесс.Running И Не Процесс.Enable Тогда
						ЕстьАктивныеВыключенныеПроцессы = Истина;
					КонецЕсли;	
				КонецЦикла;	
				
				Для каждого Процесс из Процессы Цикл										
					Если Процесс.Running И Процесс.Enable И (ТекДата - Процесс.StartedAt) > 3600 * КоличествоЧасовДляУдаленияСоединения И Не ЕстьАктивныеВыключенныеПроцессы Тогда						
						НовыйПроцесс = Агент.CreateWorkingProcessInfo();						
						НовыйПроцесс.HostName = Процесс.HostName;			
						НовыйПроцесс.Use = 1;
						НовыйПроцесс.Capacity = Процесс.Capacity;
						Агент.RegWorkingProcess(Кластер,НовыйПроцесс);				
						Агент.SetWorkingProcessUsage(Кластер,Процесс,0); 
					ИначеЕсли Не Процесс.Running Тогда 
						Агент.UnregWorkingProcess(Кластер,Процесс,Ложь);
					КонецЕсли;
				КонецЦикла;	
				
			КонецЦикла;		
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка при выполнении процедуры ПроверкаПерезапускаРабочихПроцессовСервера", 
		УровеньЖурналаРегистрации.Ошибка, , ,
		ОписаниеОшибки() + " Имя сервера: " + ИмяСервера + ". Порт центрального сервера: " + ПортСервера +". Имя базы: " + ИмяБазы + ".");
	КонецПопытки;
	
КонецПроцедуры	


Процедура ПроверкаНаличияДанныхКонфигурации() Экспорт
	
	Сообщение = "";
	Для Каждого Документ Из Метаданные.Документы Цикл
		МассивРеквизитов = Новый Массив;
		Для Каждого Реквизит Из Документ.Реквизиты Цикл
			МассивРеквизитов.Добавить(Реквизит.Имя)
		КонецЦикла;
		Форма = Документы[Документ.Имя].ПолучитьФорму(Документ.ОсновнаяФормаОбъекта.Имя);
		НетДанных = Истина;
		Для Каждого ЭлементФормы Из Форма.ЭлементыФормы Цикл
			Если Не ПустаяСтрока(ЭлементФормы.Данные) И МассивРеквизитов.Найти(ЭлементФормы.Данные) <> Неопределено Тогда
				//данные есть и они не равны
				НетДанных = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НетДанных Тогда
			Сообщение = Сообщение + "Нет данных: " + Документ.Имя + ", форма: " + Форма.Имя + "!!!
			|";
		КонецЕсли;
	КонецЦикла;
	Если Сообщение <> "" Тогда 
		Соо = Новый СообщениеПользователю;
		Соо.Текст = Сообщение;
		Соо.Сообщить();
		Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
		Параметры.Получатели 	= ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
		Параметры.Тема			= "Критичные ошибки хранилища конфигурации: нет данных";
		Параметры.Сообщение		= Сообщение;
		уб_ОбменДанными.SendMail(Параметры);
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроверитьШтрафыЗаОпоздание() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПодразделенияОрганизаций.Ссылка
	               |ПОМЕСТИТЬ Подразделения
	               |ИЗ
	               |	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	               |ГДЕ
	               |	ПодразделенияОрганизаций.Код В (""000000024"", ""000000023"", ""000000019"", 
				   //""000000018"",
	               |		""000000038"", ""000000025"", ""000000039"", ""000000042"")
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	уб_РуководителиПодразделенийСрезПоследних.Сотрудник
	               |ПОМЕСТИТЬ Руководители
	               |ИЗ
	               |	РегистрСведений.уб_РуководителиПодразделений.СрезПоследних КАК уб_РуководителиПодразделенийСрезПоследних
	               |ГДЕ
	               |	уб_РуководителиПодразделенийСрезПоследних.Уход = ЛОЖЬ
	               |	И уб_РуководителиПодразделенийСрезПоследних.Заместитель = ЛОЖЬ
	               |	И уб_РуководителиПодразделенийСрезПоследних.Подразделение В
	               |			(ВЫБРАТЬ
	               |				Подразделения.Ссылка
	               |			ИЗ
	               |				Подразделения)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие КАК АгентыНадоШтраф
	               |ИЗ
	               |	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	               |ГДЕ
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ЛОЖЬ
	               |	И уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение В
	               |			(ВЫБРАТЬ
	               |				Подразделения.Ссылка
	               |			ИЗ
	               |				Подразделения)
	               |	И НЕ уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент В
	               |				(ВЫБРАТЬ
	               |					Руководители.Сотрудник
	               |				ИЗ
	               |					Руководители)
	               |	И НЕ уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент В
	               |				(ВЫБРАТЬ
	               |					уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник
	               |				ИЗ
	               |					РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПоследних(, ТипПараметра = ""Начислять штраф за опаздание в план"") КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МЗ = Регистрысведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СоздатьМенеджерЗаписи();
		МЗ.Сотрудник         = Выборка.Агент;
		МЗ.ТипПараметра      = "Начислять штраф за опаздание в план";
		МЗ.ЗначениеПараметра = 2000;
		МЗ.Период = НачалоМесяца (ТекущаяДата());
		Попытка
			МЗ.Записать();
		Исключение
		КонецПопытки;	
	КонецЦикла;
	
КонецПроцедуры 	


Функция ПодсчетКоличестваФайловВЗаявке() Экспорт
	
	Если Час(ТекущаяДата())=1 Тогда
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.СсылкаСправочника,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Курьер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Менеджер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ФайловКурьер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ФайловМенеджер,
	               |	уб_ФайлыКПолисам.Автор,
	               |	уб_ФайлыКПолисам.ДатаПубликации,
	               |	ВЫБОР
	               |		КОГДА уб_ФайлыКПолисам.Автор.ФизЛицо = уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Менеджер
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ФайловМенеджерФакт,
	               |	ВЫБОР
	               |		КОГДА уб_ФайлыКПолисам.Автор.ФизЛицо = уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Курьер
	               |				И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Менеджер = уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Курьер
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ФайловКурьерФакт,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ФайловБланкиПлан,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ФайловБланкиФакт,
	               |	ВЫБОР
	               |		КОГДА уб_ФайлыКПолисам.ДатаПубликации >= уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ДатаСоздания
	               |				И (уб_ФайлыКПолисам.ВидДокумента В (ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.Полис), ЗНАЧЕНИЕ(Справочник.уб_ВидыДокументовКПолисам.Квитанция))
	            //   |					ИЛИ уб_ФайлыКПолисам.ВидДокумента.Наименование В (""_Фото А7 КАСКО"",""_Фото А7 ОСАГО"",""_Фото ДК"",""_Фото КАСКО"",""_Фото ОСАГО""))
				|   ИЛИ уб_ФайлыКПолисам.ВидДокумента.Наименование В (""_Фото А7 КАСКО"", ""_Фото А7 ОСАГО"", ""_Фото ДК"", ""_Фото КАСКО"", ""_Фото ОСАГО"",""_Фото КАСКО квитанция"",""_Фото КАСКО полис"",""_Фото ОСАГО полис"",""_Фото ОСАГО квитанция""))
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НовыйФайловБланкиФакт
	               |ПОМЕСТИТЬ АнализКоличества
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	               |		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.СсылкаСправочника = уб_ФайлыКПолисам.УИД
	               |			И (уб_ФайлыКПолисам.ДатаПубликации >= уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.ДатаСоздания
	               |				ИЛИ уб_ФайлыКПолисам.ДатаПубликации = ДАТАВРЕМЯ(1, 1, 1))
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Дата >= ДАТАВРЕМЯ(2018, 10, 1)
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Дата < &Текдата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
				|   	БСО.Ссылка,
				|   	СУММА(
				|   	Выбор Когда 
				|   	БСО.ВидБСО.Тип В (ЗНАЧЕНИЕ(перечисление.уб_ТипыБСО.Полис), ЗНАЧЕНИЕ(перечисление.уб_ТипыБСО.ПолисОСАГО), ЗНАЧЕНИЕ(перечисление.уб_ТипыБСО.КвитанцияА7))
				|   	И
				|   	БСО.Ссылка.Дата < ДАТАВРЕМЯ(2020, 1, 1)  или БСО.ВидБСО.ВключатьВРасчетФайлов = Истина Тогда
				|   	1 иначе 0 Конец) КАК НовыйФайловБланкиПлан
				|   ПОМЕСТИТЬ АнализБСО
				|   ИЗ
				|   	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК БСО
				|   ГДЕ
				|   	БСО.Ссылка.Дата >= ДАТАВРЕМЯ(2018, 10, 1)
				//  и 	БСО.Ссылка = &З
				|   	И БСО.Ссылка.Дата < &Текдата
				|СГРУППИРОВАТЬ ПО
	             |  	БСО.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АнализКоличества.Ссылка КАК Ссылка,
	               |	МАКСИМУМ(АнализКоличества.ФайловКурьер) КАК ФайловКурьер,
	               |	МАКСИМУМ(АнализКоличества.ФайловМенеджер) КАК ФайловМенеджер,
	               |	СУММА(АнализКоличества.ФайловМенеджерФакт) КАК ФайловМенеджерФакт,
	               |	СУММА(АнализКоличества.ФайловКурьерФакт) КАК ФайловКурьерФакт,
	               |	МАКСИМУМ(АнализКоличества.ФайловБланкиПлан) КАК ФайловБланкиПлан,
	               |	МАКСИМУМ(АнализКоличества.ФайловБланкиФакт) КАК ФайловБланкиФакт,
	               |	СУММА(АнализКоличества.НовыйФайловБланкиФакт) КАК НовыйФайловБланкиФакт
	               |ПОМЕСТИТЬ Анализ1
	               |ИЗ
	               |	АнализКоличества КАК АнализКоличества
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	АнализКоличества.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(Анализ1.Ссылка, АнализБСО.Ссылка) КАК Ссылка,
	               |	ЕСТЬNULL(Анализ1.Ссылка.Дата, АнализБСО.Ссылка.Дата) КАК Дата,
	               |	ЕСТЬNULL(Анализ1.ФайловКурьер, 0) КАК ФайловКурьер,
	               |	ЕСТЬNULL(Анализ1.ФайловКурьерФакт, 0) КАК ФайловКурьерФакт,
	               |	ЕСТЬNULL(Анализ1.ФайловМенеджер, 0) КАК ФайловМенеджер,
	               |	ЕСТЬNULL(Анализ1.ФайловМенеджерФакт, 0) КАК ФайловМенеджерФакт,
	               |	ЕСТЬNULL(Анализ1.ФайловБланкиПлан, 0) КАК ФайловБланкиПлан,
	               |	ЕСТЬNULL(АнализБСО.НовыйФайловБланкиПлан, 0) КАК НовыйФайловБланкиПлан,
	               |	ЕСТЬNULL(Анализ1.ФайловБланкиФакт, 0) КАК ФайловБланкиФакт,
	               |	ЕСТЬNULL(Анализ1.НовыйФайловБланкиФакт, 0) КАК НовыйФайловБланкиФакт
	               |ИЗ
	               |	Анализ1 КАК Анализ1
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АнализБСО КАК АнализБСО
	               |		ПО Анализ1.Ссылка = АнализБСО.Ссылка
	               |ГДЕ
	               |	(ЕСТЬNULL(Анализ1.ФайловМенеджер, 0) <> ЕСТЬNULL(Анализ1.ФайловМенеджерФакт, 0)
	               |			ИЛИ ЕСТЬNULL(Анализ1.ФайловКурьер, 0) <> ЕСТЬNULL(Анализ1.ФайловКурьерФакт, 0)
	               |			ИЛИ ЕСТЬNULL(Анализ1.ФайловБланкиФакт, 0) <> ЕСТЬNULL(Анализ1.НовыйФайловБланкиФакт, 0)
	               |			ИЛИ ЕСТЬNULL(Анализ1.ФайловБланкиПлан, 0) <> ЕСТЬNULL(АнализБСО.НовыйФайловБланкиПлан, 0))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Анализ1.Ссылка.Дата";
				   Запрос.УстановитьПараметр("Текдата",НачалоДня(ТекущаяДата()));
				   Запрос.УстановитьПараметр("СвойКонтрагент",ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент);
				   Выборка = Запрос.Выполнить().Выбрать();
				   Пока Выборка.Следующий() Цикл
					   Об = Выборка.Ссылка.ПолучитьОбъект();
					   Об.ОбменДанными.Загрузка = Истина;
					   
					   Об.ФайловКурьер   = Выборка.ФайловКурьерФакт;
					   Об.ФайловМенеджер = Выборка.ФайловМенеджерФакт;
					   Об.ФайловБланкиФакт   = Выборка.НовыйФайловБланкиФакт;
					   Об.ФайловБланкиПлан = Выборка.НовыйФайловБланкиПлан;
					   
					   Попытка
						   Об.Записать();
					   Исключение
					   КонецПопытки;
					   
				   КонецЦикла; 
КонецФункции	

Функция АнализРекомендаций()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	полис.Страхователь,
	               |	МИНИМУМ(полис.ДатаНачала) КАК ДатаНачала,
	               |	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис
	               |ПОМЕСТИТЬ ДатыПервыхПолисов
	               |ИЗ
	               |	Документ.уб_СтраховойПолис КАК полис
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗаменаПолисов.СрезПоследних КАК уб_ЗаменаПолисовСрезПоследних
	               |		ПО (уб_ЗаменаПолисовСрезПоследних.НовыйПолис = полис.Ссылка)
	               |ГДЕ
	               |	НЕ полис.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
	               |	И полис.СтраховаяПремия > 0
	               |	И уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис ЕСТЬ NULL 
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	полис.Страхователь,
	               |	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОП.Ссылка КАК Оплата,
	               |	ОП.СтраховойПолис.Заявка КАК Заявка,
	               |	ОП.СтраховойПолис.Заявка.Менеджер КАК Менеджер,
	               |	ОП.СтраховойПолис.Заявка.Страхователь КАК Страхователь,
	               |	ОП.СтраховойПолис.Заявка,
	               |	ОП.СтраховойПолис.Заявка.Источник КАК Источник,
	               |	ОП.СтраховойПолис.Заявка.ДатаСоздания КАК ДатаСоздания,
	               |	СУММА(ОП.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
	               |	СУММА(ВЫБОР
	               |			КОГДА ОП.ОплаченоФакт > 0
	               |					И ОП.КВСумма >= ОП.АВилиСкидкаСумма
	               |				ТОГДА ОП.КВСумма - ОП.АВилиСкидкаСумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ * (100 - ОП.ПроцентСКВ) / 100) КАК СКВ,
	               |	СУММА(ОП.КВСумма) КАК КВСумма,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА СУММА(ОП.НачисленнаяСуммаВзноса) = 0
	               |				ТОГДА 0
	               |			ИНАЧЕ СУММА(ОП.КВСумма) * 100 / СУММА(ОП.НачисленнаяСуммаВзноса)
	               |		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК КВПроцент,
	               |	ВЫБОР
	               |		КОГДА ОП.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ВЗР),  ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.НС))
	               |			ТОГДА 0
	               |		КОГДА ОП.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Имущество), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Произвольный))
	               |				И ОП.НачисленнаяСуммаВзноса < 1500
	               |			ТОГДА 0
	               |		КОГДА ОП.НомерВзноса = 1
	               |				И РАЗНОСТЬДАТ(ДатыПервыхПолисов.ДатаНачала, ОП.СтраховойПолис.Заявка.ДатаСоздания, МЕСЯЦ) < 3
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НовыйКлиент
	               |ПОМЕСТИТЬ Оплаты
	               |ИЗ
	               |	Документ.уб_ОплатаПолисов КАК ОП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДатыПервыхПолисов КАК ДатыПервыхПолисов
	               |		ПО ОП.СтраховойПолис.Страхователь = ДатыПервыхПолисов.Страхователь
	               |ГДЕ
	               |	ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
	               |	И НЕ ОП.СтраховойПолис.Ссылка = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
	               |	И ОП.СтраховойПолис.ПометкаУдаления = ЛОЖЬ
	               |	И ОП.ПометкаУдаления = ЛОЖЬ
	               |	И ОП.НеВключатьВОтчетыПоставщикам = ЛОЖЬ
	               |	И ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	               |	И ОП.СтраховойПолис.Заявка.ДатаСоздания >= &ДатаНачала
	               |	И ОП.СтраховойПолис.Заявка.Источник = ""Рекомендация""
	               |	И ОП.СК.Наименование <> ""-- КупиПолис --""
	               |	И ОП.НомерВзноса = 1
	               |	И ОП.НачисленнаяСуммаВзноса > 100
				   |    И ОП.СтраховойПолис.Заявка.Дата<ДатаВремя(2024,1,1)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОП.Ссылка,
	               |	ОП.СтраховойПолис.Заявка.Менеджер,
	               |	ОП.СтраховойПолис.Заявка.Страхователь,
	               |	ОП.СтраховойПолис.Заявка,
	               |	ОП.СтраховойПолис.Заявка.Источник,
	               |	ОП.СтраховойПолис.Заявка.ДатаСоздания,
	               |	ВЫБОР
	               |		КОГДА ОП.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ВЗР), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.НС))
	               |			ТОГДА 0
	               |		КОГДА ОП.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Имущество), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.Произвольный))
	               |				И ОП.НачисленнаяСуммаВзноса < 1500
	               |			ТОГДА 0
	               |		КОГДА ОП.НомерВзноса = 1
	               |				И РАЗНОСТЬДАТ(ДатыПервыхПолисов.ДатаНачала, ОП.СтраховойПолис.Заявка.ДатаСоздания, МЕСЯЦ) < 3
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ,
	               |	ОП.СтраховойПолис.Заявка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	оплаты.Заявка КАК Заявка,
	               |	оплаты.Менеджер КАК Менеджер,
	               |	оплаты.Заявка.ИндексРекомендации КАК ИндексРекомендации,
	               |	оплаты.Заявка.ИндексЦепочкиРекомендаций,
	               |	МАКСИМУМ(оплаты.НовыйКлиент) КАК НовыйКлиент,
	               |	оплаты.Заявка.Дата КАК ДатаЗаявки,
				   |	оплаты.Оплата.Подразделение.Наименование как ПодразделениеНаименование
	               |ИЗ
	               |	Оплаты КАК оплаты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	оплаты.Заявка,
	               |	оплаты.Менеджер,
	               |	оплаты.Заявка.ИндексРекомендации,
	               |	оплаты.Заявка.ИндексЦепочкиРекомендаций,
	               |	оплаты.Заявка.Дата,оплаты.Оплата.Подразделение.Наименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	оплаты.Заявка.ДатаСоздания
	               |ИТОГИ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	оплаты.Оплата,
	               |	оплаты.Заявка,
	               |	оплаты.Заявка.Дата КАК ДатаЗаявки,
	               |	оплаты.Менеджер,
	               |	оплаты.Страхователь,
	               |	оплаты.СтраховойПолисЗаявка,
	               |	оплаты.Источник,
	               |	оплаты.ДатаСоздания,
	               |	оплаты.НачисленнаяСуммаВзноса,
	               |	оплаты.СКВ,
	               |	оплаты.КВСумма,
	               |	оплаты.КВПроцент,
	               |	оплаты.НовыйКлиент,
	               |	оплаты.Оплата.Подразделение,
	               |	оплаты.Оплата.Подразделение.Наименование как ПодразделениеНаименование
	               |ИЗ
	               |	Оплаты КАК оплаты";
				   
				   Запрос.УстановитьПараметр("ДатаНачала",Дата(2018,10,1));
				   
				   Пакет = Запрос.ВыполнитьПакет();
				   Выборка = Пакет[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				   ВсеОплаты = Пакет[3].Выгрузить();
				   
				   Пока Выборка.Следующий() Цикл
					   ТекМенеджер = Выборка.Менеджер;
					   ТекущийИндекс = 0;
					   ТекущаяЦепочка = 0;
					   
					   СуммаКВ     = 0;
					   СуммаПремии = 0;
					   ВсегоОплат  = 0;
					   
					   ВыборкаЗаявок = Выборка.Выбрать();
					   Пока ВыборкаЗаявок.Следующий() Цикл
						   
						   Если ВыборкаЗаявок.ПодразделениеНаименование = "ОП-3" и ВыборкаЗаявок.Заявка.ДатаСоздания>Дата(2023,4,1) Тогда
							   Продолжить
						   ИначеЕсли ВыборкаЗаявок.Заявка.ДатаСоздания<Дата(2023,10,15) Тогда	   
							   Продолжить
						   КонецЕсли; 
					   
						   
						   
						   Если ВыборкаЗаявок.НовыйКлиент = 0 Тогда
							   //не считаются
							   ПриведенныйТекущийИндекс = 0;
						   Иначе
							   ТекущийИндекс = ТекущийИндекс+1;
							   ПриведенныйТекущийИндекс = ТекущийИндекс;
						   КонецЕсли; 
						   
						   Если ВыборкаЗаявок.ИндексРекомендации<>ПриведенныйТекущийИндекс Тогда
							   Об = ВыборкаЗаявок.Заявка.ПолучитьОбъект();
							   об.ОбменДанными.Загрузка = Истина;
							   об.ИндексРекомендации = ПриведенныйТекущийИндекс;
							   об.ИндексЦепочкиРекомендаций = ТекущаяЦепочка;
							   
							   Об.Записать();
						   КонецЕсли;	   
						   
						   Если ТекущийИндекс = 16 Тогда
							   СреднееКВ = Окр(?(ВсегоОплат =0,0,СуммаКВ/ВсегоОплат),2);
							   СредняяПремия = Окр(?(ВсегоОплат =0,0,СуммаПремии/ВсегоОплат),2);
							   найденныеОплаты = ВсеОплаты.НайтиСтроки(Новый Структура("Заявка",ВыборкаЗаявок.Заявка)); 
							   Подразделение = Неопределено;
							   Об = Документы.уб_ОплатаПолисов.ПустаяСсылка();
							   Для каждого СтрокаОплаты из найденныеОплаты Цикл
								   Об = СтрокаОплаты.Оплата.ПолучитьОбъект();
								  // об.ОбменДанными.Загрузка = Истина;
								   Если Об.НомерВзноса =1 и (об.СредняяПремияРекомендаций <> СредняяПремия
									   или об.СреднийКВРекомендаций <> СреднееКВ
									   или об.ИндексЦепочкиРекомендаций  <> ТекущаяЦепочка) Тогда
									   об.СредняяПремияРекомендаций = СредняяПремия;
									   об.СреднийКВРекомендаций = СреднееКВ;
									   об.ИндексЦепочкиРекомендаций  = ТекущаяЦепочка;
									   
									   Об.Записать();
								   КонецЕсли;
								   Подразделение = Об.Подразделение;
							   КонецЦикла;	   
							   Месяц = НачалоМесяца(ВыборкаЗаявок.Заявка.Дата);
							   Текст = "За рекомендации (группа "+Формат(ТекущаяЦепочка,"ЧН=; ЧГ=")+")";
							   //ТекМенеджер
							   Сумма =  Окр((СреднееКВ-6)*СредняяПремия/100,2);
							   ТекущийИндекс = 0;
							   ТекущаяЦепочка = ТекущаяЦепочка+1;
							   ВсегоОплат = 0;
							   СуммаКВ = 0;
							   СуммаПремии = 0;
							   
							   //Версия 2+
							   Если Месяц>=Дата(2019,5,1) Тогда
								   ТекущийИндекс = 1; //16 заявка становится первой в следующей цепочке
								   
								   //Расчет средних значений КВ и премий по заявке
								   найденныеОплаты = ВсеОплаты.НайтиСтроки(Новый Структура("Заявка",ВыборкаЗаявок.Заявка)); 
								   ОплатЗаявки = найденныеОплаты.Количество();
								   Если ВыборкаЗаявок.ДатаЗаявки>=Дата(2019,5,1)  и ОплатЗаявки>0 Тогда
									   СуммаКВЗаявки      = 0;
									   СуммаПремииЗаявки  =  0;
									   
									   Для каждого СтрокаОплаты из найденныеОплаты Цикл
										   СуммаКВЗаявки = СуммаКВЗаявки + СтрокаОплаты.КВПроцент;
										   СуммаПремииЗаявки = СуммаПремииЗаявки + СтрокаОплаты.НачисленнаяСуммаВзноса;
									   КонецЦикла;
									   СуммаПремии = СуммаПремии + СуммаПремииЗаявки/ОплатЗаявки;
									   СуммаКВ = СуммаКВ + СуммаКВЗаявки/ОплатЗаявки;
									   ВсегоОплат = ВсегоОплат+1;
								   КонецЕсли;
							   КонецЕсли; 
							   //Версия 2-
							   
							   Если ТекМенеджер.ВзаиморасчетыПрекращены = Истина Тогда
								   продолжить;
							   ИначеЕсли Подразделение<>Неопределено и Подразделение.НеИспользоватьПремированиеРекомендаций = Истина Тогда
								   Сумма = 0;
							   ИначеЕсли уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("БезРекомендаций",ТекМенеджер,ВыборкаЗаявок.Заявка.Дата,-1)>0 Тогда
								   Сумма = 0;
							   КонецЕсли; 
							   СинхронизироватьСумму(Месяц,ТекМенеджер,Текст,Сумма);
								   
							   
						   ИначеЕсли ПриведенныйТекущийИндекс>0 Тогда
							   найденныеОплаты = ВсеОплаты.НайтиСтроки(Новый Структура("Заявка",ВыборкаЗаявок.Заявка)); 
							   ОплатЗаявки = найденныеОплаты.Количество();
							   //Версия 2+
							   Если ВыборкаЗаявок.ДатаЗаявки>=Дата(2019,5,1)  и ОплатЗаявки>0 Тогда
								   СуммаКВЗаявки      = 0;
								   СуммаПремииЗаявки  =  0;
								   
								   Для каждого СтрокаОплаты из найденныеОплаты Цикл
									   СуммаКВЗаявки = СуммаКВЗаявки + СтрокаОплаты.КВПроцент;
									   СуммаПремииЗаявки = СуммаПремииЗаявки + СтрокаОплаты.НачисленнаяСуммаВзноса;
								   КонецЦикла;
								   СуммаПремии = СуммаПремии + СуммаПремииЗаявки/ОплатЗаявки;
								   СуммаКВ = СуммаКВ + СуммаКВЗаявки/ОплатЗаявки;
								   ВсегоОплат = ВсегоОплат+1;
							   //Версия 2-
							   Иначе	   
								   Для каждого СтрокаОплаты из найденныеОплаты Цикл
									   СуммаКВ = СуммаКВ + СтрокаОплаты.КВПроцент;
									   СуммаПремии = СуммаПремии + СтрокаОплаты.НачисленнаяСуммаВзноса;
									   ВсегоОплат = ВсегоОплат+1;
								   КонецЦикла; 
							   КонецЕсли;
						   КонецЕсли;	   
					   КонецЦикла;	
					   
				   КонецЦикла;	
				   
КонецФункции	
			   
Функция СинхронизироватьСумму(Месяц,Сотрудник,Текст,Сумма)
	
	Док = Документы.уб_НачислениеЗП.Выбрать(Месяц,Месяц);
	ЕстьПравки = ложь;
	Если Док.Следующий() ТОгда
		Об = Док.ПолучитьОбъект();
		Разовые = Об.НачисленияРазовые;
		нСтроки = Разовые.НайтиСтроки(Новый Структура("Сотрудник,Начисление",Сотрудник,Текст));
		Если Сумма = 0 Тогда
			Для каждого СтрокаН из нСтроки Цикл
				Если Не СтрокаН.Результат = 0 Тогда
					СтрокаН.Результат = 0;
					ЕстьПравки = Истина;
				КонецЕсли;
				
			КонецЦикла;	
		Иначе
			Если нСтроки.Количество() = 0 Тогда
				СтрокаН = Разовые.Добавить();
				СтрокаН.Сотрудник  = Сотрудник; 
				СтрокаН.Начисление = Текст;
				СтрокаН.Период = Месяц;
				ЕстьПравки = Истина;
			Иначе
				СтрокаН = нСтроки[0];
			КонецЕсли;
			Если Не СтрокаН.Результат = Сумма Тогда
				ЕстьПравки = Истина;
				СтрокаН.Результат = Сумма;
			КонецЕсли;	
			
		КонецЕсли;	
		Если ЕстьПравки = Истина Тогда
			Об.Записать();
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции	
			   
Процедура СинхронизироватьАгентаВПеремещениях()			   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер как Курьер,
	|	уб_ПеремещениеБСО.АгентКуда,
	|	уб_ПеремещениеБСО.Проведен,
	|	уб_ПеремещениеБСО.Ссылка КАК Перемещение
	|ИЗ
	|	Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	|		ПО уб_ПеремещениеБСО.СозданНаОсновании = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
	|			И уб_ПеремещениеБСО.АгентКуда <> уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер
	|			И (уб_ПеремещениеБСО.Проведен)
	|			И (уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= ДАТАВРЕМЯ(2018, 12, 1))
	|			И (уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд = ЛОЖЬ)";
	
	Выборка= Запрос.Выполнить().Выбрать();			   
	Пока Выборка.Следующий() Цикл
		об = Выборка.Перемещение.ПолучитьОбъект();
		об.АгентКуда = Выборка.Курьер;
		Попытка
			об.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры	


Процедура ОбработатьСтраховойПолисВДвижениях()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ДвиженияБСОСрезПоследних.СтраховойПолис,
	               |	уб_ДвиженияБСОСрезПоследних.ВидБСО,
	               |	уб_ДвиженияБСОСрезПоследних.НомерБСО,
	               |	уб_ДвиженияБСОСрезПоследних.НомерПолиса,
	               |	уб_СтраховойПолисБСО.Ссылка,
	               |	уб_СтраховойПолисБСО.Ссылка.ДатаДвиженияБСО КАК ДатаПолиса
	               |ПОМЕСТИТЬ БезПолиса
	               |ИЗ
	               |	РегистрСведений.уб_ДвиженияБСО.СрезПоследних КАК уб_ДвиженияБСОСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис.БСО КАК уб_СтраховойПолисБСО
	               |		ПО уб_ДвиженияБСОСрезПоследних.НомерБСО = уб_СтраховойПолисБСО.НомерБСО
	               |			И уб_ДвиженияБСОСрезПоследних.ВидБСО = уб_СтраховойПолисБСО.ВидБСО
	               |			И (уб_СтраховойПолисБСО.Ссылка.Дата > ДАТАВРЕМЯ(2023, 1, 1))
	               |			И (уб_СтраховойПолисБСО.Ссылка.Проведен)
	               |ГДЕ
	               |	уб_ДвиженияБСОСрезПоследних.СтраховойПолис = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ //ПЕРВЫЕ 100
	               |	Безполиса.СтраховойПолис,
	               |	Безполиса.ВидБСО,
	               |	Безполиса.НомерБСО,
	               |	Безполиса.НомерПолиса,
	               |	Безполиса.Ссылка,
	               |	Безполиса.ДатаПолиса,
	               |	уб_ДвиженияБСО.Регистратор, Представление(уб_ДвиженияБСО.Регистратор) как Регистратор2
	               |ИЗ
	               |	БезПолиса КАК Безполиса
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	               |		ПО (уб_ДвиженияБСО.Период > Безполиса.ДатаПолиса)
	               |			И (уб_ДвиженияБСО.НомерБСО = Безполиса.НомерБСО)
	               |			И (уб_ДвиженияБСО.ВидБСО = Безполиса.ВидБСО)
	               |			И (уб_ДвиженияБСО.Регистратор.Проведен)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Безполиса.ДатаПолиса,Безполиса.НомерБСО,уб_ДвиженияБСО.Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Регистратор.ПолучитьОбъект();
		Объект.ДополнительныеСвойства.Вставить("Допроведение",Истина);
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;	
		#Если Клиент Тогда
			Состояние(Выборка.Регистратор2);
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
	КонецЦикла;	
КонецПроцедуры	


