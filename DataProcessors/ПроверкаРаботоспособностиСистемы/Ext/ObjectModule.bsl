Процедура ПроверкаОплатПолисовБезИстории() Экспорт
	
	Если ПравоДоступа("Вывод", Метаданные) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		| Вложенный.Ссылка,
		| Вложенный.ДатаСоздания КАК ДатаСоздания
		|ИЗ
		| (ВЫБРАТЬ
		|  уб_ОплатаПолисов.Ссылка КАК Ссылка,
		|  уб_ИсторияОбъект.НомерВерсии КАК НомерВерсии,
		|  уб_ОплатаПолисов.МоментВремени КАК МоментВремени,
		|  уб_ОплатаПолисов.ДатаСоздания КАК ДатаСоздания
		| ИЗ
		|  Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияОбъект КАК уб_ИсторияОбъект
		|   ПО уб_ОплатаПолисов.Ссылка = уб_ИсторияОбъект.ОбъектИстории
		| ГДЕ
		|  уб_ИсторияОбъект.НомерВерсии ЕСТЬ NULL ) КАК Вложенный
		|
		|УПОРЯДОЧИТЬ ПО
		| ДатаСоздания");
		Результат = Запрос.Выполнить().Выгрузить();
		Если Результат.Количество() <> 0 Тогда
			Файл = Новый ТекстовыйДокумент;
			Для Каждого Строка Из Результат Цикл
				Файл.ДобавитьСтроку("<P>" + Строка.Ссылка + "</P>");
			КонецЦикла;
			Попытка
				ПутьФайла = КаталогВременныхФайлов() + "OP_errors.htm";
				Файл.Записать(ПутьФайла);
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось записать " + ПутьФайла,, Истина);
				Возврат;
			КонецПопытки;
			Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
			Параметры.Получатели	= ПараметрыСеанса.уб_Константы.АдресДоставкиЛога;
			Параметры.Тема			= "Не имеют истории документы ""ОплатаПолисов"" из файла во вложении";
			Параметры.Сообщение		= "<P> Всего <B>" + Результат.Количество() + "</B> оплат не имеют истории.</P>";
			Параметры.Вложения		= ПутьФайла;
			Попытка
				//уб_ОбменДанными.SendMail(ПараметрыСеанса.уб_Константы.АдресДоставкиЛога, "Не имеют истории документы ""ОплатаПолисов"" из файла во вложении","<P> Всего <B>"+Результат.Количество()+"</B> оплат не имеют истории.</P>",ПутьФайла);	
				уб_ОбменДанными.SendMail(Параметры);
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось отправить по почте " + ПутьФайла,, Истина);
			КонецПопытки;
			УдалитьФайлы(КаталогВременныхФайлов(), "OP_errors*.*");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьЛишниеВзаиморасчетыВСК() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка,
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Сумма,
	|	уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику
	|ИЗ
	|	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК уб_ВзаиморасчетСПоставщикомРаспределение
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|		ПО уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику = уб_ОплатаПолисов.ОтчетПоставщику
	|			И уб_ВзаиморасчетСПоставщикомРаспределение.Уточнение = уб_ОплатаПолисов.Ссылка
	|ГДЕ
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем)
	|	И (уб_ОплатаПолисов.Ссылка ЕСТЬ NULL 
	|			ИЛИ уб_ОплатаПолисов.ОтчетПоставщику.ОрганизацияАгент <> уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.ОрганизацияАгент
	|			ИЛИ уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику <> уб_ВзаиморасчетСПоставщикомРаспределение.Сумма)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка,
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Сумма,
	|	уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику
	|ИЗ
	|	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК уб_ВзаиморасчетСПоставщикомРаспределение
	|ГДЕ
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем)
	|	И уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	|	И уб_ВзаиморасчетСПоставщикомРаспределение.Сумма = уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.СуммаДокумента") ;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();	
		Объект.Удалить();
	КонецЦикла;
	
КонецПроцедуры	


Процедура ДобавитьОтсутствующиеОплатыВСК() Экспорт
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	Запрос = Новый Запрос;
	Если СистемаНаправлениеПлатежа Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.Ссылка КАК Оплата,
		|	уб_ОплатаПолисов.ОтчетПоставщику КАК ОтчетПоставщику
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	уб_ОплатаПолисов.НаправлениеПлатежа = ЗНАЧЕНИЕ(Перечисление.уб_НаправленияПлатежа.Поставщику)
		|	И НЕ уб_ОплатаПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
		|	И НЕ уб_ОплатаПолисов.ПометкаУдаления";
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.Ссылка КАК Оплата,
		|	уб_ОплатаПолисов.ОтчетПоставщику КАК ОтчетПоставщику
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	уб_ОплатаПолисов.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
		|	И НЕ уб_ОплатаПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
		|	И НЕ уб_ОплатаПолисов.ПометкаУдаления";
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаТЧ Из Таблица Цикл		
		СтрокаТЧ.УникальныйИдентификатор = Строка(СтрокаТЧ.Оплата.УникальныйИдентификатор());		
	КонецЦикла;
	ЗапросДокументов = Новый Запрос;
	ЗапросДокументов.Текст = "ВЫБРАТЬ
	|	Таблица.Оплата,
	|	Таблица.ОтчетПоставщику,
	|	Таблица.УникальныйИдентификатор
	|ПОМЕСТИТЬ ВТ_Оплаты
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Оплаты.Оплата,
	|	ВТ_Оплаты.ОтчетПоставщику КАК ОтчетПоставщику,
	|	ВТ_Оплаты.УникальныйИдентификатор,
	|	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка КАК СсылкаВзаиморасчет
	|ПОМЕСТИТЬ ВТ_ОплатыСВзаиморасчетом
	|ИЗ
	|	ВТ_Оплаты КАК ВТ_Оплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК уб_ВзаиморасчетСПоставщикомРаспределение
	|		ПО ((ВЫРАЗИТЬ(ВТ_Оплаты.УникальныйИдентификатор КАК СТРОКА(36))) = (ВЫРАЗИТЬ(уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.IDизБухДок КАК СТРОКА(36))))
	|			И ВТ_Оплаты.ОтчетПоставщику = уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику
	|           И ВТ_Оплаты.Оплата = уб_ВзаиморасчетСПоставщикомРаспределение.Уточнение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОплатыСВзаиморасчетом.Оплата,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.Валюта КАК ОплатаВалюта,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.Дата КАК ОплатаДата,	
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.ПлатежныйДокумент_Дата КАК ОплатаПлатежныйДокумент_Дата,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.ПлатежныйДокумент_Номер КАК ОплатаПлатежныйДокумент_Номер,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.Поставщик КАК ОплатаПоставщик,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику КАК ОплатаПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.ОрганизацияАгент КАК ОплатаОрганизацияАгент,
	|	ВТ_ОплатыСВзаиморасчетом.Оплата.ОтчетПоставщику.ОрганизацияАгент КАК ОтчетПоставщикуОрганизацияАгент,
	|	ВТ_ОплатыСВзаиморасчетом.ОтчетПоставщику,
	|	ВТ_ОплатыСВзаиморасчетом.УникальныйИдентификатор
	|ИЗ
	|	ВТ_ОплатыСВзаиморасчетом КАК ВТ_ОплатыСВзаиморасчетом
	|ГДЕ
	|	ВТ_ОплатыСВзаиморасчетом.СсылкаВзаиморасчет ЕСТЬ NULL ";
	ЗапросДокументов.УстановитьПараметр("Таблица", Таблица);			
	Выборка = ЗапросДокументов.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ОплатаПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику<=0 Тогда
			Продолжить;
		КонецЕсли;	
		Оплата = Выборка.Оплата;
		Док = Документы.уб_ВзаиморасчетСПоставщиком.СоздатьДокумент();
		Док.Дата 						= Выборка.ОплатаДата;
		Док.IDизБухДок 					= Выборка.УникальныйИдентификатор;
		Док.ВалютаДокумента 			= Выборка.ОплатаВалюта;
		Док.ДатаВходящегоДокумента  	= Выборка.ОплатаПлатежныйДокумент_Дата;
		Док.НомерВходящегоДокумента 	= Выборка.ОплатаПлатежныйДокумент_Номер;
		Док.ДокументИсточникОтсутствует = Истина;
		Док.ИсключитьИзВзаиморасчетов   = Ложь;
		Док.Категория     				= Перечисления.уб_КатегорияЗадолженности.ЕстьОтчетПоставщику;
		Док.Комментарий   				= "Создано автоматичеcки при привязке оплаты полиса к Отчету Поставщику";
		Док.Контрагент    				= Выборка.ОплатаПоставщик;
		Док.Поставщик     				= Выборка.ОплатаПоставщик;
		Док.НаправлениеРасчетов 		= Перечисления.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем;
		Док.НеИзменятьПриЗагрузке 		= Ложь;
		Док.СуммаДокумента 				= Выборка.ОплатаПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
		Док.ОрганизацияАгент 			= Выборка.ОтчетПоставщикуОрганизацияАгент;
		Док.Ответственный    			= ПараметрыСеанса.ТекущийПользователь;
		Док.ФормаОплаты      			= Перечисления.уб_ФормаОплатыВзаиморасчеты.Безналично;
		СтрокаРаспределения = Док.Распределение.Добавить();
		СтрокаРаспределения.ОтчетПоставщику = Выборка.ОтчетПоставщику;
		СтрокаРаспределения.Сумма 			= Док.СуммаДокумента;
		СтрокаРаспределения.Уточнение       =  Выборка.Оплата;
		Док.Записать(РежимЗаписиДокумента.Проведение);		
	КонецЦикла;	
	
КонецПроцедуры	

Функция ОбработатьОтчетСОплатойПоставщику(ТекОтчет) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка,
	               |	уб_ВзаиморасчетСПоставщикомРаспределение.Сумма,
	               |	уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику
	               |ИЗ
	               |	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК уб_ВзаиморасчетСПоставщикомРаспределение
	               |ГДЕ
	               |	уб_ВзаиморасчетСПоставщикомРаспределение.ОтчетПоставщику = &ОтчетПоставщику
	               |	И уб_ВзаиморасчетСПоставщикомРаспределение.Уточнение = ЗНАЧЕНИЕ(Документ.уб_ОплатаПолисов.ПустаяСсылка)
				   |    и уб_ВзаиморасчетСПоставщикомРаспределение.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем)";
				   Запрос.УстановитьПараметр("ОтчетПоставщику",ТекОтчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		 Объект = Выборка.Ссылка.ПолучитьОбъект();	
		 Объект.Удалить();
	 КонецЦикла;	
	 
	 Запрос.Текст = "ВЫБРАТЬ
	                |	уб_ОплатаПолисов.Ссылка КАК Оплата,
	                |	уб_ОплатаПолисов.ФормаОплаты,
	                |	уб_ОплатаПолисов.ОтчетПоставщику,
	                |	Распределение.Ссылка КАК Ссылка1,
	                |	уб_ОплатаПолисов.Дата,
	                |	уб_ОплатаПолисов.Валюта,
	                |	уб_ОплатаПолисов.ПлатежныйДокумент_Дата,
	                |	уб_ОплатаПолисов.ПлатежныйДокумент_Номер,
	                |	уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,
	                |	уб_ОплатаПолисов.ОтчетПоставщику.ОрганизацияАгент КАК ОтчетПоставщикуОрганизацияАгент,
	                |	уб_ОплатаПолисов.Поставщик
	                |ИЗ
	                |	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК Распределение
	                |		ПО (Распределение.ОтчетПоставщику = уб_ОплатаПолисов.ОтчетПоставщику)
	                |			И (Распределение.Уточнение = уб_ОплатаПолисов.Ссылка)
	                |ГДЕ
	                |	уб_ОплатаПолисов.ОтчетПоставщику = &ОтчетПоставщику
	                |	И НЕ уб_ОплатаПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
	                |	И уб_ОплатаПолисов.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
	                |	И Распределение.Ссылка ЕСТЬ NULL ";
	Выборка  = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Оплата = Выборка.Оплата;
		Док = Документы.уб_ВзаиморасчетСПоставщиком.СоздатьДокумент();
		Док.Дата 						= Выборка.Дата;
		Док.IDизБухДок 					= Выборка.Оплата.УникальныйИдентификатор();
		Док.ВалютаДокумента 			= Выборка.Валюта;
		Док.ДатаВходящегоДокумента  	= Выборка.ПлатежныйДокумент_Дата;
		Док.НомерВходящегоДокумента 	= Выборка.ПлатежныйДокумент_Номер;
		Док.ДокументИсточникОтсутствует = Истина;
		Док.ИсключитьИзВзаиморасчетов   = Ложь;
		Док.Категория     				= Перечисления.уб_КатегорияЗадолженности.ЕстьОтчетПоставщику;
		Док.Комментарий   				= "Создано автоматичеcки при привязке оплаты полиса к Отчету Поставщику";
		Док.Контрагент    				= Выборка.Поставщик;
		Док.Поставщик     				= Выборка.Поставщик;
		Док.НаправлениеРасчетов 		= Перечисления.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем;
		Док.НеИзменятьПриЗагрузке 		= Ложь;
		Док.СуммаДокумента 				= Выборка.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
		Док.ОрганизацияАгент 			= Выборка.ОтчетПоставщикуОрганизацияАгент;
		Док.Ответственный    			= ПараметрыСеанса.ТекущийПользователь;
		Док.ФормаОплаты      			= Перечисления.уб_ФормаОплатыВзаиморасчеты.Безналично;
		СтрокаРаспределения = Док.Распределение.Добавить();
		СтрокаРаспределения.ОтчетПоставщику = Выборка.ОтчетПоставщику;
		СтрокаРаспределения.Сумма 			= Док.СуммаДокумента;
		СтрокаРаспределения.Уточнение       =  Выборка.Оплата;
		Док.Записать(РежимЗаписиДокумента.Проведение);		
	КонецЦикла;	
КонецФункции	

Процедура ПроверкаОплатСПоступлениемПоКвитанцииПозжеДвижения(РежимТестирования=Неопределено)
	
	Запрос= Новый Запрос("ВЫБРАТЬ
	                     |	уб_ОплатаПолисов.НомерКвитанции,
	                     |	уб_ДвиженияБСО.Период,
	                     |	уб_ДвиженияБСО.Регистратор,
	                     |	уб_ОплатаПолисов.Ссылка КАК Оплата,
	                     |	Перемещения.Регистратор.Дата КАК Дата,
	                     |	РАЗНОСТЬДАТ(уб_ОплатаПолисов.Дата, Перемещения.Регистратор.Дата, ДЕНЬ) КАК Поле1
	                     |ИЗ
	                     |	РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	                     |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	                     |		ПО уб_ДвиженияБСО.НомерБСО = уб_ОплатаПолисов.НомерКвитанции
	                     |			И (уб_ДвиженияБСО.Активность)
	                     |			И (уб_ДвиженияБСО.Регистратор ССЫЛКА Документ.уб_ПоступлениеБСО)
	                     |			И уб_ДвиженияБСО.Период > уб_ОплатаПолисов.ДатаПроведенияБСО
	                     |			И (уб_ДвиженияБСО.КодОперации = ЗНАЧЕНИЕ(Перечисление.уб_КодыОперацийБСО.ОформлениеКвитанции))
	                     |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                     |			уб_ДвиженияБСО.НомерБСО КАК НомерБСО,
	                     |			МАКСИМУМ(уб_ДвиженияБСО.Регистратор) КАК Регистратор
	                     |		ИЗ
	                     |			РегистрСведений.уб_ДвиженияБСО КАК уб_ДвиженияБСО
	                     |		ГДЕ
	                     |			уб_ДвиженияБСО.КодОперации = ЗНАЧЕНИЕ(Перечисление.уб_КодыОперацийБСО.ОформлениеКвитанции)
	                     |			И уб_ДвиженияБСО.Активность
	                     |			И уб_ДвиженияБСО.Регистратор ССЫЛКА Документ.уб_ПеремещениеБСО
	                     |			И уб_ДвиженияБСО.ПоложениеБСО = ЗНАЧЕНИЕ(Перечисление.уб_ПоложенияБСО.ПереданНаТочку)
	                     |		
	                     |		СГРУППИРОВАТЬ ПО
	                     |			уб_ДвиженияБСО.НомерБСО,
	                     |			уб_ДвиженияБСО.Регистратор.МоментВремени) КАК Перемещения
	                     |		ПО уб_ДвиженияБСО.НомерБСО = Перемещения.НомерБСО
	                     |ГДЕ
	                     |	НЕ Перемещения.Регистратор ЕСТЬ NULL 
	                     |	И РАЗНОСТЬДАТ(уб_ОплатаПолисов.Дата, Перемещения.Регистратор.Дата, ДЕНЬ) < 10");
	
	выборка= Запрос.Выполнить().Выбрать();
	Если НЕ РежимТестирования =Неопределено Тогда
		//Режим Тестирования
		Результат = Выборка.Количество();
		Возврат;
	КонецЕсли;	
	Пока Выборка.Следующий() Цикл
		
		#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			Состояние(Выборка.Дата);
		#КонецЕсли
		
		об = Выборка.Оплата.ПолучитьОбъект();
		об.ДатаПроведенияБСО = Макс(Выборка.Дата,Выборка.Период)+1;
		//об.ОбменДанными.Загрузка = Истина;
		Попытка
			об.Записать();
			Об2  = об.СтраховойПолис.ПолучитьОбъект();
			Если Об.Проведен Тогда
				Если Об2.ОтключитьКонтрольНомеровБСО Тогда
					ОтключитьКонтрольНомеровБСО = ложь;
				КонецЕсли;	
				Об2.Записать (РежимЗаписиДокумента.Проведение);
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
	КонецЦикла;	
КонецПроцедуры



