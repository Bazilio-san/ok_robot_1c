//Вызывает принудительный перерасчет итогов отчета поставщику, в которых исключены все оплаты
Процедура ИсправитьИтогиОтчетовПоставщику() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Итоги.ОтчетПоставщику,
	               |	СУММА(Итоги.Задолженность - Итоги.ЗадолженностьПоКВ) КАК ФактЗадолженность,
	               |	СУММА(Итоги.Задолженность) КАК Задолженность,
	               |	СУММА(Итоги.ЗадолженностьПоКВ) КАК ЗадолженностьПоКВ,
	               |	СУММА(Итоги.Начислено) КАК Начислено,
	               |	СУММА(Итоги.НачисленоПоКВ) КАК НачисленоПоКВ,
	               |	СУММА(Итоги.НачисленоПоКВДляОтчета) КАК НачисленоПоКВДляОтчета,
	               |	СУММА(Итоги.Оплачено) КАК Оплачено,
	               |	СУММА(Итоги.ОплаченоКВ) КАК ОплаченоКВ,
	               |	СУММА(Итоги.ОплаченоФакт) КАК ОплаченоКлиентомФакт,
	               |	СУММА(Итоги.СкидкаКлиенту) КАК СкидкаКлиенту,
	               |	МАКСИМУМ(Итоги.Дата) КАК Дата,
	               |	МАКСИМУМ(Итоги.ОтчетПоставщику.Поставщик.АльтернативноеУдержаниеДопКВ) КАК АльтернативноеУдержаниеДопКВ,
	               |	СУММА(Итоги.Баланс_Брокер_Поставщик) КАК Баланс_Брокер_Поставщик,
	               |	СУММА(Итоги.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
	               |	СУММА(Итоги.КВСуммаДляОтчета) КАК КВСуммаДляОтчета,
	               |	СУММА(Итоги.КВСумма) КАК КВСумма,
	               |	МАКСИМУМ(Итоги.ОтчетПоставщикуДата) КАК ОтчетПоставщикуДата,
	               |	МАКСИМУМ(Итоги.ОтчетПоставщикуНомер) КАК ОтчетПоставщикуНомер,
	               |	ЕСТЬNULL(Итоги.ОтчетПоставщику.НомерОтчетаПоставщику, """") КАК НомерОтчетаПоставщику,
	               |	ЕСТЬNULL(Итоги.ОтчетПоставщику.ВидВзаиморасчета, """") КАК ВидВзаиморасчета
	               |ПОМЕСТИТЬ ВТ_СостояниеПромежуточная
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ОплатыПолисов.ОтчетПоставщику КАК ОтчетПоставщику,
	               |		ВЫРАЗИТЬ(СУММА(ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику - ВЫБОР
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ИСТИНА
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ЛОЖЬ
	               |						ТОГДА 0
	               |					КОГДА ОплатыПолисов.ОтчетПоставщику.ВидВзаиморасчета = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.СудержаниемКВ)
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					ИНАЧЕ 0
	               |				КОНЕЦ) КАК ЧИСЛО(15, 2)) КАК Задолженность,
	               |		СУММА(ОплатыПолисов.ОплаченоФакт) КАК ОплаченоФакт,
	               |		СУММА(ОплатыПолисов.АВилиСкидкаСумма) КАК СкидкаКлиенту,
	               |		ВЫРАЗИТЬ(СУММА(ОплатыПолисов.КВСумма - ВЫБОР
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ИСТИНА
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ЛОЖЬ
	               |						ТОГДА 0
	               |					КОГДА ОплатыПолисов.ОтчетПоставщику.ВидВзаиморасчета = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.СудержаниемКВ)
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					ИНАЧЕ 0
	               |				КОНЕЦ) КАК ЧИСЛО(15, 2)) КАК ЗадолженностьПоКВ,
	               |		ВЫРАЗИТЬ(СУММА(ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику - ВЫБОР
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ИСТИНА
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ЛОЖЬ
	               |						ТОГДА 0
	               |					КОГДА ОплатыПолисов.ОтчетПоставщику.ВидВзаиморасчета = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.СудержаниемКВ)
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					ИНАЧЕ 0
	               |				КОНЕЦ) КАК ЧИСЛО(15, 2)) КАК Начислено,
	               |		ВЫРАЗИТЬ(СУММА(ОплатыПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику) КАК ЧИСЛО(15, 2)) КАК НачисленнаяСуммаВзноса,
	               |		ВЫРАЗИТЬ(СУММА(ОплатыПолисов.КВСумма - ВЫБОР
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ИСТИНА
	               |						ТОГДА ОплатыПолисов.КВСумма
	               |					КОГДА &ВидВзаиморасчетовСУдержаниемКВ = ЛОЖЬ
	               |						ТОГДА 0
	               |					КОГДА ОплатыПолисов.ОтчетПоставщику.ВидВзаиморасчета = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.СУдержаниемКВ)
