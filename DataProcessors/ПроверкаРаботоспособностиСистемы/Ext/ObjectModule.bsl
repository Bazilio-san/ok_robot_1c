// установка паролей для всех пользователей, имеющий аутентификацию 1с
Процедура ПроверкаАутентификацииПользователей() Экспорт

	Пароль = "4568";
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Пользователь.АутентификацияСтандартная И Не Пользователь.ПарольУстановлен Тогда
			Пользователь.Пароль = Пароль;
			Пользователь.Записать();
		КонецЕсли;
	КонецЦикла;

