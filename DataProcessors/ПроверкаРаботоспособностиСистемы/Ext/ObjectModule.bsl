Процедура Оплаты_Поставщику_С_НулевойСуммой()
	
	СистемаНаправлениеПлатежа = ПараметрыСеанса.уб_Константы.СистемаНаправлениеПлатежаВОплатеПолиса = Истина;
	Запрос = Новый Запрос;
	Если СистемаНаправлениеПлатежа Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.Ссылка,
		|	уб_ОплатаПолисов.ОтчетПоставщику,
		|	уб_ОплатаПолисов.НачисленнаяСуммаВзноса,
		|	уб_ОплатаПолисов.НеВключатьВОтчетыПоставщикам,
		|	уб_ОплатаПолисов.ОплаченоФакт,
		|	уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,
		|	уб_ОплатаПолисов.СкидкаВыплаченаяКлиенту,
		|	уб_ОплатаПолисов.СуммаКОплатеБрокеруДляОчетаПоставщику
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	НЕ уб_ОплатаПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
		|	И НЕ уб_ОплатаПолисов.ОтчетПоставщику.ВидВзаиморасчета.Код ЕСТЬ NULL 
		|	И уб_ОплатаПолисов.ОплаченоФакт = 0
		|	И уб_ОплатаПолисов.НаправлениеПлатежа = ЗНАЧЕНИЕ(Перечисление.уб_НаправленияПлатежа.Поставщику)
		|	И уб_ОплатаПолисов.НачисленнаяСуммаВзноса <> уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	уб_ОплатаПолисов.Ссылка,
		|	уб_ОплатаПолисов.ОтчетПоставщику,
		|	уб_ОплатаПолисов.НачисленнаяСуммаВзноса,
		|	уб_ОплатаПолисов.НеВключатьВОтчетыПоставщикам,
		|	уб_ОплатаПолисов.ОплаченоФакт,
		|	уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,
		|	уб_ОплатаПолисов.СкидкаВыплаченаяКлиенту,
		|	уб_ОплатаПолисов.СуммаКОплатеБрокеруДляОчетаПоставщику
		|ИЗ
		|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		|ГДЕ
		|	НЕ уб_ОплатаПолисов.ОтчетПоставщику = ЗНАЧЕНИЕ(Документ.уб_ОтчетПоставщику.ПустаяСсылка)
		|	И НЕ уб_ОплатаПолисов.ОтчетПоставщику.ВидВзаиморасчета.Код ЕСТЬ NULL 
		|	И уб_ОплатаПолисов.ОплаченоФакт = 0
		|	И уб_ОплатаПолисов.ФормаОплаты = Значение(Перечисление.уб_ФормыОплаты.Поставщику)
		|	И уб_ОплатаПолисов.НачисленнаяСуммаВзноса<>уб_ОплатаПолисов.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику";
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = Объект.НачисленнаяСуммаВзноса;
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;	
	
КонецПроцедуры

