Процедура ПроверкаНаличияПеремещений() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Различные
	               |	уб_ПеремещениеБСО.Ссылка КАК Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка КАК Ссылка1,
	               |	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус КАК Статус//,
	               //|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.НомерБСО КАК НомерБСО
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
	               |		ПО (уб_ПеремещениеБСО.СозданНаОсновании = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
	               |		ПО (уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка)
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Дата > &Дата
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.НомерБСО <> """"
	               |	И уб_ПеремещениеБСО.Ссылка ЕСТЬ NULL
	               |	И НЕ уб_ИсторияСтатусовЗаявокСрезПоследних.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_статусыЗаявок.ЗапросНаУдаление), ЗНАЧЕНИЕ(Перечисление.уб_статусыЗаявок.СогласованиеСКлиентом))
				   |    И не Isnull(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка.Курьер.Код,""!23у23434"") в(""000000000"",""000081966"",""000081967"",""000081969"",""000081970"")";
	Запрос.УстановитьПараметр("Дата",ТекущаяДата()-90*3600*24);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			уб_УСЗ.ПроверитьПеремещения(Выборка.Ссылка1,Выборка.Статус,Истина);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры	


Процедура ПроставитьБонусыРекомендаций() Экспорт
	Запрос  = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	оплатыполисов.Ссылка КАК Ссылка,
	               	|	СУММА(ВЫБОР
	               	|			КОГДА ЕСТЬNULL(влож.Результат, 0) > 0 и (оплатыполисов.ВидС В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтрахования.КАСКО), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтрахования.ОСАГО)))
	               	|				ТОГДА ЕСТЬNULL(влож.Результат, 0)
	               	|			ИНАЧЕ 0
	               	|		КОНЕЦ) КАК Результат
	               	|ПОМЕСТИТЬ данные
	               	|ИЗ
	               	|	Документ.уб_ОплатаПолисов КАК оплатыполисов
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               	|			уб_НачислениеЗПНачисленияПоДокументам.Начисление КАК Начисление,
	               	|			СУММА(уб_НачислениеЗПНачисленияПоДокументам.Результат) КАК Результат,
	               	|			уб_НачислениеЗПНачисленияПоДокументам.Документ КАК Документ
	               	|		ИЗ
	               	|			Документ.уб_НачислениеЗП.НачисленияПоДокументам КАК уб_НачислениеЗПНачисленияПоДокументам
	               	|		ГДЕ
	               	|			уб_НачислениеЗПНачисленияПоДокументам.Начисление = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознЗаРекомендацию)
	               	|		
	               	|		СГРУППИРОВАТЬ ПО
	               	|			уб_НачислениеЗПНачисленияПоДокументам.Начисление,
	               	|			уб_НачислениеЗПНачисленияПоДокументам.Документ) КАК влож
	               	|		ПО оплатыполисов.СтраховойПолис.Заявка = влож.Документ
	               	
	               	|ГДЕ
	               	|	оплатыполисов.НомерВзноса = 1
	               	|
	               	|СГРУППИРОВАТЬ ПО
	               	|	оплатыполисов.Ссылка
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
	               	|	данные.Результат КАК Результат,
	               	|	данные.Ссылка.ЗаРекомендацию КАК ЗаРекомендацию,
	               	|	данные.Ссылка КАК Ссылка
	               	|ИЗ
	               	|	данные КАК данные
	               	|ГДЕ
	               	|	данные.Ссылка.ЗаРекомендацию <> данные.Результат
	               	|	И данные.Ссылка.НомерВзноса = 1";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект                             = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка       = Истина;
		Объект.НачисленБонусЗаРекомендацию = Выборка.Результат>0;
		Объект.ЗаРекомендацию              = Выборка.Результат;
		Объект.Записать();
		
	КонецЦикла;	
				   
КонецПроцедуры	




Процедура ПроставитьБонусыКоробок() Экспорт
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	АналитикаУчетаБСО.ВидСП КАК ВидСП,
	               |	АналитикаУчетаБСО.ОрганизацияАгент КАК ОрганизацияАгент,
	               |	АналитикаУчетаБСО.СК КАК СК
	               |ПОМЕСТИТЬ Аналитика
	               |ИЗ
	               |	Справочник.АналитикаУчетаБСО КАК АналитикаУчетаБСО
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	уб_НачислениеЗПНачисленияПоДокументам.Начисление КАК Начисление,
	               |	СУММА(уб_НачислениеЗПНачисленияПоДокументам.Результат) КАК Результат,
	               |	уб_НачислениеЗПНачисленияПоДокументам.Документ КАК Документ
	               |ПОМЕСТИТЬ Начисления
	               |ИЗ
	               |	Документ.уб_НачислениеЗП.НачисленияПоДокументам КАК уб_НачислениеЗПНачисленияПоДокументам
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(уб_НачислениеЗПНачисленияПоДокументам.Начисление) = ТИП(СТРОКА)
	               |	И (уб_НачислениеЗПНачисленияПоДокументам.Начисление ПОДОБНО ""Клуб%""
	               |			ИЛИ уб_НачислениеЗПНачисленияПоДокументам.Начисление ПОДОБНО ""Коробка%"")
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	уб_НачислениеЗПНачисленияПоДокументам.Начисление,
	               |	уб_НачислениеЗПНачисленияПоДокументам.Документ
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(уб_НачислениеЗПНачисленияПоДокументам.Результат) <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА ОП.КВПроцентДляАгента >= 29
	               |				ТОГДА начисления.Результат
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Результат,
	               |	ОП.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Данные
	               |ИЗ
	               |	Начисления КАК начисления
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ОплатаПолисов КАК ОП
	               |		ПО (ОП.СтраховойПолис.Заявка = начисления.Документ)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Аналитика КАК Аналитика
	               |		ПО (ОП.ВидСП = Аналитика.ВидСП)
	               |			И (ОП.ОрганизацияАгент = Аналитика.ОрганизацияАгент)
	               |			И (ОП.СК = Аналитика.СК)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОП.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	данные.Результат КАК Результат,
	               |	данные.Ссылка.ЗаКоробку КАК СсылкаЗаКоробку,
	               |	данные.Ссылка КАК Ссылка
	               |ИЗ
	               |	Данные КАК данные
	               |ГДЕ
	               |	данные.Ссылка.ЗаКоробку <> данные.Результат
	               |	И данные.Ссылка.НомерВзноса = 1";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект                        = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка  = Истина;
		Объект.НачисленБонусЗаКоробку = Выборка.Результат<>0;
		Объект.ЗаКоробку              = Выборка.Результат;
		Объект.Записать();
	КонецЦикла;	
				   
КонецПроцедуры	

Процедура СинхронизироватьЕстьЧек() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.СсылкаСправочника КАК СсылкаСправочника,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.УидСтроки КАК УидСтроки,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.ДатаПубликации КАК ДатаПубликации,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Размещен КАК Размещен,
	               |	уб_ФайлыКПолисам.ФайлИмя КАК ФайлИмя,
	               |	уб_ФайлыКПолисам.Размещен КАК Размещен1,
	               |	уб_ФайлыКПолисам.ВидДокумента КАК ВидДокумента,
	               |	уб_ФайлыКПолисам.Хранилище КАК Хранилище,
	               |	уб_ФайлыКПолисам.Архив КАК Архив,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка КАК Ссылка,
	               |	уб_ФайлыКПолисам.Страхователь КАК Страхователь
	               |ПОМЕСТИТЬ Чеки
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.СписокФайлов КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	               |		ПО уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.СсылкаСправочника = уб_ФайлыКПолисам.УИД
	               |			И (уб_ФайлыКПолисам.ВидДокумента.Код = 74)
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаСписокФайлов.Ссылка.Дата >= ДАТАВРЕМЯ(2022, 1, 1)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	БСО.Ссылка КАК Ссылка,
	               |	БСО.УидСтроки КАК УидСтроки,
	               |	ВЫБОР
	               |		КОГДА Чеки.Ссылка ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК естьчек
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК БСО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Чеки КАК Чеки
	               |		ПО БСО.Ссылка = Чеки.Ссылка
	               |			И БСО.УидСтроки = Чеки.УидСтроки
	               |ГДЕ
	               |	БСО.Ссылка.Дата >= ДАТАВРЕМЯ(2022, 1, 1)
	               |	И БСО.ЕстьЧек <> ВЫБОР
	               |			КОГДА Чеки.Ссылка ЕСТЬ NULL
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	Выборка = Запрос.Выполнить().Выбрать();
	Всего = Выборка.Количество();
	Сообщить("Для обработки 'Естьчек' "+ Всего);
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик+1;
		ОбъектЗаявка = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗаявка.ОбменДанными.Загрузка = Истина;
		#Если Клиент Тогда
			Состояние("Обработка 'Естьчек': "+Окр(Счетчик*100/Всего,2));
		#КонецЕсли
		
		нСтроки = ОбъектЗаявка.БСО.НайтиСтроки(Новый Структура("УидСтроки",Выборка.УидСтроки));
		Для каждого Строка из нСтроки Цикл
			Строка.ЕстьЧек = Выборка.ЕстьЧек;
		КонецЦикла;	
		ОбъектЗаявка.Записать();
	КонецЦикла;	
КонецПроцедуры	
