	Запись.Иконка 		= Форма.ИконкаКанала;
	Запись.Общий		= Форма.Общий;
	
	Набор.Записать();
	
КонецПроцедуры //ЗаписатьДанныеКанала()

Процедура ПометитьСообщениеКакПрочтенное(Форма) Экспорт
	
	Если Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
	Набор.Отбор.ИДСообщения.Установить(Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные.ИДСообщения);
	Набор.Отбор.Пользователь.Установить(ПараметрыСеанса.ТекущийПользователь);
	Набор.Отбор.Период.Установить(КонецДня(ТекущаяДата()));
	Если Форма.Заголовок = "Сообщение" Тогда
		Набор.Отбор.Отправитель.Установить(Форма.ЭлементыФормы.ПанельКорреспондентов.ТекущаяСтраница.Значение);	
	КонецЕсли;
	Набор.Записать();
	Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные.ИДСообщения = Неопределено;
	
	// одновременно удалим сообщения старше одного дня
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	чат_НепрочитанныеСообщения.ИДСообщения,
	|	чат_НепрочитанныеСообщения.Пользователь,
	|	чат_НепрочитанныеСообщения.Период
	|ИЗ
	|	РегистрСведений.уб_Чат_НепрочитанныеСообщения КАК чат_НепрочитанныеСообщения
	|ГДЕ
	|	чат_НепрочитанныеСообщения.Период < &Период";
	Запрос.УстановитьПараметр("Период",НачалоДня(ТекущаяДата()));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
		Набор.Отбор.ИДСообщения.Установить(Выборка.ИДСообщения);
		Набор.Отбор.Пользователь.Установить(Выборка.Пользователь);
		Набор.Отбор.Период.Установить(Выборка.Период);
		Набор.Записать();
	КонецЦикла;
	
КонецПроцедуры //ПометитьСообщениеКакПрочтенное()

Процедура ДобавитьВложенияПодбором(ИмяГруппыМетаданных,ФормаРодитель) Экспорт
	
		СписокМетаданных = Новый СписокЗначений;
		Если ИмяГруппыМетаданных = "Документы" Тогда
			Картинка = БиблиотекаКартинок.ДокументОбъект;
			Заголовок = "Выберите вид документов";
		ИначеЕсли ИмяГруппыМетаданных = "Справочники" Тогда
			Картинка = БиблиотекаКартинок.СправочникОбъект;
			Заголовок = "Выберите вид справочников";
		КонецЕсли;
		
		Для каждого Элемент ИЗ Метаданные[ИмяГруппыМетаданных] Цикл
			
			СписокМетаданных.Добавить(Элемент.Имя, Элемент.Синоним,, Картинка);			
			
		КонецЦикла;
		
		ВыбранныйТип = СписокМетаданных.ВыбратьЭлемент(Заголовок);
		
		Если ВыбранныйТип <> Неопределено Тогда
			Форма = Неопределено;
			СтрокаКоманды = "Форма = " + ИмяГруппыМетаданных + "." + ВыбранныйТип.Значение + ".ПолучитьФормуВыбора(,мФорма)";
			Выполнить(СтрокаКоманды);
			
			Результат = Форма.ОткрытьМодально();
			Если Результат <> Неопределено Тогда
				
				НСтрока = ФормаРодитель.ТабличноеПолеВложений.Добавить();
				НСтрока.Ссылка 		= Результат;
				НСтрока.ТипСсылки 	= ИмяГруппыМетаданных + "." + ВыбранныйТип;
				
			КонецЕсли;
		КонецЕсли;
	
КонецПроцедуры //ДобавитьВложенияПодбором()

Процедура ОткрытьСписокВложений(Форма) Экспорт
	
	Если Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные.ПредставлениеВложений) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	Объект = Форма.ЭлементыФормы.ПолеСообщений.ТекущиеДанные.ПредставлениеВложений.ВыбратьЭлемент();
	Если Объект <> Неопределено Тогда
		ФормаОбъекта = Объект.Значение.ПолучитьФорму();
		ФормаОбъекта.Открыть();
	КонецЕсли;
	
КонецПроцедуры //ОткрытьСписокВложений()

Процедура ОбновитьПредставлениеСмайла(Форма) Экспорт
	
	Попытка
		Форма.ЭлементыФормы.КоманднаяПанельПоляСообщения.Кнопки.Смайлы.Картинка = БиблиотекаКартинок[мСмайл];
	Исключение
		         // ошибка
	КонецПопытки;
	
КонецПроцедуры //ОбновитьПредставлениеСмайла()

