КонецПроцедуры //ОткрытьПрофильПользователя()

Процедура ЗаполнитьПараметрыПользователя(Форма) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	чат_НастройкиПользователей.Настройка,
	|	чат_НастройкиПользователей.Значение,
	|	чат_НастройкиПользователей.Хранилище
	|ИЗ
	|	РегистрСведений.уб_Чат_НастройкиПользователей КАК чат_НастройкиПользователей
	|ГДЕ
	|	чат_НастройкиПользователей.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь",Форма.Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Настройка = ПланыВидовХарактеристик.чат_НастройкиПользователей.Фотография Тогда
			Попытка
				Форма.ЭлементыФормы.ПолеКартинки.Картинка = Выборка.Хранилище.Получить();
			Исключение
				// не картинка
			КонецПопытки;
		Иначе
			Попытка
				Форма.ЭлементыФормы[СтрЗаменить(Строка(Выборка.Настройка)," ","")].Значение = Выборка.Значение;
			Исключение
				// ошибка
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьПараметрыПользователя()

Процедура СохранитьПараметрыПользователя(Форма) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	чат_НастройкиПользователей.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.чат_НастройкиПользователей КАК чат_НастройкиПользователей
	|ГДЕ
	|	чат_НастройкиПользователей.Предопределенный
	|	И (НЕ чат_НастройкиПользователей.ЭтоГруппа)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Хранилище = Неопределено;
		Если Выборка.Ссылка = ПланыВидовХарактеристик.чат_НастройкиПользователей.Фотография Тогда
			Хранилище = Новый ХранилищеЗначения(Форма.ЭлементыФормы.ПолеКартинки.Картинка);
			Значение = "Картинка";
		ИначеЕсли Выборка.Ссылка = ПланыВидовХарактеристик.чат_НастройкиПользователей.Пол Тогда
			
		Иначе
			Попытка
				Значение = Форма.ЭлементыФормы[СтрЗаменить(Строка(Выборка.Ссылка)," ","")].Значение;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Набор = РегистрыСведений.уб_Чат_НастройкиПользователей.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Форма.Пользователь);
		Набор.Отбор.Настройка.Установить(Выборка.Ссылка);
		
		Запись = Набор.Добавить();
		Запись.Пользователь = Форма.Пользователь;
		Запись.Настройка 	= Выборка.Ссылка;
		Запись.Значение 	= Значение;
		Запись.Хранилище	= Хранилище;
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры //СохранитьПараметрыПользователя()

Процедура ОтправитьСообщение(Получатель = Неопределено,Форма = Неопределено) Экспорт
	
	Если Форма = Неопределено Тогда // отправка в канал (не личное)
		Форма = мФорма;
	КонецЕсли;
	
	Текст = Форма.ЭлементыФормы.ПолеСообщения.ПолучитьТекст();
	
	Если Получатель = Неопределено Тогда // отправка в канал (не личное)
		ИмяКанала = Форма.ЭлементыФормы.ПанельПереключенияКаналов.ТекущаяСтраница.Заголовок;
	КонецЕсли;
	
	ИдСообщения = Новый УникальныйИдентификатор();
	мДата = ТекущаяДата();
	
	//вложения
	Значение = ЗначениеВСтрокуВнутр(Форма.ТабличноеПолеВложений);
	Хранилище = Новый ХранилищеЗначения(Значение);
	
	Набор = РегистрыСведений.уб_Чат_Сообщения.СоздатьНаборЗаписей();
	Набор.Отбор.ИмяКанала.Установить(ИмяКанала);
	Набор.Отбор.ИдСообщения.Установить(ИдСообщения);
	Набор.Отбор.Период.Установить(мДата);
	Набор.Отбор.Получатель.Установить(Получатель);
	Набор.Отбор.Отправитель.Установить(ПараметрыСеанса.ТекущийПользователь);
	
	Запись = Набор.Добавить();
	Запись.ИмяКанала 	= ИмяКанала;
	Запись.ИдСообщения 	= ИдСообщения;
	Запись.Период 		= мДата;
	Запись.Отправитель 	= ПараметрыСеанса.ТекущийПользователь;
	Запись.Сообщение 	= Текст;
	Запись.Вложения		= Хранилище;
	Запись.ИмяИконки	= мСмайл;
	Запись.Получатель	= Получатель;
	Запись.ЕстьВложения = Форма.ТабличноеПолеВложений.Количество() <> 0;
	
	Набор.Записать();
	
	// пометка о прочтении для пользователей
	
	Если Получатель = Неопределено Тогда // отправка в канал (не личное)
		Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			ПользовательИБ = Справочники.Пользователи.НайтиПоКоду(Пользователь.Имя);
			Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
			Набор.Отбор.ИДСообщения.Установить(ИдСообщения);
			Набор.Отбор.Пользователь.Установить(ПользовательИБ);
			Набор.Отбор.Период.Установить(КонецДня(ТекущаяДата()));
			Запись = Набор.Добавить();
			Запись.ИДСообщения = ИДСообщения;
			Запись.Пользователь = ПользовательИБ;
			Запись.Период = КонецДня(ТекущаяДата());
			Набор.Записать();
		КонецЦикла;
		ЗаполнитьСписокСообщений(Форма.ЭлементыФормы.ПанельПереключенияКаналов.ТекущаяСтраница.Заголовок);
		Форма.ЭлементыФормы.ПолеСообщения.УстановитьТекст("");
		Форма.ТабличноеПолеВложений.Очистить();
	Иначе
		// уведомление о личном сообщении
		Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
		Набор.Отбор.ИДСообщения.Установить(ИдСообщения);
		Набор.Отбор.Пользователь.Установить(Получатель);
		Набор.Отбор.Отправитель.Установить(ПараметрыСеанса.ТекущийПользователь);
		Набор.Отбор.Период.Установить(КонецДня(ТекущаяДата()));
		
		Запись = Набор.Добавить();
		Запись.ИДСообщения 	= ИДСообщения;
		Запись.Пользователь = Получатель;
		Запись.Отправитель 	= ПараметрыСеанса.ТекущийПользователь;
		Запись.Период 		= КонецДня(ТекущаяДата());
		
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры //ОтправитьСообщение()

Процедура ОтправитьЛичноеСообщение() Экспорт
	
	СписокПолучателей = Новый СписокЗначений;
	Для Каждого Строка Из мФорма.ЭлементыФормы.Пользователи.ВыделенныеСтроки Цикл
		СписокПолучателей.Добавить(Строка.Имя);	
	КонецЦикла;
	Форма = ПолучитьФорму("ФормаСообщения",мФорма);
	Форма.Получатели = СписокПолучателей;
	Форма.ОткрытьМодально();
	
КонецПроцедуры //ОтправитьЛичноеСообщение()

Процедура ОтправитьСообщенияПолучателям(ФормаСообщения) Экспорт
	
	Для Каждого Получатель Из ФормаСообщения.Получатели Цикл
		ОтправитьСообщение(Получатель.Значение,ФормаСообщения);	
	КонецЦикла;
	ФормаСообщения.ЭлементыФормы.ПолеСообщения.УстановитьТекст("");
	ФормаСообщения.ТабличноеПолеВложений.Очистить();
	мСмайл = Неопределено;
	ОбновитьПредставлениеСмайла(ФормаСообщения)
	
КонецПроцедуры //ОтправитьСообщенияПолучателям()

Процедура ЗаполнитьПанельИконок(Форма) Экспорт
	#Если Клиент Тогда
	ВсеКартинки = Метаданные.ОбщиеКартинки;
	мРазмерСмайлов = 34;
	ВозможноеКоличествоПоГоризонтали = Цел(Форма.ЭлементыФормы.ПанельИконок.Ширина / мРазмерСмайлов);
	СЧ = 0;
	ТекущийВерх = 0;
	Для Каждого Картинка Из ВсеКартинки Цикл
		Если Форма.Режим = "Смайлы" И Найти("0123456789",Сред(Картинка.Имя,5,1)) = 0 Тогда 
			Продолжить;
		КонецЕсли;
		Если СЧ = ВозможноеКоличествоПоГоризонтали Тогда
			СЧ = 0;
			ТекущийВерх = ТекущийВерх + мРазмерСмайлов;
		КонецЕсли;
		Кнопка = Форма.ЭлементыФормы.Добавить(Тип("Кнопка"),Картинка.Имя,,Форма.ЭлементыФормы.ПанельИконок);
		Кнопка.Высота 			= мРазмерСмайлов;
		Кнопка.Ширина 			= мРазмерСмайлов;
		Кнопка.Лево 			= СЧ * мРазмерСмайлов;
		Кнопка.Верх 			= ТекущийВерх;
		Картинка = БиблиотекаКартинок[Картинка.Имя];
		Кнопка.Картинка 		= Картинка;
		Кнопка.Рамка 			= Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
		Кнопка.ЦветФонаКнопки 	= ЦветаСтиля.ЦветФонаФормы;
		
		Действие = Новый Действие("ОбработкаНажатияКнопки");
		Кнопка.УстановитьДействие("Нажатие",Действие);
		
		СЧ = СЧ + 1;
	КонецЦикла;
	#КонецЕсли 
КонецПроцедуры //ЗаполнитьПанельИконок()


Процедура ЗаписатьДанныеКанала(Форма) Экспорт
	
	Набор = РегистрыСведений.уб_Чат_Каналы.СоздатьНаборЗаписей();
