
Перем мФорма Экспорт;
Перем мКаталогСмайлов;
Перем мСмайл Экспорт;

Перем мПутьКИсполняемымФайлам;

Перем мИмяФайла;
Перем СписокПользователей Экспорт;
Перем ОтображениеТолькоАктивных Экспорт;

// Процедура производит создание рабочего каталога и копирование в него исплолняемых файлов
//
Процедура ЗарегистрироватьAutoItX() Экспорт
	Попытка
		Если НЕ ПроверитьФайл(КаталогВременныхФайлов() + "\AutoIt") Тогда
			СоздатьКаталог(КаталогВременныхФайлов() + "AutoIt");
			ДвоичныеДанные = ПолучитьМакет("AutoIt");
			ИмяФайла = КаталогВременныхФайлов() + "AutoIt\AutoIt.exe";
			ДвоичныеДанные.Записать(ИмяФайла);
		КонецЕсли;
	Исключение
		Сообщить("Неудачная попытка регистрации AutoItX3.dll:
		|" + ОписаниеОшибки(),СтатусСообщения.Важное);
	КонецПопытки;
КонецПроцедуры //ЗарегистрироватьAutoItX()

Функция ПроверитьФайл(ИмяФайла) Экспорт
	КаталогНаДиске = Новый Файл(ИмяФайла);
	Возврат КаталогНаДиске.Существует();
КонецФункции

// Процедура подготавливает скрипт
//
//  Параметры:
//   1. ИмяСкрипта - Строка - имя скрипта
//
Процедура ПодготовитьСкрипт(ИмяСкрипта)
	Макет = ПолучитьМакет("СкриптыAutoIt");
	ТекстСкрипта = Макет.Области[ИмяСкрипта].Текст;
	ИмяФайла = КаталогВременныхФайлов() + "AutoIt\_Script.au3";	
	Файл = Новый ЗаписьТекста(ИмяФайла,КодировкаТекста.Системная);
	Файл.Записать(ТекстСкрипта);
	Файл.Закрыть();
КонецПроцедуры //ПодготовитьСкрипт

// Процедура выводит сообщение в трей
//
//  Параметры:
//   1. ТекстПодсказки - Строка - текст выводимого сообщения
//   2. ТекстЗаголовка - Строка - заголовок выводимого сообщения
//   3. Опция - Число - обозначае тип иконки сообщения (0 - без иконки,1 - информация, 2 - предупреждение, 3 - ошибка)
//   4. ВремяПоказа - Число - время показа выводимого сообщения в мс.
//
Процедура ВывестиПодсказкуВТрей(ТекстПодсказки = "",ТекстЗаголовка = "",Опция = 1,ВремяПоказа = 5000) Экспорт
	ПодготовитьСкрипт("СкриптПодсказкиВТрее");
	СтрокаКоманды = """" + мПутьКИсполняемымФайлам + """ """
	+ мИмяФайла + """ """ + ТекстПодсказки + """"
	+ " """ + ТекстЗаголовка + """"
	+ " " + Опция + " " + СтрЗаменить(Строка(ВремяПоказа),Символы.НПП,"");
	// выполнение скрипта
	ЗапуститьПриложение(СтрокаКоманды);
Конецпроцедуры //ВывестиПодсказкуВТрей()

Процедура ДействияПриОткрытии() Экспорт
	
	ЗаполнитьСписокПользователей(мФорма.Пользователи);
	ОбновитьСписокКаналов();
	УправлениеВидимостьюЭлементовФормы();
	ЗарегистрироватьAutoItX();
	ЗаполнитьНастройкиПользователя();
	
	мФорма.Заголовок = "Чат (пользователь):" + ПараметрыСеанса.ТекущийПользователь;
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиПользователя()
	
	Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
		
		Результат = уб_Чат_Общий.ПолучитьНастройкуПользователя(Реквизит.Имя);
		
		Если Результат <> Неопределено Тогда
			ЭтотОбъект[Реквизит.Имя] = Результат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьНастройкиПользователя()

Процедура чат_СохранитьНастройкиПользователя(ИмяРеквизита) Экспорт
	
	Попытка
	
		Настройка = ПланыВидовХарактеристик.чат_НастройкиПользователей[ИмяРеквизита];
		Набор = РегистрыСведений.уб_Чат_НастройкиПользователей.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(ПараметрыСеанса.ТекущийПользователь);
		Набор.Отбор.Настройка.Установить(Настройка);
		
		Запись = Набор.Добавить();
		Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		Запись.Настройка = Настройка;
		Запись.Значение = ЭтотОбъект[ИмяРеквизита];
		
		Набор.Записать();
		
	Исключение
		// неверное имя реквизита или настройки
	КонецПопытки;
	
	
КонецПроцедуры //чат_СохранитьНастройкиПользователя()

Процедура ЗаполнитьСписокПользователей(ТаблицаПользователей) Экспорт
	
	ТаблицаПользователей.Очистить();
	Соединения = ПолучитьСоединенияИнформационнойБазы();
	Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	мФорма.ЭлементыФормы.НадписьУведомления.Значение 		= "нет новых сообщений...";
	мФорма.ЭлементыФормы.НадписьУведомления.ЦветТекстаПоля	= Новый Цвет(137,132,119);
	мФорма.ЭлементыФормы.НадписьСсылка.Заголовок 			= "";
	мФорма.ЭлементыФормы.ПолеКартинкиУведомления.Картинка 	= БиблиотекаКартинок.чат_Уведомления_офф;
	мФорма.ПользовательУведомлений							= Справочники.Пользователи.ПустаяСсылка();
			
	Для Каждого Пользователь Из Пользователи Цикл
		Если Пользователь.ПоказыватьВСпискеВыбора Или Пользователь.АутентификацияОС Тогда
			НСтрока = ТаблицаПользователей.Добавить();
			СпрПользователь = СписокПользователей[Пользователь.Имя];
			Если СпрПользователь = Неопределено  Тогда
				СпрПользователь = Справочники.Пользователи.НайтиПоКоду(Пользователь.Имя);
				Если СпрПользователь.Пустая() Тогда
				Иначе
					СписокПользователей.Вставить(Пользователь.Имя,СпрПользователь.Ссылка);
				КонецЕсли;	
			КонецЕсли;	
			НСтрока.Имя = СпрПользователь;
			НСтрока.Пол = ОпределитьПол(Пользователь.Имя);
			НСтрока.Активен = Ложь;
			Для Каждого Соединение Из Соединения Цикл
				ПользовательСоединения = Соединение.Пользователь;
				Если ПользовательСоединения <> Неопределено И ПользовательСоединения.Имя = Пользователь.Имя Тогда
					НСтрока.Активен = Истина;
				КонецЕсли;
			КонецЦикла;
			
			НСтрока.ЕстьНепрочитанные = ОпределитьНаличиеНепрочитанныхЛичныхСообщений(СпрПользователь);
			Если ОтображениеТолькоАктивных Тогда
				Если НСтрока.ЕстьНепрочитанные ИЛИ НСтрока.Активен Тогда
				Иначе
					ТаблицаПользователей.Удалить(НСтрока);
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			
			Если НСтрока.ЕстьНепрочитанные Тогда
				ТекстСообщения = ПолучитьТекстПоследнегоЛичногоСообщения(СпрПользователь,ПараметрыСеанса.ТекущийПользователь);
				Если мФорма.ПоказыватьВсплывающиеПодсказки Тогда
					ВывестиПодсказкуВТрей(ТекстСообщения,"Сообщение от " + Пользователь.Имя);
				КонецЕсли;
				
				// информация в панели уведомлений
				мФорма.ЭлементыФормы.НадписьУведомления.Значение 		= "Получено сообщение от пользователя: " + Пользователь.Имя;
				мФорма.ЭлементыФормы.НадписьУведомления.ЦветТекстаПоля	= Новый Цвет(153,51,0);
				мФорма.ЭлементыФормы.НадписьСсылка.Заголовок 			= ТекстСообщения;
				мФорма.ЭлементыФормы.ПолеКартинкиУведомления.Картинка 	= БиблиотекаКартинок.чат_Уведомления_он;
				мФорма.ПользовательУведомлений							= СпрПользователь;
			Иначе
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//Отсортируем по алфАвиту
	ТаблицаПользователей.Сортировать("Имя");
	
КонецПроцедуры //ЗаполнитьСписокПользователей()

Функция ПолучитьТекстПоследнегоЛичногоСообщения(Отправитель,Получатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	чат_Сообщения.Сообщение,
	|	чат_Сообщения.Период КАК Дата
	|ИЗ
	|	РегистрСведений.уб_Чат_Сообщения КАК чат_Сообщения
	|ГДЕ
	|	чат_Сообщения.Отправитель = &Отправитель
	|	И чат_Сообщения.Получатель = &Получатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Отправитель",Отправитель);
	Запрос.УстановитьПараметр("Получатель",Получатель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сообщение;
	КонецЕсли;
	Возврат "";
	
КонецФункции //ПолучитьТекстПоследнегоЛичногоСообщения()

Процедура ПоказатьЛичнуюПереписку(Пользователь = Неопределено) Экспорт
	
	Форма = ПолучитьФорму("ФормаСообщения",мФорма);
	Форма.Получатели.Добавить(?(Пользователь = Неопределено,мФорма.ЭлементыФормы.Пользователи.ТекущиеДанные.Имя,Пользователь));
	Форма.РежимПереписки = Истина;
	Форма.ОткрытьМодально();
	
КонецПроцедуры //ПоказатьЛичнуюПереписку()

Процедура ЗаполнитьПереписку(Форма) Экспорт
	
	ЗаполнитьСписокСообщений(,ПараметрыСеанса.ТекущийПользователь, Форма.ЭлементыФормы.ПанельКорреспондентов.ТекущаяСтраница.Значение,Форма);	
	
КонецПроцедуры //ЗаполнитьПереписку()

Процедура ОбновитьКаналыПереписки(Форма) Экспорт
	
	Для Каждого Корреспондент Из Форма.Получатели Цикл
		Форма.ЭлементыФормы.ПанельКорреспондентов.Страницы.Добавить(Корреспондент.Значение.Код,Корреспондент.Значение,Корреспондент.Значение,БиблиотекаКартинок.чат_Канал);
	КонецЦикла;
	Форма.ЭлементыФормы.ПанельКорреспондентов.Страницы.Удалить(0);
	
КонецПроцедуры //ОбновитьКаналыПереписки()

Функция ОпределитьНаличиеНепрочитанныхЛичныхСообщений(Отправитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	чат_НепрочитанныеСообщения.ИДСообщения
	|ИЗ
	|	РегистрСведений.уб_Чат_НепрочитанныеСообщения КАК чат_НепрочитанныеСообщения
	|ГДЕ
	|	чат_НепрочитанныеСообщения.Пользователь = &Пользователь
	|	И чат_НепрочитанныеСообщения.Отправитель = &Отправитель";
	Запрос.УстановитьПараметр("Отправитель",Отправитель);
	Запрос.УстановитьПараметр("Пользователь",ПараметрыСеанса.ТекущийПользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции //ОпределитьНаличиеНепрочитанныхЛичныхСообщений()

Процедура ВыполнитьДействияПоРасписанию() Экспорт
	//Сохраним пользователя
	ТекущиеДанные = мФорма.ЭлементыФормы.Пользователи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекПользователь ="Не найден пользователь";		
	Иначе
		ТекПользователь = ТекущиеДанные.Имя;
	КонецЕсли;	
	ЗаполнитьСписокПользователей(мФорма.Пользователи);
	ЗаполнитьСписокСообщений(мФорма.ЭлементыФормы.ПанельПереключенияКаналов.ТекущаяСтраница.Заголовок);
	
	//Восстановим активную строку
	СтрокаСПользователем = мФорма.Пользователи.Найти(ТекПользователь,"Имя");
	Если СтрокаСПользователем = Неопределено Тогда
	Иначе
		мФорма.ЭлементыФормы.Пользователи.ТекущаяСтрока = СтрокаСПользователем;
	КонецЕсли;
	
КонецПроцедуры //ВыполнитьДействияПоРасписанию()

Функция ОпределитьПол(Имя)
	
	Попытка
		СпрПользователь = СписокПользователей[Имя];
			Если СпрПользователь = Неопределено  Тогда
				СпрПользователь = Справочники.Пользователи.НайтиПоКоду(Имя);
				Если СпрПользователь.Пустая() Тогда
				Иначе
					СписокПользователей.Вставить(Имя,СпрПользователь.Ссылка);
				КонецЕсли;	
			КонецЕсли;	
		//Если Пользователь <> Неопределено Тогда
		//	Если ЗначениеЗаполнено(Пользователь.ФизЛицо) И ЗначениеЗаполнено(Пользователь.ФизЛицо.Пол) Тогда
				Возврат НРег(Лев(Строка(СпрПользователь.ФизЛицо.Пол),1));
		//	Иначе
		//		Возврат "н";	
		//	КонецЕсли;
		//Иначе
		//	Возврат "н";
		//КонецЕсли;
	Исключение
		Возврат "н";
	КонецПопытки;
	
КонецФункции //ОпределитьПол()

Процедура ОбновитьСписокКаналов() Экспорт
	
	Для Каждого Страница Из мФорма.ЭлементыФормы.ПанельПереключенияКаналов.Страницы Цикл
		мФорма.ЭлементыФормы.ПанельПереключенияКаналов.Страницы.Удалить(Страница);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(чат_Каналы.Иконка) КАК Иконка,
	|	МАКСИМУМ(чат_Каналы.Общий) КАК Общий,
	|	чат_Каналы.ИмяКанала
	|ИЗ
	|	РегистрСведений.уб_Чат_Каналы КАК чат_Каналы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_Чат_ДоступККаналам КАК чат_ДоступККаналам
	|		ПО (чат_ДоступККаналам.ИмяКанала = чат_Каналы.ИмяКанала)
	|ГДЕ
	|	(чат_ДоступККаналам.УровеньДоступа >= &УровеньДоступа
	|				И чат_ДоступККаналам.Пользователь = &Пользователь
	|			ИЛИ чат_Каналы.Общий)
	|
	|СГРУППИРОВАТЬ ПО
	|	чат_Каналы.ИмяКанала";
	
	Запрос.УстановитьПараметр("Пользователь"	,ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("УровеньДоступа"	,1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ИмяКанала) Тогда
			Попытка
				Картинка = БиблиотекаКартинок[Выборка.Иконка];
			Исключение
				// нет такой картинки
			КонецПопытки;
			Страница = мФорма.ЭлементыФормы.ПанельПереключенияКаналов.Страницы.Добавить(,Выборка.ИмяКанала,,Картинка);
		КонецЕсли;
	КонецЦикла;
	
	мФорма.ЭлементыФормы.ПанельПереключенияКаналов.Страницы.Удалить(0);
	
КонецПроцедуры //ОбновитьСписокКаналов()

Процедура УправлениеВидимостьюЭлементовФормы()
	
	#Если Клиент Тогда
	ЕстьПравоАдмина = ПользовательАдминистратор();
	мФорма.ЭлементыФормы.ОсновнаяПанель.Страницы.Администрирование.Видимость = ЕстьПравоАдмина; 
	мФорма.ЭлементыФормы.ОсновнаяПанель.ОтображениеЗакладок = ?(ЕстьПравоАдмина,ОтображениеЗакладок.Сверху,ОтображениеЗакладок.НеИспользовать);
	#КонецЕсли
КонецПроцедуры //УправлениеВидимостьюЭлементовФормы()

Процедура ДействияПриСменеСтраницыКаналов() Экспорт
	
	Попытка
		ЗаполнитьСписокСообщений(мФорма.ЭлементыФормы.ПанельПереключенияКаналов.ТекущаяСтраница.Заголовок);
	Исключение
	КонецПопытки;
	
КонецПроцедуры //ДействияПриСменеСтраницыКаналов()

Функция ПользовательАдминистратор()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	чат_ДоступККаналам.ИмяКанала
	|ИЗ
	|	РегистрСведений.уб_Чат_ДоступККаналам КАК чат_ДоступККаналам
	|ГДЕ
	|	чат_ДоступККаналам.Пользователь = &Пользователь
	|	И чат_ДоступККаналам.УровеньДоступа = &УровеньДоступа";
	
	Запрос.УстановитьПараметр("Пользователь"	,ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("УровеньДоступа"	,10);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции //ПользовательАдминистратор()

Процедура ЗаполнитьСписокСообщений(Канал = "",Получатель = Неопределено, Отправитель = Неопределено,Форма = Неопределено)
	
	Если Форма = Неопределено Тогда
		Форма = мФорма;
	КонецЕсли;
	
	//&&&+
	// оптимизировать этот кусок!!!!
	Если Получатель = Неопределено Тогда
		СписокПолучателей = Справочники.Пользователи.ПустаяСсылка();
	Иначе
		СписокПолучателей = Новый СписокЗначений;
		СписокПолучателей.Добавить(Получатель);
		СписокПолучателей.Добавить(Отправитель);
	КонецЕсли;
	
	Если Отправитель = Неопределено Тогда
		СписокОтправителей = Справочники.Пользователи.ПустаяСсылка();
	Иначе
		СписокОтправителей = Новый СписокЗначений;
		СписокОтправителей.Добавить(Получатель);
		СписокОтправителей.Добавить(Отправитель);
	КонецЕсли;
	//&&&+
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	чат_Сообщения.Период КАК Дата,
	|	чат_Сообщения.Сообщение,
	|	чат_Сообщения.Отправитель,
	|	чат_Сообщения.ИмяИконки,
	|	чат_НепрочитанныеСообщения.ИДСообщения,
	|	чат_Сообщения.Вложения,
	|	чат_Сообщения.ЕстьВложения
	|ИЗ
	|	РегистрСведений.уб_Чат_Сообщения КАК чат_Сообщения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_Чат_НепрочитанныеСообщения КАК чат_НепрочитанныеСообщения
	|		ПО чат_Сообщения.ИДСообщения = чат_НепрочитанныеСообщения.ИДСообщения
	|			И (чат_НепрочитанныеСообщения.Пользователь = &Пользователь)
	|ГДЕ
	|	чат_Сообщения.ИмяКанала = &ИмяКанала
	|	И чат_Сообщения.Получатель В(&Получатели)
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборПоОтправителю
	|				ТОГДА чат_Сообщения.Отправитель В (&Отправители)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И чат_Сообщения.Период МЕЖДУ &НачПериода И &КонПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ИмяКанала",Канал);
	Запрос.УстановитьПараметр("Получатели"				,СписокПолучателей);
	Запрос.УстановитьПараметр("Отправители"				,СписокОтправителей);
	Запрос.УстановитьПараметр("ЕстьОтборПоОтправителю"	,ЗначениеЗаполнено(Отправитель));
	Запрос.УстановитьПараметр("НачПериода"				,НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонПериода"				,КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Пользователь"			,ПараметрыСеанса.ТекущийПользователь);
	
	Форма.ЭлементыФормы.ПолеСообщений.Значение.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НСтрока = Форма.ЭлементыФормы.ПолеСообщений.Значение.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрока,Выборка);
		Если Выборка.ЕстьВложения Тогда
			НСтрока.ПредставлениеВложений = ПолучитьПредставлениеВложений(ЗначениеИзСтрокиВнутр(Выборка.Вложения.Получить()));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьСписокСообщений()

Функция ПолучитьПредставлениеВложений(ТЗВложений)
	
	СписокВозврата = Новый СписокЗначений;
	
	Для Каждого СтрокаВложения Из ТЗВложений Цикл
		СписокВозврата.Добавить(СтрокаВложения.Ссылка);
	КонецЦикла;
	
	Возврат СписокВозврата;
	
КонецФункции //ПолучитьПредставлениеВложений()

Функция ПолучитьКартинкуИконки(ИмяИконки) Экспорт
	
	Попытка
		Картинка = БиблиотекаКартинок[ИмяИконки];
	Исключение
		// нет такой картинки в библиотеке
		Попытка
			Картинка = Новый Картинка(мКаталогСмайлов + "\" + ИмяИконки + ".gif",Истина);
		Исключение
			// нигде нет такой картинки
			Картинка = БиблиотекаКартинок.чат_КартинкаНеопределено;
		КонецПопытки;
	КонецПопытки;
	
	Возврат Картинка;
	
КонецФункции //ПолучитьКартинкуИконки()

