//RDP-


//RDP+
//Альтернативный сериализатор ссылочных объектов, для последующей упаковки ЗначениеВСтрокуВнутр/JSON и т.п.
//Для идентичных или схожих объектов

Функция ЗначениеСтруктурой(Значение,КэшЗначения,Перезаписать = ЛОЖЬ,МаксУровень = 10,Уровень=0,ЭтоОтладка = ЛОЖЬ,ВставитьКэш = ЛОЖЬ,СчетчикКэша = 0) Экспорт
	ТекУровень = 1+Уровень;
	Если КэшЗначения = Неопределено Тогда
		КэшЗначения = Новый Соответствие;
	КонецЕсли;	
	ПромКэш = КэшЗначения.Получить(Значение);
	Если ПромКэш = Неопределено Тогда
		типЗнч = ТипЗнч(Значение);
		Если ТипЗнч = Тип("Дата") тогда
			Возврат XMLСтрока(Значение);
		ИначеЕсли ТипЗнч = Тип("Строка") 
			или ТипЗнч = Тип("Дата")
			ИЛИ ТипЗнч = Тип("Число")
			ИЛИ ТипЗнч = Тип("Булево")
			ИЛИ ТипЗнч = Тип("Неопределено")
			Тогда
			Возврат Значение
		Иначе
			Попытка 
				Мета = Значение.Метаданные();
				ЕстьМета = Истина;
			Исключение
				ЕстьМета = Ложь;
			КонецПопытки;	
			Если естьМета Тогда
				кэш = КэшЗначения.Получить(Мета);
				Если Кэш = Неопределено Тогда
					Если НЕ Метаданные.Справочники.Найти(Мета.Имя) = Неопределено Тогда
						//Это справочник
						Кэш = ПолучитьСтруктуруРеквизитов(Мета,"Справочники");
						КэшЗначения.Вставить(Мета,Кэш);
					ИначеЕсли НЕ Метаданные.Документы.Найти(Мета.Имя) = Неопределено Тогда 	
						//Это документ
						Кэш = ПолучитьСтруктуруРеквизитов(Мета,"Документы");
						Кэш.Добавить("Дата","Дата");
						Кэш.Добавить("Проведен","Проведен");
						Кэш.Добавить("Номер","Номер");
						КэшЗначения.Вставить(Мета,Кэш);
						//ИначеЕсли НЕ Метаданные.Документы.Найти(Мета.Имя) = Неопределено Тогда 	
						//	//Это документ
						//	Кэш = ПолучитьСтруктуруРеквизитов(Мета);
						//	КэшЗначения.Вставить(Мета,Кэш);
					ИначеЕсли НЕ Метаданные.Перечисления.Найти(Мета.Имя) = Неопределено Тогда 	
						//
						Если ЗначениеЗаполнено(Значение) Тогда
							ИндексЗначенияПеречисления = Перечисления[Мета.Имя].Индекс(Значение);
							Кэш = "_Перечисления."+Мета.Имя+"."+Метаданные.Перечисления[Мета.Имя].ЗначенияПеречисления[Перечисления[Мета.Имя].Индекс(Значение)].Имя;
							//КэшЗначения.Вставить(Мета,Кэш);
						Иначе
							Кэш = Неопределено;
						КонецЕсли;	
						Возврат Кэш;
					ИначеЕсли НЕ Метаданные.ПланыВидовРасчета.Найти(Мета.Имя) = Неопределено Тогда 	
						//Это документ
						Кэш = ПолучитьСтруктуруРеквизитов(Мета,"ПланыВидовРасчета");
						КэшЗначения.Вставить(Мета,Кэш);
					ИначеЕсли НЕ Метаданные.ПланыВидовХарактеристик.Найти(Мета.Имя) = Неопределено Тогда 	
						//Это документ
						Кэш = ПолучитьСтруктуруРеквизитов(Мета,"ПланыВидовХарактеристик");
						КэшЗначения.Вставить(Мета,Кэш);	
						//ИначеЕсли НЕ Метаданные.Документы.Найти(Мета.Имя) = Неопределено Тогда 	
						//	//Это документ
						//	Кэш = ПолучитьСтруктуруРеквизитов(Мета);
						//	КэшЗначения.Вставить(Мета,Кэш);	
					ИначеЕсли НЕ Метаданные.ПланыСчетов.Найти(Мета.Имя) = Неопределено Тогда 	
						Кэш = ПолучитьСтруктуруРеквизитов(Мета,"ПланыСчетов");
						КэшЗначения.Вставить(Мета,Кэш);	
					Иначе
						СтрокаОшибки = "--- НЕИЗВЕСТНО -- "+ Мета;
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = СтрокаОшибки;
						Сообщение.Сообщить();
						//Сообщить ("-"+ Мета);
						Возврат Новый Структура
					КонецЕсли;	
				Иначе
				КонецЕсли;	
				Если Не Кэш = Неопределено Тогда
					СтруктураЗначения   = Новый Структура;
					Если Перезаписать = ИСТИНА ТОГДА
						СтруктураЗначения.Вставить("_Перезаписать_",Перезаписать);
					КонецЕсли;	
					
					Если ЭтоОтладка = Истина Тогда
						Сообщить(Лев(">>>>>>>>>>>>>>>>>",ТекУровень)+Значение);
					КонецЕсли;	
					
					Для каждого ЭлСтруктуры из кэш Цикл
						ИмяКлюча = ЭлСтруктуры.Значение;
						Если Лев(ИмяКлюча,1) = "_" и Прав(ИмяКлюча,1) = "_" Тогда
							СтруктураЗначения.Вставить(ИмяКлюча,ЭлСтруктуры.Представление);
							Если ИмяКлюча = "_Коллекция_" Тогда
								СтруктураЗначения.Вставить("_УникальныйИдентификатор_",""+значение.УникальныйИдентификатор());								
								Если ЭлСтруктуры.Представление = "Справочники" Тогда
									СтруктураЗначения.Вставить("_ЭтоГруппа_",значение.ЭтоГруппа);								
								ИначеЕсли ЭлСтруктуры.Представление = "Документы" Тогда
									СтруктураЗначения.Вставить("_Проводить_",ФлПроводить);								
								КонецЕсли;
								//Для исключения возможного зацикливания сразу включаем объект в кэш, в нем будут только ключевые реквизиты
								//КэшЗначения.Вставить(Значение, СтруктураЗначения);
								УидКэша = СтруктураЗначения._Имя_+"_"+СтрЗаменить(СтруктураЗначения._УникальныйИдентификатор_,"-","_");
								СчетчикКэша = СчетчикКэша+1;
								КэшЗначения.Вставить(Значение, Новый Структура("УИД,Значение,Счетчик",УидКэша,СтруктураЗначения,СчетчикКэша));
							КонецЕсли;
							ИмяТЧ = Сред(ИмяКлюча,2,СтрДлина(ИмяКлюча)-2);
							СсылкаТЧ = значение.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ);
							Если НЕ СсылкаТЧ = Неопределено Тогда
								РеквизитыТЧ = РазложитьСтрокуВМассивПодстрок(ЭлСтруктуры.Представление,";");
								Массив = Новый Массив;
								Для каждого СтрокаТЧ из  Значение[ИмяТЧ] Цикл
									СтруктураСтрокиТЧ = Новый Структура;
									Для каждого РеквизитТЧ из  РеквизитыТЧ Цикл
										ТекИмяРеквизитаТЧ = СокрЛП(РеквизитТЧ);
										ЗначениеРеквизитаТЧ = СтрокаТЧ[ТекИмяРеквизитаТЧ];
										ТипЗнчРеквизитаТЧ =  ТипЗнч(ЗначениеРеквизитаТЧ); 
										Если ТипЗнчРеквизитаТЧ = Тип("Дата") Тогда
											СтруктураСтрокиТЧ.Вставить(ТекИмяРеквизитаТЧ, XmlСтрока(ЗначениеРеквизитаТЧ));
										ИначеЕсли ТипЗнчРеквизитаТЧ = Тип("Строка") 
											или ТипЗнчРеквизитаТЧ = Тип("Дата")
											ИЛИ ТипЗнчРеквизитаТЧ = Тип("Число")
											ИЛИ ТипЗнчРеквизитаТЧ = Тип("Булево") тогда
											СтруктураСтрокиТЧ.Вставить(ТекИмяРеквизитаТЧ, ЗначениеРеквизитаТЧ);
										Иначе
