//Отправить через сервис массив данных типа соответствие {УИД, Ссылка}
Процедура ОтправитьМассив(Узел,МассивОтправки) Экспорт
	
	МассивОбъектов = Новый Массив;
	КэшЗначения = Новый Соответствие;
	
	СчетчикКэша = 0;
	//СчетчикДокументов = 0;
	
	Организации = Неопределено;
	Попытка
		ДатаНачалаОбмена = Узел.ДатаНачалаОбмена;
	Исключение
		ДатаНачалаОбмена = Узел.ДатаНачалаВыгрузкиДокументов;
	КонецПопытки;	
	Объекты = Неопределено;
			
	Для каждого _ОбъектСтруктуры из МассивОтправки Цикл
		_Объект = _ОбъектСтруктуры.Значение;
		Если ТипЗнч(_Объект) = ТИп("УдалениеОбъекта") Тогда
			МассивОбъектов.Добавить(Новый Структура("_Имя_,Метаданные,УникальныйИдентификатор","_УдалениеОбъекта_",_Объект.Ссылка.Метаданные().Имя,Строка(_Объект.Ссылка.УникальныйИдентификатор())));
		Иначе	
			Если ВыгружатьОбъект(_Объект.Ссылка,Организации,ДатаНачалаОбмена,Объекты) = Истина Тогда
				
				Попытка
					Владелец =_Объект.Ссылка.Владелец;
					ЕстьВладелец = Истина;
				Исключение
					ЕстьВладелец = Ложь;
				КонецПопытки;
				
				Если ЕстьВладелец и ВыгружатьОбъект(Владелец,Организации,ДатаНачалаОбмена,Объекты) = Ложь Тогда
					Сообщить("Пропущен "+_Объект.Ссылка+" по владельцу "+Владелец);
					Продолжить;
				КонецЕсли;	
				
				ТекОбъект = ЗначениеСтруктурой(_Объект.Ссылка,КэшЗначения,ИСТИНА,,,,ЛОЖЬ,СчетчикКэша);
			Иначе
				Сообщить("Пропущен "+_Объект.Ссылка);
			КонецЕсли;	
			МассивОбъектов.Добавить(ТекОбъект);
		КонецЕсли;		
	КонецЦикла;			
	МассивОбъектов.Вставить(0,СтруктураКэша(КэшЗначения));
	Строкаjson = ЗаписьJSON(МассивОбъектов);
	
	
	СтруктураНастроек = РегистрыСведений.НастройкиТранспортаОбмена.НастройкиТранспортаWS(Узел);
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("URL",      СтруктураНастроек.WSURLВебСервиса);
	ПараметрыПодключения.Вставить("UserName", СтруктураНастроек.WSИмяПользователя);
	ПараметрыПодключения.Вставить("Password", СтруктураНастроек.WSПароль);
	
	//Возврат;
	ПараметрыАдреса = ИзвлечьАдрес(СтруктураНастроек.WSURLВебСервиса);
	Адрес        = ПараметрыАдреса.Адрес;//"192.168.1.25";
	Ресурс       = "/"+ПараметрыАдреса.ИмяБазы+"/hs/api/post";
	Порт         =ПараметрыАдреса.Порт;
	Пользователь = СтруктураНастроек.WSИмяПользователя;//"Администратор";
	Пароль       = СтруктураНастроек.WSПароль;//"rarus";
	РазмерПорции = 10;
	Защищенное   = Ложь;
	
	ПараметрыСоединения = Новый Структура;
	//Ответ = СоединениеДок(Выборка.Запрос); 
	Ответ = _Соединение(Адрес,
	Порт,
	Ресурс,
	Пользователь,
	Пароль,
	Защищенное,
	Строкаjson);
	Сообщить(Ответ);
	Если Не ПустаяСтрока(Ответ.Ответ) Тогда
		Сообщить(Ответ.Ответ);
	КонецЕсли;	
	Если Ответ.Свойство("Обработанные") Тогда
		
		Для каждого _Объект из Ответ.Обработанные Цикл
			
			ЗначениеОтмены = МассивОтправки.Получить(Новый УникальныйИдентификатор(_Объект));
			Если Не ЗначениеОтмены = Неопределено Тогда
				//
				ПланыОбмена.УдалитьРегистрациюИзменений(Узел,ЗначениеОтмены);
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	
КонецПроцедуры	

//Функция проверки трубетуся ли выгружать объекты исходя из настроек в узле
Функция ВыгружатьОбъект(_Объект,Организации = Неопределено,ДатаНачалаОбмена = Неопределено,Объекты = Неопределено) Экспорт
	//АДАПТАЦИЯ+++
	Если ТипЗнч(Узел) = Тип("Строка") Тогда
		Возврат Истина
	КонецЕсли;	
	//АДАПТАЦИЯ---
		
	Если Организации = Неопределено Тогда
		Организации=Узел.Организации.Выгрузить().ВыгрузитьКолонку("Организация")
	КонецЕсли;	
	
	Если Объекты = Неопределено Тогда
		Попытка
			ЕстьОбъекты = Истина;
			_Объекты=Узел.Объекты.Выгрузить();
			Объекты  = Новый Массив;
			Для каждого _ВидыОбъектов из _Объекты Цикл
				Если _ВидыОбъектов.Регистрация = Истина Тогда
					Объекты.Добавить(_ВидыОбъектов.Вид);
				КонецЕсли;	
			КонецЦикла;	
		Исключение
			ЕстьОбъекты = Ложь;
		КонецПопытки
	КонецЕсли;	

	
	Если ДатаНачалаОбмена = Неопределено Тогда
		ДатаНачалаОбмена = Узел.ДатаНачалаОбмена;
	КонецЕсли;	

	//Индивидуальная проверка
	Если ИсключитьОбъект(_Объект) = Истина Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	//универсальные проверки
	Попытка
		Если Организации.Найти(_Объект.Организация) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Объекты.Найти(ПолучитьВид(_Объект.Метаданные()))= Неопределено и ЕстьОбъекты = Истина Тогда
			Возврат Ложь; 
		КонецЕсли;
		Если _Объект.Дата<ДатаНачалаОбмена и _Объект.Дата<>Дата(1,1,1) Тогда
			Возврат Ложь;
		КонецЕсли;	
		Возврат Истина;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции		

Функция ИзвлечьАдрес (Строка)
	_Строка =""+Строка;
	
	_Адрес = "";
	//https://web.skype.com/
	Поз1 = Найти(_Строка,"//");
	Если Поз1>0 Тогда
		_Строка = Сред(_Строка,Поз1+2);
	КонецЕсли;	
	Поз1 = Найти(_Строка,":");//СтрНайти(Строка,":",НаправлениеПоиска.СНачала,Поз1+2);
	
	Если Поз1 = 0 Тогда 
		//сразу имя базы
		Поз2 = Найти(_Строка,"/");
		_Адрес = лев(_Строка,Поз2-1);
		_Порт  = 80;
	Иначе
		_Адрес = лев(_Строка,Поз1-1);
		_Строка = Сред(_Строка,Поз1+1);
		Поз2 = Найти(_Строка,"/");
		_Порт = Лев(_Строка,Поз2-1);
	КонецЕсли;
	
	_ИмяБазы = Сред(_Строка,Поз2+1);
	
	Если Прав(_ИмяБазы,1) ="/" Тогда
		_ИмяБазы = Лев(_ИмяБазы,СтрДлина(_ИмяБазы)-1);
		
	КонецЕсли;	
	
	Возврат Новый Структура("Адрес,ИмяБазы,Порт",_Адрес,_ИмяБазы,_Порт)
	
	
	
КонецФункции	

//Вспомогательная функция представления вида по метаданным
Функция ПолучитьВид(ТекущиеМетаданные)
	
	Имя = ТекущиеМетаданные.Имя;
	Префикс = "";
	Если Метаданные.Справочники.Содержит(ТекущиеМетаданные) Тогда
		Префикс = "Справочник.";
	ИначеЕсли Метаданные.Документы.Содержит(ТекущиеМетаданные) Тогда
		Префикс = "Документ.";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ТекущиеМетаданные) Тогда
		Префикс = "Регистр сведений.";
	КонецЕсли;
	СтрокаВида = Префикс+Имя;
	
	Возврат СтрокаВида;
	
КонецФункции	