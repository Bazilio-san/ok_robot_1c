Функция ОтправитьСсылку(Ссылка) Экспорт
	
	МассивОбъектов = Новый Массив;
	КэшЗначения = Новый Соответствие;
	СчетчикКэша = 0;
	СчетчикДокументов = 0;
	ТекОбъект = ЗначениеСтруктурой(Ссылка,КэшЗначения,ИСТИНА,,,,ЛОЖЬ,СчетчикКэша);
	ДополнитьОбъект(Ссылка,КэшЗначения);
	МассивОбъектов.Добавить(ТекОбъект);
	МассивОбъектов.Вставить(0,СтруктураКэша(КэшЗначения));
	Строкаjson = ЗаписьJSON(МассивОбъектов);
	Ответ = ОтправитьСтрокой(Строкаjson);
	
	//Возврат ЛОЖЬ;//Отладка
	Возврат ТипЗнч(Ответ)=Тип("Структура") и Ответ.Свойство("Ответ") и Найти(Ответ.Ответ,"Обработано 0")=0;
КонецФункции
//RDP+
//Отправка через сервис данных из узла регистрации (настройки соединения из узла)
Процедура Отправить() Экспорт
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Сообщить("Не заполнен узел обмена");
		Возврат;
	КонецЕсли;
	
	
	МассивОбъектов = Новый Массив;
	КэшЗначения = Новый Соответствие;
	СчетчикКэша = 0;
	СчетчикДокументов = 0;
	МассивОтправки = Новый Соответствие();
	
	ВыборкаДанных = ПланыОбмена.ВыбратьИзменения(Узел,1,);
	
	
	Организации = Узел.Организации.Выгрузить().ВыгрузитьКолонку("Организация");
	
	Пока ВыборкаДанных.Следующий() Цикл
		//Попытка
		_Объект = ВыборкаДанных.Получить();
		Если ТипЗнч(_Объект) = ТИп("УдалениеОбъекта") Тогда
			МассивОтправки.Вставить(_Объект.Ссылка.УникальныйИдентификатор(),_Объект);
			МассивОбъектов.Добавить(Новый Структура("_Имя_,Метаданные,УникальныйИдентификатор","_УдалениеОбъекта_",_Объект.Ссылка.Метаданные().Имя,Строка(_Объект.Ссылка.УникальныйИдентификатор())));
		Иначе	
			Если Организации.Найти(_Объект.Фирма) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(_Объект)  = Тип("ДокументОбъект.Табель") и _Объект.Утвержден = ЛОЖЬ  Тогда
				Продолжить;
			КонецЕсли;
				
				
			МассивОтправки.Вставить(_Объект.Ссылка.УникальныйИдентификатор(),_Объект.Ссылка);
			ТекОбъект = ЗначениеСтруктурой(_Объект.Ссылка,КэшЗначения,ИСТИНА,,,,ЛОЖЬ,СчетчикКэша);
			ДополнитьОбъект(_Объект.Ссылка,КэшЗначения);
			МассивОбъектов.Добавить(ТекОбъект);
		КонецЕсли;	
		//Исключение
		//КонецПопытки;	
			
			//Сообщить("Подготовлен "+Выборка.Ссылка);
			//Прервать;
			
			СчетчикДокументов = СчетчикДокументов+1;
	КонецЦикла;	
	МассивОбъектов.Вставить(0,СтруктураКэша(КэшЗначения));
	Строкаjson = ЗаписьJSON(МассивОбъектов);
	
	Адрес        = Узел.Адрес;//"192.168.1.25";
	Ресурс       = Узел.Ресурс;//"/SB/hs/api/post";
	Порт         = Узел.Порт;//8080;
	Пользователь = Узел.Пользователь;//"Администратор";
	Пароль       = Узел.Пароль;//"rarus";
	РазмерПорции = 10;
	Защищенное   = Ложь;
	
	ПараметрыСоединения = Новый Структура;
	//Ответ = СоединениеДок(Выборка.Запрос); 
	Ответ = _Соединение(Адрес,
	Порт,
	Ресурс,
	Пользователь,
	Пароль,
	Защищенное,
	Строкаjson);
	Сообщить(Ответ);
	Если Не ПустаяСтрока(Ответ.Ответ) Тогда
		Сообщить(Ответ.Ответ);
	КонецЕсли;	
	Если Ответ.Свойство("Обработанные") Тогда
		
		Для каждого _Объект из Ответ.Обработанные Цикл
			
			ЗначениеОтмены = МассивОтправки.Получить(Новый УникальныйИдентификатор(_Объект));
			Если Не ЗначениеОтмены = Неопределено Тогда
				 //
				 ПланыОбмена.УдалитьРегистрациюИзменений(Узел,ЗначениеОтмены);
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	

КонецПроцедуры	

