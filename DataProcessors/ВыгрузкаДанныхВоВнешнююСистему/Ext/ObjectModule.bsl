//Вспомогательная функция, чтобы добавить в структуру объекта дополнительные данные
Процедура ДополнитьОбъект(_ОбъектСсылка,КэшЗначения) Экспорт
	Если ТипЗнч(_ОбъектСсылка) = тип("ДокументСсылка.уб_ОтчетКассира") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	П.Ссылка.Категория как Категория,
			|	ЕСТЬNULL(СУММА(П.Сумма), 0) КАК Сумма,
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА П.ОбоснованиеРазницы = ""Оплата выезда клиентом""
			|					ТОГДА П.Сумма
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК СуммаВознагражденияКурьераКлиентом,
			|	ЕСТЬNULL(СУММА(П.Сумма) - СУММА(ВЫБОР
			|				КОГДА П.ОбоснованиеРазницы = ""Оплата выезда клиентом""
			|					ТОГДА П.Сумма
			|				ИНАЧЕ 0
			|			КОНЕЦ), 0) КАК СуммаПоСтраховкам
			|ИЗ
			|	Документ.уб_ОтчетКассира КАК ОК
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК П
			|		ПО (П.Ссылка.ОтчетКассира = ОК.Ссылка)
			|			И (П.Ссылка.Проведен)
			|			И (П.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса)
			|				ИЛИ (П.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
			|					И П.Ссылка.Дата > ДАТАВРЕМЯ(2023, 7, 1)))
			|ГДЕ
			|	ОК.Ссылка = &ОтчетКассира
			|
			|СГРУППИРОВАТЬ ПО
			|	П.Ссылка.Категория";
		Запрос.УстановитьПараметр("ОтчетКассира",_ОбъектСсылка);	
		ОтчетыКассиру = Запрос.Выполнить().Выгрузить();
		Если ОтчетыКассиру.НайтиСтроки(Новый Структура("Категория",Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка())).Количество()= 0 Тогда
			итОтчетаКассиру = ОтчетыКассиру.Вставить(0);
			итОтчетаКассиру.Категория = Справочники.уб_КатегорииДенежныхСредств.ПустаяСсылка();
			итОтчетаКассиру.Сумма = 0;
			итОтчетаКассиру.СуммаВознагражденияКурьераКлиентом= 0;
			итОтчетаКассиру.СуммаПоСтраховкам= 0;
		КонецЕсли;	
		Структура = КэшЗначения.Получить(_ОбъектСсылка);
		Структура.Значение.Вставить("_КатегорииВыплат_", ЗначениеСтруктурой(ОтчетыКассиру,КэшЗначения,ИСТИНА,,,,ЛОЖЬ));
	КонецЕсли;
КонецПроцедуры	

