&НаСервере
Процедура ЗаполнитьИзмененныеНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ВыборкаДанных = ПланыОбмена.ВыбратьИзменения(Объект.Узел,1,);
	
	МассивОбъектов = Новый Массив;
	КэшЗначения = Новый Соответствие;
	СчетчикКэша = 0;
	СчетчикДокументов = 0;
	
	Объект.ОбъектыДляВыгрузки.Очистить();
	ДатаНачалаОбмена = Объект.Узел.ДатаНачалаВыгрузкиДокументов;
	Организации = Объект.Узел.Организации.Выгрузить().ВыгрузитьКолонку("Организация");
	МассивОтправки = Новый Соответствие();
	Пока ВыборкаДанных.Следующий() Цикл
		//Попытка
		_Объект = ВыборкаДанных.Получить();
		Если ТипЗнч(_Объект) = ТИп("УдалениеОбъекта") Тогда
		Иначе	
			Если Обработка.ВыгружатьОбъект(_Объект,Организации,ДатаНачалаОбмена) =Истина  Тогда
				_Ссылка= Объект.ОбъектыДляВыгрузки.Добавить();
				Если ОтмечатьКОтправке Тогда
					_Ссылка.Выгружать = Истина;
				КонецЕсли;	
				_Ссылка.Объект = _Объект.Ссылка;
				
				_Ссылка.ПредставлениеОбъекта = ПредставлениеОбъекта(_Объект.Ссылка);
			КонецЕсли;	
		КонецЕсли;	
		
		СчетчикДокументов = СчетчикДокументов+1;
	КонецЦикла;		
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьИзмененные(Команда)
	ЗаполнитьИзмененныеНаСервере();
КонецПроцедуры


