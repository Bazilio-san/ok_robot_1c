Функция ПредставлениеОбъекта(_Ссылка)
	Суффикс = "";
	Попытка 
		Партнер = _Ссылка.Партнер;
		Суффикс = Суффикс+" ["+СокрЛП(Партнер)+"]";
	Исключение
		
	КонецПопытки;	
	
	Попытка 
		СуммаДокумента = _Ссылка.СуммаДокумента;
		Суффикс = Суффикс+" {"+Формат(СуммаДокумента,"ЧГ=")+"}";
	Исключение
		
	КонецПопытки;	
	Возврат ""+_Ссылка+ суффикс;
КонецФункции

