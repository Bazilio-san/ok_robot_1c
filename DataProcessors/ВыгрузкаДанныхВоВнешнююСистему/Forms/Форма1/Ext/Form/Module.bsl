&НаКлиенте
Процедура ПриВыбореИмениФайла(Результат,ДопПараметр) Экспорт
	Если Результат = Неопределено Тогда
		Возврат
	КонецЕсли;	
	Для каждого Файл из Результат Цикл
		Объект.ИмяФайлаОбмена  = Файл;
	КонецЦикла;	
		
КонецПроцедуры	


&НаСервере
Процедура ЗаполнитьПоПериодуИВидуНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОбменУправлениеТорговлейБухгалтерияПредприятия30Организации.Организация КАК Организация
	|ИЗ
	|	ПланОбмена.ОбменУправлениеТорговлейБухгалтерияПредприятия30.Организации КАК ОбменУправлениеТорговлейБухгалтерияПредприятия30Организации
	|ГДЕ
	|	ОбменУправлениеТорговлейБухгалтерияПредприятия30Организации.Ссылка = &Узел";
	Запрос.УстановитьПараметр("Узел",Объект.Узел);
	_Организации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
	
	Запрос.УстановитьПараметр("Дата1",Период.ДатаНачала);
	Запрос.УстановитьПараметр("Дата2",Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организации",_Организации);
	
	ДатаНачалаОбмена = Объект.Узел.ДатаНачалаВыгрузкиДокументов;
	
	Объект.ОбъектыДляВыгрузки.Очистить();
	СчетчикДокументов = 0;
	
	Для каждого ЭлементСписка из СписокВидовДокументов Цикл
		
		Если ЭлементСписка.Пометка = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		Запрос.Текст = "ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
		|	РеализацияТоваровУслуг.Дата КАК Дата,
		|	РеализацияТоваровУслуг.Проведен КАК Проведен
		|ИЗ
		|	"+ЭлементСписка.Значение+" КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ
		|	И РеализацияТоваровУслуг.Дата >= &Дата1
		|	И РеализацияТоваровУслуг.Дата <= &Дата2
		|	И РеализацияТоваровУслуг.Организация В(&Организации)";
		Выборка =Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
			_Объект = Выборка.Ссылка;
			Если ТипЗнч(_Объект) = ТИп("УдалениеОбъекта") Тогда
			Иначе	
				Если Обработка.ВыгружатьОбъект(_Объект,_Организации,ДатаНачалаОбмена) =Истина Тогда
					_Ссылка= Объект.ОбъектыДляВыгрузки.Добавить();
					Если  ОтмечатьКОтправке Тогда
						_Ссылка.Выгружать = Истина;
					КонецЕсли;	
					_Ссылка.Объект = _Объект.Ссылка;
					
					_Ссылка.ПредставлениеОбъекта = ПредставлениеОбъекта(_Объект.Ссылка);
				КонецЕсли;	
			КонецЕсли;	
			
			СчетчикДокументов = СчетчикДокументов+1;
			
		КонецЦикла;
	КонецЦикла;	
		
КонецПроцедуры


