&НаСервере
Процедура ВыгрузитьВФайлНаСервере()
			
	
	Обработка = РеквизитФормыВзначение("Объект");
	МассивОбъектов = Новый Массив;
	
	КэшЗначения = Новый Соответствие;
	
	ПодготовитьДанные(МассивОбъектов,КэшЗначения,Обработка);
	
	Текст = Новый ТекстовыйДокумент;
	Если МассивОбъектов.Количество() > 0 Тогда
		МассивОбъектов.Вставить(0,Обработка.СтруктураКэша(КэшЗначения));
		//Строка = ЗначениеВСтрокуВнутр(МассивОбъектов);
		//Возврат;
		Строка = Обработка.ЗаписьJSON(МассивОбъектов);
		//Возврат;
		Текст.УстановитьТекст(Строка);
	Иначе	
		Текст.УстановитьТекст("");
	КонецЕсли;	
	ВремИмяФайла = ПолучитьИмяВременногоФайла("txt");
	Текст.Записать(ВремИмяФайла);
	Объект.АдресВХранилище= ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВремИмяФайла),Новый УникальныйИдентификатор);
	МассивОбъектов = Новый Массив;
	Строка = "";
	

КонецПроцедуры

&НаСервере
Функция ПодготовитьДанные(МассивОбъектов,КэшЗначения,Обработка)
	Если ПустаяСтрока(Объект.ИмяФайлаОбмена) Тогда
		Сообщить("Не выбран файл сохранения");
		Возврат Ложь
	КонецЕсли;	
	
	
	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата1",Период.ДатаНачала);
	Запрос.УстановитьПараметр("Дата2",Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Фирма",Объект.Организация);
	ШаблонЗапроса = "ВЫБРАТЬ
	|	ТекДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК ТекДокумент
	|ГДЕ
	|	ТекДокумент.Дата >= &Дата1
	|	И ТекДокумент.Дата <= &Дата2 И ТекДокумент.Организация = &Фирма  и 2 = 2
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТекДокумент.Дата"; 
	
	ШаблонЗапроса2 = "ВЫБРАТЬ
	|	ТекДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК ТекДокумент"; 
	
	СчетчикКэша = 0;
	Для каждого СтрокаВида из  Объект.СписокВидовДокументов Цикл
		Если СтрокаВида.Пометка = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		Если Найти(СтрокаВида.Значение,"Справочник")>0 Тогда
			Запрос.Текст = СтрЗаменить(ШаблонЗапроса2,"Документ.ПриходнаяНакладная",СтрокаВида.Значение);
		Иначе	
			Запрос.Текст = СтрЗаменить(ШаблонЗапроса,"Документ.ПриходнаяНакладная",СтрокаВида.Значение);
		КонецЕсли;	
		//Если НЕ ПустаяСтрока(Комментарий) Тогда
		//	Запрос.Текст = СтрЗаменить(Запрос.Текст,"2 = 2","ТекДокумент.Комментарий подобно ""%"+Комментарий+"%""");
		//КонецЕсли;	
			 
		Выборка  = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			//ДанныеВходные = ЗначениеСтруктурой(Выборка.Ссылка,КэшЗначения,ИСТИНА);
			ТекОбъект = Обработка.ЗначениеСтруктурой(Выборка.Ссылка,КэшЗначения,ИСТИНА,,,,ЛОЖЬ,СчетчикКэша);
			//ТекОбъектСтрока = ЗаписьJSON(ТекОбъект);
			//ТекОбъектСтрока = ЗначениеВСтрокуВнутр(ТекОбъект);
			МассивОбъектов.Добавить(ТекОбъект);
			//Прервать;
		КонецЦикла;	
	КонецЦикла;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	Если ПустаяСтрока(Объект.ИмяФайлаОбмена) Тогда
		ПоказатьПредупреждение(,"Не выбрано имя файла",3);
		ЭтаФорма.ТекущийЭлемент = Элементы.ИмяФайлаОбмена;
		Возврат
	КонецЕсли;	
	ВыгрузитьВФайлНаСервере();
	Если ЭтоАдресВременногоХранилища(Объект.АдресВХранилище) Тогда
		ДД = ПолучитьИзВременногоХранилища(Объект.АдресВХранилище);
		ДД.Записать(Объект.ИмяФайлаОбмена);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОтправитьЧерезСервисНаСервере()
	Обработка = РеквизитФормыВзначение("Объект");
	МассивОбъектов = Новый Массив;
	
	КэшЗначения = Новый Соответствие;
	
	ПодготовитьДанные(МассивОбъектов,КэшЗначения,Обработка);
	
	Если МассивОбъектов.Количество()>0 Тогда
		МассивОбъектов.Вставить(0,Обработка.СтруктураКэша(КэшЗначения));
		Строкаjson = Обработка.ЗаписьJSON(МассивОбъектов);
		
		Обработка.ОтправитьСтрокой(Строкаjson);
		
		МассивОбъектов = Новый Массив;
		КэшЗначения = Новый Соответствие;
	КонецЕсли;


КонецПроцедуры

