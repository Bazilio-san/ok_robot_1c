&НаСервере
Процедура ОтправитьИзмененныеНаСервере()
	
	МассивОтправки = Новый Соответствие();
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Если Объект.ОбъектыДляВыгрузки.Количество()>0 Тогда
			Для каждого _Объект Из Объект.ОбъектыДляВыгрузки Цикл
			
			Если _Объект.Выгружать Тогда
				МассивОтправки.Вставить(_Объект.Объект.УникальныйИдентификатор(),_Объект.Объект);
			КонецЕсли;
		КонецЦикла;	
	Иначе
		МассивОтправки = Обработка.МассивОтправки(Объект.Узел);
	КонецЕсли;	
	
	Обработка.ОтправитьМассив(Объект.Узел,МассивОтправки);

	//ЗаполнитьИзмененныеНаСервере();

КонецПроцедуры

