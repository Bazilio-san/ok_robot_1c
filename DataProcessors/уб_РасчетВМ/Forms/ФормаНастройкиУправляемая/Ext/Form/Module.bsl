&НаСервереБезКонтекста
Функция ПолучитьСписокАгентов(ЗарплатныйПериод)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уб_ОплатаПолисов.Агент,
	|	уб_ОплатаПолисов.Агент.Наименование КАК Наименование
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|ГДЕ
	|	уб_ОплатаПолисов.ЗарплатныйПериод = &ЗарплатныйПериод
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Запрос.УстановитьПараметр("ЗарплатныйПериод",НачалоДня(КонецМесяца(ЗарплатныйПериод)));
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Агент, Выборка.Наименование);
	КонецЦикла;
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура рПериодЗПНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, Объект.ЗарплатныйПериод, ЭтаФорма);
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииУсловий()

	Структура = Неопределено;
	ВладелецФормы.ПриИзмененииУсловий(Структура);
	Элементы.Менеджер.СписокВыбора.Очистить();
	Элементы.Подразделение.СписокВыбора.Очистить();
	Для Каждого Элемент Из Структура.Менеджер Цикл
		Элементы.Менеджер.СписокВыбора.Добавить(Элемент.Значение);
	КонецЦикла;
	Для Каждого Элемент Из Структура.Подразделение Цикл
		Элементы.Подразделение.СписокВыбора.Добавить(Элемент.Значение);
	КонецЦикла;
	Если Элементы.Менеджер.СписокВыбора.Количество() > 1 Тогда
		Элементы.Менеджер.Доступность			= Истина;
		Элементы.Менеджер.КнопкаСпискаВыбора  	= Истина;
	Иначе
		Элементы.Менеджер.Доступность			= Ложь;
		Элементы.Менеджер.КнопкаСпискаВыбора	= Ложь;
	КонецЕсли;
	Если Элементы.Подразделение.СписокВыбора.Количество() < 2 Тогда
		Элементы.Подразделение.Доступность 			= Ложь;
		Элементы.Подразделение.КнопкаСпискаВыбора 	= Ложь;
	Иначе
		Элементы.Подразделение.Доступность			= Истина;
		Элементы.Подразделение.КнопкаСпискаВыбора	= Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, ПериодРегистрации, ЭтаФорма, НачальноеЗначение = Неопределено);
	
	СтандартнаяОбработка = Ложь;
	
	Если НачальноеЗначение = Неопределено Тогда
		НачальноеЗначение = ПериодРегистрации;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	НачалоТекущегоГода = НачалоГода(НачальноеЗначение);
	НачалоПрошлогоГода = НачалоГода(НачалоТекущегоГода - 1);
	СписокВыбора.Добавить(НачалоПрошлогоГода, (Формат(НачалоПрошлогоГода, "ДФ='yyyy'") + "..."));
	НачалоМесяцаЗаполнения = НачалоТекущегоГода;
	ЭлементПоУмолчанию = Неопределено;
	Для а = 1 По 12 Цикл
		ДобавленныйЭлемент = СписокВыбора.Добавить(НачалоМесяцаЗаполнения, Формат(НачалоМесяцаЗаполнения, "ДФ='MMMM yyyy'"));
		Если НачальноеЗначение = НачалоМесяцаЗаполнения Тогда
			ЭлементПоУмолчанию = ДобавленныйЭлемент;
		КонецЕсли;
		НачалоМесяцаЗаполнения = ДобавитьМесяц(НачалоМесяцаЗаполнения, 1);
	КонецЦикла;
	НачалоСледующегоГода = КонецГода(НачалоТекущегоГода) + 1;
	СписокВыбора.Добавить(НачалоСледующегоГода, (Формат(НачалоСледующегоГода, "ДФ='yyyy'") + "..."));
	
	ВыбранныйЭлемент = ЭтаФорма.ВыбратьИзСписка(СписокВыбора, Элемент, ЭлементПоУмолчанию);
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	ИначеЕсли Год(ВыбранныйЭлемент.Значение) <> Год(НачальноеЗначение) Тогда
		НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, ПериодРегистрации, ЭтаФорма, ВыбранныйЭлемент.Значение);
		Возврат;
	КонецЕсли;
	
	ПериодРегистрации = ВыбранныйЭлемент.Значение;
	ЭтаФорма[Элемент.Имя] = Формат(ПериодРегистрации, "ДФ='MMMM yyyy'");
	
КонецПроцедуры

&НаКлиенте
Процедура рПериодЗПРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ЗарплатныйПериод) Тогда
		УстановитьЗначениеЗППериода();
		Возврат;
	Иначе	
	    Если Направление = 1 Тогда // увеличиваем значение
			Объект.ЗарплатныйПериод = НачалоДня(КонецМесяца(КонецМесяца(Объект.ЗарплатныйПериод) + 1));
		Иначе // = -1 - уменьшаем значение
			Объект.ЗарплатныйПериод = НачалоДня(КонецМесяца(НачалоМесяца(Объект.ЗарплатныйПериод) - 1));
		КонецЕсли;
		УстановитьЗначениеЗППериода(Объект.ЗарплатныйПериод);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Если ЭтаФорма.ВладелецФормы <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма.ВладелецФормы.Объект, Объект,,"ЗП");
	КонецЕсли;
КонецПроцедуры
