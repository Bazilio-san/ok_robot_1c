
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.ВладелецФормы <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Объект, ЭтаФорма.ВладелецФормы.Объект,,"ЗП");
	КонецЕсли;
	Если Не (уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")  ) Тогда	
		Элементы.ПересчитыватьСуммыВОплатах.Доступность = Ложь;
		Элементы.СкрыватьКолонкиДСП.Доступность = Ложь;
		//Элементы.ПоказатьТолькоОплатыНеИзЭтогоЗППериода.Доступность = Ложь;
		Элементы.ОтображатьОплатыИсключенныеИзРасчетаЗП.Доступность = Ложь;	
	КонецЕсли;
	ТекПользователь = ПолучитьПараметрСеансаТекущийПользователь();
	ФизЛицоТекущийПользователь = ТекПользователь.ФизЛицо;
	Если уб_КЭШируемые.ДоступностьРоли("уб_МенеджерНаТочке") И НЕ (уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")) Тогда
		Объект.Менеджер = ФизЛицоТекущийПользователь;
		Элементы.Менеджер.Доступность = Ложь;
		Объект.Подразделение = ПолучитьПустоеПодразделение();
		Элементы.Подразделение.Доступность = Ложь;
	ИначеЕсли уб_КЭШируемые.ДоступностьРоли("уб_СтаршийМенеджерНаТочке") И НЕ (уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")) Тогда
		Объект.Подразделение = уб_СС.ПолучитьПодразделениеАгента(ФизЛицоТекущийПользователь);
		Элементы.Подразделение.Доступность = Ложь;
	КонецЕсли;
	УстановитьЗначениеЗППериода();
	//ОбновитьСписокМенеджеров();
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПустоеПодразделение()
	Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрСеансаТекущийПользователь()
	Структура = Новый Структура;
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ТекПользователь);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.ФизЛицо,
	|	Пользователи.Представление
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структура.Вставить("ФизЛицо", Выборка.ФизЛицо);
		Структура.Вставить("Представление", Выборка.Представление);
	Иначе
		Структура.Вставить("ФизЛицо", Справочники.ФизическиеЛица.ПустаяСсылка());
		Структура.Вставить("Представление", "");
	КонецЕсли;
	Возврат Структура;
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеЗППериода(ЗначениеЗпПериода = Неопределено) Экспорт
	
	Если ЗначениеЗпПериода = Неопределено Тогда
		ЗначениеЗпПериода = ДайЗарплатныйПериод();
	КонецЕсли;
	Объект.ЗарплатныйПериод = ЗначениеЗпПериода;
	УстановитьОтображениеМесячногоПериода("рПериодЗП",Объект.ЗарплатныйПериод);
	
КонецПроцедуры

&НаКлиенте
Функция ДайЗарплатныйПериод()
	Возврат НачалоМесяца(Объект.ЗарплатныйПериод);	
КонецФункции

&НаКлиенте
Процедура УстановитьОтображениеМесячногоПериода(Элемент,Реквизит)
	
	мФорматМесячногоПериода = "ДФ='ММММ гггг'";
	ЭтаФорма[Элемент] = Формат(Реквизит, мФорматМесячногоПериода);
	Если Реквизит = НачалоДня(КонецМесяца(ТекущаяДата())) Тогда
		Элементы[Элемент].ЦветТекста = Новый Цвет(164, 40, 190);	
	ИначеЕсли Реквизит > НачалоДня(КонецМесяца(ТекущаяДата())) Тогда
		Элементы[Элемент].ЦветТекста = ПолучитьЦветСтиля("ЦветОтрицательногоЧисла");
	Иначе
		Элементы[Элемент].ЦветТекста = Новый Цвет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦветСтиля(Цвет)
	Возврат ЦветаСтиля[Цвет];
КонецФункции

