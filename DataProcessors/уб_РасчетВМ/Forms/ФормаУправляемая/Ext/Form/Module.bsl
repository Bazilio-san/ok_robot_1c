#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтруктураПараметров = уб_ФормыВызовСервера.ПолучитьСтруктуруДанныхФормы(Параметры);
	//ЗаполнитьЗначенияСвойств(ЭтаФорма,СтруктураПараметров);
	Для каждого Параметр из СтруктураПараметров Цикл
		Попытка
			Объект[Параметр.Ключ] = Параметр.Значение;
		Исключение
		КонецПопытки;	
	КонецЦикла;
	
	ОбновитьСписокМенеджеров();
	Если Параметры.Свойство("Сформровать") Тогда
		ТабДок = Новый ТабличныйДокумент;
		СформироватьОтчетНаСервере(, , , , ТабДок);
		ДокументРезультат = ТабДок;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ТекПользователь = ПолучитьПараметрСеансаТекущийПользователь();
	ФизЛицоТекущийПользователь = ТекПользователь.ФизЛицо;
	Если Не ЗначениеЗаполнено(Объект.ЗарплатныйПериод)Тогда		
		//Невнешнее открытие
		Объект.ЗарплатныйПериод 						= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ЗарплатныйПериод");
		Объект.ВидСП 									= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ВидСП");
		Если уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ") Тогда
			Объект.ПересчитыватьСуммыВОплатах = ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ПересчитыватьСуммыВОплатах");
		КонецЕсли;	
		Объект.ВыводитьПримечанияКВМВячейки 			= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ВыводитьПримечанияКВМВячейки");
		Объект.СкрыватьКолонкиДСП 						= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","СкрыватьКолонкиДСП");
		Объект.ОтображатьКолонкиДляСхемыПланПоСКВ 		= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ОтображатьКолонкиДляСхемыПланПоСКВ");
		Объект.ОтображатьТолькоФамилии 					= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ОтображатьТолькоФамилии");
		Объект.ПоказатьТолькоОплатыНеИзЭтогоЗППериода 	= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ПоказатьТолькоОплатыНеИзЭтогоЗППериода");
		Объект.ОтображатьОплатыИсключенныеИзРасчетаЗП 	= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","ОтображатьОплатыИсключенныеИзРасчетаЗП");		
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ЗарплатныйПериод) Тогда
		Объект.ЗарплатныйПериод = НачалоДня(КонецМесяца(ТекущаяДата()));
	КонецЕсли;
	
	Элементы.ПересчитыватьСуммыВОплатах.Доступность = уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ");
	
	ОбновитьПредставлениеЗППериода();
	РежимОтчета = РежимОтчета;
	УправлениеВидимостью();	
	Если  уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") Тогда
		Объект.Менеджер 		= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","Менеджер");
		Объект.Подразделение 	= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","Подразделение");
		Объект.Организация 		= ЗагрузитьИзХранилищаНастроек("Обработка_РасчетЗПМенеджерамОП","Организация");
	КонецЕсли;
	Отказ = ПриИзмененииУсловий();
	Если Отказ Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет доступа!";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	СохранитьЗначенияРеквизитов();
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура РежимОтчетаПриИзменении(Элемент)
	
	УправлениеВидимостью();
	Если Объект.РежимОтчета = 1 Тогда
		Объект.ТолькоСОтличиями = Истина;
	//	Элементы.рПериодЗП.Ширина = 17;
	//	Элементы.Менеджер.Ширина = 24;
	//Иначе
	//	Элементы.рПериодЗП.Ширина = 18;
	//	Элементы.Менеджер.Ширина = 23;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура УправлениеВидимостью()
	
	бСравнение = Объект.РежимОтчета = 1;
	//Одиночное
	Элементы.Подразделение.Видимость = НЕ бСравнение;
	Элементы.ДатаСреза.Видимость = НЕ бСравнение;
	Элементы.ПересчитыватьСуммыВОплатах.Видимость = НЕ бСравнение и уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ");
	//Сравнение
	Элементы.ОткрытьОтчетОбИзмененияхВОплатах.Видимость =  бСравнение;
	Элементы.ТолькоСОтличиями.Видимость = бСравнение;
	Элементы.ДатаСреза1.Видимость = бСравнение;
	Элементы.ДатаСреза2.Видимость = бСравнение;
	
КонецПроцедуры

// Процедура устанавливает значение расчетного периода и его представление в реквизит формы
&НаКлиенте
Процедура ОбновитьПредставлениеЗППериода(ЗначениеЗпПериода = Неопределено) Экспорт
	
	Если ЗначениеЗпПериода = Неопределено Тогда
		ЗначениеЗпПериода = ДайЗарплатныйПериод();
	КонецЕсли;
	Объект.ЗарплатныйПериод = ЗначениеЗпПериода;
	УстановитьОтображениеМесячногоПериода("рПериодЗП",Объект.ЗарплатныйПериод);
	
КонецПроцедуры

&НаКлиенте
Функция ДайЗарплатныйПериод()
	Возврат НачалоМесяца(Объект.ЗарплатныйПериод);	
КонецФункции

&НаКлиенте
Процедура УстановитьОтображениеМесячногоПериода(Элемент,Реквизит)
	
	мФорматМесячногоПериода = "ДФ='ММММ гггг'";
	ЭтаФорма[Элемент] = Формат(Реквизит, мФорматМесячногоПериода);
	Если Реквизит = НачалоДня(КонецМесяца(ТекущаяДата())) Тогда
		Элементы[Элемент].ЦветТекста = Новый Цвет(164, 40, 190);	
	ИначеЕсли Реквизит > НачалоДня(КонецМесяца(ТекущаяДата())) Тогда
		Элементы[Элемент].ЦветТекста = ПолучитьЦветСтиля("ЦветОтрицательногоЧисла");
	Иначе
		Элементы[Элемент].ЦветТекста = Новый Цвет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦветСтиля(Цвет)
	Возврат ЦветаСтиля[Цвет];
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрСеансаТекущийПользователь()
	Структура = Новый Структура;
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ТекПользователь);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.ФизЛицо,
	|	Пользователи.Представление
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структура.Вставить("ФизЛицо", Выборка.ФизЛицо);
		Структура.Вставить("Представление", Выборка.Представление);
	Иначе
		Структура.Вставить("ФизЛицо", Справочники.ФизическиеЛица.ПустаяСсылка());
		Структура.Вставить("Представление", "");
	КонецЕсли;
	Возврат Структура;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПустоеПодразделение()
	Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
КонецФункции

&НаСервере
Процедура ОбновитьСписокМенеджеров()
	СписокВыбора = уб_СС.ПолучитьСписокСотрудниковАктуальныхВМесяце(Объект.ЗарплатныйПериод);
	Элементы.Менеджер.СписокВыбора.Очистить();
	Для Каждого Элемент Из СписокВыбора Цикл
		Элементы.Менеджер.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
КонецПроцедуры

