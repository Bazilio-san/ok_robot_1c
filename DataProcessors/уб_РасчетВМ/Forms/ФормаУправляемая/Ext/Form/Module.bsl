&НаКлиенте
Процедура СохранитьЗначенияРеквизитов()
	
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ЗарплатныйПериод", 						Объект.ЗарплатныйПериод);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "Менеджер", 								Объект.Менеджер);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ВидСП", 									Объект.ВидСП);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "Подразделение", 							Объект.Подразделение);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "Организация", 							Объект.Организация);
	Если  уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ") Тогда
		СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ПересчитыватьСуммыВОплатах", 			Объект.ПересчитыватьСуммыВОплатах);
	КонецЕсли;	
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ВыводитьПримечанияКВМВячейки", 			Объект.ВыводитьПримечанияКВМВячейки);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "СкрыватьКолонкиДСП", 					Объект.СкрыватьКолонкиДСП);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ОтображатьКолонкиДляСхемыПланПоСКВ", 	Объект.ОтображатьКолонкиДляСхемыПланПоСКВ);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ОтображатьТолькоФамилии", 				Объект.ОтображатьТолькоФамилии);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ПоказатьТолькоОплатыНеИзЭтогоЗППериода", Объект.ПоказатьТолькоОплатыНеИзЭтогоЗППериода);
	СохранитьВХранилищеНастроек("Обработка_РасчетЗПМенеджерамОП", "ОтображатьОплатыИсключенныеИзРасчетаЗП", Объект.ОтображатьОплатыИсключенныеИзРасчетаЗП);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетОбИзмененияхВОплатах(Команда)
	ОткрытьОтчетОбИзмененияхВОплатахНаКлиенте(Объект.ДатаСреза1, Объект.ДатаСреза2, Объект.Менеджер, Объект.ЗарплатныйПериод);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетОбИзмененияхВОплатахНаКлиенте(ДатаСреза1, ДатаСреза2, Менеджер, ЗарплатныйПериод)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
	Форма = Отчеты.уб_ОтчетПоПравкамОплатДляЗП.ПолучитьФорму();
	ПриведеннаяДатаСреза1 = ДатаСреза1;
	ПриведеннаяДатаСреза2 = ДатаСреза2;
	ТД = ТекущаяДата();
	Если НЕ ЗначениеЗаполнено(ПриведеннаяДатаСреза1) Тогда
		ПриведеннаяДатаСреза1 = ТД;
	Конецесли;
	Если НЕ ЗначениеЗаполнено(ПриведеннаяДатаСреза2) Тогда
		ПриведеннаяДатаСреза2 = ТД;
	Конецесли;
	Минимум = Мин(ПриведеннаяДатаСреза1,ПриведеннаяДатаСреза2);
	Максимум = Макс(ПриведеннаяДатаСреза1,ПриведеннаяДатаСреза2);
	
	//Ограничение по дате началаведения истории
	Минимум = Макс(Минимум,Дата(2011,12,25,1,1,1));
	Максимум = Макс(Максимум,Дата(2011,12,25,1,1,1));
	
	Форма.НачПериода = Минимум;
	Форма.КонПериода = Максимум;
	
	Форма.Менеджер = Менеджер;
	Форма.РасчетныйПериод = ЗарплатныйПериод;
	Форма.ФильтрПоПериоду = Истина;
	Форма.Открыть();
	#Иначе
	//!Пока не работает так как нужно нарисовать управляемую форму!
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Отчет об изменениях в оплатах временно не работает в тонком клиенте.";
	Сообщение.Сообщить();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура рПериодЗПНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, Объект.ЗарплатныйПериод, ЭтаФорма);
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, ПериодРегистрации, ЭтаФорма, НачальноеЗначение = Неопределено);
	
	СтандартнаяОбработка = Ложь;
	
	Если НачальноеЗначение = Неопределено Тогда
		НачальноеЗначение = ПериодРегистрации;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	НачалоТекущегоГода = НачалоГода(НачальноеЗначение);
	НачалоПрошлогоГода = НачалоГода(НачалоТекущегоГода - 1);
	СписокВыбора.Добавить(НачалоПрошлогоГода, (Формат(НачалоПрошлогоГода, "ДФ='yyyy'") + "..."));
	НачалоМесяцаЗаполнения = НачалоТекущегоГода;
	ЭлементПоУмолчанию = Неопределено;
	Для а = 1 По 12 Цикл
		ДобавленныйЭлемент = СписокВыбора.Добавить(НачалоМесяцаЗаполнения, Формат(НачалоМесяцаЗаполнения, "ДФ='MMMM yyyy'"));
		Если НачальноеЗначение = НачалоМесяцаЗаполнения Тогда
			ЭлементПоУмолчанию = ДобавленныйЭлемент;
		КонецЕсли;
		НачалоМесяцаЗаполнения = ДобавитьМесяц(НачалоМесяцаЗаполнения, 1);
	КонецЦикла;
	НачалоСледующегоГода = КонецГода(НачалоТекущегоГода) + 1;
	СписокВыбора.Добавить(НачалоСледующегоГода, (Формат(НачалоСледующегоГода, "ДФ='yyyy'") + "..."));
	
	ВыбранныйЭлемент = ЭтаФорма.ВыбратьИзСписка(СписокВыбора, Элемент, ЭлементПоУмолчанию);
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	ИначеЕсли Год(ВыбранныйЭлемент.Значение) <> Год(НачальноеЗначение) Тогда
		НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, ПериодРегистрации, ЭтаФорма, ВыбранныйЭлемент.Значение);
		Возврат;
	КонецЕсли;
	
	ПериодРегистрации = ВыбранныйЭлемент.Значение;
	ЭтаФорма[Элемент.Имя] = Формат(ПериодРегистрации, "ДФ='MMMM yyyy'");
	
КонецПроцедуры

&НаКлиенте
Процедура рПериодЗПРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ЗарплатныйПериод) Тогда
		ОбновитьПредставлениеЗППериода();
		Возврат;
	КонецЕсли;
	Если Направление = 1 Тогда // увеличиваем значение
		Объект.ЗарплатныйПериод = НачалоДня(КонецМесяца(КонецМесяца(Объект.ЗарплатныйПериод) + 1));
	Иначе // = -1 - уменьшаем значение
		Объект.ЗарплатныйПериод = НачалоДня(КонецМесяца(НачалоМесяца(Объект.ЗарплатныйПериод) - 1));
	КонецЕсли;
	ОбновитьПредставлениеЗППериода(Объект.ЗарплатныйПериод);
	СтандартнаяОбработка = Ложь;
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаКлиенте
