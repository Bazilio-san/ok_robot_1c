&НаКлиенте
Процедура СформироватьОтчетПоЗП(Команда = Неопределено, Знач фТЗОплат = Неопределено, Знач фТЗАгентов=Неопределено, Знач фтзПодразделений = Неопределено, Знач фтзСхемаРасчетаДляАгентов=Неопределено) Экспорт
	
	Если Объект.РежимОтчета = 1 И Не ЗначениеЗаполнено(Объект.Менеджер) Тогда
		Предупреждение("В режиме сравнения менеджер должен быть заполнен!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ЗарплатныйПериод) Или СокрЛП(ЭтаФорма.рПериодЗП) = "" Тогда
		Предупреждение("Не выбран период");
		Возврат;
	КонецЕсли;
	ТабДок = Новый ТабличныйДокумент;
	СформироватьОтчетНаСервере(фТЗОплат, фТЗАгентов, фтзПодразделений, фтзСхемаРасчетаДляАгентов, ТабДок);
	ДокументРезультат = ТабДок;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере(Знач фТЗОплат, Знач фТЗАгентов, Знач фтзПодразделений, Знач фтзСхемаРасчетаДляАгентов, ДокументРезультат)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СформироватьОтчет(фТЗОплат, фТЗАгентов, фтзПодразделений, фтзСхемаРасчетаДляАгентов, ДокументРезультат);
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииУсловийСервер(НовыйПериод = Неопределено, СписокВыбораМенеджеров = Неопределено, СписокВыбораПодразделений = Неопределено)

	Перем Парам;
	////
	Отказ = Ложь;
	Если Не уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") Тогда
		Элементы.Менеджер.КнопкаВыбора 		= Ложь;
		Элементы.Подразделение.КнопкаВыбора	= Ложь;
		уб_СС.ПодчиненныеРуководителя(, ?(НовыйПериод = Неопределено, Объект.ЗарплатныйПериод, НовыйПериод), Парам);
		КоличествоВСписке = Парам.ТЗ.Количество();
		Если КоличествоВСписке = 0 Тогда
			Отказ = Истина;
			Элементы.Менеджер.Доступность = Ложь;
			Объект.СписокМенеджеров.Очистить();
			Элементы.Менеджер.КнопкаСпискаВыбора   		= Ложь;
			Элементы.Подразделение.Доступность 			= Ложь;
			Элементы.Подразделение.КнопкаСпискаВыбора	= Ложь;
		Иначе
			Если Парам.ТЗПодразделений.Количество() = 1 Тогда
				Объект.Подразделение = Парам.ТЗПодразделений[0].Значение;
				Элементы.Подразделение.Доступность 			= Ложь;
				Элементы.Подразделение.КнопкаСпискаВыбора 	= Ложь;
			Иначе
				Элементы.Подразделение.Доступность			= Истина;
				Элементы.Подразделение.КнопкаСпискаВыбора	= Истина;
				СписокВыбораПодразделений = Парам.ТЗПодразделений;
				Если Элементы.Подразделение.СписокВыбора.НайтиПоЗначению(Объект.Подразделение) = Неопределено Тогда
					Объект.Подразделение = Неопределено
				КонецЕсли;
			КонецЕсли;
			Если КоличествоВСписке > 1 Тогда
				Элементы.Менеджер.Доступность			= Истина;
				Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
					СЗ = Новый СписокЗначений;
					Для Каждого СтрокаТЗ Из Парам.ТЗ Цикл
						Если СтрокаТЗ.Подразделение = Объект.Подразделение Тогда
							СЗ.Добавить(СтрокаТЗ.Сотрудник);
						КонецЕсли;
					КонецЦикла;
				Иначе
					СЗ = Парам.СписокСотрудников;
				КонецЕсли;
				СписокВыбораМенеджеров = СЗ;
				Объект.СписокМенеджеров = СЗ;
				Элементы.Менеджер.КнопкаСпискаВыбора  	= Истина;
			Иначе
				Объект.Менеджер = Парам.ТЗ[0].Сотрудник;
				Элементы.Менеджер.Доступность = Ложь;
				Объект.СписокМенеджеров.Очистить();
				Элементы.Менеджер.КнопкаСпискаВыбора	= Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
			СписокВыбораМенеджеров = Новый СписокЗначений;
			СписокВыбораМенеджеров.ЗагрузитьЗначения(уб_КЭШируемые.СписокСотрудниковПодразделения(Объект.Подразделение, ?(НовыйПериод = Неопределено, Объект.ЗарплатныйПериод, НовыйПериод)));
			Объект.СписокМенеджеров = СписокВыбораМенеджеров.Скопировать();
			Элементы.Менеджер.КнопкаСпискаВыбора = Истина;
		Иначе
			Объект.СписокМенеджеров.Очистить();
			СписокВыбораМенеджеров = уб_СС.ПолучитьСписокСотрудниковАктуальныхВМесяце(Объект.ЗарплатныйПериод);
		КонецЕсли;
	КонецЕсли;
	Возврат Отказ;

КонецФункции // ПриИзмененииУсловий()

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ПриИзмененииУсловий();
	
КонецПроцедуры

&НаКлиенте
Функция ПриИзмененииУсловий(СтруктураСписковВыбора = Неопределено) Экспорт
	
	СписокВыбораМенеджеров = Новый СписокЗначений;
	СписокВыбораПодразделений = Новый СписокЗначений;
	Отказ = ПриИзмененииУсловийСервер(, СписокВыбораМенеджеров, СписокВыбораПодразделений);
	Элементы.Менеджер.СписокВыбора.Очистить();
	Элементы.Подразделение.СписокВыбора.Очистить();
	Для Каждого Элемент Из СписокВыбораМенеджеров Цикл
		Элементы.Менеджер.СписокВыбора.Добавить(Элемент.Значение);
	КонецЦикла;
	Для Каждого Элемент Из СписокВыбораПодразделений Цикл
		Элементы.Подразделение.СписокВыбора.Добавить(Элемент.Значение);
	КонецЦикла;
	СтруктураСписковВыбора = Новый Структура;
	СтруктураСписковВыбора.Вставить("Менеджер", 		Элементы.Менеджер.СписокВыбора.Скопировать());
	СтруктураСписковВыбора.Вставить("Подразделение", 	Элементы.Подразделение.СписокВыбора.Скопировать());
	Возврат Отказ;
	
КонецФункции

