					Если Найти("ОП-4,ОП-3,000000038,000000025",СокрЛП(Стр.Подразделение.Код)) = 0 Тогда
						Стр.СуммаВознаграждения_РОП_Прол = Стр.СтавкаВознаграждения_РОП_Прол*Стр.СКВ_Прол/100;
						Стр.СуммаВознаграждения_РОП_НБ = Стр.СтавкаВознаграждения_РОП_НБ*Стр.СКВ_НБ/100;
