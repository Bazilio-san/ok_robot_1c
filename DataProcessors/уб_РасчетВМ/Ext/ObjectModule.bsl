					//КонецЕсли;
					
					ОблПодразделение.Параметры.КоличествоФакт  = Формат(ВыборкаПодраздел.КоличествоФакт_ПоПодразделению,КФ);
					ОблПодразделение.Параметры.КоэффициентВида  = Формат(ВыборкаПодраздел.КоэффициентВида_ПоПодразделению,КФ);
					ОблПодразделение.Параметры.НовыйКлиент  = Формат(ВыборкаПодраздел.НовыйКлиент_ПоПодразделению,КФ);
					ОблПодразделение.Параметры.НовыйКлиентСКВ  = "";//Формат(ВыборкаПодраздел.НовыйКлиентСКВ_ПоПодразделению,КФ);
					
					
