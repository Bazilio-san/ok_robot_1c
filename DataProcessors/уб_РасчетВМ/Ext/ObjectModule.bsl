				ОблПодразделение_Вознаграждение = Макет.ПолучитьОбласть("Подразделение|Вознаграждение");	
				ОблПодразделение_Взносы = Макет.ПолучитьОбласть("Подразделение|Взносы");	
				ОблПодразделение_Доход = Макет.ПолучитьОбласть("Подразделение|Доход");	
				ОблПодразделение.Параметры.Подразделение	= НаименованиеПодразделения;
