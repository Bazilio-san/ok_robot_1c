					//	//ОблПодразделение.Параметры.СобранаяКВ	   = Формат(ВыборкаПодраздел.СКВ_ДляПланаПоСКВ_ПоПодразделению,ЧФ000);
					//	ОблПодразделение.Параметры.СобранаяКВ	   = Формат(ВыборкаПодраздел.СКВ_ПоПодразделениямДоСП,ЧФ000);
					//	
