	Кол.Добавить("КоэффициентВида_ПоАгенту",		ОписаниеТипаЧисло12_0);//_ПоАгенту	
	Кол.Добавить("НовыйКлиент_ПоАгенту",		ОписаниеТипаЧисло12_0);//_ПоАгенту	
	Кол.Добавить("НовыйКлиентСКВ_ПоАгенту",		ОписаниеТипаЧисло12_0);//_ПоАгенту	
	
