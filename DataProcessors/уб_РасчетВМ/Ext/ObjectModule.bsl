		|	   ВЫРАЗИТЬ(ВЫБОР
		|	               КОГДА ДанныеПоМенеджерам.СКВ = 0
		|	                 ТОГДА 0
		|                  ИНАЧЕ СУММА(ПромежуточныеРасчеты.Доплата) * 100 / ДанныеПоМенеджерам.СКВ
		|	            КОНЕЦ КАК ЧИСЛО(15, 1)) КАК ВМПроцентБезКоррекции,
		|	    ВЫБОР
		|	      КОГДА ПромежуточныеРасчеты.ЭтоВМ = ИСТИНА
		|	        ТОГДА ""ВМ""
		|         ИНАЧЕ ""РОП""
		|	    КОНЕЦ КАК ВидВознаграждения
		|	ИЗ
		|	ПромежуточныеРасчеты КАК ПромежуточныеРасчеты
		|	ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоМенеджерам КАК ДанныеПоМенеджерам
		|	ПО (ДанныеПоМенеджерам.менеджер = ПромежуточныеРасчеты.менеджер)
		|	ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоРОП КАК ДанныеПоРОП
		|	ПО (ДанныеПоРОП.РОП = ПромежуточныеРасчеты.менеджер)
		|	
		|	СГРУППИРОВАТЬ ПО
		|	ПромежуточныеРасчеты.менеджер,
		|	ПромежуточныеРасчеты.Подразделение,
		|	ДанныеПоМенеджерам.СКВ,
		|	ДанныеПоРОП.СКВ,
		|	ПромежуточныеРасчеты.ЭтоВМ");
		Если тзПоИнтерваламСКВ.Колонки.Найти("РасчетыПоДокументу")<>Неопределено Тогда
			тзПоИнтерваламСКВ.Колонки.Удалить("РасчетыПоДокументу");
		КонецЕсли;
		
		Если тзПоИнтерваламСКВ.Колонки.Найти("УслугиПоДокументу")<>Неопределено Тогда
			тзПоИнтерваламСКВ.Колонки.Удалить("УслугиПоДокументу");	
		КонецЕсли;
		
		
		Запрос.УстановитьПараметр("тз",тзПоИнтерваламСКВ);
