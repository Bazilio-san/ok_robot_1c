		Для Каждого СтрокаДляКуратора Из ТЗТолькоКуратор Цикл
			ТЗТолькоАгентДоп = ТЗТолькоАгент.Добавить();
			ЗаполнитьЗначенияСвойств(ТЗТолькоАгент,СтрокаДляКуратора);
		КонецЦикла;
		ЗапросВыводРасчетаВМ.УстановитьПараметр("ТЗ",ТЗТолькоАгент);
	Иначе	
		ЗапросВыводРасчетаВМ.УстановитьПараметр("ТЗ", ТЗ1.Скопировать(,"Агент,Куратор,СКВ,СКВ_Прол,ВидСП,Дата,Пустышка,СхемаРасчетаСМенеджером,Подразделение,Страхователь,ПолисАннулирован,ВознаграждениеМенеджера,ВознаграждениеДоп,Ссылка,НеВыводить,СтраховойПродукт,Номер,СК,НомерЗаявки,СКВ_КС,НомерПолиса,НомерКвитанции,ПолнаяПремия,НачисленнаяСуммаВзноса,НомерВзноса,ОплаченоФакт,АВилиСкидкаПроцент,АВилиСкидкаСумма,КоличествоФакт,КоэффициентВида,НовыйКлиент,НовыйКлиентСКВ,НаправлениеПлатежа,КВПроцент,КВСумма,КВСуммаДляАгента,КВПроцентДляОтчета,БонусМенеджеру,ВидРасчетаСАгентом,Бонус_КС,ЕД,ВычетСАгента,БОНУС_РОП_КС,КВПодВопросом,ЭтоПролонгация"));
	КонецЕсли;	
	Для каждого СтрокаА из ТЗАгентов Цикл
		Если ТипЗнч(СтрокаА.СуммаДб)<>Тип("Число") Тогда
			СтрокаА.СуммаДб = 0;
		КонецЕсли;	
	КонецЦикла;	
	
	ЗапросВыводРасчетаВМ.УстановитьПараметр("ТЗАгентов", ТЗАгентов);
