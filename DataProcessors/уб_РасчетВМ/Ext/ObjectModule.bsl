			Стр.НовыйКлиентСКВ_ПоПодразделению = СтрокаСуммыСКВ.НовыйКлиентСКВ;			
			
			
		КонецЕсли;
		СтрокаСуммыВМ = тзСуммыВМ_ПоПодразделениям.Найти(Стр.Подразделение,"Подразделение");
		Если СтрокаСуммыВМ <> Неопределено Тогда
			Стр.СуммаВМ = СтрокаСуммыВМ.ВознаграждениеМенеджера+СтрокаСуммыВМ.ПартнерскоеВознаграждение;
			Стр.СуммаДБ = СтрокаСуммыВМ.СуммаДБ;
		КонецЕсли;
		бСхПроцентОтСКВ	= Стр.СхемаВознагражденияРуководителяОП = ПрчСхемаВР.ПроцентОтСКВ;
		бСхПроцентОтВМ	= Стр.СхемаВознагражденияРуководителяОП = ПрчСхемаВР.ПроцентОтВМ;
		бСхПроцентОтДБ	= Стр.СхемаВознагражденияРуководителяОП = ПрчСхемаВР.ПроцентОтДБ и ЭтоВариант20180701 ;
		Если бСхПроцентОтДБ Тогда
			//Если ЭтоВариант20180701 Тогда  Расчет будет по сотрудникам ниже
			//	Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаДоМинимальногоПорога_РОП;	
			//	Стр.СуммаВознаграждения_РОП		= Стр.СуммаДБ * Стр.СтавкаВознаграждения_РОП / 100;	
			//Иначе
				Стр.СтавкаВознаграждения_РОП = 0;
				Стр.СуммаВознаграждения_РОП	 = 0;
			//КонецЕсли;
		ИначеЕсли бСхПроцентОтСКВ Тогда
			колПланРукВыполнен = ЭтоВариант20130901=ЛОЖЬ ИЛИ Стр.СуммаКоличествоПлан=0 ИЛИ Стр.КоличествоФакт_ПоПодразделению>=Стр.СуммаКоличествоПлан;
			Если Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению >= Стр.СуммаПлана * Стр.ПоказательПлана_РОП / 100 Тогда
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаПослеПлана_РОП-?(колПланРукВыполнен,0,1);	
			ИначеЕсли Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению >= Стр.СуммаПлана * Стр.ПоказательМинимальногоПорога_РОП / 100 Тогда
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаДоПлана_РОП-?(колПланРукВыполнен,0,1);	
			Иначе
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаДоМинимальногоПорога_РОП+?(колПланРукВыполнен и ЭтоВариант20130901 и НЕ ЭтоВариант20191201,1,0);	
			КонецЕсли;
			Если ЭтоВариант20120401  Тогда 
				//В этом случае расчет может быть скорректирован
			ИначеЕсли ЭтоВариант20121001 Тогда
				//
				Стр.СуммаВознаграждения_РОП	= (Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению) * Стр.СтавкаВознаграждения_РОП / 100;	
				//Стр.СуммаВознаграждения_РОП		= (Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению-Стр.СКВ_КС) * Стр.СтавкаВознаграждения_РОП / 100;	
			Иначе
				Стр.СуммаВознаграждения_РОП	= Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению * Стр.СтавкаВознаграждения_РОП / 100;	
			КонецЕсли;	
			Стр.ПроцентВыполненияПлана_РОП	= ?(Стр.СуммаПлана = 0,0,Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению / Стр.СуммаПлана * 100);	
		ИначеЕсли бСхПроцентОтВМ Тогда	
			//Для схемы вознаграждения руководителя  ПроцентОтВМ значения показателей имеет иной смысл:
			Если Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению >= Стр.ПоказательПлана_РОП Тогда
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаПослеПлана_РОП;	
			ИначеЕсли Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению >= Стр.ПоказательМинимальногоПорога_РОП Тогда
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаДоПлана_РОП;	
			Иначе
				Стр.СтавкаВознаграждения_РОП = Стр.ПроцентнаяСтавкаДоМинимальногоПорога_РОП;	
			КонецЕсли;
			Стр.СуммаВознаграждения_РОП		= Стр.СуммаВМ * Стр.СтавкаВознаграждения_РОП / 100;	
			Стр.ПроцентВыполненияПлана_РОП	= ?(Стр.ПоказательПлана_РОП = 0,0,Стр.СКВ_ДляПланаПоСКВ_ПоПодразделению / Стр.ПоказательПлана_РОП * 100);	
		
		КонецЕсли;
		Если НЕ Стр.РуководительПолучаетВознаграждение Тогда
			Стр.СуммаВознаграждения_РОП = 0;
		КонецЕсли;	
	КонецЦикла;
	//Добавляем в ТЗ1 пустые строки для Подразделений, у которых небыло оплат
	Для Каждого Стр ИЗ тзПодразделений Цикл
		Если НЕ Стр.ЭтоПодразделениеЕстьВТЗ1 Тогда
			НовОплата				= ТЗ1.Добавить();
			НовОплата.Подразделение	= Стр.Подразделение;		
