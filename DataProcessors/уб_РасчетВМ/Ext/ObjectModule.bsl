	Кол.Добавить("БОНУС_КС_",ОписаниеТипаЧисло14_2_но);
	Кол.Добавить("БратьВИтоги",ОписаниеТипаБулево);
	СписокУчтенных = Новый Массив;
	
	ВыборкаМенеджеров = ВыполнениеПланаМенеджерами(ТЗАгентов.ВыгрузитьКолонку("Агент"), ЗарплатныйПериод);
	
	Для Каждого Стр ИЗ ТЗАгентов Цикл
		Если СписокУчтенных.Найти(Стр.Агент) = Неопределено Тогда
			Стр.БратьВИтоги = Истина;
			СписокУчтенных.Добавить(Стр.Агент);
		Иначе
			Стр.БратьВИтоги = Ложь;
		КонецЕсли;	
		СтрокаСумм = тзСуммы_ДляПланаПоСКВ_ПоАгентам.Найти(Стр.Агент,"Агент"); //Тут таблица только по схеме
		ДопПроцент = 0; //За выполнение НС при невыполнении плана по суммам
