	ЭтоВариант20180701 = ЗарплатныйПериод >= Дата(2018,7,1);//СКВ КС вычиватеся из БАЗЫ РОП
	ЭтоВариант20180801 = ЗарплатныйПериод >= Дата(2018,8,1);//Автоматическое изменние дельты АВ
	ЭтоВариант20181001 = ЗарплатныйПериод >= Дата(2025,2,1);//Сравнение количества клиентов с прошлым годом для оценки выполнения плана
