		//|    ИЛИ 
		//|      ВЫБОР
		//|      КОГДА ОП.ЗарплатныйПериод >= ДАТАВРЕМЯ(2015, 9, 1)
		//|        ТОГДА ЕСТЬNULL(НачисленияСКВ.СуммаСКВ, 0)
		//|      ИНАЧЕ 0 //ВЫБОР
		//|            //КОГДА ОП.ОплаченоФакт > 0
		//|            //     И ОП.КВСуммаДляАгента > ОП.АВилиСкидкаСумма
		//|            //  ТОГДА ОП.КВСуммаДляАгента - ОП.АВилиСкидкаСумма
		//|            //ИНАЧЕ 0
		//|            //КОНЕЦ
		//|      КОНЕЦ > 0
		//|     ) //Вместо нижестоящей
		//|	И ОП.СтраховойПолис.НомерЗаявки <> &ЛичнаяСтраховка 
		|   И ОП.ПометкаУдаления = ЛОЖЬ ";		
		Если ФильтрПоСП Тогда
			УсловиеОтбораОплат = УсловиеОтбораОплат + " И ОП.ВидС = &ВидСП ";
		КонецЕсли;		
		//Если ФильтрПоМенеджеру Тогда
		//УсловиеОтбораОплат = УсловиеОтбораОплат + " И ОП.Агент = &Менеджер ";
		//КонецЕсли;		
		//Если ФильтрПоПодразделению Тогда
		//	УсловиеОтбораОплат = УсловиеОтбораОплат + " И ОП.Подразделение = &Подразделение ";
		//КонецЕсли;		
		ЗапросРасчетВМ.УстановитьПараметр("ДатаНачала",		ДатаНачала);
		ЗапросРасчетВМ.УстановитьПараметр("ДатаКонца",		ДатаКонца);
		//ЗапросРасчетВМ.УстановитьПараметр("ЛичнаяСтраховка",кЛичнаяЗаявка);
		//ЗапросРасчетВМ.УстановитьПараметр("РасчетПоАВ",		кРасчетПоАВ);
		ЗапросРасчетВМ.УстановитьПараметр("РасчетПоАВ",		кРасчетПоАВ);
		//ЗапросРасчетВМ.УстановитьПараметр("ВидКАСКО",		пВидКАСКО);
		//ЗапросРасчетВМ.УстановитьПараметр("ВидЕКАСКО",		пВидЕКАСКО);
		ЗапросРасчетВМ.УстановитьПараметр("ПустойПолис",	ПустойПолис);		
		ЗапросРасчетВМ.УстановитьПараметр("Менеджер",		Менеджер);
		ЗапросРасчетВМ.УстановитьПараметр("Подразделение",	Подразделение);
		ЗапросРасчетВМ.УстановитьПараметр("ВидСП",			ВидСП);		
		ЗапросРасчетВМ.УстановитьПараметр("СотрудникиМастера",ЭтоМастер());
		// Если галочка "пересчитывать суммы в оплатах" ИСТИНА
		Если ПересчитыватьСуммыВОплатах Тогда
			ЗапросРасчетВМ.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОП.Ссылка
			|ИЗ
			|	Документ.уб_ОплатаПолисов КАК ОП" + УсловиеОтбораОплат;
			Результат = ЗапросРасчетВМ.Выполнить();			
			ПересчитатьСуммыПоЗП(Результат);
		КонецЕсли;		
		Если ЭтоПолныеПрава Тогда
			УстановитьПривилегированныйРежим(Истина);
			ЗапросНачисления = Новый Запрос;
			ЗапросНачисления.Текст = "ВЫБРАТЬ
			|	МАКСИМУМ(уб_НачислениеЗП.Дата) КАК Дата
			|ИЗ
			|	Документ.уб_НачислениеЗП КАК уб_НачислениеЗП
			|ГДЕ
			|	уб_НачислениеЗП.ПометкаУдаления = Ложь";
			
			
			Попытка
				ВыборкаНачисления = ЗапросНачисления.Выполнить().Выбрать();
				Если ВыборкаНачисления.Следующий() Тогда
					ЭтоПоследнийРасчет = ДатаНачала >= ВыборкаНачисления.Дата;
				Иначе
					ЭтоПоследнийРасчет = Истина;
				КонецЕсли;	
			Исключение
				ЭтоПоследнийРасчет = Ложь;
			КонецПопытки;	
			
			УстановитьПривилегированныйРежим(Ложь);
			
			ПересчетДельтыАВ = ЭтоВариант20180801 и (ЭтоПоследнийРасчет Или ПересчетДельтыКВ); 
			Если ПересчетДельтыАВ Тогда
				ЗапросРасчетВМ.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОП.Ссылка
				|ИЗ
				|	Документ.уб_ОплатаПолисов КАК ОП" + СтрЗаменить(УсловиеОтбораОплат,"<>Значение(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ)","=Значение(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ) и ПроверенаЗП = ЛОЖЬ");
				Результат = ЗапросРасчетВМ.Выполнить();			
				ПересчитатьДельтыКВ(Результат);
			КонецЕсли;	
		КонецЕсли;	
		
