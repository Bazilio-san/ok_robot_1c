			Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("Скрывать для замов ЗП сотрудников", Ложь) Тогда
				ЗамПодразделения = Справочники.ФизическиеЛица.ПустаяСсылка();
			Иначе
				МЗ2 = уб_СтраховойБрокер.ПолучитьРуководителяПодразделения(ДатаНачала+1, ВыборкаПодраздел.Подразделение,Истина);
				ЗамПодразделения = МЗ2.Сотрудник;
			КонецЕсли;	
				
			//Если (ЗначениеЗаполнено(Подразделение) И ВыборкаПодраздел.Подразделение <> Подразделение)
			//	Или (СписокПодразделений <> Неопределено И СписокПодразделений.НайтиПоЗначению(ВыборкаПодраздел.Подразделение) = Неопределено)
			//	Или (ФильтрПоМенеджеру И ВыборкаПодраздел.Пустышка И РуководительПодразделения <> Менеджер И Не ПодразделениеАгента <> ВыборкаПодраздел.Подразделение)
			//	Или ВыборкаПодраздел.Пустышка
			//	Тогда
			//	Продолжить
			//КонецЕсли;		
			Если ФильтрПоМенеджеру Тогда
				Если ВыборкаПодраздел.Пустышка 
                     И РуководительПодразделения <> Менеджер 
					 И Не ПодразделениеАгента <> ВыборкаПодраздел.Подразделение Тогда
					Продолжить;
				КонецЕсли;	
			Иначе
				Если ВыборкаПодраздел.Пустышка Тогда
