				ДокументРезультат.Присоединить(ОблОрг_Доход);
			КонецЕсли;	
		КонецЕсли;	
		ВыборкаПодраздел = ВыборкаОрг.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
