	Кол.Добавить("ЗПот1БПдо2БП",			ОписаниеТипаЧисло14_2_но); //До От1БПдо2БП
	Кол.Добавить("ЗПСвыше2БП",			ОписаниеТипаЧисло14_2_но); //До От1БПдо2БП
