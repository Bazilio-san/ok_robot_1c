	// ПОЛУЧЕНИЕ ДАННЫХ ИЗ ОПЛАТ ЛИБО ИЗ ИСТОРИИ ОПЛАТ
	////////////////////////////////////////////////////////
	
	ФильтрПоМенеджеру = ЗначениеЗаполнено(Менеджер);
