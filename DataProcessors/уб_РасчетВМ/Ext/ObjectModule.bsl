		МассивПакетов = Запрос.ВыполнитьПАкет();
		ВсегоЗапросов = МассивПакетов.Количество();
		Выборка = МассивПакетов[ВсегоЗапросов-1].Выбрать();
		//
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.Менеджер) Тогда
