Функция ПолучитьСоответствиеОрганизацийПодразделениям()
	//
	Запрос = Новый Запрос (
	"ВЫБРАТЬ
	|	ПодразделенияОрганизаций.Ссылка Подразделение,
	|	ПодразделенияОрганизаций.Владелец как Организация
	|ИЗ
	|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций");
	Выборка = Запрос.Выполнить().Выбрать();
	Соответствие = Новый Соответствие;
	ПустаяОрганизация = Справочники.Организации.ПустаяСсылка();
	Соответствие.Вставить(0,ПустаяОрганизация);
	Соответствие.Вставить(NULL,ПустаяОрганизация);
	Соответствие.Вставить(Неопределено,ПустаяОрганизация);
	Соответствие.Вставить(Справочники.ПодразделенияОрганизаций.ПустаяСсылка(),ПустаяОрганизация);	
	Пока Выборка.Следующий() Цикл
		Соответствие.Вставить(Выборка.Подразделение,Выборка.Организация);
	КонецЦикла;	
	Возврат Соответствие;
	
