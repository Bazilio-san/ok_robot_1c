						Стр.СуммаВознаграждения_РОП_Прол = Стр.СтавкаВознаграждения_РОП_Прол*(Стр.СКВ_Прол+Стр.СКВ_БП_Прол)/100;
						Стр.СуммаВознаграждения_РОП_НБ = Стр.СтавкаВознаграждения_РОП_НБ*(Стр.СКВ_НБ+Стр.СКВ_БП_НБ)/100;
					КонецЕсли;	
					Стр.СуммаВознаграждения_РОП = Стр.СуммаВознаграждения_РОП_Прол+Стр.СуммаВознаграждения_РОП_НБ;
