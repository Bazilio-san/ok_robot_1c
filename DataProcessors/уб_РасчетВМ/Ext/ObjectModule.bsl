			Стр.СКВ_ДляПланаПоСКВ_ПоАгенту	= СтрокаСумм.СКВ;
			Стр.СКВ_Прол                    = СтрокаСумм.СКВ_Прол;
			Стр.СобраннаяСП					= СтрокаСумм.НачисленнаяСуммаВзноса; 
			Стр.ПроцентВыполненияПлана		= ?(Стр.План = 0,0,Стр.СКВ_ДляПланаПоСКВ_ПоАгенту / Стр.План * 100); 
			Стр.ПроцентВыполненияПланаДляРОП = ?((Стр.План-Стр.ШтрафнойПлан) = 0,0,Стр.СКВ_ДляПланаПоСКВ_ПоАгенту / (Стр.План-Стр.ШтрафнойПлан) * 100); 
			
			Стр.КоличествоФакт_ПоАгенту		= СтрокаСумм.КоличествоФакт;
			Стр.КоэффициентВида_ПоАгенту	= СтрокаСумм.КоэффициентВида;
			Стр.НовыйКлиент_ПоАгенту	= СтрокаСумм.НовыйКлиент;
			Стр.НовыйКлиентСКВ_ПоАгенту	= СтрокаСумм.НовыйКлиентСКВ;
			
			
		ИначеЕсли ЭтоВариант20180701 Тогда	
			Стр.СКВ_ДляПланаПоСКВ_ПоАгенту	= 0;
			Стр.СобраннаяСП					= 0; 
			Стр.ПроцентВыполненияПлана		= 0; 
			Стр.ПроцентВыполненияПланаДляРОП = 0; 
			
			Стр.КоличествоФакт_ПоАгенту		= 0;
			Стр.КоэффициентВида_ПоАгенту	= 0;
			Стр.НовыйКлиент_ПоАгенту	= 0;
			Стр.НовыйКлиентСКВ_ПоАгенту	= 0;
			
			
		Иначе
			Продолжить;
		КонецЕсли;	
		
		СтрокаСумм = ТЗ1_ГодНазад.Найти(Стр.Агент,"Агент");
		Если СтрокаСумм <> Неопределено Тогда
			Стр.КоэффициентВидаГод_ПоАгенту	= СтрокаСумм.КоэффициентВида;
		КонецЕсли;	
		
		//ПланВыполнен = уб_РасчетыСМенеджерами.ПланВыполнен(Стр.Агент,ЗарплатныйПериод,Стр.СКВ_ДляПланаПоСКВ_ПоАгенту >= Стр.План);
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Менеджер", Стр.Агент);
		ВыборкаМенеджеров.Сбросить();
		
		Если ВыборкаМенеджеров.НайтиСледующий(СтруктураПоиска) Тогда
			ПланВыполнен = ВыборкаМенеджеров.ВыполненПлан;
			РаскраситьКоличественныйПлан = Ложь;
			РаскраситьПлан = Ложь;
		ИначеЕсли ЭтоВариант20181001 Тогда
			СуммовойПланВыполнен = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту >= Стр.План;
			ПроцентНовых = ?(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту=0,0,Цел(100*Стр.НовыйКлиентСКВ_ПоАгенту/Стр.СКВ_ДляПланаПоСКВ_ПоАгенту));
			КоличественныйПланВыполнен = ПроцентНовых>=20 или Стр.КоэффициентВида_ПоАгенту>=Стр.КоэффициентВидаГОД_ПоАгенту;
			ПланВыполнен = СуммовойПланВыполнен И КоличественныйПланВыполнен;
			ДопПроцент = 0;//?(КоличественныйПланВыполнен=Истина ,5,0);//
			РаскраситьПлан = Не СуммовойПланВыполнен;
			РаскраситьКоличественныйПлан = Не КоличественныйПланВыполнен;		
		ИначеЕсли ЭтоВариант20130801 Тогда
			СуммовойПланВыполнен = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту >= Стр.План;
			//КоличественныйПланВыполнен = Стр.КоэффициентВида >= Стр.КоэффициентВидаГОд;
			КоличественныйПланВыполнен = Стр.КоличествоФакт_ПоАгенту >= Стр.Количество;
			ПланВыполнен = СуммовойПланВыполнен И КоличественныйПланВыполнен;
			ДопПроцент = ?(ПланВыполнен=ЛОЖЬ и КоличественныйПланВыполнен=Истина ,?(ЗарплатныйПериод<Дата(2018,10,1),5,0),0);//За выполнение НС при невыполнении плана по суммам
			РаскраситьПлан = Не СуммовойПланВыполнен;
			РаскраситьКоличественныйПлан = Не КоличественныйПланВыполнен;
		Иначе
			СуммовойПланВыполнен = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту >= Стр.План;
			ПланВыполнен = СуммовойПланВыполнен;
			РаскраситьПлан = Не СуммовойПланВыполнен;
			РаскраситьКоличественныйПлан = Ложь;
		КонецЕсли;
		РаскраситьПолеМенеджера = Не ПланВыполнен;
		
		Если РаскраситьПолеМенеджера = Истина Или РаскраситьПлан = Истина Или РаскраситьКоличественныйПлан = Истина Тогда
			
			НайденныеСтроки = тзАгентовДляРаскраски.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаМенеджера = НайденныеСтроки[0];
			Иначе
				СтрокаМенеджера = тзАгентовДляРаскраски.Добавить();
				СтрокаМенеджера.Менеджер = Стр.Агент;
				СтрокаМенеджера.РаскраситьПолеМенеджера = Ложь;
				СтрокаМенеджера.РаскраситьПлан = Ложь;
				СтрокаМенеджера.РаскраситьКоличественныйПлан = Ложь;
			КонецЕсли;
			
			Если СтрокаМенеджера.РаскраситьПолеМенеджера = Ложь Тогда
				СтрокаМенеджера.РаскраситьПолеМенеджера = РаскраситьПолеМенеджера;
			КонецЕсли;
			
			Если СтрокаМенеджера.РаскраситьПлан = Ложь Тогда
				СтрокаМенеджера.РаскраситьПлан = РаскраситьПлан;
			КонецЕсли;
			
			Если СтрокаМенеджера.РаскраситьКоличественныйПлан = Ложь Тогда
				СтрокаМенеджера.РаскраситьКоличественныйПлан = РаскраситьКоличественныйПлан;
			КонецЕсли;
			
		КонецЕсли;
		
		Стр.ВыполненПланПоСКВ = ПланВыполнен;
		Стр.СтавкаВознаграждения = ?(ПланВыполнен, Стр.ПроцентнаяСтавкаПослеПлана, Стр.ПроцентнаяСтавкаДоПлана+ДопПроцент);
		Бонус_КС  = 0;
		ОстатокПролонгации = 0;
		Если ЭтоВариант20121001 и (ЭтоВариант20150401=Истина ИЛИ ПланВыполнен = Истина) Тогда //Отработка не выполненного плана внутри
			//
			Если ПланВыполнен Тогда
				СКВ_БЕЗ_КС = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту-Стр.СКВ_КС;//-Стр.СКВ_Прол;
			Иначе	
				//Подменяем ставки, а суммы также будут распределятся по диапазонам, чтобы не влиять на зп руководителей
				Стр.ПроцентнаяСтавкаПослеПервойБонусПланки = Стр.СтавкаВознаграждения; 
				Стр.ПроцентнаяСтавкаПослеСуперПлана        = Стр.СтавкаВознаграждения;
				//КС идут в план бьез бонусов
				СКВ_БЕЗ_КС = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту;//-Стр.СКВ_Прол;
				//= Стр.СКВ_КС-(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту-Мин(СКВ_БЕЗ_КС,Стр.ПерваяБонусПланка))
				//= 53000 - (248000-(248000-53000)<Стр.ПерваяБонусПланка))
				// = ?((248000-53000)>Стр.ПерваяБонусПланка,0,1);
				// Мин(Стр.ПерваяБонусПланка,500000)- Мин((500000-150000),Стр.ПерваяБонусПланка)
				// Мин(Стр.ПерваяБонусПланка,236000)- Мин((236000-236000),Стр.ПерваяБонусПланка)
				Если ЭтоВариант20150901 Тогда
					ДельтаКСРуководитель = 0; //Дельты нет. т.к. все идет в план
				Иначе
					ДельтаКСРуководитель = Мин(Стр.ПерваяБонусПланка,Стр.СКВ_ДляПланаПоСКВ_ПоАгенту)- Мин((Стр.СКВ_ДляПланаПоСКВ_ПоАгенту-Стр.СКВ_КС),Стр.ПерваяБонусПланка);
					Если ДельтаКСРуководитель <> 0 Тогда
						Сообщить("Дельта "+ДельтаКСРуководитель 
						//+ "/"+ Стр.Подраздаление
						+"/"+Стр.Агент);
					КонецЕсли;
				КонецЕсли;
				Стр.ДельтаКСРуководитель = ДельтаКСРуководитель;
			КонецЕсли;
			
			
			//+Новые промежуточные расчеты
			Стр.СКВДоПлана = Мин(СКВ_БЕЗ_КС,Стр.План);
			//-
			СКВ_НБ = СКВ_БЕЗ_КС;
			Если ЭтоВариант20121201 Тогда
				//+Новые промежуточные расчеты
				Стр.СКВотПланадо1БП             = Макс(Мин(СКВ_БЕЗ_КС,Стр.ПерваяБонусПланка) - Стр.План,0);
				Стр.СКВот1БПдо2БП               = Макс(Мин(СКВ_БЕЗ_КС,Стр.СуперПлан) - Стр.ПерваяБонусПланка,0);
				Стр.СКВСвыше2БП                 = Макс(СКВ_БЕЗ_КС - Стр.СуперПлан, 0);
				//-
				Если Стр.СКВ_Прол >0 Тогда
					СКВ_НБ = СКВ_БЕЗ_КС-Стр.СКВ_Прол;
					СКВ_Прол = Стр.СКВ_Прол;
					
					Если СКВ_НБ>Стр.ПерваяБонусПланка Тогда
						Стр.ЗПотСКВдоСуперПлана = Стр.ПерваяБонусПланка* Стр.СтавкаВознаграждения / 100; 
					Иначе
						Стр.ЗПотСКВдоСуперПлана = СКВ_НБ* Стр.СтавкаВознаграждения / 100; 
						ОстатокДоБП = Стр.ПерваяБонусПланка-СКВ_НБ;
						Если СКВ_Прол>ОстатокДоБП Тогда
							ОстатокПролонгации = СКВ_Прол-ОстатокДоБП;    //Эта сумма пойдет под 60
							//Стр.СКВ_Прол= Стр.СКВ_Прол-ОстатокПролонгации;//уберем из расчета под 30
						КонецЕсли;	
					КонецЕсли;	
					Стр.ЗПЗаПревышение1БП           = Стр.СКВот1БПдо2БП* Стр.ПроцентнаяСтавкаПослеПервойБонусПланки / 100;
					Стр.ЗП_Пролонгация              = (Стр.СКВ_Прол-ОстатокПролонгации)*?(ПланВыполнен=Истина,Стр.ПроцентнаяСтавкаПролонгация,Стр.ПроцентнаяСтавкаПролонгацияДоПлана)/100;
					Стр.ПревышениеСуперплана		= Макс(СКВ_БЕЗ_КС - Стр.СуперПлан, 0);
				Иначе	
					Стр.ЗПотСКВдоСуперПлана			= Мин(СКВ_БЕЗ_КС,Стр.ПерваяБонусПланка) * Стр.СтавкаВознаграждения / 100; 
					//Стр.СКВотПланадо1БП             = Макс(Мин(СКВ_БЕЗ_КС,Стр.СуперПлан)-Стр.ПерваяБонусПланка,0)
					//Стр.ЗПЗаПревышение1БП           = Макс(Мин(СКВ_БЕЗ_КС,Стр.СуперПлан)-Стр.ПерваяБонусПланка,0)* Стр.ПроцентнаяСтавкаПослеПервойБонусПланки / 100;
					Стр.ЗПЗаПревышение1БП           = Стр.СКВот1БПдо2БП* Стр.ПроцентнаяСтавкаПослеПервойБонусПланки / 100;
					Стр.ПревышениеСуперплана		= Макс(СКВ_БЕЗ_КС - Стр.СуперПлан, 0);
					Стр.ЗП_Пролонгация              = Стр.СКВ_Прол*?(ПланВыполнен=Истина,Стр.ПроцентнаяСтавкаПролонгация,Стр.ПроцентнаяСтавкаПролонгацияДоПлана)/100;
				КонецЕсли;
			Иначе	
				//+Новые промежуточные расчеты
				Стр.СКВотПланадо1БП             = Макс(Мин(СКВ_БЕЗ_КС,Стр.СуперПлан) - Стр.План,0);
				Стр.СКВот1БПдо2БП               = 0;
				Стр.СКВСвыше2БП                 = Макс(СКВ_БЕЗ_КС - Стр.СуперПлан, 0);
				//-
				//Стр.СКВотПланадо1БП = 0;
				Стр.ЗПотСКВдоСуперПлана			= Мин(СКВ_БЕЗ_КС,Стр.СуперПлан) * Стр.СтавкаВознаграждения / 100; 
				Стр.ПревышениеСуперплана		= Макс(СКВ_БЕЗ_КС - Стр.СуперПлан, 0);
			КонецЕсли;	
			Бонус_КС =0;
			Если ПланВыполнен = Истина Тогда
				СтруктураОтбораКС = Новый Структура("ЭтоКрупнаяСделка,Агент,СхемаРасчетаСМенеджером",Истина,Стр.Агент,ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ);
				СтрокиКС = ТЗ1.НайтиСтроки(СтруктураОтбораКС);
				
				Для каждого СтрокаКС из СтрокиКС Цикл
					СтрокаКС.СКВ_КС =  СтрокаКС.СКВ;
					СтрокаКС.БОНУС_КС = СтрокаКС.СКВ_КС * Макс(СтрокаКС.БонусПроцент+Стр.СтавкаВознаграждения,0)/100;
					Бонус_КС = Бонус_КС + СтрокаКС.БОНУС_КС;
				КонецЦикла;	
			КонецЕсли;
		Иначе	
			//+Новые промежуточные расчеты
			Стр.СКВДоПлана       = Мин(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту,Стр.План);
			Стр.СКВотПланадо1БП  = Макс(Мин(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту,Стр.СуперПлан) - Стр.План,0);
			Стр.СКВот1БПдо2БП    = 0;
			Стр.СКВСвыше2БП      = Макс(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту - Стр.СуперПлан, 0);
			//-
			//Стр.СКВотПланадо1БП = 0;
			Стр.ЗПотСКВдоСуперПлана		= Мин(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту,Стр.СуперПлан) * Стр.СтавкаВознаграждения / 100; 
			Стр.ПревышениеСуперплана	= Макс(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту - Стр.СуперПлан, 0);
		КонецЕсли;
		
		//Стр.ЗПотПланадо1БП = Стр.СКВотПланадо1БП*Стр.ПерваяБонусПланка;
		
		КорректировкаЗПСуперПлана = 0;
		СуммаДляРуководителяПоПониженнойСтавке = 0;
		ПроцентКС 		= 5;
		Бонус_КС_РОП 	= 0;
		Бонус     		= 0;
		Если Стр.ПревышениеСуперплана > 0 Тогда 
			Если ЭтоВариант20121001 Тогда
				ПревышениеСуперпланаКРаспределению = Стр.ПревышениеСуперплана;
				Если ПревышениеСуперпланаКРаспределению > 0 Тогда
					БОНУС = ПревышениеСуперпланаКРаспределению * ?(ПланВыполнен,Стр.ПроцентнаяСтавкаПослеСуперПлана,Стр.ПроцентнаяСтавкаДоПлана)/100;
				КонецЕсли;	
				Стр.ЗПотЗаПревышениеСуперПлана = БОНУС;
			Иначе
				СтруктураОтбораОплат = Новый Структура("СхемаРасчетаСМенеджером",ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ);
				СКВ_КС = 0;
				//Копируем таблицу по агенту
				ТЗОплатАгентаПоСхемеПланПоСКВ = ТЗ1.Скопировать(Новый Структура("СхемаРасчетаСМенеджером,Агент,Подразделение",ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ,Стр.Агент,Стр.Подразделение));
				Для каждого СтрокаТЗ ИЗ ТЗОплатАгентаПоСхемеПланПоСКВ Цикл
					//Сообщить(СтрокаТЗ.Ссылка);
					Если СтрокаТЗ.КВСуммаДляАгента>РазмерКС Тогда
						СКВ_КС = СКВ_КС + СтрокаТЗ.СКВ;
						Если ЭтоВариант20120401 Тогда
							СуммаДляРуководителяПоПониженнойСтавке = СуммаДляРуководителяПоПониженнойСтавке+СтрокаТЗ.СКВ;
						КонецЕсли;
					КонецЕсли;	
				КонецЦикла;	
				Если СКВ_КС>Стр.ПревышениеСуперплана Тогда
					СуммаПоПовышеннойСтавке        = Стр.ПревышениеСуперплана;
					БОНУС_КС                       = СуммаПоПовышеннойСтавке*(Стр.ПроцентнаяСтавкаПослеПлана+ПроцентКС)/100;
					Стр.ЗПотЗаПревышениеСуперПлана = БОНУС_КС;
				Иначе
					ФактическоеПревышениеСупера    = Стр.ПревышениеСуперплана - СКВ_КС;
					СуммаПоПовышеннойСтавке        = СКВ_КС;
					БОНУС_КС      = СуммаПоПовышеннойСтавке*(Стр.ПроцентнаяСтавкаПослеПлана+ПроцентКС)/100;
					БОНУС         = ФактическоеПревышениеСупера * Стр.ПроцентнаяСтавкаПослеСуперПлана / 100;
					//+Новые промежуточные расчеты
					Стр.СКВСвыше2БП      = ФактическоеПревышениеСупера;
					//-
					Стр.ЗПотЗаПревышениеСуперПлана	= БОНУС + БОНУС_КС;
				КонецЕсли;	
				
				
				НадоВыводитьСообщение = ЭтоПолныеПрава;
				Если НадоВыводитьСообщение И Бонус_КС > 0 Тогда
					Сообщить("По агенту "+Стр.Агент+" начислен бонус за крупную сделку в размере: "+Формат(Бонус_КС,"ЧЦ=15; ЧДЦ=2"));
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;			
		//+Новые промежуточные расчеты
		Стр.ЗПдоПлана      = Мин(Стр.СКВДоПлана,СКВ_НБ) * Стр.СтавкаВознаграждения/100;
		Стр.ЗПотПланадо1БП = (Мин(СКВ_НБ,Стр.ПерваяБонусПланка)-Мин(Стр.СКВДоПлана,СКВ_НБ)) * Стр.СтавкаВознаграждения/100;
		Стр.ЗПот1БПдо2БП   = Стр.СКВот1БПдо2БП * Стр.ПроцентнаяСтавкаПослеПервойБонусПланки/100;
		Стр.ЗПСвыше2БП     = Стр.СКВСвыше2БП * Стр.ПроцентнаяСтавкаПослеСуперПлана/100;
		//-Новые промежуточные расчеты
		
		Если Стр.БратьВИтоги Тогда
			Стр.ИтогоЗП	= Стр.ЗПотСКВдоСуперПлана + Стр.ЗПотЗаПревышениеСуперПлана+Стр.ЗПЗаПревышение1БП
			+ Стр.ЗП_Пролонгация;//+?(ЭтоВариант20121001,БОНУС_КС,0);
			Стр.БОНУС_КС_ = +?(ЭтоВариант20121001,БОНУС_КС,0);
		Иначе
			Стр.ИтогоЗП = 0 ;
		КонецЕсли;	
		СтрокаПодразделения				= тзПодразделений.Найти(Стр.Подразделение,"Подразделение");
		Если СтрокаПодразделения <> Неопределено Тогда
			Если СтрокаПодразделения.РуководительПолучаетВознаграждение Тогда					
				//ПроцентнаяСтавкаДоМинимальногоПорога_РОП	5	
				//СтрокаПодразделения.ПроцентнаяСтавкаДоПлана_РОП 8
				//Превышен план и есть крупная сделка
				НадоВыводитьСообщение = ЭтоПолныеПрава Или (СтрокаПодразделения.Руководитель = ПараметрыСеанса.уб_ТекущееФизЛицо);
				Если СуммаДляРуководителяПоПониженнойСтавке>0 
					И СтрокаПодразделения.СтавкаВознаграждения_РОП>СтрокаПодразделения.ПроцентнаяСтавкаДоПлана_РОП 
					и ЭтоВариант20150901 = ЛОЖЬ
					Тогда //Для старых расчетных периодов так.
					СуммаДляРуководителяПоПолнойСтавке = Стр.СКВ_ДляПланаПоСКВ_ПоАгенту-СуммаДляРуководителяПоПониженнойСтавке;
					СуммаДляРуководителяПоПониженнойСтавке = Мин(Стр.СКВ_ДляПланаПоСКВ_ПоАгенту - Стр.ПревышениеСуперплана,СуммаДляРуководителяПоПониженнойСтавке)-СуммаДляРуководителяПоПолнойСтавке;
					ВознаграждениеРуководителя = (Стр.СКВ_ДляПланаПоСКВ_ПоАгенту - Стр.ПревышениеСуперплана-СуммаДляРуководителяПоПониженнойСтавке) * СтрокаПодразделения.СтавкаВознаграждения_РОП / 100;
					//Для руководителя эта часть по пониженной ставке
					ВознаграждениеРуководителя2 = (СуммаДляРуководителяПоПониженнойСтавке) * СтрокаПодразделения.ПроцентнаяСтавкаДоМинимальногоПорога_РОП / 100;
					Если НадоВыводитьСообщение И СтрокаПодразделения.СтавкаВознаграждения_РОП<>СтрокаПодразделения.ПроцентнаяСтавкаДоМинимальногоПорога_РОП Тогда
						Сообщить("Для "+СтрокаПодразделения.Руководитель+" крупная сделка подчиненного на сумму "+Формат(СуммаДляРуководителяПоПониженнойСтавке,"ЧЦ=15; ЧДЦ=2; ДФ=")+" посчитана по "+СтрокаПодразделения.ПроцентнаяСтавкаДоМинимальногоПорога_РОП+"%");
					КонецЕсли;	
					Стр.ВознаграждениеРуководителя = ВознаграждениеРуководителя+ВознаграждениеРуководителя2;
					//Корректируем
					СтрокаПодразделения.СуммаВознаграждения_РОП = СтрокаПодразделения.СуммаВознаграждения_РОП+Стр.ВознаграждениеРуководителя;
				Иначе							
					Если ЭтоВариант20121001 Тогда
						//TO DO проверить								
					ИначеЕсли ЭтоВариант20120401 Тогда
						//TO DO проверить
						Стр.ВознаграждениеРуководителя = (Стр.СКВ_ДляПланаПоСКВ_ПоАгенту - Стр.ПревышениеСуперплана)* СтрокаПодразделения.СтавкаВознаграждения_РОП / 100;
						СтрокаПодразделения.СуммаВознаграждения_РОП = СтрокаПодразделения.СуммаВознаграждения_РОП+Стр.ВознаграждениеРуководителя;
					Иначе
