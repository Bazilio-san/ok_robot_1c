	//						__ВознаграждениеМенеджера = Окр(?(_вм.ЗП_СКВ=0 ИЛИ _этоКС,0,_вм.ЗП_СКВ*__СКВ/_вм.СКВ)+?(бЗаблокирована,ОП.Знч("ВознаграждениеМенеджера"),_ВознаграждениеМенеджера)+
	//						?(_вм.СКВ_КС=0 ИЛИ НЕ _этоКС,0,_вм.Бонус_КС*__СКВ/_вм.СКВ_КС),2);
	
