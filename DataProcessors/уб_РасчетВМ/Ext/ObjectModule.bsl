				КонецЕсли;
				Если РассчитатьПоказателиПодразделения Тогда
					
					ЗПОбщееП = УстановитьПараметрыОбласти_Вознаграждение(ОблПодразделение_Вознаграждение.Параметры,ВыборкаПодраздел,"ИтогоЗПпоПодразделению",Истина);
					ОблПодразделение.Параметры.ОбщееЗП = ЗПОбщееП;
