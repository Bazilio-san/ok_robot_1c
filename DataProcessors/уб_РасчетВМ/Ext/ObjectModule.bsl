	РазмерКС = ?(ПараметрыСеанса.уб_Константы.уб_ИспользуетсяМеханизмСделок = ИСТИНА И ЗарплатныйПериод >= Дата(2012,10,1),уб_РасчетыСменеджерами.РазмерКС(ЗарплатныйПериод),50000);
	
	РасчетДО1БП = уб_РасчетыСменеджерами.РасчетДО1БП(ЗарплатныйПериод);
	
	ЭтоПолныеПрава = ПолныеПрава();
	
	ЭтоВариант20121001 = ПараметрыСеанса.уб_Константы.уб_ИспользуетсяМеханизмСделок = ИСТИНА И ЗарплатныйПериод >= Дата(2012,10,1);
	
	ЭтоВариант20120401 = ЗарплатныйПериод >= Дата(2012,4,1); //У руководителей корректируется ЗП при наличии КС
	
	ЭтоВариант20121201 = ЗарплатныйПериод >= Дата(2012,12,1);//Используются 2 бонус планки
	ЭтоВариант20130301 = ЗарплатныйПериод >= Дата(2013,3,1) ; //Для истории КВ Агента
	
	ЭтоВариант20130801 = ЗарплатныйПериод >= Дата(2013,8,1);//Количественный план
	ЭтоВариант20130901 = ЗарплатныйПериод >= Дата(2013,9,1);//Количественный план РОП
