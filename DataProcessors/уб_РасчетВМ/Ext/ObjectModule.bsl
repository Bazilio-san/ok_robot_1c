Процедура ПосчитатьСтрахователей(ТЗ1)
	тз1_Страхователи = ТЗ1.Скопировать(,"Страхователь,Ед,КоэффициентВида,НовыйКлиент,НовыйКлиентСКВ");//Новый Структура("СхемаРасчетаСМенеджером",ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	тз1_Страхователи.Свернуть("Страхователь","ЕД,КоэффициентВида,НовыйКлиент,НовыйКлиентСКВ");
	
	ТЗ1.Сортировать("КоэффициентВида Убыв");//Учитывыем более высокие коэффицинты
	
	Для каждого СтрокаТЗ из ТЗ1.НайтиСтроки(Новый Структура("НовыйКлиент",1)) Цикл
		СтрокаТЗ.НовыйКлиентСКВ = СтрокаТЗ.СКВ;
		СтрокаТЗ.НовыйКлиентУник = 1;
	КонецЦикла;	
	
	Для каждого СтрокаСтрахователя из тз1_Страхователи Цикл
		Если СтрокаСтрахователя.Ед>1 и СтрокаСтрахователя.КоэффициентВида>1 Тогда
			Учтено = Ложь;
			нстроки = ТЗ1.НайтиСтроки(Новый Структура("Страхователь",СтрокаСтрахователя.Страхователь));
			Для каждого СтрокаС из нстроки Цикл
				Если СтрокаС.КоэффициентВида>0 Тогда
					Если Учтено  = Ложь Тогда
						Учтено = Истина;
					Иначе
						//Повторные оплаты от того же клиента обнуляем
						СтрокаС.КоэффициентВида = 0;
						СтрокаС.НовыйКлиентУник     = 0;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

Функция ЭтоМастер()
	
	Запрос = Новый Запрос;
	
	Если ЗарплатныйПериод >=Дата(2023,8,1) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник
		|ИЗ
		|	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПоследних(, ) КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
		|ГДЕ
		|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра = ""ЭтоМастер""
		|	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0";
	Иначе
		Запрос.Текст  = "ВЫБРАТЬ
		|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник
		|ИЗ
		|	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПервых(, ) КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
		|ГДЕ
		|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра = ""ЭтоМастер""
		|	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0";
		//	|	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник = &Сотрудник";
	КонецЕсли;				
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(ЗарплатныйПериод));				
	//Запрос.УстановитьПараметр("Сотрудник", Агент);				
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");
КонецФункции

Функция ЭтоСтажер(_Агент)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст  = "ВЫБРАТЬ
					|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник
					|ИЗ
					|	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПервых(, ) КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
					|ГДЕ
					|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра = ""ЭтоСтажер""
					|	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0
					|	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник = &Сотрудник";
					
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(ЗарплатныйПериод));				
	Запрос.УстановитьПараметр("Сотрудник", _Агент);				
	Возврат Запрос.Выполнить().Выгрузить().Количество()>0;
КонецФункции


Процедура ЗаписатьПараметр(_ТипПараметра,_Агент,_ЗначениеПараметра) Экспорт
	Попытка
	МЗ = Регистрысведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СоздатьМенеджерЗаписи();
	МЗ.Сотрудник         = _Агент;
	МЗ.ТипПараметра      = _ТипПараметра;
	МЗ.ЗначениеПараметра = _ЗначениеПараметра;
	МЗ.Период = ДатаНачала;
	Попытка
		МЗ.Записать();
	Исключение
	КонецПопытки;	
	Исключение
	КонецПопытки;	
КонецПроцедуры	