	ЭтоВариант20170101 = ЗарплатныйПериод >= Дата(2017,1,1);//Мастер получает ЗП через кассу
	ЭтоВариант20170901 = ЗарплатныйПериод >= Дата(2017,8,1);//Мастер и ведущие в одном отделе
	ДатаНачалаАВиТО = Дата(2016,1,1);
	ЭтоВариант20151001 = ЗарплатныйПериод >= ДатаНачалаАВиТО;//АВ и ТО сдается в кассу
