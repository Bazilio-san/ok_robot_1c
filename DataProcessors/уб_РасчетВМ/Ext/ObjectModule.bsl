				КонецЕсли;
			КонецЕсли;
			ВыводимСтрокуПодразделения = (ЭтоПолныеПрава ИЛИ 
										 (РуководительПодразделения = ПараметрыСеанса.уб_ТекущееФизЛицо  или ЗамПодразделения = ПараметрыСеанса.уб_ТекущееФизЛицо)
										 или (ПараметрыСеанса.уб_Константы.ЭтоМастерРуководитель и Найти(ВыборкаПодраздел.Подразделение,"М-ОП")>0)) и не Менеджер.Наименование = "Банки.ру" ;
										 Если ВыводимСтрокуПодразделения и ЗначениеЗаполнено(Менеджер) 
											 и НЕ РуководительПодразделения = Менеджер 
											 и НЕ ЗамПодразделения = Менеджер Тогда
											 ВыводимСтрокуПодразделения = Ложь;
										 КонецЕсли;							 
			Если ВыводимСтрокуПодразделения Тогда
