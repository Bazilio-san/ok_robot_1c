	//ЗапросВыводРасчетаВМ.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ТАгентов ИЗ &ТЗАгентов КАК ТА";
	//ЗапросВыводРасчетаВМ.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ТСписокОплатЗаПериод ИЗ &ТЗ КАК ТТ";
	//ЗапросВыводРасчетаВМ.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ТПодразделений ИЗ &тзПодразделений КАК ТП";
