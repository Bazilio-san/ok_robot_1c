		ТЗ1.Колонки.Добавить("СКВ_НБ", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП_Прол", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП_НБ", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("ВознаграждениеДоп", ОписаниеТипаЧисло14_2_но);
		
		ТЗ1.Очистить();		
