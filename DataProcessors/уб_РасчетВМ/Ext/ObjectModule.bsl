						ДокументРезультат.Присоединить(ОблПодразделение_Вознаграждение);
					КонецЕсли;	
					ДокументРезультат.Присоединить(ОблПодразделение_Взносы);
					Если ДБЕсть Тогда
						ДокументРезультат.Присоединить(ОблПодразделение_Доход);
					КонецЕсли;	
					ОбластьПодразделениеВыведено = Истина;
					// расшифровка по руководителю
					УровеньРасшифровки = Уровень+2;//+?(ОднаСхема = ЛОЖЬ,1,0);
