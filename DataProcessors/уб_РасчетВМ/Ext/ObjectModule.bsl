			УсловиеОтбораОплат = УсловиеОтбораОплат + " И (ОП.Дата < &ДатаНачала ИЛИ ОП.Дата > &ДатаКонца) ";
		КонецЕсли;		
		Если НЕ ОтображатьОплатыИсключенныеИзРасчетаЗП Тогда
			УсловиеОтбораОплат = УсловиеОтбораОплат + " И ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ ";
		КонецЕсли;		
