//Пересчет сумм, переустановка схем оплаты
Процедура ПересчитатьСуммыПоЗП(РезультатЗапроса) Экспорт 
	
	СоотвИнфоКВМ = Новый Соответствие;			
	ВыборкаОплат = РезультатЗапроса.Выбрать();
	//ИндикаторИнициализировать(ВыборкаОПлат.Количество());
	ДанныеПоЗПМенеджерам = уб_РасчетыСМенеджерами.РасчетЗП_Быстро(ЗарплатныйПериод);
	Пока ВыборкаОПлат.Следующий() Цикл
		#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
		ДО = ВыборкаОплат.Ссылка.ПолучитьОбъект(); 
		Параметры = уб_РасчетыСМенеджерами.СтруктураПараметровОППересчетСуммПоУмолчанию();
		Параметры.ДанныеПоЗПМенеджерам = ДанныеПоЗПМенеджерам;
		уб_РасчетыСМенеджерами.ОП_ПересчетСумм(ДО,,, Параметры);
		ИнфоКВМ = Параметры.ИнфоКВМ;
		СоотвИнфоКВМ.Вставить(ДО.Номер, Параметры.ИнфоКВМ);		
		Если ДО.Модифицированность() Тогда
			Попытка
				ДО.Записать();	
			Исключение
				Сообщить("Не удалось записать оплату номер: " + ДО.Номер + ". " + ОписаниеОшибки());	
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьДельтыКВ(РезультатЗапроса) Экспорт 
	
	СоотвИнфоКВМ = Новый Соответствие;			
	ВыборкаОплат = РезультатЗапроса.Выбрать();
	//ИндикаторИнициализировать(ВыборкаОПлат.Количество());
	//ДанныеПоЗПМенеджерам = уб_РасчетыСМенеджерами.РасчетЗП_Быстро(ЗарплатныйПериод);
	Пока ВыборкаОПлат.Следующий() Цикл
		#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			Состояние ("Пересчет АВ");
		#КонецЕсли
		_СуммаФикс = 0;
		_ВычетСАгента = 0;
		
		ДО = ВыборкаОплат.Ссылка.ПолучитьОбъект(); 
		
		
		Источник = уб_РасчетыСМенеджерами.ПолучитьИсточникЗаявки(ДО.СтраховойПолис);
		Если ЗначениеЗаполнено(Источник) и ДО.Агент<>Источник Тогда
			
			_ВидСп = ДО.ВидСП;
			//Вариант 1
			Если _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКОПП Тогда
				_ВычетСАгента = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетПоИсточникуКАСКО",Источник,ДО.ЗарплатныйПериод,0);
			ИначеЕсли _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО Тогда
				_ВычетСАгента = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетПоИсточникуОСАГО",Источник,ДО.ЗарплатныйПериод,0);	
			Иначе
				//Если вычет установлен руками, он должен быть заблокирован "ПроверенаЗП", иначе вычет обнулится
				_ВычетСАгента = 0;
			КонецЕсли;	
			//УстЗнч(ОП, "ВычетСАгента", _ВычетСАгента, РасчетныеПоля.бЗаблокирована);
			
			//Вариант 2
			Если _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО
				или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО
				или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКОПП
				Тогда
				_СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетСКВПоИсточникуКАСКО",Источник,ДО.ЗарплатныйПериод,-1);
			ИначеЕсли _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО
				или _ВидСп = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО
				Тогда
				_СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ВычетСКВПоИсточникуОСАГО",Источник,ДО.ЗарплатныйПериод,-1);
			Иначе
				_СуммаФикс = 0;
			КонецЕсли;
			//Вариант 3
			Если _СуммаФикс = 0 Тогда
				_СуммаФикс = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("СуммаФикс",ДО.Агент,ДО.ЗарплатныйПериод,-1);
			КонецЕсли;	
		КонецЕсли;	
		Если _СуммаФикс>0 или _ВычетСАгента>0 Тогда
			//прочие сложные расчеты здесь не трогаем
		Иначе
			
			тзДельта = уб_СтраховойБрокер.ПолучитьДельтуКВ(
			ДатаНачала, 
			Перечисления.уб_НазначенияКВ.ДляМенеджера,
			ДО.Подразделение.Владелец,
			ДО.Подразделение,
			ДО.Агент, 
			ДО.Поставщик, 
			ДО.ОрганизацияАгент, 
			ДО.СК, 
			ДО.ВидСП, 
			ДО.СтраховойПродукт 
			);
			
			//Если ДО.ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ
			//и НЕ (ДО.ВидС = Перечисления.уб_ВидыСтрахования.ВЗР
			//ИЛИ ДО.ВидС = Перечисления.уб_ВидыСтрахования.Ипотека)
			//и ДО.ЗарплатныйПериод>=Дата(2026,1,1)	 
			//и ДО.ФормаОплаты     = Перечисления.уб_ФормыОплаты.Поставщику
			//Тогда
			//	Дельта = 9;
			//Иначе	
				Дельта = 6; //Для данного значения Дельта значение АВ везде будет равно 0
				Если тзДельта.Количество() > 0 Тогда
					Дельта = тзДельта[0].Дельта;
				КонецЕсли;	

			//КонецЕсли;	
						
			ТекДельта = ДО.КВПроцент-ДО.КВПроцентДляАгента;
			Если ТекДельта >= Дельта Тогда
			Иначе
				Если ДО.КВПроцент>Дельта Тогда
					_КВПроцентДляАгента = ДО.КВПроцент-Дельта;
				Иначе
					_КВПроцентДляАгента = 0;
				КонецЕсли;	
				_КВСуммаДляАгента    = ОКР(До.НачисленнаяСуммаВзноса*_КВПроцентДляАгента/100,2);
				
				_АВилиСкидкаСумма = ДО.НачисленнаяСуммаВзноса-ДО.ОплаченоФакт;
				
				Если _АВилиСкидкаСумма> _КВСуммаДляАгента Тогда
					//_КВПроцентДляАгента  = _КВПроцентДляАгента;
					//_КВСуммаДляАгента = _КВСуммаДляАгента;
					//до.АВилиСкидкаСумма	2 503.74	Число
					_СкидкаВыплаченаяКлиенту = _КВСуммаДляАгента-_АВилиСкидкаСумма;
					_АВилиСкидкаСумма = _КВСуммаДляАгента;					
				Иначе	
					_АВилиСкидкаСумма = Макс(_АВилиСкидкаСумма,_КВСуммаДляАгента);
					_СкидкаВыплаченаяКлиенту =_АВилиСкидкаСумма;
				КонецЕсли;	
				
				_АВилиСкидкаПроцент = Окр(?(ДО.НачисленнаяСуммаВзноса=0,100,_АВилиСкидкаСумма*100/ДО.НачисленнаяСуммаВзноса),2); 
					
				//Если  (_КВПроцентДляАгента <> ДО.КВПроцентДляАгента Или _АВилиСкидкаСумма<> ДО.АВилиСкидкаСумма )и  ДО.ПроверенаЗП = Ложь Тогда
				Если  (_КВПроцентДляАгента <> ДО.КВПроцентДляАгента Или _АВилиСкидкаСумма<> ДО.АВилиСкидкаСумма )и  ДО.НеМенятьАВ = Ложь Тогда
					ДО.КВПроцентДляАгента  = _КВПроцентДляАгента;
					ДО.КВСуммаДляАгента    = _КВСуммаДляАгента;//ОКР(До.НачисленнаяСуммаВзноса*ДО.КВПроцентДляАгента/100,2);
					ДО.АВилиСкидкаПроцент  = _АВилиСкидкаПроцент;
					ДО.АВилиСкидкаСумма  = _АВилиСкидкаСумма;
					ДО.ВМРасчетное      = ДО.КВСуммаДляАгента;
					ДО.ДБ                  = ДО.КВСумма - ДО.АВилиСкидкаСумма;// + ДО.ВычетСАгента;
					ДО.СкидкаВыплаченаяКлиенту = _СкидкаВыплаченаяКлиенту;
					//Параметры = уб_РасчетыСМенеджерами.СтруктураПараметровОППересчетСуммПоУмолчанию();
					////	Параметры.ДанныеПоЗПМенеджерам = ДанныеПоЗПМенеджерам;
					//уб_РасчетыСМенеджерами.ОП_ПересчетСумм(ДО,,, Параметры);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	
		//Параметры = уб_РасчетыСМенеджерами.СтруктураПараметровОППересчетСуммПоУмолчанию();
		//Параметры.ДанныеПоЗПМенеджерам = ДанныеПоЗПМенеджерам;
		//уб_РасчетыСМенеджерами.ОП_ПересчетСумм(ДО,,, Параметры);
		//ИнфоКВМ = Параметры.ИнфоКВМ;
		//СоотвИнфоКВМ.Вставить(ДО.Номер, Параметры.ИнфоКВМ);		
		Если ДО.Модифицированность() Тогда
			Попытка
				ДО.Записать();	
			Исключение
				Сообщить("Не удалось записать оплату номер: " + ДО.Номер + ". " + ОписаниеОшибки());	
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

