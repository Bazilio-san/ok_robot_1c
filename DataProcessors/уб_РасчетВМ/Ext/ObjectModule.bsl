Функция УстановитьПараметрыОбласти_Вознаграждение(Параметры,Выборка,ИмяОбщейЗП="ИтогоЗПОрг",УстановитьОбщееЗП = Ложь)
	
	Попытка 
		//Параметры.Кол			   = Выборка.ЕД;	
		Параметры.ВМ			   = Формат(Выборка.ВознаграждениеМенеджера,ЧФ);
		Параметры.ВычетСАгента	   = Формат(?(Выборка.ВычетСАгента = Null, 0, -Выборка.ВычетСАгента),ЧФ);
		ЗПОбщее = ?(Выборка[ИмяОбщейЗП] = Null, 0, Выборка[ИмяОбщейЗП]) //ВМ по СКВ
		+ ?(Выборка.ВознаграждениеМенеджера = Null, 0, Выборка.ВознаграждениеМенеджера) //ВМ в оплатах
		- ?(Выборка.ВычетСАгента = Null, 0, Выборка.ВычетСАгента)     //вычеты  
		+ ?(Выборка.Бонус_КС = Null, 0, Выборка.Бонус_КС)             //Крупные сделки
		+ ?(Выборка.ВМПоИнтервалам = Null, 0,Выборка.ВМПоИнтервалам); //По интервалам
		Если УстановитьОбщееЗП Тогда
			//Параметры.ОбщееЗП		= Формат(ЗПОбщее,ЧФ0);
			Параметры.ИтогоЗП       = Формат(Выборка[ИмяОбщейЗП],ЧФ000);
		КонецЕсли;	
		Параметры.ПроцентРуководителя = Выборка.ВознаграждениеРуководителя;
		Возврат ЗПОбщее;
	Исключение
		//Сообщить(ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
КонецФункции
Функция УстановитьПараметрыОбласти_Взносы(Параметры,Выборка,ИмяОбщейЗП="ИтогоЗПОрг",УстановитьОбщееЗП = Ложь)
	
	Попытка 
		Параметры.СуммаВзносов	   = Формат(Выборка.НачисленнаяСуммаВзноса,ЧФ000);
		//Параметры.СобранаяКВ	   = Формат(Выборка.СКВ,ЧФ000);
		Попытка
			Если Выборка.КоличествоФакт = 0 Тогда
				Параметры.КоличествоФакт = "";
			Иначе
				Параметры.КоличествоФакт = Формат(Выборка.КоличествоФакт,ЧФ000);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Параметры.ОбщаяСуммаСкидок = Формат(Выборка.АВилиСкидкаСумма,ЧФ000);
		
		Если Выборка.НачисленнаяСуммаВзноса <> 0 И (Выборка.АВилиСкидкаСумма <> Null ИЛИ Выборка.НачисленнаяСуммаВзноса <> Null) Тогда
			Параметры.СредПроцСкидки		= Формат(Выборка.АВилиСкидкаСумма*100/Выборка.НачисленнаяСуммаВзноса,ЧФ000);
		КонецЕсли;
		Параметры.СуммаОплаченоФакт	= Формат(Выборка.ОплаченоФакт,ЧФ000);
		
		Если НЕ СкрыватьКолонкиДСП Тогда
			Если Выборка.НачисленнаяСуммаВзноса <> 0 И (Выборка.КВСуммаДляАгента <> Null ИЛИ Выборка.НачисленнаяСуммаВзноса <> Null) Тогда
				Параметры.СредПроцКВ			= Формат(Выборка.КВСуммаДляАгента*100/Выборка.НачисленнаяСуммаВзноса,ЧФ000);
			КонецЕсли;
			Параметры.ОбщаяСуммаКВ		= Формат(Выборка.КВСуммаДляАгента,ЧФ000)
		КонецЕсли;		
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция УстановитьПараметрыОбласти(Параметры,Выборка,ИмяОбщейЗП="ИтогоЗПОрг",УстановитьОбщееЗП = Ложь)
	
	Попытка 
		Параметры.Кол			   = Выборка.ЕД;	
		Параметры.ВМ			   = Формат(Выборка.ВознаграждениеМенеджера,ЧФ);
		Параметры.ВычетСАгента	   = Формат(?(Выборка.ВычетСАгента = Null, 0, -Выборка.ВычетСАгента),ЧФ);
		Параметры.СуммаВзносов	   = Формат(Выборка.НачисленнаяСуммаВзноса,ЧФ000);
		Параметры.СобранаяКВ	   = Формат(Выборка.СКВ,ЧФ000);
		Попытка
			Если Выборка.КоличествоФакт = 0 Тогда
				Параметры.КоличествоФакт = "";
			Иначе
				Параметры.КоличествоФакт = Формат(Выборка.КоличествоФакт,ЧФ000);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Параметры.ОбщаяСуммаСкидок = Формат(Выборка.АВилиСкидкаСумма,ЧФ000);
		
		Если Выборка.НачисленнаяСуммаВзноса <> 0 И (Выборка.АВилиСкидкаСумма <> Null ИЛИ Выборка.НачисленнаяСуммаВзноса <> Null) Тогда
			Параметры.СредПроцСкидки		= Формат(Выборка.АВилиСкидкаСумма*100/Выборка.НачисленнаяСуммаВзноса,ЧФ000);
		КонецЕсли;
		Параметры.СуммаОплаченоФакт	= Формат(Выборка.ОплаченоФакт,ЧФ000);
		
		ЗПОбщее = ?(Выборка[ИмяОбщейЗП] = Null, 0, Выборка[ИмяОбщейЗП]) 
		+ ?(Выборка.ВознаграждениеМенеджера = Null, 0, Выборка.ВознаграждениеМенеджера) 
		- ?(Выборка.ВычетСАгента = Null, 0, Выборка.ВычетСАгента)+ ?(Выборка.Бонус_КС = Null, 0, Выборка.Бонус_КС); 
		Если УстановитьОбщееЗП Тогда
			Параметры.ОбщееЗП		= Формат(ЗПОбщее,ЧФ0);
			Параметры.ИтогоЗП       = Формат(Выборка[ИмяОбщейЗП],ЧФ000);
		КонецЕсли;	
		Если НЕ СкрыватьКолонкиДСП Тогда
			Если Выборка.НачисленнаяСуммаВзноса <> 0 И (Выборка.КВСуммаДляАгента <> Null ИЛИ Выборка.НачисленнаяСуммаВзноса <> Null) Тогда
				Параметры.СредПроцКВ			= Формат(Выборка.КВСуммаДляАгента*100/Выборка.НачисленнаяСуммаВзноса,ЧФ000);
			КонецЕсли;
			Параметры.ОбщаяСуммаКВ		= Формат(Выборка.КВСуммаДляАгента,ЧФ000)
		КонецЕсли;		
		
		Возврат ЗПОбщее;
	Исключение
		//Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Процедура ДобавитьПустышку(ТЗ1,Стр,СхемаРасчета=Неопределено)
	Пустышки = ТЗ1.НайтиСтроки(Новый Структура("Агент,Подразделение,Пустышка",Стр.Агент,Стр.Подразделение,Истина)).Количество();
	Если Пустышки = 1 Тогда
		Возврат;
	ИначеЕсли Пустышки > 1 Тогда
		Сообщить("Сообщить количество пустых записей по агенту "+Пустышки+ " Это может вызвать задвоение");
	КонецЕсли;	
		
			НовОплата					= ТЗ1.Добавить();
			НовОплата.Агент 			= Стр.Агент;		
			НовОплата.Подразделение		= Стр.Подразделение;
			НовОплата.Организация 		= Стр.Подразделение.Владелец;
			НовОплата.Пустышка			= Истина;
			Если Стр.ЕстьПланПоСКВ=Истина Тогда
				
			Иначе	
				тз = уб_СтраховойБрокер.ПолучитьПланПоСКВ(НачалоДня(КонецМесяца(ЗарплатныйПериод)), , Стр.Подразделение, Стр.Агент);
				Если тз.Количество() > 0 Тогда
					Стр.План = тз[0].План;
					Если Стр.План = 0 Тогда
						Стр.Количество = 0;
					Иначе
						Стр.Количество = тз[0].Количество;
					КонецЕсли;
				Иначе
					Сообщить("ВНИМАНИЕ! Не найдено значение плана по СКВ для Агента " + Строка(Стр.Агент) + " на дату " + Строка(НачалоДня(КонецМесяца(ЗарплатныйПериод))) + " (Подразделение: " + Строка(Стр.Подразделение) + ")" );
				КонецЕсли;
				
			КонецЕсли;
			Если СхемаРасчета=Неопределено Тогда
				Если Стр.ЕстьПланПоСКВ=Истина Тогда
					СхемаРасчета = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ;
				Иначе	
					тз = уб_СтраховойБрокер.ПолучитьСхемуРасчетаСМенеджером(НачалоДня(КонецМесяца(ЗарплатныйПериод)), Стр.Подразделение.Владелец, Стр.Подразделение, Стр.Агент);
					Если тз.Количество() > 0 Тогда
						СхемаРасчета = тз[0].СхемаРасчета;
					Иначе
						СхемаРасчета = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.БезРасчета;
						Сообщить("Ошибка при получении вида расчета с менеджером."+Стр.Агент,СтатусСообщения.ОченьВажное);
						//Возврат  ВознаграждениеМенеджера;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			НовОплата.СхемаРасчетаСМенеджером = СхемаРасчета;
			
			НовОплата.УАгентаПланПоСКВ	= СхемаРасчета = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ;
			
			Стр.УАгентаПланПоСКВ		= НовОплата.УАгентаПланПоСКВ;
			НовОплата.СКВ = 0;
			НовОплата.КоличествоФакт = 0;
			НовОплата.КоэффициентВида = 0;
			НовОплата.НовыйКлиент = 0;
			НовОплата.НовыйКлиентСКВ = 0;
			
			
			НовОплата.ОплаченоФакт = 0;
			НовОплата.НачисленнаяСуммаВзноса = 0;
