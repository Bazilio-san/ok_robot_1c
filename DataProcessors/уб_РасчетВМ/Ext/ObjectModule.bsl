		//тзАгентовДляРаскраски.Колонки.Добавить("РаскраситьПлан",Новый ОписаниеТипов("Булево"));
		//тзАгентовДляРаскраски.Колонки.Добавить("РаскраситьКоличественныйПлан",Новый ОписаниеТипов("Булево"));
		//_тзАгентовДляРаскраски = Новый ТаблицаЗначений;
		//_тзАгентовДляРаскраски.Колонки.Добавить("Менеджер", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
