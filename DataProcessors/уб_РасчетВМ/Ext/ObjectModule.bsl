		|ИЗ
		|	Документ.уб_ОплатаПолисов.РасчетыПоДокументу КАК уб_ОплатаПолисовРасчетыПоДокументу
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОплатыМесяца КАК ОплатыМесяца
		|		ПО уб_ОплатаПолисовРасчетыПоДокументу.Ссылка = ОплатыМесяца.Оплата
		|ГДЕ
		|	уб_ОплатаПолисовРасчетыПоДокументу.Вид = ЗНАЧЕНИЕ(Справочник.уб_ВидыРасчетныхОпераций.НачислениеСКВ)
		|	И уб_ОплатаПолисовРасчетыПоДокументу.ВремяРегистрации <= &ДатаСреза
		|	И уб_ОплатаПолисовРасчетыПоДокументу.СуммаМенеджер <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	уб_ОплатаПолисовРасчетыПоДокументу.Ссылка";
		#Если Клиент Тогда
			Состояние(стрСостояние+". Этап: " + Этап + " из " + КоличествоЭтапов + " - Запрос по оплатам из истории");
		#КонецЕсли
		Пакет = ЗапросПоОплатамИзИстории.ВыполнитьПакет();		
		//СписокОплатИзИстории = Пакет[1].Выгрузить().ВыгрузитьКолонку("Оплата");
		ВыборкаОплат = Пакет[2].Выбрать();		
		ТЗ1	= Пакет[3].Выгрузить();//ТЗ1 = СоздатьТаблицу();
		ТЗ1.Колонки.Добавить("СКВ_Прол", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_НБ", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП_Прол", ОписаниеТипаЧисло14_2_но);
		ТЗ1.Колонки.Добавить("СКВ_БП_НБ", ОписаниеТипаЧисло14_2_но);
		
		ТЗ1.Очистить();		
		ВыборкаИсторияРеквизитовОплат = Пакет[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
		ВыборкаСтраховыхПолисов = Пакет[7].Выбрать();		
		ВыборкаНачисленияСКВ = Пакет[8].Выбрать();		
		//ВсегоМассив = СписокОплатИзИстории.Количество();
		ВсегоМассив = ВыборкаОплат.Количество();		
		СпПометкаУдаления = Ложь;
		Этап = Этап + 1;
		СчетчикОплат = 0;
		//Для СчетчикОплат = 0 по ВсегоМассив - 1 Цикл
		Пока ВыборкаОплат.Следующий() Цикл
			#Если Клиент Тогда
				Состояние(стрСостояние+". Этап: " + Этап + " из " + КоличествоЭтапов + " (" + Окр(100*СчетчикОплат/ВсегоМассив,2) + ") - Расчет показателей СКВ из истории");
			#КонецЕсли
			//Оплата = СписокОплатИзИстории[СчетчикОплат];
			Оплата = ВыборкаОплат.Оплата;
			СчетчикОплат = СчетчикОплат + 1;
			#Если Клиент Тогда
				ОбработкаПрерыванияПользователя();
			#КонецЕсли
			/////////////////////////////////////////////////////////////////////////////////////////////
			//!!! Добавить проверку на удаленные оплаты, подменять некоторые реквизиты или менять представление
			/////////////////////////////////////////////////////////////////////////////////////////////
			Стр = ТЗ1.Добавить();
			Стр.Ссылка = Оплата;//.Ссылка
			Стр.ЕД = 1;
			Стр.ЭтоКрупнаяСделка = Ложь;
			Попытка
				Стр.ЭтоПролонгация   = ВыборкаОплат.ЭтоПролонгация;
			Исключение
				Стр.ЭтоПролонгация = Ложь;
			КонецПопытки;	
			Стр.КоличествоФакт = ВыборкаОплат.КоличествоФакт;			
			Стр.НеОплачиватьКС = ВыборкаОплат.НеОплачиватьКС;
			Стр.КоэффициентВида = ВыборкаОплат.КоэффициентВида;
			Стр.НовыйКлиент = ВыборкаОплат.НовыйКлиент;
			Стр.СуммаДБ = 0;
			//СтруктураИзменений = уб_ИсторияИзмененияОбъектов.ПолучитьДанныеОбъектаНаДату(Стр.Ссылка,ДатаСреза);//!!!Сделать: объединить в один пакет			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ОбъектИстории", Оплата);
			СтруктураИзменений = Новый Структура;
			ВыборкаИсторияРеквизитовОплат.Сбросить();
			Если ВыборкаИсторияРеквизитовОплат.НайтиСледующий(СтруктураПоиска) Тогда
				ДетальныеЗаписи = ВыборкаИсторияРеквизитовОплат.Выбрать();
				
				Пока ДетальныеЗаписи.Следующий() Цикл
					СтруктураИзменений.Вставить(ДетальныеЗаписи.НаименованиеРеквизита, ДетальныеЗаписи.ЗначениеРеквизита);
				КонецЦикла;
			КонецЕсли;		
			флПересчитанСКВ = Ложь;
			Для Каждого ЭлементСтруктуры из СтруктураИзменений Цикл
				КлючЭл = ЭлементСтруктуры.Ключ;
				ЗначениеЭл = ЭлементСтруктуры.Значение;
				
				Попытка
					Стр[КлючЭл]= ЗначениеЭл;
				Исключение
					Если РежимОтладки Тогда
						Сообщить("Ошибка заполнения строки из истории (" + Оплата + " / " + КлючЭл + ")");
					КонецЕсли;	
					продолжить;
				КонецПопытки;
				Если КлючЭл = "СтраховойПолис" Тогда
					Если ЗначениеЗаполнено (ЗначениеЭл) Тогда
						
						СтруктураПоиска = Новый Структура;
						СтруктураПоиска.Вставить("СтраховойПолис", ЗначениеЭл);
						
						ВыборкаСтраховыхПолисов.Сбросить();
						
						Если ВыборкаСтраховыхПолисов.НайтиСледующий(СтруктураПоиска) Тогда
							ЗначениеЭл = ВыборкаСтраховыхПолисов;
							Стр.СП_СтраховойПродукт = ЗначениеЭл.СтраховойПродукт;
							Если ТипЗнч(ЗначениеЭл.СтраховойПродукт) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
								Стр.СП_ВидСП = ЗначениеЭл.Вид;
							Иначе
								Стр.СП_ВидСП = ЗначениеЭл.СтраховойПродукт;
							КонецЕсли;	
							Стр.СП_СК = ЗначениеЭл.СК;//Не используется и тормозит
							Стр.Страхователь = ЗначениеЭл.Страхователь;
							Стр.ДатаПолиса = ЗначениеЭл.Дата;
							Стр.НомерПолиса = ЗначениеЭл.Номер;
							Стр.НомерЗаявки = ЗначениеЭл.НомерЗаявки;
							Стр.БонусМенеджеру = ЗначениеЭл.БонусМенеджеру;
							Стр.ПолнаяПремия = ЗначениеЭл.СтраховаяПремия;
							//Если ЭтоВариант20121001 Тогда
							Стр.Сделка = ЗначениеЭл.Сделка;
							Стр.ДатаСделки = ЗначениеЭл.ДатаСделки;
							Стр.БонусПроцент = ЗначениеЭл.БонусПроцент;
							Стр.БонусПроцентРОП = ЗначениеЭл.БонусПроцентРОП;
							//КонецЕсли;	
							
							СпПометкаУдаления = ЗначениеЭл.ПометкаУдаления;
						Конецесли;
					КонецЕсли;	
				ИначеЕсли КлючЭл ="Подразделение" Тогда	
					Стр.Организация = СоотОрганизацийПодразделениям.Получить(ЗначениеЭл);
				ИначеЕсли КлючЭл ="ОплаченоФакт" 
					Или КлючЭл ="НачисленнаяСуммаВзноса" 
					Или КлючЭл ="СкидкаВыплаченаяКлиенту" 
					Или КлючЭл ="ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику" 
					Или КлючЭл ="КВСумма" Тогда		
					
					Если флПересчитанСКВ Тогда
						Продолжить;
					КонецЕсли;  
					Если ЭтоВариант20151001 Тогда
						ВыборкаНачисленияСКВ.Сбросить();
						Если ВыборкаНачисленияСКВ.НайтиСледующий(Новый Структура("Ссылка",Оплата)) Тогда
							Стр.СКВ = ВыборкаНачисленияСКВ.СуммаСКВ;
							флПересчитанСКВ = Истина;
							Продолжить;
						Иначе
							//не найден посчитанный СКВ, посчитаем по старому	
						КонецЕсли;	
					Иначе
						
					КонецЕсли;
					
						
					Если СтруктураИзменений.Свойство("ОплаченоФакт") Тогда
						ОплаченоФакт = СтруктураИзменений.ОплаченоФакт;
						Стр.ОплаченоФакт = ОплаченоФакт;
					Иначе
						ОплаченоФакт = Стр.ОплаченоФакт;
					КонецЕсли;	  
					
					Если СтруктураИзменений.Свойство("НачисленнаяСуммаВзноса") Тогда
						НачисленнаяСуммаВзноса = СтруктураИзменений.НачисленнаяСуммаВзноса;
						Стр.НачисленнаяСуммаВзноса = НачисленнаяСуммаВзноса;
					Иначе
						НачисленнаяСуммаВзноса = Стр.НачисленнаяСуммаВзноса;
					КонецЕсли;
					Если СтруктураИзменений.Свойство("ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику") Тогда
						ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = СтруктураИзменений.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
						Стр.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
					Иначе
						ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику = Стр.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику;
					КонецЕсли;
					
					Если СтруктураИзменений.Свойство("СкидкаВыплаченаяКлиенту") Тогда
						СкидкаВыплаченаяКлиенту = СтруктураИзменений.СкидкаВыплаченаяКлиенту;
						Стр.СкидкаВыплаченаяКлиенту = СкидкаВыплаченаяКлиенту;
					Иначе
						СкидкаВыплаченаяКлиенту = Стр.СкидкаВыплаченаяКлиенту;
					КонецЕсли;
					Если ЭтоВариант20130301 ИЛИ ДатаСреза > Дата(2013,10,7) Тогда
						Если СтруктураИзменений.Свойство("КВСуммаДляАгента") Тогда
							Попытка
								КВСумма = Число(СтруктураИзменений.КВСуммаДляАгента);
							Исключение
								КВСумма = 0;
							КонецПопытки;
							Стр.КВСумма = КВСумма;
							Стр.КВСуммаДляАгента = КВСумма;
						Иначе
							КВСумма = Стр.КВСуммаДляАгента;
						КонецЕсли;
					Иначе	
						Если СтруктураИзменений.Свойство("КВСумма") Тогда
							КВСумма = СтруктураИзменений.КВСумма;
							Стр.КВСумма = КВСумма;
							Стр.КВСуммаДляАгента = КВСумма;
						Иначе
							КВСумма = Стр.КВСумма;
						КонецЕсли;
					КонецЕсли;
					Если (ОплаченоФакт - СкидкаВыплаченаяКлиенту ) < ?(НачисленнаяСуммаВзноса=0,ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,НачисленнаяСуммаВзноса)-КВСумма ТОГДА  
						СКВ = 0;
					Иначе	  
						СКВ = ОплаченоФакт - ?(НачисленнаяСуммаВзноса=0,ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,НачисленнаяСуммаВзноса) - СкидкаВыплаченаяКлиенту + КВСумма;
					КонецЕсли; 
					Стр.СКВ = СКВ;
					флПересчитанСКВ = Истина;
				КонецЕсли;	
			КонецЦикла;	
			
			СтраховойПолис = Стр.СтраховойПолис;
			/////////////////////////////////////////////////////////////////////////////////////////////
			//!!! Добавить проверку на получение полиса из истории?
			/////////////////////////////////////////////////////////////////////////////////////////////
			//Если ФильтрПоМенеджеру И Стр.Агент<>Менеджер Тогда
			////	//
			//	ТЗ1.Удалить(Стр);
			//Иначе
			Если ФильтрПоПодразделению И Стр.Подразделение <> Подразделение Тогда
				////	//
				ТЗ1.Удалить(Стр);
			ИначеЕсли (НЕ ОтображатьОплатыИсключенныеИзРасчетаЗП) И Стр.ИсключитьИзРасчетаЗП Тогда
				ТЗ1.Удалить(Стр);
			ИначеЕсли  СтраховойПолис = ПустойПолис Тогда
