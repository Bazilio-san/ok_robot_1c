				ОблОрг.Параметры.КоличествоПлан		= "";
			Иначе
				ОблОрг.Параметры.КоличествоПлан		= Формат(ВыборкаОрг.СуммаКоличествоПланОрг,ЧФ000);
			КонецЕсли;
			ОблОрг.Параметры.ПроцентПлана			= Формат(?(ВыборкаОрг.СуммаПланаОрг=0,0,ВыборкаОрг.СКВ/ВыборкаОрг.СуммаПланаОрг*100),ЧФ0);
			
			ОблОрг_Вознаграждение.Параметры.ПроцентРуководителя	= Формат(ВыборкаОрг.СуммаВознаграждения_РОПОрг,ЧФ000);
			
