		НовСтрока.Подразделение				= Выборка.Ссылка;
		НовСтрока.НаименованиеПодразделения	= Выборка.Наименование + ?(ЗначениеНеЗаполнено(Руководитель),""," (" + Руководитель.Наименование + ")");
		НовСтрока.Руководитель				= Руководитель;
		НовСтрока.РуководительПолучаетВознаграждение = МЗ.ПолучаетВознаграждениеЗаРуководство;
		НовСтрока.ЗамПолучаетВознаграждение = ЗамПолучаетВознаграждение;
		Если тз.Количество() = 0 ИЛИ тз[0].СхемаВознагражденияРуководителяОП = ПрчСхемаВР.БезВознаграждения Тогда
			НовСтрока.СхемаВознагражденияРуководителяОП			= ПрчСхемаВР.БезВознаграждения;
			НовСтрока.ПроцентнаяСтавкаДоМинимальногоПорога_РОП	= 0;
			НовСтрока.ПоказательМинимальногоПорога_РОП			= 0;
			НовСтрока.ПроцентнаяСтавкаДоПлана_РОП				= 0;
			НовСтрока.ПоказательПлана_РОП						= 0;
			НовСтрока.ПроцентнаяСтавкаПослеПлана_РОП			= 0;
			НовСтрока.ПроцентКС_РОП  = 0 ;
		Иначе	
			Схема = тз[0];
			НовСтрока.СхемаВознагражденияРуководителяОП			= Схема.СхемаВознагражденияРуководителяОП;
			НовСтрока.ПроцентнаяСтавкаДоМинимальногоПорога_РОП	= Схема.ПроцентнаяСтавкаДоМинимальногоПорога;
			НовСтрока.ПоказательМинимальногоПорога_РОП			= Схема.ПоказательМинимальногоПорога;
			НовСтрока.ПроцентнаяСтавкаДоПлана_РОП				= Схема.ПроцентнаяСтавкаДоПлана;
			НовСтрока.ПоказательПлана_РОП						= Схема.ПоказательПлана;
			НовСтрока.ПроцентнаяСтавкаПослеПлана_РОП			= Схема.ПроцентнаяСтавкаПослеПлана;			
			НовСтрока.ПроцентКС_РОП                             = Схема.ПроцентКС_РОП;
			//Добавляем подразделение в список для последующей выборки агентов, работающих по схеме ПланПоСКВ
			//Только для случая, когда руководитель получает процент от СКВ необходимо будет собрать в писок
			//всех агентов подразделения, что бы посчитать суммарный план подразделения			
			//В остальных случаях в список агентов подразделения (в отчете) попадут только те агенты, у которых есть оплаты		
			//Так же исключаем случай, когда отчет фильтруется по конкретному менеджеру
			Если //НЕ ФильтрПоМенеджеру И 
				Схема.СхемаВознагражденияРуководителяОП = ПрчСхемаВР.ПроцентОтСКВ Тогда
				СписокПодразделенийДляВыборки.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;                                                         
		НовСтрока.ЕстьОплатыПоПодразделению = НЕ бНетОплатПоПодразделению;
	КонецЦикла;
	//##добавляем подразделения, где были оплаты в тзПодразделений
	Для каждого Стр Из тзПодразделенийСОплатами Цикл		
		Если тзПодразделений.Найти(Стр.Подразделение,"Подразделение")=Неопределено Тогда
			НовСтрока = тзПодразделений.Добавить();	
			НовСтрока.Подразделение	= Стр.Подразделение;
		КонецЕсли;			
	КонецЦикла; 	
	//Формируем список всех агентов, которые в течение зарплатного периода присутствовали в выбранных подразделениях
	//Если будут найдены агенты, которые не попали в главную выборку оплат (по пичине отсутствия у них оплат в этом периоде)
	//то эти агенты будут добавлены в список	
	//Запрос на получение списка сотрудников, работающих в подразделении в период отчета
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	А.Агент,
	|	А.Подразделение,
	|	А.Период,
	|	А.Организация
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&ДатаНач, ) КАК А
	|ГДЕ
	|	А.Подразделение В(&Подразделения)
	|	И (НЕ А.Выбытие)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	А.Агент,
	|	А.Подразделение,
	|	А.Период,
	|	А.Организация
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям КАК А
	|ГДЕ
	|	А.Подразделение В(&Подразделения)
	|	И (НЕ А.Выбытие)
	|	И А.Период МЕЖДУ &ДатаНач И &ДатаКон";
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКонца);	
	Запрос.УстановитьПараметр("Подразделения", СписокПодразделенийДляВыборки);	
	ВыборкаАгентов = Запрос.Выполнить().Выбрать();
	
	//Подготавливаем ТЗАгентов для сравнения дублирующихся записей
	//Возможны случаи, когда агент переходил из подразделения в подразделение в течение месяца
	//Тогда подразделением Агента считается подразделение, в котором он числился позже всего
	
	//Не рассматриваем работу агента в разных подразделениях в течении месяца 
	//По причине того, что придется пропорционально времени работы в подразделениях делить план (в случае работы по схеме план)
	//Учет ведем по последнему подразделению, в котором работал сотрудник в отчетном периоде (даже если он работал всего один последний день)
	
	ТЗАгентов.Колонки.Добавить("ДатаПоступленияВПодразделение",ОписаниеТипаДата);
	
	Пока ВыборкаАгентов.Следующий() Цикл
		НайденныйАгент	= ТЗАгентов.НайтиСтроки(Новый Структура("Агент",ВыборкаАгентов.Агент)); 
		Если НайденныйАгент.Количество()=0 Тогда
			//Добавляем нового агента
			НовАгент								= ТЗАгентов.Добавить();
			НовАгент.Агент							= ВыборкаАгентов.Агент;
			НовАгент.Подразделение					= ВыборкаАгентов.Подразделение.Ссылка;
			НовАгент.ДатаПоступленияВПодразделение	= ВыборкаАгентов.Период;
			НовАгент.ВознаграждениеМенеджера 		= 0;
			НовАгент.ВознаграждениеДоп = 0;
			НовАгент.ПартнерскоеВознаграждение      = 0;
			НовАгент.ВычетСАгента					= 0;
		Иначе
			НайденныйАгент = НайденныйАгент[0];
			Если НайденныйАгент.Подразделение <> ВыборкаАгентов.Подразделение 
				И НайденныйАгент.ДатаПоступленияВПодразделение < ВыборкаАгентов.Период Тогда
				НайденныйАгент.Подразделение = ВыборкаАгентов.Подразделение.Ссылка;
				НайденныйАгент.ДатаПоступленияВПодразделение = ВыборкаАгентов.Период;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//Теперь выберем всех агентов, у которых встречаются оплаты по схеме "ПланПоСКВ"
	СтруктураОтбора				= Новый Структура("СхемаРасчетаСМенеджером",ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ);
	ТЗАгентовПоСхемеПланПоСКВ	= ТЗ1.Скопировать(СтруктураОтбора, "Агент,СхемаРасчетаСМенеджером");
	ТЗАгентовПоСхемеПланПоСКВ.Свернуть("Агент,СхемаРасчетаСМенеджером");
	//Для таких агентов заполним параметры Плана и СуперПлана
	Кол = ТЗАгентов.Колонки;
	Кол.Добавить("План",							ОписаниеТипаЧисло14_2_но);
	Кол.Добавить("ШтрафнойПлан",							ОписаниеТипаЧисло14_2_но);
	Кол.Добавить("Количество",						ОписаниеТипаЧисло12_0);
	Кол.Добавить("СуперПлан",						ОписаниеТипаЧисло14_2_но);
	Кол.Добавить("ПерваяБонусПланка",				ОписаниеТипаЧисло14_2_но);//2012
	Кол.Добавить("ПроцентнаяСтавкаДоПлана",			ОписаниеТипаПроцент);
	Кол.Добавить("ПроцентнаяСтавкаПослеПлана",		ОписаниеТипаПроцент);
	Кол.Добавить("ПроцентнаяСтавкаПослеПервойБонусПланки",	ОписаниеТипаПроцент);//201212
	Кол.Добавить("ПроцентнаяСтавкаПослеСуперПлана",	        ОписаниеТипаПроцент);
	
	Кол.Добавить("ПроцентнаяСтавкаПролонгация",			ОписаниеТипаПроцент);
	Кол.Добавить("ПроцентнаяСтавкаПролонгацияДоПлана",		ОписаниеТипаПроцент);
	
	
	Кол.Добавить("ЕстьПланПоСКВ",					ОписаниеТипаБулево);
	Кол.Добавить("ЭтотАгентЕстьВТЗ1",				ОписаниеТипаБулево);
	Кол.Добавить("УАгентаПланПоСКВ",				ОписаниеТипаБулево);
	Кол.Добавить("ВыполненПланПоСКВ",				ОписаниеТипаБулево);
	//Итоги СКВ по КС
	Кол.Добавить("СКВ_КС",							ОписаниеТипаЧисло14_2_но);
	Кол.Добавить("СКВ_Прол",							ОписаниеТипаЧисло14_2_но);
	тзПодразделений.Колонки.Добавить("СКВ_КС",			ОписаниеТипаЧисло14_2_но);
	тзПодразделений.Колонки.Добавить("ВыполненПланПоСКВ", ОписаниеТипаБулево);
	тзАгентов.Сортировать("Агент,ДатаПоступленияВПодразделение УБЫВ");
	ТЗАгентов.Индексы.Добавить("Агент");

	//Пробегаем по агентам 
	//И для тех, кто входит в подразделение, с расчетом вознаграждения рауководителя по схеме ПроцентОтСКВ
	//А так же для тех агентов, у кого есть оплаты по схеме "ПланПоСКВ"
	//- заполним параметры Плана и СуперПлана
	Для Каждого Стр ИЗ ТЗАгентов Цикл
		НайденноеПодразделение	=	тзПодразделений.Найти(Стр.Подразделение);
		бСхемаРОП_ПроцентОтСКВ	=	(НайденноеПодразделение <> Неопределено) 
								И НайденноеПодразделение.РуководительПолучаетВознаграждение = Истина 
								и (НайденноеПодразделение.СхемаВознагражденияРуководителяОП = ПрчСхемаВР.ПроцентОтСКВ);
		бЕстьОплатаПоПлануПоСКВ	=	ТЗАгентовПоСхемеПланПоСКВ.Найти(Стр.Агент) <> Неопределено;
		
		Если бСхемаРОП_ПроцентОтСКВ ИЛИ бЕстьОплатаПоПлануПоСКВ Тогда
			
			ШтрафнойПлан = ПолучитьШтрафнойПлан(Стр.Агент,НачалоДня(КонецМесяца(ЗарплатныйПериод)));
			
			тз = уб_СтраховойБрокер.ПолучитьПланПоСКВ(НачалоДня(КонецМесяца(ЗарплатныйПериод)), , Стр.Подразделение, Стр.Агент);
			Если тз.Количество() > 0 Тогда
				Стр.План = тз[0].План+ШтрафнойПлан;
				Стр.ШтрафнойПлан = ШтрафнойПлан;
				Если Стр.План = 0 Тогда
					Стр.Количество = 0;
				Иначе
					Стр.Количество = тз[0].Количество;
				КонецЕсли;
			Иначе
				Сообщить("ВНИМАНИЕ! Не найдено значение плана по СКВ для Агента " + Строка(Стр.Агент) + " на дату " + Строка(НачалоДня(КонецМесяца(ЗарплатныйПериод))) + " (Подразделение: " + Строка(Стр.Подразделение) + ")" );
			КонецЕсли;
			
			тз = уб_СтраховойБрокер.ПолучитьСуперПланПоСКВ(НачалоДня(КонецМесяца(ЗарплатныйПериод)), , Стр.Подразделение, Стр.Агент," И Т.СуперПлан<>0");
			Если тз.Количество() > 0 Тогда
				Стр.СуперПлан = тз[0].СуперПлан+?(ЭтоВариант20150601=Истина и не ЭтоВариант20200801,ШтрафнойПлан,0);
			Иначе
				Сообщить("ВНИМАНИЕ! Не найдено значение Бонус-Планки по СКВ для Агента " + Строка(Стр.Агент) + " на дату " + Строка(НачалоДня(КонецМесяца(ЗарплатныйПериод))) + " (Подразделение: " + Строка(Стр.Подразделение) + ")" );
			КонецЕсли;
			
			Если ЭтоВариант20121201 Тогда
				тз = уб_СтраховойБрокер.ПолучитьСуперПланПоСКВ(НачалоДня(КонецМесяца(ЗарплатныйПериод)), , Стр.Подразделение, Стр.Агент," И Т.ПерваяБонусПланка<>0");
				Если тз.Количество() > 0 Тогда
					Стр.ПерваяБонусПланка = тз[0].ПерваяБонусПланка+?(ЭтоВариант20150601=Истина и не ЭтоВариант20200801,ШтрафнойПлан,0);//201212	Стр.СуперПлан = тз[0].СуперПлан;
				Иначе
					Сообщить("ВНИМАНИЕ! Не найдено значение min Бонус-Планки по СКВ для Агента " + Строка(Стр.Агент) + " на дату " + Строка(НачалоДня(КонецМесяца(ЗарплатныйПериод))) + " (Подразделение: " + Строка(Стр.Подразделение) + ")" );
				КонецЕсли;
			КонецЕсли;
			
			тз = уб_СтраховойБрокер.ПолучитьПроцентныеСтавкиПоСКВ(НачалоДня(КонецМесяца(ЗарплатныйПериод)), , Стр.Подразделение, Стр.Агент);
			
			//
			
			//
			Если тз.Количество() > 0 Тогда
				ЕСли ЗарплатныйПериод<Дата(2017,1,1) и ПараметрыСеанса.уб_Константы.ЭтоМастер = Истина и Мастер70=Ложь Тогда
					Стр.ПроцентнаяСтавкаДоПлана			        = 35;
					Стр.ПроцентнаяСтавкаПослеПлана		        = 40;
					Стр.ПроцентнаяСтавкаПослеПервойБонусПланки  = 40;//201212
					Стр.ПроцентнаяСтавкаПослеСуперПлана         = 40;
					
					Стр.ПроцентнаяСтавкаПролонгация = 40;
					Стр.ПроцентнаяСтавкаПролонгацияДоПлана = 35;
				Иначе
					Стр.ПроцентнаяСтавкаДоПлана			 = тз[0].ПроцентнаяСтавкаДоПлана;
					Стр.ПроцентнаяСтавкаПослеПлана		 = тз[0].ПроцентнаяСтавкаПослеПлана;
					Стр.ПроцентнаяСтавкаПослеПервойБонусПланки = тз[0].ПроцентнаяСтавкаОтПервойБонусПланки;//201212
					Стр.ПроцентнаяСтавкаПослеСуперПлана  = тз[0].ПроцентнаяСтавкаПослеСуперПлана;
					
					ЭтоСтажер = ЭтоСтажер(Стр.Агент);
					Стр.ПроцентнаяСтавкаПролонгация       = Макс(Стр.ПроцентнаяСтавкаПослеПлана-?(ЭтоСтажер,0,10),0);
					Стр.ПроцентнаяСтавкаПролонгацияДоПлана = Макс(Стр.ПроцентнаяСтавкаДоПлана  -?(ЭтоСтажер,0,10),0);
				КонецЕсли;	
			Иначе
				Сообщить("ВНИМАНИЕ! Не найдена информация по ставкам ПланаПоСКВ для Агента " + Строка(Стр.Агент) + " на дату " + Строка(НачалоДня(КонецМесяца(ЗарплатныйПериод))) + " (Подразделение: " + Строка(Стр.Подразделение) + ")" );
			КонецЕсли;
			Стр.ЕстьПланПоСКВ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	//Теперь В ТЗАгентов Есть все данные для получения общего плана подразделения, работающего по схеме ПланПоСКВ	
	
	//В таблице ТЗ1 есть сведения об СКВ
	//Произведем корректировку значения подразделений для выборки оплат, находящейся в ТЗ1
	ТЗ1.Колонки.Добавить("ЕстьПланПоСКВ",		ОписаниеТипаБулево);
	ТЗ1.Колонки.Добавить("УАгентаПланПоСКВ",	ОписаниеТипаБулево);
	ТЗ1.Колонки.Добавить("Пустышка", ОписаниеТипаБулево);
	ТЗ1.Колонки.Добавить("СКВ_КС", ОписаниеТипаЧисло14_2_но);
	
	ТЗ1.Колонки.Добавить("БОНУС_КС", ОписаниеТипаЧисло14_2_но);
	ТЗ1.Колонки.Добавить("БОНУС_РОП_КС", ОписаниеТипаЧисло14_2_но);
	
//	ТЗ1.Колонки.Добавить("СКВ_Прол", ОписаниеТипаЧисло14_2_но);
	
	СтрокаТЗАгентов = Неопределено;
	Для Каждого Стр ИЗ ТЗ1 Цикл
		Если (СтрокаТЗАгентов = Неопределено) ИЛИ (Стр.Агент<>СтрокаТЗАгентов.Агент) Тогда
			СтрокаТЗАгентов = ТЗАгентов.Найти(Стр.Агент);
		КонецЕсли;
		Если СтрокаТЗАгентов <> Неопределено Тогда
			
			Стр.Подразделение = СтрокаТЗАгентов.Подразделение;
			Стр.ЕстьПланПоСКВ = СтрокаТЗАгентов.ЕстьПланПоСКВ;
			СтрокаТЗАгентов.ЭтотАгентЕстьВТЗ1 = Истина;
		Иначе
			Сообщить("Ошибка: не найден агент из оплаты " + Строка(Стр.Агент) + " в промежуточной таблице агентов");
			продолжить;
		КонецЕсли;
		Если Стр.СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ Тогда
			СтрокаТЗАгентов.УАгентаПланПоСКВ = Истина;
			Стр.УАгентаПланПоСКВ = Истина;
		КонецЕсли;	
		
