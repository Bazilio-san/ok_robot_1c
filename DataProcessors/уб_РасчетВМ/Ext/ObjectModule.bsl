Функция ВыполнениеПланаМенеджерами(МассивМенеджеров, Период) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ЗП_ВыполнениеПланаМенеджерами.ВыполненПлан,
	|	уб_ЗП_ВыполнениеПланаМенеджерами.Менеджер
	|ИЗ
	|	РегистрСведений.уб_ЗП_ВыполнениеПланаМенеджерами КАК уб_ЗП_ВыполнениеПланаМенеджерами
	|ГДЕ
	|	уб_ЗП_ВыполнениеПланаМенеджерами.Менеджер В (&МассивМенеджеров)
	|	И НАЧАЛОПЕРИОДА(уб_ЗП_ВыполнениеПланаМенеджерами.ПериодЗП, МЕСЯЦ) = &ПериодЗП");
	Запрос.УстановитьПараметр("МассивМенеджеров",	МассивМенеджеров);
	Запрос.УстановитьПараметр("ПериодЗП",			НачалоМесяца(Период));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;
	
