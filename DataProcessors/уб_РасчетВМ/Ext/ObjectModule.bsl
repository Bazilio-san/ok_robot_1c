						КонецЕсли;
						ОблПодразделение.Параметры.ПроцентПлана     = Строка(Формат(ВыборкаПодраздел.ПроцентВыполненияПлана_РОП,ЧФ000));
						//!ОблПодразделение.Параметры.СКВдоСП			= Формат(ВыборкаПодраздел.СКВ_ПоПодразделениямДоСП,ЧФ0);
						Если ВыводитьКС Тогда
							//!ОблПодразделение.Параметры.СКВ_КС		= Формат(ВыборкаПодраздел.СКВ_КС,ЧФ);
							//!ОблПодразделение.Параметры.БОНУС_РОП_КС = Формат(ВыборкаПодраздел.БОНУС_РОП_КС,ЧФ);
						КонецЕсли;	
						
						//МЗ = тзПодразделений.Найти(ВыборкаПодраздел.Подразделение,"Подразделение_ТПодразделений");
						//Если МЗ = Неопределено Тогда
						//	МЗ = уб_СтраховойБрокер.ПолучитьРуководителяПодразделения(ДатаНачала+1, ВыборкаПодраздел.Подразделение);//.Ссылка
						//КонецЕсли;
						
						ПроцентРуководителя = ?(ПолучаетВознаграждениеЗаРуководствоОтделом,ВыборкаПодраздел.СтавкаВознаграждения_РОП,0);
						
						ОблПодразделение_Вознаграждение.Параметры.ПроцентРуководителя	= Формат(ВыборкаПодраздел.СуммаВознаграждения_РОП,ЧФ000);
						Если СохраняемДанные =Истина и не (Строка(РуководительПодразделения) ="Слученков Дмитрий" и Строка(ВыборкаПодраздел.Подразделение) ="ОП-2") Тогда 
							ЗаписатьПараметр("СуммаВознаграждения_РОП",РуководительПодразделения,ВыборкаПодраздел.СуммаВознаграждения_РОП);
						КонецЕсли;	
						//!ОблПодразделение.Параметры.ПроцентОтСКВМенеджеру = Формат(ПроцентРуководителя,"");
					КонецЕсли;
					
					Если НЕ СкрыватьКолонкиДСП И ДБЕсть Тогда
						Если ВыборкаПодраздел.СхемаВознагражденияРуководителяОП = Перечисления.уб_ЗП_СхемыВознагражденияРуководителейОП.ПроцентОтДБ Тогда
							ОблПодразделение_Доход.Параметры.СуммаДоходаБрокера = ?(ВыборкаПодраздел.СуммаДБ = Null,0,ВыборкаПодраздел.СуммаДБ)+?(ЗПОбщееП<0,ЗПОбщееП,0);
						Иначе	
							
							ОблПодразделение_Доход.Параметры.СуммаДоходаБрокера	= Формат(?(ВыборкаПодраздел.СКВ_ДляПланаПоСКВ_ПоПодразделению = Null, 0, ВыборкаПодраздел.СКВ_ДляПланаПоСКВ_ПоПодразделению) - ЗПОбщееП - ?(ВыборкаПодраздел.СуммаВознаграждения_РОП = Null, 0, ВыборкаПодраздел.СуммаВознаграждения_РОП),ЧФ000);
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			//область подразделения выводим позже
			ОбластьПодразделениеВыведено = Ложь;
			
			///////////////// МЕНЕДЖЕР \\\\\\\\\\\\\\\\\
			// заполнение строки макета МЕНЕДЖЕР	
			ВыборкаМенеджер = ВыборкаПодраздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
			Пока ВыборкаМенеджер.Следующий() Цикл
				Если ФильтрПоМенеджеру Тогда
					Если ВыборкаМенеджер.Агент = Менеджер Тогда
					ИначеЕсли ЭтоРуководитель Тогда
						КВыводу = ВыборкаМенеджер.ЕД-ВыборкаМенеджер.НеВыводить;
						Если КВыводу<0 Или (ФильтрПоСпискуМенеджеров=Истина и СписокМенеджеров.НайтиПоЗначению(ВыборкаМенеджер.Агент) = Неопределено) Тогда
							Продолжить;
						КонецЕсли;	
					Иначе
						КВыводу = ВыборкаМенеджер.ЕД-ВыборкаМенеджер.НеВыводить;
						Если КВыводу<0 Тогда
							Продолжить;
						КонецЕсли;
						//Продолжить;
					КонецЕсли;	
				ИначеЕсли ФильтрПоСпискуМенеджеров Тогда
					Если СписокМенеджеров.НайтиПоЗначению(ВыборкаМенеджер.Агент) = Неопределено Тогда
						Продолжить
					КонецЕсли;
				Иначе
					Если ВыборкаМенеджер.Пустышка И ВыборкаМенеджер.План = 0 Тогда //И НЕ ФильтрПоМенеджеру Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;	
				Если ВыводимСтрокуПодразделения и Не ОбластьПодразделениеВыведено  Тогда
					ДокументРезультат.Вывести(ОблПодразделение,Уровень+1,,Истина);
