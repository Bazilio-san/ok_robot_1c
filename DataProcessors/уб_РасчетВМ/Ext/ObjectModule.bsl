					Сообщить("Не найден менеджер в таблице агентов "+Выборка.Менеджер);
				КонецЕсли;	
			Иначе	
				СтрокаАгента = массивСтрок[0];
				Если Выборка.ВидВознаграждения = "ВМ" Тогда
					СтрокаАгента.ВМПоИнтервалам = СтрокаАгента.ВМПоИнтервалам+ Выборка.ВМ;
					ДобавитьПустышку(тз1,СтрокаАгента,ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоИнтерваламСКВ);
					//СтрокаАгента.ИтогоЗП = СтрокаАгента.ИтогоЗП + СтрокаАгента.ВМПоИнтервалам;
				ИначеЕсли Выборка.ВидВознаграждения = "РОП" Тогда
					//СтрокаАгента.ВМПоИнтервалам = СтрокаАгента.ВМПоИнтервалам+ Выборка.ВМ;
					СтрокаАгента.ВознаграждениеРуководителя = СтрокаАгента.ВознаграждениеРуководителя+Выборка.ВМ;
					//СтрокаАгента.ИтогоЗП = СтрокаАгента.ИтогоЗП + СтрокаАгента.ВМПоИнтервалам;
				КонецЕсли;	
			КонецЕсли;		
			Если Выборка.ВидВознаграждения = "РОП" Тогда
				//СтрокаАгента.ИтогоЗП = СтрокаАгента.ИтогоЗП + СтрокаАгента.ВМПоИнтервалам;
				СтрокаПодразделения				= тзПодразделений.Найти(Выборка.Подразделение,"Подразделение");
				Если СтрокаПодразделения <> Неопределено Тогда
					СтрокаПодразделения.СуммаВознаграждения_РОП = СтрокаПодразделения.СуммаВознаграждения_РОП+Выборка.ВМ;
					СтрокаПодразделения.СуммаВознаграждения_РОПОрг = СтрокаПодразделения.СуммаВознаграждения_РОПОрг+Выборка.ВМ;
				КонецЕсли;	
			КонецЕсли;			
		КонецЦикла;	
		ТЗИнтервалов = МассивПакетов[ВсегоЗапросов-2].Выгрузить();
	Иначе
		ТЗИнтервалов = Новый  ТаблицаЗначений;
	КонецЕсли;	
	//---Корпоративное
	
	//+++ Прочие виды по ТЧ Начислений в оплате
	Запрос = Новый Запрос;
	//---
	
	
	//Условно
	//Сверка вознаграждения в оплате
	Если ПерезаполнитьВМ И ВРеальномВремени Тогда
		#Если Клиент Тогда
			Состояние(стрСостояние+". Распределение вознаграждения по оплатам");
		#КонецЕсли
		
		
		СчетчикОплат = 0;
		
		ВсегоМассив = тз1.Количество();
		Этап = Этап+1;
		Для каждого Строка1  из тз1 Цикл
			
			#Если Клиент Тогда
				Если СчетчикОплат%5 = 0 Тогда
					Состояние(стрСостояние+". Этап: " + Этап + ". Распределение вознаграждения по оплатам (" + Окр(100*СчетчикОплат/ВсегоМассив,2) + "%)");
				КонецЕсли;
				СчетчикОплат = СчетчикОплат+1;
			#КонецЕсли
			Если НЕ Строка1.СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ Тогда
				Продолжить;
			КонецЕсли;	
			_этоКС = (Строка1.ЭтоКрупнаяСделка = Истина) ;
			__СКВ = Строка1.СКВ;
			_вм = тзАгентов.НайтиСтроки(Новый Структура("Агент",Строка1.Агент))[0];
			_ВознаграждениеМенеджера = ?(Строка1.ВМРасчетное=Неопределено,0,Строка1.ВМРасчетное);
			
			__ВознаграждениеМенеджера = Окр(?(_вм.ИтогоЗП=0 ИЛИ _этоКС ИЛИ (_вм.СКВ_ДляПланаПоСКВ_ПоАгенту-_вм.СКВ_КС)=0,0,_вм.ИтогоЗП*__СКВ/(_вм.СКВ_ДляПланаПоСКВ_ПоАгенту-_вм.СКВ_КС))+?(Строка1.ВознаграждениеМенеджера<0,Строка1.ВознаграждениеМенеджера,0)+
			?(_вм.СКВ_КС=0 ИЛИ НЕ _этоКС,0,_вм.БОНУС_КС_*__СКВ/_вм.СКВ_КС),2);
			//__ВознаграждениеМенеджера = Окр(__ВознаграждениеМенеджера, 2);
			Если _ВознаграждениеМенеджера <> __ВознаграждениеМенеджера Тогда
				__ДоходБрокера = __СКВ - __ВознаграждениеМенеджера; //Удержание за косяки
				ОП = Строка1.Ссылка.ПолучитьОбъект();
				ОП.ДополнительныеСвойства.Вставить("ОтключенКонтрольПериодов",Истина);
				УстановитьЗначение(ОП.ДБ, 			__ДоходБрокера);
				УстановитьЗначение(ОП.ВМРасчетное, 	__ВознаграждениеМенеджера);
				ОП.Записать();
				#Если Клиент Тогда
					ОбработкаПрерыванияПользователя();
				#КонецЕсли
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	
КонецПроцедуры


Процедура ВывестиОтчет(ДокументРезультат,ТЗ1,ТЗАгентов,тзПодразделений,тзСхемаРасчетаДляАгентов,ДатаОтчета, тзАгентовДляРаскраски = Неопределено,ТЗИнтервалов) Экспорт
	ЭтоВариант20200201 = ЗарплатныйПериод >= Дата(2019,1,1);
