			НовОплата.Ед = 0;
			НовОплата.СуммаДБ = 0;
		КонецЕсли;
	КонецЦикла;	
	//Заполняем Фактические параметры для Агентов 
	Кол = ТЗАгентов.Колонки;
	Кол.Добавить("СКВ_ДляПланаПоСКВ_ПоАгенту",	ОписаниеТипаЧисло14_2_но);
