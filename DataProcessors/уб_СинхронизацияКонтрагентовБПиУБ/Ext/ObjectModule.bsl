// Процедура подключения к базе "Бухгалтерия предприятия"
Функция ПодключитьБазу(Ошибка = Неопределено) Экспорт
	
	User = ИмяПользователя;
	Pass = Пароль;
	Путь = ПутькБазе;
	Сервер = ИмяСервера;
	База = БазаНаСервере;
	
	Если СерверноеПодключение Тогда 
		
		ПараметрСоединения = "Srvr="""+Сервер+""";Ref="""+БазаНаСервере+""";Usr="""+User+""";Pwd="""+Pass+""";";
	Иначе
		
		ПараметрСоединения = "File=""" + ПутькБазе + """; Usr=""" + ИмяПользователя + """; Pwd="""+Пароль+""";";
	КонецЕсли;
	
	Возврат уб_ОбменДанными.ПодключитьСоединение(Открыть, ПараметрСоединения, "V82","База <Брокер> не открыта! Проверьте параметры подключения!");
	
КонецФункции


Функция ПолучитьТаблицуДляВыгрузки(Интерактивно = Ложь) Экспорт
	
	ТаблицаДанных  = Новый ТаблицаЗначений;
	Колонки = ТаблицаДанных.Колонки;
	Колонки.Добавить("ДанныеБухгалтерии");
	Колонки.Добавить("ДанныеБрокера");
	Колонки.Добавить("КодБрокера");
	Колонки.Добавить("УИД");
	Колонки.Добавить("Переносить");
	
	СтрокаОшибки ="";
	Если НЕ ПодключитьБазу(СтрокаОшибки) Тогда
		СтрокаСообщения=СтрокаОшибки;
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
		
		Возврат ТаблицаДанных;
	КонецЕсли;
	
	КонтрагентУБ = Справочники.Контрагенты.Выбрать();
	
	//	ИндикаторОбработки = ИндикаторОбработки + 10;
	
	Пока КонтрагентУБ.Следующий() Цикл
		
		#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
		
		//		ИндикаторОбработки = ИндикаторОбработки + 1;
		
		Если КонтрагентУБ.ЭтоГруппа 
			Или КонтрагентУБ.ПометкаУдаления 
			Или ЗначениеЗаполнено(Открыть.Справочники.Контрагенты.НайтиПоКоду(КонтрагентУБ.КодБух).Наименование) 
			Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.ДанныеБрокера = КонтрагентУБ.Ссылка;
		НоваяСтрока.КодБрокера    = КонтрагентУБ.КодБух;
		НоваяСтрока.УИД			  = КонтрагентУБ.Ссылка.УникальныйИдентификатор();
		НоваяСтрока.Переносить  =  НЕ Интерактивно;
	КонецЦикла;
	Возврат ТаблицаДанных;
КонецФункции

//ПРОЦЕДУРЫ ДЛЯ ВЫГРУЗКИ ДАННЫХ 
//
Процедура ВыгрузитьДанныеИзУБ(ТаблицаДанных)  Экспорт
	// Выгрузка данных из УБ в БП
	ЗаписьХМL = Новый ЗаписьXML;
	//ИмяФайла = "C:\ВыгрузкаКонтрагентовИзУБ.xml";
	ИмяФайла = ФайлВыгрузки;
	ЗаписьХМL.ОткрытьФайл(ИмяФайла);
	
	// Записать начало корневого элемента 
	ЗаписьХМL.ЗаписатьНачалоЭлемента("Корневой");
	
	Переносимые = ТаблицаДанных.Скопировать(Новый Структура("Переносить",Истина));
	
	ВыгрузитьКонтрагентов(Переносимые,ЗаписьХМL);
	
	ЗаписьХМL.ЗаписатьКонецЭлемента(); //Относится к элементу "Корневой"
	ЗаписьХМL.Закрыть();
КонецПроцедуры	


// Процедура выгружает выбранных контрагентов в xml-файл
Процедура ВыгрузитьКонтрагентов(ТаблицаДляВыгрузки,ЗаписьХМL)
	
	// Записываем контрагентов
	Для Каждого Выборка Из ТаблицаДляВыгрузки Цикл 
		
		Если Не Выборка.Переносить Тогда
			Продолжить;
		КонецЕсли;	
		
		ЗаписьХМL.ЗаписатьНачалоЭлемента("Контрагент");
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Код");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Наименование");
		ЗаписьХМL.ЗаписатьТекст(Выборка.ДанныеБрокера.Наименование);
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("УникальныйИдентификатор");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.УИД));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ЮрФизЛицо");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.ЮрФизЛицо));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Родитель");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.Родитель.Наименование));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		Если Строка(Выборка.ДанныеБрокера.ЮрФизЛицо) = "Юр. лицо" Тогда
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("НаименованиеПолное");
			ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.НаименованиеПолное));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("КПП");
			ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.КПП));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
		Иначе
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("ДокументУдостоверяющийЛичность");
			ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.ДокументУдостоверяющийЛичность));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
		КонецЕсли;
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ИНН");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.ИНН));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("КодПоОКПО");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.КодПоОКПО));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ГоловнойКонтрагентКод");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБрокера.ГоловнойКонтрагент.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьКонецЭлемента(); 
		//ИндикаторОбработки = ИндикаторОбработки + 100;
		ВыгрузитьДоговора(Выборка.ДанныеБрокера,ЗаписьХМL);
		//ИндикаторОбработки = ИндикаторОбработки + 100;
		ВыгрузитьСчета(Выборка.ДанныеБрокера,ЗаписьХМL);
		//ИндикаторОбработки = ИндикаторОбработки + 100;
		ВыгрузитьКИ(Выборка.ДанныеБрокера,ЗаписьХМL);
		//ИндикаторОбработки = ИндикаторОбработки + 100;
	КонецЦикла;
	
КонецПроцедуры	

// Процедура выгружает договора выбранных контрагентов в xml-файл
Процедура ВыгрузитьДоговора(Владелец,ЗаписьХМL)
	
	// Записываем договора контрагентов
	
	Если Владелец.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	
	Договор = Справочники.ДоговорыКонтрагентов.Выбрать(,Владелец.Ссылка);
	
	Пока Договор.Следующий() Цикл
		
		//Для Каждого Выборка Из ТабличноеПоле Цикл 
		//	
		Если Договор.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		
		ЗаписьХМL.ЗаписатьНачалоЭлемента("ДоговораКонтрагента");
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Владелец");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.Владелец.Наименование));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ВалютаВзаиморасчетов");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.ВалютаВзаиморасчетов));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ВидДоговора");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.ВидДоговора));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Код");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Наименование");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.Наименование));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ОрганизацияНаим");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.Организация.Наименование));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ОрганизацияКод");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.Организация.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ПроцентКомиссионногоВознаграждения");
		ЗаписьХМL.ЗаписатьТекст(Формат(Договор.ПроцентКомиссионногоВознаграждения,"ЧГ="));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("СрокДействия");
		ЗаписьХМL.ЗаписатьТекст(Строка(Договор.ДатаОкончанияДействияДоговора));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL. ЗаписатьКонецЭлемента(); 
		//		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

