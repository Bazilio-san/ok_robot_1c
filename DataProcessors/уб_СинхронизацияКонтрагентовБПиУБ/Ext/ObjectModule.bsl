// Процедура выгружает выбранных контрагентов в xml-файл
Процедура ВыгрузитьКонтрагентовИзБП(ТабличноеПоле,ЗаписьХМL)
	
	// Записываем контрагентов
	Для Каждого Выборка Из ТабличноеПоле Цикл 
		
		ИндикаторОбработки = ИндикаторОбработки + 1;
		
		Если Не Выборка.Переносить Тогда
			Продолжить;
		КонецЕсли;	
		
		ЗаписьХМL.ЗаписатьНачалоЭлемента("Контрагент");
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Код");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Наименование");
		ЗаписьХМL.ЗаписатьТекст(Выборка.ДанныеБухгалтерии.Наименование);
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("УникальныйИдентификатор");
		ЗаписьХМL.ЗаписатьТекст(Открыть.String(Выборка.УИД));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ЮрФизЛицо");
		ЗаписьХМL.ЗаписатьТекст(Открыть.String(Выборка.ДанныеБухгалтерии.ЮрФизЛицо));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("Родитель");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.Родитель.Наименование));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		Если Строка(Выборка.ДанныеБухгалтерии.ЮрФизЛицо) = "Юр. лицо" Тогда
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("НаименованиеПолное");
			ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.НаименованиеПолное));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("КПП");
			ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.КПП));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
		Иначе
			
			ЗаписьХМL.ЗаписатьНачалоАтрибута("ДокументУдостоверяющийЛичность");
			ЗаписьХМL.ЗаписатьТекст(Открыть.String(Выборка.ДанныеБухгалтерии.ДокументУдостоверяющийЛичность));
			ЗаписьХМL.ЗаписатьКонецАтрибута();
			
		КонецЕсли;
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ИНН");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.ИНН));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("КодПоОКПО");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.КодПоОКПО));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL.ЗаписатьНачалоАтрибута("ГоловнойКонтрагентКод");
		ЗаписьХМL.ЗаписатьТекст(Строка(Выборка.ДанныеБухгалтерии.ГоловнойКонтрагент.Код));
		ЗаписьХМL.ЗаписатьКонецАтрибута();
		
		ЗаписьХМL. ЗаписатьКонецЭлемента(); 
		
		ВыгрузитьДоговораИзБП(ЗаписьХМL,Выборка.ДанныеБухгалтерии);
		ВыгрузитьСчетаИзБП(ЗаписьХМL,Выборка.ДанныеБухгалтерии);
		ВыгрузитьКИИзБП(ЗаписьХМL,Выборка.ДанныеБухгалтерии);
		
	КонецЦикла;
	
КонецПроцедуры	

