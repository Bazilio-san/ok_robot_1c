		ЧтениеXML.ПрочитатьАтрибут();
		//НовыйСчет.Код			        =
		ЧтениеXML.ПрочитатьАтрибут();
		Наим 							= ЧтениеXML.Значение;
		НовыйСчет.Наименование          = ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйСчет.НомерСчета            = СокрЛП(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйСчет.ВидСчета				= СокрЛП(ЧтениеXML.Значение);
		НовыйСчет.УстановитьНовыйКод();
		НовыйСчет.Записать();
		Возврат Истина;
	Исключение
		
		СтрокаСообщения="Не удалось создать счет " + Наим + "контрагента " + Владелец + " / " + ОписаниеОшибки();
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Процедура создания новой контактной информации выбранного контрагента с данными из xml-файла
Функция СоздатьКИ(ЧтениеXML,Владелец)
	
	Попытка
		
		НоваяКИ 		= РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		//ЧтениеXML.ПрочитатьАтрибут();
		//Владелец 			= НайтиВладельцаКИ(ЧтениеXML.Значение);
		НоваяКИ.Объект  = Владелец;
		ЧтениеXML.ПрочитатьАтрибут();
		НоваяКИ.Вид 	= Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		НоваяКИ.Поле1  	= ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
		НоваяКИ.Поле2  	= ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
		НоваяКИ.Поле3  	= ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
