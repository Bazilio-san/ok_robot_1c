// Функция проверки существования выбранной организации
Функция ПроверитьОрганизацию(ОргНаим, ОргКод)
	
	ОргПоКоду = Справочники.Организации.НайтиПоКоду(ОргКод);
	ОргПоНаим = Справочники.Организации.НайтиПоНаименованию(ОргНаим);
	
	Если ОргПоКоду.Наименование = ОргПоНаим.Наименование Тогда
		Возврат ОргПоКоду;
	ИначеЕсли НЕ ОргПоКоду.Пустая() И Найти(ОргНаим,ОргПоКоду.Наименование)>0 Тогда
		Возврат ОргПоКоду;	
	Иначе 
		Возврат ОргПоНаим;
	КонецЕсли;
	
КонецФункции

// Функция поиска владельца контактной информации
Функция НайтиВладельцаКИ(Владелец)
	
	Если ЗначениеЗаполнено(Справочники.Контрагенты.НайтиПоНаименованию(Владелец)) Тогда
		Возврат Справочники.Контрагенты.НайтиПоНаименованию(Владелец);
	ИначеЕсли ЗначениеЗаполнено(Справочники.ФизическиеЛица.НайтиПоНаименованию(Владелец)) Тогда 
		Возврат Справочники.ФизическиеЛица.НайтиПоНаименованию(Владелец);
	КонецЕсли;
	
КонецФункции	

// Функция поиска группы контрагента для загрузки данных
Функция НайтиГруппу(ТекНаим)
	
	Группа = Справочники.Контрагенты.НайтиПоНаименованию(ТекНаим);
	Если Группа.Наименование = ТекНаим И Группа.ЭтоГруппа Тогда
		Возврат Группа.Ссылка;
	КонецЕсли;
	
	НоваяГруппа 			 = Справочники.Контрагенты.СоздатьГруппу();
	НоваяГруппа.Наименование = ТекНаим;
	НоваяГруппа.Записать();
	
	Возврат НоваяГруппа.Ссылка;
	
КонецФункции


