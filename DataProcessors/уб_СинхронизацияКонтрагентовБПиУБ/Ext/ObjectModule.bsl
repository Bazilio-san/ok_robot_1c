Функция ЗаполнитьТаблицуДляЗагрузкиИзБП() Экспорт 
	
	ТаблицаДанных  = Новый ТаблицаЗначений;
	Колонки = ТаблицаДанных.Колонки;
	Колонки.Добавить("ДанныеБухгалтерии");
	Колонки.Добавить("ДанныеБрокера");
	Колонки.Добавить("КодБрокера");
	Колонки.Добавить("УИД");
	Колонки.Добавить("Переносить");
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.ОткрытьФайл(Файл);
	
	Имя = ЧтениеXML.Имя;
	
	Пока ЧтениеXML.Прочитать() Цикл 
		
		//		ИндикаторОбработки = ИндикаторОбработки + 1;
		
		ПолучитьXMLТип(ЧтениеXML);
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента  Тогда
			
			Имя = ЧтениеXML.Имя;
			
			Если Имя = "Контрагент" Тогда
				ЧтениеXML.ПрочитатьАтрибут();           
				ЧтениеXML.ПрочитатьАтрибут();
				
				Наименование = СокрЛП(ЧтениеXML.Значение);
				ЧтениеXML.ПрочитатьАтрибут();
				УИД			  	  = СокрЛП(ЧтениеXML.Значение);
				
				СсылкаПОУИД = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
				СсылкаПоНаименованию = Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
				Если  НЕ ЗначениеЗаполнено(СсылкаПОУИД.Код)
					И Не ЗначениеЗаполнено(СсылкаПоНаименованию) Тогда
					НоваяСтрока = ТаблицаДанных.Добавить();
					НоваяСтрока.Переносить        = Истина;
					НоваяСтрока.ДанныеБухгалтерии = Наименование;
					НоваяСтрока.УИД			  	  = УИД;
				Иначе
					СтрокаСообщения="Контрагент " + СокрЛП(Наименование) + " уже создан в базе ""Управление брокером""! 
					|Внутренний UID"+УИД+"/"+СсылкаПоНаименованию+"/"+СсылкаПоУИД+"
					|		Проверьте заполнение кода в базе ""Бухгалтерия предприятия""!";
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить");
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат ТаблицаДанных;
КонецФункции

Процедура ЗагрузитьФайлИзБП(ТаблицаЗагрузки) Экспорт
	ТабличноеПоле = ТаблицаЗагрузки.Скопировать(Новый Структура("Переносить",Истина));
	ТабличноеПоле.Индексы.Добавить("ДанныеБухгалтерии");
	//ИндикаторОбработки = 0;
	//ЭлементыФормы.ИндикаторОбработки.МаксимальноеЗначение = ?(ЭлементовВФайле=Неопределено,1000,ЭлементовВФайле);
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.ОткрытьФайл(Файл);
	
	Имя = ЧтениеXML.Имя;
	ЕстьОшибкаПоКонтрагенту = Ложь;
	Пока ЧтениеXML.Прочитать() Цикл 
		
		//		ИндикаторОбработки = ИндикаторОбработки + 1;
		
		ПолучитьXMLТип(ЧтениеXML);
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента  Тогда
			
			Имя = ЧтениеXML.Имя;
			
			Если Имя = "Контрагент" Тогда
				Если ТранзакцияАктивна() Тогда
					Если ЕстьОшибкаПоКонтрагенту Тогда
						
						СтрокаСообщения="Отменена транзакция из-за ошибок";
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
						ОтменитьТранзакцию()
					Иначе
						ПОпытка
							ЗафиксироватьТранзакцию();
						Исключение
							
							СтрокаСообщения="При Фиксации транзакции: "+ОписаниеОшибки();
							уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
						КонецПопытки;	
					Конецесли;	
				КонецЕсли;
				
				ЕстьОшибкаПоКонтрагенту = Ложь;
				НачатьТранзакцию();
				
				ЧтениеXML.ПрочитатьАтрибут();           
				Код = ЧтениеXML.Значение;
				ЧтениеXML.ПрочитатьАтрибут();
				Наим = СокрЛП(ЧтениеXML.Значение);
				
				ТекСтрока = ТабличноеПоле.Найти(Наим, "ДанныеБухгалтерии");
				
				Если ТекСтрока = Неопределено Или Не ТекСтрока.Переносить Тогда 
					Продолжить;
				КонецЕсли;
				
				ЧтениеXML.ПрочитатьАтрибут();
				СтрокаGUID = СокрЛП(ЧтениеXML.Значение);
				НовыйGUID = Новый УникальныйИдентификатор(СтрокаGUID);
				УИД = Справочники.Контрагенты.ПолучитьСсылку(НовыйGUID);
				
				Если ЗначениеЗаполнено(УИД.Код) Тогда 
					
					СтрокаСообщения="Уже есть такой контрагент или изменено наименование контрагента: " + УИД.Наименование + " / " + Наим;
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить");
					Продолжить;
				Иначе
					ЕстьОшибка = НЕ СоздатьКонтрагента(ЧтениеXML,Наим,Код,УИД);
					ЕстьОшибкаПоКонтрагенту = ?(ЕстьОшибкаПоКонтрагенту,Истина,ЕстьОшибка);
					Если НЕ ЕстьОшибкаПоКонтрагенту Тогда
						ТекСтрока.КодБрокера = Код;
					КонецЕсли;	
				КонецЕсли;
			ИначеЕсли Имя = "ДоговораКонтрагента" Тогда
				ЧтениеXML.ПрочитатьАтрибут();
				Попытка
					Владелец  = Справочники.Контрагенты.НайтиПоНаименованию(ЧтениеXML.Значение);
				Исключение
					СтрокаСообщения="Ошибка при поиске контрагента, возможно нужна переиндексация базы / "+ ЧтениеXML.Значение;
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
					Продолжить;
				КонецПопытки;	
				ТекСтрока = ТабличноеПоле.Найти(СокрЛП(ЧтениеXML.Значение), "ДанныеБухгалтерии");
				Если ТекСтрока = Неопределено Или Не ТекСтрока.Переносить Или Не ЗначениеЗаполнено(Владелец.Код) Тогда 
					Продолжить;
				Иначе
					ЕстьОшибка = НЕ СоздатьДоговор(ЧтениеXML,Владелец);
					ЕстьОшибкаПоКонтрагенту = ?(ЕстьОшибкаПоКонтрагенту,Истина,ЕстьОшибка);
				КонецЕсли;
			ИначеЕсли Имя = "БанковскиеСчетаКонтрагента" Тогда
				ЧтениеXML.ПрочитатьАтрибут();
				Попытка
					Владелец  = Справочники.Контрагенты.НайтиПоНаименованию(ЧтениеXML.Значение);
				Исключение
					СтрокаСообщения="Ошибка при поиске контрагента, возможно нужна переиндексация базы / "+ ЧтениеXML.Значение;
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
					Продолжить;
				КонецПопытки;	
				ТекСтрока = ТабличноеПоле.Найти(СокрЛП(ЧтениеXML.Значение), "ДанныеБухгалтерии");
				Если ТекСтрока = Неопределено Или Не ТекСтрока.Переносить Или Не ЗначениеЗаполнено(Владелец.Код) Тогда 
					Продолжить;
				Иначе
					
					ЕстьОшибка = НЕ СоздатьСчет(ЧтениеXML,Владелец);
					ЕстьОшибкаПоКонтрагенту = ?(ЕстьОшибкаПоКонтрагенту,Истина,ЕстьОшибка);
					
				КонецЕсли;
				
			ИначеЕсли Имя = "КонтактнаяИнформацияКонтрагента" Тогда
				ЧтениеXML.ПрочитатьАтрибут();
				Попытка
					Владелец  = Справочники.Контрагенты.НайтиПоНаименованию(ЧтениеXML.Значение);
				Исключение
					СтрокаСообщения="Ошибка при поиске контрагента, возможно нужна переиндексация базы / "+ ЧтениеXML.Значение;
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
					Продолжить;
				КонецПопытки;	
				ТекСтрока = ТабличноеПоле.Найти(СокрЛП(ЧтениеXML.Значение), "ДанныеБухгалтерии");
				Если ТекСтрока = Неопределено Или Не ТекСтрока.Переносить  Или Не ЗначениеЗаполнено(Владелец.Код) Тогда 
					Продолжить;
				Иначе
					ЕстьОшибка = НЕ СоздатьКИ(ЧтениеXML,Владелец);
					ЕстьОшибкаПоКонтрагенту = ?(ЕстьОшибкаПоКонтрагенту,Истина,ЕстьОшибка);
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	Если ТранзакцияАктивна() Тогда
		Если ЕстьОшибкаПоКонтрагенту Тогда
			ОтменитьТранзакцию()
		Иначе
			ПОпытка
				ЗафиксироватьТранзакцию();
			Исключение
				СтрокаСообщения="При Фиксации транзакции: "+ОписаниеОшибки();
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
			КонецПопытки;	
		Конецесли;	
	КонецЕсли;
	//ИндикаторОбработки = 1000;
	
	
КонецПроцедуры	

// Процедура создания выбранного контрагента с данными из xml-файла
Функция СоздатьКонтрагента(ЧтениеXML,Наим,Код,СсылкаПоУИД)
	
	Попытка
		
		НовыйКонтрагентБП 						 = Справочники.Контрагенты.СоздатьЭлемент();
		
		НовыйКонтрагентБП.УстановитьСсылкуНового(СсылкаПоУИД);
		
		//ЧтениеXML.ПрочитатьАтрибут();           
		НовыйКонтрагентБП.КодБух                 = Код;
		//ЧтениеXML.ПрочитатьАтрибут();
		//Наим 									 = СокрЛП(ЧтениеXML.Значение);
		//НовыйКонтрагентБП.Наименование			 = СокрЛП(ЧтениеXML.Значение);
		НовыйКонтрагентБП.Наименование			 = Наим;
		ЧтениеXML.ПрочитатьАтрибут();
		Если ЧтениеXML.Значение = "Юр. лицо" Тогда
			НовыйКонтрагентБП.ЮрФизЛицо  		 = Перечисления.ЮрФизЛицо.ЮрЛицо;
		Иначе                                           
			НовыйКонтрагентБП.ЮрФизЛицо  		 = Перечисления.ЮрФизЛицо.ФизЛицо;
		КонецЕсли;
		ЧтениеXML.ПрочитатьАтрибут();
		Группа 									 = НайтиГруппу(ЧтениеXML.Значение);
		НовыйКонтрагентБП.Родитель  			 = Группа;
		ЧтениеXML.ПрочитатьАтрибут();
		Если НовыйКонтрагентБП.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
			НовыйКонтрагентБП.НаименованиеПолное = СокрЛП(ЧтениеXML.Значение);
			ЧтениеXML.ПрочитатьАтрибут();
			НовыйКонтрагентБП.КПП		         = СокрЛП(ЧтениеXML.Значение);
		Иначе 
			НовыйКонтрагентБП.ДокументУдостоверяющийЛичность = СокрЛП(ЧтениеXML.Значение);
		КонецЕсли;
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйКонтрагентБП.ИНН                    = СокрЛП(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйКонтрагентБП.КодПоОКПО              = СокрЛП(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		//НовыйКонтрагентБП.ГоловнойКонтрагент	 = Справочники.Контрагенты.НайтиПоКоду(ЧтениеXML.Значение);
		НовыйКонтрагентБП.УстановитьНовыйКод();
		НовыйКонтрагентБП.Записать();
		Возврат Истина;
	Исключение
		
		СтрокаСообщения="Не удалось создать контрагента " + Наим + "/" + ОписаниеОшибки();
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Процедура создания нового договора выбранного контрагента с данными из xml-файла
Функция СоздатьДоговор(ЧтениеXML,Владелец)
	
	Попытка
		
		НовыйДоговорБП 						= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		//ЧтениеXML.ПрочитатьАтрибут();
		//Владелец							= Справочники.Контрагенты.НайтиПоНаименованию(ЧтениеXML.Значение);
		НовыйДоговорБП.Владелец				= Владелец;
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйДоговорБП.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоНаименованию(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		Если ЧтениеXML.Значение = "С поставщиком" Тогда
			НовыйДоговорБП.ВидДоговора 		=  Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ИначеЕсли ЧтениеXML.Значение = "С покупателем" Тогда
			НовыйДоговорБП.ВидДоговора 		=  Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		ИначеЕсли ЧтениеXML.Значение = "С комитентом (принципалом)" Тогда
			НовыйДоговорБП.ВидДоговора 		=  Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
		ИначеЕсли ЧтениеXML.Значение = "С комиссионером (агентом)" Тогда
			НовыйДоговорБП.ВидДоговора 		=  Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;
		ИначеЕсли ЧтениеXML.Значение = "Прочее" Тогда
			НовыйДоговорБП.ВидДоговора 		=  Перечисления.ВидыДоговоровКонтрагентов.Прочее;
		КонецЕсли;
		ЧтениеXML.ПрочитатьАтрибут();
		//НовыйДоговорБП.Код        			= 
		ЧтениеXML.ПрочитатьАтрибут();
		Наим								= СокрЛП(ЧтениеXML.Значение);
		НовыйДоговорБП.Наименование       	= СокрЛП(ЧтениеXML.Значение);
		ЧтениеXML.ПрочитатьАтрибут();
		ОргНаим = ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
		ОргКод  = ЧтениеXML.Значение;
		Организация = ПроверитьОрганизацию(ОргНаим, ОргКод);
		НовыйДоговорБП.Организация        	= Организация;
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйДоговорБП.ПроцентКомиссионногоВознаграждения = ЧтениеXML.Значение;
		ЧтениеXML.ПрочитатьАтрибут();
		НовыйДоговорБП.ДатаОкончанияДействияДоговора      = Дата(ЧтениеXML.Значение);
		НовыйДоговорБП.УстановитьНовыйКод();
		НовыйДоговорБП.Записать();
		Возврат Истина
	Исключение
		
		СтрокаСообщения="Не удалось создать договор " + Наим + " контрагента " + Владелец + " / " + ОписаниеОшибки();
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(СтрокаСообщения,"Сообщить",ДобавлятьЗаписьВЖурнал);
		Возврат Ложь
	КонецПопытки;
	
КонецФункции

// Процедура создания нового банковского счета выбранного контрагента с данными из xml-файла
Функция СоздатьСчет(ЧтениеXML,Владелец)
	
	Попытка
		
		НовыйСчет 						= Справочники.БанковскиеСчета.СоздатьЭлемент();
		//ЧтениеXML.ПрочитатьАтрибут();
		//Владелец						= Справочники.Контрагенты.НайтиПоНаименованию(ЧтениеXML.Значение);
		НовыйСчет.Владелец              = Владелец;
		ЧтениеXML.ПрочитатьАтрибут();
