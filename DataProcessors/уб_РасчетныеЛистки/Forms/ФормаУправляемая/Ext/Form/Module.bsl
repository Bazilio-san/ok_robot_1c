&НаКлиенте
Процедура ОткрытьОтчетОСравнении(Команда)
	
	
	ТекущаяОбласть 	= Элементы.ТабличныйДокумент.ТекущаяОбласть;
	Расшифровка 	= ТабличныйДокумент.Область(ТекущаяОбласть.Верх,1,ТекущаяОбласть.Верх,1).Расшифровка;	
	Структура = Новый Структура;
	Структура.Вставить("ЗарплатныйПериод", 	Расшифровка.РасчетныйПериод);
	Структура.Вставить("Менеджер",			Расшифровка.Менеджер);
	УИД = УникальныйИдентификатор2(Структура.Менеджер);
	УИД = УИД + Структура.ЗарплатныйПериод;
	Если Расшифровка.Период <> Расшифровка.РасчетныйПериод Тогда
		//В режиме сравнения
		ПриведеннаяДатаСреза1 = Расшифровка.ПредДатаФиксации;
		ПриведеннаяДатаСреза2 = Расшифровка.ДатаФиксации;
		ТД = ТекущаяДата();
		Если Не ЗначениеЗаполнено(ПриведеннаяДатаСреза1) Тогда
			ПриведеннаяДатаСреза1 = ТД;
		Конецесли;	
		Если Не ЗначениеЗаполнено(ПриведеннаяДатаСреза2) Тогда
			ПриведеннаяДатаСреза2 = ТД;
		Конецесли;	
		Минимум 	= Мин(ПриведеннаяДатаСреза1,	ПриведеннаяДатаСреза2);
		Максимум    = Макс(ПриведеннаяДатаСреза1,   ПриведеннаяДатаСреза2);
		Если НачалоДня(Максимум) = НачалоДня(ТекущаяДата()) Тогда
			Максимум = Дата(1, 1, 1)
		КонецЕсли;
		//Ограничение по дате началаведения истории
		Минимум = Макс(Минимум, Дата(2011,12,25,1,1,1));
		Структура.Вставить("ДатаСреза", 		Минимум);
		Структура.Вставить("РежимОтчета",   	1);
		Структура.Вставить("датаСреза1",		Минимум);
		Структура.Вставить("датаСреза2",		Максимум);
		Структура.Вставить("ТолькоСОтличиями",  Истина);
		Структура.Вставить("Сформровать",  Истина);
		
		УИД = УИД + Минимум + Максимум;
	Конецесли;
	ОткрытьФорму("Обработка.уб_РасчетВМ.Форма.ФормаУправляемая",Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИсториюОплат(Команда)
	ТекущаяОбласть 	= Элементы.ТабличныйДокумент.ТекущаяОбласть;
	Расшифровка 	= ТабличныйДокумент.Область(ТекущаяОбласть.Верх,1,ТекущаяОбласть.Верх,1).Расшифровка;	
	Доступно 		= ТипЗНЧ(Расшифровка) = Тип("Структура");
	Если Доступно Тогда
		Структура = Новый Структура;
		Структура.Вставить("Менеджер", 			Расшифровка.Менеджер);
		Структура.Вставить("РасчетныйПериод",   Расшифровка.РасчетныйПериод);
		УИД = Строка(УникальныйИдентификатор2(Структура.Менеджер)) + Структура.РасчетныйПериод;
		Структура.Вставить("ФильтрПоПериоду",	Истина);
		ПриведеннаяДатаСреза1 = Расшифровка.ПредДатаФиксации;
		ПриведеннаяДатаСреза2 = Расшифровка.ДатаФиксации;
		ТД = ТекущаяДата();
