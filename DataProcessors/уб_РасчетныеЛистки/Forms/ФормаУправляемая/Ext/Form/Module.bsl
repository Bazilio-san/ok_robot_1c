		Структура.Вставить("Сформровать",  Истина);
		УИД = УИД + Минимум + Максимум;
		
		ОткрытьФорму("Отчет.уб_ОтчетПоПравкамОплатДляЗП.Форма.ФормаУправляемая",Структура);
