		|      <product>ОСАГО</product>
		|      <dictionaryCode>"+ИмяСправочника+"</dictionaryCode>
		|   </ser:getDictionaries>
		|	</soapenv:Body>
		|</soapenv:Envelope>";
		
		XMLОтвет = ЗапросSoap("getDictionaries",ТекстЗапроса);
		
		СтрокаXPath = "//ListDictionaryResponse/ns2:Dictionary/ns2:Value/ns2:Parameter/ns2:Value";
		
		ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
		
		СписокСправочника  = Новый СписокЗначений;
		
		Для каждого ХМЛнода из ВыборкаXMLНод Цикл
			
			СписокСправочника.Добавить(ХМЛнода.Text);
			//Сообщить(ХМЛнода.Text);
			
		КонецЦикла;		
		
		Возврат СписокСправочника
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	//Возврат XMLОтвет;
	
	
