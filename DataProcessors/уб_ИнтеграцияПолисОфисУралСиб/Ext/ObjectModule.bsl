Функция ОтправитьДанныеПолиса()Экспорт
	
	Обработка = ЭтотОбъект;
	
	НомерСессии = Обработка.AccId;
	
	Текст = Новый ТекстовыйДокумент;
	_IDПолиса = "";
	ЕСли НомерСессии <> Неопределено ИЛИ Обработка.ТестовыйРежим = Истина Тогда
		
		//ИмяМакета = "ШаблонИмпорта";
		ДанныеДляЗаполнения = Неопределено;
		
		Если Документ.ПодготовитьДанные(НомерСессии,ДанныеДляЗаполнения) = Истина Тогда
			
			Если ПустаяСтрока(Документ.IDКалькуляции)= Истина Тогда  
				Если ПроизвестиКалькуляцию(ДанныеДляЗаполнения,Текст) = ЛОЖЬ Тогда
					Обработка.ЗакрытьAccID();
					Текст.ДобавитьСтроку("Калькуляция не проведена");
					Возврат Текст;
				КонецЕсли;	
			Иначе
				//Есть код калькуляции
			КонецЕсли;	
			//
			ДопСтрока = ДанныеДляЗаполнения.Добавить();
			ДопСтрока.Параметр = "КодКалькуляции";
			ДопСтрока.Значение = Документ.IDКалькуляции;
		
			ИмяМакета = "ШаблонИмпорта";
			Результат = ЗаполнитьМакет(ИмяМакета,ДанныеДляЗаполнения);
			
			///Сообщить(Результат);
			XMLОтвет = Обработка.ЗапросSoap("importPolicy",Результат);
			Если XMLОтвет = Неопределено Тогда
				Текст.ДобавитьСтроку("Не получено ответа на запрос");
				Текст.ДобавитьСтроку("--------Проект запроса "+Имямакета+"-------");
				Текст.ДобавитьСтроку(Результат);
			Иначе	
				СтрокаXPath = "/S:Envelope/S:Body/ns2:importPolicyResponse/errors/error/message";
				//СтрокаXPath = "//errors/error/message";
				СтрокаXPath = "//errors/error[message or type]";
				ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
				Если ВыборкаXMLНод.length = 0 Тогда
					//Текст.ДобавитьСтроку(XMLОтвет.xml);
				Иначе	
					Для каждого ХМЛнода из ВыборкаXMLНод Цикл
						Текст.ДобавитьСтроку("--------Ошибки отправки-----------------");
						Текст.ДобавитьСтроку(ХМЛнода.Text);
						
					КонецЦикла;		
				КонецЕсли;	
				//СтрокаXPath = "/S:Envelope/S:Body/ns3:importPolicyResponse/policy/ns4:ID";
				СтрокаXPath = "/S:Envelope/S:Body/ns2:importPolicyResponse/policy/ns4:ID";
				ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
				Если ВыборкаXMLНод.length = 0 Тогда
					Текст.ДобавитьСтроку(XMLОтвет.xml);
					//IDПолиса = "";
				Иначе	
					_IDПолиса = ВыборкаXMLНод.item(0).text;
					Если ПустаяСтрока(_IDПолиса)= ИСТИНА ИЛИ (_IDПолиса<>Документ.IDПолиса) Тогда
						IDПолиса = _IDПолиса;
					КонецЕсли;	
					
				КонецЕсли;	
			КонецЕсли;
			
			
			//Корешок = Ответ.DocumentElement;
			//Если ВыборкаXMLНод.length = 0 Тогда
			//	
			//КонецЕсли;
		Иначе
			//Не подготовлены данные
		КонецЕсли;
		Если _IDПолиса = 0 Тогда
		Иначе
			Документ.IDПолиса = IDПолиса;	
		КонецЕсли;	
		Обработка.ЗакрытьAccID();
	Иначе
		Текст.ДобавитьСтроку("Соединение не инициализировано");
	КонецЕсли;	
	
	Возврат Текст;
	
КонецФункции

Функция ПроизвестиКалькуляцию(ДанныеДляЗаполнения,Текст = Неопределено, Обработка = Неопределено,ИмяМакета = "ШаблонКалькуляции") Экспорт
	
	Обработка = ЭтотОбъект;
	
	ТребуетсяЗакрытьСессию = ЛОЖЬ;	
	
	Если Текст = Неопределено Тогда
		//	
		Текст = Новый ТекстовыйДокумент;
	КонецЕсли;	
	
	Если ДанныеДляЗаполнения = Неопределено Тогда
		
		Если НЕ Документ.ПодготовитьДанные(Обработка.AccId,ДанныеДляЗаполнения) = Истина Тогда
			Текст.ДобавитьСтроку("Не подготовлены данные для калькуляции");
			Если ТребуетсяЗакрытьСессию = Истина Тогда
				Обработка.ЗакрытьAccID();
			Конецесли;	
			Возврат ЛОЖЬ;
		КонецЕсли;	
	Конецесли;	
	
	ТекстЗапросаXML = ЗаполнитьМакет(ИмяМакета,ДанныеДляЗаполнения,"МакетВодительРСАX");
	
	///Сообщить(Результат);
	XMLОтвет = Обработка.ЗапросSoap("calcByProductType",ТекстЗапросаXML);
	Если XMLОтвет = Неопределено Тогда
		Текст.ДобавитьСтроку("Не получено ответа на запрос");
		Текст.ДобавитьСтроку("--------Проект запроса "+Имямакета+"-------");
		Сообщить(ТекстЗапросаXML);
	Иначе	
		//Сообщить(XMLОтвет.xml);//XMLОтвет.text);
		СтрокаXPath = //"/S:Envelope/S:Body/ns3:calcByProductTypeResponse/calcPolicyResult/calcResult/errors/error/message";//Полный
		//"/S:Envelope/S:Body/ns3:calcByProductTypeResponse//errors/error/message";//Более универсальный?
		//"//errors/error/message";//Еще более универсальный?
		"//errors/error[message or type]";
		//XMLОтвет.selectNodes("//errors/error/message");
		ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
		//Корешок = Ответ.DocumentElement;
		Если ВыборкаXMLНод.length = 0 Тогда
			//Нет ошибок
			СтрокаXPath = "//calcPolicyResult/calcResult/policy/ns4:calcID";
			ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
			ЭлементВыборки = ВыборкаXMLНод.item(0);
			
			Если ЭлементВыборки = Неопределено Тогда
			Иначе
				КодКалькуляции = ЭлементВыборки.text;	
			КонецЕсли;	
			//
			Если ПустаяСтрока(КодКалькуляции)= ИСТИНА ИЛИ (КодКалькуляции<>Документ.IDКалькуляции) Тогда
				Документ.IDКалькуляции = КодКалькуляции;
			КонецЕсли;	
			
			//СтрокаXPath = "/S:Envelope/S:Body/ns3:calcByProductTypeResponse/calcPolicyResult/calcResult/policy/ns4:insPremTotal";
			СтрокаXPath = "//calcPolicyResult/calcResult/policy/ns4:insPremTotal";
			ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
			
			Для каждого ХМЛнода из ВыборкаXMLНод Цикл
				СтраховаяПремия = ХМЛнода.text;
				Прервать;
			КонецЦикла;
			
			//Сообщить(СтраховаяПремия);
			
			Попытка
				СтраховаяПремия = 	Число(СтраховаяПремия);
			Исключение
				СтраховаяПремия = 0;
			КонецПопытки;
			Документ.УстановитьПараметр("СтраховаяПремияРиск",  СтраховаяПремия);
			Документ.УстановитьПараметр("ПлатежСумма",          СтраховаяПремия);
			
			СписокЗначений = Новый СписокЗначений;
			
			//Значения
			//СтрокаXPath = "/S:Envelope/S:Body/ns3:calcByProductTypeResponse/calcPolicyResult/calcResult/policy/ns4:riskInfo/ns4:risk/ns4:koefficients/ns4:koefficient/ns4:value";
			СтрокаXPath = "//calcPolicyResult/calcResult/policy/ns4:riskInfo/ns4:risk/ns4:koefficients/ns4:koefficient/ns4:value";
			ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
			Для каждого ХМЛнода из ВыборкаXMLНод Цикл
				СписокЗначений.Добавить(ХМЛнода.Text);
			КонецЦикла;	
			//Имена
			//СтрокаXPath = "/S:Envelope/S:Body/ns3:calcByProductTypeResponse/calcPolicyResult/calcResult/policy/ns4:riskInfo/ns4:risk/ns4:koefficients/ns4:koefficient/ns4:name";
			СтрокаXPath = "//calcPolicyResult/calcResult/policy/ns4:riskInfo/ns4:risk/ns4:koefficients/ns4:koefficient/ns4:name";
			ВыборкаXMLНод = XMLОтвет.selectNodes(СтрокаXPath);
			Счетчик = 0;
			Для каждого ХМЛнода из ВыборкаXMLНод Цикл
				ЭлементСписка =  СписокЗначений[Счетчик];
				ЭлементСписка.Представление = ХМЛнода.Text;
				//Сообщить(ХМЛнода.Text+"="+ЭлементСписка.Значение);
				нСтрокиДанные = Документ.Данные.НайтиСтроки(Новый Структура("Параметр",ХМЛнода.Text));
				Если нСтрокиДанные.Количество() = 0 Тогда
					Сообщить("Не найдена строка данных с именем: "+ ХМЛнода.Text);
				Иначе
					нСтрокиДанные[0].Значение = Число(ЭлементСписка.Значение);
					нСтрокиДанные = ДанныеДляЗаполнения.НайтиСтроки(Новый Структура("Параметр",ХМЛнода.Text));
					Если нСтрокиДанные.Количество() > 0 Тогда
						нСтрокиДанные[0].Значение = Число(ЭлементСписка.Значение);
					КонецЕсли;	
				КонецЕсли;	
				Счетчик = Счетчик+1;
			КонецЦикла;
			//Возврат Неопределено;;
			
			Соответствие = ПрочитатьОтветРСА(XMLОтвет);
			Для каждого ЭлементСоответствия из Соответствие Цикл
				ИмяДанных =  ЭлементСоответствия.Значение.Имя;
				
				Если ПустаяСтрока(ИмяДанных) = ЛОЖЬ Тогда
					нСтрокиДанные =	Документ.Данные.НайтиСтроки(Новый Структура("Параметр",ИмяДанных));
					Если нСтрокиДанные.Количество()>0 Тогда
						//
						Если ЗначениеЗаполнено (нСтрокиДанные[0].Значение) и Найти(ИмяДанных,"КБМ") = ЛОЖЬ Тогда
							
						Иначе	
							нСтрокиДанные[0].Значение = ЭлементСоответствия.Значение.Значение;
						КонецЕсли;	
					Иначе
						//!!! 
						//Сообщить ("Заполнение по РСА: не найден  параметр с именем "+ИмяДанных);
					КонецЕсли;	
					
				КонецЕсли;
					 
			КонецЦикла; 
			Документ.УстановитьПараметр("СтраховаяПремияВсего", СтраховаяПремия,,Истина);
		Иначе	
			Для каждого ХМЛнода из ВыборкаXMLНод Цикл
				Текст.ДобавитьСтроку("--------Ошибки калькуляции-----------------");
				Текст.ДобавитьСтроку(ХМЛнода.Text);
			КонецЦикла;	
			Если ТребуетсяЗакрытьСессию = Истина Тогда
				Обработка.ЗакрытьAccID();
			Конецесли;	
			Возврат Ложь;
		КонецЕсли;//Ошибки калькуляции	
	КонецЕсли;	//Наличие ответа
	
	Если ТребуетсяЗакрытьСессию = Истина Тогда
		Обработка.ЗакрытьAccID();
	Конецесли;	
	Возврат Истина;
