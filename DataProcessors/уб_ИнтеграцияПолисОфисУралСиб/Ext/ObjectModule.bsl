Функция ЗакрытьAccID()  Экспорт
	
	Если НЕ AccID = Неопределено и AccID<>"" Тогда
		ТекстЗапроса ="<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:ser=""http://service.insurance.lois.ru/"">
		|   <soapenv:Header/>
		|   <soapenv:Body>
		|      <ser:logOut>"+AccID+"</ser:logOut>
		|   </soapenv:Body>
		|</soapenv:Envelope>";
		
		оXML = ЗапросSoap("LogOut",ТекстЗапроса);
		Если оXML = Неопределено Тогда
		Иначе
			ОтветСтрока  = оXML.text;
			Если не ПустаяСтрока(ОтветСтрока) Тогда
				Сообщить("Ответ при закрытии "+AccID+" "+ОтветСтрока);
			Иначе
				AccID = Неопределено;
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции

Функция ЗапросSoap(МетодСервиса,ТекстЗапроса)  Экспорт
	Запрос = Новый COMОбъект("MSXML2.DOMDocument");
	Запрос.loadXML(ТекстЗапроса);
	//Попытка
	xmlHttp = Новый COMОбъект("MSXML2.xmlHttp");
	xmlHttp.OPEN ("POST", АдресСервиса, 0);
	xmlHttp.setRequestHeader ("SOAPAction", МетодСервиса);
	xmlHttp.setRequestHeader ("Host", host);
	xmlHttp.setRequestHeader ("Content-type", "text/xml; charset=UTF-8");
	Попытка
		Если ТестовыйРежим Тогда
			//
			Сообщить("--------"+МетодСервиса+"-------");
			Сообщить(ТекстЗапроса);
		Иначе	
			xmlHttp.SEND (Запрос);
			Если xmlHttp.status = 200 Тогда
				оXML = xmlHttp.responseXML;
				//DOCToSave=New COMОбъект("MSXML2.DOMDocument");
				//DOCToSave.loadXML(xmlHttp.responseText);
				Возврат оXML;
			Иначе
				Сообщить("Ошибка");
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("----------ОШИБКА СОЕДИНЕНИЯ попробуйте позднее----------");
		Сообщить(ПреобразоватьОшибку(ОписаниеОшибки()));
		Сообщить(АдресСервиса);
		Сообщить(МетодСервиса);
		Сообщить(host);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПреобразоватьОшибку(ТекстОшибки)
	Если Найти(ТекстОшибки,"Ошибка при вызове метода контекста (send): Произошла исключительная ситуация (msxml3.dll): Не удается найти указанный ресурс")>0 Тогда
		Возврат "Не отвечает сайт"
	Иначе
		Возврат ТекстОшибки
	КонецЕсли;	
	
КонецФункции	


Функция ПолучитьСправочник(ИмяСправочника,ВидСП = "ОСАГО") Экспорт

	

	Попытка	
		ТекстЗапроса ="<?xml version=""1.0"" encoding=""UTF-8""?>
		|<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:ser=""http://service.insurance.lois.ru/"" xmlns:dic=""http://dictionary.policy.ie.lois.ru/"">
		|<soapenv:Header/>
