Функция ЗаполнитьМакет(ИмяМакета,ДанныеДляМакета,ИмяПодМакета="МакетВодительX")Экспорт
	Попытка
		МакетЗапроса = ПолучитьМакет(ИмяМакета);
	Исключение
		Сообщить("Не найден макет "+ИмяМакета);
		Возврат "";
	КонецПопытки;	
	//"ШаблонКалькуляции"
	
	ТекстМакета = МакетЗапроса.ПолучитьТекст();
	
	Для каждого СтрокаДанных из ДанныеДляМакета Цикл
		
		Если Лев(СтрокаДанных.Значение,5) = "Макет" Тогда
			Попытка
				ТекстМакета = СтрЗаменить(ТекстМакета,СтрокаДанных.Параметр,ПолучитьМакет(Сред(СтрокаДанных.Значение,6)).ПолучитьТекст());				
			Исключение
				Сообщить("Ошибка добавления вложенного макета "+Сред(СтрокаДанных.Значение,6));
			КонецПопытки;	
		//Пока частные замены водитля и периода использования
		ИначеЕсли (Лев(СтрокаДанных.Параметр,8) = "Водитель") И  Прав(СтрокаДанных.Параметр,13) = "ПодменаСсылки" Тогда
			ПозПомены = Найти(СтрокаДанных.Параметр,"ПодменаСсылки");
			НомерВодителя = Число(Сред(СтрокаДанных.Параметр,9,ПозПомены-9));
			//В макете есть строки
			//"<!--Водитель1-->";
			//"<!--Водитель2-->";
			// в подмакете есть поля вида "dogovor.obektstrahovaniaauto.dopusk.voditeli.voditel1.vozrast"
			ЗначениеЗамены = ".voditel1.";
			ЗначениеНаЧто  = ".voditel"+НомерВодителя+".";
			ЗначениеВГлавномМакете = "<!--Водитель"+НомерВодителя+"-->";
			//Готовим подмакет
			Подмакет = ПолучитьМакет(ИмяПодМакета).ПолучитьТекст();
			Подмакет = СтрЗаменить(Подмакет,ЗначениеЗамены,ЗначениеНаЧто);
			ЗначениеЗамены = "ВодительX";
			ЗначениеНаЧто  = "Водитель"+НомерВодителя;
			Подмакет = СтрЗаменить(Подмакет,ЗначениеЗамены,ЗначениеНаЧто);
			//заменяем в шаблоне на  готовые подмакеты
			ТекстМакета = СтрЗаменить(ТекстМакета,ЗначениеВГлавномМакете,Подмакет);				
		ИначеЕсли (Лев(СтрокаДанных.Параметр,19) = "ПериодИспользования") И  Прав(СтрокаДанных.Параметр,6) = "Начало" Тогда
			ПозПомены = Найти(СтрокаДанных.Параметр,"Начало");
			НомерПериода = Число(Сред(СтрокаДанных.Параметр,20,ПозПомены-20));
			ИмяПодМакета2 = "МакетПериодыИспользования";
			ЗначениеЗамены = ".periodIspolzovania1.";
			ЗначениеНаЧто  = ".periodIspolzovania"+НомерПериода+".";
			ЗначениеВГлавномМакете = "<!--ПериодИспользования"+НомерПериода+"-->";
			//Готовим подмакет
			Подмакет = ПолучитьМакет(ИмяПодМакета2).ПолучитьТекст();
			Подмакет = СтрЗаменить(Подмакет,ЗначениеЗамены,ЗначениеНаЧто);
			ЗначениеЗамены = "ПериодИспользованияX";
			ЗначениеНаЧто  = "ПериодИспользования"+НомерПериода;
			Подмакет = СтрЗаменить(Подмакет,ЗначениеЗамены,ЗначениеНаЧто);
			//заменяем в шаблоне на  готовые подмакеты
			ТекстМакета = СтрЗаменить(ТекстМакета,ЗначениеВГлавномМакете,Подмакет);					
		//	
		
		КонецЕсли;		
	КонецЦикла;	
	
	Результат = "";
	Для СчетчикСтрок = 1 по СтрЧислоСтрок(ТекстМакета) Цикл
		ТекСтрока = СтрПолучитьСтроку(ТекстМакета,СчетчикСтрок);
		
		ЧтоТоНайдено = Ложь;
		Для каждого СтрокаДанных из ДанныеДляМакета Цикл
			
			Если Найти(ТекСтрока,СтрокаДанных.Параметр)>0 Тогда
				//Предобработчик();
				Значение = Документ.ОтформатироватьЗначение(СтрокаДанных.Значение,СтрокаДанных.Параметр);
				ТекСтрока = СтрЗаменить(ТекСтрока,СтрокаДанных.Параметр,Значение);
				ЧтотоНайдено = Истина;
				
				//Прервать;
			КонецЕсли;	
		КонецЦикла;	
		
		Результат = Результат + ТекСтрока + Символы.ПС;
		
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

