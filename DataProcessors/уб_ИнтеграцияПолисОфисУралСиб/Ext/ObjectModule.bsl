	Соотв.Вставить("dogovor.obektstrahovaniaauto.soobsenieRSA",Новый Структура("Имя,Значение","ОтветРСА"));
	Соотв.Вставить("dogovor.obektstrahovaniaauto.kbmSobstvWithKoeff",Новый Структура("Имя,Значение","КБМСобственникаСКоэф"));
	Соотв.Вставить("dogovor.obektstrahovaniaauto.kbmRSA",Новый Структура("Имя,Значение","КБМОбъектастрахов_РСА"));
	//Соотв.Вставить("dogovor.obektstrahovaniaauto.kbmRSA",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("dogovor.obektstrahovaniaauto.rsaID",Новый Структура("Имя,Значение",""));
	//Соотв.Вставить("",Новый Структура("Имя,Значение",""));
	//Соотв.Вставить("",Новый Структура("Имя,Значение",""));
	
	
	
	Для каждого ХМЛнода из ВыборкаXMLНод Цикл
		ИмяПараметра  = ХМЛнода.text;
		ИскомоеСвойство = Соотв.Получить(ИмяПараметра);
		
		Если ИскомоеСвойство = Неопределено Тогда
			Счетчик = Счетчик+1;
			Продолжить;
		КонецЕсли;	
		
		ТипЗначенияПараметра = xml_doc.selectNodes("//ns4:parameters/ns4:parameter["+Счетчик+"]/ns4:type").item(0).text;
		//Сообщить(ТипЗначенияПараметра);
		Если ТипЗначенияПараметра = "Строка" Тогда
			имяПодСвойства = "stringValue" 
		ИначеЕсли ТипЗначенияПараметра = "Дата" Тогда
			имяПодСвойства = "dateValue" 
		ИначеЕсли ТипЗначенияПараметра = "Целое" Тогда
			имяПодСвойства = "intValue" 
		ИначеЕсли ТипЗначенияПараметра = "Логический" Тогда	
			имяПодСвойства = "boolValue" 
		ИначеЕсли ТипЗначенияПараметра = "Вещественный" Тогда		
			имяПодСвойства = "decimalValue" 
		Иначе 
			имяПодСвойства ="";
			Сообщить("Не известный тип параметра "+ ТипЗначенияПараметра);	
		КонецЕсли;	
		Если Не имяПодСвойства ="" Тогда
		//	Сообщить(ТипЗначенияПараметра);
		//	Сообщить(имяПодСвойства);
			ЗначениеПараметра = "";
			ВыборкаЗначения = xml_doc.selectNodes("//ns4:parameters/ns4:parameter["+Счетчик+"]/ns4:"+имяПодСвойства);
			Если ВыборкаЗначения.length >= 1 Тогда
				ЗначениеПараметра = ВыборкаЗначения.item(0).text;
			КонецЕсли;
			//Сообщить(xml_doc.selectNodes("//ns4:parameters/ns4:parameter["+Счетчик+"]/ns4:"+имяПодСвойства).item(0).text);
			
			ИскомоеСвойство.Значение = МенеджерОбработки.ПривестиЗначениеКТипу(ЗначениеПараметра,ТипЗначенияПараметра);
			//Сообщить(ИскомоеСвойство.Значение);
		Конецесли;

		Счетчик = Счетчик+1;
		
	КонецЦикла;
	Возврат Соотв;
КонецФункции	

