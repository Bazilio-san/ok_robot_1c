//Функция получает менеджер записи регистра уб_ФайлыКПолису
Функция ПолучитьЗаписьРС_ФайлКПолису(ЗначениеСвойствЗаписиРС)
		
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА тогда
		Если ТипЗнч(ЗначениеСвойствЗаписиРС) = Тип("ВыборкаИзРезультатаЗапроса") Тогда 
			Возврат ЗначениеСвойствЗаписиРС;
		Иначе 
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		МЗФайлыКПолису = РегистрыСведений.уб_ФайлыКПолисам.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗФайлыКПолису, ЗначениеСвойствЗаписиРС);
		МЗФайлыКПолису.Прочитать();
		
		Если МЗФайлыКПолису.Выбран() Тогда
			Возврат МЗФайлыКПолису;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
КонецФункции

//Функция получает полное имя файла
//	Параметры:
//		МЗФайлыКПолису - (Менеджер записи регистра сведений уб_ФайлыКПолсу)
//	Возвращает:
//		(Строка) Полный путь до файла
Функция ПолучитьПолноеИмяФайла(МЗФайлыКПолису)
	
	ПутьДоХранилища	= МЗФайлыКПолису.Хранилище.Путь + ?(Прав(МЗФайлыКПолису.Хранилище.Путь, 1)	= "\", "", "\");
	ПутьДоФайла		= МЗФайлыКПолису.ПутьКПапке		+ ?(Прав(МЗФайлыКПолису.ПутьКПапке, 1) 		= "\", "", "\");	
	Возврат ПутьДоХранилища + ПутьДоФайла + МЗФайлыКПолису.ФайлИмя;
	
КонецФункции

//Функция проверяет существование файла
//	Параметры:
//		ПолноеИмяФайла - (Строка) Полный путь до файла
//	Возвращает:
//		(Файл)			если файл существует
//		(Неопределено)	если файл не существует

Функция ОбработатьИзображение(ПолноеИмяФайла, ДатаПубликации = Неопределено, МассивТолькоЧтение = Неопределено, ДатаНачалаПроверки = '00010101')
	
	Файл = Новый Файл(ПолноеИмяФайла);
	Если НЕ Файл.Существует() Тогда
		//непонятно, для чего нужно не писать ошибку по новым файлам. закомментировано
		//Если ДатаПубликации=Неопределено Тогда 
		//ИначеЕсли (ТекущаяДата()- ДатаПубликации)<(3600*24*3) Тогда
		//	Возврат "";
		//КонецЕсли;	
		Если ДатаПубликации = Неопределено Или Не ЗначениеЗаполнено(ДатаНачалаПроверки) Или ДатаПубликации >= ДатаНачалаПроверки Тогда
			Возврат "Файл " + ПолноеИмяФайла + " не существует!"
		КонецЕсли;
	ИначеЕсли Файл.ПолучитьТолькоЧтение() Тогда
		Если МассивТолькоЧтение = Неопределено Тогда
			МассивТолькоЧтение = Новый Массив;
		КонецЕсли;
		МассивТолькоЧтение.Добавить(ПолноеИмяФайла);
		Возврат "У файла " + ПолноеИмяФайла + " выставлен атрибут только для чтения!"
	Иначе		
		Попытка 
			Ком = Новый COMObject("wScript.Shell");
		Исключение
			Возврат ОписаниеОшибки()
		КонецПопытки;
		Если Ком <> Неопределено Тогда
			ВременныйФайл = ПолучитьИмяВременногоФайла(Файл.Расширение);
			КопироватьФайл(Файл.ПолноеИмя, ВременныйФайл);	
			Текст = Новый ЗаписьТекста(ConvertBat, КодировкаТекста.ANSI);
			Текст.ЗаписатьСтроку("@Echo off");
			Текст.ЗаписатьСтроку(Символ(34) + Convert + Символ(34) + "  " + Символ(34) + ВременныйФайл + Символ(34) + " -quality " + Строка(quality) + " " + Символ(34) + ВременныйФайл + Символ(34) + Символы.ПС);
			Текст.ЗаписатьСтроку("exit");
			Текст.Закрыть();
			Попытка
				Ком.Run("cmd /C """ + ConvertBat  + """", 0, Истина);
				Успешно = Истина;
			Исключение
				Успешно = Ложь;
				УдалитьФайлы(ВременныйФайл);
				Возврат ОписаниеОшибки();
			КонецПопытки;
			Если Успешно Тогда
				ПереместитьФайл(ВременныйФайл, Файл.ПолноеИмя);
				Возврат Файл.Размер();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

