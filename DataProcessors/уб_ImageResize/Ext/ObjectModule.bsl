Функция ImageResize(ПереданныйПараметр,ТекстОшибки = "", МассивТолькоЧтение = Неопределено, ДатаНачалаПроверки = '00010101') Экспорт
	
	//Если переданный параметр выборка из регистра уб_ФайлыКПолисам
	ТипЗнчПараметра = ТипЗнч(ПереданныйПараметр);
	Если МассивТолькоЧтение = Неопределено Тогда
		МассивТолькоЧтение = Новый Массив;
	КонецЕсли;
	Если ТипЗнчПараметра = Тип("СтрокаТаблицыЗначений") Или ТипЗнчПараметра = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		МЗФайлыКПолису = ПолучитьЗаписьРС_ФайлКПолису(ПереданныйПараметр);		
		Если МЗФайлыКПолису <> Неопределено Тогда
			ПолноеИмяФайла	= ПолучитьПолноеИмяФайла(МЗФайлыКПолису);
			Результат		= ОбработатьИзображение(ПолноеИмяФайла, МЗФайлыКПолису.ДатаПубликации, МассивТолькоЧтение, ДатаНачалаПроверки);
			ТипЗнчРезультат = ТипЗнч(Результат);
			Если ТипЗнчРезультат = Тип("Строка") Тогда
				//описание ошибки
				Возврат Результат;
			ИначеЕсли ТипЗнчРезультат = Тип("Число") Тогда
				//файл обработан
				Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА тогда
					Справочник = МЗФайлыКПолису.УИД;
					сОбъект = Справочник.ПолучитьОбъект();
					сОбъект.Обработан = ИСТИНА;
					Попытка
						сОбъект.Записать();
					Исключение
						Возврат ОписаниеОшибки();
					КонецПопытки;
				Иначе 
					МЗФайлыКПолису.Обработан = Истина;
					МЗФайлыКПолису.ФайлРазмер = Результат;
					Попытка
						МЗФайлыКПолису.Записать()
					Исключение
						Возврат ОписаниеОшибки()
					КонецПопытки;
				КонецЕсли;
				Возврат Истина;
			Иначе
				//Неопределено
				//ошибку возвращать не требуется, файл не обработан
			КонецЕсли;
		Иначе
			#Если Клиент ТОгда
				// всегда попадает сюда из клиента, если файл не обработан из формы просмотра и отправки на e-mail
				//Сообщить("Не удалось получить менеджер записи уб_ФайлыКПолисам!");
			#Иначе
				Возврат "Не удалось получить менеджер записи уб_ФайлыКПолисам!"
			#КонецЕсли
		КонецЕсли;
		//Если переданный параметр полный путь до файла
	ИначеЕсли ТипЗнчПараметра = Тип("Строка") Тогда
		Результат = ОбработатьИзображение(ПереданныйПараметр);
		Возврат Результат;
	Иначе
		#Если Клиент Тогда
			Сообщить("Переданный параметр не определен! " + ПереданныйПараметр);
		#Иначе
			Возврат "Переданный параметр не определен! " + ПереданныйПараметр 
		#КонецЕсли
	КонецЕсли;
	
КонецФункции

Функция ImageResizeКомандойСистемы(ИмяФайла, quality = 50) Экспорт
	
	Расширение = уб_СЛ.ОпределитьРасширениеФайла(ИмяФайла);
	ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
	КопироватьФайл(ИмяФайла, ВременныйФайл);
	
	ТекстКоманды = Символ(34) + Convert + Символ(34) + "  " + Символ(34) + ИмяФайла + Символ(34) + " -quality " + Строка(quality) + " " + Символ(34) + ВременныйФайл + Символ(34); //+ Символы.ПС
	#Если Клиент Тогда
	КомандаСистемы(ТекстКоманды,"/C");
	#КонецЕсли
	Возврат ВременныйФайл;
	
КонецФункции

