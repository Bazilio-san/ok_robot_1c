&НаКлиенте
Процедура СтраховыеКомпанииОрганизацияАгентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ЛОЖЬ;
	СписокВсех = уб_СЛ.СписокДоступныхОрганизаций();
	НовыйСписок = Новый СписокЗначений;
	НовыйСписок.ЗагрузитьЗначения(СписокВсех);
	
	ТекущийСписок = Элементы.СтраховыеКомпании.ТекущиеДанные.ОрганизацияАгент;
	Для каждого ТекущийЭлементСписка из ТекущийСписок Цикл
		НайденныйЭлементСписка = НовыйСписок.НайтиПоЗначению(ТекущийЭлементСписка.Значение);
		Если НайденныйЭлементСписка = Неопределено Тогда
			Сообщить("Организация "+ТекущийЭлементСписка.Значение+" удалена из списка доступных");
		Иначе
			НайденныйЭлементСписка.Пометка = Истина;
		КонецЕсли;	
		
	КонецЦикла;	
	
	ОписаниеВыбораСписка = Новый ОписаниеОповещения("ПослеОтметкиСписка",ЭтаФорма,Новый Структура("Элемент,ИмяПоля",Элемент,"ОрганизацияАгент"));
	НовыйСписок.ПоказатьОтметкуЭлементов(ОписаниеВыбораСписка, "Отметьте брокеров, для которых действует");
	
КонецПроцедуры


&НаКлиенте
Процедура СтраховыеКомпанииВидыСПНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ЛОЖЬ;
	
	ТекущиеДанные = Элементы.СтраховыеКомпании.ТекущиеДанные;
	
	СписокВсех = уб_СЛ.СписокВидовСП(?(НЕ ТекущиеДанные.Поставщик.Пустая(),ТекущиеДанные.Поставщик,ТекущиеДанные.СтраховаяКомпания),ТекущиеДанные.ОрганизацияАгент.ВыгрузитьЗначения());
	
	НовыйСписок = Новый СписокЗначений;
	НовыйСписок.ЗагрузитьЗначения(СписокВсех);
	
	ТекущийСписок = ТекущиеДанные.ВидыСП;
	Для каждого ТекущийЭлементСписка из ТекущийСписок Цикл
		НайденныйЭлементСписка = НовыйСписок.НайтиПоЗначению(ТекущийЭлементСписка.Значение);
		Если НайденныйЭлементСписка = Неопределено Тогда
			Сообщить("Вид СП "+ТекущийЭлементСписка.Значение+" удален из списка доступных");
		Иначе
			НайденныйЭлементСписка.Пометка = Истина;
		КонецЕсли;	
		
	КонецЦикла;	
	
	ОписаниеВыбораСписка = Новый ОписаниеОповещения("ПослеОтметкиСписка",ЭтаФорма,Новый Структура("Элемент,ИмяПоля",Элемент,"ВидыСП"));
	НовыйСписок.ПоказатьОтметкуЭлементов(ОписаниеВыбораСписка, "Отметьте виды страховых продуктов, для которых действует");
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеОтметкиСписка(Список,ДополнительныеПараметры) Экспорт
	Если Не Список = Неопределено Тогда
		СписокДляЗаписи = Новый СписокЗначений;
		Для каждого ТекущийЭлементСписка из Список Цикл
			Если ТекущийЭлементСписка.Пометка Тогда
				СписокДляЗаписи.Добавить(ТекущийЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;	
		Элементы.СтраховыеКомпании.ТекущиеДанные[ДополнительныеПараметры.имяПоля] = СписокДляЗаписи;
		Если ДополнительныеПараметры.имяПоля = "ОрганизацияАгент" Тогда
			Элементы.СтраховыеКомпании.ТекущийЭлемент = Элементы.СтраховыеКомпанииВидыСП; 
		ИначеЕсли ДополнительныеПараметры.имяПоля = "ВидыСП" Тогда	
			ТекущийЭлемент = Элементы.Добавить; 
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры	

