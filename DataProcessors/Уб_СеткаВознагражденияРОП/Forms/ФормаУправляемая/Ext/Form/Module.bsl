#Область СобытияФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИнициализироватьФорму();
	ОбновитьСеткуНаСервере();
	ПеречитатьНастройкиКлубаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()
	
	Если Параметры.Свойство("Период") Тогда
		РасчетныйПериод = Параметры.Период;
	Иначе	
		Если НЕ ЗначениеЗаполнено(РасчетныйПериод) Тогда
			РасчетныйПериод = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
		Конецесли;	
	Конецесли;	
	
	ПериодЗП = Новый СтандартныйПериод(РасчетныйПериод,КонецМесяца(РасчетныйПериод));
	
	Элементы.Сетка.ТолькоПросмотр = НЕ уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ,ПолныеПрава");
	
	Если Параметры.Свойство("Страница") Тогда
		Попытка
			Этаформа.ТекущийЭлемент = Элементы[Параметры.Страница];
		Исключение
		КонецПопытки;	
	КонецЕсли;	
	
	
КонецПроцедуры	
#КонецОбласти

