	|ИЗ
	|	РегистрСведений.уб_ЗП_ПоказателиРасчетаЗП.СрезПоследних(&Период, ) КАК уб_ЗП_ПоказателиРасчетаЗПСрезПоследних";
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"уб_ЗП_ПоказателиРасчетаЗПСрезПоследних.Период","уб_ЗП_ПоказателиРасчетаЗПСрезПоследних.*");
	Запрос.УстановитьПараметр("Период",РасчетныйПериод);
