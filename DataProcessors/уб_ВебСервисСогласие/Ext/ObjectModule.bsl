Перем мIDКалькуляции Экспорт; 
Перем СтруктураКБМ;

Процедура ВыполнитьКалькуляцию(Текст) Экспорт 
	
	XMLОтвет = queryWinHttp();
	
	//РезультатЗапроса.Очистить();
	Данные  = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Параметр");
	Данные.Колонки.Добавить("Наименование");
	Данные.Колонки.Добавить("Результат");
	
	ФайлXML = Новый COMОбъект("MSXML2.DOMDocument");
	ФайлXML.loadXML(XMLОтвет);
	
	СтрокаXPath = "//S:Envelope/S:Body/ns2:calcProductResponse/data/contract/*";
	ВыборкаXMLНод = ФайлXML.selectNodes(СтрокаXPath);
		
	Для каждого ХМЛнода из ВыборкаXMLНод Цикл
		Если ХМЛнода.nodeName = "error" Тогда 
			СтрокаДанные = Данные.Добавить();
			СтрокаДанные.Параметр = "error";
			СтрокаДанные.Результат = ХМЛнода.Text;
		ИначеЕсли ХМЛнода.nodeName = "result" Тогда 
			СтрокаДанные = Данные.Добавить();
			СтрокаДанные.Параметр = ХМЛнода.nodeName;
			СтрокаДанные.Наименование = "Результат";
			СтрокаДанные.Результат = ХМЛнода.Text;
		ИначеЕсли ХМЛнода.nodeName = "datecalc" Тогда 
			ДатаКалькуляции = ХМЛнода.Text;
			ДатаКалькуляции = СтрЗаменить(ДатаКалькуляции, "-", "");
			ДатаКалькуляции = СтрЗаменить(ДатаКалькуляции, "T", "");
			ДатаКалькуляции = СтрЗаменить(ДатаКалькуляции, ".", "");
			ДатаКалькуляции = СтрЗаменить(ДатаКалькуляции, ":", "");
			ДатаКалькуляции = СтрЗаменить(ДатаКалькуляции, "+", "");
			мIDКалькуляции = ДатаКалькуляции;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДанные = Данные.Добавить();
	СтрокаДанные.Наименование = "Коэфициенты";
	СтрокаXPath = "//S:Envelope/S:Body/ns2:calcProductResponse/data/contract/coeff/*";
	ВыборкаXMLНод = ФайлXML.selectNodes(СтрокаXPath);
	
	Для каждого ХМЛнода из ВыборкаXMLНод Цикл
		Если ХМЛнода.nodeName = "brief" Тогда 
			СтрокаДанные = Данные.Добавить();
			СтрокаДанные.Параметр = ХМЛнода.Text;
		КонецЕсли;
		Если ХМЛнода.nodeName = "name" Тогда
			СтрокаДанные.Наименование = ХМЛнода.Text;
		КонецЕсли;
		Если ХМЛнода.nodeName = "result" Тогда
			СтрокаДанные.Результат = ХМЛнода.Text;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДанные = Данные.Добавить();
	СтрокаДанные.Наименование = "Параметры расчета";
	СтрокаXPath = "//S:Envelope/S:Body/ns2:calcProductResponse/data/contract/param/*";
	ВыборкаXMLНод = ФайлXML.selectNodes(СтрокаXPath);
	
	Для каждого ХМЛнода из ВыборкаXMLНод Цикл
		Если ХМЛнода.nodeName = "brief" Тогда 
			СтрокаДанные = Данные.Добавить();
			СтрокаДанные.Параметр = ХМЛнода.Text;
		КонецЕсли;
		Если ХМЛнода.nodeName = "name" Тогда
			СтрокаДанные.Наименование = ХМЛнода.Text;
		КонецЕсли;
		Если ХМЛнода.nodeName = "result" Тогда
			СтрокаДанные.Результат = ХМЛнода.Text;
		КонецЕсли;
	КонецЦикла;
	
	//Если ТестовыйРежим Тогда 
	//	Данные.ВыбратьСтроку();
	//КонецЕсли;
	
	Текст = ОбработатьРезультат(Данные);
	
	//Возврат Текст;
	//Если Лог тогда
	//	Сообщить("Результат ответа сервера:");
	//	Сообщить(XMLОтвет);
	//КонецЕсли;
КонецПроцедуры

Функция ОбработатьРезультат(ДанныеОтвет)

	Текст = Новый ТекстовыйДокумент;
	
	Если НЕ ДанныеДляЗаполнения = Неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Параметр", "error");
		МассивОшибок = ДанныеОтвет.НайтиСтроки(Отбор);
		Если МассивОшибок.Количество() > 0 Тогда 
			Текст.ДобавитьСтроку("-----Ошибки калькуляции Веб-Сервиса 'Согласие'-----");
			Для Каждого Ошибка Из МассивОшибок Цикл 
				Текст.ДобавитьСтроку("* "+Ошибка.Результат+"");
			КонецЦикла;
			Возврат Текст;
		КонецЕсли;
		
		Соответствие = ПрочитатьОтветРСА(ДанныеОтвет);
		СтраховаяПремия = 0;
		Для каждого ЭлементСоответствия из Соответствие Цикл
			ИмяДанных =  ЭлементСоответствия.Значение.Имя;
			
			Если ПустаяСтрока(ИмяДанных) = ЛОЖЬ Тогда
				нСтрокиДанные =	Документ.Данные.НайтиСтроки(Новый Структура("Параметр",ИмяДанных));
				Если нСтрокиДанные.Количество()>0 Тогда
					//
					//Если ЗначениеЗаполнено (нСтрокиДанные[0].Значение) Тогда		
					//Иначе	
					Попытка
						нСтрокиДанные[0].Значение = Число(ЭлементСоответствия.Значение.Значение);
					Исключение
						нСтрокиДанные[0].Значение = ЭлементСоответствия.Значение.Значение;
					КонецПопытки;
					//КонецЕсли;	
				Иначе
					//!!! 
					//Сообщить ("Заполнение по РСА: не найден  параметр с именем "+ИмяДанных);
				КонецЕсли;	
				Если ИмяДанных = "СтраховаяПремияВсего" Тогда 
					СтраховаяПремия = Число(ЭлементСоответствия.Значение.Значение);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла; 
		Документ.УстановитьПараметр("СтраховаяПремияРиск",  СтраховаяПремия);
		Документ.УстановитьПараметр("ПлатежСумма",          СтраховаяПремия);
		
		//ИмяМакета = "ШаблонИмпорта";
		//Результат = Документ.ЗаполнитьМакет(ИмяМакета,ДанныеДляЗаполнения);
		//
		//Текст.ДобавитьСтроку(Результат);
		IDКалькуляции = мIDКалькуляции;
		
		Возврат Текст;
	Иначе
		Текст.ДобавитьСтроку("Калькуляция не проведена");
		Возврат Текст;
	КонецЕсли;
КонецФункции

Функция ПрочитатьОтветРСА(Таблица)
	Соотв = Новый Соответствие;
	
	Соотв.Вставить("result",Новый Структура("Имя,Значение","СтраховаяПремияВсего"));
	//коэфициенты
	Соотв.Вставить("БазовыйТариф",Новый Структура("Имя,Значение","Базовый тариф"));
	Соотв.Вставить("Кбм",Новый Структура("Имя,Значение","Коэфф. бонус-малус"));
	Соотв.Вставить("КБМ_РСА",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("Км",Новый Структура("Имя,Значение","Коэфф. за мощность двигателя"));
	Соотв.Вставить("Кн",Новый Структура("Имя,Значение","Коэфф-т по грубым нарушениям"));
	Соотв.Вставить("Ко",Новый Структура("Имя,Значение","Коэфф. допуск к управлению"));
	Соотв.Вставить("Кс",Новый Структура("Имя,Значение","Коэфф-т по периоду использования"));
	Соотв.Вставить("Кт",Новый Структура("Имя,Значение","Коэфф. региональный"));
	//параметры расчета
	Соотв.Вставить("Кс_для_периода",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("СобственникЮЛ",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("ТарифнаяЗона",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("Км_пар",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("Ко_",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("КрымИлиСевастополь",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("Кт",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("ТипСобственника",Новый Структура("Имя,Значение",""));
	Соотв.Вставить("ТипТССокр",Новый Структура("Имя,Значение",""));

	Для Каждого Строка Из Таблица Цикл 
		ИмяПараметра  = Строка.Параметр;
		ИскомоеСвойство = Соотв.Получить(ИмяПараметра);
		
		ЗначениеПараметра = Строка.Результат;
		Если НЕ ИскомоеСвойство = Неопределено Тогда 
			ИскомоеСвойство.Значение = ЗначениеПараметра;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Соотв;

