Процедура ЗагрузитьОстатки()  Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_РасчетыСПоставщикамиОстатки.ОрганизацияАгент КАК ОрганизацияАгент,
	|	уб_РасчетыСПоставщикамиОстатки.Контрагент КАК Контрагент,
	|	уб_РасчетыСПоставщикамиОстатки.Валюта,
	|	-уб_РасчетыСПоставщикамиОстатки.СуммаОстаток КАК СуммаОстаток,
	|	-уб_РасчетыСПоставщикамиОстатки.СуммаКВОстаток КАК СуммаКВОстаток,
	|	уб_РасчетыСПоставщикамиОстатки.Категория
	|ИЗ
	|	РегистрНакопления.уб_РасчетыСПоставщиками.Остатки(&ДатаКорректировки, ) КАК уб_РасчетыСПоставщикамиОстатки");
	Запрос.УстановитьПараметр("ДатаКорректировки",ДатаНачала);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ПараметрСоединения =  СтрокаПодключения+" Usr="+Пользователь+"; Pwd="+Пароль;
	
	Base_COM = Неопределено;
	Если уб_ОбменДанными.ПодключитьСоединение(Base_COM, ПараметрСоединения, v) Тогда
	Иначе
		Возврат;
	КонецЕсли;	
	Запрос = Base_COM.NewObject("Запрос");
	ТекстЗапроса="ВЫБРАТЬ
	|	Вложенный.Организация,
	|	Вложенный.Субконто1 КАК Контрагент,
	|	СУММА(Вложенный.Сумма) КАК Сумма,
	|	СУММА(Вложенный.СуммаКВ) КАК СуммаКВ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ХозрасчетныйОстатки.Организация КАК Организация,
	|		ХозрасчетныйОстатки.Субконто1 КАК Субконто1,
	|		ХозрасчетныйОстатки.Субконто2 КАК Субконто2,
	|		0 КАК Сумма,
	|		ХозрасчетныйОстатки.СуммаОстаток КАК СуммаКВ
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет В ИЕРАРХИИ (&СчетКВ), , ) КАК ХозрасчетныйОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ХозрасчетныйОстатки.Организация КАК Организация,
	|		ХозрасчетныйОстатки.Субконто1,
	|		ХозрасчетныйОстатки.Субконто2,
	|		ХозрасчетныйОстатки.СуммаОстаток,
	|		0
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет В ИЕРАРХИИ (&Счет), , ) КАК ХозрасчетныйОстатки) КАК Вложенный
	
	|СГРУППИРОВАТЬ ПО
	|	Вложенный.Организация,
	|	Вложенный.Субконто1
	
	|УПОРЯДОЧИТЬ ПО
	|	Субконто1.Наименование";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Дата",ДатаНачала);
	Запрос.УстановитьПараметр("Счет",Base_COM.ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.09"));
	Запрос.УстановитьПараметр("СчетКВ",Base_COM.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтроковоеПредставлениеКонтрагента = СокрЛП(Base_COM.String(Выборка.Контрагент));
		
		Если Найти(ИсключитьЗагрузкуОстатковПО,СтроковоеПредставлениеКонтрагента)>0 Тогда
			Продолжить;	
		КонецЕсли;	
		
		Контрагент = ПолучитьПоставщика(Выборка.Контрагент);
		
		Организация = ПолучитьОрганизацию(Выборка.Организация);
		Массив = ТаблицаОстатков.НайтиСтроки(Новый Структура("ОрганизацияАгент,Контрагент,Категория",Организация,Контрагент,Перечисления.уб_КатегорияЗадолженности.ОтчетПоставщикуПринят));
		Если Массив.Количество() = 1 Тогда
			СтрокаОстатка = Массив[0];
			//Корректировка
			СтрокаОстатка.СуммаОстаток       = - Выборка.Сумма+СтрокаОстатка.СуммаОстаток;
			СтрокаОстатка.СуммаКВОстаток     = Выборка.СуммаКВ+СтрокаОстатка.СуммаКВОстаток;
		ИначеЕсли Массив.Количество()>1 Тогда
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Более 1 строки по контрагенту "+Контрагент+" / "+Организация);
		Иначе
			СтрокаОстатка = ТаблицаОстатков.Добавить(); 
			СтрокаОстатка.ОрганизацияАгент = Организация;
			СтрокаОстатка.Контрагент = Контрагент; 
			//СтрокаОстатка.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
			СтрокаОстатка.Валюта = ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета;
			СтрокаОстатка.СуммаОстаток       = - Выборка.Сумма;
			СтрокаОстатка.СуммаКВОстаток     = Выборка.СуммаКВ;
		КонецЕсли;	
	КонецЦикла;	
	Автор = ? (СокрЛП(ПараметрыСеанса.ТекущийПользователь)="Не авторизован",Справочники.Пользователи.Robot,ПараметрыСеанса.ТекущийПользователь);
	Для каждого СтрокаОстатка из  ТаблицаОстатков Цикл
		
		//Корректировка не подтвержденной ОП суммы
		Если (СтрокаОстатка.СуммаОстаток<>0) Тогда
			
			Документ = ПолучитьДокументОстатка(СтрокаОстатка.Контрагент,ДатаНачала-1,СтрокаОстатка.ОрганизацияАгент,Перечисления.уб_ВидОперацииВзаиморасчетов.НачальныйОстаток);
			
			Если Документ.Пустая() Тогда
				Об = Документы.уб_ВзаиморасчетСПоставщиком.СоздатьДокумент();
				Об.Автор = Автор;
				Об.ДатаСоздания = ТекущаяДата();
			Иначе
				Об = Документ.ПолучитьОбъект();
			КонецЕсли;	
			
			//Об.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			Об.ВалютаДокумента = ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета;
			Об.Дата  = ДатаНачала-1;
			Об.ДатаИзменения = ТекущаяДата();
			Об.НаправлениеРасчетов = Перечисления.уб_ВидОперацииВзаиморасчетов.НачальныйОстаток;
			Об.ФормаОплаты =  Перечисления.уб_ФормаОплатыВзаиморасчеты.Безналично;
			
			Об.СуммаДокумента  = СтрокаОстатка.СуммаОстаток;
			Об.Поставщик        = СтрокаОстатка.Контрагент;
			Об.ОрганизацияАгент = СтрокаОстатка.ОрганизацияАгент;
			
			//Об.Комментарий = Выборка.Комментарий;
			//
			ДокументГрузится = НЕ Об.Поставщик.Пустая() И НЕ Об.ОрганизацияАгент.Пустая()  И (Об.СуммаДокумента<>0);
			
			Если ДокументГрузится Тогда
				//
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;		
		КонецЕсли;	
		
		Если (СтрокаОстатка.СуммаКВОстаток<>0) Тогда
			
			Документ = ПолучитьДокументОстатка(СтрокаОстатка.Контрагент,ДатаНачала-1,СтрокаОстатка.ОрганизацияАгент,Перечисления.уб_ВидОперацииВзаиморасчетов.НачальныйОстаток);
			
			Если Документ.Пустая() Тогда
				Об = Документы.уб_ВзаиморасчетСПоставщиком.СоздатьДокумент();
				Об.Автор = Автор;
				Об.ДатаСоздания = ТекущаяДата();
			Иначе
				Об = Документ.ПолучитьОбъект();
			КонецЕсли;	
			
			//Об.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			Об.ВалютаДокумента = ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета;
			Об.Дата  = ДатаНачала-1;
			Об.ДатаИзменения = ТекущаяДата();
			Об.НаправлениеРасчетов = Перечисления.уб_ВидОперацииВзаиморасчетов.НачальныйОстаток;
			Об.ФормаОплаты =  Перечисления.уб_ФормаОплатыВзаиморасчеты.Безналично;
			
			Об.СуммаДокумента  = СтрокаОстатка.СуммаКВОстаток;
			Об.Поставщик        = СтрокаОстатка.Контрагент;
			Об.ОрганизацияАгент = СтрокаОстатка.ОрганизацияАгент;
			
			//Об.Комментарий = Выборка.Комментарий;
			//
			ДокументГрузится = НЕ Об.Поставщик.Пустая() И НЕ Об.ОрганизацияАгент.Пустая()  И (Об.СуммаДокумента<>0);
			
			Если ДокументГрузится Тогда
				//
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;		
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

Функция ПолучитьДокументОстатка (Поставщик,Дата,ОрганизацияАгент,Направление)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ВзаиморасчетСПоставщиком.Ссылка
	|ИЗ
	|	Документ.уб_ВзаиморасчетСПоставщиком КАК уб_ВзаиморасчетСПоставщиком
	|ГДЕ
	|	уб_ВзаиморасчетСПоставщиком.Поставщик = &Поставщик
	|	И уб_ВзаиморасчетСПоставщиком.Дата = &Дата
	|	И уб_ВзаиморасчетСПоставщиком.НаправлениеРасчетов ПОДОБНО &НаправлениеРасчетов
	|	И уб_ВзаиморасчетСПоставщиком.ОрганизацияАгент = &ОрганизацияАгент");
	Запрос.УстановитьПараметр("ОрганизацияАгент",ОрганизацияАгент);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("НаправлениеРасчетов",Направление);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Документы.уб_ВзаиморасчетСПоставщиком.ПустаяСсылка();
	КонецЕсли;
	
	
КонецФункции

Функция ПроверитьЗаполнить (Об,ИмяР,Значение,ДокументИзменен)
	Результат = ДокументИзменен;
	
	ЗначениеДляПроверки = Значение;
	
	//Исключенаем ситуации когда ""<>Null и 0001.01.01<>Null !!!TO DO
	Если ЗначениеДляПроверки = Null И ИмяР="НомерВходящегоДокумента" Тогда
		ЗначениеДляПроверки = "";
	ИначеЕсли ЗначениеДляПроверки = Null И ИмяР="ДатаВходящегоДокумента" Тогда
		ЗначениеДляПроверки = Дата(1,1,1);
	КонецЕсли;
		
	Если НЕ Об[ИмяР] = ЗначениеДляПроверки Тогда
		Попытка
			Если ЗначениеЗаполнено(Об.Ссылка) Тогда 
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(""+Об+""+ИмяР+"="+Об[ИмяР]+"/"+ЗначениеДляПроверки);
			Конецесли;
		Исключение
		КонецПопытки;	
		Об[ИмяР] = ЗначениеДляПроверки;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат
КонецФункции;	