Функция ЕстьШтраф(Структура,Период = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ШтрафыСрезПоследних.Период,
	               |	уб_ШтрафыСрезПоследних.Физлицо,
	               |	уб_ШтрафыСрезПоследних.Штраф,
	               |	уб_ШтрафыСрезПоследних.ДатаШтрафа
	               |ИЗ
	               |	РегистрСведений.уб_Штрафы КАК уб_ШтрафыСрезПоследних
	               |ГДЕ
	               |	уб_ШтрафыСрезПоследних.ДатаШтрафа = &ДатаШтрафа
	               |	И уб_ШтрафыСрезПоследних.Физлицо = &Физлицо
	               |	И уб_ШтрафыСрезПоследних.Штраф = &Штраф";
	Запрос.УстановитьПараметр("ДатаШтрафа", Структура.ДатаШтрафа);
	Запрос.УстановитьПараметр("Штраф",      Структура.Штраф);
	Запрос.УстановитьПараметр("Физлицо",    Структура.Физлицо);
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Следующий() Тогда
		Период = Выборка.Период;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	


Функция НачислитьШтрафыСтрая(ТекДата) Экспорт
	
	Если ТекДата<Дата(2017,9,28) 
		или ТекДата>Дата(2019,3,1) 
		Тогда
		Возврат Ложь;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник,
	|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра,
	|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра как Штраф
	|ИЗ
	|	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПоследних(&Дата, ТипПараметра = ""Начислять штраф за опаздание"" или ТипПараметра = ""Начислять штраф за опаздание в план"") КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
	|ГДЕ
	|	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0";
	Запрос.УстановитьПараметр("Дата",ТекДата);
	
	
	ГрафикСотрудников = Обработки.ГрафикСотрудников;
	
	ВидДня        = ГрафикСотрудников.ВидДня(ТекДата);
	ДанныеЖурнала = ГрафикСотрудников.ДанныеЖурнала(ТекДата);
	
	сШтрафО  = СПравочники.уб_ШтрафныеСанкции.НайтиПоКоду(5);
	Если сШтрафО.Пустая() Тогда
		сШтрафО  = СПравочники.уб_ШтрафныеСанкции.НайтиПоКоду("За опоздание на работу");
	КонецЕсли;	
	Если сШтрафО.Пустая() Тогда
		Сообщить("Не найден штраф за опазадание, сообщите разработчикам, автоматческое начисление невозможно");
		Возврат Ложь;
	КонецЕсли;
	сШтрафПлан = Справочники.уб_ШтрафныеСанкции.ШтрафнойПлан;
	
	ЭтоПраздник = ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Праздник;
	Учтенные = Новый Массив;
	
	ДопУсловие = Обработки.ГрафикСотрудников.УсловиеДляДняНедели(ТекДата);
	
	//Выгрузить().ВыгрузитьКолонку("Сотрудник");
	//Для каждого Сотрудник из МассивСотрудников Цикл
	ВыборкаСотрудников = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаСотрудников.Следующий() Цикл
		
		Сотрудник = ВыборкаСотрудников.Сотрудник;
		
		Если Не Учтенные.Найти(Сотрудник) = Неопределено Тогда
			//Уже обработанный сотрудник, такого не должно быть
			Продолжить;
		КонецЕсли;
		Если ВыборкаСотрудников.ТипПараметра = "Начислять штраф за опаздание" Тогда
			ТекШтраф = сШтрафО;
		Иначе
			ТекШтраф = сШтрафПлан;
		КонецЕсли;	
		
		Учтенные.Добавить(Сотрудник);
		
		Если ЭтоПраздник Тогда
			Ответ = Новый Структура("ВремяНачала,ДатаНачала,ДатаОкончания,Вид",Дата(1,1,1),Дата(1,1,1),Дата(1,1,1),Справочники.уб_ТипЗанятостиВС.ПустаяСсылка());
		Иначе	
			Ответ = ГрафикСотрудников.ТекущийГрафикСотрудника(Сотрудник,ДопУсловие,ТекДата);
		КонецЕсли;
		
		ФактическийПриход = Дата(1,1,1);
		Если Ответ.ВремяНачала = ФактическийПриход Тогда
			//выходной или праздник
			Комментарий = "Праздник";
			СтруктураШтрафа = Новый Структура("Физлицо,Штраф,СуммаШтрафа,ОтветственныйЗаНачисление, Автор,ДатаШтрафа, Комментарий,Период,Модификатор",
				Сотрудник,ТекШтраф,0,Справочники.ФизическиеЛица.ПустаяСсылка(),Справочники.Пользователи.Robot,КонецДня(ТекДата),Комментарий,ПараметрыОбмена.Период,Справочники.Пользователи.Robot);
			ПериодСуществующейЗаписи = Неопределено;
			Если ЕстьШтраф(СтруктураШтрафа,ПериодСуществующейЗаписи) = Истина Тогда
				//Сообщить("Начислен "+Сотрудник+" "+ШтрафСотруднику);
				Запись = Регистрысведений.уб_Штрафы.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтруктураШтрафа);
				Запись.Период = ПериодСуществующейЗаписи;
			
				//НачатьТранзакцию();
				Запись.Записать();
				ПараметрыОбмена.Период = ПараметрыОбмена.Период+1;
				//ОтменитьТранзакцию();
			КонецЕсли;	
			Продолжить;
		КонецЕсли;	
			
		нСтроки = ДанныеЖурнала.НайтиСтроки(НОвый Структура("ПользовательФизЛицо",Сотрудник));
		
			
		Для каждого СтрокаЖ из нСтроки Цикл
			ФактическийПриход = СтрокаЖ.Вход-(НачалоДня(ТекДата)-Дата(1,1,1));
			Прервать;
		КонецЦикла;	
		//Сообщить(Сотрудник);
		////Сообщить(Ответ.ДатаНачала);
		//Сообщить(Ответ.ВремяНачала);
		//Сообщить(ФактическийПриход);
		СекундПросрочки = 60;
		
		Если (ФактическийПриход-Ответ.ВремяНачала)>СекундПросрочки или ФактическийПриход = Дата(1,1,1) Тогда
			ШтрафСотруднику = ВыборкаСотрудников.Штраф;
		Иначе
			ШтрафСотруднику = 0;
		КонецЕсли;
		
		Если ШтрафСотруднику >0 Тогда
			//Сообщить("Штраф: "+ШтрафСотруднику);
			Комментарий = "Вход "+?(ФактическийПриход = Дата(1,1,1),"отсутствует","в "+Формат(ФактическийПриход,"ДФ=HH:mm:ss"))+" вместо "+Формат(Ответ.ВремяНачала,"ДФ=HH:mm");
			СтруктураШтрафа = Новый Структура("Физлицо,Штраф,СуммаШтрафа,ОтветственныйЗаНачисление, Автор,ДатаШтрафа, Комментарий,Период,Модификатор",Сотрудник,ТекШтраф,ШтрафСотруднику,Справочники.ФизическиеЛица.ПустаяСсылка(),Справочники.Пользователи.Robot,КонецДня(ТекДата),Комментарий,ПараметрыОбмена.Период,Справочники.Пользователи.Robot);
			Если ЕстьШтраф(СтруктураШтрафа,ПериодСуществующейЗаписи) = Ложь Тогда
				//Сообщить("Начислен "+Сотрудник+" "+ШтрафСотруднику);
				Запись = Регистрысведений.уб_Штрафы.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтруктураШтрафа);
				//НачатьТранзакцию();
				Запись.Записать(Истина);
				ПараметрыОбмена.Период = ПараметрыОбмена.Период+1;
				//ОтменитьТранзакцию();
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ДанныеЖурнала(Знач ДатаИзПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст  = "ВЫБРАТЬ
	                |	журналСобытий.Ссылка,
	                |	журналСобытий.ВерсияДанных,
	                |	журналСобытий.ПометкаУдаления,
	                |	журналСобытий.Предопределенный,
	                |	журналСобытий.Событие,
	                |	журналСобытий.Дата,
	                |	журналСобытий.Пользователь,
	                |	журналСобытий.Информация,
	                |	журналСобытий.Объект
	                |ПОМЕСТИТЬ Журналы
	                |ИЗ
	                |	Справочник.журналСобытий КАК журналСобытий
	                |ГДЕ
	                |	журналСобытий.Дата >= &Дата1
	                |	И журналСобытий.Дата <= &Дата2
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 20000
	                |	журналы.Пользователь.ФизЛицо,
	                |	журналы.Пользователь,
	                |	ФИОФизЛицСрезПоследних.Фамилия КАК Фамилия,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
	                |ПОМЕСТИТЬ ФИО
	                |ИЗ
	                |	Журналы КАК журналы
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
	                |		ПО журналы.Пользователь.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	                |		ПО журналы.Пользователь.ФизЛицо = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Фамилия
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|  Журналы.Пользователь,
					|  НАЧАЛОПЕРИОДА(Журналы.Дата, ДЕНЬ) КАК День,
					|  //Журналы.Событие,
					|  МИНИМУМ(Журналы.Дата) КАК Вход
					|ПОМЕСТИТЬ ВХОД
					|ИЗ
					|  Журналы КАК Журналы
					|ГДЕ
					|	Час(Журналы.Дата)>4 или
					|	Журналы.Событие = ЗНАЧЕНИЕ(Справочник.ВидСобытия.Вход)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	Журналы.Пользователь,
	                |	НАЧАЛОПЕРИОДА(Журналы.Дата, ДЕНЬ)//,
	               // |	Журналы.Событие
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Журналы.Пользователь КАК Пользователь,
	                |	НАЧАЛОПЕРИОДА(Журналы.Дата, ДЕНЬ) КАК День,
	                |	МАКСИМУМ(Журналы.Дата) КАК Выход
	                |ПОМЕСТИТЬ ПоследняяАктивность
	                |ИЗ
	                |	Журналы КАК Журналы
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	Журналы.Пользователь,
	                |	НАЧАЛОПЕРИОДА(Журналы.Дата, ДЕНЬ)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ФИО.ПользовательФизЛицо,
	                |	ФИО.Пользователь,
	                |	ФИО.Фамилия,
	                |	ФИО.Выбытие,
	                |	ФИО.Подразделение,
	                |	ПерваяАктивность.День,
	                |	ПерваяАктивность.Вход,
	                |	ПоследняяАктивность.Выход,
	                |	РАЗНОСТЬДАТ(ПерваяАктивность.Вход, ПоследняяАктивность.Выход, ЧАС) КАК ЧасовРаботы
	                |ИЗ
	                |	ФИО КАК ФИО
	                |		ЛЕВОЕ СОЕДИНЕНИЕ ВХОД КАК ПерваяАктивность
	                |		ПО ФИО.Пользователь = ПерваяАктивность.Пользователь
	                |		ЛЕВОЕ СОЕДИНЕНИЕ ПоследняяАктивность КАК ПоследняяАктивность
	                |		ПО (ПерваяАктивность.Пользователь = ПоследняяАктивность.Пользователь)
	                |			И (ПерваяАктивность.День = ПоследняяАктивность.День)
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ФИО.Пользователь.Наименование,
	                |	ПерваяАктивность.День";
	Запрос.УстановитьПараметр("Дата1",НачалоМесяца(ДатаИзПериода));
	Запрос.УстановитьПараметр("Дата2",КонецМесяца(ДатаИзПериода));
	Возврат Запрос.выполнить().Выгрузить();
КонецФункции	

Функция ТекущийГрафикСотрудника(Сотрудник,ДопУсловие,ДатаИзМесяца) Экспорт
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря,
|	РегламентированныйПроизводственныйКалендарь.ВидДня
|ПОМЕСТИТЬ Даты
|ИЗ
|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
|ГДЕ
|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
|;

|////////////////////////////////////////////////////////////////////////////////
