|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
|		ИНАЧЕ ЕСТЬNULL(Занятость.ДатаОкончания, ЕСТЬNULL(ЗанятостьШирокийДиапазон.ДатаОкончания, КОНЕЦПЕРИОДА(Даты.ДатаКалендаря, ДЕНЬ)))
|	КОНЕЦ КАК ДатаОкончания,
|	ЕСТЬNULL(Занятость.ТипЗанятости, ЕСТЬNULL(ЗанятостьШирокийДиапазон.ТипЗанятости, &Работа)) КАК ТипЗанятости,
|	ВЫБОР
|		КОГДА ЕСТЬNULL(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие, ЛОЖЬ) = ИСТИНА
|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
|		ИНАЧЕ ЕСТЬNULL(Занятость.ВремяНачала, ЕСТЬNULL(ЗанятостьШирокийДиапазон.ВремяНачала, Выбор когда Даты.ДатаКалендаря>ДатаВремя(2019,12,15)и Даты.ВидДня = Значение(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий) Тогда ДатаВремя(1,1,1, 9,0,0) Иначе ДатаВремя(1,1,1) Конец))
|	КОНЕЦ КАК ВремяНачала,
|	ВЫБОР
|		КОГДА ЕСТЬNULL(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие, ЛОЖЬ) = ИСТИНА
|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
|		ИНАЧЕ ЕСТЬNULL(Занятость.ВремяОкончания, ЕСТЬNULL(ЗанятостьШирокийДиапазон.ВремяОкончания, Выбор когда Даты.ДатаКалендаря>ДатаВремя(2019,12,15)и Даты.ВидДня = Значение(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий) Тогда ДатаВремя(1,1,1, 18,0,0)  Иначе ДатаВремя(1,1,1) Конец))
|	КОНЕЦ КАК ВремяОкончания,
|	ЕСТЬNULL(ЗанятостьШирокийДиапазон.ТипЗанятости.Наименование,""Работа"") КАК Наименование,
|	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие,
|	Даты.ВидДня
|ИЗ
|	Даты КАК Даты
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&Дата, Агент = &Агент) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
|		ПО (ИСТИНА)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗанятостьВС КАК ЗанятостьШирокийДиапазон
|		ПО (ЗанятостьШирокийДиапазон.ДатаНачала <= Даты.ДатаКалендаря)
|			И (ЗанятостьШирокийДиапазон.ДатаОкончания >= Даты.ДатаКалендаря)
|			И (ЗанятостьШирокийДиапазон.Агент = &Агент)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗанятостьВС КАК Занятость
|		ПО (Занятость.ДатаНачала = Даты.ДатаКалендаря)
|			И (Занятость.ДатаОкончания = Даты.ДатаКалендаря)
|			И (Занятость.Агент = &Агент)

|УПОРЯДОЧИТЬ ПО
|	Даты.ДатаКалендаря,
|	ДатаНачала УБЫВ";
	
	Запрос.УстановитьПараметр("Агент",	Сотрудник);
	
	Запрос.УстановитьПараметр("Работа",	Справочники.уб_ТипЗанятостиВС.НайтиПоКоду(4));
	
