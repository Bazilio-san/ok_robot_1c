Процедура ЗаполнитьинформациюПосотруднику(Сотрудник,ГрафикСотрудника,ДанныеЖурнала,ВсегоДней,ГОд,Месяц,ТекДень) Экспорт
	
	Для счетчик = 1 по ВсегоДней Цикл
		День = Дата(Год,Месяц,Счетчик);
		//ВидДня = Обработки.ГрафикСотрудников.ВидДня(День);
		//ЭтоПраздник = ЭлементыФормы.Сотрудники.Колонки["День"+Счетчик].ПодсказкаВШапке ="Выходной";
		СтруктураИзПроизводственногоКалендаря = ПроизводственныйКалендарь.Получить(Счетчик);
		ВидДня = СтруктураИзПроизводственногоКалендаря.ВидДня;
		
		ЭтоПраздник = ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Праздник
		или ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Воскресенье 
		или ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Суббота; 
		
		
		нСтроки = ГрафикСотрудника.НайтиСтроки(НОвый Структура("ДатаКалендаря",День));
		Если нСтроки.Количество()=0 Тогда
			Если Не ЭтоПраздник Тогда
				Сотрудник["День"+Счетчик] = Дата(1,1,1,0,0,0);
			КонецЕсли;	
		Иначе	
			Для каждого СтрокаЗ из нСтроки Цикл
				Если Не ЭтоПраздник Тогда
					Сотрудник["День"+Счетчик] = СтрокаЗ.ВремяНачала;
				КонецЕсли;	
				Прервать;
			КонецЦикла;	
		КонецЕсли;
		Если Счетчик <= ТекДень Тогда
			нСтроки = ДанныеЖурнала.НайтиСтроки(НОвый Структура("ПользовательФизЛицо,День",Сотрудник.Сотрудник,День));
			
			ФактическийПриход = Дата(1,1,1);
			ПоследняяАктивность = Дата(1,1,1);
			Для каждого СтрокаЖ из нСтроки Цикл
				ФактическийПриход = СтрокаЖ.Вход-(День-Дата(1,1,1));
				ПоследняяАктивность = СтрокаЖ.Выход;
			КонецЦикла;	
			
			Сотрудник["Факт"+Счетчик] = ФактическийПриход;
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

//Процедура обновляет сооттветствие структур дня и дат месяца по производсвенному календарю
Процедура ОбновитьПроизводственныйКалендарь (ЗарплатныйПериод) Экспорт
	
	ПроизводственныйКалендарь = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря,
	|	РегламентированныйПроизводственныйКалендарь.Пятидневка,
	|	РегламентированныйПроизводственныйКалендарь.Шестидневка,
	|	РегламентированныйПроизводственныйКалендарь.КалендарныеДни,
	|	РегламентированныйПроизводственныйКалендарь.ВидДня
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.Год = &Год
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря >= &ДатаНачала
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря <= &ДатаОкончания");
	Запрос.УстановитьПараметр("Год",Год(ЗарплатныйПериод));
	Запрос.УстановитьПараметр("ДатаНачала",НачалоМесяца(ЗарплатныйПериод));
	Запрос.УстановитьПараметр("ДатаОкончания",КонецМесяца(ЗарплатныйПериод));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДня = Новый Структура;
		СтруктураДня.Вставить("ДатаКалендаря",	Выборка.ДатаКалендаря);
		СтруктураДня.Вставить("Пятидневка",		Выборка.Пятидневка);
		СтруктураДня.Вставить("Шестидневка",	Выборка.Шестидневка);
		СтруктураДня.Вставить("КалендарныеДни",	Выборка.КалендарныеДни);
		СтруктураДня.Вставить("ВидДня",			Выборка.ВидДня);
		//Добавляются два варианта получения данных о календаре
		ПроизводственныйКалендарь.Вставить(Выборка.ДатаКалендаря,СтруктураДня);
		ПроизводственныйКалендарь.Вставить(День(Выборка.ДатаКалендаря),СтруктураДня);
	КонецЦикла;	
	
КонецПроцедуры	