|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
|		ИНАЧЕ ЕСТЬNULL(Занятость.ДатаНачала, ЕСТЬNULL(ЗанятостьШирокийДиапазон.ДатаНачала, Даты.ДатаКалендаря))
|	КОНЕЦ КАК ДатаНачала,
|	ВЫБОР
