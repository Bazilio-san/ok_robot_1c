		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТЗ.Ссылка,
	ТЗ.СтраховойПродуктВид,
	ТЗ.СтраховойПродукт,
	ТЗ.ДатаОкончания,
	ТЗ.ЕстьКредитныйДоговор,
	ТЗ.Курьер,
	ТЗ.ОбъектСтрахования,
	ТЗ.СК,
	ТЗ.Страхователь,
	ТЗ.СтраховаяПремия,
	ТЗ.СтраховаяСумма,
	ТЗ.СтраховойПолис,
	ТЗ.НачисленнаяСуммаВзноса,
	ТЗ.ОплаченоФакт,
	ТЗ.Поле1 КАК НомерВзноса,
	уб_ЗаданияНаПролонгациюСрезПоследних.Ответственный,
	уб_ЗаданияНаПролонгациюСрезПоследних.СтатусПролонгации
ИЗ
	(ВЫБРАТЬ
		СП.Ссылка КАК Ссылка,
		СП.СтраховойПродуктВид КАК СтраховойПродуктВид,
		СП.СтраховойПродукт КАК СтраховойПродукт,
		СП.ДатаОкончания КАК ДатаОкончания,
		СП.ЕстьКредитныйДоговор КАК ЕстьКредитныйДоговор,
		СП.Курьер КАК Курьер,
		СП.ОбъектСтрахования КАК ОбъектСтрахования,
		СП.СК КАК СК,
		СП.Страхователь КАК Страхователь,
		СП.СтраховаяПремия КАК СтраховаяПремия,
		СП.СтраховаяСумма КАК СтраховаяСумма,
		ОП.СтраховойПолис КАК СтраховойПолис,
		ОП.НачисленнаяСуммаВзноса КАК НачисленнаяСуммаВзноса,
		ОП.ОплаченоФакт КАК ОплаченоФакт,
		ВЫБОР
			КОГДА ОП.НомерВзноса &gt; 1
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ КАК Поле1
	ИЗ
		(ВЫБРАТЬ
			уб_СтраховойПолис.Ссылка КАК Ссылка,
			уб_СтраховойПолис.СтраховойПродукт.Вид КАК СтраховойПродуктВид,
			уб_СтраховойПолис.СтраховойПродукт КАК СтраховойПродукт,
			уб_СтраховойПолис.ДатаОкончания КАК ДатаОкончания,
			уб_СтраховойПолис.ЕстьКредитныйДоговор КАК ЕстьКредитныйДоговор,
			уб_СтраховойПолис.Курьер КАК Курьер,
			уб_СтраховойПолис.ОбъектСтрахования КАК ОбъектСтрахования,
			уб_СтраховойПолис.СК КАК СК,
			уб_СтраховойПолис.Страхователь КАК Страхователь,
			уб_СтраховойПолис.СтраховаяПремия КАК СтраховаяПремия,
			уб_СтраховойПолис.СтраховаяСумма КАК СтраховаяСумма
		ИЗ
			Документ.уб_СтраховойПолис КАК уб_СтраховойПолис) КАК СП
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				уб_ОплатаПолисов.СтраховойПолис КАК СтраховойПолис,
				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ОплатаПолисов.НомерВзноса) КАК НомерВзноса,
				СУММА(уб_ОплатаПолисов.НачисленнаяСуммаВзноса) КАК НачисленнаяСуммаВзноса,
				СУММА(уб_ОплатаПолисов.ОплаченоФакт) КАК ОплаченоФакт
			ИЗ
				Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
			
			СГРУППИРОВАТЬ ПО
				уб_ОплатаПолисов.СтраховойПолис) КАК ОП
			ПО СП.Ссылка = ОП.СтраховойПолис) КАК ТЗ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЗаданияНаПролонгацию.СрезПоследних КАК уб_ЗаданияНаПролонгациюСрезПоследних
		ПО ТЗ.Ссылка = уб_ЗаданияНаПролонгациюСрезПоследних.СтраховойПолис
ГДЕ
	уб_ЗаданияНаПролонгациюСрезПоследних.СтатусПролонгации = &amp;Статус</query>
