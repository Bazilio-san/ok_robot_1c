Функция НайтиПриемку (СтрокаДанных,ОбъектПриемки = Ложь,НеОбрезатьУИД36) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст  = "ВЫБРАТЬ
	|	уб_ПриемкаОплатПолисы.Ссылка
	|ИЗ
	|	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
	|ГДЕ
	|	уб_ПриемкаОплатПолисы.УИДСтроки = &УИДСтроки";
	Запрос.УстановитьПараметр("УИДСтроки",""+?(НеОбрезатьУИД36=Истина,СтрокаДанных.PayId,Лев(СтрокаДанных.PayId,36)));
	Выборка  = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Приемка =  Выборка.Ссылка;
		Если ОбъектПриемки = Истина Тогда
			ОбъектПриемки = Приемка.ПолучитьОбъект();
			ОбъектПриемки.ДополнительныеСвойства.Вставить("НеДвигатьСтатусы");
		КонецЕсли;	
	Иначе
		//Поиск приемки по сумме и дате
		Запрос.Текст  = "ВЫБРАТЬ
		|	уб_ПриемкаОплатПолисы.НомерБСО,
		|	уб_ПриемкаОплатПолисы.НомерПолиса,
		|	уб_ПриемкаОплатПолисы.Сумма,
		|	уб_ПриемкаОплатПолисы.Ссылка.Дата КАК Дата,
		|	уб_ПриемкаОплатПолисы.Ссылка,
		|	уб_ПриемкаОплатПолисы.УИДСтроки
		|ИЗ
		|	Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
		|ГДЕ
