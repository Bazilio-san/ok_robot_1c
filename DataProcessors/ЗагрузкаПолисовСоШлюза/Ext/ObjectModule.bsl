Функция СоздатьФизлицо(Персона,ПрежнееФизлицо)
	//Физлицо
	
	
		
	ФИО = Персона.LastName+" "+?(Персона.Свойство("FirstName"),Персона.FirstName+" ","")+?(Персона.Свойство("MiddleName"),Персона.MiddleName,"");
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("Фамилия",Персона.LastName);
	СтруктураЗаполнения.Вставить("Имя",?(Персона.Свойство("FirstName"),Персона.FirstName,""));
	
	Персона.Вставить("Отчество",?(Персона.Свойство("MiddleName"),Персона.MiddleName,""));
		
	СтруктураЗаполнения.Вставить("ДатаРождения",?(Персона.Свойство("BirthDate"),ДатаИзСтроки(Персона.BirthDate),Дата(1,1,1)));
	
	СтруктураЗаполнения.Вставить("Телефон",?(Персона.Свойство("Phone"),Персона.Phone,""));
	СтруктураЗаполнения.Вставить("Пол",?(Персона.Свойство("Gender")=Ложь или Персона.Gender="М",Перечисления.ПолФизическихЛиц.Мужской,Перечисления.ПолФизическихЛиц.Женский));
	естьИзменения = Ложь;
	Если ЗначениеЗаполнено(ПрежнееФизлицо) = Ложь Тогда
		Физлицо           = уб_temp.СсылкаСправочникаПоНаименованию("ФизическиеЛица",ФИО,Истина,,СтруктураЗаполнения);
	Иначе
		Физлицо       = ПрежнееФизлицо; 
		ОбъектФизлицо = ПрежнееФизлицо.ПолучитьОбъект();
		УстановитьЗначение(ОбъектФизлицо.Наименование,ФИО);
		УстановитьЗначение(ОбъектФизлицо.ДатаРождения,СтруктураЗаполнения.ДатаРождения);
		УстановитьЗначение(ОбъектФизлицо.Пол,СтруктураЗаполнения.Пол);
		Если ОбъектФизлицо.Модифицированность() = Истина Тогда
			естьИзменения = Истина;
			ОбъектФизлицо.Записать();
		КонецЕсли;
	КонецЕсли;
	//Гражданство
	Если Персона.Свойство("Citizenship") = Истина и ПустаяСтрока(Персона.Citizenship) = Ложь  и Физлицо.Пустая() = Ложь Тогда
		Страна = Справочники.КлассификаторСтранМира.НайтиПоНаименованию(Персона.Citizenship);
		Если Страна.Пустая() =Ложь Тогда
			Запрос  = Новый Запрос("ВЫБРАТЬ
			|	ГражданствоФизЛицСрезПоследних.Период,
			|	ГражданствоФизЛицСрезПоследних.ФизЛицо,
			|	ГражданствоФизЛицСрезПоследних.Страна,
			|	ГражданствоФизЛицСрезПоследних.НеИмеетПравоНаПенсию,
			|	ГражданствоФизЛицСрезПоследних.НеЯвляетсяНалоговымРезидентомРФ
			|ИЗ
			|	РегистрСведений.ГражданствоФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ГражданствоФизЛицСрезПоследних");
			Запрос.УстановитьПараметр("Физлицо",Физлицо);
			ВыборкаГр = Запрос.Выполнить().выбрать();
			Грузим = Ложь;
			Если ВыборкаГр.Следующий()  Тогда
				Если ВыборкаГр.Страна <> Страна Тогда
					Грузим =Истина;
				КонецЕсли;			
			Иначе
				Грузим = Истина;	
			КонецЕсли;
			Если Грузим = Истина Тогда
				
				МзГр  = РегистрыСведений.ГражданствоФизЛиц.СоздатьМенеджерЗаписи();
				МзГр.Период = НачалоДня(ТекущаяДата());
				МзГр.ФизЛицо = Физлицо;
				МзГр.Страна = Страна;
				МзГр.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	//Паспортные данные
	Если Персона.Свойство("Identification") = Истина и Физлицо.Пустая() = Ложь Тогда
		
		Если Персона.Identification.Свойство("IDTypeValue")и не ПустаяСтрока(Персона.Identification.IDTypeValue) Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения
		|ИЗ
		|	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ПаспортныеДанныеФизЛицСрезПоследних";
		Запрос.УстановитьПараметр("ФизЛицо",);			   
		
		ВыборкаПаспорт = Запрос.Выполнить().Выбрать();
		Если ВыборкаПаспорт.Следующий() Тогда
		Иначе
			МЗ = РегистрыСведений.ПаспортныеДанныеФизЛиц.СоздатьМенеджерЗаписи();
			МЗ.ФизЛицо = Физлицо; 
			МЗ.ДокументВид = Справочники.ДокументыУдостоверяющиеЛичность["ИМНС"+Персона.Identification.IDTypeValue];
			
			Если Персона.Identification.Свойство("IDDate") Тогда
				МЗ.ДокументДатаВыдачи = ДатаИзСтроки(Персона.Identification.IDDate);
			КонецЕсли;	
			Если Персона.Identification.Свойство("IssuingAgency") Тогда
				МЗ.ДокументКемВыдан = Персона.Identification.IssuingAgency;
			КонецЕсли;	
			Identification = 0;
			Если Персона.Identification.Свойство("IDNum") Тогда
				МЗ.ДокументНомер  = Персона.Identification.IDNum;
				Identification = Identification+1;
			КонецЕсли;	
			Если Персона.Identification.Свойство("IDSeries") Тогда
				МЗ.ДокументСерия  = Персона.Identification.IDSeries;
				Identification = Identification+1;
			КонецЕсли;
			
			МЗ.Период = НачалоГода(ТекущаяДата());
			Если Identification < 1 Тогда
				Сообщить(""+ФизЛицо+"Мало данных для записи паспортных данных");
			Иначе
				МЗ.Записать();
			КонецЕсли;	
		КонецЕсли;	
		Иначе
			Сообщить(""+Физлицо+" отсутствует код вида документа удостоверяющего личность");
		КонецЕсли;	
	КонецЕсли;
	
	//ФИО
	Если Физлицо.Пустая() = Ложь  Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ФИО_Физлиц.Период,
		|	ФИО_Физлиц.ФизЛицо,
		|	ФИО_Физлиц.Фамилия,
		|	ФИО_Физлиц.Имя,
		|	ФИО_Физлиц.Отчество
		|ИЗ
		|	РегистрСведений.ФИОФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ФИО_Физлиц";
		Запрос.УстановитьПараметр("ФизЛицо",Физлицо);			   
		ВыборкаФИО = Запрос.Выполнить().Выбрать();
		Если ВыборкаФИО.Следующий() и естьИзменения = Ложь Тогда
		Иначе
			МЗ = РегистрыСведений.ФИОФизЛиц.СоздатьМенеджерЗаписи();
			МЗ.ФизЛицо = Физлицо; 
			//Сообщить(МЗ.ФизЛицо);
			Если Персона.Свойство("LastName") Тогда
				МЗ.Фамилия = Персона.LastName;
			КонецЕсли;	
			Если Персона.Свойство("FirstName") Тогда
				МЗ.Имя = Персона.FirstName;
			КонецЕсли;	
			Если Персона.Свойство("MiddleName") Тогда
				МЗ.Отчество = Персона.MiddleName;
			КонецЕсли;	
			МЗ.Период = НачалоГода(ТекущаяДата());
			МЗ.Записать();
		КонецЕсли;	
	КонецЕсли;
	
	//Адрес
	Если Персона.Свойство("Address") и ЗначениеЗаполнено(Физлицо) = Истина Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект,
		|	КонтактнаяИнформация.Тип,
		|	КонтактнаяИнформация.Вид,
		|	КонтактнаяИнформация.УИД,
		|	КонтактнаяИнформация.Представление,
		|	КонтактнаяИнформация.Поле1,
		|	КонтактнаяИнформация.Поле2,
		|	КонтактнаяИнформация.Поле3,
		|	КонтактнаяИнформация.Поле4,
		|	КонтактнаяИнформация.Поле5,
		|	КонтактнаяИнформация.Поле6,
		|	КонтактнаяИнформация.Поле7,
		|	КонтактнаяИнформация.Поле8,
		|	КонтактнаяИнформация.Поле9,
		|	КонтактнаяИнформация.Поле10,
		|	КонтактнаяИнформация.Комментарий,
		|	КонтактнаяИнформация.ЗначениеПоУмолчанию,
		|	КонтактнаяИнформация.ПользовательЛичногоКонтакта
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Вид = Значение(Справочник.ВидыКонтактнойИнформации.АдресФизЛицаПоПрописке)";
		Запрос.УстановитьПараметр("Объект",Физлицо);
		
		ВыборкаАдр = Запрос.Выполнить().Выбрать();
		Если ВыборкаАдр.Следующий()=Ложь или ИСТИНА //ВыборкаАдр.Представление<>Персона.Address.AddressLine 
			Тогда
			//Сообщить(ОбъектПолиса.Страхователь);
			Address = Персона.Address;
			Если Address.Свойство("AddressLine") = Истина Тогда
				МЗ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				МЗ.Объект = Физлицо;
				МЗ.Тип    = Перечисления.ТипыКонтактнойИнформации.Адрес;
				МЗ.Вид    = Справочники.ВидыКонтактнойИнформации.АдресФизЛицаПоПрописке;
				
				
				//МЗ.Представление =Address.AddressLine; 
				МЗ.УИД = ?(ВыборкаАдр.Количество()=0,0,ВыборкаАдр.УИД);
				
				Если Address.Свойство("ZIP") Тогда
					МЗ.Поле1  = Address.ZIP; //Индекс
				КонецЕсли;
				Если Address.Свойство("Region") Тогда
					МЗ.Поле2  = Address.Region;//Регион
				КонецЕсли;	
				Если Address.Свойство("Area") Тогда
					МЗ.Поле3  = Address.Area;//Район
				КонецЕсли;	
				Если Address.Свойство("City") Тогда
					МЗ.Поле4  = Address.City; //Город
					Если МЗ.Поле4="Москва" Тогда//Идет как регион
						МЗ.Поле4 = "";
						МЗ.Поле2 = "Москва";
					КонецЕсли;
				КонецЕсли;	
				Если Address.Свойство("Settlement") Тогда
					МЗ.Поле5  = Address.Settlement; //Населенный пункт
				КонецЕсли;	
				Если Address.Свойство("Street") Тогда
					МЗ.Поле6  = Address.Street;
				КонецЕсли;	
				Если Address.Свойство("House") Тогда
					МЗ.Поле7  = Address.House;
				КонецЕсли;	
				Если Address.Свойство("Block") Тогда
					МЗ.Поле8  = Address.Block;
				КонецЕсли;	
				Если Address.Свойство("Flat") Тогда
					МЗ.Поле9  = Address.Flat;
				КонецЕсли;	
				//Если Address.Свойство("") Тогда
				//	МЗ.Поле10  = Address.;
				//КонецЕсли;	
				МЗ.Представление = УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдреса(МЗ);
				мз.Записать();
				//Прервать;
			Иначе
				
				//Сообщить("AddressLine "+ОбъектПолиса.Страхователь);
				
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;		
	Возврат Физлицо
КонецФункции	
