Функция ДанныеПоБланкуВПриемке(Операция) Экспорт
	//_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Русский Стандарт");
	//_Поставщик = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Компания Банковского Страхования");
	Если Операция.СтраховаяКомпания = "In-touch" Тогда
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Интач",Ложь);
	ИначеЕсли Операция.СтраховаяКомпания = "Русский Стандарт" Тогда	
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Русский Стандарт",Ложь);
	ИначеЕсли Операция.СтраховаяКомпания = "УралСиб" Тогда	
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","УралСиб",Ложь);
	ИначеЕсли Операция.СтраховаяКомпания = "КупиПолис" Тогда	
		_СК  = СПравочники.Контрагенты.ПустаяСК;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не известная СК в загрузке с сайта "+Операция.СтраховаяКомпания;
		Сообщение.Сообщить();
		_СК  = СПравочники.Контрагенты.ПустаяСК;
	КонецЕсли;
	Операция.СК = _СК;
	Операция.НомерБСО                    = СтрЗаменить(СтрЗаменить(Операция.НомерПолиса,"TRS № ","")," ","");	
	Операция.НомерБСО                    = СтрЗаменить(Операция.НомерБСО,"№","");	
	Если Операция.СтраховойПродукт = 	"ДМС44"	Тогда
		Операция.НомерПолиса = Операция.НомерБСО;
		_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО",
		Операция.СК,
		//Справочники.Организации.НайтиПоКоду("000000012"),//СБ
		Справочники.Организации.НайтиПоКоду("000000013"),  //Новый 
		
		Операция.НомерПолиса,
		Справочники.уб_ВидыБСО.НайтиПоНаименованию("ДМС44",Истина,,Операция.СК));
	ИначеЕсли Операция.СтраховойПродукт = 	"Мигранты"	Тогда
		Операция.НомерПолиса = Операция.НомерБСО;
		_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО",
		Операция.СК,
		//Справочники.Организации.НайтиПоКоду("000000012"),//СБ
		Справочники.Организации.НайтиПоКоду("000000013"),  //Новый 
		Операция.НомерПолиса,
		Справочники.уб_ВидыБСО.НайтиПоНаименованию("Мигранты",Истина,,Операция.СК));
	Иначе
		_СтруктураБСО = ПолучитьДанныеБСОПоНомеруИСК(Операция.НомерБСО,_СК);	
		Операция.СК  = _СтруктураБСО.СК;
	КонецЕсли;
	
	
	
	Операция.ВидБСО                      = _СтруктураБСО.ВидБСО;//ПолучитьБСОПоНаименованию ("Бланк полиса ВЗР",СК);
	Операция.ОрганизацияАгент            = _СтруктураБСО.ОрганизацияАгент;
	Операция.ОрганизацияАгентКвитанции   = Операция.ОрганизацияАгент;//Совпадает
	Операция.Поставщик                   = _СтруктураБСО.Поставщик;
	Операция.ПоставщикКвитанции          = _СтруктураБСО.Поставщик;
	
	Возврат Истина 
