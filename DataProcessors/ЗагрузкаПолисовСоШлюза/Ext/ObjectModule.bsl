Функция ПривестиВТЗ(МС)
	Тз = Новый ТаблицаЗначений;
	Для каждого Соот из МС Цикл
		СтрокаТ = Тз.Добавить();
		Для каждого ЭлСоот Из Соот Цикл
			НашКлюч = Подмена(ЭлСоот.Ключ);
			Если тз.Колонки.Найти(НашКлюч) = Неопределено Тогда
				тз.Колонки.Добавить(НашКлюч);
			КонецЕсли;	
			СтрокаТ[НашКлюч] = ЭлСоот.Значение;
		КонецЦикла;	
	КонецЦикла;	
	Возврат Тз;
КонецФункции	

Функция Подмена(Значение)
	Результат = ""+Значение;
	Если Результат = "InsPeriod" Тогда
		Результат = "ПериодСтрахования";
	ИначеЕсли Результат = "Site" Тогда
		Результат = "Источник";	
	ИначеЕсли Результат = "InsSum" Тогда
		Результат = "СтраховаяСумма";	
	ИначеЕсли Результат = "InsType" Тогда
		Результат = "СтраховойПродукт";	
	ИначеЕсли Результат = "Insurer" Тогда
		Результат = "Страхователь";	
	ИначеЕсли Результат = "InsCurr" Тогда
		Результат = "Валюта";	
	ИначеЕсли Результат = "CardNumber" Тогда
		Результат = "НомерКарты";	
	ИначеЕсли Результат = "Insured" Тогда
		Результат = "Застрахованные";		
	ИначеЕсли Результат = "PayTime" Тогда
		Результат = "ДатаОплаты";			
	ИначеЕсли Результат = "Supplier" Тогда
		Результат = "СтраховаяКомпания";				
	ИначеЕсли Результат = "InsPrem" Тогда
		Результат = "СтраховаяПремия";					
	ИначеЕсли Результат = "PoliceNumber" Тогда
		Результат = "НомерПолиса";						
	ИначеЕсли Результат = "SourceAmountFee" Тогда
		Результат = "Комиссия";							
	ИначеЕсли Результат = "Beneficiary" Тогда
		Результат = "Выгодоприобретатель";								
	ИначеЕсли Результат = "SourceAmountTotal" Тогда
		Результат = "СуммаПлатежаЗаМинусомКомиссии";									
	ИначеЕсли Результат = "SourceAmount" Тогда
		Результат = "СуммаПлатежа";										
	ИначеЕсли Результат = "Acquirer" Тогда
		Результат = "Эквайер";										
	ИначеЕсли Результат = "MONETA.RU" Тогда
		Результат = Справочники.Контрагенты.НайтиПоНаименованию("МОНЕТА.РУ");
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции	

Процедура ДобавитьСтрокуТЗЛогВЗР(ТЗЛог, Текст, Ошибка = Ложь, ТекстИсточника = "") Экспорт
	Если ТЗЛог = Неопределено Тогда
		ТЗЛог = Новый ТаблицаЗначений();
		ТЗЛог.Колонки.Добавить("Текст", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1024)));
		ТЗЛог.Колонки.Добавить("Ошибка",    		Новый ОписаниеТипов("Булево"));
		ТЗЛог.Колонки.Добавить("ТекстИсточника",	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1024)));
	КонецЕсли;
	СтрокаТЗ = ТЗЛог.Добавить();
	СтрокаТЗ.Текст 			= Текст;
	СтрокаТЗ.Ошибка			= Ошибка;
	СтрокаТЗ.ТекстИсточника = ТекстИсточника;
	
КонецПроцедуры

Функция ДатаИзСтроки(дата,Вариант=1) Экспорт
	Попытка
		Если Вариант=1 Тогда
			Возврат Дата(Лев(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Дата,"-","")," ",""),":",""),"T",""),14));
			//2014-11-08 00:00:00
			//2014-11-08T00:00:00.001
		Иначе
			Возврат Дата( Сред (Дата,7,4)+Сред (Дата,4,2)+Сред (Дата,1,2));
		КонецЕсли;	
	Исключение
		Попытка
			Возврат Дата( Сред (Дата,7,4)+Сред (Дата,4,2)+Сред (Дата,1,2));
		Исключение
			Возврат Дата(1,1,1);
		КонецПопытки;
		
	КонецПопытки;
КонецФункции



Функция УстановитьЗнач(Реквизит, НовоеЗначение,ИмяРеквизита="") Экспорт
	
	СтароеЗначение = Неопределено;
	Установлено = УстановитьЗначение(Реквизит, НовоеЗначение, СтароеЗначение);
	Если флОтладка = Истина  и Установлено = Истина Тогда
		Если ЗначениеЗаполнено(СтароеЗначение) =  Ложь Тогда
			СтароеЗначение = "<..>";
		КонецЕсли;	
		Сообщить("Изменено "+ИмяРеквизита+" с " + СтароеЗначение + " на " + НовоеЗначение);
	КонецЕсли;	
	Возврат Установлено;
КонецФункции


Функция НеобходимоДобавитьВОчередь(Полис)
	КоличествоПРиемок = Полис.Payments.Количество();
	Если КоличествоПРиемок > 0 Тогда
		Для каждого СтрокаПлатежей из Полис.Payments Цикл
			ОбъектПриемка = Неопределено;
			ПлатежP = СтрокаПлатежей.Значение;	
			Если ПлатежP.PaymentSystemID ="2" Тогда
				Возврат Истина;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	
		

Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = " ") 
     
    Позиция = НайтиНедопустимыеСимволыXML(Текст); 
    Пока Позиция > 0 Цикл 
        ТекущийСимвол = Сред(Текст, Позиция, 1); 
        Если КодСимвола(ТекущийСимвол) = 21 Тогда    // Параграф. 
            Текст = СтрЗаменить(Текст, ТекущийСимвол, Символ(167)); 
            Позиция = НайтиНедопустимыеСимволыXML(Текст); 
            Продолжить; 
        КонецЕсли; 
        Текст = СтрЗаменить(Текст, ТекущийСимвол, СимволЗамены); 
        Позиция = НайтиНедопустимыеСимволыXML(Текст); 
    КонецЦикла; 
     
    Возврат Текст; 
     
КонецФункции 
