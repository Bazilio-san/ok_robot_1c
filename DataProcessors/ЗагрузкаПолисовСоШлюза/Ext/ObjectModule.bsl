Функция СтрокаПриемки(ОбъектПриемка,UID1C,ОтветыПлатежи,КритическаяОшибка = Ложь)
	
	МассивСтрок = ОбъектПриемка.Полисы.НайтиСтроки(НОвый Структура("УИДСтроки",UID1C));
	Если МассивСтрок.Количество() = 0 Тогда
		//++error++
		СчетчикОшибок = СчетчикОшибок+1;
		ТекстОшибки = "Не найдена строка в приемке с UID %s";
		Ошибка = Новый Структура("msg,num,args",
		ТекстОшибки,
		"2015042010",//Формат(ТекущаяДата(),"ДФ=yyyyMMddhhmmss")+Формат(СчетчикОшибок,"ЧГ="),
		UID1C);
		Сообщить(СтрЗаменить(ТекстОшибки,"%s",Ошибка.args));
		СтрокаОшибки = ОтветыПлатежи.Добавить();
		СтрокаОшибки.Error = Ошибка;
		//--error--
		
		//Перейти ~ЗакрытиеПриемки;
		КритическаяОшибка = Истина;
		СтрокаПриемки = Неопределено;
	Иначе
		СтрокаПриемки = МассивСтрок[0];
	КонецЕсли;
	Возврат СтрокаПриемки;
КонецФункции
						
Функция ПолучитьДанныеПоСтраховке(Параметр)
	
	//Параметр СК,ТипСтрахования,СтраховойПродукт
	Если Параметр.СтраховойПродукт ="Стационар" Тогда
	ИначеЕсли Параметр.СтраховойПродукт = "№4"  Тогда
		//Уралсиб
		Параметр.СтраховойПродукт = "Мигранты";
	ИначеЕсли Параметр.ТипСтрахования = "ВЗР" Тогда
		//РСС
		Параметр.СтраховойПродукт = "ВЗР";
	ИначеЕсли Параметр.СтраховойПродукт = "Стандарт" или Параметр.СтраховойПродукт = "Выгода" или Параметр.СтраховойПродукт = "Экстра" Тогда
		//РСС
		Параметр.СтраховойПродукт = "ДМС44";	
	ИначеЕсли Параметр.СтраховойПродукт ="Мед. помощь" Тогда
		//ВТБ
		Если ЗначениеЗаполнено(Параметр.СК) Тогда
		//Создадим
			уб_temp.СсылкаСправочникаПоНаименованию("уб_СтраховыеПродукты",Параметр.СтраховойПродукт,Истина, Параметр.СК)
		КонецЕсли;	
		//	Параметр.СтраховойПродукт
	Иначе
		Сообщить("Неизвестный продукт "+Параметр.СтраховойПродукт+"/"+Параметр.ТипСтрахования);
	КонецЕсли;	
		
	//Если НЕ Параметр.СтраховойПродукт = "№4" 
	//	 и НЕ Параметр.СтраховойПродукт = "Стационар" Тогда
	//	 Параметр.СтраховойПродукт = "ДМС44";
	//ИначеЕсли Параметр.СтраховойПродукт ="Стационар" Тогда
	//Иначе
	//	Параметр.СтраховойПродукт ="Мигранты";
	//КонецЕсли;
	
	_СтраховойПродукт = уб_temp.СсылкаСправочникаПоНаименованию("уб_СтраховыеПродукты",Параметр.СтраховойПродукт,ЛОЖЬ, Параметр.СК);//Сред(Операция.program,2)//Так правильней, но пока кидаем на один СП
	
	Если _СтраховойПродукт =Неопределено или _СтраховойПродукт.Пустая() Тогда
		_ВидСП  = Перечисления.уб_ВидыСтраховыхПродуктов.ПустаяСсылка();
		_Риск   = Справочники.уб_СтраховыеРиски.ПустаяСсылка();
	Иначе
		_ВидСП = _СтраховойПродукт.Вид;
		ТипыОбъектовИРиски = _СтраховойПродукт.ТипыОбъектовИРиски;
		Если ТипыОбъектовИРиски.Количество()>0 Тогда
			_Риск = ТипыОбъектовИРиски[0].Риск;
		Иначе
			_Риск = уб_temp.СсылкаСправочникаПоНаименованию("уб_СтраховыеРиски", ""+_ВидСП + " (все риски)",Ложь);
		КонецЕсли;
	КонецЕсли;
	//
	_ОбъектСтрахования = уб_temp.СсылкаСправочникаПоНаименованию("уб_ОбъектыСтрахования", Параметр.СтраховойПродукт,ЛОЖЬ);
	
	Если ЗначениеЗаполнено(_ОбъектСтрахования) = Ложь Тогда
		_ОбъектСтрахования = уб_temp.СсылкаСправочникаПоНаименованию("уб_ОбъектыСтрахования", "ДМС44",ЛОЖЬ);
	КонецЕсли;	
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("СтраховойПродукт",_СтраховойПродукт);
	СтруктураРезультат.Вставить("СтраховойПродуктСтрока",Параметр.СтраховойПродукт);
	СтруктураРезультат.Вставить("ВидСП",_ВидСП);
	СтруктураРезультат.Вставить("Риск",_Риск);
	СтруктураРезультат.Вставить("ОбъектСтрахования",_ОбъектСтрахования);
	СтруктураРезультат.Вставить("Организация",Параметр.Организация);//
	Возврат СтруктураРезультат;
	
КонецФункции

Функция НайтиСтраховуюКомпанию(Наименование,ИНН=Неопределено)
	Если Наименование = "In-touch" Тогда
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Интач",Ложь);
	ИначеЕсли Наименование = "Русский Стандарт" Тогда	
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Русский Стандарт",Ложь);
	ИначеЕсли Наименование = "ЗАО Русский Стандарт Страхование" Тогда	
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Русский Стандарт",Ложь);	
	ИначеЕсли Наименование = "УралСиб" Тогда	
		_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","УралСиб",Ложь);
	ИначеЕсли Наименование = "КупиПолис" Тогда	
		_СК  = СПравочники.Контрагенты.ПустаяСК;
	Иначе
		Если ЗначениеЗаполнено(ИНН) Тогда
			Запрос = Новый Запрос ;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10
			               |	Контрагенты.Ссылка
			               |ИЗ
			               |	Справочник.Контрагенты КАК Контрагенты
			               |ГДЕ
			               |	Контрагенты.ИНН = &ИНН";
			Запрос.УстановитьПараметр("ИНН",ИНН);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				_СК =Выборка.Ссылка;
			Иначе
				_СК  = СПравочники.Контрагенты.ПустаяСК;
			КонецЕсли;
		Иначе
			_СК  = СПравочники.Контрагенты.ПустаяСК;	
		КонецЕсли;
		Если _СК  = СПравочники.Контрагенты.ПустаяСК Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не известная СК в загрузке с сайта "+Наименование;
			Сообщение.Сообщить();
			_СК  = СПравочники.Контрагенты.ПустаяСК;
		КонецЕсли;
			
		
	КонецЕсли;
	Возврат _СК;
КонецФункции

Функция ДанныеПоБланку(НомерПолиса,СтраховаяКомпания,СтраховойПродукт,Организация)
	
	КодОргПоУмолчанию = "000000016";
	ЕСли ЗначениеЗаполнено(Организация) = Ложь Тогда
		Организация = Справочники.Организации.НайтиПоКоду(КодОргПоУмолчанию); 
	Иначе
		Если ТипЗнч(Организация)= Тип("Строка") Тогда
			ОрганизацияСсылка = Справочники.Организации.НайтиПоРеквизиту("ИНН",Организация); 
			Если ОрганизацияСсылка.Пустая() Тогда
				Организация = Справочники.Организации.НайтиПоКоду(КодОргПоУмолчанию); 
			Иначе
				Организация = ОрганизацияСсылка; 	
			КонецЕсли;
		ИначеЕсли ТипЗнч(Организация)= Тип("СправочникСсылка.Организации") Тогда	
		Иначе	
			Организация = Справочники.Организации.НайтиПоКоду(КодОргПоУмолчанию); 
		КонецЕсли;	
	КонецЕсли;	
	//Если ФормаОплаты = Неопределено Тогда //От формы оплаты зависит организация
	//	ФормаОплаты = Перечисления.уб_ФормыОплаты.Безнал;
	//КонецЕсли;
	//_СК = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Русский Стандарт");
	//_Поставщик = уб_temp.СсылкаСправочникаПоНаименованию("Контрагенты","Компания Банковского Страхования");
	
	НомерБСО                    = СтрЗаменить(СтрЗаменить(НомерПолиса,"TRS № ","")," ","");	
	НомерБСО                    = СтрЗаменить(НомерБСО,"№","");	
	Если СокрЛП(СтраховойПродукт) = "ДМС44"	Тогда
		НомерПолиса = НомерБСО;
		_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО,СК",
		СтраховаяКомпания,
		//Справочники.Организации.НайтиПоКоду("000000012"),//СБ
		Организация,  //Новый 
		НомерПолиса,
		Справочники.уб_ВидыБСО.НайтиПоНаименованию("ДМС44",Истина,,СтраховаяКомпания),
		СтраховаяКомпания);

	ИначеЕсли СокрЛП(СтраховойПродукт) = "Мигранты" или СокрЛП(СтраховойПродукт) = "Стационар" Тогда
		НомерПолиса = НомерБСО;
		_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО,СК",
		СтраховаяКомпания,
		//Справочники.Организации.НайтиПоКоду("000000012"),//СБ
		Организация,  //Новый 
		НомерПолиса,
		Справочники.уб_ВидыБСО.НайтиПоНаименованию("Мигранты",Истина,,СтраховаяКомпания),
		СтраховаяКомпания);
	ИначеЕсли СокрЛП(СтраховойПродукт) = "№4"	Тогда
		НомерПолиса = НомерБСО;
		_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО,СК",
		СтраховаяКомпания,
		//Справочники.Организации.НайтиПоКоду("000000012"),//СБ
		Организация,  //Новый 
		НомерПолиса,
		Справочники.уб_ВидыБСО.НайтиПоНаименованию("Мигранты",Истина,,СтраховаяКомпания),
		СтраховаяКомпания);	
	//ИначеЕсли СокрЛП(СтраховойПродукт) ="ВЗР" Тогда	
		
	Иначе
	//Поиск по номерным
		_СтруктураБСО = ПолучитьДанныеБСОПоНомеруИСК(НомерБСО,СтраховаяКомпания);	
	КонецЕсли;
	_СтруктураБСО.Вставить("НомерБСО",НомерБСО);
	Возврат _СтруктураБСО;
КонецФункции	

