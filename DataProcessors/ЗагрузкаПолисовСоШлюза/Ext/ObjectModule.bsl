Функция Чтение(Чтение,Знач ИмяОкончанияРекурсии="",Знач ОжидаемоеИмя ="",Знач Родитель ="",ОбъектРодитель = Неопределено)
	
	
	//Узлы с вложениями
	СложныеУзлы = "Insured,Insurer,Person,Identification,Legal,AdditionalFields,Payments,Payment,Address,body,Polices,Police,Field,";
	//Узлы с повторяющимися именами
	Списки = "Payments,Polices,AdditionalFields,";
	
	//ОтладочныйРежим = Истина;
	ТребуетсяЧтение = Истина;
	
	ТипУзлаXMLНачалоЭлемента = ТипУзлаXML.НачалоЭлемента;
	ТипУзлаXMLТекст = ТипУзлаXML.Текст;
	ТипУзлаXMLКонецЭлемента = ТипУзлаXML.КонецЭлемента;
	ТипУзлаXMLНичего = ТипУзлаXML.Ничего;
	ТипУзлаXMLАтрибут = ТипУзлаXML.Атрибут;
	
	Пока Истина Цикл
		Если ТребуетсяЧтение = Ложь Тогда
		Иначе
			Попытка
				Прочитано = Чтение.Прочитать();
				Если НЕ Прочитано = Истина ТОгда
					Прервать;
				КонецЕсли;	
			Исключение
				Сообщить(ОписаниеОшибки());
				Возврат ?(ОбъектРодитель= Неопределено,Новый Структура,ОбъектРодитель);
			КонецПопытки;	
		КонецЕсли;	
		ТребуетсяЧтение = Истина;
		ЛокальноеИмя = ""+Чтение.ЛокальноеИмя;
		Если Чтение.ТипУзла = ТипУзлаXMLНачалоЭлемента Тогда
			
			ЭтоСписок  = Найти(Списки,ЛокальноеИмя+",")>0;
			ЭтоСложный = Найти(СложныеУзлы,ЛокальноеИмя+",") > 0;
			
			Если ЭтоСложный Тогда
				
				ОбъектРезультат = Неопределено;
				Если ЭтоСписок Тогда
					ОбъектРезультат = Новый ТаблицаЗначений;
					ОбъектРезультат.Колонки.Добавить("Ключ");
					ОбъектРезультат.Колонки.Добавить("Значение");
				Иначе	
					ОбъектРезультат = Новый Структура();
				КонецЕсли;
				
				ЭтоТЗ =  ТипЗнч(ОбъектРодитель) = Тип("ТаблицаЗначений");
				//Если ЭтоТЗ  и ОбъектРодитель.Количество() >ОграничениеСписков Тогда //Надо пропускать разобраться по мере возможности
				//Иначе
					ОбъектВлож = Чтение(Чтение,""+ЛокальноеИмя,"--ЗАГРУЗКА--",""+ЛокальноеИмя,ОбъектРезультат);//!!!Рекурсия
				//КонецЕсли;
			
				
				//<!--
				Если флОтладка  = Истина Тогда
					Сообщить(ЛокальноеИмя+"="+ОбъектВлож);
				КонецЕсли;
				//-->
				
				Если  ОбъектРодитель = Неопределено Тогда
					ОбъектРодитель = Новый Структура;//Подумать: есть другие варианты что это не структура, и не сработает, скорее всего да 
				КонецЕсли;	
				Если ЭтоТЗ Тогда
					//Если ОбъектРодитель.Количество() <=ОграничениеСписков Тогда //!!!! не грузим больше 50, теперь фильтруем после загрузки
						СтрокаСписка = ОбъектРодитель.Добавить();
						СтрокаСписка.Ключ     = ЛокальноеИмя; 
						СтрокаСписка.Значение = ОбъектВлож;
					//КонецЕсли;
				
				Иначе	
					ОбъектРодитель.Вставить(ЛокальноеИмя,ОбъектВлож);
				КонецЕсли;
				
			Иначе
				ВсегоАтрибутов = Чтение.КоличествоАтрибутов();
				ВставленоЗначение = Ложь;
				Если НЕ ТипЗнч(ОбъектРодитель) = Тип("ТаблицаЗначений") Тогда
					Для СчетчикАтр = 0 по ВсегоАтрибутов-1 Цикл
						ИмяАтрибута      = Чтение.ЛокальноеИмяАтрибута(СчетчикАтр);
						ЗначениеАтрибута = Чтение.ПолучитьАтрибут(СчетчикАтр);
						Если ИмяАтрибута ="t" Тогда
							ОбъектРодитель.Вставить(ЛокальноеИмя,ЗначениеАтрибута);
							//<!--
							Если флОтладка  = Истина Тогда
								Сообщить(ЛокальноеИмя+"="+ЗначениеАтрибута);
							КонецЕсли;
							ВставленоЗначение = Истина;
						Иначе
							//<!--
							Если флОтладка  = Истина Тогда
								Сообщить(ЛокальноеИмя+ИмяАтрибута+"="+ЗначениеАтрибута);
							КонецЕсли;
							//-->
							ОбъектРодитель.Вставить(ЛокальноеИмя+ИмяАтрибута,ЗначениеАтрибута);
						КонецЕсли;	
					КонецЦикла;
				Иначе
				//Не куда записывать свойства таблицы
				//<!--
					Если флОтладка  = Истина Тогда
					КонецЕсли;	
				//-->
 				КонецЕсли;	
				Прочитано = Чтение.Прочитать();
				Если Прочитано = Ложь Тогда 
					Прервать;//Врядли возможно
				ИначеЕсли Чтение.ТипУзла = ТипУзлаXMLТекст Тогда
					//
					Если НЕ ТипЗнч(ОбъектРодитель) = Тип("ТаблицаЗначений") Тогда
						Если Чтение.ИмеетЗначение = Истина Тогда
							Если ВставленоЗначение = Ложь Тогда
								//<!--
								Если флОтладка  = Истина Тогда
									Сообщить(ЛокальноеИмя+"="+Чтение.Значение);
								КонецЕсли;	
								//-->
								ОбъектРодитель.Вставить(ЛокальноеИмя,Чтение.Значение);
							Иначе	
								//<!--
								//Если флОтладка  = Истина Тогда
									//Сообщить("!"+ЛокальноеИмя+"="+Чтение.Значение);
									ОбъектРодитель.Вставить(ЛокальноеИмя+"Value",Чтение.Значение);
								//КонецЕсли;
								//-->
							КонецЕсли;	
							
						КонецЕсли;	
					Иначе
						//!!!!
						//<!--
						Если флОтладка  = Истина Тогда
						КонецЕсли;	
						//-->
					КонецЕсли;	
				Иначе
					ТребуетсяЧтение = Ложь;//уже прочитано
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXMLКонецЭлемента Тогда	
			Если ЛокальноеИмя = ИмяОкончанияРекурсии Тогда
				Возврат ОбъектРодитель;
			КонецЕсли;	
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXMLТекст Тогда		
		ИначеЕсли Чтение.ТипУзла =ТипУзлаXMLНичего Тогда	
			
		Иначе
			Сообщить("!"+"Тип узла:"+Чтение.ТипУзла);
		КонецЕсли;
		
	КонецЦикла;
	Возврат ОбъектРодитель;
КонецФункции	

Функция СообщитьИзФайла(ИмяФ,Заголовок="",Кодировка="")
	Если Кодировка  = "" Тогда
		Кодировка = КодировкаТекста.UTF8;
	КонецЕсли;	
	Если Заголовок="" Тогда
	Иначе
		Сообщить("Чтение "+Заголовок);
	КонецЕсли;	
	Текст = Новый ТекстовыйДокумент;
	Попытка
		Текст.Прочитать(ИмяФ,Кодировка);
	Исключение
		Сообщить("Ошибка при чтении файла "+ИмяФ+" "+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;	
	
	Сообщить(Текст.ПолучитьТекст());
	Возврат Истина;
КонецФункции

