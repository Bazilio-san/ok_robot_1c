	ПараметрыОбмена.Вставить("ИмяФайла","");
	ПараметрыОбмена.Вставить("ИзФайла",Ложь);
	ПараметрыОбмена.Вставить("ПоказатьОтвет",Ложь);
	ПараметрыОбмена.Вставить("РабочийРежим",Истина);
