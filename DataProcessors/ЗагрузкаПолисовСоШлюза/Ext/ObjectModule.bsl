Функция ПолучитьДанныеБСОПоНомеруИСК (НомерБСО,СК,ГодПолиса = Неопределено) экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДБ.Период КАК Период,
	|	ДБ.Регистратор,
	|	ДБ.НомерСтроки,
	|	ДБ.Активность,
	|	ДБ.ВидБСО,
	|	ДБ.НомерБСО,
	|	ДБ.Подтверждено,
	|	ДБ.Активность КАК Активность,
	|	ДБ.СК,
	|	ДБ.Поставщик,
	|	ДБ.ОрганизацияАгент,
	|	ДБ.АгентОтправитель,
	|	ДБ.Агент,
	|	ДБ.ПоложениеБСО,
	|	ДБ.СостояниеБСО,
	|	ДБ.НомерПолиса,
	|	ДБ.ГодПолиса,
	|	ДБ.СтраховойПолис,
	|	ДБ.НаОснованииБумажногоДокумента,
	|	ДБ.ДатаВозврата,
	|	ДБ.Заявка,
	|	ДБ.КодОперации,
	|	ДБ.Комментарий
	|ИЗ
	|	РегистрСведений.уб_ДвиженияБСО КАК ДБ
	|ГДЕ
	|	(ДБ.НомерБСО = &НомерБСО или ДБ.НомерБСО = &НомерБСО2 или ДБ.НомерБСО = &НомерБСО3)
	//|	И ДБ.СК = &СК
	|	И ДБ.Регистратор ССЫЛКА Документ.уб_ПоступлениеБСО
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ, Выбор когда ДБ.СК = &СК тогда 1 иначе 0 конец");
	Запрос.УстановитьПараметр("НомерБСО",	НомерБСО);						  
	Запрос.УстановитьПараметр("НомерБСО2",	СтрЗаменить(НомерБСО,"-","/"));						  
	Запрос.УстановитьПараметр("НомерБСО3",	"ССС"+НомерБСО);						  
	Запрос.УстановитьПараметр("СК",			СК);						  
	//Поставил в первом Пустую ссылку, чтобы не забывали править поставщика у печатных, понаблюдать
	_СтруктураБСО = Новый Структура("Поставщик,ОрганизацияАгент,НомерПолиса,ВидБСО,СК", Справочники.Контрагенты.ПустаяСсылка(), Справочники.Организации.НайтиПоКоду("000000001"), НомерБСО, Справочники.уб_ВидыБСО.ПустаяСсылка(),Справочники.Контрагенты.ПустаяСК);
	Выборка = Запрос.Выполнить().Выбрать();					  
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(_СтруктураБСО, Выборка);
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не найдено БСО с параметрами " + СК + "/" + НомерБСО;
		Сообщение.Сообщить();	
	КонецЕсли;	
	Возврат _СтруктураБСО;
	
КонецФункции	

