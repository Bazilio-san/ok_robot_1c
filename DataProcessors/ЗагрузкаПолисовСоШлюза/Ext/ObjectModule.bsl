Функция ПреобразоватьНОмерПолиса(_НомерПолиса)
	НомерПолиса = СтрЗаменить(СтрЗаменить(_НомерПолиса,"№","")," ","");
	НомерПолиса = СтрЗаменить(НомерПолиса,"TRS","");//--Временно
