		СоответствиеДоступаКВидуДок.Вставить(Тип,Можно);
	КонецЕсли;	
	Если Можно Тогда
		//
		Можно = ПроверитьПравоДоступаКСодержимому(Док);
	КонецЕсли;	
	Возврат Можно;
