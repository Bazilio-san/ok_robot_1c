&НаСервере
Функция ПолучитьОписаниеДокумента(СсылкаДок) 
	
	Тип = ТипЗнч(СсылкаДок);
	
	Описание="";
	Попытка
		Если Тип = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
			Описание="Заявка "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Менеджер,,Ложь,2,Ложь))+
			?(СсылкаДок.Самовыезд," (Самовыезд)"," для курьера: "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Курьер,,Ложь,2,Ложь)));
			//ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Курьер,,Ложь,2));
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
			Описание="Перемещение БСО "+
			?(ТипЗнч(СсылкаДок.Агент)=Тип("СправочникСсылка.ФизическиеЛица"),"от "+уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Агент,,Ложь,2,Ложь),"из "+СсылкаДок.Агент)
			+ ?(ТипЗнч(СсылкаДок.АгентКуда)=Тип("СправочникСсылка.ФизическиеЛица")," к "+уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.АгентКуда,,Ложь,3,Ложь)," в " +СсылкаДок.АгентКуда);
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ПередачаБСОПоставщику") Тогда
			Описание="Передача от "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Агент,,Ложь,2,Ложь))+" для "+ СсылкаДок.Поставщик+ ?(ЗначениеЗаполнено(СсылкаДок.Курьер)," через "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Курьер,,Ложь,2,Ложь)), "");
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ОплатаПолисов") Тогда	
			Описание= "Оплата от "+
			?(ТипЗнч(СсылкаДок.СтраховойПолис.Страхователь)=Тип("СправочникСсылка.ФизическиеЛица"),уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.СтраховойПолис.Страхователь,,Ложь,2,Ложь),СсылкаДок.СтраховойПолис.Страхователь)+ " через "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Курьер,,Ложь,4,Ложь))+"/"+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Агент,,Ложь,4,Ложь));
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда	
			Описание= "Полис для "+?(ТипЗнч(СсылкаДок.Страхователь)=Тип("СправочникСсылка.ФизическиеЛица"),уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Страхователь,,Ложь,2,Ложь),СсылкаДок.Страхователь)+ " менеджером: "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Агент,,Ложь,5,Ложь))+" через "+СсылкаДок.СК;	
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ЗаявлениеОбУтрате") Тогда	
			Описание= "Заявление об утрате от "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Агент,,Ложь,2,Ложь));
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_УведомлениеПоставщикаОбУтратеБСО") Тогда	
			Описание= "Уведомление об утрате для "+ СсылкаДок.Поставщик;
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда	
			СистемаТЧПлатежи = ПараметрыСеанса.уб_Константы.СистемаТЧПлатежейВПриемкеОплат = Истина;
			Если СистемаТЧПлатежи Тогда
				Описание = "Приемка денег от "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.ПринятоОТ,,Ложь,2,Ложь));
			Иначе
				Описание = "Приемка денег от "+ ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.ПринятоОТ,,Ложь,2,Ложь))+" ("+СсылкаДок.ФормаОплаты+")";
			КонецЕсли;
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ОтчетКассира") Тогда	
			Описание= "Отчет кассира "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Ответственный,,Ложь,2,Ложь))+". Проверено: "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.ОтветственныйФинансы,,Ложь,5,Ложь));
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда		
			Описание= "Отчет поставщику "+СсылкаДок.Поставщик+" создан: "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.ОтветственныйБСО,,Ложь,5,Ложь))+". Проверено: "+ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.ОтветственныйФинансы,,Ложь,5,Ложь));	
		//ППС 24-07-2014	
		ИначеЕсли Тип = Тип("ДокументСсылка.уб_ЗаявкаНаПечать") Тогда	
		    ФЛ = ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Менеджер,,Ложь,2,Ложь));
			Если Не ПустаяСтрока(ФЛ) Тогда
				Описание= "Заявка на печать " + ФИО(уб_КЭШируемые.ФИОФизлицаСтрокой(СсылкаДок.Менеджер,,Ложь,2,Ложь));
			Конецесли;
		Конецесли;
		//ППС 24-07-2014
	Исключение
	КонецПопытки;
	Возврат Описание;
КонецФункции	

Функция ФИО(ФИО)
	ФИО = СокрЛП(ФИО);
	ЧислоПробелов = СтрЧислоВхождений(ФИО," ");
	Если ЧислоПробелов=2 Тогда
		ВремСтрока=ФИО; 
		ФИО="" ;
		Пока Найти(ВремСтрока," ")>0 Цикл
			ФИО = ФИО+Лев(ВремСтрока,Найти(ВремСтрока," "));
			ВремСтрока = Сред(ВремСтрока,Найти(ВремСтрока," ")+1);
		КонецЦикла;	
		ФИО  =СокрЛП(ФИО);
	Иначе
		ЧислоТочек = СтрЧислоВхождений(ФИО,".");
		Если ЧислоТочек=2 Тогда
			ФИО = Лев(ФИО,СтрДлина(ФИО)-2);
		КонецЕсли;	
			
	КонецЕсли;
	Возврат ФИО;
КонецФункции	

