Процедура ПриИзмененииКонтрагентаУведомляемого() Экспорт
	
	ОрганизацияАгент = СозданНаОсновании.ОрганизацияАгент;

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Должность,
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Наименование,
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Фамилия,
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Имя,
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо.Отчество
	|ИЗ
	|	РегистрСведений.уб_ПараметрыДоговоровИОтчетов.СрезПоследних(
	|			&ДатаСреза,
	|			ОрганизацияАгент = &ОрганизацияАгент
	|				И Поставщик = &Поставщик) КАК уб_ПараметрыДоговоровИОтчетовСрезПоследних");
	Запрос.УстановитьПараметр("ДатаСреза",Дата);
	Запрос.УстановитьПараметр("ОрганизацияАгент",ОрганизацияАгент);
	Запрос.УстановитьПараметр("Поставщик", КонтрагентУведомляемый);

	Выборка = Запрос.Выполнить().Выбрать();
	ДолжностьУведомляемого = "";
	ФИОУведомляемого	   = "";
	Если Выборка.Следующий() Тогда
		
		ФИО = СокрЛП(Выборка.КонтактноеЛицоФамилия + " " +  Выборка.КонтактноеЛицоИмя + " " + Выборка.КонтактноеЛицоОтчество);
		Если ПустаяСтрока(ФИО) Тогда
			ФИОУведомляемого = Выборка.КонтактноеЛицоНаименование;
		Иначе
			ФИОУведомляемого = ФИО;
		КонецЕсли;
		ДолжностьУведомляемого = Выборка.КонтактноеЛицоДолжность;
		
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ЗаполнитьНаОснованииПолиса() Экспорт
	
//
Если ТипЗнч(СозданНаОсновании)= Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	уб_СтраховойПолисБСО.НомерБСО
	                      |ИЗ
	                      |	Документ.уб_СтраховойПолис.БСО КАК уб_СтраховойПолисБСО
	                      |ГДЕ
	                      |	уб_СтраховойПолисБСО.Ссылка = &Ссылка
	                      |	И уб_СтраховойПолисБСО.ВидБСО.Тип В(&Тип)");
						  Запрос.УстановитьПараметр("Ссылка",СозданНаОсновании);
						  ТипыБСО = Новый Массив;
						  ТипыБСО.Добавить(Перечисления.уб_ТипыБСО.Полис);
						  ТипыБСО.Добавить(Перечисления.уб_ТипыБСО.ПолисОсаго);
						  
						  Запрос.УстановитьПараметр("Тип",ТипыБСО);
	МассивПолисов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерБСО");					  
	
	Если МассивПолисов.Количество()>0 Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	уб_ДвиженияБСОСрезПоследних.Поставщик
		               |ИЗ
		               |	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
		               |			,
		               |			НомерБСО = &НомерБСО
		               |				И СК = &СК) КАК уб_ДвиженияБСОСрезПоследних";
		Запрос.УстановитьПараметр("НомерБСО", МассивПолисов[0]);
		Запрос.УстановитьПараметр("СК", СозданНаОсновании.СК);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			КонтрагентУведомляемый = Выборка.Поставщик; 
		КонецЕсли;	
	Иначе
		КонтрагентУведомляемый = СозданНаОсновании.СК; 
	КонецЕсли;	
	
						  
	
	ПриИзмененииКонтрагентаУведомляемого();
		
КонецЕсли;	
КонецПроцедуры	
	
