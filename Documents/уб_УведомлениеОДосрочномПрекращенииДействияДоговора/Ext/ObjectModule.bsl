Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	мРежимЗаписи = РежимЗаписи;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение 
	 или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
	Тогда
		Если НЕ МожноПроводитьДокумент() Тогда
			Отказ = Истина;
			тОперация = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, "проведение", "отмену проведения");
			Сообщить("Нет прав на "+тОперация+" документа");
		КонецЕсли;
	КонецЕсли;
    Заголовок = "Запись документа """ + СокрЛП(Ссылка) + """: ";
	
КонецПроцедуры

