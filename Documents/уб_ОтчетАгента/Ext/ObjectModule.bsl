Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПравоПроведенияОА = ПравоДоступа("Проведение", Метаданные());

	ДокументОК = ПроверкаЗаполнения();
	
	Отказ = НЕ (ДокументОК И ПравоПроведенияОА);
	
	Возврат;	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Отказ = НЕ ПравоДоступа("ОтменаПроведения", Метаданные());
	Возврат;	

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	#Если Клиент Тогда
	Оповестить("ПриЗаписиОтчетаАгента", Проведен, ЭтотОбъект);
	#КонецЕсли
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьКоличествоСтрокОплат();

КонецПроцедуры
  