
Функция ПроверкаЗаполнения()
	
	Статус = СтатусСообщения.Важное;	
	Рез = Истина;
	Если Не ЗначениеЗаполнено(Номер) Тогда 
		УстановитьНовыйНомер();
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(Дата) Тогда 
		Дата = ТекущаяДата();
	КонецЕсли; 
	Если Ответственный.Пустая() Тогда 
		Если Не Проведен Тогда
			Отв_й = уб_СС.ПолучКонтрагентаИлиФизлицоПоПльзователю(ПараметрыСеанса.ТекущийПользователь);
			Если Отв_й <> Неопределено Тогда
				Ответственный = Отв_й;
			КонецЕсли;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Ответственный) Тогда 
			#Если Клиент Тогда
				Сообщить("Не заполнено поле 'ОтветственныйБСО'!", Статус);
			#КонецЕсли
			Рез = Ложь;
		КонецЕсли;
	КонецЕсли; 
	#Если Клиент Тогда
		//У сервера нет настроек/нет фин ответственного
		Если ОтветственныйФинансы.Пустая() Тогда 
			Если Не Проведен Тогда
				ОтветственныйФинансы = уб_СС.ПолучитьФИНОтветственного();
			КонецЕсли; 
			Если Не ЗначениеЗаполнено(ОтветственныйФинансы) Тогда 
				Сообщить("Не заполнено поле 'Фин. Ответственный'!",Статус);
				Рез = Ложь;
			КонецЕсли;
		КонецЕсли; 
	#КонецЕсли
	Возврат Рез;
	
КонецФункции



