Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПравоПроведенияОА = ПравоДоступа("Проведение", Метаданные());
	ДокументОК = ПроверкаЗаполнения();
	Отказ = Не (ДокументОК И ПравоПроведенияОА);
	#Если Клиент Тогда
		Если Отказ Тогда
			Предупреждение("Документ не проведен!")
		Иначе
			Оповестить("ПроведениеВОтчетеКассира", Ссылка, ЭтотОбъект)
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Отказ = НЕ ПравоДоступа("ОтменаПроведения", Метаданные());
	Если Не Отказ Тогда
		#Если Клиент Тогда
		Оповестить("ПроведениеВОтчетеКассира", Ссылка, ЭтотОбъект);
		#КонецЕсли
	КонецЕсли; 
	Возврат;	

КонецПроцедуры

