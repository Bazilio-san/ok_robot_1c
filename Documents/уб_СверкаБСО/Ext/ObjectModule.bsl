Функция ПоложениеИСостояниеУбытия(ПоложениеБСО,СостояниеБСО) Экспорт 
	ПБ = Перечисления.уб_ПоложенияБСО;
	СБ = Перечисления.уб_СостоянияБСО;
	Если ПоложениеБСО = ПБ.ПереданВСК
	 или ПоложениеБСО = ПБ.Списан
	 или ПоложениеБСО = ПБ.ОтданКлиенту
	 или ПоложениеБСО = ПБ.ОтданБанку
	 или СостояниеБСО = СБ.Испорчен
	 или СостояниеБСО = СБ.Украден
	 или СостояниеБСО = СБ.Уничтожен
	 или СостояниеБСО = СБ.Утрачен
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция ДайСостояниеИПоложениеБСОДляПостащика(ДанныеСтроки) Экспорт 
	ПБ = Перечисления.уб_ПоложенияБСО;
	СБ = Перечисления.уб_СостоянияБСО;
	
	Если ДанныеСтроки.УстановитьПоложениеБСО = ПБ.ПустаяСсылка() Тогда
		ПоложениеБСО = ДанныеСтроки.ПоложениеБСО;
	Иначе	
		ПоложениеБСО = ДанныеСтроки.УстановитьПоложениеБСО;
	КонецЕсли;
	
	Если ДанныеСтроки.УстановитьСостояниеБСО = СБ.ПустаяСсылка() Тогда
		СостояниеБСО = ДанныеСтроки.СостояниеБСО;
	Иначе	
		СостояниеБСО = ДанныеСтроки.УстановитьСостояниеБСО;
	КонецЕсли;
	
	
	Плж = "";
	Если ЛОЖЬ
		ИЛИ ПоложениеБСО = ПБ.ПолученИзСК
		ИЛИ ПоложениеБСО = ПБ.ВозвращенИзСК
		ИЛИ ПоложениеБСО = ПБ.ПереданНаТочку
		ИЛИ ПоложениеБСО = ПБ.ВозвращенСТочки
	Тогда
		Плж = "На руках";
	ИначеЕсли ПоложениеБСО = ПБ.ПереданВСК Тогда
		Плж = "Передан поставщику (СК)";
	ИначеЕсли ПоложениеБСО = ПБ.Списан Тогда
		Плж = "Списан";
	ИначеЕсли ЛОЖЬ
		или ПоложениеБСО = ПБ.ОтданКлиенту
	 	или ПоложениеБСО = ПБ.ОтданБанку
	Тогда
		Плж = "Отдан клиенту/банку";
	КонецЕсли;
	
	Сст = "";
	Если ЛОЖЬ
		или СостояниеБСО = СБ.ПустойБланк
		или СостояниеБСО = СБ.НеиспользованныйБланк
		или СостояниеБСО = СБ.НеПолностьюОформлен
	Тогда
		Сст = "Неиспользован";
	ИначеЕсли ЛОЖЬ
		или СостояниеБСО = СБ.НедействующийБланк
	Тогда
		Сст = "Не действующий бланк";
	ИначеЕсли ЛОЖЬ
		или СостояниеБСО = СБ.НеполныйБланк
	Тогда
		Сст = "Неполный бланк";
	ИначеЕсли ЛОЖЬ
		или СостояниеБСО = СБ.Оформлен
		или СостояниеБСО = СБ.НеПравильноОформлен
	Тогда
		Сст = "Оформлен";
	ИначеЕсли ЛОЖЬ
		или СостояниеБСО = СБ.Утрачен
		или СостояниеБСО = СБ.Уничтожен
		или СостояниеБСО = СБ.Украден
	Тогда
		Сст = "Утрачен";
	ИначеЕсли ЛОЖЬ
		или СостояниеБСО = СБ.Испорчен
	Тогда
		Сст = "Испорчен";
	КонецЕсли;
	
	СстПлж = Сст + ?(Сст = "","",", ") + Плж;
	СостояниеИПоложениеДляПоставщика = Новый Структура("Положение, Состояние, СостояниеИПоложение",Плж,Сст,СстПлж);
	Возврат СостояниеИПоложениеДляПоставщика;
КонецФункции

