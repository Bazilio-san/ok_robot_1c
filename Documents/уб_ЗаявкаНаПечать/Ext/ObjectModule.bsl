Перем ДанныеШаблона экспорт;
Перем КэшСтрокШаблона Экспорт;
Функция НайтиСтрокуШаблонаПоИмени(имя)
	нСтрока = КэшСтрокШаблона.Получить(Имя);
	Если нСтрока = Неопределено Тогда
		Для каждого СтрокаШ из ДанныеШаблона Цикл
			Если СтрокаШ.Имя = Имя Тогда
				нСтрока = СтрокаШ;
				Прервать;
			ИначеЕсли СтрокаШ.ЕстьИндекс = Истина Тогда
				Для счетчик = 1 по 10 Цикл
					ТекИмя = СтрЗаменить(СтрокаШ.Имя,"X",Счетчик);
					Если ТекИмя = Имя Тогда
						нСтрока = СтрокаШ;
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
		КонецЦикла;	
		КэшСтрокШаблона.Вставить(Имя,нСтрока);//Кэшируем поиск
	Конецесли;
	Возврат нСтрока 
КонецФункции	

Функция Обработчик(ТекстОбработчика,ТекущиеДанные = Неопределено,Элемент=Неопределено) Экспорт
	Если ПустаяСтрока(ТекстОбработчика) = Ложь Тогда
		Попытка
			Выполнить(ТекстОбработчика);
		Исключение
			ТекстОшибки = уб_temp.ОшибкаПоИсходномуКоду(ТекстОбработчика, ОписаниеОшибки());
			Если Не ТекущиеДанные = Неопределено Тогда
				Попытка
					Уточнение = "[" +ТекущиеДанные.Параметр+"] ";
				Исключение
					Уточнение = "";
				КонецПопытки;	
			Иначе
				Уточнение = "";
			КонецЕсли;	
			Возврат "Ошибка при выполнении обработчика "+Уточнение+ТекстОшибки+Символы.ПС+ТекстОбработчика;
		КонецПопытки;	
	КонецЕсли;	
	Возврат  Истина;
КонецФункции

Функция ПолучитьДанныеПолиса() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ЗаявкаНаПечатьБСО.СК как СтраховаяКомпания,
	|	уб_ЗаявкаНаПечатьБСО.ВидБСО,
	|	уб_ЗаявкаНаПечатьБСО.НомерБСО как НомерПолисаПолный,
	|	уб_ЗаявкаНаПечатьБСО.Поставщик,
	|	уб_ЗаявкаНаПечатьБСО.ОрганизацияАгент,
	|	уб_ЗаявкаНаПечатьБСО.ВидБСО.Тип,
	|	уб_ЗаявкаНаПечатьБСО.ВидБСО.ТипУчетаБСО,
	|	ВЫБОР
	|		КОГДА уб_ЗаявкаНаПечатьБСО.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОсаго)
	|			ТОГДА ""ОСАГО""
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(уб_ЗаявкаНаПечать.Шаблон.СтраховойПродукт.Вид)
	|	КОНЕЦ КАК ВидСП
	|ИЗ
	|	Документ.уб_ЗаявкаНаПечать.БСО КАК уб_ЗаявкаНаПечатьБСО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаПечать КАК уб_ЗаявкаНаПечать
	|		ПО уб_ЗаявкаНаПечатьБСО.Ссылка = уб_ЗаявкаНаПечать.Ссылка
	|ГДЕ
	|	(уб_ЗаявкаНаПечатьБСО.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис)
	|			ИЛИ уб_ЗаявкаНаПечатьБСО.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОсаго))
	|	И уб_ЗаявкаНаПечатьБСО.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	//ВыборкаПолисов = Запрос.Выполнить().Выбрать();
	СтруктураБСО = Новый Структура("ВидБСО,НомерПолисаПолный,СтраховаяКомпания,СерияПолиса,НомерПолисаБезСерии,ВидСП");
	//Если ВыборкаПолисов.Следующий() Тогда
	//	//
	//	ЗаполнитьЗначенияСвойств(СтруктураБСО,ВыборкаПолисов);
	//	СерияП = ""; 
	//	НомерП = "";
	//	
	//	уб_страховойБрокер.Получить_Серию_и_Номер_БСО_или_ПОЛИСА_по_НомеруБСО(ВыборкаПолисов.ВидБСО,ВыборкаПолисов.НомерПолисаПолный,СерияП,НомерП );
	//	
	//	СтруктураБСО.Вставить("СерияПолиса",СерияП);
	//	СтруктураБСО.Вставить("НомерПолисаБезСерии",НомерП);
	//Иначе
		Для каждого ВыборкаПолисов из БСО Цикл
			Если ВыборкаПолисов.Подтверждено  = истина и уб_СЛ.ОпределитьЭтоПолис(ВыборкаПолисов.ВидБСО)= Истина тогда
				СерияП = ""; 
				НомерП = "";
				уб_страховойБрокер.Получить_Серию_и_Номер_БСО_или_ПОЛИСА_по_НомеруБСО(ВыборкаПолисов.ВидБСО,ВыборкаПолисов.НомерБСО,СерияП,НомерП );
				СтруктураБСО.Вставить("СерияПолиса",СерияП);
				СтруктураБСО.Вставить("НомерПолисаБезСерии",НомерП);
				СтруктураБСО.Вставить("ВидБСО",ВыборкаПолисов.ВидБСО);
				СтруктураБСО.Вставить("НомерПолисаПолный",ВыборкаПолисов.НомерБСО);
				СтруктураБСО.Вставить("ВидСП",СокрЛП(Шаблон.СтраховойПродукт.Вид));
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	//КонецЕсли;	
	Возврат СтруктураБСО;
КонецФункции	

