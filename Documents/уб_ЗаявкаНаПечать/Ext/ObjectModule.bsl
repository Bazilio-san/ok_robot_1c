Функция УстановитьПараметр(ИмяПараметра,ЗначениеПараметра,СтрокаДанных=Неопределено,ВызватьОбработчик = ЛОЖЬ) Экспорт
	нСтрокиДанные = Данные.НайтиСтроки(Новый Структура("Параметр",ИмяПараметра));
	Если нСтрокиДанные.Количество() = 0 Тогда
		Сообщить("Не найдена строка данных с именем: "+ ИмяПараметра);
		Возврат Ложь;
	Иначе
		СтрокаДанных = нСтрокиДанные[0];
		ЗначениеУстановлено = УстановитьЗначение(СтрокаДанных.Значение,ЗначениеПараметра);
		Если ЗначениеУстановлено и ВызватьОбработчик = ИСТИНА Тогда
			//
			СтрокаШаблона = НайтиСтрокуШаблонаПоИмени(ИмяПараметра);	
			Если Не СтрокаШаблона = Неопределено Тогда
				Обработчик(СтрокаШаблона.ПриИзменении,СтрокаДанных);
			КонецЕсли;	
		КонецЕсли;	
		Возврат ЗначениеУстановлено;
	КонецЕсли;	
КонецФункции	
Функция ПолучитьПараметр(ИмяПараметра,
						 НеНайдено = ЛОЖЬ,
						 ЗначениеНеНайденного = Неопределено,
						 СтрокаДанных = Неопределено,
						 ВыводитьСообщение = Истина) Экспорт
	нСтрокиДанные = Данные.НайтиСтроки(Новый Структура("Параметр",ИмяПараметра));
	Если нСтрокиДанные.Количество() = 0 Тогда
		Если ВыводитьСообщение = ИСТИНА Тогда
			Сообщить("Не найдена строка данных с именем: "+ ИмяПараметра);
		КонецЕсли;	
		НеНайдено = Истина;
		Возврат ЗначениеНеНайденного;
	Иначе
		НеНайдено = Ложь;
		СтрокаДанных = нСтрокиДанные[0];
		Возврат нСтрокиДанные[0].Значение;
	КонецЕсли;	
КонецФункции	
