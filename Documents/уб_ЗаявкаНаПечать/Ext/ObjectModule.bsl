Функция ПодготовитьДанные(НомерСессии, ДанныеКопия = Неопределено, СтруктураДанных = Неопределено, ИмяМакета = "") Экспорт
	
	ДанныеКопия = Данные.Выгрузить();
	ДопСтрока = ДанныеКопия.Добавить();
	ДопСтрока.Параметр=	"IDПолиса";
	ДопСтрока.Значение = IDПолиса;
	
	ДопСтрока = ДанныеКопия.Добавить();
	ДопСтрока.Параметр=	"НомерСессии";
	ДопСтрока.Значение = НомерСессии;
	СтруктураБСО  =  ПолучитьДанныеПолиса();		
	Для каждого ЭлементСтруктуры из СтруктураБСО  Цикл
		ДопСтрока = ДанныеКопия.Добавить();
		ДопСтрока.Параметр = ЭлементСтруктуры.Ключ;
		ДопСтрока.Значение = ЭлементСтруктуры.Значение;
	КонецЦикла;			
	тФизлица = Тип("СправочникСсылка.ФизическиеЛица");
	МасСокр = Новый Массив;
	МасСокр.Добавить(" обл");
	МасСокр.Добавить(" г");
	МасСокр.Добавить(" п");
	МасСокр.Добавить(" рп");
	МасСокр.Добавить(" нп");
	МасСокр.Добавить(" пер");
	МасСокр.Добавить(" пер");
	МасСокр.Добавить(" переезд");
	МасСокр.Добавить(" д");
	МасСокр.Добавить(" с");
	МасСокр.Добавить(" кр");
	МасСокр.Добавить(" ул");
	МасСокр.Добавить(" р-н");
	МасСокр.Добавить(" сл");
	МасСокр.Добавить(" ст");
	МасСокр.Добавить(" ст-ца");
	МасСокр.Добавить(" тер");
	МасСокр.Добавить(" аллея");
	МасСокр.Добавить(" б-р");
	МасСокр.Добавить(" въезд");
	МасСокр.Добавить(" городок");
	МасСокр.Добавить(" дор");
	МасСокр.Добавить(" заезд");
	МасСокр.Добавить(" казарма");
	МасСокр.Добавить(" кв-л");
	МасСокр.Добавить(" км");
	МасСокр.Добавить(" кольцо");
	МасСокр.Добавить(" линия");
	МасСокр.Добавить(" м");
	МасСокр.Добавить(" мкр");
	МасСокр.Добавить(" наб");
	МасСокр.Добавить(" нп");
	МасСокр.Добавить(" остров");
	МасСокр.Добавить(" п");
	МасСокр.Добавить(" п/о");
	МасСокр.Добавить(" п/р");
	МасСокр.Добавить(" п/ст");
	МасСокр.Добавить(" парк");
	МасСокр.Добавить(" пер");
	МасСокр.Добавить(" переезд");
	МасСокр.Добавить(" пл");
	МасСокр.Добавить(" платф");
	МасСокр.Добавить(" пл-ка");
	МасСокр.Добавить(" полустанок");
	МасСокр.Добавить(" починок");
	МасСокр.Добавить(" пр-кт");
	МасСокр.Добавить(" проезд");
	Для каждого СтрокаДанных  из ДанныеКопия Цикл 
		ТипДанных = ТипЗнч(СтрокаДанных.Значение);		
		Если ТипДанных = тФизлица Тогда
			//Дополняем другими данными физлица
			//Значение = Справочники.ФизическиеЛица.НайтиПоНаименованию("");
			Значение = СтрокаДанных.Значение;
			Префикс = СтрокаДанных.Параметр;
			СтрокаДанных.Параметр = СтрокаДанных.Параметр+"ПодменаСсылки";
			//
			
			ДобавитьПараметр(Префикс+"ТипДокумента", "Паспорт гражданина РФ", ДанныеКопия);
			ДобавитьПараметр(Префикс+"ФИО",Значение.Наименование,ДанныеКопия);
			ДанныеФизлица = ОбщегоНазначения.ДанныеФизЛица(Справочники.Организации.ПустаяСсылка(),Значение,ТекущаяДата(),Ложь);
			//Организация, ФизЛицо, ДатаСреза, ФИОКратко = Истина
			//ОбщегоНазначения.ФИО_ФизЛица(Значение,Фамилия,Имя,Отчество);
			ДобавитьПараметр(Префикс+"Фамилия",ДанныеФизлица.Фамилия,ДанныеКопия);
			ДобавитьПараметр(Префикс+"Имя",ДанныеФизлица.Имя,ДанныеКопия);
			ДобавитьПараметр(Префикс+"Отчество",ДанныеФизлица.Отчество,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ДокументСерия",ДанныеФизлица.ДокументСерия,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ДокументНомер",ДанныеФизлица.ДокументНомер,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ДокументДатаВыдачи",ДанныеФизлица.ДокументДатаВыдачи,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ДокументКемВыдан",ДанныеФизлица.ДокументКемВыдан,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ДокументКодПодразделения",ДанныеФизлица.ДокументКодПодразделения,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ПредставлениеДокумента",ДанныеФизлица.ПредставлениеДокумента,ДанныеКопия);
			//
			ДобавитьПараметр(Префикс+"ДатаРождения",Значение.ДатаРождения,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ВодительскоеУдостоверениеДатаВыдачи",Значение.ВодительскоеУдостоверениеДатаВыдачи,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ВодительскоеУдостоверениеНомер",Значение.ВодительскоеУдостоверениеНомер,ДанныеКопия);
			ДобавитьПараметр(Префикс+"ВодительскоеУдостоверениеСерия",Значение.ВодительскоеУдостоверениеСерия,ДанныеКопия);
			//
			ДобавитьПараметр(Префикс+"Телефон","7(495)228-09-42",ДанныеКопия);
			
			//
			Если ЗначениеЗаполнено(Значение.ДатаРождения) Тогда
				Возраст = Цел((ТекущаяДата()-Значение.ДатаРождения)/(3600*24*365));
			Иначе
				Возраст = 0;
			Конецесли;	
			ДобавитьПараметр(Префикс+"Возраст",Возраст,ДанныеКопия);
			//
			Если ЗначениеЗаполнено(Значение.ВодительскоеУдостоверениеДатаНачалаСтажа) Тогда
				ДатаНачалаСтажа  = Значение.ВодительскоеУдостоверениеДатаНачалаСтажа;
			Иначе
				ДатаНачалаСтажа  = Значение.ВодительскоеУдостоверениеДатаВыдачи;
			КонецЕсли;
			ДобавитьПараметр(Префикс+"ДатаНачалаСтажа",ДатаНачалаСтажа,ДанныеКопия);
			//
			Если ЗначениеЗаполнено(ДатаНачалаСтажа) Тогда
				Стаж = Цел((ТекущаяДата()-ДатаНачалаСтажа)/(3600*24*365));
			Иначе
				Стаж = 0;
			КонецЕсли;	
			ДобавитьПараметр(Префикс+"Стаж",Стаж,ДанныеКопия);
			//
			ИзвестнаДатаНачалаСтажа = НЕ ДатаНачалаСтажа = Дата(1,1,1);
			ДобавитьПараметр(Префикс+"ИзвестнаДатаНачалаСтажа",ИзвестнаДатаНачалаСтажа,ДанныеКопия);
			//
			ТекПол = ?(ЗначениеЗаполнено(Значение.Пол),""+Значение.Пол,"");
			ДобавитьПараметр(Префикс+"Пол",ТекПол,ДанныеКопия);
			ДобавитьПараметр(Префикс+"Пол1",Лев(ТекПол,1),ДанныеКопия);
			ДобавитьПараметр(Префикс+"Пол3",Лев(ТекПол,3),ДанныеКопия);
			ДобавитьПараметр(Префикс+"Пол3НРЕГ",Нрег(Лев(ТекПол,3)),ДанныеКопия);
			
