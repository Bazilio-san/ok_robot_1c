				//СтруктураПолей.Вставить("Поле9", Структура.Квартира);
				//Представление = УправлениеКонтактнойИнформацией.СформироватьПредставлениеАдресаЗаПределамиРФ("Россия", УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдреса(СтруктураПолей));
				ДобавитьПараметр(Префикс + "КонтактнаяИнформацияПредставлениеЮр", Структура.Представление, ДанныеКопия);
			КонецЕсли;
			ДобавитьПараметр(Префикс + "ТипДокумента", "Свидетельство о регистрации", ДанныеКопия);
		ИначеЕсли СтрокаДанных.Параметр = "ОбъектСтрахования" Тогда
			СтрокаДанных.Параметр = СтрокаДанных.Параметр+"Ссылка";
			Для каждого ЭлементСтруктуры из Справочники.уб_ОбъектыСтрахования.ПолучитьДанные(СтрокаДанных.Значение,ЛОЖЬ)  Цикл
				ДопСтрока = ДанныеКопия.Добавить();
				ДопСтрока.Параметр = ЭлементСтруктуры.Ключ;
				ДопСтрока.Значение = ЭлементСтруктуры.Значение;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
	
	Попытка
		СтруктураДанных = ПодготовитьСтруктуруДанных(ДанныеКопия, ИмяМакета);
	Исключение
	КонецПопытки;	
	
	
	Возврат  Истина;
КонецФункции		

Функция ДобавитьПараметр(ИмяПараметра,ЗначениеПараметра,Таблица)
	ДопСтрока = Таблица.Добавить();
	ДопСтрока.Параметр = ИмяПараметра;
	ДопСтрока.Значение = ЗначениеПараметра;
КонецФункции	

Функция ОтформатироватьЗначение(Значение, ИмяПараметра = "") экспорт
	ТипЗ = ТипЗнч(Значение); 
	Если ТипЗ = Тип("Дата") Тогда
		СтрокаДаты = Строка(Значение);
		//У нас
		//СтрокаДаты	"22.05.2014 00:00:00"	Строка
		//Надо
		//2013-02-20T00:00:00
		Возврат Формат(Значение,"ДФ=yyyy-MM-ddTHH:mm:ss");
		
		//Если НачалоДня(Значение) = Значение Тогда
		//	//Без времени?
		//Иначе
		//	//
		//	Зна
		//	Сообщить(СтрокаДаты);
		//	
		//КонецЕсли;	
	ИначеЕсли ТипЗ = Тип("Булево") Тогда	
		Возврат Формат(Значение,"БЛ=false; БИ=true");
	ИначеЕсли ТипЗ = Тип("Число") Тогда	
		Если Найти("ОбъектСтрахованияГодВыпуска,ОбъектСтрахованияГрузоподъемность,ОбъектСтрахованияМощностьДвигателя,ОбъектСтрахованияМаксМасса,ОбъектСтрахованияГрузоподъемность,СобственникВнутреннийНомер,Водитель1ВнутреннийКод,Водитель1Возраст,Водитель1Стаж,Водитель2ВнутреннийКод,Водитель2Возраст,Водитель2Стаж,Водитель3ВнутреннийКод,Водитель3Возраст,Водитель3Стаж,",ИмяПараметра)>0 Тогда
			Возврат Формат(Значение,"ЧЦ=18; ЧГ=");
		Иначе
			Возврат Формат(Значение,"ЧЦ=18; ЧДЦ=3; ЧГ=");
		КонецЕсли;	
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции	

Функция ПодготовитьСтруктуруДанных(ТЗ, Знач ИмяМакета = "")

	Если ИмяМакета = "" Тогда
		ИмяМакета = Макет.Наименование;
	КонецЕсли;
	ЭтоПустойБланкОСАГО = ИмяМакета = "ОСАГО пустое";
	ЭтоЗаявлениеОСАГО	= ИмяМакета = "Заявление ОСАГО";
	СоответствиеКлючу = Новый Соответствие;
	СоответствиеКлючу.Вставить("Базовый тариф", 					"БазовыйТариф");
	СоответствиеКлючу.Вставить("Коэфф. бонус-малус",    			"КоэффБонусМалус");
	СоответствиеКлючу.Вставить("Коэфф. допуск к управлению",		"КоэффДопускКУправлению");
	СоответствиеКлючу.Вставить("Коэфф. за краткосрочность",			"КоэффЗаКраткосрочность");
	СоответствиеКлючу.Вставить("Коэфф. за мощность двигателя",		"КоэффЗаМощностьДвигателя");
	СоответствиеКлючу.Вставить("Коэфф. по возрасту и стажу",		"КоэффПоВозрастуИСтажу");
	СоответствиеКлючу.Вставить("Коэфф. региональный",				"КоэффРегиональный");
	СоответствиеКлючу.Вставить("Коэфф-т по грубым нарушениям",		"КоэффПоГрубымНарушениям");
	СоответствиеКлючу.Вставить("Коэфф-т по периоду использования",	"КоэффПоПериодуИспользования");
	СоответствиеКлючу.Вставить("Максимальная премия ОСАГО",	"МаксимальнаяПремияОСАГО");
	СоответствиеКлючу.Вставить("Запрос КБМ в РСА",	"ЗапросКБМвРСА");
	СоответствиеКлючу.Вставить("Запрос ТО в РСА",	"ЗапросТОвРСА");
	СоответствиеКлючу.Вставить("Коэфф-т за прицеп",	"КоэффЗаПрицеп");
	
	ТекущаяДата = ТекущаяДата();
	СтруктураДанных = Новый Структура;
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если Найти(СтрокаТЗ.Параметр, "<") > 0 Тогда
			Продолжить;
		КонецЕсли;			
		Ключ = СоответствиеКлючу.Получить(СтрокаТЗ.Параметр);
		Если Ключ = Неопределено Тогда
			Ключ = СтрокаТЗ.Параметр
		КонецЕсли;
		
		Если Найти(Ключ, " ") > 0 Тогда
			//
			Если НЕ ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза  = Истина Тогда
			    Сообщить("При печати не задействуется параметр: "+Ключ);
			КонецЕсли;
			Продолжить;
			
		КонецЕсли;			
		
		
		Попытка
			СтруктураДанных.Вставить(Ключ, СтрокаТЗ.Значение);
		Исключение
			Сообщить("При печати не задействуется параметр: "+Ключ);
			Сообщить("Ключ " +  Ключ);
		КонецПопытки;		
	КонецЦикла;
	СтруктураДанных.Вставить("СК", 						Шаблон.СтраховойПродукт.Владелец);
	СтруктураДанных.Вставить("НачалоДействияДата", 		Формат(СтруктураДанных["НачалоДействия"], "ДФ=dd"));
	#Если Клиент Тогда
		СтруктураДанных.Вставить("НачалоДействияМесяц",		Уб_Клиент.ПадежП(Формат(СтруктураДанных["НачалоДействия"], "ДФ=MMMM"), 2));
	#Иначе
		СтруктураДанных.Вставить("НачалоДействияМесяц",		Уб_ВызовСервера.ПадежП(Формат(СтруктураДанных["НачалоДействия"], "ДФ=MMMM"), 2));
	#КонецЕсли
	СтруктураДанных.Вставить("НачалоДействияГод",		Формат(СтруктураДанных["НачалоДействия"], "ДФ=yyyy"));
	СтруктураДанных.Вставить("ОкончаниеДействияДата", 	Формат(СтруктураДанных["ОкончаниеДействия"], "ДФ=dd"));
	#Если Клиент Тогда
		СтруктураДанных.Вставить("ОкончаниеДействияМесяц",	Уб_Клиент.ПадежП(Формат(СтруктураДанных["ОкончаниеДействия"], "ДФ=MMMM"), 2));
	#Иначе
		СтруктураДанных.Вставить("ОкончаниеДействияМесяц",	Уб_ВызовСервера.ПадежП(Формат(СтруктураДанных["ОкончаниеДействия"], "ДФ=MMMM"), 2));
	#КонецЕсли
	СтруктураДанных.Вставить("ОкончаниеДействияГод",	Формат(СтруктураДанных["ОкончаниеДействия"], "ДФ=yyyy"));
	//СтруктураДанных.Вставить("СерияПолиса",				СокрЛП(СтрЗаменить(СтруктураДанных["НомерПолисаПолный"], СтруктураДанных["НомерПолисаБезСерии"], "")));
	СтруктураДанных.Вставить("ТипОграниченияДопускаСОграничением");
	СтруктураДанных.Вставить("ТипОграниченияДопускаБезОграничений");
	БезОграничений = СтруктураДанных["ТипОграниченияДопуска"] = "Без ограничений";
	Для Счетчик = 1 По 5 Цикл
		//Данные.Вставить("Водитель" + Счетчик + "ФИО", ?(ПустаяСтрока(Данные["Водитель" + Счетчик + "Фамилия"]), "", СокрЛП(Данные["Водитель" + Счетчик + "Фамилия"]) + " ") + ?(ПустаяСтрока(Данные["Водитель" + Счетчик + "Имя"]), "", СокрЛП(Данные["Водитель" + Счетчик + "Имя"]) + " ") + ?(ПустаяСтрока(Данные["Водитель" + Счетчик + "Отчество"]), "", СокрЛП(Данные["Водитель" + Счетчик + "Отчество"])));
		//Если СтруктураДанных.Свойство("Водитель" + Счетчик + "Фамилия") И СтруктураДанных.Свойство("Водитель" + Счетчик + "Имя") Тогда
		//	СтруктураДанных.Вставить("Водитель" + Счетчик + "ФИО", ?(ПустаяСтрока(СтруктураДанных["Водитель" + Счетчик + "Фамилия"]), "", СокрЛП(СтруктураДанных["Водитель" + Счетчик + "Фамилия"]) + " ") + ?(ПустаяСтрока(СтруктураДанных["Водитель" + Счетчик + "Имя"]), "", СокрЛП(СтруктураДанных["Водитель" + Счетчик + "Имя"])));
		//КонецЕсли;
		ЕстьФиоВодителя = СтруктураДанных.Свойство("Водитель" + Счетчик + "ФИО");
		Если БезОграничений //Не надо заполнять
			Или НЕ ЕстьФиоВодителя//Нет
			ИЛИ (ЕстьФиоВодителя И Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "ФИО"])) //Не заполнено
			Тогда
			Если ЕстьФиоВодителя Тогда
				СтруктураДанных["Водитель" + Счетчик + "ФИО"] = "";
			КонецЕсли;	
			СтруктураДанных.Вставить("Водитель" + Счетчик + "НомерСтроки", 0);
		Иначе
			СтруктураДанных.Вставить("Водитель" + Счетчик + "НомерСтроки", Счетчик);
		КонецЕсли;
		Если СтруктураДанных.Свойство("Водитель" + Счетчик + "ДатаРождения") И (БезОграничений Или Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "ДатаРождения"])) Тогда
			СтруктураДанных["Водитель" + Счетчик + "ДатаРождения"] = Дата(1, 1, 1);
		КонецЕсли;
		Если СтруктураДанных.Свойство("Водитель" + Счетчик + "НомерВодительскогоУдостоверения") И (БезОграничений Или Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "НомерВодительскогоУдостоверения"])) Тогда
			СтруктураДанных["Водитель" + Счетчик + "НомерВодительскогоУдостоверения"] = "";
		КонецЕсли;
		Если СтруктураДанных.Свойство("Водитель" + Счетчик + "Стаж") И (БезОграничений Или Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "Стаж"])) Тогда
			СтруктураДанных["Водитель" + Счетчик + "Стаж"] = 0;
		КонецЕсли;
		Если СтруктураДанных.Свойство("Водитель" + Счетчик + "Пол") Тогда
			Если (БезОграничений Или Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "Пол"])) Тогда
				СтруктураДанных["Водитель" + Счетчик + "Пол"] = "";
			Иначе
				СтруктураДанных["Водитель" + Счетчик + "Пол"] = СокрЛП(Лев(Строка(СтруктураДанных["Водитель" + Счетчик + "Пол"]), 3));
				Если Прав(СтруктураДанных["Водитель" + Счетчик + "Пол"], 1) <> "." Тогда
					СтруктураДанных["Водитель" + Счетчик + "Пол"] = СтруктураДанных["Водитель" + Счетчик + "Пол"] + ".";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если СтруктураДанных.Свойство("Водитель" + Счетчик + "КБМсКоэф") И (БезОграничений Или Не ЗначениеЗаполнено(СтруктураДанных["Водитель" + Счетчик + "КБМсКоэф"])) Тогда
			СтруктураДанных["Водитель" + Счетчик + "КБМсКоэф"] = 0;
		КонецЕсли;
	КонецЦикла;
	Для Счетчик = 1 По 3 Цикл
		Если СтруктураДанных.Свойство("ПериодИспользования" + Счетчик + "Начало") И СтруктураДанных.Свойство("ПериодИспользования" + Счетчик + "Окончание") Тогда
			СтруктураДанных["ПериодИспользования" + Счетчик + "Начало"] = Формат(СтруктураДанных["ПериодИспользования" + Счетчик + "Начало"], "ДФ=dd.MM.yyyy");
			СтруктураДанных["ПериодИспользования" + Счетчик + "Окончание"] = Формат(СтруктураДанных["ПериодИспользования" + Счетчик + "Окончание"], "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	СтруктураДанных.Вставить("ДатаЗаполненияЗаявления", 		ТекущаяДата);
	СтруктураДанных.Вставить("ДатаЗаполненияЗаявленияДень",  	Формат(СтруктураДанных["ДатаЗаполненияЗаявления"], "ДФ=dd"));
	СтруктураДанных.Вставить("ДатаЗаполненияЗаявленияМесяц", 	Уб_Клиент.ПадежП(Формат(СтруктураДанных["ДатаЗаполненияЗаявления"], "ДФ=MMMM"), 2));
	СтруктураДанных.Вставить("ДатаЗаполненияЗаявленияГод");
	Если ТипЗнч(СтруктураДанных["СтраховаяПремияВсего"]) = Тип("Число") Тогда
		СтруктураДанных.Вставить("СтраховаяПремияСтрока", ЧислоПрописью(СтруктураДанных["СтраховаяПремияВсего"],, ОбщегоНазначения.ПолучитьВалютуРубли().ПараметрыПрописиНаРусском));
	Иначе
		СтруктураДанных.Вставить("СтраховаяПремияСтрока", "");
	КонецЕсли;
	// данные бланка ОСАГО
	СтрокаДата = Формат(СтруктураДанных["НачалоДействия"], "ДФ='ддММгг'");
	Для Счетчик = 1 По 6 Цикл
		СтруктураДанных.Вставить("НачалоДействия1" + Счетчик, Сред(СтрокаДата, Счетчик, 1));
		СтруктураДанных.Вставить("НачалоДействия2" + Счетчик, "");
		СтруктураДанных.Вставить("НачалоДействия3" + Счетчик, "");
	КонецЦикла;
	СтрокаДата = Формат(СтруктураДанных["ОкончаниеДействия"], "ДФ='ддММгг'");
	Для Счетчик = 1 По 6 Цикл
		СтруктураДанных.Вставить("ОкончаниеДействия1" + Счетчик, Сред(СтрокаДата, Счетчик, 1));
		СтруктураДанных.Вставить("ОкончаниеДействия2" + Счетчик, "");
		СтруктураДанных.Вставить("ОкончаниеДействия3" + Счетчик, "");
	КонецЦикла;
	Если СтруктураДанных.Свойство("ОбъектСтрахованияИдентификационныйНомер") Тогда
		Для Счетчик = 1 По 17 Цикл
			СтруктураДанных.Вставить("ОбъектСтрахованияИдентификационныйНомер" + Счетчик, Сред(СтруктураДанных["ОбъектСтрахованияИдентификационныйНомер"], Счетчик, 1));
		КонецЦикла;
	КонецЕсли;
	Для Счетчик = 1 По 2 Цикл
		СтруктураДанных.Вставить("Часов" + Счетчик, Сред(СтруктураДанных["Часов"], Счетчик, 1));
	КонецЦикла;
	Для Счетчик = 1 По 2 Цикл
		СтруктураДанных.Вставить("Минут" + Счетчик, Сред(СтруктураДанных["Минут"], Счетчик, 1));
	КонецЦикла;
	//
	//Если ИзМакетаОбработки Или Объект.Макет.Пустая() Тогда
	//	Макет = ПолучитьМакет("Макет");
	//Иначе
	//	Макет = Объект.Макет.МакетШаблона.Получить();
	//КонецЕсли;		
	//ТабДок = Новый ТабличныйДокумент;
	//ТабДок.ОриентацияСтраницы 	= ОриентацияСтраницы.Портрет;
	Если ЭтоПустойБланкОСАГО Тогда
		//Если БезОграничений Тогда
		//	СтруктураДанных["ТипОграниченияДопускаСОграничением"]	= "";
		//	СтруктураДанных["ТипОграниченияДопускаБезОграничений"] 	= "✓";
		//Иначе
		//	СтруктураДанных["ТипОграниченияДопускаСОграничением"]	= "✓";
		//	СтруктураДанных["ТипОграниченияДопускаБезОграничений"]	= "";
		//КонецЕсли;
		//СтруктураДанных.Вставить("ДатаЗаполненияЗаявленияГод" , Формат(СтруктураДанных["ДатаЗаполненияЗаявления"], "ДФ=yy"));
	Иначе
		СтруктураДанных["ДатаЗаполненияЗаявленияГод"] = Формат(СтруктураДанных["ДатаЗаполненияЗаявления"], "ДФ=yyyy");
		Если БезОграничений Тогда
			//СтруктураДанных["ТипОграниченияДопускаСОграничением"]	= "£";
			СтруктураДанных["ТипОграниченияДопускаСОграничением"]	= "5";
			СтруктураДанных["ТипОграниченияДопускаБезОграничений"] 	= "R";
		Иначе
			СтруктураДанных["ТипОграниченияДопускаСОграничением"]	= "R";
			//СтруктураДанных["ТипОграниченияДопускаБезОграничений"]	= "£";
			СтруктураДанных["ТипОграниченияДопускаБезОграничений"]	= "5";
