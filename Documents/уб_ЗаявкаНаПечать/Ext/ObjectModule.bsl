	Если ТипЗнч(_Страхователь) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		тдАдресПрописка = РегистрыСведений.КонтактнаяИнформация.ПолучитьДанныеАдреса(_Страхователь, Справочники.ВидыКонтактнойИнформации.АдресФизЛицаПоПрописке,3);
	Иначе	
		тдАдресПрописка = РегистрыСведений.КонтактнаяИнформация.ПолучитьДанныеАдреса(_Страхователь, Справочники.ВидыКонтактнойИнформации.АдресКонтрагентаФактический,3);
	КонецЕсли;	
	
	НеНайдено    = Истина;
	тдСтрокаДанных = Неопределено;
	
	//Если (НЕ ПолучитьПараметр("ИспользованиеТСРегион",НеНайдено,"Не найдено",тдСтрокаДанных)= "Не найдено") и ПустаяСтрока(тдСтрокаДанных.Значение) Тогда
	//	тдСтрокаДанных.Значение = тдАдресПрописка.Регион;
	//КонецЕсли;	
	флТрубуетсяОбновитьСписокГородов = Ложь;
	ТекРегион = ПолучитьПараметр("ИспользованиеТСРегион",НеНайдено,"Не найдено",тдСтрокаДанных); 
	Если НеНайдено Тогда
		Сообщить("Не найден параметр Регион Использования");
	Иначе	
		Если тдАдресПрописка.Регион = "Москва" ИЛИ тдАдресПрописка.Регион = "" Тогда
			УстановитьПараметр("ИспользованиеТСРегион"  , "Москва");
			УстановитьПараметр("ИспользованиеТСГород"   , "");
			УстановитьПараметр("ИспользованиеТСКодКладр", "7700000000000");
		Иначе
			УстановитьПараметр("ИспользованиеТСРегион"  , тдАдресПрописка.Регион);
			флТрубуетсяОбновитьСписокГородов = УстановитьПараметр("ИспользованиеТСГород"   , ?(ПустаяСтрока(тдАдресПрописка.НаселенныйПункт),тдАдресПрописка.Город,тдАдресПрописка.НаселенныйПункт));
			времРайон="";
			текКодКладра = РегистрыСведений.АдресныйКлассификатор.КодКладра(тдАдресПрописка.Регион,времРайон,?(ПустаяСтрока(тдАдресПрописка.НаселенныйПункт),тдАдресПрописка.Город,тдАдресПрописка.НаселенныйПункт));
			УстановитьПараметр("ИспользованиеТСКодКладр", текКодКладра);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры
Функция ОбновитьСписокРегионов(ИмяПараметра = "ИспользованиеТСРегион")
	
	СтрокаШ = НайтиСтрокуШаблонаПоИмени(ИмяПараметра);
	
	Если НЕ СтрокаШ = Неопределено и СтрокаШ.СписокВыбора.Количество()<= 1 Тогда //Москва есть всегда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	АдресныйКлассификатор.КодРегионаВКоде КАК КодРегионаВКоде,
			|	АдресныйКлассификатор.КодРайонаВКоде КАК КодРайонаВКоде,
			|	АдресныйКлассификатор.КодУлицыВКоде КАК КодУлицыВКоде,
			|	АдресныйКлассификатор.КодНаселенногоПунктаВКоде КАК КодНаселенногоПунктаВКоде,
			|	АдресныйКлассификатор.Наименование КАК Наименование,
			|	АдресныйКлассификатор.Сокращение,
			|	ВЫБОР
			|		КОГДА АдресныйКлассификатор.КодРегионаВКоде = 77
			|			ТОГДА -1
			|		КОГДА АдресныйКлассификатор.КодРегионаВКоде = 50
			|			ТОГДА 1	
			|		ИНАЧЕ АдресныйКлассификатор.Наименование
			|	КОНЕЦ КАК Сортировка
			|   ИЗ
			|	РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
			|   ГДЕ
			|	АдресныйКлассификатор.ТипАдресногоЭлемента = 1
			|Упорядочить  по 
			|ВЫБОР
			|		КОГДА АдресныйКлассификатор.КодРегионаВКоде = 77
			|			ТОГДА -1
			|		КОГДА АдресныйКлассификатор.КодРегионаВКоде = 50
			|			ТОГДА 1	
			|		ИНАЧЕ АдресныйКлассификатор.Наименование
			|	КОНЕЦ	");
			РезультатЗапроса= Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				СтрокаШ.СписокВыбора.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Наименование"));
			КонецЕсли;	
	КонецЕсли;	
	
КонецФункции	
Процедура ОбновитьСписокГородов(Регион = Неопределено, ИмяПараметраРегион = "ИспользованиеТСРегион" ,ИмяПараметраГород = "ИспользованиеТСГород")
