Процедура ДобавитьВСписок(ИмяПоля,СписокДляОбработки = Неопределено,ИмяСписка = "СписокОбязательных") Экспорт
	флЗаписать = ЛОжь;
	Если СписокДляОбработки = Неопределено  Тогда
		СписокДляОбработки = ДополнительныеСвойства[ИмяСписка];
		флЗаписать = Истина;
	КонецЕсли;	
	Если ПараметрыСеанса.уб_ЭтоМенеджер = Истина Тогда
		Если Найти("НачалоДействия,ОкончаниеДействия,Страхователь,Собственник,ОбъектСтрахования,ВодительX", ИмяПоля)>0 Тогда
			СписокДляОбработки.Добавить(ИмяПоля);
		КонецЕсли;	
	
	Иначе	
	    ЭлементСписка = СписокДляОбработки.НайтиПоЗначению(ИмяПоля);
		Если ЭлементСписка = Неопределено Тогда
			СписокДляОбработки.Добавить(ИмяПоля);
		КонецЕсли;
		
		Если Найти(ИмяПоля,"X")>0 Тогда
			Для счетчик = 1 по 10 Цикл
				ТекИмяПараметра =  СтрЗаменить(ИмяПоля,"X",счетчик);
				
				ЭлементСписка = СписокДляОбработки.НайтиПоЗначению(ТекИмяПараметра);
				Если ЭлементСписка = Неопределено Тогда
					СписокДляОбработки.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
		
	КонецЕсли;
	Если флЗаписать = Истина Тогда
		ДополнительныеСвойства.Вставить(ИмяСписка,СписокДляОбработки);
	КонецЕсли;	
КонецПроцедуры
Процедура УдалитьИзСписка(ИмяПоля,СписокДляОбработки = Неопределено,ИмяСписка = "СписокОбязательных") Экспорт
	флЗаписать = ЛОжь;
	Если СписокДляОбработки = Неопределено  Тогда
		СписокДляОбработки = ДополнительныеСвойства[ИмяСписка];
		флЗаписать = Истина;
	КонецЕсли;	
	ЭлементСписка = СписокДляОбработки.НайтиПоЗначению(ИмяПоля);
	Пока НЕ ЭлементСписка = Неопределено Цикл
		СписокДляОбработки.Удалить(ЭлементСписка);
		ЭлементСписка = СписокДляОбработки.НайтиПоЗначению(ИмяПоля);
	КонецЦикла;
	Если Найти(ИмяПоля,"X")>0 Тогда
		Для счетчик = 1 по 10 Цикл
			ТекИмяПараметра =  СтрЗаменить(ИмяПоля,"X",счетчик);
			ЭлементСписка = СписокДляОбработки.НайтиПоЗначению(ТекИмяПараметра);
			Если НЕ ЭлементСписка = Неопределено Тогда
				СписокДляОбработки.Удалить(ЭлементСписка);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	Если флЗаписать = Истина Тогда
		ДополнительныеСвойства.Вставить(ИмяСписка,СписокДляОбработки);
	КонецЕсли;	
КонецПроцедуры	

