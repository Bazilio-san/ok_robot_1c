		|	АдресныйКлассификатор.Сокращение,
		|	РАЙОНЫ.Наименование КАК НаименованиеРайона,
		|	АдресныйКлассификатор.ТипАдресногоЭлемента,
		|	РАЙОНЫ.Сокращение КАК СокращениеРайона
		|ИЗ
		|	РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			АдресныйКлассификатор.Код / 1000000000000 КАК Код,
		|			АдресныйКлассификатор.КодРегионаВКоде КАК КодРегионаВКоде,
		|			АдресныйКлассификатор.КодРайонаВКоде КАК КодРайонаВКоде,
		|			АдресныйКлассификатор.КодУлицыВКоде КАК КодУлицыВКоде,
		|			АдресныйКлассификатор.КодНаселенногоПунктаВКоде КАК КодНаселенногоПунктаВКоде,
		|			АдресныйКлассификатор.Наименование КАК Наименование,
		|			АдресныйКлассификатор.Сокращение КАК Сокращение
		|		ИЗ
		|			РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
		|		ГДЕ
		|			АдресныйКлассификатор.ТипАдресногоЭлемента = 2
		|			И АдресныйКлассификатор.КодРегионаВКоде В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						АдресныйКлассификатор.КодРегионаВКоде КАК КодРегионаВКоде
		|					ИЗ
		|						РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
		|					ГДЕ
		|						АдресныйКлассификатор.ТипАдресногоЭлемента = 1
		|						И АдресныйКлассификатор.Наименование = &ЗначениеРегиона)) КАК РАЙОНЫ
		|		ПО (РАЙОНЫ.КодРегионаВКоде = АдресныйКлассификатор.КодРегионаВКоде)
		|			И (РАЙОНЫ.КодРайонаВКоде = АдресныйКлассификатор.КодРайонаВКоде)
		|ГДЕ
		|	(АдресныйКлассификатор.ТипАдресногоЭлемента = 3
		|			ИЛИ АдресныйКлассификатор.ТипАдресногоЭлемента = 4)
		|	И АдресныйКлассификатор.КодРегионаВКоде В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				АдресныйКлассификатор.КодРегионаВКоде КАК КодРегионаВКоде
		|			ИЗ
		|				РегистрСведений.АдресныйКлассификатор КАК АдресныйКлассификатор
		|			ГДЕ
		|				АдресныйКлассификатор.ТипАдресногоЭлемента = 1
		|				И АдресныйКлассификатор.Наименование = &ЗначениеРегиона)
		|
		|УПОРЯДОЧИТЬ ПО
		|	АдресныйКлассификатор.Наименование,
		|	АдресныйКлассификатор.ТипАдресногоЭлемента");
		//нДШСтрока[0].
		
		Запрос.УстановитьПараметр("ЗначениеРегиона",Регион);
		
		ВремВыборка = Запрос.Выполнить().Выбрать();
		
		Пока ВремВыборка.Следующий() Цикл
			СтрокаШ.СписокВыбора.Добавить (ВремВыборка.Наименование,ВремВыборка.Наименование + ?(ЗначениеЗаполнено(ВремВыборка.НаименованиеРайона),"("+СокрЛП(ВремВыборка.НаименованиеРайона)+" "+СокрЛП(ВремВыборка.СокращениеРайона)+")",""));
		КонецЦикла;	
		Город = ПолучитьПараметр(ИмяПараметраГород);
		Если ЗначениеЗаполнено(Город) и СтрокаШ.СписокВыбора.НайтиПоЗначению(Город) = Неопределено Тогда
			//Может быть город другого региона
			 УстановитьПараметр(ИмяПараметраГород,"");
		КонецЕсли;	
				//тдНСтроки2 = Данные.НайтиСтроки(Новый Структура("Параметр","ИспользованиеТСКодКладр"));
		//Если тдНСтроки2.Количество() = 1 Тогда
		//	
		//	Если ЗначениеЗаполнено(тдНСтроки2[0].Значение) = ЛОЖЬ Тогда
		//		тдНСтроки2[0].Значение = текКодКладра;
		//	КонецЕсли;	
		//КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	
Функция ЗаполнитьКладр(Регион=Неопределено,Район=Неопределено,Город=Неопределено,ИмяПараметраРегион="ИспользованиеТСРегион",ИмяПараметраГород="ИспользованиеТСГород",ИмяПараметраКодКладра="ИспользованиеТСКодКладр")
		Если Регион = Неопределено Тогда
			Регион = ПолучитьПараметр(ИмяПараметраРегион);
		КонецЕсли;	
		Если Город = Неопределено Тогда
			Город = ПолучитьПараметр(ИмяПараметраГород);
		КонецЕсли;	
		
		Если Район = Неопределено и не Город = Неопределено Тогда
				//В городе может быть и район
			ПозСкобки = Найти(Город,"(");
			Если НЕ ПозСкобки = 0 Тогда
				Район = СтрЗаменить(Сред(Город,ПозСкобки+1)," р-н)","");
				Город = Лев(Город,ПозСкобки-1);
			Иначе
				Район = "";
			КонецЕсли;		
		КонецЕсли;	
	    Если НЕ Город = Неопределено Тогда
		
			//Есть все данные для получения кода кладра
			текКодКладра = РегистрыСведений.АдресныйКлассификатор.КодКладра(Регион,Район,Город);	
			УстановитьПараметр(ИмяПараметраКодКладра,текКодКладра);
		Иначе
		//Не найден город
		КонецЕсли;	
КонецФункции
	
Функция КоэффициентПоКлассу(_класс) Экспорт
	Если      _класс = "3"  Тогда Возврат  1
	ИначеЕсли _класс = "М"  Тогда Возврат  2.45
	ИначеЕсли _класс = "0"  Тогда Возврат  2.3
	ИначеЕсли _класс = "1"  Тогда Возврат  1.55
	ИначеЕсли _класс = "2"  Тогда Возврат  1.4 
	ИначеЕсли _класс = "4"  Тогда Возврат  0.95
	ИначеЕсли _класс = "5"  Тогда Возврат  0.9
	ИначеЕсли _класс = "6"  Тогда Возврат  0.85
	ИначеЕсли _класс = "7"  Тогда Возврат  0.8
	ИначеЕсли _класс = "8"  Тогда Возврат  0.75
	ИначеЕсли _класс = "9"  Тогда Возврат  0.7
	ИначеЕсли _класс = "10" Тогда Возврат  0.65
	ИначеЕсли _класс = "11" Тогда Возврат  0.6
	ИначеЕсли _класс = "12" Тогда Возврат  0.55	
	ИначеЕсли _класс = "13" Тогда Возврат  0.5	
	Иначе                         возврат  1;
	КонецЕсли;	
КонецФункции		
	