Процедура ДвижениеНомераПолиса(ВидДвижения, Отказ) Экспорт
	
	СтруктураВидБСО = ОпределитьТекВидБСО();
	ТекВидБСО = СтруктураВидБСО.ВидБСО;
	ИспользуютсяСвободныеНомера = СтруктураВидБСО.ИспользуютсяСвободныеНомераПолисов;
	Если НЕ ИспользуютсяСвободныеНомера = Истина ИЛИ "ТолькоОчиститьДвижения" = ВидДвижения 
	//Если НЕ уб_СЛ.ОпределитьИспользуютсяСвободныеНомераПолисов(ТекВидБСО, СтруктураВидБСО.ТипУчетаБСО) ИЛИ "ТолькоОчиститьДвижения" = ВидДвижения 
		ИЛИ уб_СЛ.ПолисАннулирован(СостояниеПолиса)
		Тогда
		Движения.уб_СвободныеНомераПолисов.Очистить();
		Движения.уб_СвободныеНомераПолисов.Записать();
		#Если Клиент Тогда
		Оповестить("ДвиженияСвободныхНомеровПолисов",Ссылка);
		#КонецЕсли
		Возврат;	
	КонецЕсли;
	сНомер = СокрЛП(Номер);
	СтруктураНомеров = уб_СтраховойБрокер.ПолучитьСтруктуруНомеровПолисов();
	СтруктураНомеров.Период 		= Новый Граница(ДатаДвиженияБСО, ВидГраницы.Исключая);
	СтруктураНомеров.СК 			= СК;
	СтруктураНомеров.НомерПолиса	= сНомер;
	уб_СтраховойБрокер.ПрочитатьСостояниеНомераПолиса(СтруктураНомеров);
	СообщениеОшибки = СообщениеОшибкиСвободногоНомераПолиса(СтруктураНомеров, СтруктураВидБСО);	
	ДолженБытьОтказ = Не ПустаяСтрока(СообщениеОшибки);
	Если ДолженБытьОтказ Тогда
		Сообщить(СообщениеОшибки)
	КонецЕсли;
	Если "ТолькоПроверитьНомерИОчиститьДвижения" = ВидДвижения Тогда
		Движения.уб_СвободныеНомераПолисов.Очистить();
		Движения.уб_СвободныеНомераПолисов.Записать();
		#Если Клиент Тогда
		Оповестить("ДвиженияСвободныхНомеровПолисов",Ссылка);
		Если ДолженБытьОтказ Тогда
			Сообщить("Эта ошибка не влияет на запись и проведение документа, поскольку установлен флаг 'Ручной ввод номера полиса'!");
		КонецЕсли;
		#КонецЕсли
		Возврат;	
	КонецЕсли;
	//--------------------------
	Если ДолженБытьОтказ Тогда
		Сообщить("Нет возможности " + ВидДвижения + " полис!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	//--------------------------		
	Движения.уб_СвободныеНомераПолисов.Очистить();
	Движения.уб_СвободныеНомераПолисов.Записать();	
	Движение = Движения.уб_СвободныеНомераПолисов.Добавить();	
	Движение.Период 			= ДатаДвиженияБСО;
	Движение.СК					= СК;
	Движение.Поставщик			= СтруктураНомеров.Поставщик;
	Движение.ОрганизацияАгент	= ОрганизацияАгент;
	Движение.НомерПолиса		= сНомер;
	//НЕ записываем вид нумерации в регистр
	//часто требуется изменять виды нумерации в поступлении, и во избежание перепроведения движений номеров полисов
	//с измененной нумерацией, будем считать, что вид нумерации будет определяться только поступлением и получать данные
	//нумерации из регистра срезом первых только для нумераций
	//Движение.ВидНумерации		= СтруктураНомеров.ВидНумерации;
	Движение.ГодПолиса			= СтруктураНомеров.ГодПолиса;
	Движение.НомерИспользован	= СтруктураНомеров.НомерИспользован;   
	Движение.НомерЗаблокирован	= СтруктураНомеров.НомерЗаблокирован;
	Движение.НомерЗарезервирован= СтруктураНомеров.НомерЗарезервирован;
	Движение.НомерВыданАгенту		= СтруктураНомеров.НомерВыданАгенту;	
	Если ВидДвижения = "Оформить" Тогда
		Движение.НомерИспользован	= Истина;
		Движение.НомерЗарезервирован	= Ложь;
		Движение.КодОперации		= Перечисления.уб_КодыОперацийНомеровПолисов.ОформлениеПолиса;
	ИначеЕсли ВидДвижения = "Зарезервировать" Тогда
		Движение.НомерИспользован	= Ложь;
		Движение.НомерЗарезервирован	= Истина;
		Движение.КодОперации			= Перечисления.уб_КодыОперацийНомеровПолисов.РезервированиеНомера;
	КонецЕсли;	
	Движения.уб_СвободныеНомераПолисов.Записать();
	#Если Клиент Тогда
	Оповестить("ДвиженияСвободныхНомеровПолисов", Ссылка);
	#КонецЕсли

КонецПроцедуры

Функция СообщениеОшибкиСвободногоНомераПолиса(СтруктураНомеров = Неопределено, СтруктураВидБСО = Неопределено) Экспорт

	Если СтруктураВидБСО = Неопределено Тогда
		СтруктураВидБСО = ОпределитьТекВидБСО();		
	КонецЕсли;
	ТекВидБСО = СтруктураВидБСО.ВидБСО;
	ИспользуютсяСвободныеНомера = СтруктураВидБСО.ИспользуютсяСвободныеНомераПолисов;
	//Если Не (уб_СЛ.ОпределитьИспользуютсяСвободныеНомераПолисов(ТекВидБСО, СтруктураВидБСО.ТипУчетаБСО) Или ЭтоСвободныйНомер) Тогда
	Если Не (ИспользуютсяСвободныеНомера = Истина Или ЭтоСвободныйНомер) Тогда
		Возврат ""
	КонецЕсли;
	сНомер = уб_СЛ.ДайНомерПолисаБезПометкиАннулирования(Номер);;
	Если СтруктураНомеров = Неопределено Тогда
		СтруктураНомеров = уб_СтраховойБрокер.ПолучитьСтруктуруНомеровПолисов();
		СтруктураНомеров.Период 		= Новый Граница(ДатаДвиженияБСО, ВидГраницы.Исключая);
		СтруктураНомеров.СК 			= СК;
		СтруктураНомеров.НомерПолиса	= сНомер;
		уб_СтраховойБрокер.ПрочитатьСостояниеНомераПолиса(СтруктураНомеров);
	КонецЕсли;
	Сообщение = "";
	Если Не СтруктураНомеров.Существует Тогда
		Сообщение = "Указанный свободный номер полиса """ + сНомер + """ не существует!";
	ИначеЕсли Не МожноИспользоватьНомер(сНомер, Сообщение) Тогда
		// Если сообщение не получено - номер существует, проверим правильность выбора нумерации
	ИначеЕсли НЕ ЗначениеЗаполнено(СтруктураНомеров.ВидНумерации) Тогда
		Сообщение = "Номер полиса имеет пустой вид нумерации!";
	ИначеЕсли СтруктураНомеров.ВидНумерации.ВидыБСО.Найти(ТекВидБСО, "ВидБСО") = Неопределено Тогда
		Сообщение = "Нумерация полисов (" + СтруктураНомеров.ВидНумерации + ") не соответствует Виду БСО. Необходимо выбрать другой номер полиса!";
	ИначеЕсли ЕстьКредитныйДоговор И Не СтруктураНомеров.ВидНумерации.ДляКредитныхПолисов Тогда
		Сообщение = "Номер полиса """ + сНомер + """ не соответствует типу договора. Номер не предназначен для кредитных полисов!";
	ИначеЕсли Не ЕстьКредитныйДоговор И НЕ СтруктураНомеров.ВидНумерации.ДляОбычныхПолисов Тогда
		Сообщение = "Номер полиса """ + сНомер + """ не соответствует типу договора. Номер не предназначен для НЕ кредитных полисов!";
	ИначеЕсли РассрочкаПлатежа И Не СтруктураНомеров.ВидНумерации.СРассрочкой Тогда
		Сообщение = "Номер полиса """ + сНомер + """ не соответствует типу договора. Номер не предназначен для договоров с рассрочкой платежа!";
	ИначеЕсли Не РассрочкаПлатежа И Не СтруктураНомеров.ВидНумерации.БезРассрочки Тогда
		Сообщение = "Номер полиса """ + сНомер + """ не соответствует типу договора. Номер не предназначен для договоров без рассрочки платежа!";
	КонецЕсли;
	Возврат Сообщение;

КонецФункции // ывпаывп()

//Ч
Функция ПолучитьСписокДоступныхРисков(фСтраховойПродукт, фОбъектСтрахования) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	Если НЕ ЗначениеЗаполнено(фСтраховойПродукт) Тогда
		Возврат СписокВыбора;
	КонецЕсли;
	Если  ЗначениеЗаполнено(фОбъектСтрахования) Тогда
		Для Каждого СтрокаТЧ из фСтраховойПродукт.ТипыОбъектовИРиски Цикл
			Если СтрокаТЧ.ТипОбъекта = фОбъектСтрахования.Тип Тогда
				СписокВыбора.Добавить(СтрокаТЧ.Риск);
			КонецЕсли;
		КонецЦикла;
	Иначе
		//если объект не указан - берем все риски
		Для Каждого СтрокаТЧ из фСтраховойПродукт.ТипыОбъектовИРиски Цикл
			Если СписокВыбора.НайтиПоЗначению(СтрокаТЧ.Риск)=Неопределено Тогда
				СписокВыбора.Добавить(СтрокаТЧ.Риск);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокВыбора;
КонецФункции

