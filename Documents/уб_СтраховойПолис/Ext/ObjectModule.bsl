	, КонтрольПоРСДвиженияБСО = Ложь
	, ОстановитьсяПриОшибке = Ложь
	, ТипСообщения = 0 //0 - Диалог, 1 - Стандартные сообщения при проведении, 2 - простое сообщение по списку
	, Форма = Неопределено
	, oОплатыСписок = Неопределено
	, НеПроверятьЕслиЕстьДвижКвит = Ложь
	) Экспорт               
	
	ТзОшибки = СоздатьТаблицуОшибок();	
	ТЗОплат = ОП_ПолучитьТЗОплат();
	iНомерСтроки = 0;
	Для Каждого оОплата из ТЗОплат Цикл		
		iНомерСтроки = iНомерСтроки + 1;
		Если НЕ ЗначениеЗаполнено(оОплата.НомерВзноса) И оОплата.НомерВзноса <> iНомерСтроки Тогда
			ФиксироватьНовыеНомераОплат = Истина;
			ДокОП = оОплата.Ссылка.ПолучитьОбъект();			
			ДокОП.НомерВзноса = iНомерСтроки;
			Попытка
				ДокОП.Записать();	
			Исключение
			КонецПопытки;
		КонецЕсли;
		//Типа, мысль такая: если уже было движение китанции, то остальная часть проверки не нужна
		//В том случае, если установлен флаг НеПроверятьЕслиЕстьДвижКвит (это при проведении)
		// А вот при проверке оплаты на вшивость из формы по кнопке, проверяем все подряд
		// (тогда передается НеПроверятьЕслиЕстьДвижКвит = ЛОЖЬ)		
		//В случае, если проведен отчет агента, то считаем, что уже поздняк метаться.
		#Если ТолстыйКлиент ИЛИ Сервер Тогда
		Если уб_СС.ЕстьДвиженияКвитанцииПоЭтомуСП(оОплата.НомерКвитанции, Ссылка) 
			И НеПроверятьЕслиЕстьДвижКвит Тогда
			Продолжить;	
		КонецЕсли;
		
		уб_СС.ОП_Проверить(
				ТзОшибки
				, oОплатыСписок
				, оОплата
				, ПроверятьТолькоНомерКвитанции
				, ПроверятьТолькоКритические
				, КонтрольПоРСДвиженияБСО
				, ОстановитьсяПриОшибке
				, ЭтотОбъект
				, ОтключитьКонтрольНомеровБСО
				,"СтраховойПолис"
			   );
		#КонецЕсли
	КонецЦикла;
	Если ТзОшибки.Количество() <> 0 Тогда
		Для Каждого COO из ТзОшибки Цикл
			Если COO.Статус = СтатусСообщения.Важное ИЛИ COO.Статус = СтатусСообщения.ОченьВажное Тогда
				Отказ = Истина;
		    КонецЕсли;
		КонецЦикла;		
		Если ТипСообщения = 0 Тогда
			ОткрытьСообщениеОбОшибках(ТзОшибки, Форма);
		ИначеЕсли ТипСообщения = 1 Тогда
			ОтказДоЦикла = Отказ; //Что бы восстановить состояние переменной после цикла  
			Для Каждого COO из ТзОшибки Цикл
				ОбщегоНазначения.ОшибкаПриПроведении(COO.Ошибка,Отказ,,COO.Статус);
			КонецЦикла;
			Отказ = ОтказДоЦикла;  
		Иначе
			СообщитьСОО(ТзОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

//>>>>>>>>>>>>>> процедуры проверки оплат >>>>>>>>>>>>>>>>>

Функция ПодготовитьТаблицуБСО()
	
	ИнфоЗапись = НЕ Ссылка.Проведен;
	ТаблицаБСО = Новый ТаблицаЗначений;
	ТаблицаБСО.Колонки.Добавить("ДатаДвижения");
	ТаблицаБСО.Колонки.Добавить("ВидБСО");
	ТаблицаБСО.Колонки.Добавить("НомерБСО");
	ТаблицаБСО.Колонки.Добавить("ДопНомерБСО");
	ТаблицаБСО.Колонки.Добавить("КоличествоБСО");
	ТаблицаБСО.Колонки.Добавить("Оформлен");
	ТаблицаБСО.Колонки.Добавить("НазначениеБСО");
	ТаблицаБСО.Колонки.Добавить("НомерСтроки");
	ТаблицаБСО.Колонки.Добавить("АгентОТ");
	ТаблицаБСО.Колонки.Добавить("АгентКУДА");
	ТаблицаБСО.Колонки.Добавить("ЭтоКвитанцияВОплате");
	ТаблицаБСО.Колонки.Добавить("СсылкаНаОплату");
	ТаблицаБСО.Колонки.Добавить("УчавствуетВдвижениях");
	ТаблицаБСО.Колонки.Добавить("СсылкаНаОплаты");
	ТаблицаБСО.Колонки.Добавить("ВедетсяНомернойУчет");
	ТаблицаБСО.Колонки.Добавить("ВедетсяКоличественныйУчет");
	ТаблицаБСО.Колонки.Добавить("ТипУчетаБСО");
	//В реквизите СКогоУходитБСО, как правило, хранится физлицо или контрагент, 
	// соотвтетстующий текущему пользователю
	//Отправителем Номерного БСО является: 
	// - в случае отсутствия ограничений по агенту: Агент по полису 
	// - в случае ограничений по агенту: значение переменной СКогоУходитБСО	
	АгентОТДляНомерного = Агент;	
	//Получателем Номерного БСО является: 
	// - в случае отсутствия ограничений по агенту: Основное Подразделение По Учету БСО 
	// - в случае ограничений по агенту: значение переменной СКогоУходитБСО
	// Если помечено "Списать БСО с Агента, то всегда - Основное Подразделение По Учету БСО"		
	АгентКУДА	= ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;	
	Для Каждого СтрокаТЧ Из БСО Цикл
		Если СтрокаТЧ.Оформлен Тогда		
			ТипУчетаБСО = Неопределено;
			Если уб_СЛ.ОпределитьВедетсяНомернойУчет(СтрокаТЧ.ВидБСО,ТипУчетаБСО) Тогда 				
				СтрокаТЗ = ТаблицаБСО.Добавить();
				СтрокаТЗ.ВедетсяНомернойУчет 	= Истина;
				СтрокаТЗ.ДатаДвижения		 	= ДатаДвиженияБСО;
				СтрокаТЗ.НомерСтроки 			= СтрокаТЧ.НомерСтроки;
				СтрокаТЗ.ВидБСО 				= СтрокаТЧ.ВидБСО;
				СтрокаТЗ.НомерБСО 				= СтрокаТЧ.НомерБСО;
				СтрокаТЗ.КоличествоБСО 			= 1;
				СтрокаТЗ.Оформлен 				= Истина;
				СтрокаТЗ.НазначениеБСО		 	= СтрокаТЧ.НазначениеБСО;
				СтрокаТЗ.АгентОТ 				= АгентОТДляНомерного;
				СтрокаТЗ.АгентКУДА 				= АгентКУДА;
				СтрокаТЗ.ЭтоКвитанцияВОплате 	= Ложь;
				СтрокаТЗ.СсылкаНаОплату 		= Неопределено;
				СтрокаТЗ.УчавствуетВдвижениях 	= Ложь;
				СтрокаТЗ.ТипУчетаБСО 			= ТипУчетаБСО;
			ИначеЕсли уб_СЛ.ОпределитьВедетсяКоличественныйУчет(СтрокаТЧ.ВидБСО,ТипУчетаБСО) Тогда 			
				СтрокаТЗ = ТаблицаБСО.Добавить();
				СтрокаТЗ.ВедетсяКоличественныйУчет 	= Истина;
				СтрокаТЗ.ДатаДвижения 				= ДатаДвиженияБСО;
				СтрокаТЗ.НомерСтроки 				= 0;
				СтрокаТЗ.ВидБСО 					= СтрокаТЧ.ВидБСО;
				Если ТипЗнч(СтрокаТЧ.ВидБСО) = ТИП("СправочникСсылка.уб_ВидыБСО") Тогда
				Иначе	
					ТипУчетаБСО = СтрокаТЧ.ВидБСО.ТипУчетаБСО;
					Если ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.КоличественныйПолисВручную ИЛИ ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.КоличественныйПолисИзСвободных Тогда
						СтрокаТЗ.НомерБСО = СтрокаТЧ.НомерБСО;
					Иначе	
						СтрокаТЗ.НомерБСО = "";
					КонецЕсли;
				КонецЕсли;
				СтрокаТЗ.КоличествоБСО 			= 1;
				СтрокаТЗ.Оформлен 				= Истина;
				СтрокаТЗ.НазначениеБСО 			= СтрокаТЧ.НазначениеБСО;
				СтрокаТЗ.АгентОТ 				= ДайАгентаОТДляКоличественногоБСО(СтрокаТЧ);
				СтрокаТЗ.АгентКУДА 				= АгентКУДА;
				СтрокаТЗ.ЭтоКвитанцияВОплате 	= Ложь;
				СтрокаТЗ.СсылкаНаОплату 		= Неопределено;
				СтрокаТЗ.УчавствуетВдвижениях 	= Ложь;				
				СтрокаТЗ.ТипУчетаБСО 			= ТипУчетаБСО;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СтруктураБСО = уб_СЛ.ПолучитьСтруктуруБСО();
	Если ТипЗНЧ(СтраховойПродукт) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
		#Если ТолстыйКлиент ИЛИ Сервер Тогда
		оБСОквА7 = уб_СС.ПолучитьБСОТипаКвА7дляСтраховогоПродукта(СтраховойПродукт);	
		//Структура : "Существует, ВидБСО, ТипБСО, Обязательно, НазначениеБСО, ТипУчетаБСО, НомернойУчет"
		Если Не оБСОквА7.Существует Тогда
			//Если Найти(СтраховойПродукт,"ЕОСАГО") = 0 Тогда
			//	Сообщить("Для данного страхового продукта не установлено БСО типа 'Квитанция А7'.");
			//КонецЕсли;	
		Иначе	
			ВидБСОТипаКвА7 = оБСОквА7.ВидБСО;
			НазначениеБСОквА7 = оБСОквА7.НазначениеБСО;
			ТЗОплат = ОП_ПолучитьТЗОплат();
			iНомерСтроки = 0;
			Для Каждого Оплата из ТЗОплат Цикл
				iНомерСтроки = iНомерСтроки + 1;
				Если Не Оплата.ЕстьКвитанция Или ПустаяСтрока(Оплата.НомерКвитанции) Или уб_СС.ЕстьДвиженияКвитанцииПоДругомуСП(Оплата.НомерКвитанции, Ссылка) Тогда
					Продолжить;	
				КонецЕсли;
				СОО = "";	
				Если уб_СС.ОП_ПроверитьНаДублиНомерКвитанции(Оплата.Ссылка, СОО) Тогда 
					Прервать;	
				КонецЕсли;
				Если СОО <> "" Тогда
					Если ИнфоЗапись Тогда
						Сообщить("Оплата № " + iНомерСтроки + " от " + Формат(Оплата.Дата, "ДФ=dd.MM.yyyy") +  " сохранена, но в ней есть ошибки: " + СОО + "");
					Иначе	
						Сообщить("Квитанция № " + Оплата.НомерКвитанции + " не может быть проведена из-за ошибок в оплате (№ " + iНомерСтроки + " от " + Формат(Оплата.Дата,"ДФ=dd.MM.yyyy") +  ") [Ошибка: " + СОО + "].");
						Продолжить;	
					КонецЕсли;
				КонецЕсли;			
				//Устанавливаем, с кого уходит БСО для оплаты
				МенеджерКвитанции = ?(Оплата.СписатьСКурьера = Ложь Или Оплата.Курьер.Пустая(), Оплата.Агент, Оплата.Курьер);
				СКогоУходитБСОВОплате = ?(НЕ ЗначениеЗаполнено(МенеджерКвитанции),уб_СС.ПолучКонтрагентаИлиФизлицоПоПльзователю(ПараметрыСеанса.ТекущийПользователь),МенеджерКвитанции);			
				АгентКУДАКвитанции = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;		
				АгентОТДляКвитанции = МенеджерКвитанции;
				СтрокаТЗ = ТаблицаБСО.Добавить();
				СтрокаТЗ.ДатаДвижения 				= Оплата.ДатаПроведенияБСО;
				СтрокаТЗ.НомерСтроки 				= Оплата.НомерВзноса;
				СтрокаТЗ.ВидБСО 					= ВидБСОТипаКвА7;
				СтрокаТЗ.НомерБСО 					= Оплата.НомерКвитанции;
				СтрокаТЗ.ДопНомерБСО 				= Оплата.ДопНомерКвитанции;
				СтрокаТЗ.КоличествоБСО				= 1;
				СтрокаТЗ.Оформлен 					= Истина;
				СтрокаТЗ.НазначениеБСО 				= НазначениеБСОквА7;
				СтрокаТЗ.АгентОТ 					= АгентОТДляКвитанции;
				СтрокаТЗ.АгентКУДА 					= АгентКУДАКвитанции;
				СтрокаТЗ.ЭтоКвитанцияВОплате 		= Истина;
				СтрокаТЗ.СсылкаНаОплату 			= Оплата;
				СтрокаТЗ.ТипУчетаБСО 				= оБСОквА7.ТипУчетаБСО;
				СтрокаТЗ.ВедетсяНомернойУчет 		= Истина;//Когда будет по другому раскомментировать: уб_СЛ.ОпределитьВедетсяНомернойУчет(СтрокаТЗ.ВидБСО,СтрокаТЗ.ТипУчетаБСО)
				СтрокаТЗ.ВедетсяКоличественныйУчет 	= Ложь;
				СтрокаТЗ.УчавствуетВдвижениях 		= Ложь;
			КонецЦикла;
		КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	// TODO - уйти от свертки - при количественном БСО и НомерБСО="" выше не добавлять, а искать строку по видуБСО, НазначениеБСО,АгентОТ,АгентКУДА	и итерировать количество - таких случаи будут редки, и производительней
	ТаблицаБСО.Свернуть("ДатаДвижения,НомерСтроки,ВидБСО,НомерБСО,ДопНомерБСО,Оформлен,НазначениеБСО,АгентОТ,АгентКУДА,ЭтоКвитанцияВОплате,СсылкаНаОплату,СсылкаНаОплаты,УчавствуетВдвижениях,ВедетсяНомернойУчет,ВедетсяКоличественныйУчет,ТипУчетаБСО","КоличествоБСО");
	Возврат ТаблицаБСО;
	
КонецФункции

