Функция ОпределитьТекВидБСО_Старая(ТекНомерБСО = "") Экспорт
	
	ТекВидБСО = Справочники.уб_ВидыБСО.ПустаяСсылка();
	ТекНомерБСО = "";
	Для Каждого СтрокаТЧ из БСО Цикл
		Если уб_СЛ.ЕстьНомерПолиса(СтрокаТЧ.ВидБСО) Тогда
			ТекВидБСО = СтрокаТЧ.ВидБСО;
			Если уб_СЛ.ОпределитьВедетсяНомернойУчет(ТекВидБСО) Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерБСО) Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ уб_СЛ.ОпределитьЭтоПолис(ТекВидБСО) Тогда
					Продолжить;
				КонецЕсли;
				ТекНомерБСО = СтрокаТЧ.НомерБСО;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ТекВидБСО;
	
КонецФункции

Функция МожноИспользоватьНомер(Знач НомерПолиса, Сообщение = "")
	
	Если уб_СЛ.ПолисАннулирован(СостояниеПолиса) Тогда
		Возврат Истина;
	КонецЕсли;	
	НомерПолиса = уб_СЛ.ДайНомерПолисаБезПометкиАннулирования(НомерПолиса); 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СН.Регистратор,
	|	СН.КодОперации,
	|	СН.НомерИспользован,
	|	СН.НомерЗаблокирован,
	|	СН.НомерЗарезервирован
	|ИЗ
	|	РегистрСведений.уб_СвободныеНомераПолисов КАК СН
	|ГДЕ
	|	СН.Регистратор <> &Ссылка
	|	И СН.НомерПолиса = &НомерПолиса
	|	И СН.СК = &СК
	|	И СН.КодОперации В(&СписокОпераций)
	|	И НЕ СН.Регистратор.СостояниеПолиса В (&Аннулированные)";
	СписокОпераций = Новый Массив;
	СписокОпераций.Добавить(Перечисления.уб_КодыОперацийНомеровПолисов.ОформлениеПолиса);
	СписокОпераций.Добавить(Перечисления.уб_КодыОперацийНомеровПолисов.БлокировкаНомера);
	СписокОпераций.Добавить(Перечисления.уб_КодыОперацийНомеровПолисов.РезервированиеНомера);
	//при аннулировании есть возможность использовать номер повторно - исключаем из запроса
	Аннулированные = Новый СписокЗначений;
	Аннулированные.Добавить(Перечисления.уб_СостоянияПолиса.АннулированВыписанНовый);
	Аннулированные.Добавить(Перечисления.уб_СостоянияПолиса.АннулированЗаменаБланка);
	Аннулированные.Добавить(Перечисления.уб_СостоянияПолиса.АннулированПолностью);
	Запрос.УстановитьПараметр("Аннулированные",	Аннулированные);
	Запрос.УстановитьПараметр("СписокОпераций", СписокОпераций);
	Запрос.УстановитьПараметр("Ссылка", 		Ссылка);
	Запрос.УстановитьПараметр("НомерПолиса", 	НомерПолиса);
	Запрос.УстановитьПараметр("СК", 			СК);	
	Результат = Запрос.Выполнить();
	Рез = Истина;
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();	
		Пока Выборка.Следующий() Цикл
			Если Выборка.КодОперации = Перечисления.уб_КодыОперацийНомеровПолисов.ОформлениеПолиса Тогда
				Сообщение = "Номер полиса `" + НомерПолиса + "` уже был использован документом: " + Строка(Выборка.Регистратор) + ", необходимо выбрать другой номер!";
				Рез = Ложь;
				Прервать;
			ИначеЕсли Выборка.КодОперации = Перечисления.уб_КодыОперацийНомеровПолисов.БлокировкаНомера Тогда
				Сообщение = "Номер полиса `" + НомерПолиса + "` был заблокирован документом: " + Строка(Выборка.Регистратор) + ", необходимо выбрать другой номер!";
				Рез = Ложь;
				Прервать;
			ИначеЕсли Выборка.КодОперации = Перечисления.уб_КодыОперацийНомеровПолисов.РезервированиеНомера Тогда
				Сообщение = "Номер полиса `" + НомерПолиса + "` уже был зарезервирован документом: " + Строка(Выборка.Регистратор) + ", необходимо выбрать другой номер!";
				Рез = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Возврат Рез;

КонецФункции

