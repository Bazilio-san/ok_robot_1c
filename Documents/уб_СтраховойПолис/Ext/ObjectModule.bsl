// ЭКСПОРТИРУЕМЫЕ ФУНКЦИИ И ПРОЦЕДУРЫ


Функция РасчитатьСуммуОплаченнойПремииПоОПлатам(УстанавливатьЗначенияПолей = Ложь, СуммаСкидки = 0, ЕстьИзменения = Ложь) Экспорт
	
	Если ПараметрыСеанса.уб_Константы.ВестиВзаиморасчетыПоОперациям = Истина Тогда
		СтруктураПоказателей = уб_Взаиморасчеты.ПоказателиГруппы(Ссылка);
	Иначе
		СтруктураПоказателей = Новый Структура("гПремия,гНачисленнаяСуммаВзноса,гПринятаяСумма,гСкидкаКлиенту,гАВ", СтраховаяПремия, 0, 0, 0, 0);
		ТЗОплат = ОП_ПолучитьТЗОплат();
		Для Каждого Оплата из ТЗОплат Цикл
			//ТОДО Сменить на проверку факта сквитованности по принятым оплатам
			Если Оплата.ОплаченоФакт<>0 //Оплата.ОтчетАгента.Проведен 
				Тогда
				СтруктураПоказателей.гНачисленнаяСуммаВзноса = СтруктураПоказателей.гНачисленнаяСуммаВзноса + Оплата.НачисленнаяСуммаВзноса;
				Если Оплата.ВидРасчетаСАгентом  = Перечисления.уб_ВидыРасчетовСАгентом.ПоСхеме Тогда
					СтруктураПоказателей.гСкидкаКлиенту = СтруктураПоказателей.гСкидкаКлиенту + Оплата.АВилиСкидкаСумма;
				Иначе	
					СтруктураПоказателей.гАВ = СтруктураПоказателей.гАВ+Оплата.АВилиСкидкаСумма;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если УстанавливатьЗначенияПолей Тогда
		#Если Клиент Тогда
			ЕстьИзменения = Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"СуммаПремийПоОплатам", СтруктураПоказателей.гНачисленнаяСуммаВзноса) ИЛИ ЕстьИзменения;
			ЕстьИзменения = Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"СкидкаОбщаяПроцент", ?(СтруктураПоказателей.гНачисленнаяСуммаВзноса = 0,0,Окр(СтруктураПоказателей.гСкидкаКлиенту / СтруктураПоказателей.гНачисленнаяСуммаВзноса * 100,2))) ИЛИ ЕстьИзменения;
			ЕстьИзменения = Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"СуммаСкидкиПоОплатам", Окр(СтруктураПоказателей.гСкидкаКлиенту+СтруктураПоказателей.гАВ,2)) ИЛИ ЕстьИзменения;
		#Иначе	
			ЕстьИзменения = Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"СуммаПремийПоОплатам", СтруктураПоказателей.гНачисленнаяСуммаВзноса) ИЛИ ЕстьИзменения;
			ЕстьИзменения = Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"СкидкаОбщаяПроцент", ?(СтруктураПоказателей.гНачисленнаяСуммаВзноса = 0,0,Окр(СтруктураПоказателей.гСкидкаКлиенту / СтруктураПоказателей.гНачисленнаяСуммаВзноса * 100,2))) ИЛИ ЕстьИзменения;
			ЕстьИзменения = Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"СуммаСкидкиПоОплатам", Окр(СтруктураПоказателей.гСкидкаКлиенту+СтруктураПоказателей.гАВ,2)) ИЛИ ЕстьИзменения;
		#КонецЕсли
		Если СуммаПремийПоОплатам <= 0 Тогда
			хСост = 0; 	
		ИначеЕсли СтруктураПоказателей.гПремия > СуммаПремийПоОплатам И СуммаПремийПоОплатам > 0 И (СтруктураПоказателей.гПремия > СтруктураПоказателей.гПринятаяСумма) Тогда
			хСост = 1; 	
		ИначеЕсли СтруктураПоказателей.гПремия = СуммаПремийПоОплатам Тогда
			хСост = 2; 	
		ИначеЕсли СтруктураПоказателей.гПремия < СуммаПремийПоОплатам Тогда
			хСост = 3; 	
		КонецЕсли;
		#Если Клиент Тогда
			ЕстьИзменения = Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"СостояниеОплаченности", хСост) ИЛИ ЕстьИзменения;
		#Иначе	
			ЕстьИзменения = Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"СостояниеОплаченности", хСост) ИЛИ ЕстьИзменения;
		#КонецЕсли	
	КонецЕсли;
	Возврат СтруктураПоказателей;
	
КонецФункции

Процедура ОбновитьПлатежи(
	ОбновлятьФлагРассрочки 				= Ложь,
	ОбновлятьДатуНачисленияКВ 			= Ложь,
	ОбновлятьСуммуЕдинственногоПлатежа 	= Ложь,
	ИсправлятьНекорректныеДатыОплат 	= Ложь
	) Экспорт
	
	дДата = НачалоДня(?(НЕ ЗначениеЗаполнено(Дата),ТекущаяДата(),Дата)); 
	ДатаПлатежаПоУмолячанию = НачалоДня(?(НЕ ЗначениеЗаполнено(ДатаВыдачи),дДата,ДатаВыдачи));
	Если Платежи.Количество() = 0 Тогда
		НовыйПлатеж = Платежи.Добавить();
		НовыйПлатеж.Дата = ДатаПлатежаПоУмолячанию;
		НовыйПлатеж.Сумма = СтраховаяПремия;
	КонецЕсли;
	Если Платежи.Количество() = 1 Тогда
		ПервыйПлатеж = Платежи[0];
		Если НЕ ЗначениеЗаполнено(ПервыйПлатеж.Дата) ИЛИ ПервыйПлатеж.Дата < дДата  ИЛИ ПервыйПлатеж.Дата > (дДата + (1*60*60*24*31))  Тогда
			ПервыйПлатеж.Дата = ДатаПлатежаПоУмолячанию;
		КонецЕсли;
		Если ОбновлятьСуммуЕдинственногоПлатежа Тогда 
			#Если Клиент Тогда
				Уб_Клиент._УстановитьЗначение(ПервыйПлатеж,"Сумма",СтраховаяПремия);
			#Иначе	
				Уб_ВызовСервера._УстановитьЗначение(ПервыйПлатеж,"Сумма",СтраховаяПремия);
			#КонецЕсли				
		КонецЕсли; 	
	КонецЕсли;	
	Если ОбновлятьФлагРассрочки Тогда 
		//ЭтотОбъект.РассрочкаПлатежа = Платежи.Количество() > 1;
		#Если Клиент Тогда
			Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"РассрочкаПлатежа",Платежи.Количество() > 1); 
		#Иначе	
			Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"РассрочкаПлатежа",Платежи.Количество() > 1); 
		#КонецЕсли
	КонецЕсли; 	
	Если ОбновлятьДатуНачисленияКВ И НЕ РассрочкаПлатежа Тогда 
		//ЭтотОбъект.КВБеретсяНаДатуПлатежа = ЛОЖЬ;
		#Если Клиент Тогда
				Уб_Клиент._УстановитьЗначение(ЭтотОбъект,"КВБеретсяНаДатуПлатежа",Ложь) 
		#Иначе	
			Уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"КВБеретсяНаДатуПлатежа",Ложь) 
		#КонецЕсли
	КонецЕсли; 	
	Если ИсправлятьНекорректныеДатыОплат Тогда 
		Для й = 0 По Платежи.Количество() - 1 Цикл
			Платеж = Платежи[й];
			Если Платеж.Дата < дДата И Платеж.Дата < ДатаПлатежаПоУмолячанию И Платеж.Дата < ДатаНачала Тогда
				Платеж.Дата = ДатаПлатежаПоУмолячанию;
				Сообщить("Изменена дата платежа " + Платеж.НомерСтроки + " Полис: " + Строка(Ссылка));
			ИначеЕсли Платеж.Дата > КонецДня(ДатаОкончания) Тогда
				Если й = 0 Тогда
					Платеж.Дата = НачалоДня(ДатаОкончания);
				Иначе
					Платеж.Дата = Мин(НачалоДня(Платежи[й-1].Дата + 60*60*24),НачалоДня(ДатаОкончания));
				КонецЕсли;
				Сообщить("Изменена дата платежа " + Платеж.НомерСтроки + " Полис: " + Строка(Ссылка));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДайЗамененныйПолис() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтотПолис", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	З.*
	|ИЗ
	|	РегистрСведений.уб_ЗаменаПолисов КАК З
	|ГДЕ
	|	З.НовыйПолис = &ЭтотПолис";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);
	
КонецФункции

Процедура ЗаполнитьДокументПоСтруктуре(Структ) Экспорт
		
	Агент = Структ.Агент;
	Если Не ЗначениеЗаполнено(Агент) Тогда
		ПодразделениеОП = Неопределено;
	ИначеЕсли ТипЗнч(Агент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПодразделениеОП = ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети
	ИначеЕсли ТипЗнч(Агент) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ПодразделениеОП = Агент
	ИначеЕсли ТипЗнч(Агент) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		#Если ТолстыйКлиент ИЛИ Сервер Тогда
			ПодразделениеОП = уб_СС.ПолучитьПодразделениеАгента(Агент, Дата);
		#КонецЕсли
	КонецЕсли;
	СтраховойПродукт	= Структ.СтраховойПродукт;
	ВалютаДокумента 	= Структ.Валюта;
	СК 					= Структ.СК;
	НомерЗаявки			= Структ.НомерЗаявки;
	Если НЕ Структ.ДатаОформления = Дата(1,1,1) Тогда
		Дата				= Структ.ДатаОформления;
		ДатаВыдачи			= Структ.ДатаОформления;
	КонецЕсли;
	ДатаНачала			= Структ.ДатаНачала;
	ДатаОкончания		= Структ.ДатаОкончания;
	Страхователь		= Структ.Страхователь;
	
	Заявка 				= Структ.Заявка;
	НомерКартыСтрахователя = Заявка.НомерКартыСтрахователя;
	Если Структ.НомерВзноса = 1 Тогда
		//обычно, если номер взноса не первый, курьер редко совпадает с данными приемки
		Курьер = Структ.Курьер;
	КонецЕсли;
	КурсДокумента 		= Структ.Курс;
	ОрганизацияАгент 	= Структ.ОрганизацияАгент;
	Поставщик 			= Структ.Поставщик;
	Номер 				= СокрЛП(Структ.НомерПолиса);
	ДопДанные = Неопределено;
	
	Структ.Свойство("Аддендум",Аддендум);
	
	Если Структ.Свойство("ДопДанные",ДопДанные) Тогда
		//Часть данных получено ранее из "Заявки на печать"
		Если ЗначениеЗаполнено(ДопДанные.ОбъектСтрахования) Тогда
			ОбъектСтрахования = ДопДанные.ОбъектСтрахования;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДопДанные.Собственник) Тогда
			Собственник = ДопДанные.Собственник;
		КонецЕсли;	
		//ДобавитьЗначениеПараметраЗаявки("ОбъектСтрахования",ЗаявкаПараметры,Структура,Справочники.уб_ОбъектыСтрахования.ПустаяСсылка());
		////ДобавитьЗначениеПараметраЗаявки("Страхователь",ЗаявкаПараметры,Структура);
		//ДобавитьЗначениеПараметраЗаявки("Собственник",ЗаявкаПараметры,Структура);
		Если ЗначениеЗаполнено(ДопДанные.СтраховаяПремияВсего) Тогда
			СтраховаяПремия = ДопДанные.СтраховаяПремияВсего;
		КонецЕсли;	
		
		Если Платежи.Количество() = 0 Тогда
			Пл = Платежи.Добавить();
			Пл.Дата  = Структ.ДатаОформления;
			Пл.Сумма = СтраховаяПремия;
		КонецЕсли;
		
		//TODO Переделать в допДанных на массив
		врСвойство = Неопределено;
		Если ДопДанные.Свойство("Водитель1",врСвойство) Тогда
			Водитель = Застрахованные.Добавить();
			Водитель.ФИО = врСвойство;
		КонецЕсли;	
		Если ДопДанные.Свойство("Водитель2",врСвойство) Тогда
			Водитель = Застрахованные.Добавить();
			Водитель.ФИО = врСвойство;
		КонецЕсли;	
		Если ДопДанные.Свойство("Водитель3",врСвойство) Тогда
			Водитель = Застрахованные.Добавить();
			Водитель.ФИО = врСвойство;
		КонецЕсли;	
		Если ДопДанные.Свойство("Водитель4",врСвойство) Тогда
			Водитель = Застрахованные.Добавить();
			Водитель.ФИО = врСвойство;
		КонецЕсли;	
		Если ДопДанные.Свойство("Водитель5",врСвойство) Тогда
			Водитель = Застрахованные.Добавить();
			Водитель.ФИО = врСвойство;
		КонецЕсли;	
		Если ДопДанные.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО
			или ДопДанные.ВидСП = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО
			Тогда
			СтрокаТЧ = Риски.Добавить();
			СтрокаТЧ.Валюта = ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета;
			СтрокаТЧ.СтраховойРиск = ДопДанные.ВидСП;//Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО;//ПараметрыСеанса.уб_Константы.уб_РискОсаго;
			СтрокаТЧ.СтраховаяСумма = ПараметрыСеанса.уб_Константы.уб_СуммаОсаго;
			СтрокаТЧ.Тариф = ?(НЕ СтрокаТЧ.СтраховаяСумма = 0,СтраховаяПремия*100/СтрокаТЧ.СтраховаяСумма,0);
			СтрокаТЧ.СтраховаяПремия = СтраховаяПремия;
			СтраховаяСумма = СтрокаТЧ.СтраховаяСумма;
		КонецЕсли;
	КонецЕсли;	
	//Номер = уб_СЛ.ДайНомерПолисаСУчетомСостояния(СтруктураЗаполнения.НомерБСО, СостояниеПолиса);
	БСО.Очистить();
	СтрокаТЧ = БСО.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, Структ);
	СтрокаТЧ.Обязательно 	= Истина;
	СтрокаТЧ.Оформлен    	= Истина;
	//TODO получать все значения структуры Структ одним запросом чтобы получать все в одном месте
	СтрокаТЧ.НазначениеБСО = НазначениеБСОПоВидуБСО(Структ.ВидБСО);
	//Если уб_СЛ.НомерПолисаЗаполняетсяПриПоступлении(Структ.ВидБСО) Тогда
	//	НомерНачалоВыбора(ЭлементыФормы.Номер,, Истина);
	//КонецЕсли;
	//Если ЭтаФорма.ДополнительныеСвойства.Свойство("ИмяОбъекта") Тогда
	//	АвтоматическоеОбновлениеФормы();
	//КонецЕсли;
	//замена реквизита ЗаполненНеПолностью, чтобы записать без проверок на данных при создании полиса из приемки
	//однако этот случай отключения проверки должен работать только при создании из приемки,
	//а не если мы создали вручную новый полис и ввели любые данные. Поэтому этот реквизит, на всякий случай
	ОбъектНаОснованииПриемки = Истина;
	//заполнение предоставленных документов по заявке
	//нужно после записи
	//ЗаполнитьПредоставленныеДокументыПоЗаявке(Структ.Заявка);
	
	Если Структ.Свойство("СтрокаЗаявки") Тогда
			СтрокаЗаявки = Структ.СтрокаЗаявки;
			Если СтрокаЗаявки.Свойство("ОбъектСтрахования") Тогда
				ОбъектСтрахования = СтрокаЗаявки.ОбъектСтрахования;			
			КонецЕсли;
			Если ЗначениеЗаполнено(СтраховойПродукт) = Ложь Тогда
				СписокСтрахПр = уб_СЛ.ПолучитьСписокСтрахПродуктов(СК, Дата, СтрокаТЧ.ВидБСО);
				Если СписокСтрахПр.Количество() = 1 Тогда
