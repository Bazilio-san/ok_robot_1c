Функция КвитанцияСуществуетДляСК(НомерКвитанции)
	
	//ВидБСОТипаКвА7 = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СК);
	Структура = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СК);
