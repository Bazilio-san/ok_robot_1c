//требуется для перечитывания данных назначения БСО из страхового продукта, т.к. он может меняться
Функция НазначениеБСОПоВидуБСО(ВидБСО) Экспорт

	Если ЗначениеЗаполнено(СтраховойПродукт) И ЗначениеЗаполнено(ВидБСО) Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СП.НазначениеБСО
		|ИЗ
		|	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК СП
		|ГДЕ
		|	СП.Ссылка = &СтраховойПродукт
		|	И СП.ВидБСО = &ВидБСО
		|
		|УПОРЯДОЧИТЬ ПО
		|	СП.Обязательно УБЫВ");
		Запрос.УстановитьПараметр("СтраховойПродукт", 	СтраховойПродукт);
		Запрос.УстановитьПараметр("ВидБСО",				ВидБСО);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.НазначениеБСО
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

