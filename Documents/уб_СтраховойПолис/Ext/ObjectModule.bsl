		//Если СписокДоступныхРисков.НайтиПоЗначению(СтрокаТЧ.СтраховойРиск) = Неопределено Тогда
		//	СтрокаСообщения = "Выбран не допустимый для страхового продукта риск: " + Строка(СтрокаТЧ.СтраховойРиск) + "!";
		//	ОбщегоНазначения.ОшибкаПриПроведении(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, Отказ, Заголовок);
		//КонецЕсли;		
		Если СтрокаТЧ.СтраховаяСумма <> 0  Тогда
			Если СтрокаТЧ.СтраховаяПремия = 0  Тогда
				СтрокаСообщения = "Указана страховая сумма, но не заполнена страховая премия.";
