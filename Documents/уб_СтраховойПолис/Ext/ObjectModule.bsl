Функция ПолучитьТС(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТС.РегистрационныйЗнак,
	|	ТС.ИдентификационныйНомер,
	|	ТС.МаркаТС,
	|	ТС.МодельТС,
	|	ТС.ТипТС,
	|	ТС.Категория,
	|	ТС.ГодВыпуска,
	|	ТС.ДвигательНомер,
	|	ТС.ШассиНомер,
	|	ТС.КузовНомер,
	|	ТС.Цвет,
	|	ТС.МощностьДвигателя,
	|	ТС.МаксМасса,
	|	ТС.КолПассажирскихМест,
	|	ТС.Грузоподъемность,
	|	ТС.ПротивоугоннаяСистема,
	|	ТС.ПаспортСерия,
	|	ТС.ПаспортНомер,
	|	ТС.ПаспортДатаВыдачи
	|ИЗ
	|	РегистрСведений.уб_ТранспортныеСредства КАК ТС
	|ГДЕ
	|	ТС.Объект = &Объект";	
	Запрос.УстановитьПараметр("Объект", Объект);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

