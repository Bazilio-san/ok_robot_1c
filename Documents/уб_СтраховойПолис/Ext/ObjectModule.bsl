Перем мВалютаРегламентированногоУчета Экспорт;
Перем _НеОповещатьОЗаписи_ Экспорт;
Перем СтруктураВидБСО Экспорт;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Модифицированность();
	
	ВидСП = ?(ТипЗнч(Страховойпродукт)=Тип("СправочникСсылка.уб_СтраховыеПродукты"),Страховойпродукт.Вид,Страховойпродукт);
	
	уб_РасчетыСМенеджерами.ПроверитьВидСтрахования(ЭтотОбъект,ВидСП);
	
	//уб_ВызовСервера._УстановитьЗначение(ЭтотОбъект,"ВидС", ВидСтрахования);

	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(ПодразделениеОП) Тогда
		ПодразделениеОП = уб_СС.ПолучитьПодразделениеАгента(Агент, Дата);
	КонецЕсли;	
	

	Если Не ЗначениеЗаполнено(Собственник) Тогда
		Собственник = Страхователь;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	Если ЭтоНовый() Тогда
		Запрос.УстановитьПараметр("Заявка",Заявка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
		               |	ЛОЖЬ КАК Проведен,
		               |	ЛОЖЬ КАК ПометкаУдаления,
		               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Куратор
		               |ИЗ
		               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста";
	Иначе
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
			|	уб_СтраховойПолис.Ссылка,
			|	уб_СтраховойПолис.Проведен,
			|	уб_СтраховойПолис.ПометкаУдаления,
			|	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Куратор
			|ИЗ
			|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
			|		ПО уб_СтраховойПолис.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
			|ГДЕ
		|	уб_СтраховойПолис.Ссылка = &Ссылка";		
	КонецЕсли;		   
	ВыборкаСсылка = Запрос.Выполнить().Выбрать();
	Если ВыборкаСсылка.Следующий() Тогда
		бУстановкаПометкиУдаления = НЕ ВыборкаСсылка.ПометкаУдаления И ПометкаУдаления;
		бСнятиеПометкиУдаления = ВыборкаСсылка.ПометкаУдаления И НЕ ПометкаУдаления;
		
		бПроведение = НЕ ВыборкаСсылка.Проведен И Проведен;
		бСнятиеПроведения = ВыборкаСсылка.Проведен И НЕ Проведен;
		Если ЗначениеЗаполнено(ВыборкаСсылка.Куратор) и не Куратор = ВыборкаСсылка.Куратор Тогда
			Куратор = ВыборкаСсылка.Куратор;
		КонецЕсли;
	Иначе
		бУстановкаПометкиУдаления = ПометкаУдаления;
		бСнятиеПометкиУдаления = НЕ ПометкаУдаления;
		бПроведение  = Проведен;
		бСнятиеПроведения = НЕ Проведен;
	КонецЕсли;
	
	
	// Нельзя помечать на удаление полисы, содержащие оплаты
	Если бУстановкаПометкиУдаления Тогда
		ТЗОплат = ОП_ПолучитьТЗОплат();
		Если ТЗОплат.Количество() > 0 Тогда
			Отказ = Истина;
			#Если Клиент Тогда
			Предупреждение("Нельзя помечать как удаленный полис, в котором есть оплаты!
			|
			|Сначала удалите все оплаты.
			|
			|(Для удаления оплаты, ее необходимо вначале отсоединить от отчетов Агенту и Поставщику)",15,"Внимание! Операция отменена!");
			#КонецЕсли
			Возврат;	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;		
	Если ПараметрыСеанса.уб_Константы.ОтключитьДвиженияВПолисе Тогда
		Возврат;	
	КонецЕсли;	
	#Если Клиент Тогда
	Если ПараметрыСеанса.уб_Константы.ОчищатьСообщенияПриЗаписиДокументов Тогда
		ОчиститьСообщения();
	КонецЕсли;	
	#КонецЕсли
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = "Запись документа """ + СокрЛП(Ссылка) + """: ";
	Если Не Отказ И НЕ Проведен Тогда
		ТаблицаБСО = ДвиженияПоРегистрам(Отказ, Заголовок);		
		Если Не Отказ Тогда
			//Проверить сдачу БСО выданного по заявке, связанной с полисом
			//уб_УСЗ.ПроверитьНеобходимостьВозвратаПоСвязаннымЗаявкам(Ссылка);		
			//Установка/Исправление флага крупной сделки оплат 
			Если ПараметрыСеанса.уб_Константы.уб_ИспользуетсяМеханизмСделок = ИСТИНА Тогда
				ЭтоКрупнаяСделка = НЕ Сделка.Пустая() И НЕ (НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная или НомерЗаявки = Перечисления.уб_ВидыЗаявок.Агентская) И Сделка.Крупная ;			
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	уб_ОплатаПолисов.Ссылка
				|ИЗ
				|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
				|ГДЕ
				|	уб_ОплатаПолисов.ПометкаУдаления = ЛОЖЬ
				|	И НЕ уб_ОплатаПолисов.ЭтоКрупнаяСделка = &ЭтоКрупнаяСделка
				|	И уб_ОплатаПолисов.СтраховойПолис = &СтраховойПолис");			
				Запрос.УстановитьПараметр("СтраховойПолис", Ссылка);
				Запрос.УстановитьПараметр("ЭтоКрупнаяСделка", ЭтоКрупнаяСделка);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОБОплата =  Выборка.Ссылка.ПолучитьОбъект();
					ОБОплата.ЭтоКрупнаяСделка = ЭтоКрупнаяСделка;
					Попытка
						//ОБОплата.ЭтоПереустановкаЗПКрупнойСделки = Истина;//Отключаем проверку правки периода старых оплат (в случае удаления оплаты из крупной сделки возможны проблемы)
						ОБОплата.Записать();
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка при исключении оплаты из крупной сделки. Попробуйте записать полис."+Символы.ПС+
						"Техническая информация: "+ОписаниеОшибки(),
						"Сообщить", 
						Истина,
						УровеньЖурналаРегистрации.Ошибка,
						Ссылка.Метаданные(),
						Ссылка,
						"Error");
					КонецПопытки;	
				КонецЦикла;	
			КонецЕсли;
			Если Не Проведен Тогда
				Если ДополнительныеСвойства.Свойство("НеДвигатьСтатусы") Тогда
				Иначе
					уб_УСЗ.ТребуетсяВозвратБСОПоСсылке(Ссылка);
				КонецЕсли;
				
			КонецЕсли;
		Иначе	
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Отказ после движения по регистрам при проведении",
			"Сообщить", 
			Истина,
			УровеньЖурналаРегистрации.Ошибка,
			Ссылка.Метаданные(),
			Ссылка,
			"Error");
		КонецЕсли;
	Иначе
		Если Отказ Тогда
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Отказ при записи документа",
			"Сообщить", 
			Истина,
			УровеньЖурналаРегистрации.Ошибка,
			Ссылка.Метаданные(),
			Ссылка,
			"Error");
		КонецЕсли;
	КонецЕсли;

	Если Отказ = Ложь и ПустаяСтрока(КоличествоФайловB2B) Тогда
		уб_СтраховойБрокер.ПроставитьСтрахователяВФайлахПоЗаявке(Ссылка);
		_НеОповещатьОЗаписи_ = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ОбъектКопирования.Дата;
	//стираем данные агента, т.к. при копировании без права ЗП_ПолныйДоступ Агента нельзя менять даже в незаписанном документе
	Если Не уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ") Тогда
		Агент = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ПараметрыСеанса.уб_Константы.ОтключитьДвиженияВПолисе Тогда
		Возврат;	
	КонецЕсли;	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = "Проведение документа """ + СокрЛП(Ссылка) + """: ";
	СтруктураОбязательныхПолей = Новый Структура("СК, СтраховойПродукт, ОбъектСтрахования, Страхователь, ВалютаДокумента, НомерЗаявки, Поставщик, ОрганизацияАгент, Ответственный, Ответственный2, СтраховаяСумма, СтраховаяПремия");
	ОбщегоНазначения.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		СтрокаСообщения = "Номер полиса не заполнен. Проведение не возможно!";
		ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
	КонецЕсли;	
	// Проверяем правильность выбора типа объекта страхования
	Если ТипЗНЧ(СтраховойПродукт) = Тип("СправочникСсылка.уб_ОбъектыСтрахования") Тогда
		ТипОбъектаСтрахованияУказанВерно = ЛОЖЬ; 		
		Если Не СтраховойПродукт.Пустая() И Не ОбъектСтрахования.Пустая() Тогда
			Для Каждого СтрокаТЧ из СтраховойПродукт.ТипыОбъектовИРиски Цикл
				Если СтрокаТЧ.ТипОбъекта = ОбъектСтрахования.Тип Тогда
					ТипОбъектаСтрахованияУказанВерно = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтраховойПродукт.ТипыОбъектовИРиски.Количество() = 0 Тогда
				ДопИнфо = " (Отсутствуют страховые риски)";
			Иначе
				ДопИнфо = "";	
			КонецЕсли;
			Если НЕ ТипОбъектаСтрахованияУказанВерно Тогда
				СтрокаСообщения = "Тип объекта не найден в страховом продукте! "+ДопИнфо+". "+Ссылка;
				ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
			КонецЕсли;
		КонецЕсли; 
	Иначе
		ТипОбъектаСтрахованияУказанВерно = Истина; 		
	КонецЕсли; 
	ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок);
	Если ТипОбъектаСтрахованияУказанВерно Тогда
		ПроверитьЗаполнениеТабличнойЧастиРиски(Отказ, Заголовок);
	КонецЕсли;
	ПроверитьЗаполнениеТабличнойЧастиОплаты(Отказ, Ложь, Истина, Ложь, Ложь, 1,,,Истина);	
	// Движения по документу
	Если Не Отказ Тогда
		ТаблицаБСО = ДвиженияПоРегистрам(Отказ, Заголовок);
		Если ДополнительныеСвойства.Свойство("НеДвигатьСтатусы") Тогда
		Иначе
			уб_УСЗ.ТребуетсяВозвратБСОПоСсылке(Ссылка);
		КонецЕсли;
	КонецЕсли;	
	#Если Клиент Тогда
	Оповестить("ПриЗаписиСтраховогоПолиса", Проведен, ЭтотОбъект);
	#КонецЕсли

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Для Каждого НаборЗаписей Из Движения Цикл
		Если НаборЗаписей <> Движения.уб_СвободныеНомераПолисов Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
    
Функция ДвиженияПоРегистрам(Отказ, Заголовок)
	
	ТаблицаБСО = ПодготовитьТаблицуБСО();
	Если Поставщик.Пустая() Тогда
		ОбщегоНазначения.ОшибкаПриПроведении("Не указан Поставщик", Отказ, Заголовок);
		Возврат ТаблицаБСО;	
	КонецЕсли;
	Если ОрганизацияАгент.Пустая() Тогда
		ОбщегоНазначения.ОшибкаПриПроведении("Не указана Организация-Агент", Отказ, Заголовок);
		Возврат ТаблицаБСО;	
	КонецЕсли;
	// удаляем движения по регистрам
	Для Каждого НаборЗаписей Из Движения Цикл
		Если НаборЗаписей <> Движения.уб_СвободныеНомераПолисов Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;
	ПолисАннулирован = уб_СЛ.ПолисАннулирован(СостояниеПолиса);
	//Признак того, что данное движение должно быть записано КАК ЕСТЬ (только для информации с соответствующими флажками)
	ИнфоЗапись = Не Ссылка.Проведен Или ОтключитьКонтрольНомеровБСО;
	пНзнБСО = Перечисления.уб_НазначенияБСО;
	пПлжБСО = Перечисления.уб_ПоложенияБСО;
	пСстБСО = Перечисления.уб_СостоянияБСО;
	КонтролироватьНаличиеБСО = ПараметрыСеанса.уб_Константы.уб_КонтролироватьНаличиеБСО;
	Для Каждого СтрокаТЧ Из ТаблицаБСО Цикл
		НаборДвижений = Новый Массив;
		НаборДвижений.Добавить("Основное");
		Если ПолисАннулирован Тогда
			Если ДатаАннулирования = Дата(1,1,1) Тогда
				ДатаАннулирования = ДатаИзменения;
			КонецЕсли;	
			НаборДвижений.Добавить("Аннулирование");
		КонецЕсли;
		ВидБСО = СтрокаТЧ.ВидБСО;
		Если СтрокаТЧ.ЭтоКвитанцияВОплате Тогда
			s1 = "Закладка 'Оплаты'. ";
			s2 = "Взнос № ";
			s3 = "";
		Иначе
			s1 = "Закладка 'БСО'. ";
			s2 = "Строка № ";
			s3 = "БСО ";
		КонецЕсли;
		sГде = s1 + s2 + СокрЛП(Строка(СтрокаТЧ.НомерСтроки)) + ": ";
		сВидБСО = Строка(СтрокаТЧ.ВидБСО);
		сНомБСО = СокрЛП(СтрокаТЧ.НомерБСО);
		sБСО = s3 + "'" + сВидБСО + "' с номером " + сНомБСО;
		sГде_и_БСО = sГде + sБСО;
		Если ТипЗнч(СтрокаТЧ.ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
			актуалСК = СК;
		Иначе	
			актуалСК = ?(СтрокаТЧ.ВидБСО.УниверсальноеБСО, СтрокаТЧ.ВидБСО.Владелец, СК);
		КонецЕсли;	
		актуалПоставщик = Неопределено;
		актуалОргАгент 	= Неопределено;
		АктуалЗаявка    = Неопределено;
	
		Если СтрокаТЧ.ВедетсяНомернойУчет = Истина Тогда 
			_ЕстьОшибка = Ложь;
			////////////////////////////////////////////////////////////////////
			// Проверки ключеых измерений, если они не заполнены, в регистр не пишем ни при каких обстояельсвах
			Если сНомБСО = "" Тогда
				_ЕстьОшибка = Истина;
				СтрокаСообщения = sГде +" Не указан номер БСО!";
			КонецЕсли;
			Если СК.Пустая() = "" Тогда
				_ЕстьОшибка = Истина;
				СтрокаСообщения = "Не указана сраховая компания!";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВидБСО) Тогда
				_ЕстьОшибка = Истина;
				СтрокаСообщения = sГде + " Не указан Вид БСО!";
			КонецЕсли;
			Если _ЕстьОшибка Тогда
				Если ИнфоЗапись Тогда
					Отказ_Пустышка = Ложь;
					ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ_Пустышка, Заголовок);
				Иначе
					ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
				Продолжить;	
			КонецЕсли;
			////////////////////////////////////////////////////////////////////
			СтруктураБСО = уб_СЛ.ПолучитьСтруктуруБСО();		
			СтруктураБСО.Период 	= Новый Граница(СтрокаТЧ.ДатаДвижения, ВидГраницы.Исключая);
			СтруктураБСО.СК 		= актуалСК;			
			СтруктураБСО.ВидБСО 	= ВидБСО;
			СтруктураБСО.НомерБСО 	= сНомБСО;	
			уб_СЛ.ПрочитатьСостояниеБСО(СтруктураБСО);
			Если СтруктураБСО.Существует Тогда 
				//Если ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО")
				//	И ВидБСО.УниверсальноеБСО Тогда
				//	актуалПоставщик = СтруктураБСО.Поставщик;
				//	актуалОргАгент 	= СтруктураБСО.ОрганизацияАгент;
				//Иначе	
					актуалПоставщик = Поставщик;
					актуалОргАгент 	= ОрганизацияАгент;
				//КонецЕсли;				
				//По идее, такого случаться не должно 
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.АгентОТ) Тогда
					СтрокаТЧ.АгентОТ = СтруктураБСО.Агент;	
				КонецЕсли;
			Иначе
				Если ТипЗнч(ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
					актуалПоставщик = Поставщик;
					актуалОргАгент 	= ОрганизацияАгент;
				Иначе
					Если Не ВидБСО.УниверсальноеБСО Тогда
						актуалПоставщик = Поставщик;
						актуалОргАгент 	= ОрганизацияАгент;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;			
			//TO DO  Когда это может быть
			Если Лев(сНомБСО,4) = "=НЕТ" Тогда
				СтруктураБСО.Существует = Истина;				
				СтруктураБСО.СК = актуалСК;
				СтруктураБСО.ВидБСО 			= ВидБСО;
				СтруктураБСО.НомерБСО 			= сНомБСО;
				СтруктураБСО.Поставщик 			= ?(Не ЗначениеЗаполнено(актуалПоставщик), актуалСК, актуалПоставщик);
				СтруктураБСО.ОрганизацияАгент 	= ?(Не ЗначениеЗаполнено(актуалОргАгент), ПараметрыСеанса.уб_ОсновнаяОрганизация, актуалОргАгент);
				СтруктураБСО.Подтверждено  		= Истина;
				//СтруктураБСО.ДокПроведен 		= Истина;
				//СтруктураБСО.Активность 		= Истина;
				//СтруктураБСО.ДокПроведен 		= Проведен;
				СтруктураБСО.Активность 		= Проведен;
				//СтруктураБСО.АгентОтправитель
				СтруктураБСО.Агент				= СтрокаТЧ.АгентОТ;	
				СтруктураБСО.ПоложениеБСО 		= пПлжБСО.ПолученИзСК;
				СтруктураБСО.СостояниеБСО 		= пСстБСО.ПустойБланк;
				СтруктураБСО.Блокировка 		= Ложь;
				СтруктураБСО.НомерПолиса 		= СокрЛП(Номер);
				СтруктураБСО.ГодПолиса 			= "";
				//СтруктураБСО.СтраховойПолис 	= ;
				СтруктураБСО.НаОснованииБумажногоДокумента = Ложь;
				СтруктураБСО.ДатаВозврата 		= Неопределено;
			КонецЕсли;			
			Проводить = Истина;			
			////////////////////////////////////////////////////////////////////
			Если ТипЗнч(СтруктураБСО.ВидБСО) = ТИП("СправочникСсылка.уб_ВидыБСО")  и НЕ СтруктураБСО.ВидБСО.ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.УчетНеВедетсяПолисВручную Тогда
				Если НЕ СтруктураБСО.Существует Тогда
					Проводить = Ложь;
					Если КонтролироватьНаличиеБСО Тогда
						_ЕстьОшибка = Истина;
						СтрокаСообщения = sГде_и_БСО + " не найден(а) для указанной СК: '" + актуалСК.Наименование + "'";
					КонецЕсли;		
				ИначеЕсли КонтролироватьНаличиеБСО Тогда				
					Если НЕ Пересортица Тогда
						СОО2 = "Установите флаг 'Пересортица' на закладке оплаты или устраните ошибку путем переоформления квитанции";
						Если СтруктураБСО.Поставщик <> актуалПоставщик Тогда
							Проводить 	= Ложь;
							_ЕстьОшибка = Истина;
							СтрокаСообщения = sГде_и_БСО + " не может быть оформлено! Т.к. поступало от поставщика: '" + 
							СтруктураБСО.Поставщик.Наименование + "', а в полисе указан поставщик: '" + актуалПоставщик.Наименование + "'"
							+ Символы.ВК + Символы.ПС + СОО2;
						КонецЕсли;					
						Если СтруктураБСО.ОрганизацияАгент <> актуалОргАгент Тогда
							Проводить 	= Истина;
							_ЕстьОшибка = Ложь;
							ИнфоЗапись 	= Ложь;
							СтрокаСообщения = sГде_и_БСО + " может быть оформлено в исключительных случаях! Т.к. числится на Организации-Агенте: '" + 
							СтруктураБСО.ОрганизацияАгент.Наименование + "', а в полисе указан ОргАгент: '" + актуалОргАгент.Наименование + "'"
							+ Символы.ВК + Символы.ПС + СОО2;
							//теперь оргагент - это ресурс, нельзя дублировать записи
							//НаборДвижений.Добавить("СписатьСДругогоОргАгента");
						КонецЕсли;
					КонецЕсли;								
				КонецЕсли;
			КонецЕсли;
			ТекСост = СтруктураБСО.СостояниеБСО;
			бЗапретПроведенияПоТекСостоянию = Ложь;
			Если Проводить Тогда
				Если ТекСост = пСстБСО.Оформлен Тогда
					Если ТипЗнч(СтруктураБСО.Регистратор) <> Тип("ДокументСсылка.уб_ПриемкаОплат") Тогда
						бЗапретПроведенияПоТекСостоянию = Ложь;
					КонецЕсли;
				ИначеЕсли ТекСост <> пСстБСО.ПустойБланк И ТекСост <> пСстБСО.НеиспользованныйБланк Тогда
					бЗапретПроведенияПоТекСостоянию = Ложь;
				КонецЕсли;
			КонецЕсли;			
			Если бЗапретПроведенияПоТекСостоянию Тогда
				Проводить = Ложь;
				_ЕстьОшибка = Истина;
				СтрокаСообщения = sГде_и_БСО + " имеет состояние '" + Строка(ТекСост) + "' и не может быть оформлен!";
			КонецЕсли;				
			Если Проводить И СтруктураБСО.Блокировка = Истина Тогда
				Проводить = Ложь;
				_ЕстьОшибка = Истина;
				СтрокаСообщения = sГде_и_БСО + "' с номером " + сНомБСО + " заблокирован!";
			КонецЕсли;			
			//Определение кода операции
			Если СтруктураБСО.Тип = Перечисления.уб_ТипыБСО.Полис ИЛИ СтруктураБСО.Тип = Перечисления.уб_ТипыБСО.ПолисОсаго Тогда 
				оснКодОперации = Перечисления.уб_КодыОперацийБСО.ОформлениеПолиса;
			ИначеЕсли СтрокаТЧ.ЭтоКвитанцияВОплате = Истина Тогда	
				оснКодОперации = Перечисления.уб_КодыОперацийБСО.ОформлениеКвитанции;
			Иначе
				оснКодОперации = Перечисления.уб_КодыОперацийБСО.ОформлениеБСО;
			КонецЕсли;	
			Для Каждого ОтдельноеДвижение ИЗ НаборДвижений Цикл			
				Если ОтдельноеДвижение = "Аннулирование" Тогда
					Период = ?(СтрокаТЧ.ДатаДвижения < ДатаАннулирования, ДатаАннулирования, СтрокаТЧ.ДатаДвижения + 60);
					АгентКуда 		= ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
					СостояниеБСО 	= пСстБСО.Испорчен;	
					ПоложениеБСО	= пПлжБСО.ВозвращенСТочки;
					КодОперации		= Перечисления.уб_КодыОперацийБСО.АннулированиеПолиса;
				//ИначеЕсли ОтдельноеДвижение = "СписатьСДругогоОргАгента" Тогда	
				//	//неактуальное
				//	СостояниеБСО 	= пСстБСО.Оформлен;	
				//	ПоложениеБСО	= пПлжБСО.Списан;
				//	актуалОргАгент  = СтруктураБСО.ОрганизацияАгент;
				//	КодОперации = оснКодОперации;
				//	продолжить;//TODO Старое действие, аккуратно убрать
				Иначе // "Основное"
					Период = СтрокаТЧ.ДатаДвижения;
					АгентКуда = СтрокаТЧ.АгентКУДА;
					СостояниеБСО = пСстБСО.Оформлен;						
					Если СтрокаТЧ.НазначениеБСО = пНзнБСО.ДляКлиента Тогда
						ПоложениеБСО	= пПлжБСО.ОтданКлиенту;
					ИначеЕсли СтрокаТЧ.НазначениеБСО = пНзнБСО.ДляБанка Тогда
						ПоложениеБСО	= пПлжБСО.ОтданБанку;
					Иначе
						Если СтруктураБСО.Существует Тогда
							текПлж = СтруктураБСО.ПоложениеБСО;
							Если Подразделение.ТипПодразделения = Перечисления.уб_ТипПодразделения.ГоловнойОфис 
								И (текПлж = пПлжБСО.ПереданНаТочку ИЛИ текПлж = пПлжБСО.ПереданВСК ИЛИ текПлж = пПлжБСО.Списан)
								Тогда
								//раз оформляем перемещение по головному офису, то тех положений не может быть) 
								ПоложениеБСО	= пПлжБСО.ВозвращенСТочки;
							Иначе
								ПоложениеБСО	= СтруктураБСО.ПоложениеБСО;
							КонецЕсли;
						Иначе 
							Если Подразделение.ТипПодразделения = Перечисления.уб_ТипПодразделения.ГоловнойОфис Тогда
								ПоложениеБСО	= пПлжБСО.ВозвращенСТочки;
							Иначе
								ПоложениеБСО	= пПлжБСО.ПереданНаТочку;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					КодОперации = оснКодОперации;
				КонецЕсли;
				Если (НЕ _ЕстьОшибка И Проводить) ИЛИ ИнфоЗапись Тогда
					СтрокаТЧ.УчавствуетВдвижениях = Истина;
					Движение = Движения.уб_ДвиженияБСО.Добавить();
					// измерения
					Движение.Период				= Период;						
					Движение.СК					= СтруктураБСО.СК;
					Движение.ВидБСО				= ВидБСО;
					Движение.НомерБСО			= сНомБСО;				
					Если СтруктураБСО.Тип = перечисления.уб_ТипыБСО.КвитанцияА7 Тогда
						//Из оплаты
						Движение.ДопНомерБСО		= СтрокаТЧ.ДопНомерБСО;				
					Иначе	
						//Из движений
						Движение.ДопНомерБСО		= СтруктураБСО.ДопНомерБСО;				
					КонецЕсли;	
					Движение.Поставщик			= актуалПоставщик;
					Движение.ОрганизацияАгент	= актуалОргАгент;					
					Если ОтдельноеДвижение = "Аннулирование" Тогда
						Движение.Период				= ?(ДатаАннулирования=Дата(1,1,1),Период,ДатаАннулирования);						
						Движение.Подтверждено 	= Истина;
						//Движение.ДокПроведен	= Ложь;
						//Движение.Активность		= Ложь;
					Иначе
						Движение.Подтверждено   	= (Не ИнфоЗапись И СтруктураБСО.Существует) И Лев(сНомБСО,4) <> "=НЕТ" ;
						//или СтруктураБСО.ВидБСО.ТипУчетаБСО = Перечисления.уб_ТипыУчетаБСО.УчетНеВедетсяПолисВручную; // И (НЕ уб_СЛ.ПолисАннулирован(СостояниеПолиса) И НЕ ОтдельноеДвижение = "Аннулирование" )
						//Движение.ДокПроведен 		= Ссылка.Проведен;
						//Движение.Активность 		= Ссылка.Проведен;
					КонецЕсли;
					//Движение.ДокПроведен 		= Проведен;
					Движение.Активность 		= Проведен;
					// ресурсы
					Движение.АгентОтправитель 	= СтрокаТЧ.АгентОТ;
					Движение.Агент 				= АгентКуда;	
					Движение.ПоложениеБСО		= ПоложениеБСО;
					Движение.СостояниеБСО		= СостояниеБСО;
					//Движение.Блокировка			= ?(СтруктураБСО.Существует, СтруктураБСО.Блокировка, Ложь);					
					Движение.НомерПолиса		= СокрЛП(Номер); // номер документа
					Движение.ГодПолиса			= СтруктураБСО.ГодПолиса;
					Движение.СтраховойПолис		= Ссылка;
					Движение.НаОснованииБумажногоДокумента = Истина;					
					Движение.ДатаВозврата 		= ?(СтруктураБСО.Существует, СтруктураБСО.ДатаВозврата, Неопределено);					
					Движение.КодОперации		= КодОперации;
					Движение.Заявка         	= СтруктураБСО.Заявка;
				КонецЕсли;				
			КонецЦикла; //НаборДвижений			
			Если _ЕстьОшибка Тогда
				Если ИнфоЗапись Тогда
					Отказ_Пустышка = Ложь;
					ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ_Пустышка, Заголовок);
					Если ОтключитьКонтрольНомеровБСО Тогда
						Сообщить("Эти ошибки не влияют на запись и проведение документа, поскольку установлен флаг 'Отключить контроль номеров БСО'!");
					Иначе	
						Сообщить("Эти ошибки будут критичны при проведении, но не влияют на запись документа!");
					КонецЕсли;
				Иначе
					ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрокаТЧ.ВедетсяКоличественныйУчет = Истина Тогда			
			Если ИнфоЗапись Тогда
				Продолжить;	
			КонецЕсли;			
			//Ранее может быть осуществлена приемка оплаты по данному полису
			//В от момент уже списыался 1 бланк с того, от кого получены деньги
			//И тогда в РС "Движения БСО" будет запись для данного номера БСО (производное от номера полиса)
			//Поэтому, если найдем запись в РС Движения БСО , то списывать полис по остаткам не будем
			
			//СтруктураОтбора = Новый Структура("СК, ВидБСО, НомерБСО, Подтверждено, ДокПроведен"
			//, актуалСК, ВидБСО, сНомБСО,Истина,Истина);
			//НаМомент = Новый Граница(СтрокаТЧ.ДатаДвижения, ВидГраницы.Исключая);
			//тзРег = РегистрыСведений.уб_ДвиженияБСО.СрезПоследних(НаМомент, СтруктураОтбора);
			//Если тзРег.Количество() > 0 Тогда
			//	Если тзРег.Количество() > 1 Тогда
			//		тзРег.Сортировать("Период УБЫВ");
			//	КонецЕсли;
			//	актуалПоставщик = тзРег[0].Поставщик;
			//	актуалОргАгент  = тзРег[0].ОрганизацияАгент;
			//	АктуалЗаявка    = тзРег[0].Заявка; 
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДБ.Поставщик,
			|	ДБ.ОрганизацияАгент,
			|	ДБ.Заявка
			|ИЗ
			|	РегистрСведений.уб_ДвиженияБСО КАК ДБ
			|ГДЕ
			|	ДБ.ВидБСО = &ВидБСО
			|	И ДБ.НомерБСО = &НомерБСО
			|	И ДБ.Подтверждено
			|	И ДБ.Активность
			|	И ДБ.Поставщик = &Поставщик
			|	И ДБ.ОрганизацияАгент = &ОрганизацияАгент
			|	И ДБ.Регистратор ССЫЛКА Документ.уб_ПриемкаОплат
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДБ.Период УБЫВ";
			Запрос.УстановитьПараметр("ВидБСО",				ВидБСО);
			Запрос.УстановитьПараметр("НомерБСО",			сНомБСО);			
			Запрос.УстановитьПараметр("Поставщик",			Поставщик);
			Запрос.УстановитьПараметр("ОрганизацияАгент",	ОрганизацияАгент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				АктуалЗаявка = Выборка.Заявка;			
				Для Каждого ОтдельноеДвижение ИЗ НаборДвижений Цикл					
					//TODO перенести под условие ниже уб_СЛ.ОпределитьУчетНеВедется(СтрокаТЧ.ВидБСО, СтрокаТЧ.ТипУчетаБСО)
					Если ОтдельноеДвижение = "Аннулирование" Тогда
						Период 			= ?(СтрокаТЧ.ДатаДвижения < ДатаАннулирования, ДатаАннулирования, СтрокаТЧ.ДатаДвижения + 60);
						АгентКуда 		= ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
						СостояниеБСО 	= пСстБСО.Испорчен;	
						ПоложениеБСО	= пПлжБСО.ВозвращенСТочки;
						КодОперации		= Перечисления.уб_КодыОперацийБСО.АннулированиеПолиса;
					Иначе // "Основное"
						Период 			= СтрокаТЧ.ДатаДвижения;
						АгентКуда 		= СтрокаТЧ.АгентКУДА;
						СостояниеБСО 	= пСстБСО.Оформлен;							
						Если СтрокаТЧ.НазначениеБСО = пНзнБСО.ДляКлиента Тогда
							ПоложениеБСО = пПлжБСО.ОтданКлиенту;
						ИначеЕсли СтрокаТЧ.НазначениеБСО = пНзнБСО.ДляБанка Тогда
							ПоложениеБСО = пПлжБСО.ОтданБанку;
						ИначеЕсли Подразделение.ТипПодразделения = Перечисления.уб_ТипПодразделения.ГоловнойОфис Тогда
							ПоложениеБСО = пПлжБСО.ВозвращенСТочки;
						Иначе
							ПоложениеБСО = пПлжБСО.ПереданНаТочку;
						КонецЕсли;
						КодОперации	= Перечисления.уб_КодыОперацийБСО.ОформлениеБСО;
					КонецЕсли;					
					Если уб_СЛ.ОпределитьУчетНеВедется(СтрокаТЧ.ВидБСО, СтрокаТЧ.ТипУчетаБСО)
						и СтрокаТЧ.Оформлен
						и СтрокаТЧ.НазначениеБСО = пНзнБСО.Остается
						Тогда 
						//ТекМОЛ = СоотвМОЛ.Получить(СтрокаТЧ.ВидБСО);
						Движение = Движения.уб_ДвиженияБСО.Добавить();
						// измерения
						Движение.Период			  = Период;
						Движение.СК				  = актуалСК;
						Движение.ВидБСО			  = СтрокаТЧ.ВидБСО;
						Движение.НомерБСО		  = уб_СЛ.ДайНомерБСОДляКоличУчета(Номер);
						Движение.Поставщик		  = актуалПоставщик;
						Движение.ОрганизацияАгент = актуалОргАгент;
						Движение.Подтверждено     = НЕ ИнфоЗапись;
						//Движение.ДокПроведен 	  = Ссылка.Проведен;
						//Движение.Активность 	  = Ссылка.Проведен;
						//Движение.ДокПроведен 	  = Проведен;
						Движение.Активность 	  = Проведен;
						// ресурсы
						Движение.АгентОтправитель = СтрокаТЧ.АгентОТ;
						Движение.Агент	= АгентКУДА;							
						Движение.ПоложениеБСО	= ПоложениеБСО;
						Движение.СостояниеБСО	= СостояниеБСО;
						//Движение.Блокировка		= Ложь;
						Движение.НомерПолиса	= СокрЛП(Номер); // номер документа
						Движение.ГодПолиса		= "";
						Движение.СтраховойПолис	= Ссылка;
						Движение.НаОснованииБумажногоДокумента = Истина;					
						Движение.ДатаВозврата	= Неопределено;					
						Движение.КодОперации	= КодОперации;
						Движение.Заявка         = АктуалЗаявка;
					КонецЕсли;
				КонецЦикла; //НаборДвижений				
				Продолжить;
			КонецЕсли;
			актуалПоставщик = Поставщик;
			актуалОргАгент	= ОрганизацияАгент;
			СтруктураБСО = уб_СЛ.ПолучитьСтруктуруБСО();
			СтруктураБСО.Период = Новый Граница(СтрокаТЧ.ДатаДвижения, ВидГраницы.Исключая);
			//!!!TO DO!!!
			//СтруктураБСО.Поставщик 	= актуалПоставщик;
			СтруктураБСО.Поставщик 	= Поставщик;
			//СтруктураБСО.ОрганизацияАгент 	= актуалОргАгент;
			СтруктураБСО.ОрганизацияАгент 	= ОрганизацияАгент;
			СтруктураБСО.СК 		= актуалСК;
			СтруктураБСО.ВидБСО 	= ВидБСО;
			СтруктураБСО.Агент		= СтрокаТЧ.АгентОТ;
			тзОстатки = уб_СЛ.ПолучитьОстаткиБСО(СтруктураБСО);			
			НадоКолБСО = СтрокаТЧ.КоличествоБСО;
			ОстКолБСО = НадоКолБСО;
			Для Каждого СтрокаТЗ из тзОстатки Цикл
				Если СтрокаТЗ.Количество >= ОстКолБСО Тогда
					ЕстьКолБСО = ОстКолБСО;
				ИначеЕсли СтрокаТЗ.Количество > 0 Тогда
					ЕстьКолБСО = СтрокаТЗ.Количество;
				Иначе
					ЕстьКолБСО = 0;
				КонецЕсли;
				Если ЕстьКолБСО > 0 Тогда
					СтрокаТЧ.УчавствуетВдвижениях = Истина;
					Движение				= Движения.уб_ОстаткиБСО.Добавить();					
					Движение.ВидДвижения	= ВидДвиженияНакопления.Расход;
					Движение.Период			= СтрокаТЧ.ДатаДвижения;
					// измерения
					//!!!TO DO!!!
					//Движение.Поставщик		= актуалПоставщик;
					Движение.Поставщик		= Поставщик;
					//Движение.ОрганизацияАгент 	= актуалОргАгент;
					Движение.ОрганизацияАгент 	= ОрганизацияАгент;
					актуалПоставщик = Поставщик;
					актуалОргАгент 	= ОрганизацияАгент;
					Движение.СК				= актуалСК;
					Движение.ВидБСО			= СтрокаТЗ.ВидБСО;
					Движение.Агент			= СтрокаТЧ.АгентОТ;	
					// ресурсы
					Движение.Количество		= ЕстьКолБСО;
					// реквизиты
					Движение.КодОперации	= Перечисления.уб_КодыОперацийБСО.ОформлениеБСО;					
					//TODO Заявка Добавить движение
					Движения.уб_ОстаткиБСО.Записать();					
					ОстКолБСО = ОстКолБСО - ЕстьКолБСО;
				КонецЕсли;
				Если ОстКолБСО = 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ПараметрыСеанса.уб_Константы.уб_КонтролироватьОстаткиБСО И ОстКолБСО > 0 Тогда
				НаКом = ?(Не ЗначениеЗаполнено(СтруктураБСО.Агент), "", " у Агента '" + СтруктураБСО.Агент + "'");				
				// ошибка, нет остатка
				СтрокаСообщения = sГде + " Нет необходимого количества (" + Строка(НадоКолБСО)+" шт.) " + s3 + "'" + Строка(ВидБСО) + "'" 
				+ " (поставщик: '" + актуалПоставщик + "', ОргАгент: '" + актуалОргАгент + "', СК: '" + актуалСК + "') "
				+ НаКом 
				+ ". Наличие: " + Строка(тзОстатки.Итог("Количество")) + " шт.";
				ОбщегоНазначения.ОшибкаПриПроведении(СтрокаСообщения, Отказ, Заголовок);
			КонецЕсли;
		//ИначеЕсли уб_СЛ.ОпределитьУчетНеВедется(ВидБСО,СтрокаТЧ.ТипУчетаБСО) Тогда
			//Ничего не делаем... пока.... 				
		КонецЕсли;		
	КонецЦикла;	
	//--------------------------------
	// Выполним движения для Количественных БСО и БСО у которых учет не велся, 
	// но только для тех, которые были оформлены и остались на точке	
	//--------------------------------	
	Попытка
		//чкн
		ТЗОшибок = Новый ТаблицаЗначений;
		ТЗОшибок.Колонки.Добавить("Ошибка");
		ТЗОшибок.Колонки.Добавить("Строка");
		ТЗОшибок.Колонки.Добавить("Элемент");
		ПроверкаУникальностиЗаписейРегистра(Движения.уб_ДвиженияБСО, Отказ, ТЗОшибок);
		Если ТЗОшибок.Количество() <> 0 Тогда
			//Форма = ЭтотОбъект.ПолучитьФорму();
			Форма = Ссылка.ПолучитьФорму();
			Если Форма.Открыта() Тогда
				ОткрытьСообщениеОбОшибках(ТзОшибок, Форма);
			Иначе
				Для Каждого Строка Из ТЗОшибок Цикл
					Сообщить(Строка.Ошибка);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Движения.уб_ДвиженияБСО.Записать();
		//чкн
	Исключение
		Отказ = Истина;
		СОО = ОписаниеОшибки();
		Сообщить(СОО);	
		Если Найти(СОО, "Запись с такими ключевыми полями существует!") > 0 Тогда
			ДатаДвиженияБСО = ДатаДвиженияБСО + 60; 
			Сообщить("Эта ошибка возникает, когда дата документа совпадает с датой другого документа, производящего движение БСО." + Символы.ВК + Символы.ПС + "Дата этого документа автоматически увеличена на 1 мин. Попробуйте еще раз.");
		КонецЕсли;
	КонецПопытки;	
	Движения.уб_ОстаткиБСО.Записать();		
	Если ОтключитьКонтрольНомераПолиса Тогда
		ДвижениеНомераПолиса("ТолькоПроверитьНомерИОчиститьДвижения", Отказ);
		Возврат ТаблицаБСО;
	КонецЕсли;		
	Если ПометкаУдаления Тогда
		ДвижениеНомераПолиса("ТолькоОчиститьДвижения", Отказ);
		Возврат ТаблицаБСО;
	КонецЕсли;	
	Если Проведен Тогда  //Отказ
		ДвижениеНомераПолиса("Оформить", Отказ);
	Иначе
		Если РезервироватьНомерПолиса Тогда
			ДвижениеНомераПолиса("Зарезервировать", Отказ);
		иначе
			ДвижениеНомераПолиса("ТолькоОчиститьДвижения", Отказ);
		КонецЕсли;
	КонецЕсли;	
	Возврат ТаблицаБСО;
	
КонецФункции

// Функция возвращает количество документов привязанных полису
Функция ПолучитьКоличествоФайловКПолису(ДокументПроверки = Неопределено) Экспорт
	
	Если ДокументПроверки = Неопределено Тогда
		ДокументПроверки = Ссылка;
	КонецЕсли;	
	//======================Список файлов======================
	ЗапросФайлы = Новый Запрос(
	"ВЫБРАТЬ
	|	ФОТО.КоличествоФОТО,
	|	БСОДОК.КоличествоБСОДОК,
	|	ДСП.КоличествоДСП
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.ФайлИмя) КАК КоличествоФОТО
	|	ИЗ
	|		РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|	ГДЕ
	|		уб_ФайлыКПолисам.ВидФайлаB2B = &ВидФайлаB2BФОТО
	|		И уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис) КАК ФОТО,
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.ФайлИмя) КАК КоличествоБСОДОК
	|	ИЗ
	|		РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|	ГДЕ
	|		(уб_ФайлыКПолисам.ВидФайлаB2B = &ВидФайлаB2BБСОДОК
	|				ИЛИ уб_ФайлыКПолисам.ВидФайлаB2B = &ВидФайлаB2BПРОЧЕЕ)
	|		И уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис) КАК БСОДОК,
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.ФайлИмя) КАК КоличествоДСП
	|	ИЗ
	|		РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|	ГДЕ
	|		уб_ФайлыКПолисам.ВидФайлаB2B = &ВидФайлаB2BДСП
	|		И уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис) КАК ДСП
	|ГДЕ
	|	(БСОДОК.КоличествоБСОДОК <> 0
	|			ИЛИ ФОТО.КоличествоФОТО <> 0
	|			ИЛИ ДСП.КоличествоДСП <> 0)");
	ЗапросФайлы.УстановитьПараметр("ВидФайлаB2BФОТО", 	Перечисления.уб_ВидыФайловB2B.ФОТО);
	ЗапросФайлы.УстановитьПараметр("ВидФайлаB2BБСОДОК", Перечисления.уб_ВидыФайловB2B.БСО_ДОК);
	ЗапросФайлы.УстановитьПараметр("ВидФайлаB2BДСП", 	Перечисления.уб_ВидыФайловB2B.ДСП);
	ЗапросФайлы.УстановитьПараметр("ВидФайлаB2BПРОЧЕЕ", Перечисления.уб_ВидыФайловB2B.ПРОЧЕЕ);
	ЗапросФайлы.УстановитьПараметр("СтраховойПолис", 	ДокументПроверки.Ссылка);	
	//чкн
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		ЗапросФайлы.Текст = ЗапросПолучитьКоличествоФайловКПолису();
	КонецЕсли;
	//чкн
	РезультатФайлы = ЗапросФайлы.Выполнить().Выгрузить();
	РезультатСтрока = "";
	Если РезультатФайлы.Количество() > 0 Тогда
		РезультатСтрока = Строка(РезультатФайлы[0].КоличествоФОТО) + "/" + Строка(РезультатФайлы[0].КоличествоБСОДОК) + "/" + Строка(РезультатФайлы[0].КоличествоДСП);
	КонецЕсли;
	Возврат РезультатСтрока;
	
КонецФункции

//чкн
Функция ЗапросПолучитьКоличествоФайловКПолису()
	Текст = "ВЫБРАТЬ
	        |	ФОТО.КоличествоФОТО,
	        |	БСОДОК.КоличествоБСОДОК,
	        |	ДСП.КоличествоДСП
	        |ИЗ
	        |	(ВЫБРАТЬ
	        |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлИмя) КАК КоличествоФОТО
	        |	ИЗ
	        |		Документ.уб_СтраховойПолис.СписокФайлов КАК уб_СтраховойПолисСписокФайлов
	        |	ГДЕ
	        |		уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ВидФайлаB2B = &ВидФайлаB2BФОТО
	        |		И уб_СтраховойПолисСписокФайлов.Ссылка = &СтраховойПолис) КАК ФОТО,
	        |	(ВЫБРАТЬ
	        |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлИмя) КАК КоличествоБСОДОК
	        |	ИЗ
	        |		Документ.уб_СтраховойПолис.СписокФайлов КАК уб_СтраховойПолисСписокФайлов
	        |	ГДЕ
	        |		(уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ВидФайлаB2B = &ВидФайлаB2BБСОДОК
	        |				ИЛИ уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ВидФайлаB2B = &ВидФайлаB2BПРОЧЕЕ)
	        |		И уб_СтраховойПолисСписокФайлов.Ссылка = &СтраховойПолис) КАК БСОДОК,
	        |	(ВЫБРАТЬ
	        |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлИмя) КАК КоличествоДСП
	        |	ИЗ
	        |		Документ.уб_СтраховойПолис.СписокФайлов КАК уб_СтраховойПолисСписокФайлов
	        |	ГДЕ
	        |		уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ВидФайлаB2B = &ВидФайлаB2BДСП
	        |		И уб_СтраховойПолисСписокФайлов.Ссылка = &СтраховойПолис) КАК ДСП
	        |ГДЕ
	        |	(БСОДОК.КоличествоБСОДОК <> 0
	        |			ИЛИ ФОТО.КоличествоФОТО <> 0
	        |			ИЛИ ДСП.КоличествоДСП <> 0)";
	
	Возврат Текст;
КонецФункции
//чкн
 
 // Функция возвращает флаг наличия ошибки в предоставденных документах
 Функция ПолучитьФлагОшибкиВПредоставленныхДокументах(ДокументПроверки = Неопределено) Экспорт
	 
	Если ДокументПроверки = Неопределено Тогда
		ДокументПроверки = Ссылка;
	КонецЕсли;	
	ЗапросДокументы = Новый Запрос(
	"ВЫБРАТЬ
	|	уб_ПредоставленныеДокументыСП.Объект,
	|	NULL КАК УИД,
	|	NULL КАК Приоритет,
	|	NULL КАК КритическаяДата,
	|	NULL КАК ОписаниеОшибки
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК уб_ПредоставленныеДокументыСП
	|ГДЕ
	|	уб_ПредоставленныеДокументыСП.Объект = &Объект
	|	И уб_ПредоставленныеДокументыСП.Используется
	|	И НЕ уб_ПредоставленныеДокументыСП.Предоставлен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	уб_ОшибкиСрезПоследних.Объект,
	|	уб_ОшибкиСрезПоследних.УИД,
	|	уб_ОшибкиСрезПоследних.Приоритет,
	|	уб_ОшибкиСрезПоследних.КритическаяДата,
	|	уб_ОшибкиСрезПоследних.ОписаниеОшибки
	|ИЗ
	|	РегистрСведений.уб_Ошибки.СрезПоследних КАК уб_ОшибкиСрезПоследних
	|ГДЕ
	|	уб_ОшибкиСрезПоследних.Объект = &Объект
	|	И уб_ОшибкиСрезПоследних.Статус.Родитель = &СтатусНеРешено");
	ЗапросДокументы.УстановитьПараметр("Объект", 			ДокументПроверки.Ссылка);
