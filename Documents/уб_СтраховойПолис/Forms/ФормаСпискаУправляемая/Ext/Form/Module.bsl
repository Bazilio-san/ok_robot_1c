&НаСервере
Процедура Фильтр()  Экспорт
	СтруктурыФильтра = Новый Массив;
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Агент",        эуПоискМенеджер,      Неопределено, НЕ эуПоискМенеджер.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Курьер",       эуПоискКурьер,        Неопределено, НЕ эуПоискКурьер.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Номер",        эуНомерПолиса,        ВидСравненияКомпоновкиДанных.Содержит, НЕ ПустаяСтрока(эуНомерПолиса)));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Заявка.Номер", _Число(эуПоискНомер), Неопределено, НЕ ПустаяСтрока(эуПоискНомер)));
	Если ТипЗнч(эуПоискНомерЗаявки) = Тип("Строка") Тогда 
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","НомерЗаявки",_Число(эуПоискНомерЗаявки),Неопределено, НЕ ПустаяСтрока(эуПоискНомерЗаявки)));
	Иначе
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","НомерЗаявки",эуПоискНомерЗаявки,Неопределено, ЗначениеЗаполнено(эуПоискНомерЗаявки)));
	КонецЕсли;	
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","СК",эуСК,Неопределено,НЕ эуСК.Пустая()));
	
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование,Представление","ДатаОкончания",эуПериодОкончания.ДатаНачала,ВидСравненияКомпоновкиДанных.БольшеИлиРавно, ЗначениеЗаполнено(эуПериодОкончания.ДатаНачала),"ДатаОкончанияОт"));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование,Представление","ДатаОкончания",эуПериодОкончания.ДатаОкончания,ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ЗначениеЗаполнено(эуПериодОкончания.ДатаОкончания),"ДатаОкончанияПо"));
	
	Если СтрДлина(эуПоискСтрахователь)>=3 Тогда
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  уб_ВызовСервера.СтрахователиПоНаименованию(эуПоискСтрахователь),
		                                                                                                            ВидСравненияКомпоновкиДанных.ВСписке, НЕ ПустаяСтрока(эуПоискСтрахователь)));
		//СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","СтраховательНаименование", эуПоискСтрахователь, ВидСравненияКомпоновкиДанных.Содержит,НЕ ПустаяСтрока(эуПоискСтрахователь)));
	Иначе
		//
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  эуПоискСтрахователь,ВидСравненияКомпоновкиДанных.ВСписке,ЛОЖЬ));
		//Отключаем
		//СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","СтраховательНаименование",  эуПоискСтрахователь,ВидСравненияКомпоновкиДанных.Содержит,ЛОЖЬ));
	КонецЕсли;	
	
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","ВидС",эуПоискВидСП,Неопределено,НЕ эуПоискВидСП.Пустая()));
	Если ЗначениеЗаполнено(эуПоискVIN) 
		или ЗначениеЗаполнено(эуМарка) 
		или ЗначениеЗаполнено(эумодель) 
		Тогда
		СписокОбъектов = СписокОбъектов();
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","ОбъектСтрахования",СписокОбъектов,ВидСравненияКомпоновкиДанных.ВСписке,Истина));
	Иначе
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","ОбъектСтрахования",Неопределено,Неопределено,ЛОЖЬ));
	КонецЕсли;	
	
	
	уб_ФормыВызовСервера.УстановитьОтборыСписка(ЭтаФорма.Список,СтруктурыФильтра);
КонецПроцедуры	

