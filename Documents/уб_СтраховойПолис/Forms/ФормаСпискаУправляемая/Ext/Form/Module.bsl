&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	ПРЕДСТАВЛЕНИЕ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.СК) КАК СК,
	               |	ПРЕДСТАВЛЕНИЕ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВидБСО) как ВидБСО
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка В(&Список)";
				   
	
	_Скидки = Неопределено;
	Ключи = Строки.ПолучитьКлючи();
	Запрос.УстановитьПараметр("Список",Ключи);		
	
	
	СтраховыеКомпании = Запрос.Выполнить().Выгрузить();	
	Ссылки = СтраховыеКомпании.Скопировать();
	Ссылки.Свернуть("Ссылка");
	Для каждого Ссылка из Ссылки Цикл
		СтрокаСписка = Строки[Ссылка.Ссылка];    
		
		Масс = СтраховыеКомпании.НайтиСтроки(Новый Структура("Ссылка",Ссылка.Ссылка));
		СтрокаСК = "";
		СтрокаВидыСП = "";
		Для каждого СтрокаБСО из Масс Цикл
			Если найти(СтрокаСК,СтрокаБСО.СК) = 0 Тогда
				СтрокаСК = СтрокаСК+""+?(СтрокаСК="","",", ")+СтрокаБСО.СК;
			КонецЕсли;	
			Если найти(СтрокаВидыСП,СтрокаБСО.ВидБСО) = 0 Тогда
				СтрокаВидыСП = СтрокаВидыСП+""+?(СтрокаВидыСП="","",", ")+СтрокаБСО.ВидБСО;
			КонецЕсли;	
		КонецЦикла;
		
		СтрокаСписка.Оформление["СК"].УстановитьЗначениеПараметра("Текст",  СтрокаСК);
		СтрокаСписка.Оформление["Город"].УстановитьЗначениеПараметра("Текст",  СтрокаВидыСП);
		//СтрокаСписка.Оформление["Наименование"].УстановитьЗначениеПараметра("ЦветТекста",  Новый Цвет(200,200,200));
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Параметры.РежимВыбора = Истина Тогда
		ОповеститьОВыборе(Элементы.Список.ТекущаяСтрока);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Поле.Имя = "ЗаявкаНомер" Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоказатьЗначение(,Заявка(Элементы.Список.ТекущаяСтрока));
	ИначеЕсли Поле.Имя = "РасчетЕсть" Тогда
		СтандартнаяОбработка = Ложь;
		URL = Элементы.Список.ТекущиеДанные.РасчетСсылка;
		Если Элементы.Список.ТекущиеДанные.РасчетЕсть = Истина  Тогда
			Попытка
				ПерейтиПоНавигационнойСсылке(URL);//"https://kupipolis.ru");
			Исключение
				ЗапуститьПриложение(URL);
			КонецПопытки;	
		ИначеЕсли Не ПустаяСтрока(URL)	 Тогда
			ПоказатьЗначение(,URL);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция Заявка(Ссылка)
	Возврат Ссылка.Заявка;
КонецФункции	

