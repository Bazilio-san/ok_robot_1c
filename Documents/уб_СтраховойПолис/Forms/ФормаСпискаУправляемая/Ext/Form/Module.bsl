&НаСервере
Функция СписокОбъектов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Разрешенные
	               |	уб_ТранспортныеСредства.Объект КАК Объект
	               |ИЗ
	               |	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
	               |ГДЕ
	               |	1 = 1
	               |	И 2 = 2
				   |	И 3 = 3";
	Если ЗначениеЗаполнено(эуМарка) Тогда
		Запрос.Текст = Стрзаменить(Запрос.Текст,"1 = 1","уб_ТранспортныеСредства.МаркаТС = &МаркаТС");
		Запрос.УстановитьПараметр("МаркаТС",эуМарка);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(эуМодель) Тогда
		Запрос.Текст = Стрзаменить(Запрос.Текст,"3 = 3","уб_ТранспортныеСредства.МодельТС = &МодельТС");
		Запрос.УстановитьПараметр("МодельТС",эуМодель);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(эуПоискVIN) Тогда
		Запрос.Текст = Стрзаменить(Запрос.Текст,"2 = 2","уб_ТранспортныеСредства.ИдентификационныйНомер Подобно &ИдентификационныйНомер");
		Запрос.УстановитьПараметр("ИдентификационныйНомер","%"+СокрЛП(эуПоискVIN)+"%");
	КонецЕсли;	

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Объект");	
		
	
КонецФункции	

