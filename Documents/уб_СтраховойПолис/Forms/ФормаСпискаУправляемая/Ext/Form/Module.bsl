&НаСервере
Процедура ОбновитьСпискиВыбора()
	
	Запрос  = Новый Запрос;
	РасчетныйПериод = НачалоМесяца(ТекущаяДата())-1;
	Запрос.УстановитьПараметр("ДатаНач",ТекущаяДата()-365*24*3600);					   
	Запрос.УстановитьПараметр("ДатаКон",КонецМесяца(ТекущаяДата()));					   
	
	ЭтоПолныеПрава = Ложь;
	Если уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") 
		или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.КураторВыездных, Ложь) 
		или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПросмотрВсехПолисовИЗаявок, Ложь) 
		Тогда
		ЭтоПолныеПрава = Истина;
	Иначе	
		ПараметрыПодчиненных = уб_СС.СтруктураПараметровФункцииПодчиненныеРуководителяПоУмолчанию();
		// Разрешенные.ВключаяВыбывших = Истина;
		ПодчиненныеРуководителя = уб_СС.ПодчиненныеРуководителя(,РасчетныйПериод,  ПараметрыПодчиненных);
	КонецЕсли;	
			
	Если ПодчиненныеРуководителя = Неопределено или СокрЛП(ПараметрыПодчиненных.ПодразделениеСотрудника) = "СВС" Тогда
		ПодчиненныеРуководителя = Неопределено;//ДЛя СВС
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ  Разрешенные
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Агент КАК Менеджер
		|ИЗ
		|	Документ.уб_СтраховойПолис КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		|ГДЕ
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= &ДатаНач
		|	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата <= &ДатаКон
		|	И (НЕ уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПометкаУдаления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Агент.Наименование";
		СписокМенеджеров = Новый СписокЗначений;
		СписокМенеджеров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Менеджер");
	Иначе
		СписокМенеджеров = ПодчиненныеРуководителя.ВыгрузитьЗначения(); 
		//Если ЭтоПолныеПрава = Ложь Тогда
		//	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//	|	уб_СтраховойПолис.Ссылка КАК Ссылка
		//	|ИЗ
		//	|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		//	|ГДЕ
		//	|	(уб_СтраховойПолис.Агент В (&Менеджер)
		//	|    или уб_СтраховойПолис.Агент.Преемник  В(&Менеджер)
		//	|			ИЛИ уб_СтраховойПолис.Курьер В (&Менеджер))";
		//	Запрос.УстановитьПараметр("Менеджер",СписокМенеджеров);
