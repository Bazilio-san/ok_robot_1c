#КонецОбласти

#Область ВспомогательныеФункции
&НаСервере
Процедура УстановитьДоступность()
	ТолькоПросмотр = Истина;
	Элементы.СрокДней.ТолькоПросмотр = Истина;
	Элементы.ВыбСрок.ТолькоПросмотр = Истина;
КонецПроцедуры	

&НаСервере
Процедура ИнициализироватьСписки()
	СписокСроков = Элементы.выбСрок.СписокВыбора;
	СписокСроков.Очистить();
	СписокСроков.Добавить(1,	"1 мес.");
	СписокСроков.Добавить(3, 	"3 мес.");
	СписокСроков.Добавить(6, 	"6 мес.");
	СписокСроков.Добавить(12, 	"1 год");
	СписокСроков.Добавить(24, 	"2 года");
	СписокСроков.Добавить(36, 	"3 года");
	
	Оплаты.Параметры.УстановитьЗначениеПараметра("СтраховойПолис",Объект.Ссылка);
КонецПроцедуры
	

