Функция ОпределитьВыбСрок()
	
	выбСрок = 0;
	Для Каждого ЭлементСЗ из Элементы.выбСрок.СписокВыбора Цикл
		фСрок = ЭлементСЗ.Значение;
		Если Объект.ДатаОкончания = ДобавитьМесяц(Объект.ДатаНачала, фСрок) - 86400 Тогда//60*60*24
			выбСрок = фСрок;
			Прервать
		КонецЕсли;
	КонецЦикла;
	
	Возврат выбСрок
	
КонецФункции

Функция ОпределитьСрокДней()
	
	Если Объект.ДатаОкончания <> Дата(1, 1, 1) и Объект.ДатаНачала <> Дата(1, 1, 1) И Объект.ДатаОкончания > Объект.ДатаНачала Тогда
		СрокДней = (Объект.ДатаОкончания - Объект.ДатаНачала) / 86400;
	Иначе
		СрокДней = 0;
	КонецЕсли;
	Возврат СрокДней;
КонецФункции

Процедура НайтиЗаменыПолисов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис КАК АннулированныйПолис,
	               |	уб_ЗаменаПолисовСрезПоследних.НовыйПолис КАК НовыйПолис
	               |ИЗ
	               |	РегистрСведений.уб_ЗаменаПолисов.СрезПоследних КАК уб_ЗаменаПолисовСрезПоследних
	               |ГДЕ
	               |	уб_ЗаменаПолисовСрезПоследних.АннулированныйПолис = &ЭтотПолис
	               |	ИЛИ уб_ЗаменаПолисовСрезПоследних.НовыйПолис = &ЭтотПолис";
	Запрос.УстановитьПараметр("ЭтотПолис",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.АннулированныйПолис = Объект.Ссылка Тогда
			ВыданВзамен    = Выборка.НовыйПолис;
		Иначе
			НачальныйПолис = Выборка.АннулированныйПолис;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

