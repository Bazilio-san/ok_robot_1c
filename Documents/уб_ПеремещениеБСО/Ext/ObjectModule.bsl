Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначение(Направление, ВернутьНаправление());
	мРежимЗаписи = РежимЗаписи;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	Если ДополнительныеСвойства.Свойство("ОбновитьПоставщикаИОргАгента") 
		И ДополнительныеСвойства.ОбновитьПоставщикаИОргАгента  = ИСТИНА Тогда
		ОбновитьДанныеПоПоставщикуОргАгенту();
	КонецЕсли;	
	Если Не Отказ Тогда 
		СинхронизацияБСОСЗаявкой();
	КонецЕсли;	
КонецПроцедуры

Процедура ОбновитьДанныеПоПоставщикуОргАгенту() Экспорт
//Обновление данных по поставщику в строке: неэффективно перед каждой записью это делать, как вариант вынести в контекст в нутри документа
	Для Каждого СтрокаТЧ Из БСО Цикл
		ЗаписьРег = Неопределено;
		//ИнфоЗапись = НЕ (СтрокаТЧ.Подтверждено И РежимЗаписи = РежимЗаписиДокумента.Проведение);
		Если "" <> СокрЛП(СтрокаТЧ.НомерБСО) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ //ПЕРВЫЕ 1
			|	*
			|ИЗ
			|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
			|			&Период,
			|			ВидБСО = &ВидБСО
			|				И НомерБСО = &НомерБСО
			//|				И СК = &СК
			|				И Подтверждено) КАК уб_ДвиженияБСОСрезПоследних
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";
			Запрос.УстановитьПараметр("ВидБСО", СтрокаТЧ.ВидБСО);
			Запрос.УстановитьПараметр("НомерБСО", СтрокаТЧ.НомерБСО);
			Запрос.УстановитьПараметр("СК", СтрокаТЧ.СК);
			Запрос.УстановитьПараметр("Период", МоментВремени());
			
			//Если НЕ ИнфоЗапись Тогда
			//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Подтверждено");
			//КонецЕсли;
			
			тзРег = Запрос.Выполнить().Выгрузить();
			
			ВсегоСтрок = тзРег.Количество();
			Если  ВсегоСтрок > 0 Тогда
				ЗаписьРег = тзРег[0];
				//Если ВсегоСтрок > 1 Тогда
				//	тзРег.СОртировать("Период УБЫВ"); //если предыдущий не страховой полис, то "самое последнее наиболее верное"
				//	ЗаписьРег = тзРег[0];
				//КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		ЕстьИнфоОБСО = ЗаписьРег <> Неопределено;
		Если ЕстьИнфоОБСО Тогда
			хПоставщик			= ЗаписьРег.Поставщик;
			хОрганизацияАгент	= ЗаписьРег.ОрганизацияАгент;
		Иначе
			//Случай записи перемещения не внесенных в систему БСО, либо с ошибочными данными
			хПоставщик = ?(ЗначениеНеЗаполнено(СтрокаТЧ.Поставщик), СтрокаТЧ.СК, СтрокаТЧ.Поставщик);
			#Если Клиент Тогда
				хОрганизацияАгент 	= ?(ЗначениеНеЗаполнено(СтрокаТЧ.ОрганизацияАгент), ОсновнаяОрганизация, СтрокаТЧ.ОрганизацияАгент);
			#Иначе	
				хОрганизацияАгент = СтрокаТЧ.ОрганизацияАгент;
			#КонецЕсли	
		КонецЕсли;
		Если СтрокаТЧ.Поставщик <> хПоставщик Тогда
			СтрокаТЧ.Поставщик = хПоставщик;
		КонецЕсли;
		Если СтрокаТЧ.ОрганизацияАгент <> хОрганизацияАгент Тогда
			СтрокаТЧ.ОрганизацияАгент = хОрганизацияАгент;
		КонецЕсли;
		#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
		#КонецЕсли	
	КонецЦикла;	
КонецПроцедуры	

Функция ВернутьНаправление() Экспорт
	
	ПодразделениеОт = уб_СС.ПолучитьПодразделениеАгента(Агент, Дата, Истина);
	ПодразделениеКуда = уб_СС.ПолучитьПодразделениеАгента(АгентКуда, Дата, Истина);	
	ТипОт   = ПодразделениеОт.ТипПодразделения;
	ТипКуда = ПодразделениеКуда.ТипПодразделения;
	
	ТП = Новый Массив;
	ТП.Добавить(Перечисления.уб_ТипПодразделения.ТочкаПродаж);
	ТП.Добавить(Перечисления.уб_ТипПодразделения.СлужбаВС);
	ТП.Добавить(Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя);
	
	ОУБСО = Перечисления.уб_ТипПодразделения.ГоловнойОфис;
	_Направление = 0;
	// Вычисляем новое положение БСО	
	Если ТП.Найти(ТипКуда)<>Неопределено и ТипОт = ОУБСО Тогда
		_Направление = 1;
	ИначеЕсли ПодразделениеОт = ПодразделениеКуда Тогда
		_Направление = 0;
	ИначеЕсли ТипКуда = ОУБСО и ТипОт  = ОУБСО Тогда
		_Направление = 0;
	ИначеЕсли ТП.Найти(ТипКуда)<>Неопределено и ТП.Найти(ТипОт)<>Неопределено Тогда
		_Направление = 0;	
	ИначеЕсли ТипКуда = ОУБСО Тогда
		_Направление = -1;
	ИначеЕсли ТП.Найти(ТипКуда)<>Неопределено Тогда
		_Направление = 1;
	Иначе
		_Направление = 0;
	КонецЕсли;
	Возврат _Направление;
	
КонецФункции	

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	#Если Клиент Тогда
		Если ПараметрыСеанса.уб_Константы.ОчищатьСообщенияПриЗаписиДокументов = Истина Тогда
			ОчиститьСообщения();
		КонецЕсли;
	#КонецЕсли
	Заголовок = "Запись документа """ + СокрЛП(Ссылка) + """: ";
	Если Не Проведен Тогда
		ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок);
	КонецЕсли;	
	Если Не Отказ И Не Проведен Тогда
		ДвиженияПоРегистрам(Отказ, Заголовок);
	КонецЕсли;	
	Если Отказ и мРежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ = Ложь;
		//Возврат;
	КонецЕсли;		
	// Вариант, если не хотим, что бы в регистре были помеченные на удаление
	//Если Не Отказ И Не Проведен И НЕ Ссылка.ПометкаУдаления Тогда
	//	ДвиженияПоРегистрам(Отказ, Заголовок);
	//ИначеЕсли Не Проведен И Ссылка.ПометкаУдаления Тогда	
	//	Движения.уб_ДвиженияБСО.Очистить();
	//	Движения.уб_ДвиженияБСО.Записать();
	//КонецЕсли;	
	//Проверка статуса
	//необходимость возврата теперь проходит в модуле менеджера ДвижениеСтатусовЗаявок
	//Если Не Направление = 0 Тогда
	//	уб_УСЗ.ПроверитьНеобходимостьВозвратаПоСвязаннымЗаявкам(Ссылка);
	//КонецЕсли;
	Если Не Отказ И Не Проведен Тогда 
		Документы.уб_ПеремещениеБСО.ДвижениеСтатусовЗаявок(Ссылка)
	КонецЕсли;
	
		
	
КонецПроцедуры

Процедура СинхронизацияБСОСЗаявкой()
	
	//
	Возврат;
	
	Если ЗначениеЗаполнено(СозданНаОсновании) и ТипЗнч(СозданНаОсновании) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
	Иначе
		Возврат;
	КонецЕсли;	
	ОбЗаявки = СозданНаОсновании.ПолучитьОбъект();
	БСОЗаявки = ОбЗаявки.БСО;
	ФлЕстьПравки = Ложь;
	Для каждого СтрокаБСО из БСо Цикл
		Если СтрокаБСО.Подтверждено = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		Если Не ПустаяСтрока(СтрокаБСо.НомерБСО) Тогда
			
			нСтроки = БСОЗаявки.НайтиСтроки(Новый Структура("ВидБСО",СтрокаБСО.ВидБСО));
			
			Найдено = Ложь;;
			
			Для каждого СтрокаВЗаявке из нСтроки Цикл
				
				Если СтрокаБСо.НомерБСО = СтрокаВЗаявке.НомерБСО Тогда
					Найдено = Истина;
					Прервать;
				ИначеЕсли Прав(СтрокаБСо.НомерБСО,8) = Прав(СтрокаВЗаявке.НомерБСО,8) Тогда
					СтрокаБСО.НомерБСО = СтрокаВЗаявке.НомерБСО;
				КонецЕсли;
				
			КонецЦикла;	
			
			Если Найдено = Ложь Тогда
				Для каждого СтрокаВЗаявке из нСтроки Цикл
					Если ПустаяСтрока(СтрокаВЗаявке.НомерБСО) Тогда
						СтрокаВЗаявке.НомерБСО = СтрокаБСо.НомерБСО;
						СтрокаВЗаявке.ДатаДвиженияБСО = Дата-1;
						Если СтрокаВЗаявке.Состояние   = Перечисления.уб_СостояниеОформления.ПолисЗаведен
							//и (СтрокаБСо.ВидБСО.Тип = Перечисления.уб_ТипыБСО.Полис
							//или СтрокаБСо.ВидБСО.Тип = Перечисления.уб_ТипыБСО.ПолисОСАГО)
							Тогда
							СтрокаВЗаявке.Состояние = Перечисления.уб_СостояниеОформления.ВыпускМаски;
						КонецЕсли;	
						ФлЕстьПравки = Истина;
						Найдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Найдено = Ложь //и НЕ СтрокаБСо.ВидБСО.Тип = Перечисления.уб_ТипыБСО.КвитанцияА7 
				Тогда
				Сообщить("Не найдена строка для номера "+ СтрокаБСо.НомерБСО+" в заявке");
			КонецЕсли;	
			
			
		КонецЕсли;	
		
	КонецЦикла;	
	Если ФлЕстьПравки Тогда
		ОбЗаявки.Записать(?(ОбЗаявки.Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ОбработкаЗаполнения(Основание, СтандартнаяОбработка)
	
	ТипЗнч = ТипЗнч(Основание);
	Если ТипЗнч  = Тип("Структура") И Основание.Свойство("Документ") Тогда
		ЗаполнятьШапку = Неопределено;
		Основание.Свойство("ЗаполнятьШапку", ЗаполнятьШапку);
		Если ЗаполнятьШапку = Неопределено Тогда
			ЗаполнятьШапку = Истина;
		КонецЕсли;	
		ПроверятьНаличиеБСО = Неопределено;
		Основание.Свойство("ПроверятьНаличиеБСО", ПроверятьНаличиеБСО);
		Если ПроверятьНаличиеБСО = Неопределено Тогда
			ПроверятьНаличиеБСО = Истина;
		КонецЕсли;	
		Документ = Основание.Документ;
		Если типЗнч(Документ) = Тип("Массив") Тогда
			ВсегоДокументов = Документ.Количество();
			Для СчетчикДокументов = 0 по ВсегоДокументов - 1  Цикл
				СоздатьНаОсновании(Документ[СчетчикДокументов], ТипЗнч, Основание.Проверять, ?(СчетчикДокументов=ВсегоДокументов-1,ЗаполнятьШапку,Ложь), ПроверятьНаличиеБСО);
			КонецЦикла;	
		Иначе	
			СоздатьНаОсновании(Документ, ТипЗнч, Основание.Проверять, ЗаполнятьШапку, ПроверятьНаличиеБСО);
		КонецЕсли;	
	Иначе
		СоздатьНаОсновании(Основание,ТипЗнч)
	Конецесли;	
	
КонецПроцедуры

Процедура СоздатьНаОсновании(Основание, ТипЗнч, Проверять = Истина, ЗаполнятьШапку = Истина, ПроверятьНаличиеБСО = Ложь)
	
 	Если ТипЗнч(Основание) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
		//проверка на модифицированность формы заявки на ВС
		#Если Клиент Тогда
			Если Основание.ПолучитьФорму().Модифицированность Тогда
				Ответ = Вопрос("Заявка на заказ выездного специалиста была изменена! Записать документ и открыть перемещение БСО?", РежимДиалогаВопрос.ДаНет);
				Если Ответ = КодВозвратаДиалога.Да Тогда
					Основание.ПолучитьФорму().Записать()
				Иначе
					ЗакрытьФорму = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		#КонецЕсли
	    Если Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТребуетсяПроверка(Основание) Тогда
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Заявка не проверена руководителем/андеррайтером! Невозможно создать перемещение.", "Предупреждение");
			ЗакрытьФорму = Истина;
			Возврат;
		КонецЕсли;
		// Заполнение шапки
		Если ЗаполнятьШапку Тогда 
			СозданНаОсновании = Основание;
			Дата = ТекущаяДата();
			Если Проверять Тогда
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	уб_ПеремещениеБСО.Ссылка,
				|	уб_ПеремещениеБСО.Проведен,
				|	уб_ПеремещениеБСО.Номер,уб_ПеремещениеБСО.Дата
				|ИЗ
				|	Документ.уб_ПеремещениеБСО КАК уб_ПеремещениеБСО
				|ГДЕ
				|	уб_ПеремещениеБСО.СозданНаОсновании = &СозданНаОсновании");
				Запрос.УстановитьПараметр("СозданНаОсновании",СозданНаОсновании);
				Выборка = Запрос.Выполнить().Выбрать();
				Список = Новый СписокЗначений;
				Пока Выборка.Следующий() Цикл
					Список.Добавить(Выборка.Ссылка,"Открыть ""Перемещение БСО № "+Выборка.Номер+" от "+Формат(Выборка.Дата,"ДФ=dd.MM.yyyy")+?(Выборка.Проведен," (Проведен)"," (Не проведен)")+"""");
				КонецЦикла;	
				Если Список.Количество() > 0 Тогда
					//В 8.1 не отказа.
					//Ответ = Вопрос("Уже есть перемещения на основании данной заявки!!!"+Символы.ПС+"Все равно создать документ?",РежимДиалогаВопрос.ДаНет);
					#Если Клиент Тогда
						Ответ = Вопрос("Уже есть перемещения на основании данной заявки !"+Символы.ПС+Символы.ПС+"Показать структуру подчиненности?",РежимДиалогаВопрос.ДаНет);
						Если Ответ = КодВозвратаДиалога.Да Тогда
							РаботаСДиалогами.ПоказатьСтруктуруПодчиненностиДокумента(Основание.Ссылка);
							ЗакрытьФорму = Истина;
							Возврат;
						Конецесли;	
					#Конецесли
				КонецЕсли;
			КонецЕсли;
			Если Основание.Самовыезд Тогда
				АгентКуда = Основание.Менеджер;
			Иначе	
				АгентКуда = Основание.Курьер;
			КонецЕсли;	
			Агент = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
			Выдал = ПараметрыСеанса.уб_ТекущееФизЛицо;
		КонецЕсли;		
		ОснованиеЗаявка = ТипЗнч(СозданНаОсновании) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста");
		Если НЕ ОснованиеЗаявка И ТипЗнч(СозданНаОсновании)= Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
			Если НЕ ВернутьНаправление() = -1 Тогда
