				ОснованиеЗаявка = ТипЗнч(ЗаявкаКПодстановке) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста")
			КонецЕсли;
		Иначе
			ЗаявкаКПодстановке = СозданНаОсновании;
		КонецЕсли;	
		//Заполнение таблицы БСО
		
		//ППС 25-07-2014
