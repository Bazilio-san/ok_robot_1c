		ЗаполнятьНомерКвитанции = Не ПустаяСтрока(НомерКвитанции_ЗаявкаНаПечать);
		//ППС 25-07-2014
		
		Для Каждого ТекСтрокаБСО Из Основание.БСО Цикл
			//Если ПроверятьНаличиеБСО И БСО.НайтиСтроки(Новый Структура("СК,ВидБСО",ТекСтрокаБСО.СК,ТекСтрокаБСО.ВидБСО)).Количество()>0 Тогда
			//	Продолжить;
			//Конецесли;
			ВидБСО = ТекСтрокаБСО.ВидБСО;
			СК     = ТекСтрокаБСО.СК;		
			Если ЗначениеЗаполнено(ВидБСО) = Ложь Тогда
				Продолжить;
			КонецЕсли;	
			ЭтоСтраховойПродукт = ТипЗнч(ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов");
			//Тип("СправочникСсылка.уб_СтраховыеПродукты");
			Если ЭтоСтраховойПродукт Тогда
				МассивБСО = Новый Массив;
				МассивБСО.Добавить(ВидБСО);
				//Квитанции не добавляем автоматически
				
				//Запрос = Новый Запрос(
				//"ВЫБРАТЬ
				//|	уб_СтраховыеПродуктыВидыБСО.Ссылка,
				//|	уб_СтраховыеПродуктыВидыБСО.НомерСтроки,
				//|	уб_СтраховыеПродуктыВидыБСО.ВидБСО,
				//|	уб_СтраховыеПродуктыВидыБСО.Обязательно,
				//|	уб_СтраховыеПродуктыВидыБСО.НазначениеБСО,
				//|	ВЫБОР
				//|		КОГДА уб_СтраховыеПродуктыВидыБСО.ВидБСО.Тип В (ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис), ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОсаго))
				//|			ТОГДА ИСТИНА
				//|		ИНАЧЕ ЛОЖЬ
				//|	КОНЕЦ КАК ЭтоПолис
				//|ИЗ
				//|	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК уб_СтраховыеПродуктыВидыБСО
