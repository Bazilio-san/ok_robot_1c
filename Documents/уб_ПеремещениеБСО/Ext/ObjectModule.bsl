				Отказ = Проведен; 
				Сообщить("Для БСО количественного учета необходимо указать Поставщика и Организацию-Агента. Номер строки: " + СтрокаТЧ.НомерСтроки + ", СК: " + Строка(СтрокаТЧ.СК) + ", Вид БСО: " + Строка(СтрокаТЧ.ВидБСО) + ".");	
			КонецЕсли;
		ИначеЕсли уб_СЛ.ОпределитьВедетсяНомернойУчет(СтрокаТЧ.ВидБСО) Тогда
			//пока нет проверок	
		Иначе
			//пока нет проверок	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры


