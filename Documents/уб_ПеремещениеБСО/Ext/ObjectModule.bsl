		СтруктураЗаявок.Свойство("НомерПолиса_ЗаявкаНаПечать",     НомерПолиса_ЗаявкаНаПечать);	
		СтруктураЗаявок.Свойство("ВидБСОКвитанции_ЗаявкаНаПечать", ВидБСОКвитанции_ЗаявкаНаПечать);
		СтруктураЗаявок.Свойство("НомерКвитанции_ЗаявкаНаПечать",  НомерКвитанции_ЗаявкаНаПечать);
		
