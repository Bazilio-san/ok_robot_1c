Процедура ПолучитьПодписиДляСтороны(оАгент,НаДату,ППФИО,ППДляШапки,ППДляПодписи) Экспорт 
	#Если ВебКлиент Тогда
		
	#Иначе	
	
	//TODO оптимизировать!!!
	//Если подразделение - головной офис, то печатаем - от ООО ... в лице агента/сотрудника
	//	Иначе Если Агент - сотрудник, то "Субагент ООО КупиПолис ФИО"
	//	А Если Агент - Контрагент, то "Субагент ФИО "		
	Если Не ЗначениеЗаполнено(оАгент) Тогда
		ППФИО 			= "";
		ППДляШапки 		= "Субагент " + ППФИО;
		ППДляПодписи 	= "Субагент:";
		Возврат;	
	КонецЕсли;	
	Если ТипЗнч(оАгент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если оАгент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			// Контрагент - ЮрЛицо
			ППОрганизация = оАгент.НаименованиеПолное;
			Если Не ЗначениеЗаполнено(оАгент.ОсновноеКонтактноеЛицо) Тогда
				ППФИО = "";
				ППДляШапки = ППОрганизация;
			Иначе	
				ППФИО = оАгент.ОсновноеКонтактноеЛицо.Наименование;
				ППДляШапки = ППОрганизация + (?(ППОрганизация = "","",", ")) + ППФИО;
			КонецЕсли;
			ППДляПодписи = ППОрганизация + (?(ППОрганизация = "","",": "));
		Иначе
			//Контрагент - Физлицо
			ППФИО = оАгент.Наименование;
			ППДляШапки = "Субагент " + ППФИО;
			ППДляПодписи = "Субагент: ";
		КонецЕсли;
	ИначеЕсли ТипЗнч(оАгент) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ППФИО = уб_СС.ПрочитатьФИОФизЛица(оАгент);
		оПодразделение = уб_СС.ПолучитьПодразделениеАгента(оАгент, НаДату, Истина);
		Если оПодразделение = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО Тогда
			ППОрганизация 	= оПодразделение.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов;
			ППДляШапки 		= ППОрганизация + (?(ППОрганизация = "", "", ", "))+ ППФИО;
			ППДляПодписи 	= ППОрганизация + (?(ППОрганизация = "", "", ": "));
		Иначе
			ППДляШапки = "Субагент " + ППФИО;
			ППДляПодписи = "Субагент: ";
		КонецЕсли;
	ИначеЕсли ТипЗнч(оАгент) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		оПодразделение = оАгент;
		ППОрганизация = оПодразделение.Владелец.НаименованиеДляДоговоровИПлатежныхДокументов;
		ПППодразделение = оПодразделение.Наименование;
		ППДляШапки = ППОрганизация + ", подразделение """ + ПППодразделение + """";
		ППДляПодписи = "От " + ПППодразделение + " " + ППОрганизация;
		Если оПодразделение = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО Тогда
			ППФИО = уб_СС.ПрочитатьФИОФизЛица(оПодразделение.МОЛпоБСО);
		Иначе
			ППФИО = "/___________________________/";
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

