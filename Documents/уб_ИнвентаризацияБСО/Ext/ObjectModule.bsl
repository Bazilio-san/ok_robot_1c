Процедура ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок)

	СтруктураОбязательныхПолей = Новый Структура("ВидБСО");
	ОбщегоНазначения.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "БСО", СтруктураОбязательныхПолей, Отказ, Заголовок);

КонецПроцедуры

Процедура ДвиженияПоРегистрам(Отказ, Заголовок)
	ДвижениеПоРегиструДвижениеБСО(Отказ, Заголовок);
	ДвижениеПоРегиструОстаткиБСО(Отказ, Заголовок);	
КонецПроцедуры

Процедура ДвижениеПоРегиструОстаткиБСО(Отказ, Заголовок)	
	Движения.уб_ОстаткиБСО.Очистить();
	Для Каждого СтрокаТЧ Из КоличественныеБСО Цикл
		Если СтрокаТЧ.Отклонение <> 0 И СтрокаТЧ.Подтверждено Тогда
			Движение = Движения.уб_ОстаткиБСО.Добавить();
			Движение.Активность = Проведен;
			Движение.Агент = Агент;
			Движение.ВидБСО = СтрокаТЧ.ВидБСО;
			Движение.Заявка = СтрокаТЧ.Заявка;
			Движение.КодОперации = Перечисления.уб_КодыОперацийБСО.ИнвентаризацияБСО;
			
			Движение.ОрганизацияАгент = СтрокаТЧ.ОрганизацияАгент;
			Движение.Период = Дата;
			Движение.Поставщик = СтрокаТЧ.Поставщик;
			Движение.СК = СтрокаТЧ.СК;
			Движение.СостояниеБСО = СтрокаТЧ.СостояниеБСО;
			Если СтрокаТЧ.Отклонение > 0 Тогда
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.Количество = СтрокаТЧ.Отклонение;
			Иначе
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Количество = -СтрокаТЧ.Отклонение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Движения.уб_ОстаткиБСО.Записать();
КонецПроцедуры	


