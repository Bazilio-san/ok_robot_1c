			//Отключаем оповещение при записи, оповещение будет при проведении //TODO может быть поменять?
			оСП._НеОповещатьОЗаписи_ = Истина;
		КонецЕсли;
	КонецЕсли;
	УдалитьВременныеДанныеПолисаКПриемкеОплат(Структ.УИДСтроки);
	Если _Интерактивно Тогда
		Если Не ЗначениеЗаполнено(Структ.ОплатаПолисаДляОтчетаАгента) Тогда
			ОплатаПолисаДляОтчетаАгента = Документы.уб_ПриемкаОплат.ПолучитьОплатуПолисаДляОтчетаАгента(Структ.УИДСтроки, Структ.НомерКвитанции);
		Иначе
			ОплатаПолисаДляОтчетаАгента = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОплатаПолисаДляОтчетаАгента)	И сО <> ОплатаПолисаДляОтчетаАгента Тогда
			ФрмОП = ОплатаПолисаДляОтчетаАгента.ПолучитьФорму(,Фрм_СП.ЭлементыФормы.ОплатыСписок);
			ФрмОП.Открыть();
		ИначеЕсли ТребуетсяАктивизировать и Фрм_СП.Открыта() Тогда
			//Активизируем страховой полис
			Фрм_СП.Активизировать()
		КонецЕсли;
	КонецЕсли;
	Структ.ОплатаПолисаДляОтчетаАгента = ОплатаПолисаДляОтчетаАгента;
	
КонецПроцедуры

Функция НайтиУидПоДопу(СтрокаДопУИД)
	Для Каждого СтрокаПолиса Из Полисы Цикл
		Если СтрокаПолиса.УИДСтрокиЗаявки = СтрокаДопУИД Тогда
			Возврат СтрокаПолиса.УИДСтроки
		КонецЕсли;	
	КонецЦикла;
	Возврат  "";
КонецФункции

