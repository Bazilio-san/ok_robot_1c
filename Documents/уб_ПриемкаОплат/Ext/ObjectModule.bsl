Функция ПроверитьЗаполнениеСтрокиТЧ(СтрокаТЧ, Префикс = "", Суффикс = "", Заголовок = Неопределено, Молча = Ложь) Экспорт 
	
	Если СтрокаТЧ.СК.Пустая() Тогда
		Если Не Молча Тогда
			#Если Клиент Тогда
				Предупреждение(Префикс + "Не заполнено поле ""СК""!" + Суффикс, 5, Заголовок);
			#КонецЕсли
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли; 
	Если СтрокаТЧ.ВидБСО.Пустая() и СтрокаТЧ.СК<>Справочники.Контрагенты.ПустаяСК Тогда
		Если Не Молча Тогда
			#Если Клиент Тогда
				Предупреждение(Префикс + "Не заполнено поле ""ВидБСО""!" + Суффикс, 5, Заголовок);
			#КонецЕсли
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли; 
	Если ПустаяСтрока(СтрокаТЧ.НомерБСО) Тогда
		Если Не Молча Тогда
			//#Если Клиент Тогда
				Сообщить(Префикс + "Необходимо указать или номер БСО" + Символы.ВК + Символы.ПС 
				+ " (любая оплата или квитанция относится к какому-либо полису!)!" + Суффикс,);
			//#КонецЕсли
		КонецЕсли;
		Возврат Истина; //Будем пропускать при проведении
	КонецЕсли;
	Если уб_СЛ.ОпределитьВедетсяКоличественныйУчет(СтрокаТЧ.ВидБСО) И (Не ПустаяСтрока(СтрокаТЧ.НомерБСО) Или Не ПустаяСтрока(СтрокаТЧ.НомерКвитанции))  Тогда
		Если СтрокаТЧ.Поставщик.Пустая() Тогда
			Если Не Молча Тогда
				#Если Клиент Тогда
					Предупреждение(Префикс + "Не заполнено поле ""Поставщик"" для БСО количественного учета" + Суффикс, 5,Заголовок);
				#КонецЕсли
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
		Если СтрокаТЧ.ОрганизацияАгент.Пустая() Тогда
			Если Не Молча Тогда
				#Если Клиент Тогда
					Предупреждение(Префикс + "Не заполнено поле ""Организация-Агент"" для БСО количественного учета" + Суффикс, 5,Заголовок);
				#КонецЕсли
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Процедура ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок)
	
	Для Каждого СтрокаТЧ Из Полисы Цикл
		Префикс = "В строке номер """ + СокрЛП(СтрокаТЧ.НомерСтроки) + """: ";
		Отказ = Не ПроверитьЗаполнениеСтрокиТЧ(СтрокаТЧ, Префикс, ,Заголовок);
		Если Отказ Тогда
			Возврат;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	МассивОтчетов = Новый Массив;
	Структура = Новый Структура;
	Структура.Вставить("ПредСумма",						0);
	Структура.Вставить("ПредПроведен",					Ложь);
	Структура.Вставить("ПредИтогСуммаПлатежи",			0);
	Структура.Вставить("ПредОтчетКассира",				Документы.уб_ОтчетКассира.ПустаяСсылка());
	Структура.Вставить("ПредОтчетКассираПодтверждено",	Ложь);
	Структура.Вставить("Сумма", 						Сумма);
	
	Структура.Вставить("ИтогСуммаПлатежи",  			ИтогСуммаПлатежи);
	Структура.Вставить("ОтчетКассира",					ОтчетКассира);
	Структура.Вставить("ОтчетКассираПодтверждено",		Ложь);
	Структура.Вставить("ОтчетКассираПроведен",		Ложь);
	Структура.Вставить("СегодняВыходной",		Ложь);



	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Сумма КАК ПредСумма,
	|	П.Проведен КАК ПредПроведен,
	|	П.ИтогСуммаПлатежи КАК ПредИтогСуммаПлатежи,
	|	П.ОтчетКассира КАК ПредОтчетКассира,
	|	П.ОтчетКассира.Подтверждено КАК ПредОтчетКассираПодтверждено,
	|	ВЫБОР
	|		КОГДА РегламентированныйПроизводственныйКалендарь.Пятидневка = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СегодняВыходной,
	|	IsNull(ОК.Ссылка.Проведен,ЛОЖЬ) как ОтчетКассираПроведен,
	|	IsNull(ОК.Ссылка.Подтверждено,ЛОЖЬ) как ОтчетКассираПодтверждено
	|ИЗ
	|	Документ.уб_ПриемкаОплат КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|		ПО (&ТекущаяДата = РегламентированныйПроизводственныйКалендарь.ДатаКалендаря)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			уб_Отчеткассира.Ссылка КАК Ссылка
	|		ИЗ
	|			Документ.уб_ОтчетКассира КАК уб_Отчеткассира
	|		ГДЕ
	|			уб_Отчеткассира.Ссылка = &ОтчетКассира) КАК ОК
	|		ПО (ИСТИНА)
	|ГДЕ
	|	П.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ОтчетКассира", ОтчетКассира);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Структура, Выборка);
		Если выборка.СегодняВыходной = Истина и ЗначениеЗаполнено(ОтчетКассира) Тогда
			Структура.ОтчетКассираПодтверждено = 
			Структура.ПредОтчетКассираПодтверждено = Истина;
		КонецЕсли;	
	КонецЕсли;

	Запрещено = Не Отладка И (ЗначениеЗаполнено(ОтчетКассира) И Структура.ОтчетКассираПодтверждено);
	ТекстМодификации = "";
	Если Запрещено И (Модифицированность_(ТекстМодификации) Или Не уб_СС.СоответствиеРежимаЗаписиСостояниюСсылки(Ссылка, РежимЗаписи)) Тогда
		#Если Клиент Тогда
			Предупреждение(ТекстМодификации+ "Для изменения требуется снять подтверждение отчета кассира."+ТекстМодификации, 10, "Внимание!!!");
		#КонецЕсли
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	СсылкаПометкаУдаления = Ссылка.ПометкаУдаления;
	бУстановкаПометкиУдаления = Не СсылкаПометкаУдаления И ПометкаУдаления;
	бСнятиеПометкиУдаления = СсылкаПометкаУдаления И Не ПометкаУдаления;
	//ТОДО проверить	
	Если бУстановкаПометкиУдаления Тогда
		УИДыСтрокТЧ = Полисы.ВыгрузитьКолонку("УИДСтроки");
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("УИДыСтрокТЧ", УИДыСтрокТЧ);
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	К.ОплатаПолиса
		|ИЗ
		|	РегистрСведений.уб_КвитовкаОплат КАК К
		|ГДЕ
		|	К.УИДСтрокиТЧ В(&УИДыСтрокТЧ)";
		Рез = Запрос.Выполнить();
		Если Не Рез.Пустой() Тогда
			#Если Клиент Тогда
				Режим = РежимДиалогаВопрос.ДаНет;
				Ответ = Вопрос("В документе есть привязки к оплатам." + Символы.ВК + Символы.ПС 
				+ "При пометке на удаление все они будут сброшены." 
				+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС + "Продолжить?" + Символы.ВК + Символы.ПС, Режим, 0, КодВозвратаДиалога.Нет, "Внимание!");
				Если Ответ = КодВозвратаДиалога.Нет Или Не УдалитьВсеКвитовкиПриемки() Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;				
			#КонецЕсли
		КонецЕсли;
	КонецЕсли;	
	ПересчитатьСуммыИУстановитьФлажки();
	УстановитьФлагКвитовки();
	Для Каждого СтрокаТЧ Из Платежи Цикл
		УстановитьЗначение(СтрокаТЧ.ОбоснованиеРазницы, СокрЛП(СтрокаТЧ.ОбоснованиеРазницы));
	КонецЦикла;
	// перезаписываем отчет кассира
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		_Проведен = Истина;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		_Проведен = Ложь;
	Иначе
		_Проведен = Неопределено
	КонецЕсли;
	Структура.Вставить("Проведен", ?(_Проведен = Неопределено, Проведен, _Проведен));

	Если Не Структура.ПредОтчетКассира.Пустая() 
		И Не Структура.ПредОтчетКассираПодтверждено
		Тогда
		МассивОтчетов.Добавить(Структура.ПредОтчетКассира)
	КонецЕсли;
	Если Не Структура.ОтчетКассира.Пустая() 
		И МассивОтчетов.Найти(Структура.ОтчетКассира) = Неопределено
		И Не Структура.ОтчетКассира.Подтверждено
		Тогда
		МассивОтчетов.Добавить(Структура.ОтчетКассира);
	КонецЕсли;
	Если МассивОтчетов.Количество() > 0 
		И (Структура.ПредСумма <> Структура.Сумма
		Или Структура.ПредПроведен <> Структура.Проведен
		Или Структура.ПредИтогСуммаПлатежи <> Структура.ИтогСуммаПлатежи)
		Тогда
		МассивОтчетовКассираДляЗаписи = МассивОтчетов
	Иначе
		МассивОтчетовКассираДляЗаписи = Неопределено;
	КонецЕсли;	
	
	пОрг = Справочники.Организации.ПустаяСсылка();
	Для каждого ДанныеПриемки из полисы Цикл
		//Если Строкап.ОрганизацияАгент = пОрг и Строкап.ВидБСО.Наименование ="Техосмотр" Тогда
		//	Строкап.ОрганизацияАгент = ПараметрыСеанса.уб_ОсновнаяОрганизация;//Справочники.Организации.НайтиПоНаименованию();
		//КонецЕсли;	
		Если ЗначениеЗаполнено(ДанныеПриемки.Заявка) и ЗначениеЗаполнено(ДанныеПриемки.УИДСтрокиЗаявки) Тогда
			СтрокаЗагрузки = Обработки.ЗагрузкаПолисовИзB2B.НайтиЗаявку(ДанныеПриемки.НомерБСО,ДанныеПриемки.СК,"",ДанныеПриемки.УИДСтрокиЗаявки);
			Если СтрокаЗагрузки.Свойство("СтрокаЗагрузки") и НЕ СтрокаЗагрузки.Заявка = ДанныеПриемки.Заявка Тогда
				//Данной строки нет в заявке, обрываем связь
				ДанныеПриемки.УИДСтрокиЗаявки = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Функция ПлатежиСтрокаТЧНераспределено(СоздаватьСтроку = Истина) Экспорт

	Итог = 0;
	Для Каждого СтрокаТЧ Из Платежи Цикл
		Если Не СтрокаТЧ.ОтсутствуетВОплатах Тогда
			Итог = Итог + СтрокаТЧ.Сумма;
		КонецЕсли;
	КонецЦикла;
	Для Индекс = -(Платежи.Количество() - 1) По 0 Цикл
		СтрокаТЧ = Платежи[-Индекс];
		Если СтрокаТЧ.ОбоснованиеРазницы = "<нераспределено>" И Не СтрокаТЧ.ОтсутствуетВОплатах Тогда
			Результат = СтрокаТЧ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	РазницаВТЧ = Полисы.Итог("Сумма") - Итог;
	Если РазницаВТЧ <> 0 Тогда
		Если Результат = Неопределено Тогда
			Если СоздаватьСтроку Тогда
				_ФормаОплаты = ФормаОплаты(Истина);
				Результат = Платежи.Добавить();
				Результат.Сумма					= РазницаВТЧ;
				Результат.ОбоснованиеРазницы 	= "<нераспределено>";
				Результат.ФормаОплаты = _ФормаОплаты;
				ЗаполнитьСтрокуТЧПлатежиПоУмолчанию(Результат);
			КонецЕсли;
		Иначе
			Результат.Сумма = Результат.Сумма + РазницаВТЧ;
		КонецЕсли;
	КонецЕсли;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбоснованиеРазницы", 	"<нераспределено>");
	ПараметрыОтбора.Вставить("Сумма",				0);
	МассивСтрок = Платежи.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		Если Результат <> Неопределено И СтрокаТЧ.НомерСтроки = Результат.НомерСтроки Тогда
			Результат = Неопределено;
		КонецЕсли;
		Платежи.Удалить(СтрокаТЧ);
	КонецЦикла;
	Если Результат <> Неопределено Тогда
		ЗаполнитьКомментарийНераспределеннойСтроки(Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции // СтруктураНераспределеннойСтроки()

Процедура ЗаполнитьКомментарийНераспределеннойСтроки(СтрокаТЧ, ПроверятьНаНераспределенную = Ложь) Экспорт

	Отказ = Ложь;
	Если ПроверятьНаНераспределенную Тогда
		Если СтрокаТЧ.ОбоснованиеРазницы <> "<нераспределено>" Тогда
			Отказ = Истина
		КонецЕсли;
	КонецЕсли;
	Если Не Отказ Тогда
		Если СтрокаТЧ.Сумма >= 0 Тогда
			Текст = "Требуется увеличить сумму по платежам, или уменьшить сумму по полисам";
		Иначе
			Текст = "Требуется увеличить сумму по полисам, или уменьшить сумму по платежам";
		КонецЕсли;
		УстановитьЗначение(СтрокаТЧ.Комментарий, Текст);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСтрокуТЧПлатежиПоУмолчанию(СтрокаТЧ) Экспорт

	Если СтрокаТЧ = Неопределено Тогда
		СтрокаТЧ = Платежи.Добавить();
	КонецЕсли;
	Если СтрокаТЧ.ФормаОплаты.Пустая() Тогда
		СтрокаТЧ.ФормаОплаты = ФормаОплаты();
	КонецЕсли;
	Если ПустаяСтрока(СтрокаТЧ.УИДСтроки) Тогда
		СтрокаТЧ.УИДСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если СтрокаТЧ.Валюта.Пустая() Тогда
		СтрокаТЧ.Валюта = ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета;
	КонецЕсли;
	Если СтрокаТЧ.Курс = 0 Тогда
		СтрокаТЧ.Курс = 1
	КонецЕсли;
	Если СтрокаТЧ.Кратность = 0 Тогда
		СтрокаТЧ.Кратность = 1
	КонецЕсли;
	Если СтрокаТЧ.СуммаВВалюте <> СтрокаТЧ.Сумма И СтрокаТЧ.Курс = 1 И СтрокаТЧ.Кратность = 1 Тогда
		СтрокаТЧ.СуммаВВалюте = СтрокаТЧ.Сумма
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Перем ЗаявкаНомер;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = "Проведение документа """ + СокрЛП(Ссылка) + """: ";
	Если _Отвязка_Оплаты_ Тогда
		_Отвязка_Оплаты_ = Ложь;
	Иначе
		СтруктураОбязательныхПолей = Новый Структура("ПринятоОТ");
		ОбщегоНазначения.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
		ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок);
	КонецЕсли;
	// Движения по документу
	Если Не Отказ И Не Проведен Тогда
		//ДвиженияПоРегистрам(Отказ, Заголовок);
	КонецЕсли;	
	//Движение статусов заявок
	Если Не Отказ Тогда		
		Если ДополнительныеСвойства.Свойство("НеДвигатьСтатусы") Тогда
		Иначе
			Документы.уб_ПриемкаОплат.ДвижениеСтатусовЗаявок(Ссылка,Строка(ПринятоОТ)="_дежурный Выходные Дни");	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Отказ = НЕ УдалитьВсеКвитовкиПриемки();
	
КонецПроцедуры

Функция УдалитьВременныеДанныеПолисаКПриемкеОплат(УИДСтроки) Экспорт 
	
	ВыборкаРС = РегистрыСведений.уб_ВременныеДанныеПолисаКПриемкеОплат.Выбрать(Новый Структура("УИДСтрокиТЧ", УИДСтроки)); 
	ЕстьДанные = Ложь;
	Пока ВыборкаРС.Следующий() Цикл
		МЗ = ВыборкаРС.ПолучитьМенеджерЗаписи();	
		Попытка
			МЗ.Удалить();
			#Если Клиент Тогда
				Если ПараметрыСеанса.уб_РежимОтладки > 8 Тогда
					Сообщить("Удалены временные данные к приемке оплат для УИД строки '" + УИДСтроки + "'");
				КонецЕсли;
			#КонецЕсли
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не удалось удалить временные данные к приемке оплат для УИД строки '" + УИДСтроки + "'",, Истина);
			Возврат Ложь;
		КонецПопытки;	
		ЕстьДанные =Истина;
	КонецЦикла;
	Если ЕстьДанные Тогда
		ДозаполнитьРегистрУТехосмотра();
	КонецЕсли;	
	Возврат Истина;
	
КонецФункции

Функция ДозаполнитьРегистрУТехосмотра()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.УИДСтрокиТЧ,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаЗаписи,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ПриемОплаты КАК ПриемОплаты,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НомерЗаявки,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.СтраховойПродукт,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Страхователь,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОкончания,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаНачала,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОформления,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОплаты,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НачисленнаяСуммаВзноса,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НачисленнаяСуммаВзносаВВалюте,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Агент,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Курьер,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НомерВзноса,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.СкидкаВыплаченаяКлиенту,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ФормаОплаты,
	               |	МАКСИМУМ(уб_ПриемкаОплатПлатежи.ФормаОплаты) КАК ФормаОплаты1,
	               |	МИНИМУМ(уб_ПриемкаОплатПлатежи.ФормаОплаты) КАК ФормаОплаты2,
	               |	уб_ПриемкаОплатПолисы.УИДСтроки КАК УИДСтроки
	               |ИЗ
	               |	РегистрСведений.уб_ВременныеДанныеПолисаКПриемкеОплат КАК уб_ВременныеДанныеПолисаКПриемкеОплат
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК уб_ПриемкаОплатПлатежи
	               |		ПО уб_ВременныеДанныеПолисаКПриемкеОплат.ПриемОплаты = уб_ПриемкаОплатПлатежи.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК уб_ПриемкаОплатПолисы
	               |		ПО уб_ВременныеДанныеПолисаКПриемкеОплат.ПриемОплаты = уб_ПриемкаОплатПолисы.Ссылка
	               |			И (уб_ПриемкаОплатПолисы.ВидБСО.Наименование = ""Техосмотр"")
	               |			И уб_ВременныеДанныеПолисаКПриемкеОплат.УИДСтрокиТЧ <> уб_ПриемкаОплатПолисы.УИДСтроки
	               |ГДЕ
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ФормаОплаты <> ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.ПустаяСсылка)
	               |	И уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаЗаписи >= ДАТАВРЕМЯ(2017, 7, 1)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.УИДСтрокиТЧ,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаЗаписи,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ПриемОплаты,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НомерЗаявки,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.СтраховойПродукт,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Страхователь,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОкончания,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаНачала,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОформления,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ДатаОплаты,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НачисленнаяСуммаВзноса,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НачисленнаяСуммаВзносаВВалюте,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Агент,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.Курьер,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.НомерВзноса,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.СкидкаВыплаченаяКлиенту,
	               |	уб_ВременныеДанныеПолисаКПриемкеОплат.ФормаОплаты,
	               |	уб_ПриемкаОплатПолисы.УИДСтроки
	               |ИТОГИ
	               |	МАКСИМУМ(УИДСтроки)
	               |ПО
	               |	ПриемОплаты";
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл			   
		Выборка2 = Выборка.Выбрать();
		Пока Выборка2.Следующий() Цикл
			Мз = РегистрыСведений.уб_ВременныеДанныеПолисаКПриемкеОплат.СоздатьМенеджерЗаписи();
			Мз.УИДСтрокиТЧ = Выборка.УИДСтроки;
			Мз.Прочитать();
			Если Мз.Выбран() Тогда
				продолжить
			Иначе
				ЗаполнитьЗначенияСвойств(мз,Выборка2);
				Мз.УИДСтрокиТЧ = Выборка.УИДСтроки;
				Мз.Записать();
			Конецесли;	
		КонецЦикла;	
	КонецЦикла;	
КонецФункции	

Процедура ПересчитатьСуммыИУстановитьФлажки(ЕстьИзменения = Ложь) Экспорт
	
	Если СистемаТЧПлатежи Тогда
		_Разница = СуммаНераспределенныхСтрок();
		ЕстьИзменения = УстЗнач(Разница, _Разница, Истина) Или ЕстьИзменения;
		СуммаПоСтрокам_	= Полисы.Итог("Сумма");
		ЕстьИзменения = УстЗнач(СуммаПоСтрокам, СуммаПоСтрокам_, Истина) Или ЕстьИзменения;
		ЕстьИзменения = УстЗнач(ИтогСуммаПлатежи, Платежи.Итог("Сумма"), Истина) Или ЕстьИзменения;
		СтрокаТЧ = Платежи.Найти("<нераспределено>", "ОбоснованиеРазницы");
		СуммыНеРавны_ = СтрокаТЧ <> Неопределено;
		ЕстьИзменения = УстЗнач(СуммыНеРавны, СуммыНеРавны_, Истина) Или ЕстьИзменения;
		НетПривязкиКОплате_ = НЕ ВсеОплатыПривязаны();
		ЕстьИзменения = УстЗнач(НетПривязкиКОплате, НетПривязкиКОплате_, Истина) Или ЕстьИзменения;
		ЕстьИзменения = УстЗнач(ВознаграждениеКурьераКлиентом, РассчитатьВознаграждениеКурьераПоПриемке(), Истина) Или ЕстьИзменения;
	Иначе
		СуммаПоСтрокам_ = Полисы.Итог("Сумма");
		СуммыНеРавны_ = Сумма <> (СуммаПоСтрокам_ + Разница);
		НетПривязкиКОплате_ = НЕ ВсеОплатыПривязаны();
		Если Курс <> 1 Тогда
			Если Валюта.Код = "810" Тогда
				ЕстьИзменения = Истина;
				Курс = 1;
			КонецЕсли;	
		КонецЕсли;	
		ЕстьИзменения = УстЗнач(Сумма, Окр(СуммаВВалюте * Курс, 2), Истина) Или ЕстьИзменения;
		Если Разница = 0 Тогда
			ЕстьИзменения = УстЗнач(ОбоснованиеРазницы, "", Истина) Или ЕстьИзменения;
		КонецЕсли;
		ЕстьИзменения = УстЗнач(СуммаПоСтрокам, СуммаПоСтрокам_, Истина) Или ЕстьИзменения;
		ЕстьИзменения = УстЗнач(СуммыНеРавны, СуммыНеРавны_, Истина) Или ЕстьИзменения;
		ЕстьИзменения = УстЗнач(НетПривязкиКОплате, НетПривязкиКОплате_, Истина) Или ЕстьИзменения;
		ЕстьИзменения = УстЗнач(ИтогСуммаПлатежи, Платежи.Итог("Сумма"), Истина) Или ЕстьИзменения;
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьВознаграждениеКурьераПоПриемке()

	Результат = 0;
	Для Каждого СтрокаТЧ Из Платежи Цикл
		Если СтрокаТЧ.ОбоснованиеРазницы = "Оплата выезда клиентом" Тогда
			Результат = Результат + СтрокаТЧ.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции // РассчитатьВознаграждениеКурьераПоПриемке()

Функция УстановитьФлагКвитовки() Экспорт
	
	тзНесквитованныхПриемокДляЗаписи = Новый ТаблицаЗначений;	
	тзНесквитованныхПриемокДляЗаписи.Колонки.Добавить("ПриемОплаты");
	НетКвитовкиПоСуммамОплат_ = Ложь;		
	Для Каждого Стр Из Полисы Цикл
		тзНесквПриемок = Новый ТаблицаЗначений;
		Если Не уб_СС.КвитовкаПоСуммам(Стр.УИДСтроки, тзНесквПриемок,,, ЭтотОбъект) Тогда
			НетКвитовкиПоСуммамОплат_ = Истина;
		КонецЕсли;
		Для Каждого СтрТЗ Из тзНесквПриемок Цикл
			новСтр = тзНесквитованныхПриемокДляЗаписи.Добавить();
			новСтр.ПриемОплаты = СтрТЗ.ПриемОплаты;
		КонецЦикла;
	КонецЦикла;
	тзНесквитованныхПриемокДляЗаписи.Свернуть("ПриемОплаты");
	УстЗнач(НетКвитовкиПоСуммамОплат, НетКвитовкиПоСуммамОплат_, Истина);
	Возврат тзНесквитованныхПриемокДляЗаписи;
	
КонецФункции

Функция ВсеОплатыПривязаны() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	К.УИДСтрокиТЧ
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|ГДЕ
	|	К.ПриемОплаты = &ПриемОплаты";
	Запрос.УстановитьПараметр("ПриемОплаты", Ссылка);
	тзУИДов = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из Полисы Цикл
		Если тзУИДов.Найти(Стр.УИДСтроки) = Неопределено Тогда
			Возврат Ложь;	
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция УдалитьВсеКвитовкиПриемки() Экспорт
	
	НачатьТранзакцию();
	Если уб_СС.УдалитьКвитовки(Неопределено, Неопределено, Ссылка, ЭтотОбъект) Тогда
		ЗафиксироватьТранзакцию();	
		Возврат Истина;	
	Иначе
		ОтменитьТранзакцию();	
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	
	Для Каждого Стр ИЗ Полисы Цикл
		Стр.УИДСтроки = Новый УникальныйИдентификатор();	
		Стр.УИДСтрокиЗаявки = "";
	КонецЦикла;
	Для Каждого СтрокаТЧ Из Платежи Цикл
		Стр.УИДСтроки = Новый УникальныйИдентификатор();
	КонецЦикла;
	Дата = ОбъектКопирования.Дата;
	ОтчетКассира 				= Документы.уб_ОтчетКассира.ПустаяСсылка();
	НетПривязкиКОплате  		= Ложь;
	НетКвитовкиПоСуммамОплат    = Ложь;	
	
КонецПроцедуры

////////////////////////

Процедура ОбработкаЗаполнения(Основание, СтандартнаяОбработка)
	
	_Заявка = Неопределено;
	Форма = ПолучитьФорму("ФормаВыбораСтрокОснования");
	ТипЗнч = ТипЗнч(Основание);
	Если ТипЗнч = Тип("ДокументСсылка.уб_ПеремещениеБСО") Или ТипЗнч = Тип("Структура") И Основание.Свойство("Заявка") Тогда // иногда при заполненном фильтре в форме списка приемок создается на основании структуры с одним ключем основания-ссылки-приемки
		Если ТипЗнч = Тип("ДокументСсылка.уб_ПеремещениеБСО") Тогда
			Параметры = Новый Структура;
			Массив = Новый Массив;
			Массив.Добавить(Основание);
			Параметры.Вставить("Документ", 		Массив);
			Параметры.Вставить("ТолькоВыдача",  Ложь);
			Параметры.Вставить("Заявка");
			ОснованиеСозданНаОсновании = Основание.СозданНаОсновании;
			Если ТипЗнч(ОснованиеСозданНаОсновании) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
				Параметры.Заявка = ОснованиеСозданНаОсновании;
			КонецЕсли;				
		Иначе
			Параметры = Основание;
		КонецЕсли;
		Форма.Заявка = Параметры.Заявка;
		ВознаграждениеКурьераКлиентом = Документы.уб_ПриемкаОплат.ВознаграждениеКурьераКлиентом(Форма.Заявка,Ссылка);
		_Заявка = Форма.Заявка;
		Документ = Параметры.Документ;//МассивДокументов
		ТолькоВыдача = Неопределено;
		Параметры.Свойство("ТолькоВыдача", ТолькоВыдача);
		//Допускаем, что тип элемента всегда ПеремещениеБСО
		ВсегоВМассиве = Документ.Количество();
		ТЗИсточник = Новый ТаблицаЗначений;
		ТЗГотова = Ложь;		
		Для Счетчик = 0 по ВсегоВМассиве - 1 Цикл
			ТекДокумент = Документ[Счетчик];
			Если ТолькоВыдача  = Истина Тогда
				Если НЕ ТекДокумент.Направление = 1 Тогда
					//Это не выдача
					//Старый код НЕ ДокументЯвляетсяВыдачей(ТекДокумент,СписокСотрудниковБСО) Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			Если НЕ ТЗГотова Тогда
				ТЗИсточник = ТекДокумент.БСО.Выгрузить();
				ТЗИсточник.Колонки.Добавить("ДопНомерБСО",Новый ОписаниеТипов("Строка"));
				Если Платежи.Количество()= 0 Тогда
					ЗаполнитьШапкуПоОснованию(ТекДокумент);
				КонецЕсли;	
				ТЗИсточник.Индексы.Добавить("НомерБСО,ВидБСО");
				ТЗГотова = Истина;
				Запрос = Новый Запрос;
				Для каждого СтрокаБсо из  ТЗИсточник Цикл
					Запрос.текст = "ВЫБРАТЬ
					               |	уб_ДвиженияБСОСрезПоследних.Период,
					               |	уб_ДвиженияБСОСрезПоследних.Регистратор,
					               |	уб_ДвиженияБСОСрезПоследних.НомерСтроки,
					               |	уб_ДвиженияБСОСрезПоследних.Активность,
					               |	уб_ДвиженияБСОСрезПоследних.ВидБСО,
					               |	уб_ДвиженияБСОСрезПоследних.НомерБСО,
					               |	уб_ДвиженияБСОСрезПоследних.СК,
					               |	уб_ДвиженияБСОСрезПоследних.АгентОтправитель,
					               |	уб_ДвиженияБСОСрезПоследних.Агент,
					               |	уб_ДвиженияБСОСрезПоследних.ПоложениеБСО,
					               |	уб_ДвиженияБСОСрезПоследних.СостояниеБСО,
					               |	уб_ДвиженияБСОСрезПоследних.НомерПолиса,
					               |	уб_ДвиженияБСОСрезПоследних.ГодПолиса,
					               |	уб_ДвиженияБСОСрезПоследних.СтраховойПолис,
					               |	уб_ДвиженияБСОСрезПоследних.НаОснованииБумажногоДокумента,
					               |	уб_ДвиженияБСОСрезПоследних.ДатаВозврата,
					               |	уб_ДвиженияБСОСрезПоследних.Заявка,
					               |	уб_ДвиженияБСОСрезПоследних.Подтверждено,
					               |	уб_ДвиженияБСОСрезПоследних.Поставщик,
					               |	уб_ДвиженияБСОСрезПоследних.ОрганизацияАгент,
					               |	уб_ДвиженияБСОСрезПоследних.СтраховаяПремия,
					               |	уб_ДвиженияБСОСрезПоследних.Актуальная,
					               |	уб_ДвиженияБСОСрезПоследних.ДопНомерБСО,
					               |	уб_ДвиженияБСОСрезПоследних.КодОперации,
					               |	уб_ДвиженияБСОСрезПоследних.Комментарий
					               |ИЗ
					               |	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(&Дата) КАК уб_ДвиженияБСОСрезПоследних
					               |ГДЕ
					               |	уб_ДвиженияБСОСрезПоследних.ВидБСО = &ВидБСО
					               |	И уб_ДвиженияБСОСрезПоследних.НомерБСО = &НомерБСО";
								   Запрос.УстановитьПараметр("Дата",ТекДокумент.Дата+1);
								   Запрос.УстановитьПараметр("ВидБСО",СтрокаБСО.ВидБСО);
								   Запрос.УстановитьПараметр("НомерБСО",СтрокаБСО.НомерБСО);
								   выборкаДопБСо= Запрос.Выполнить().Выбрать();
								   Если ВыборкаДопБСО.Следующий() Тогда
									   СтрокаБСО.ДопНомерБСО = ВыборкаДопБСО.ДопНомерБСО;
								   КонецЕсли;  
									   
				КонецЦикла;	
				Продолжить;
			Конецесли;	
			Для каждого ТекСтрока из ТекДокумент.БСО Цикл
				Если ТЗИсточник.НайтиСтроки (Новый Структура("ВидБСО,НомерБСО", ТекСтрока.ВидБСО, ТекСтрока.НомерБСО)).Количество() = 0 Тогда
					НоваяСтрока = ТЗИсточник.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
	ИначеЕсли Основание = "ПроверкаМодифицированности" Тогда
		СтандартнаяОбработка = Ложь;
		ПересчитатьСуммыИУстановитьФлажки();
		УстановитьФлагКвитовки();
		Возврат;
	Иначе
		ТЗИсточник = Новый ТаблицаЗначений;
	КонецЕсли;
	Если ТЗИсточник.Количество() > 0 Тогда
		Форма.НачальнаяТаблица = ТЗИсточник.Скопировать();
		ТЗПриемник = Полисы.Выгрузить();
		УдалитьСуществующиеБСО(ТЗИсточник, ТЗПриемник);
		СтандартнаяОбработка = Ложь;
		Если ЭтоНовый() Тогда
			УстановитьСсылкуНового(Документы.уб_ПриемкаОплат.ПолучитьСсылку(Новый УникальныйИдентификатор));
		КонецЕсли;	
		Форма.ТаблицаБСО = ТЗИсточник;
		Форма.ЭлементыФормы.ТаблицаБСО.СоздатьКолонки();
		Форма.ПодключитьОбработчикОжидания ("АктивизироватьФорму", 0.1, Истина);  
		Форма.Открыть();
	КонецЕсли;
	
КонецПроцедуры


Процедура УдалитьСуществующиеБСО(ТЗИсточник,ТЗПриемник)
	
	ВсегоСтрок = ТЗИсточник.Количество();
	Для Ит = 1 по ВсегоСтрок Цикл
		ТекСтрока = ТЗИсточник[ВсегоСтрок - Ит];
		Тип = Неопределено;
		Если уб_СЛ.ОпределитьЭтоПолис(ТекСтрока.ВидБСО, Тип) Тогда 
			Если ТЗПриемник.НайтиСтроки (Новый Структура("СК,ВидБСО,НомерБСО", ТекСтрока.СК, ТекСтрока.ВидБСО, ТекСтрока.НомерБСО)).Количество()>0 Тогда
				ТЗИсточник.Удалить(ТекСтрока);
			Конецесли;	
		ИначеЕсли уб_СЛ.ОпределитьЭтоКвитанцияА7(ТекСтрока.ВидБСО,Тип) Тогда	
			Если ТЗПриемник.НайтиСтроки (Новый Структура("НомерКвитанции",ТекСтрока.НомерБСО)).Количество()>0 Тогда
				ТЗИсточник.Удалить(ТекСтрока);
			Конецесли;	
		Иначе
			ТЗИсточник.Удалить(ТекСтрока);
		Конецесли;			
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьШапкуПоОснованию(Основание);
	
	СозданНаОсновании = Основание.Ссылка;	
	_Заявка = уб_УСЗ.ПолучитьИзначальныйДокумент(Основание);
	Если ТипЗНЧ(_Заявка) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
		_Заявка = уб_УСЗ.ПолучитьРеквизитыЗаявки(_Заявка);
		Если _Заявка.Самовыезд  Тогда
			ПринятоОТ = _Заявка.Менеджер;		
		Иначе	
			ПринятоОТ = _Заявка.Курьер;		
		КонецЕсли;	
	Иначе	
		ПринятоОТ = Основание.АгентКуда;
	КонецЕсли;
	
КонецПроцедуры

Функция Модифицированность_(ТекстМодификации = "") Экспорт
	
	Если Не Модифицированность() Тогда
		Возврат Ложь
	КонецЕсли;	
	Результат = Ложь;
	//Ключевые параметры: 
	Если СистемаТЧПлатежи Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	П.СуммаПоСтрокам,
		|	ЕСТЬNULL(ПП.ФормаОплаты, ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.ПустаяСсылка)) КАК ФормаОплаты,
		|	ЕСТЬNULL(ПП.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(ПП.УИДСтроки, """") КАК УИДСтроки
		|ИЗ
		|	Документ.уб_ПриемкаОплат КАК П
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК ПП
		|		ПО (ПП.Ссылка = П.Ссылка)
		|ГДЕ
		|	П.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрокаТЧ = Платежи.Найти(Выборка.УИДСтроки, "УИДСтроки");
				Если СтрокаТЧ = Неопределено Тогда
					ТекстМодификации = "Изменены строки ТЧ Платежи. ";
					Результат = Истина;
					Прервать;
				ИначеЕсли СтрокаТЧ.Сумма <> Выборка.Сумма Тогда
					ТекстМодификации 	= "Изменена сумма. ";
					Результат 			= Истина;
					Прервать;
				ИначеЕсли СтрокаТЧ.ФормаОплаты <> Выборка.ФормаОплаты
					И (ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Или Выборка.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса)
					Тогда
					ТекстМодификации 	= "Изменена формы оплаты. ";
					Результат 			= Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Результат И Выборка.СуммаПоСтрокам <> СуммаПоСтрокам Тогда
				ТекстМодификации	= "Изменена сумма. ";
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	уб_ПриемкаОплат.Сумма,
		|	уб_ПриемкаОплат.СуммаВВалюте,
		|	уб_ПриемкаОплат.СуммаПоСтрокам,
		|	уб_ПриемкаОплат.ФормаОплаты
		|ИЗ
		|	Документ.уб_ПриемкаОплат КАК уб_ПриемкаОплат
		|ГДЕ
		|	уб_ПриемкаОплат.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если Выборка.Сумма <> Сумма Или Выборка.СуммаВВалюте <> СуммаВВалюте Или Выборка.СуммаПоСтрокам <> СуммаПоСтрокам Тогда
				ТекстМодификации 	= "Изменена сумма. ";
				Результат 			= Истина;
			ИначеЕсли ФормаОплаты <> Выборка.ФормаОплаты 
				И (ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Или Выборка.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса)	Тогда 
				//ФормаОплаты - изменение связано с кассой
				ТекстМодификации 	= "Изменена формы оплаты. ";
				Результат 			= Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции	

Функция СобратьДанныеПоСтроке(ТекСтрока) Экспорт
	
	Структ = Документы.уб_ПриемкаОплат.ПолучитьПустуюСтруктуруСтроки();
	Если ТекСтрока <> Неопределено Тогда
		//Из строки
		ЗаполнитьЗначенияСвойств(Структ,ТекСтрока);
		//Из объекта
		Структ.Валюта      = Валюта;
		Структ.Курс        = Курс;
		Структ.ФормаОплаты = ?(СистемаТЧПлатежи, ФормаОплаты(), ФормаОплаты);
		//на примере приемки 18173:
		//ОплатаПолисаДляОтчетаАгента - пустая, временных данных нет, однако у БСО ВВВ0629405198 фактически есть и полис и оплата
		//следовательно использовать значение реквизита ОплатаПолисаДляОтчетаАгента нельзя, воспользуемся
		//получением данных из регистра сведений уб_КвитовкаОплат, а не из реквизита ТЧ
		//TODO дальше проверить работоспособность регистра уб_ВременныеДанныеПолисаКПриемкеОплат
		ОплатаПолисаДляОтчетаАгента = Документы.уб_ПриемкаОплат.ПолучитьОплатуПолисаДляОтчетаАгента(ТекСтрока.УИДСтроки, ТекСтрока.НомерКвитанции);
		Если ОплатаПолисаДляОтчетаАгента.Пустая() Тогда
			//Из временных данных
			ВыборкаРС = РегистрыСведений.уб_ВременныеДанныеПолисаКПриемкеОплат.Выбрать(Новый Структура("УИДСтрокиТЧ", ТекСтрока.УИДСтроки)); 
			Если ВыборкаРС.Следующий() Тогда
				ЗаполнитьЗначенияСвойств(Структ, ВыборкаРС);
			Иначе
				//нет ни оплаты полиса, ни временных данных. Данных для создания страхового полиса и оплаты нет.
				//Структ = Неопределено;
			КонецЕсли;
		Иначе	
			//Из оплаты и полиса
			ЗаполнитьЗначенияСвойств(Структ, ПолучитьДанныеОплатыИПолиса(ОплатаПолисаДляОтчетаАгента));
		КонецЕсли;
		//
		//Если НЕ ТекСтрока.Заявка.Пустая() И НЕ Структ = Неопределено Тогда  //не используются заявки на печать
		//	//
		//	
		//	ДанныеИзЗаявкиНаПечать = Документы.уб_ЗаявкаНаПечать.ДанныеПечатиПоВыезду (ТекСтрока.Заявка,Истина);
		//	Структ.Вставить("ДопДанные",ДанныеИзЗаявкиНаПечать);
		//	//Сообщить(Данные.Страхователь);
		//	
		//КонецЕсли;	
		
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(Структ.ВидБСО)  Тогда
			Если НЕ ТипЗнч(Структ.ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
				Структ.Вставить("РазрешитьБезОтчета",Структ.ВидБСО.НеКонтролироватьОтчетомКассира);
			Иначе
				Структ.Вставить("РазрешитьБезОтчета",Истина);
				Структ.Вставить("СтраховойПродукт",Структ.ВидБСО);
			КонецЕсли;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	Возврат Структ;
	
КонецФункции // ПолучитьСтрукт()


