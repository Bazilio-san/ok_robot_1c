		);
		//уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("КВСумма",
		//Справочники.уб_ВидыРасчетныхОпераций.НачислениеКВБрокера,Ссылка,Ссылка,КВСумма,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	КонецЦикла;
	#Если Клиент Тогда
		Оповестить("ПриемкаОплатЗаписьНомераПолиса", Полисы.ВыгрузитьКолонку("НомерПолиса"));
	#КонецЕсли
	//чкн
	Отказ = ЛОЖЬ;
	ТЗОшибок = Новый ТаблицаЗначений;
	ТЗОшибок.Колонки.Добавить("Ошибка");
	ТЗОшибок.Колонки.Добавить("Строка");
	ТЗОшибок.Колонки.Добавить("Элемент");
	ПроверкаУникальностиЗаписейРегистра(Движения.уб_ДвиженияБСО, Отказ, ТЗОшибок);
	Если ТЗОшибок.Количество() <> 0 Тогда
		//Форма = ЭтотОбъект.ПолучитьФорму();
		Форма = Ссылка.ПолучитьФорму();
		Если Форма.Открыта() Тогда
			ОткрытьСообщениеОбОшибках(ТзОшибок, Форма);
		Иначе
			Для Каждого Строка Из ТЗОшибок Цикл
				Сообщить(Строка.Ошибка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если НЕ Отказ тогда
		Движения.уб_ДвиженияБСО.Записать();
		Движения.уб_ОстаткиБСО.Записать();
	КонецЕсли;
	//чкн
	Возврат;
	//+++Взаиморасчеты
	СтруктураПараметров = Новый Структура("Дата,Агент,Страхователь,Поставщик,ОрганизацияАгент",Дата,ПринятоОт);
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("СуммовыеОтклоненияВПриемке",
	,
	Ссылка,
	Строка(Ссылка.УникальныйИдентификатор()),
	Сумма-СуммаПоСтрокам,
	СтруктураПараметров,
	Строка(Ссылка.УникальныйИдентификатор()),
	ЗапросВзаиморасчеты);
	//++заиморасчеты
	//ВсегоСтрок = ?(ЗаписьРег  = Неопределено,0,1);
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	//|	*
	//|ИЗ
	//|	РегистрСведений.уб_ДвиженияБСО.СрезПоследних(
	//|			&Период,
	//|			ВидБСО = &ВидБСО
	//|				И НомерБСО = &НомерБСО
	////|				И СК = &СК
	//|				И Подтверждено) КАК уб_ДвиженияБСОСрезПоследних
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	Период УБЫВ";
	//Запрос.УстановитьПараметр("ВидБСО", СтрокаТЧ.ВидБСО);
	//Запрос.УстановитьПараметр("НомерБСО", СтрокаТЧ.НомерБСО);
	////Запрос.УстановитьПараметр("СК", СтрокаТЧ.СК);
	//Запрос.УстановитьПараметр("Период", ГраницаДокумента);
	//
	////Если НЕ ИнфоЗапись Тогда
	////	//СтруктураОтбора.Вставить("Подтверждено",Истина);
	////	////СтруктураОтбора.Вставить("ДокПроведен",Истина);
	////	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Подтверждено");
	////КонецЕсли;
	//
	//тзРег = Запрос.Выполнить().Выгрузить();
	
	//ВидДвижения = Неопределено;
	//ВсегоСтрок = тзРег.Количество();
	//ТипУчета = Неопределено;
	//Если  ВсегоСтрок > 0 Тогда
