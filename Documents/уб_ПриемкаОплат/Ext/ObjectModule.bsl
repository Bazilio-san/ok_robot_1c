
Перем СистемаТЧПлатежи;
Перем Отладка;
Перем МассивОтчетовКассираДляЗаписи Экспорт;

Процедура СоздатьПолисИОплату(
	Структ, 
	ВладелецФормы 			= Неопределено, 
	оСП						= Неопределено, 
	оО						= Неопределено,
	ПараметрыОППересчетСумм = Неопределено
	) Экспорт
	
	ЧастныеПараметрыОППересчетаСумм = ПараметрыОППересчетСумм <> Неопределено;
	ТекущаяДата = ТекущаяДата();
	_Интерактивно = НЕ ВладелецФормы = Неопределено;
	//+++Взаиморасчеты
	УИДГруппыСтроки = уб_Взаиморасчеты.ПолучитьУИДГруппыПоКлючуОперации(Структ.УИДСтроки);
	Если _Интерактивно И УИДГруппыСтроки = Ложь И ПараметрыСеанса.уб_Константы.ВестиВзаиморасчетыПоОперациям = Истина Тогда
		#Если Клиент Тогда
			Предупреждение("Не найдена запись по взаиморасчетам данной строки. Проведите документ повторно");
		#КонецЕсли
		Возврат;
	КонецЕсли;	
	//+++Взаиморасчеты
	//Сначала ищем полис.
	оСП = Неопределено;
	Если НЕ ПустаяСтрока(Структ.УИДСтрокиЗаявки) Тогда
		СтрокаЗаявки = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПолучитьСтрокуПоУИД(Структ.УИДСтрокиЗаявки);
		Структ.Вставить("СтрокаЗаявки",СтрокаЗаявки);
	//ИначеЕсли Структ.СтраховойПродукт.Наименование = "ТО" Тогда	
	//	Структ.Вставить("НачисленнаяСуммаВзноса",0);
	//	Структ.Вставить("НачисленнаяСуммаВзносаВВалюте",0);
	//	Структ.Вставить("ДобавитьДопы",Истина);
	Иначе
		СтрокаЗаявки = Неопределено;
	КонецЕсли;
	
			
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СК", Структ.СК);
	Если Не ЗначениеЗаполнено(Структ.ОплатаПолисаДляОтчетаАгента) Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Д.СтраховойПолис,
		|	Д.НомерПолиса,
		|	Д.НомерБСО,
		|	ВЫБОР
		|		КОГДА Д.Регистратор.СтраховаяПремия - Д.Регистратор.СуммаПремийПоОплатам >= 20
		|				И Д.Регистратор.СтраховаяПремия - Д.Регистратор.СуммаПремийПоОплатам <= -20
		|			ТОГДА 100
		|		ИНАЧЕ 1
		|	КОНЕЦ * ВЫБОР
		|		КОГДА Д.НомерПолиса = &НомерПолиса
		|			ТОГДА 100
		|		ИНАЧЕ 1
		|	КОНЕЦ 
		|* ВЫБОР
		|		КОГДА Д.НомерПолиса подобно &НомерБСО2
		|			ТОГДА 50
		|		ИНАЧЕ 1
		|	КОНЕЦ
		|* ВЫБОР
		|		КОГДА Д.Регистратор.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Приоритет,
		|	Д.Регистратор.СтраховаяПремия - Д.Регистратор.СуммаПремийПоОплатам КАК НеОплаченнаяПремия,
		|	Д.Регистратор
		|ИЗ
		|	РегистрСведений.уб_ДвиженияБСО КАК Д
		|ГДЕ
		//|	Д.ВидБСО = &ВидБСО
				|	Д.СК = &СК
		|	И Д.НомерБСО подобно &НомерБСО2
		|	И Д.Регистратор ССЫЛКА Документ.уб_СтраховойПолис
		|   и НЕ Д.Регистратор.СостояниеПолиса В (ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка), ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированВыписанНовый))
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет УБЫВ";
		Запрос.УстановитьПараметр("СК", 			Структ.СК);
		//Запрос.УстановитьПараметр("ВидБСО", 		Структ.ВидБСО); //могут внести другой ВИД бСО
		Запрос.УстановитьПараметр("НомерБСО", 		Структ.НомерБСО);
		//Запрос.УстановитьПараметр("НомерБСО2", 		"%"+Сред(СокрЛП(Структ.НомерБСО),4));
		
		//Запрос.УстановитьПараметр("НомерБСО2", 		"%"+Прав(СокрЛП(Структ.НомерБСО),СтрДлина(СокрЛП(Структ.НомерБСО)-4))+"%");
		Запрос.УстановитьПараметр("НомерБСО2", 		"%"+СокрЛП(Структ.НомерБСО)+"%");
		Запрос.УстановитьПараметр("НомерПолиса", 	СокрЛП(Структ.НомерПолиса));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если _Интерактивно и уб_temp.ЧислоПоМодулю(Выборка.НеОплаченнаяПремия) < 20 Тогда
				Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ЗапретПравкиДатыЗаявки, Ложь) Тогда
					Сообщить("Уже внесен полис "+Выборка.Регистратор);
					Возврат;
				КонецЕсли;	
				СЗ = Новый СписокЗначений;
				СЗ.Добавить(Документы.уб_СтраховойПолис.ПустаяСсылка(),	"Создать новый полис");
				СЗ.Добавить(Выборка.Регистратор,	Строка(Выборка.Регистратор) + " остаток: " + Выборка.НеОплаченнаяПремия);
				Пока Выборка.Следующий() Цикл
					СЗ.Добавить(Выборка.Регистратор,Строка(Выборка.Регистратор) + " остаток: " + Выборка.НеОплаченнаяПремия);
				КонецЦикла;
				ВыбранныйПолис = СЗ.ВыбратьЭлемент("Список оплаченных полисов");
				Если ВыбранныйПолис <> Неопределено Тогда
					Если Не ВыбранныйПолис.Значение.Пустая() Тогда
						сСП = ВыбранныйПолис.Значение;
						оСП = сСП.ПолучитьОбъект();
					КонецЕсли;
				Иначе
					//при закрытии окна прерываем создание
					Возврат
				КонецЕсли;
			Иначе
				сСП = Выборка.СтраховойПолис;
				оСП = сСП.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
	Иначе	
		сСП = Структ.ОплатаПолисаДляОтчетаАгента.СтраховойПолис;
		Если сСП.Пустая() Тогда
			оСП = Неопределено;
		Иначе
			оСП = сСП.ПолучитьОбъект();
		КонецЕсли;	
	КонецЕсли;		
	Если оСП <> Неопределено Тогда
		Если _Интерактивно Тогда
			Фрм_СП = оСП.ПолучитьФорму(,ВладелецФормы);
			Фрм_СП.Открыть(); //TODO вынести начальное заполнение из ПриОткрытии
		КонецЕсли;
		//+++Взаиморасчеты
		Если ПараметрыСеанса.уб_Константы.ВестиВзаиморасчетыПоОперациям = Истина Тогда
			УИДГруппыПолиса = уб_Взаиморасчеты.ПолучитьУИДГруппыПоДокументу(сСП);
			Если НЕ УИДГруппыПолиса = УИДГруппыСтроки Тогда
				уб_Взаиморасчеты.СлияниеГрупп(УИДГруппыПолиса,УИДГруппыСтроки);
			КонецЕсли;	
		КонецЕсли;	
		//---Взаиморасчеты
		ТребуетсяАктивизировать = Ложь;//Это старый полис
	Иначе
		//Полис отсутствует
		оСП = Документы.уб_СтраховойПолис.СоздатьДокумент();
		ТребуетсяАктивизировать = Истина;//Это новый полис
		Если _Интерактивно Тогда
			Фрм_СП = оСП.ПолучитьФорму(,ВладелецФормы);		
		КонецЕсли;	
		уб_СтраховойБрокер.ЗаполнитьШапкуДокументаСтрБрокер(оСП, ПараметрыСеанса.ТекущийПользователь, ПараметрыСеанса.уб_Константы.уб_ВалютаРегламентированногоУчета);
		оСП.ДатаМониторинга  	= Структ.ДатаОформления;
		оСП.ДатаДвиженияБСО 	= ТекущаяДата;//Полис ставим позже оплаты, т.к. он меняет агента и состояние
		оСП.ВидУчетаСтраховки 	= Перечисления.уб_ВидыУчетаСтраховок.Первичная;
		оСП.СостояниеПолиса 	= Перечисления.уб_СостоянияПолиса.Действует;
		оСП.ЗаполнитьДокументПоСтруктуре(Структ);//////-----Заполняется в Полисе-------///////
		оСП.ДополнительныеСвойства.Вставить("НеДвигатьСтатусы",Истина);
		оСП.Записать();
		//РегистрыСведений.уб_ПредоставленныеДокументыСП.ЗаполнитьПредоставленныеДокументыПоЗаявке(оСП.Ссылка, Структ.Заявка);
		Если _Интерактивно Тогда
			Фрм_СП.Открыть(); //TODO вынести начальное заполнение из ПриОткрытии
			Фрм_СП.ТекущийЭлемент = Фрм_СП.ЭлементыФормы.ДатаОформления;
		КонецЕсли;			
		сСП = оСП.Ссылка;
		//+++ Взаиморасчеты
		Если УИДГруппыСтроки = Ложь Тогда
			//Нет ни документа, ни строки
			//считаем, что это создание новой приемки до ее проведени, например загрузка ВЗР с сайта
			//генерируем новый
			УИДГруппыСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		УИДГруппыПолиса = УИДГруппыСтроки;		
		//Отключено потому что не вопремя создается для взр
		Если _Интерактивно Тогда
			уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("СозданиеСтраховогоПолиса",
			,//Автоматическое определение вида
			сСП, //Документ Записи
			сСП,//Отбор
			0,//Сумма
			Новый Структура("Дата,Агент,Страхователь,Поставщик,ОрганизацияАгент",Структ.ДатаОформления,Структ.Агент,Структ.Страхователь,Структ.Поставщик,Структ.ОрганизацияАгент),
			УИДГруппыПолиса);
		КонецЕсли;
		//--- Взаиморасчеты		
	КонецЕсли;
	//Привяжем файлы приемки оплат к текущему полису	
	//чкн
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА тогда	
		ЗапросФайлов = Новый Запрос;
		ЗапросФайлов.Текст = "ВЫБРАТЬ
		                     |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Расчетчик,
		                     |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ДопСоглашение,
		                     |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ДругиеДокументы
		                     |ИЗ
		                     |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
		                     |ГДЕ
		                     |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка = &Ссылка";
		ЗапросФайлов.УстановитьПараметр("Ссылка", Структ.Заявка);
		Выборка = ЗапросФайлов.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			ДанныеДляСправочника = Структ.ДопДанные;
			// расчетчик
			Если НЕ ТипЗнч(Выборка.Расчетчик) = Тип("Строка") И ЗначениеЗаполнено(Выборка.Расчетчик) Тогда 
				обФайл = Выборка.Расчетчик.ПолучитьОбъект();
				обФайл.Страхователь = Структ.Страхователь;
				обФайл.ОбъектСтрахования = ДанныеДляСправочника.ОбъектСтрахования;
				Если обФайл.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					обФайл.Опубликован = ИСТИНА;
				КонецЕсли;
				Попытка
					обФайл.Записать();
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
				НоваяСтрока = оСП.СписокФайлов.Добавить();
				НоваяСтрока.ДатаПубликации = ТекущаяДата();
				НоваяСтрока.Размещен = ИСТИНА;
				НоваяСтрока.СсылкаСправочника = Выборка.Расчетчик;
				Если НоваяСтрока.СсылкаСправочника.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					НоваяСтрока.Опубликован = ИСТИНА;
				КонецЕсли;
			КонецЕсли;
			// ДопСоглашение
			Если НЕ ТипЗнч(Выборка.ДопСоглашение) = Тип("Строка") И ЗначениеЗаполнено(Выборка.ДопСоглашение) Тогда 
				обФайл = Выборка.ДопСоглашение.ПолучитьОбъект();
				обФайл.Страхователь = Структ.Страхователь;
				обФайл.ОбъектСтрахования = ДанныеДляСправочника.ОбъектСтрахования;
				Если обФайл.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					обФайл.Опубликован = ИСТИНА;
				КонецЕсли;
				Попытка
					обФайл.Записать();
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
				НоваяСтрока = оСП.СписокФайлов.Добавить();
				НоваяСтрока.ДатаПубликации = ТекущаяДата();
				НоваяСтрока.Размещен = ИСТИНА;
				НоваяСтрока.СсылкаСправочника = Выборка.ДопСоглашение;
				Если НоваяСтрока.СсылкаСправочника.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					НоваяСтрока.Опубликован = ИСТИНА;
				КонецЕсли;
			КонецЕсли;
			// ДругиеДокументы
			Если НЕ ТипЗнч(Выборка.ДругиеДокументы) = Тип("Строка") И ЗначениеЗаполнено(Выборка.ДругиеДокументы) Тогда 
				обФайл = Выборка.ДругиеДокументы.ПолучитьОбъект();
				обФайл.Страхователь = Структ.Страхователь;
				обФайл.ОбъектСтрахования = ДанныеДляСправочника.ОбъектСтрахования;
				Если обФайл.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					обФайл.Опубликован = ИСТИНА;
				КонецЕсли;
				Попытка
					обФайл.Записать();
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
				НоваяСтрока = оСП.СписокФайлов.Добавить();
				НоваяСтрока.ДатаПубликации = ТекущаяДата();
				НоваяСтрока.Размещен = ИСТИНА;
				НоваяСтрока.СсылкаСправочника = Выборка.ДругиеДокументы;
				Если НоваяСтрока.СсылкаСправочника.ВидФайлаB2B <> Перечисления.уб_ВидыФайловB2B.ДСП Тогда 
					НоваяСтрока.Опубликован = ИСТИНА;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Попытка
			оСП.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;

	Иначе
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	уб_ФайлыКПолисам.СтраховойПолис,
		|	уб_ФайлыКПолисам.СК,
		|	уб_ФайлыКПолисам.ВидБСО,
		|	уб_ФайлыКПолисам.НомерБСО,
		|	уб_ФайлыКПолисам.УИД
		|ИЗ
		|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
		|ГДЕ
		|	уб_ФайлыКПолисам.СтраховойПолис = &УИДСтроки");
		Запрос.УстановитьПараметр("УИДСтроки", Структ.УИДСтроки);
		Результат	= Запрос.Выполнить().Выбрать();
		Запись		= РегистрыСведений.уб_ФайлыКПолисам.СоздатьМенеджерЗаписи();
		Пока Результат.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Запись, Результат);
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.СтраховойПолис = сСП;
				//Запись.УИДСтроки = "";
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	//чкн
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	О.Ссылка
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|   И О.СтраховойПолис = &СтраховойПолис
	|	И О.НомерКвитанции = &НомерКвитанции
	//|	И О.СК = &СК
