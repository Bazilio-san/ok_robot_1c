Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = "Проведение документа """ + СокрЛП(Ссылка) + """: ";
	СтруктураОбязательныхПолей = Новый Структура("ПринятоОТ");
	ОбщегоНазначения.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);	
	ПроверитьЗаполнениеТабличнойЧастиБСО(Отказ, Заголовок);
	// Движения по документу
	Если Не Отказ Тогда
		ДвиженияПоРегистрам(Отказ, Заголовок);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ДвиженияПоРегистрам(Отказ, Заголовок)
	
	Движения.уб_ДвиженияБСО.Очистить();
	Движения.уб_ОстаткиБСО.Очистить();
	//ИнфоЗапись = Не Проведен;
	ВидГраницыДок = ВидГраницы.Исключая;
	ГраницаДокумента = Новый Граница(МоментВремени().Дата,ВидГраницыДок);
	//НужноОбновитьСтатусы = Ложь;
	//+++Взаиморасчеты
	ВидОперации = ?(ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику, Справочники.уб_ВидыРасчетныхОпераций.ПриемкаОтКлиентаПоставщиком, Справочники.уб_ВидыРасчетныхОпераций.ПриемкаОтКлиентаБрокером); 
	ЗапросВзаиморасчеты = Неопределено;
	
	ОбнулитьСтраховуюПремию = Истина;
	Если Подразделение.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя Тогда
		_Подтверждено = Истина;
		Если ОтчетКассира.Подтверждено Тогда
			
			_Агент = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
		Иначе
			ОбнулитьСтраховуюПремию = Ложь;
			_Агент = Автор.ФизЛицо;
			Если ЗначениеЗаполнено(_Агент)= Ложь Тогда
				_Агент = Подразделение.МОЛпоБСО;
			КонецЕсли;	
			Если ЗначениеЗаполнено(_Агент)= Ложь Тогда
				_Подтверждено = Ложь;
				_Агент = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
			КонецЕсли;	
		КонецЕсли;
		
		
	Иначе	
		_Подтверждено = Истина;
		_Агент = ПараметрыСеанса.уб_Константы.уб_ОсновноеПодразделениеПоУчетуБСО;
	КонецЕсли;	
	//---Взаиморасчеты-	
	Для Каждого СтрокаТЧ Из Полисы Цикл
		//Подготовка данных по полису
		ЗаписьРег = уб_СС.ПоследняяЗаписьРегистраДвижений(ГраницаДокумента, СтрокаТЧ.СК, СтрокаТЧ.ВидБСО, СокрЛП(СтрокаТЧ.НомерБСО));
		ТипУчета = Неопределено;
		АгентКол = ПринятоОТ;
		Если ЗаписьРег  = Неопределено Тогда
			ЗаписьРег = Новый Структура("ВидБСО,СК,НомерБСО,ДопНомерБСО,Подтверждено,Поставщик,ОрганизацияАгент,ГодПолиса,ДатаВозврата,СтраховойПолис,СтраховаяПремия",
			СтрокаТЧ.ВидБСО,СтрокаТЧ.СК,СтрокаТЧ.НомерБСО,СтрокаТЧ.ДопНомерБСО,Ложь,СтрокаТЧ.Поставщик,СтрокаТЧ.ОрганизацияАгент,"",Документы.уб_СтраховойПолис.ПустаяСсылка(),0);
			Если уб_СЛ.ОпределитьВедетсяКоличественныйУчет(СтрокаТЧ.ВидБСО,ТипУчета) Тогда
				
				
				ЗапросОст = Новый Запрос;
				ЗапросОст.Текст = "ВЫБРАТЬ
				                  |	ЕСТЬNULL(СУММА(ВЫБОР
				                  |				КОГДА уб_ОстаткиБСО.ВидДвижения = ЗНАЧЕНИЕ(ВидДВиженияНакопления.Приход)
				                  |					ТОГДА уб_ОстаткиБСО.Количество
				                  |				ИНАЧЕ -уб_ОстаткиБСО.Количество
				                  |			КОНЕЦ), 0) КАК Количество,
				                  |	уб_ОстаткиБСО.Агент КАК Агент
				                  |ИЗ
				                  |	РегистрНакопления.уб_ОстаткиБСО КАК уб_ОстаткиБСО
				                  |ГДЕ
				                  |	уб_ОстаткиБСО.Заявка = &Заявка
				                  |	И уб_ОстаткиБСО.ВидБСО = &ВидБСО
				                  |	И уб_ОстаткиБСО.Период < &ДатаДок
				                  |
				                  |СГРУППИРОВАТЬ ПО
				                  |	уб_ОстаткиБСО.Агент";
				ЗапросОст.УстановитьПараметр("Заявка",СтрокаТЧ.Заявка);
				ЗапросОст.УстановитьПараметр("ВидБСО",СтрокаТЧ.ВидБСО);
				ЗапросОст.УстановитьПараметр("ДатаДок",Дата);
				РезОстатки = ЗапросОст.Выполнить().Выгрузить();
				Если  РезОстатки.Итог("Количество")>0 Тогда
					ВидДвижения = "номер,количество";//Количество в плюсе, иначе мы точно не можем потом найти такой полис(например он печатный)
					Для каждого ВыборкаОст из РезОстатки Цикл
						Если ВыборкаОст.Количество>0 Тогда
							АгентКол = ВыборкаОст.Агент;
							Прервать;
						КонецЕсли;	
					КонецЦикла;	
				Иначе
					ВидДвижения = "номер";	
				КонецЕсли;
			ИначеЕсли уб_СЛ.ОпределитьВедетсяНомернойУчет(СтрокаТЧ.ВидБСО,ТипУчета) Тогда
				ВидДвижения = "номер";	
			Иначе
				ВидДвижения = Неопределено;	
			КонецЕсли;
		Иначе
			ВидДвижения = "номер";	
			//ЗаписьРег.Подтверждено = _Подтверждено;
		КонецЕсли;	
		
		//ЗаписьРег.Подтверждено = _Подтверждено;
		
		тДвижений = Новый ТаблицаЗначений;
		тДвижений.Колонки.Добавить("ВидДвижения");
		тДвижений.Колонки.Добавить("ЗаписьРег");
		Если НЕ ВидДвижения = Неопределено Тогда 
			Движение = тДвижений.Добавить();
			Движение.ВидДвижения = ВидДвижения;
			Движение.ЗаписьРег = ЗаписьРег;
		Конецесли;		
		//Подготовка данных по квитанции
		Если ПустаяСтрока(СтрокаТЧ.НомерКвитанции)=Ложь и Не СтрокаТЧ.НомерКвитанции = "б/н" Тогда
			//ВидБСОТипаКвА7 = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СтрокаТЧ.СК);
			СтруктураВидБСО = уб_КЭШируемые.ВидБСОТипаКвА7дляСК(СтрокаТЧ.СК);
			ВидБСОТипаКвА7 = СтруктураВидБСО.ВидБСО;
			ЗаписьРегА7 = уб_СС.ПоследняяЗаписьРегистраДвижений(ГраницаДокумента, СтрокаТЧ.СК, ВидБСОТипаКвА7, СокрЛП(СтрокаТЧ.НомерКвитанции));
			Если ЗаписьРегА7  = Неопределено Тогда
				ЗаписьРегА7 = Новый Структура("ВидБСО,СК,НомерБСО,ДопНомерБСО,Подтверждено,Поставщик,ОрганизацияАгент,ГодПолиса,ДатаВозврата,СтраховойПолис,СтраховаяПремия",
				ВидБСОТипаКвА7,СтрокаТЧ.СК,СтрокаТЧ.НомерКвитанции,СтрокаТЧ.ДопНомерКвитанции,Ложь,СтрокаТЧ.ПоставщикКвитанции,СтрокаТЧ.ОрганизацияАгентКвитанции,"",Документы.уб_СтраховойПолис.ПустаяСсылка(),0);
			КонецЕсли;	
			Движение = тДвижений.Добавить();
			Движение.ВидДвижения = "номер";
			Движение.ЗаписьРег = ЗаписьРегА7;
		КонецЕсли;		
		//Запись движений по строке
		Для каждого ДвижениеВыборка из тДвижений Цикл
			Данные = ДвижениеВыборка.ЗаписьРег;
			Если Найти(ДвижениеВыборка.ВидДвижения,"номер")>0 Тогда
				ДвижениеД = Движения.уб_ДвиженияБСО.Добавить();
				ДвижениеД.Период 	= Дата;
				ДвижениеД.СК 		= Данные.СК;
				ДвижениеД.ВидБСО 	= Данные.ВидБСО;
				ДвижениеД.НомерБСО 	= Данные.НомерБСО;
				ДвижениеД.ДопНомерБСО 	= Данные.ДопНомерБСО;
				ДвижениеД.Поставщик 		= СтрокаТЧ.Поставщик;
				ДвижениеД.ОрганизацияАгент 		= СтрокаТЧ.ОрганизацияАгент;
				//ДвижениеД.Поставщик 		= Данные.Поставщик;
				//ДвижениеД.ОрганизацияАгент 	= Данные.ОрганизацияАгент;
				ДвижениеД.Подтверждено 		= _Подтверждено;//Данные.Подтверждено;
				ДвижениеД.ГодПолиса 		= Данные.ГодПолиса;
				ДвижениеД.СтраховойПолис 	= Данные.СтраховойПолис;
				ДвижениеД.ДатаВозврата 		= Данные.ДатаВозврата;
				ДвижениеД.Активность 		= Проведен;
				ДвижениеД.АгентОтправитель 	= ПринятоОТ;
				ДвижениеД.Агент 			= _Агент;
				ДвижениеД.ПоложениеБСО 		= Перечисления.уб_ПоложенияБСО.ВозвращенСТочки;			
				ДвижениеД.СостояниеБСО 		= Перечисления.уб_СостоянияБСО.Оформлен;
				ДвижениеД.НомерПолиса 		= СтрокаТЧ.НомерПолиса;
				ДвижениеД.НаОснованииБумажногоДокумента = Ложь;
				ДвижениеД.Комментарий 		= Комментарий;
				ДвижениеД.КодОперации 		= Перечисления.уб_КодыОперацийБСО.ПриемОплаты;
				ДвижениеД.Заявка            = СтрокаТЧ.Заявка;
				Если ОбнулитьСтраховуюПремию = Ложь Тогда
					Попытка
						ДвижениеД.СтраховаяПремия = Данные.СтраховаяПремия;
					Исключение
					КонецПопытки;	
				КонецЕсли;	
			КонецЕсли;			
			Если Найти(ДвижениеВыборка.ВидДвижения,"количество")>0 Тогда
				Движение					= Движения.уб_ОстаткиБСО.Добавить();
				Движение.ВидДвижения		= ВидДвиженияНакопления.Расход;
				Движение.Период				= Дата;
				// измерения
				Движение.Поставщик			= Данные.Поставщик;
				Движение.ОрганизацияАгент 	= Данные.ОрганизацияАгент;
				Движение.СК					= Данные.СК;
				Движение.ВидБСО				= Данные.ВидБСО;
				Движение.Агент				= АгентКол;	
				// ресурсы
				Движение.Количество			= 1;
				// реквизиты
				Движение.КодОперации		= Перечисления.уб_КодыОперацийБСО.ОформлениеБСО;
				Движение.Заявка             = СтрокаТЧ.Заявка;
			КонецЕсли; 
		КонецЦикла;//тДвижений		
		//Продолжить;
		//+++Взаиморасчеты по Группе полисов
		СтруктураПараметров = Новый Структура("Дата,Агент,Страхователь,Поставщик,ОрганизацияАгент",Дата,Справочники.ФизическиеЛица.ПустойАгент,Справочники.ФизическиеЛица.ПустаяСсылка(),Строкатч.Поставщик,СтрокаТЧ.ОрганизацияАгент,Дата);
		уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета(
			СтрокаТЧ.УИДСтроки,
			ВидОперации,
