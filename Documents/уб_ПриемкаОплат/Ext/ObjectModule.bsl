// если форма оплаты одна для всей ТЧ Платежи, вернет ее, иначе пустую ссылку перечисления
Функция ФормаОплаты(ЗаполнитьПоУмолчаниюЕслиПустая = Истина) Экспорт

	Если СистемаТЧПлатежи Тогда
		_ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка();
		
		ФормаОплатыПоУмолчанию = Перечисления.уб_ФормыОплаты.Касса;
		
		Для Каждого СтрокаТЧ Из Платежи Цикл
			Если СтрокаТЧ.НомерСтроки = 1 И Не СтрокаТЧ.ФормаОплаты.Пустая() Тогда
				ФормаОплатыПоУмолчанию = СтрокаТЧ.ФормаОплаты;
			КонецЕсли;
			Если _ФормаОплаты.Пустая() Тогда
				_ФормаОплаты = СтрокаТЧ.ФормаОплаты
			ИначеЕсли СтрокаТЧ.ФормаОплаты <> _ФормаОплаты Тогда
				_ФормаОплаты = Перечисления.уб_ФормыОплаты.ПустаяСсылка();
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗаполнитьПоУмолчаниюЕслиПустая И _ФормаОплаты.Пустая() Тогда
			_ФормаОплаты = ФормаОплатыПоУмолчанию;
		КонецЕсли;
	Иначе
		_ФормаОплаты = ФормаОплаты;
	КонецЕсли;
	Возврат _ФормаОплаты;

КонецФункции // ФормаОплаты()

Функция СоздатьКвитовку(ОплатаСсылка, УИДСтрокиТЧ) Экспорт
	
	НачатьТранзакцию();
	Результат =  уб_СС.ДобавитьКвитовкуОплат(УИДСтрокиТЧ, ?(ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка), ОплатаСсылка, ЭтотОбъект);	
	Если Результат Тогда
		ЗафиксироватьТранзакцию();
		УстановитьФлагКвитовки();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;	
	Возврат Результат
	
КонецФункции	

//СЕРВИСНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
Функция ПолучитьДанныеОплатыИПолиса(Оплата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Оплата",Оплата);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Оплата.Ссылка,
	|	Оплата.СтраховойПолис КАК СтраховойПолис,
	|	Оплата.СтраховойПолис.СтраховойПродукт КАК СтраховойПродукт,
	|	Оплата.СтраховойПолис.Агент КАК Агент,
	|	Оплата.СтраховойПолис.НомерЗаявки КАК НомерЗаявки,
	|	Оплата.СтраховойПолис.Дата КАК ДатаОформления,
	|	Оплата.СтраховойПолис.ДатаВыдачи КАК ДатаВыдачи,
	|	Оплата.СтраховойПолис.ДатаНачала КАК ДатаНачала,
	|	Оплата.СтраховойПолис.ДатаОкончания КАК ДатаОкончания,
	|	Оплата.СтраховойПолис.Страхователь КАК Страхователь,
	|	Оплата.СтраховойПолис.Курьер КАК Курьер,
	|	Оплата.СтраховойПолис.Аддендум КАК Аддендум,
	|	Оплата.Дата КАК ДатаОплаты,
	|	Оплата.НачисленнаяСуммаВзносаВВалюте,
	|	Оплата.НачисленнаяСуммаВзноса,
	|	Оплата.СкидкаВыплаченаяКлиенту,
	|	Оплата.НомерВзноса
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &Оплата";
	Выборка =  Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	Иначе
		Возврат Новый Структура("СтраховойПолис,СтраховойПродукт,Агент,НомерЗаявки,ДатаОформления,ДатаНачала,
		|ДатаОкончания,Страхователь,Курьер,ДатаОплаты,НачисленнаяСуммаВзносаВВалюте,НачисленнаяСуммаВзноса,
		|СкидкаВыплаченаяКлиенту,НомерВзноса,Аддендум",
		Документы.уб_СтраховойПолис.ПустаяСсылка(),
		Справочники.уб_СтраховыеПродукты.ПустаяСсылка(),
		Справочники.ФизическиеЛица.ПустаяСсылка(),
		0,
		Дата(1,1,1),
		Дата(1,1,1),
		Дата(1,1,1),
		Справочники.ФизическиеЛица.ПустаяСсылка(),
		Справочники.ФизическиеЛица.ПустаяСсылка(),
		Дата(1,1,1),
		0,
		0,
		0,
		1,ЛОЖЬ);
	КонецЕсли;
	
КонецФункции

Функция УстЗнач(ПолеДанных, НовоеЗначение, ИгнорироватьПроведение = Ложь) Экспорт
	
	Если (НЕ Проведен ИЛИ ИгнорироватьПроведение) Тогда
		Возврат УстановитьЗначение(ПолеДанных, НовоеЗначение); 
	КонецЕсли;
	
КонецФункции

// возвращает заявки, указанные в ТЧ Полисы (либо все, либо с оплатой за выезд клиентом)
Функция ПолисыМассивЗаявок(ТолькоСОплатойЗаВыездКлиентом = Ложь, КакСЗ = Ложь) Экспорт

	МассивЗаявок = Новый Массив;
	Для Каждого СтрокаТЧ Из Полисы Цикл
		Если Не СтрокаТЧ.Заявка.Пустая() И МассивЗаявок.Найти(СтрокаТЧ.Заявка) = Неопределено Тогда
			МассивЗаявок.Добавить(СтрокаТЧ.Заявка);
		КонецЕсли;
	КонецЦикла;
	Если ТолькоСОплатойЗаВыездКлиентом Тогда
		Если МассивЗаявок.Количество() > 0 Тогда
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	З.Ссылка
			|ИЗ
			|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК З
			|ГДЕ
			|	З.ИсточникФинансирования = ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Клиент)
			|	И З.Ссылка В (&МассивЗаявок)");
			Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				МассивЗаявок = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если КакСЗ Тогда
		СЗ = Новый СписокЗначений;
		СЗ.ЗагрузитьЗначения(МассивЗаявок);
		Результат = СЗ;
	Иначе
		Результат = МассивЗаявок;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ПолисыМассивЗаявок()

Функция СуммаНераспределенныхСтрок() Экспорт

	Итог = 0;
	Для Каждого СтрокаТЧ Из Платежи Цикл
		Если СтрокаТЧ.ОбоснованиеРазницы = "<нераспределено>" Тогда
			Итог = Итог + СтрокаТЧ.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции // СуммаНераспределенныхСтрок()

Функция ПолучитьСтрокуВыездаПоВидуБСО(_ВидБСО,_Заявка,_сумма,СуммаСкидки =0) Экспорт
	//	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаНаВыезд.УидСтроки,
	               |	ЗаявкаНаВыезд.ИтогПредоставленнаяСкидка
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК ЗаявкаНаВыезд
	               |ГДЕ
	               |	ЗаявкаНаВыезд.ВидБСО = &ВидБСО
	               |	И ЗаявкаНаВыезд.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("ВидБСО",_ВидБСО);  
	Запрос.УстановитьПараметр("Ссылка",_Заявка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Если Выборка.СуммаВзноса = _сумма Тогда
				СуммаСкидки = Выборка.ИтогПредоставленнаяСкидка;
				Возврат Выборка.УидСтроки;
			КонецЕсли;	
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЦикла;
	
	Выборка.Сбросить();
	Если  Выборка.Следующий() Тогда
		Возврат Выборка.УидСтроки;
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции




