	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	П.Заявка,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	П.Заявка.Номер,
	               |	П.Проведен,
	               |	ИСТИНА
	               |ИЗ
	               |	Документ.уб_ПриемкаОплат КАК П
	               |ГДЕ
	               |	П.Ссылка = &Ссылка
	               |	И П.Заявка <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СЗ.Статус КАК Статус,
	               |	ВТЗаявок.Заявка КАК Заявка,
	               |	ВТЗаявок.СК,
	               |	ВТЗаявок.ВидБСО,
	               |	ВТЗаявок.НомерБСО,
	               |	ВТЗаявок.ЗаявкаНомер КАК ЗаявкаНомер,
	               |	ВТЗаявок.Проведен КАК Проведен,
	               |	ВТЗаявок.Принудительно КАК Принудительно, ВТЗаявок.Заявка.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику) КАК Поставщику
	               |ИЗ
	               |	ВТЗаявок КАК ВТЗаявок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК СЗ
	               |		ПО ВТЗаявок.Заявка = СЗ.Заявка
	               |ГДЕ
	               |	(ВТЗаявок.Проведен
	               |			ИЛИ НЕ ВТЗаявок.Проведен)
	               |	И ВЫБОР
	               |			КОГДА ВТЗаявок.Заявка.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Поставщику)
	               |					И НЕ СЗ.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ДеньгиВКомпании)
	               |				ТОГДА ИСТИНА
	               |			КОГДА СЗ.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.КомплектИДеньгиУКассира)
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |ИТОГИ
	               |	МИНИМУМ(Статус),
	               |	МИНИМУМ(ЗаявкаНомер),
	               |	МИНИМУМ(Проведен),
	               |	МАКСИМУМ(Принудительно)
	               |ПО
	               |	Заявка";
	//Запрос = Новый Запрос(
	//"ВЫБРАТЬ
	//|	ПОП.Заявка,
	//|	ПОП.СК,
	//|	ПОП.ВидБСО,
	//|	ПОП.НомерБСО,
	//|	ПОП.Заявка.Номер,
	//|	ПОП.Ссылка.Проведен КАК Провуеден,
	//|	ЛОЖЬ КАК Принудительно
	//|ПОМЕСТИТЬ ВТЗаявок
	//|ИЗ
	//|	Документ.уб_ПриемкаОплат.Полисы КАК ПОП
	//|ГДЕ
	//|	ПОП.Ссылка = &Ссылка
	//|	И ПОП.Заявка <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	П.Заявка,
	//|	NULL,
	//|	NULL,
	//|	NULL,
	//|	П.Заявка.Номер,
	//|	П.Проведен,
	//|	ИСТИНА
	//|ИЗ
	//|	Документ.уб_ПриемкаОплат КАК П
	//|ГДЕ
	//|	П.Ссылка = &Ссылка
	//|	И П.Заявка <> ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	СЗ.Статус КАК Статус,
	//|	ВТЗаявок.Заявка КАК Заявка,
	//|	ВТЗаявок.СК,
	//|	ВТЗаявок.ВидБСО,
	//|	ВТЗаявок.НомерБСО,
	//|	ВТЗаявок.ЗаявкаНомер КАК ЗаявкаНомер,
	//|	ВТЗаявок.Проведен КАК Проведен,
	//|	ВТЗаявок.Принудительно КАК Принудительно
	//|ИЗ
	//|	ВТЗаявок КАК ВТЗаявок
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК СЗ
	//|		ПО ВТЗаявок.Заявка = СЗ.Заявка
