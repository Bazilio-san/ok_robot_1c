
Функция ДайТзОплатПоУИДСтроки(УИДСтроки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.ОплатаПолиса,
	|	К.ОплатаПолиса.ОплаченоФакт КАК КОплате,
	|	К.ОплатаПолиса.ФормаОплаты КАК ФормаОплаты,
	|	К.ОплатаПолиса.НомерКвитанции КАК НомерКвитанции,
	|	К.ОплатаПолиса.Номер КАК НомерОплаты,
	|	К.ОплатаПолиса.Дата КАК ДатаОплаты,
	|	К.ОплатаПолиса.ОтчетПоставщику КАК ОтчетПоставщику,
	|	К.ОплатаПолиса.ИсключитьИзРасчетаЗП КАК ИсключитьИзРасчетаЗП,
	|	К.ОплатаПолиса.НеВключатьВОтчетыПоставщикам КАК НеВключатьВОтчетыПоставщикам,
	|	К.ОплатаПолиса.ДатаПроведенияБСО КАК ДатаПроведенияБСО
	|ИЗ
	|	РегистрСведений.уб_КвитовкаОплат КАК К
	|ГДЕ
	|	К.УИДСтрокиТЧ = &УИДСтрокиТЧ";
	Запрос.УстановитьПараметр("УИДСтрокиТЧ", УИДСтроки);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


//Получает первую оплату с совпадающей квитанцией (либо первую, если такой нет) из квитовки оплат, если она есть
Функция ПолучитьОплатуПолисаДляОтчетаАгента(УИДСтроки, НомерКвитанции, тзОплат = Неопределено) Экспорт
	
	Если тзОплат = Неопределено Тогда
		тзОплат = ДайТзОплатПоУИДСтроки(УИДСтроки);
	КонецЕсли;
	ВсегоОплат = тзОплат.Количество();
	Если ВсегоОплат > 0 Тогда
		//Берем либо единственную привязанную оплату, либо, если их несколько, ту, в которой номер квитанции совпадает
		ОплатаПолисаДляОтчетаАгента = тзОплат[0].ОплатаПолиса;
		Если ВсегоОплат > 1 Тогда 
			Для Каждого Оплата из тзОплат Цикл
				Если СокрЛП(Оплата.НомерКвитанции) = СокрЛП(НомерКвитанции) Тогда
					ОплатаПолисаДляОтчетаАгента = Оплата.ОплатаПолиса;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ОплатаПолисаДляОтчетаАгента = Документы.уб_ОплатаПолисов.ПустаяСсылка(); 	
	КонецЕсли;
	Возврат ОплатаПолисаДляОтчетаАгента;
	
КонецФункции

Функция ФормаОплатыКартинка(ФормаОплаты) Экспорт

	Пер = Перечисления.уб_ФормыОплаты;
	Если ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Тогда
		Иконка = БиблиотекаКартинок.уб_Оплата
	ИначеЕсли ФормаОплаты = Пер.Безнал Тогда
		Иконка = БиблиотекаКартинок.уб_НаправлениеПлатежаЛевоЗел
	Иначе
		//поставщику
		Иконка = БиблиотекаКартинок.уб_НаправлениеПлатежаПравоРозовый
	КонецЕсли;
	Возврат Иконка;

КонецФункции // ФормаОплатыКартинка()

Процедура ДвижениеСтатусовЗаявок(Ссылка, ЭтоЗагрузка = ЛОЖЬ) Экспорт
	
