Функция ВознаграждениеКурьераКлиентом(_Заявка = Неопределено,Ссылка)  Экспорт
	
	Если _Заявка = Неопределено Тогда
		_Заявка = уб_temp.ДокументОснованиеПоТипуРекурсивно(Ссылка, Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста"))
	КонецЕсли;
	Результат = 0;
	Если _Заявка <> Неопределено Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	З.ВознаграждениеКурьера
		|ИЗ
		|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК З
		|ГДЕ
		|	З.Ссылка = &Ссылка
		|	И З.ИсточникФинансирования = ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Клиент)");
		Запрос.УстановитьПараметр("Ссылка", _Заявка);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Результат = Выборка.ВознаграждениеКурьера;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // ВознаграждениеКурьераКлиентом()


