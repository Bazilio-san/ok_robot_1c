	//TODO!!! В запросе получать, также данные по квитанциям
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	СписокОбработанныхЗаявок = Новый СписокЗначений;
	Роль = уб_УСЗ.ПолучитьРольПользователяДляЗаявок();
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		Если Выборка.Проведен Тогда
			ЕстьДанныеТЗ = Ложь;
			//TODO убрать ПолучитьТаблицуБСОПоЗаявке, добавить соединение в запрос
			//Если текущая заявка в приемке совпадает с заявкой в регистре Движений БСО,
			//то двигать статус, количественные не расматривать
			//
			//требуется получить только по данной заявке, но со всеми положениями,
			//но также сразу нужно определить флаг требуется ли возврат БСО, чтобы не повторять в будущем этот запрос
			//ТаблицаБСО = уб_УСЗ.ПолучитьТаблицуБСОПоЗаявке(Выборка.Заявка, Ложь, Истина);
			//ТребуетсяВозвратБСО = Ложь;
			УстСтатус = "";
