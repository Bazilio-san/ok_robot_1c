				//TODO добавить эту заявку в уб_УСЗ.ТребуетсяВозвратБСОПоСсылке (потребуется добавить частное объединение в запрос)
				ТребуетсяВозвратБСО = Неопределено
			Иначе
				ТребуетсяВозвратБСО = СтрокаТЗ.ТребуетсяВозвратБСО;
				СтрокаТЗ.Обработано = Истина;
			КонецЕсли;
			Если уб_УСЗ.ВыполнитьДействиеПоЗаявке(
				Выборка.Заявка, 
				Выборка.Статус,
				УстСтатус,
				,
				Роль,
				, //ТекстКоманды
				ТребуетсяВозвратБСО
				)
				Тогда
				СписокОбработанныхЗаявок.Добавить(Выборка.ЗаявкаНомер)
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//проверяем оставшиеся заявки
	МассивСтрокТЗ = ТЗТребуетсяВозвратБСО.НайтиСтроки(Новый Структура("Обработано", Ложь));
	Для Каждого СтрокаТЗ Из МассивСтрокТЗ Цикл
		Если уб_УСЗ.ВыполнитьДействиеПоЗаявке(
			СтрокаТЗ.Заявка,
			,
			"ПроверитьБСО",
			,
			Роль,
			,
			СтрокаТЗ.ТребуетсяВозвратБСО
			) 
			Тогда
			СписокОбработанныхЗаявок.Добавить(СтрокаТЗ.Заявка);
		КонецЕсли;
	КонецЦикла;
	#Если Клиент Тогда
		Если СписокОбработанныхЗаявок.Количество() > 0 Тогда
			Оповестить("уб_СтатусыЗаявокОбновитьСписки", СписокОбработанныхЗаявок, "Документ.уб_ПриемкаОплат")
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

