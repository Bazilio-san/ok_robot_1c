Функция ЗаявкиБезПриемок(_ПринятоОт,КакТз = ЛОЖЬ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Кошелек
	               |ПОМЕСТИТЬ Заявки
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Кошелек.Сотрудник = &Сотрудник
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Кошелек
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ФормаОплатыСтрока = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.НаКарту)
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Кошелек.Сотрудник = &Сотрудник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |    Ложь как Выбран,
	               |	Заявки.Ссылка.Номер КАК Номер,
				   |	Заявки.Кошелек,
	               |	Заявки.Ссылка,
	               |	ПРЕДСТАВЛЕНИЕ(Заявки.Ссылка.Страхователь) КАК Страхователь,
				   |    Заявки.Ссылка.ИтогСуммаВзноса-Заявки.Ссылка.ИтогПредоставленнаяСкидка как кОплате,
	               |	Заявки.Ссылка.ИтогСуммаВзноса КАК ИтогСуммаВзноса,
	               |	Заявки.Ссылка.ИтогПредоставленнаяСкидка КАК ИтогПредоставленнаяСкидка,
	               |	уб_ИсторияСтатусовЗаявокСрезПоследних.Статус
	               
	               |ИЗ
	               |	Заявки КАК Заявки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Полисы КАК Полисы
	               |		ПО (Полисы.Заявка = Заявки.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
	               |		ПО Заявки.Ссылка = уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка
	               |ГДЕ
	               |	Полисы.Ссылка ЕСТЬ NULL
	               |	И НЕ уб_ИсторияСтатусовЗаявокСрезПоследних.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗапросНаУдаление), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗаявкаОтработана), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.Удалена), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Заявки.Ссылка.Номер";
	Запрос.УстановитьПараметр("Сотрудник",_ПринятоОт);
	Если КакТз = Истина Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	Иначе
		СписокЗначений = Новый СписокЗначений;
		Выборка= Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокЗначений.Добавить(Выборка.Ссылка,""+Выборка.номер +" от "+Выборка.Страхователь+" ("+Формат(Выборка.ИтогСуммаВзноса-Выборка.ИтогПредоставленнаяСкидка,"ЧДЦ=2; ЧГ=")+")");
		КонецЦикла;	
		Возврат СписокЗначений;
	КонецЕсли;
КонецФункции	
