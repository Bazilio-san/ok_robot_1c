								//Иначе
								УстСтатус = "УстановитьСтатус_КомплектИДеньгиУКассира";
								//КонецЕсли;	
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Иначе
			//УстСтатус = "УстановитьСтатус_СтраховкаСостоялась"
		КонецЕсли;
