// Процедура - обработчик отмены проведения, удаляет движения документа
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Движения.уб_ДатыРасчетовССотрудниками.Прочитать();
	
	ТаблицаДвиженийДоУдаления = Движения.уб_ДатыРасчетовССотрудниками.Выгрузить();
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект,Отказ);
	
	//2024.02.19 отказываемся от схлапывания движений, 
	//документы редко удаляют, но могут временно снять с проведения задним числом,
	//а это вызывает разрыв расчетных листков
	//проблема может быть только, если во время снятия с проведения, будет произведено начисление ЗП, 
	//но при кратковременном такого не будет
	возврат;
	Для каждого СтрокаДвижения из ТаблицаДвиженийДоУдаления Цикл
		//
		
		Сотрудник = СтрокаДвижения.ФизическоеЛицо;
		ТекущаяДатаФиксации = СтрокаДвижения.Дата;
		ТЗ = РегистрыСведений.уб_ДатыРасчетовССотрудниками.СрезПоследних(ТекущаяДатаФиксации-1,Новый Структура("ФизическоеЛицо", Сотрудник));
		Если  ТЗ.Количество()>0 Тогда
			ПредДатаФиксации = ТЗ[0].Дата;
		Иначе
			ПредДатаФиксации = Дата(1,1,1,1,1,1);
		КонецЕсли;
		
		ТЗ = РегистрыСведений.уб_ДатыРасчетовССотрудниками.СрезПервых(ТекущаяДатаФиксации+1,Новый Структура("ФизическоеЛицо", Сотрудник));
		Если  ТЗ.Количество()>0 Тогда
			СледДатаФиксации = ТЗ[0].Дата;
		Иначе
			СледДатаФиксации = Дата(1,1,1,1,1,1);
		КонецЕсли;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	уб_РасчетыСФЛПоЗП.Регистратор
		                      |ИЗ
		                      |	РегистрНакопления.уб_РасчетыСФЛПоЗП КАК уб_РасчетыСФЛПоЗП
		                      |ГДЕ
		                      |	уб_РасчетыСФЛПоЗП.Активность
		                      |	И уб_РасчетыСФЛПоЗП.ФизическоеЛицо = &ФизическоеЛицо
		                      |	И уб_РасчетыСФЛПоЗП.Период > &ПредДатаФиксации
		                      |	И 1 = 1
		                      |	И (НЕ уб_РасчетыСФЛПоЗП.Раздел = 21)");
		Если НЕ СледДатаФиксации = Дата(1,1,1,1,1,1) Тогда
			//
			Запрос.УстановитьПараметр("СледДатаФиксации",СледДатаФиксации);
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"1 = 1","уб_РасчетыСФЛПоЗП.Период < &СледДатаФиксации");
		КонецЕсли;	  
		Запрос.УстановитьПараметр("ФизическоеЛицо",Сотрудник);
		Запрос.УстановитьПараметр("ПредДатаФиксации",ПредДатаФиксации);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			//
			Об = Выборка.Регистратор.ПолучитьОбъект();
			Дата0 = НачалоМесяца(Об.Дата);
			ЗаменитьПериодыВТЧ (Об.Начисления,Дата0,Сотрудник,ПредДатаФиксации,СледДатаФиксации,"Период","Сотрудник");
			ЗаменитьПериодыВТЧ (Об.ВознаграждениеЗаПродажи,Дата0,Сотрудник,ПредДатаФиксации,СледДатаФиксации,"Период","Сотрудник");
			ЗаменитьПериодыВТЧ (Об.ВознаграждениеКурьеров,Дата0,Сотрудник,ПредДатаФиксации,СледДатаФиксации,"Период","Сотрудник");
			ЗаменитьПериодыВТЧ (Об.ВознаграждениеКурьеров,Дата0,Сотрудник,ПредДатаФиксации,СледДатаФиксации,"ПериодДляИсточника","ИсточникФинансирования");
			ЗаменитьПериодыВТЧ (Об.НачисленияРазовые,Дата0,Сотрудник,ПредДатаФиксации,СледДатаФиксации,"Период","Сотрудник");
			Об.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;	
	КонецЦикла;	
	
	уб_ОбменДанными.ВыполнитьСинхронизацию(Ссылка);
КонецПроцедуры

Процедура ЗаменитьПериодыВТЧ (ТЧ,РасчетныйПериод,ФЛ,ПредДатаФиксации,СледДатаФиксации,ПолеПериода,ПолеСотрудника)
	//
	МассивСтрокпоФЛ = ТЧ.НайтиСтроки(Новый Структура(ПолеСотрудника,ФЛ));
	ВсегоСтрокПоФл = МассивСтрокпоФЛ.Количество();
	ФлПроверятьКонДату = НЕ СледДатаФиксации=Дата(1,1,1,1,1,1);
	КоличествоПравок = 0;
	Для СчетчикСтрок = 0 по ВсегоСтрокПоФл-1 Цикл
		//
		ТекСтрока = МассивСтрокпоФЛ[СчетчикСтрок];
		Если ТекСтрока[ПолеПериода]>ПредДатаФиксации Тогда
			Если ФлПроверятьКонДату Тогда
				Если ТекСтрока[ПолеПериода]>=СледДатаФиксации Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			
			НовыйПериод = Макс(РасчетныйПериод,ПредДатаФиксации+1);
			Если НовыйПериод=ТекСтрока[ПолеПериода] Тогда
			Иначе
				ТекСтрока[ПолеПериода]  = НовыйПериод;
				КоличествоПравок=КоличествоПравок+1;
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

