
// Процедура выполняет движения по регистрам при проведении
Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.уб_ДатыРасчетовССотрудниками.Прочитать();
	ТаблицаДвиженийДоПроведения = Движения.уб_ДатыРасчетовССотрудниками.Выгрузить();
	
	ОбщегоНазначения.УдалитьДвиженияДокумента(Движения);	
	//Выплата з/п
	ВО = Перечисления.уб_ВидОперацииВыплатыЗП;
	Если ВидОперации = ВО.Зарплата  Тогда
		Описание = "Выплата заработной платы";
	ИначеЕсли ВидОперации = ВО.Аванс  Тогда	
		Описание = "Выплата аванса";
	ИначеЕсли ВидОперации = ВО.Остаток  Тогда	
		Описание = "Начальный остаток или корректировка задолженности";	
	ИначеЕсли ВидОперации = ВО.Отпускные  Тогда	
		Описание = "Выплата отпускных";
	ИначеЕсли ВидОперации = ВО.Займ  Тогда		
		Описание = "Выдан займ"
	ИначеЕсли ВидОперации  = ВО.СписаниеЗадолженности Тогда	
		Описание = "Списан долг без выплаты";
	КонецЕсли;	
	
	Для Каждого ТекСтрокаВедомости Из Ведомость Цикл
		// регистр уб_РасчетыСФЛПоЗП Приход
		Если ТекСтрокаВедомости.Выплачено Тогда
			
			//Если ВидОперации = ВО.Зарплата Тогда
			//	Дата2 = Дата;
			//	Показатели = Документы.уб_ЖурналУспеваемостиСотрудников.ПоказательУспеваемостиСотрудника(ТекСтрокаВедомости.Сотрудник,Дата2);
			//	Если Показатели.СредБаллМесяц<72.5 и Показатели.ТочкаПродаж = Истина и Показатели.ЭтоРуководитель = Ложь Тогда
			//		Сообщить("Средний балл у "+ТекСтрокаВедомости.Сотрудник+ " ниже 72.5 баллов ("+Показатели.СредБаллМесяц+")",СтатусСообщения.Информация);
			//		Если Дата >=Дата(2017,4,19) Тогда
			//			Отказ = Истина;
			//		КонецЕсли;	
			//	КонецЕсли;
			//	
			//КонецЕсли;
			ДатаДвижения = ?(ТекСтрокаВедомости.ДатаВыплаты = Дата(1,1,1),Дата,ТекСтрокаВедомости.ДатаВыплаты);
			
			Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
			Движение.ВидДвижения    = ВидДвиженияНакопления.Расход;
			Движение.Период         = ДатаДвижения;
			Движение.Организация    = Организация;
			Движение.ФизическоеЛицо = ТекСтрокаВедомости.Сотрудник;
			Движение.Сумма          = ТекСтрокаВедомости.Результат;
			//Движение.РасчетныйПериод = РасчетныйПериод;
			//	Движение.ПериодРегистрации = Дата;
			
			Движение.Описание       = Описание;
			Движение.Раздел         = 21;
			
			//Меняем последнюю дату расчетов с сотрудниками
			Если НЕ (ВидОперации = ВО.Аванс ИЛИ ВидОперации = ВО.Отпускные ИЛИ ВидОперации = ВО.Займ) Тогда
				
				СтрокаДоПроведения =  ТаблицаДвиженийДоПроведения.Найти(ТекСтрокаВедомости.Сотрудник,"ФизическоеЛицо");
				Если СтрокаДоПроведения = Неопределено Тогда
					//Это не перепроведение
					//Получаем текущую дату фиксации по сотруднику и сравниваем с датой
					ТЗ = РегистрыСведений.уб_ДатыРасчетовССотрудниками.СрезПоследних(,Новый Структура("ФизическоеЛицо", ТекСтрокаВедомости.Сотрудник));
					Если  ТЗ.Количество()>0 Тогда
						ДатаФиксации = ТЗ[0].Дата;
					Иначе
						ДатаФиксации = Дата(1,1,1,1,1,1);
					КонецЕсли;
					Если ДатаФиксации>ДатаДвижения Тогда
						//Будет авансом поскольку нельзя задним числом вносить выплату с фиксацией
						Движение.Описание = "Выплата аванса";
						Если Ведомость.Количество()=1 Тогда
							ВидОперации = ВО.Аванс;
						КонецЕсли;	
					Иначе
						Движение = Движения.уб_ДатыРасчетовССотрудниками.Добавить();
						Движение.Дата           = ДатаДвижения;
						Движение.Период         = ДатаДвижения;
						Движение.Регистратор    = Ссылка;
						Движение.ФизическоеЛицо = ТекСтрокаВедомости.Сотрудник;	
					КонецЕсли;	
				Иначе
					//!!!При смене даты, одновременно с перепроведение возможны проблемы
					Движение = Движения.уб_ДатыРасчетовССотрудниками.Добавить();
					Движение.Дата           = ДатаДвижения;
					Движение.Период         = ДатаДвижения;
					Движение.Регистратор    = Ссылка;
					Движение.ФизическоеЛицо = ТекСтрокаВедомости.Сотрудник;		
				Конецесли;
			КонецЕсли;	
			
		КонецЕсли;
	КонецЦикла;
	
	уб_ОбменДанными.ВыполнитьСинхронизацию(Ссылка);
	
КонецПроцедуры

// Процедура - обработчик ПередЗаписью документа, отмечает факт модификации
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	КодПользователя = СокрЛП(ПараметрыСеанса.ТекущийПользователь.Код);
	Если (Дата<НачалоДня(ТекущаяДата()) ИЛИ (НЕ ЭтоНовый() И Ссылка.Дата<НачалоДня(ТекущаяДата()))) и НЕ уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ВыплатаЗПНеоперативноеПроведение, Ложь) Тогда //TO DO Сделать отдельную роль для правки выплат задним числом
		#Если Клиент Тогда
		Предупреждение("Документ можно править только в течении дня!");
		#КонецЕсли
		Отказ = Истина;
	Иначе
		//Проверка
		ВО = Перечисления.уб_ВидОперацииВыплатыЗП;
		Для Каждого ТекСтрокаВедомости Из Ведомость Цикл
			// регистр уб_РасчетыСФЛПоЗП Приход
			Если ТекСтрокаВедомости.Выплачено Тогда
				Если ПустаяСтрока(ТекСтрокаВедомости.УИДСтроки) Тогда
					ТекСтрокаВедомости.УИДСтроки = Новый УникальныйИдентификатор;
				КонецЕсли;	
				Если ТекСтрокаВедомости.ДатаВыплаты = Дата(1,1,1) Тогда
					ТекСтрокаВедомости.ДатаВыплаты = Дата;
				КонецЕсли;	
				Если ВидОперации = ВО.Зарплата Тогда
					Дата2 = Дата;
					Попытка
						//Показатели = Документы.уб_ЖурналУспеваемостиСотрудников.ПоказательУспеваемостиСотрудника(ТекСтрокаВедомости.Сотрудник,Дата2);
						//Если Показатели.СредБаллМесяц<72.5 и Показатели.ТочкаПродаж = Истина и Показатели.ЭтоРуководитель = Ложь Тогда
						//	Сообщить("Средний балл у "+ТекСтрокаВедомости.Сотрудник+ " ниже 72.5 баллов ("+Показатели.СредБаллМесяц+")",СтатусСообщения.Информация);
						//	//Если Дата >=Дата(2017,4,19) Тогда
						//	//	Отказ = Истина;
						//	//КонецЕсли;	
						//КонецЕсли;
					Исключение
					КонецПопытки;
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	//Обновление представление списка входящих
	УстановитьЗначение(КраткийСоставДокумента, уб_Temp.ЗаполнитьКраткийСоставДокумента(Ведомость,, "Сотрудник"));
	
	//Обновление итогов выплаты
	УстановитьЗначение(ИтогоВыплачено,Ведомость.Выгрузить(Новый Структура("Выплачено", Истина), "Результат").Итог("Результат"));
	
	
КонецПроцедуры

