	//СтруктураПараметров.Вставить("ИмяКолонкиВТЧТипСписания", Неопределено);
	//СтруктураПараметров.Вставить("НаОсновеБумажногоДокумента", НаОсновеБумажногоДокумента);
	СтруктураПараметров.Вставить("СделатьДвиженияПоКоличественнымБСО", Истина);
	СтруктураПараметров.Вставить("ВидДвиженияНакопленияОстаткиБСО", ВидДвиженияНакопления.Расход);
	СтруктураПараметров.Вставить("ПоставщикВТЧДокумента", Ложь);
	СтруктураПараметров.Вставить("ОрганизацияАгентВТЧДокумента", Ложь);
	СтруктураПараметров.Вставить("Поставщик", Поставщик);
	СтруктураПараметров.Вставить("ОрганизацияАгент", ОрганизацияАгент);
	СтруктураПараметров.Вставить("ПоложениеПоУмолчанию ", Перечисления.уб_ПоложенияБСО.ПереданВСК);
	//СтруктураПараметров.Вставить("ПроверкаПоложения", Истина);
	//СтруктураПараметров.Вставить("СКВТЧДокумента", Истина);
	//СтруктураПараметров.Вставить("СК", Неопределено);
	//СтруктураПараметров.Вставить("СделатьДвиженияПоБлокировкамБСО", Ложь);
	СтруктураПараметров.Вставить("ИмяКолонкиСостояниеБСО", "СостояниеБСО");
	
	ДвиженияПоРегиструДвиженияБСО(Отказ, Заголовок, ЭтотОбъект, СтруктураПараметров);
	
КонецПроцедуры

