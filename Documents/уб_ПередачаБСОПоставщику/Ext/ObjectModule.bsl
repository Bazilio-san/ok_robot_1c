	СтруктураПараметров = Новый Структура;
	//СтруктураПараметров.Вставить("Дата", Дата);
	//СтруктураПараметров.Вставить("ДатаСреза", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	//СтруктураПараметров.Вставить("АгентВТЧДокумента", Ложь);
	//СтруктураПараметров.Вставить("АгентОтправительВТЧДокумента", Ложь);
	СтруктураПараметров.Вставить("Агент", Неопределено);//если агент в тч, то имя колонки, если в шапке, то ссылку на агента. неопределено - пустой агент
	//СтруктураПараметров.Вставить("АгентОтправитель", Неопределено);//если агент в тч, то имя колонки, если в шапке, то ссылку на агента. неопределено - пустой агент
//	СтруктураПараметров.Вставить("Ссылка", Ссылка);
	//СтруктураПараметров.Вставить("Движения", Движения);
