		СписокКлючевыхПолей.Добавить("Начисление"); 
		СписокКлючевыхПолей.Добавить("Документ");
		СписокРесурсов = Новый Массив;
		СписокРесурсов.Добавить("Результат");
		отразитьПодмены(вспНачисленияПоДокументам,ПодменаСотрудников,"Сотрудник");
		БылиРасхождения = ОтразитьРасхождения(НачисленияПоДокументам,вспНачисленияПоДокументам,СписокКлючевыхПолей, БылиРасхождения,ПротоколРасхождений,ОбластьШапки,ОбластьСтроки,СтруктураПараметров.ДатаРегистрацииРасчета,СписокРесурсов,,СписокСотрудниковБезПерерасчета);
	КонецЕсли;	
	Если СтруктураПараметров.ВознаграждениеКурьеров Тогда
		Если Дата > Дата(2018,1,1) Тогда
			
			
			ОбластьШапки = Макет.ПолучитьОбласть("ШапкаВознаграждениеКурьеров");
			ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаВознаграждениеКурьеров");
			СписокКлючевыхПолей = Новый Массив;
			СписокКлючевыхПолей.Добавить("Сотрудник");
			СписокКлючевыхПолей.Добавить("Начисление");
			СписокКлючевыхПолей.Добавить("ИсточникФинансирования");
			СписокКлючевыхПолей.Добавить("Заявка");
			
			СписокРесурсов = Новый Массив;
			СписокРесурсов.Добавить("Результат");
			СписокРесурсов.Добавить("РезультатДляИсточника");
			Если Дата < Дата(2018,7,1) Тогда
				БылиПодмены  = отразитьПодмены(вспВознаграждениеКурьеров,ПодменаСотрудников,"Сотрудник");
				БылиПодмены = отразитьПодмены(вспВознаграждениеКурьеров,ПодменаСотрудников,"ИсточникФинансирования") или БылиПодмены;
			КонецЕсли;	
			Если БылиПодмены = Истина Тогда
				вспВознаграждениеКурьеров.Свернуть("Сотрудник,Начисление,Первоначальная,Заявка,Период,ИсточникФинансирования","Результат,РезультатДляИсточника");
			КонецЕсли;
			
			БылиРасхождения = ОтразитьРасхождения(ВознаграждениеКурьеров, вспВознаграждениеКурьеров,СписокКлючевыхПолей, БылиРасхождения,ПротоколРасхождений,ОбластьШапки,ОбластьСтроки,СтруктураПараметров.ДатаРегистрацииРасчета,СписокРесурсов, Истина,СписокСотрудниковБезПерерасчета);
		КонецЕсли;	
	КонецЕсли;
	
	//Обнаружены и зарегистрированы расхождения
	Если БылиРасхождения Тогда
		ПротоколРасхождений.ТолькоПросмотр		= Истина;
		ПротоколРасхождений.ОтображатьЗаголовки = Ложь;
		ПротоколРасхождений.ОтображатьСетку 	= Ложь;
		ПротоколРасхождений.ЗакончитьАвтогруппировкуСтрок();
		Если СтруктураПараметров.Свойство("ВыводитьПротокол") И СтруктураПараметров.ВыводитьПротокол = Истина Тогда
			// по умолчанию не выводится протокол 
			ПротоколРасхождений.Показать("Протокол изменений в документе при перерасчете");
		Иначе
			Область = Макет.ПолучитьОбласть("ПустаяСтрока");
			ПротоколРасхождений.Вывести(Область);
		КонецЕсли;	
	КонецЕсли;	
	
	БылоЗаполнение = Истина;
	
	Если Не СтруктураПараметров.Свойство("Записать")
		Или СтруктураПараметров.Записать = Истина 
		Тогда
		//по умолчанию и по установленному параметру записываются изменения
		СжатьПравки();
		Записать(?(Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
	КонецЕсли;
	
КонецПроцедуры	

// Процедура расчитывает показатели за переданный подпериод
Процедура РасчитатьПоказатели(
	Сотрудник,
	Начисление,
	КомментарийПериода,
	ДатаНачалаПодпериода,
	ДатаОкончанияПодпериода,
	Показатель,
	вспНачисления,
	Табель,
	НормаЧасов,
	НормаДней,
	СтруктураПараметров
	);
	
	спФиксированнойСуммой = Перечисления.уб_СпособРасчетаНачисления.ФиксированнойСуммой;
	спПроцентом = Перечисления.уб_СпособРасчетаНачисления.Процентом;
	спПоМесячнойТарифнойСтавкеПоДням = Перечисления.уб_СпособРасчетаНачисления.ПоМесячнойТарифнойСтавкеПоДням;
	спПоМесячнойТарифнойСтавкеПоЧасам = Перечисления.уб_СпособРасчетаНачисления.ПоМесячнойТарифнойСтавкеПоЧасам;
	Комент = СокрЛП(КомментарийПериода);
	Если НЕ Показатель = 0 Тогда
		Если СтруктураПараметров.Начисления Тогда
			Строка = вспНачисления.Добавить();
			Строка.Сотрудник   = Сотрудник;
			Если Комент="" Тогда
				Строка.Начисление  = Начисление;
			Иначе
				Строка.Начисление  = ""+Начисление+" / "+Комент;
			КонецЕсли;	
			Строка.Период      = Дата;//????
			//Строка.Показатель  = Показатель;
			Строка.Результат   = 0;
		Иначе
			//Не перезаполняем начисления
		КонецЕсли;	
	Иначе
		Возврат;
	КонецЕсли;
	
	Если СтруктураПараметров.КомментироватьРасчет Тогда
		ВывестиКомментарий ("Начисление: "+Начисление,1);
		ВывестиКомментарий ("Способ расчета: "+Начисление.СпособРасчета,1);
		ВывестиКомментарий ("Подпериод: "+ПредставлениеПериода(ДатаНачалаПодпериода,КонецДня(ДатаОкончанияПодпериода),"ДП=истина"),2);
	КонецЕсли;
	
	//Поиск данных табелирования
	
	//ВыборкаТабелирования.Сбросить();
	
	//СтруктураПоиска = Новый Структура ("Сотрудник",Сотрудник);
	СтрокаТабеля = Табель.Найти(Сотрудник,"Сотрудник");
	Если НЕ СтрокаТабеля = Неопределено Тогда
		//
		//ФактДней  = ВыборкаТабелирования.ВсегоДней;
		//ФактЧасов = ВыборкаТабелирования.ВсегоЧасов;
		ФактДней  = 0;
		ФактЧасов = 0;
		
		УчтеннаяДата = Неопределено;
		Пока УчтеннаяДата = Неопределено ИЛИ УчтеннаяДата<=ДатаОкончанияПодпериода  Цикл
			//
			Если УчтеннаяДата = Неопределено Тогда
				УчтеннаяДата = ДатаНачалаПодпериода;
			Конецесли;
			
			ИндексДня  = День(УчтеннаяДата);
			
			ЗначениеТекущее   = СтрокаТабеля["День"+ИндексДня];
			
			Вид   = Лев(ЗначениеТекущее,2);
			
			Попытка
				Подстрока = СокрЛП(Сред(ЗначениеТекущее,3));
				Если Подстрока ="" Тогда
					Часов = 0;
				Иначе
					Часов = Число(Подстрока);
				КонецЕсли;	
			Исключение
				Часов = 0;
			Конецпопытки;
			Если Часов > 8 Тогда 
				Дней = 1 
			Иначе
				Дней = Окр(Часов/8,2);
			КонецЕсли;	
			
			ФактДней  = ФактДней+Дней;
			ФактЧасов  = ФактЧасов+Часов;
			
			УчтеннаяДата = КонецДня(УчтеннаяДата)+1;
			
		КонецЦикла;	
	Иначе
		ФактДней  = 0;
		ФактЧасов = 0;
	КонецЕсли;
	
	//НормаДней = ПолучитьНормуРабочихДнейПоКалендарю(,ДатаНачалаПодпериода,КонецДня(ДатаОкончанияПодпериода));
	
	
	//пока
	НормаЧасов = НормаДней*8;
	//Расчет показателей
	Если Начисление.СпособРасчета = спФиксированнойСуммой Тогда
		Строка.Результат = Показатель;
		
		Если СтруктураПараметров.КомментироватьРасчет Тогда
			ВывестиКомментарий ("Расчет: Результат = Показатель = "+Строка.Результат,3);
		КонецЕсли;	
		
	ИначеЕсли Начисление.СпособРасчета = спПроцентом Тогда
		
		//Получение суммы базовых начислений
		СуммаБазовая = 0;
		//Выполнение расчета 
		Строка.Результат = Показатель*СуммаБазовая/100;	
		Если СтруктураПараметров.КомментироватьРасчет Тогда
			ВывестиКомментарий ("Расчет: "+""+Показатель+"*"+СуммаБазовая+"/100 = "+Строка.Результат,3);
		КонецЕсли;	
	ИначеЕсли Начисление.СпособРасчета = спПоМесячнойТарифнойСтавкеПоДням Тогда
		
		//Выполнение расчета
		Если НормаДней = 0 Тогда
			ВывестиКомментарий ("Неверная норма дней = 0",3);
		Иначе	
			Строка.Результат = Показатель*ФактДней/НормаДней;	
			
			Если СтруктураПараметров.КомментироватьРасчет Тогда
				ВывестиКомментарий ("Расчет: "+""+Показатель+"*"+ФактДней+"/"+НормаДней+"="+Строка.Результат,3);
			КонецЕсли;
		Конецесли;
	ИначеЕсли Начисление.СпособРасчета = спПоМесячнойТарифнойСтавкеПоЧасам Тогда
		
		//Выполнение расчета
		Если НормаЧасов =0 Тогда
			ВывестиКомментарий ("Неверная норма часов =0",2);
		Иначе	
			Строка.Результат = Показатель*ФактЧасов/НормаЧасов;
			
			Если СтруктураПараметров.КомментироватьРасчет Тогда
				ВывестиКомментарий ("Расчет: "+""+Показатель+"*"+ФактЧасов+"/"+НормаЧасов+"="+Строка.Результат,3);
			КонецЕсли;
		КонецЕсли;
	Иначе
		//неизвестный способ расчета
		Строка.Результат = 0;
		Если СтруктураПараметров.КомментироватьРасчет Тогда
			ВывестиКомментарий ("Расчет: "+"Неизвестный способ расчета "+Начисление.СпособРасчета+" = "+Строка.Результат,2);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция возвращяет дату фиксации для физического лица
Функция ПолучитьДатуФиксации(Физлицо)
	
	Если ДатыФиксации=Неопределено Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	уб_ДатыРасчетовССотрудникамиСрезПоследних.Дата КАК ДатаФиксации,
		|	уб_ДатыРасчетовССотрудникамиСрезПоследних.ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.уб_ДатыРасчетовССотрудниками.СрезПоследних КАК уб_ДатыРасчетовССотрудникамиСрезПоследних";
		//Запрос.УстановитьПараметр("ДатаСреза",ТекущаяДата());
		Выборка= Запрос.Выполнить().Выбрать();
		ДатыФиксации = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			ДатыФиксации.Вставить(Выборка.ФизическоеЛицо,Выборка.ДатаФиксации);
		КонецЦикла;	
	КонецЕсли;	
	ДатаФиксации = ДатыФиксации.Получить(Физлицо);
	Если ДатаФиксации = Неопределено Тогда
		ДатаФиксации = НачалоМесяца(Дата);
	КонецЕсли;	
	Возврат ДатаФиксации;
	
КонецФункции

// Функция отражает расхождения в табличных частях, 
// возвращает факт внесения изменений,
// выводит расхождения в протокол.
Функция ОтразитьРасхождения(
	НачТЧ,
	НовТаблица,
	СписокСвертки, 
	БылиРасхождения,
	ТабличныйДокумент,
	ОбластьШапки,
	ОбластьСтроки,
	ДатаРегистрацииРасчета,
	СписокИтогов,
	ЕстьИсточник = Ложь,
	СписокСотрудниковБезПерерасчета
	);
	
	НачТаблица = НачТЧ.Выгрузить();
	//Обновим даты фиксации заново
	ДатыФиксации = Неопределено;	
	Результат = НовТаблица.Скопировать();
	Результат.Очистить();
	Результат.Колонки.Добавить("НачСумма", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Результат.Колонки.Добавить("Разница",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ВсегоКлючевыхПолей = СписокСвертки.Количество();
	Для Счетчик = 0 по ВсегоКлючевыхПолей-1 Цикл
		НачТаблица.Индексы.Добавить(СписокСвертки[Счетчик]);
	КонецЦикла;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Булево"));
	//МассивТипов.Добавить(Тип("Null"));
	ОписаниеТипаБулево = Новый ОписаниеТипов(МассивТипов);
	НачТаблица.Колонки.Добавить("Обработана",ОписаниеТипаБулево);	
	СтруктураПоиска = Новый Структура;
	СтруктураДопПоиска = Новый Структура;
	Для Счетчик = 0 по ВсегоКлючевыхПолей-1 Цикл
		СтруктураПоиска.Вставить(СписокСвертки[Счетчик],0);
		СтруктураДопПоиска.Вставить(СписокСвертки[Счетчик],0);
	КонецЦикла;
	СтруктураДопПоиска.Вставить("Период",0);	
	ВсегоРесурсов = СписокИтогов.Количество();	
	//Когда начисление производится до окончания месяца записываем начисления текущей датой
//	ДатаФиксацииАльтернатива= ?(ДатаРегистрацииРасчета<Дата,ДатаРегистрацииРасчета,Дата);  //неиспользуется
	Дата0 = НачалоМесяца(Дата);
	СписокРуководителейБезПерерасчета = Новый Массив;
	СписокРуководителейБезПерерасчета.Добавить(Справочники.ФизическиеЛица.НайтиПоКоду("000004976"));
	ВознРукОП = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.НайтиПоКоду("ВознРукОП");
	
	Для каждого НоваяСтрока из НовТаблица Цикл		
		
		Если НЕ СписокСотрудниковБезПерерасчета.Найти(НоваяСтрока.Сотрудник) = Неопределено Тогда
			Продолжить;
		ИначеЕсли НЕ СписокРуководителейБезПерерасчета.Найти(НоваяСтрока.Сотрудник) = Неопределено и НоваяСтрока.Начисление = ВознРукОП Тогда
			Продолжить;
		КонецЕсли;		
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,НоваяСтрока);		
		МассивСуществующихСтрок = НачТаблица.НайтиСтроки(СтруктураПоиска);
		Если МассивСуществующихСтрок.Количество()= 0 Тогда			
			бНадоДобавлять = Ложь;
			Для Счетчик = 0 по ВсегоРесурсов-1 Цикл
				ИмяИтога = СписокИтогов[Счетчик];
				ЗначениеРесурса =  НоваяСтрока[ИмяИтога];
				Если НЕ ЗначениеРесурса = 0 Тогда
					бНадоДобавлять = Истина;
				КонецЕсли;	
			КонецЦикла;			
			//Нет этой строки, добавляем
			Если бНадоДобавлять Тогда
				ДобавленнаяСтрока = НачТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока,НоваяСтрока);
				Датафиксации = ПолучитьДатуФиксации(НоваяСтрока.Сотрудник);
				Если Датафиксации <= Дата0 Тогда
					Период = Дата0;
				Иначе
					//
					Период = Датафиксации + 1;
				КонецЕсли;
				ДобавленнаяСтрока.Период = Период;
				//?(ДатаРегистрацииРасчета=Неопределено или НЕ ЗначениеЗаполнено(ДатаРегистрацииРасчета),ТекущаяДата(),ДатаРегистрацииРасчета);
				ДобавленнаяСтрока.Обработана = Истина;
				ДобавленнаяСтрока.Первоначальная = Истина;
				Если ЕстьИсточник Тогда
					ДатафиксацииИсточника = ПолучитьДатуФиксации(НоваяСтрока.ИсточникФинансирования);
					Если ДатафиксацииИсточника <= Дата0 Тогда
						ПериодДляИсточника = Дата0;
					Иначе
						//
						ПериодДляИсточника = ДатафиксацииИсточника + 1;
					КонецЕсли;
					ДобавленнаяСтрока.ПериодДляИсточника = ПериодДляИсточника;
				КонецЕсли;	
				//Для протокола
				ДобавленнаяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока,НоваяСтрока);
				ДобавленнаяСтрока.Период = Период;
			КонецЕсли;
		Иначе	
			КопияЭтихСтрок = НачТаблица.Скопировать(СтруктураПоиска);			
			бНадоКорректировать = Ложь;
			Для Счетчик = 0 по ВсегоРесурсов-1 Цикл
				ИмяИтога = СписокИтогов[Счетчик];
				ЗначениеИтога =  КопияЭтихСтрок.Итог(ИмяИтога);
				Если НЕ ЗначениеИтога = НоваяСтрока[ИмяИтога] Тогда
					бНадоКорректировать = Истина;
				КонецЕсли;	
			КонецЦикла;
			
			Если бНадоКорректировать Тогда
				ЗначениеИтогаДляПротокола = 0;
				ДобавленнаяСтрока = НачТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока,НоваяСтрока);
				Датафиксации = ПолучитьДатуФиксации(НоваяСтрока.Сотрудник);
				Если Датафиксации <= Дата0 Тогда
					Период = Дата0;
				Иначе
					Период = Датафиксации + 1;
				КонецЕсли;
				ДобавленнаяСтрока.Период = Период;
				Для Счетчик = 0 по ВсегоРесурсов - 1 Цикл
					ИмяИтога = СписокИтогов[Счетчик];
					ЗначениеИтога =  КопияЭтихСтрок.Итог(ИмяИтога);
					Если Счетчик = 0 Тогда
						ЗначениеИтогаДляПротокола = ЗначениеИтога;
					КонецЕсли;
					ДобавленнаяСтрока[ИмяИтога] = ДобавленнаяСтрока[ИмяИтога]-ЗначениеИтога;
				КонецЦикла;
				//?(ДатаРегистрацииРасчета=Неопределено или НЕ ЗначениеЗаполнено(ДатаРегистрацииРасчета),ТекущаяДата(),ДатаРегистрацииРасчета);
				ДобавленнаяСтрока.Обработана = Истина;
				ДобавленнаяСтрока.Первоначальная = Период = Дата0;
				Если ЕстьИсточник Тогда
					ДатафиксацииИсточника = ПолучитьДатуФиксации(НоваяСтрока.ИсточникФинансирования);
					Если ДатафиксацииИсточника <= Дата0 Тогда
						ПериодДляИсточника = Дата0;
					Иначе
						ПериодДляИсточника = ДатафиксацииИсточника + 1;
					КонецЕсли;
					ДобавленнаяСтрока.ПериодДляИсточника = ПериодДляИсточника;
				КонецЕсли;	
				//Для протокола
				ДобавленнаяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока, НоваяСтрока);
				ДобавленнаяСтрока.НачСумма 	= ЗначениеИтогаДляПротокола;
				ДобавленнаяСтрока.Разница 	= ДобавленнаяСтрока.Результат - ЗначениеИтогаДляПротокола;
			КонецЕсли;			
			ВсегоПроверено = МассивСуществующихСтрок.Количество();
			Для СчетчикПроверенныхСтрок = 0 по  ВсегоПроверено-1  Цикл
				СтрокаПроверенная = МассивСуществующихСтрок[СчетчикПроверенныхСтрок];
				СтрокаПроверенная.Обработана = Истина;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	//Уволенные и получившие окончательный расчет
	Для каждого Уволенный из СписокСотрудниковБезПерерасчета Цикл
		СтруктураУвол = Новый Структура("Сотрудник",Уволенный);
		МассивПоУволенным = НачТаблица.НайтиСтроки(СтруктураУвол);
		Для каждого Строка из МассивПоУволенным Цикл
			//Копируем предыдущие данные
			//Дубль = НачТаблица.Добавить();
			//ЗаполнитьЗначенияСвойств(Дубль,Строка);
			Строка.Обработана = Истина;
		КонецЦикла;	
	КонецЦикла;	
	
	СписокРуководителейБезПерерасчета.Добавить(Справочники.ФизическиеЛица.НайтиПоКоду("000004976"));
	ВознРукОП = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.НайтиПоКоду("ВознРукОП");
	Для каждого Уволенный из СписокРуководителейБезПерерасчета Цикл
		СтруктураУвол = Новый Структура("Сотрудник,Начисление",Уволенный,ВознРукОП);
		МассивПоУволенным = НачТаблица.НайтиСтроки(СтруктураУвол);
		Для каждого Строка из МассивПоУволенным Цикл
			//Копируем предыдущие данные
			//Дубль = НачТаблица.Добавить();
			//ЗаполнитьЗначенияСвойств(Дубль,Строка);
			Строка.Обработана = Истина;
		КонецЦикла;	
	КонецЦикла;	
	
	
	НачТаблица.Индексы.Очистить();
	НачТаблица.Индексы.Добавить("Обработана");
	МассивУдаляемых = НачТаблица.Скопировать(Новый Структура("Обработана",Ложь));
	ВсегоУдаляемых = МассивУдаляемых.Количество();
	Для СчетчикСтрок = 0 по  ВсегоУдаляемых - 1  Цикл
		СтрокаУдаляемая = МассивУдаляемых[СчетчикСтрок];
		Если СтрокаУдаляемая.Обработана Тогда
			Продолжить;
		КонецЕсли;	
		СтруктураПоиска = Новый Структура;
		Для Счетчик = 0 по ВсегоКлючевыхПолей-1 Цикл
			СтруктураПоиска.Вставить(СписокСвертки[Счетчик],0);
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаУдаляемая);
		КопияЭтихСтрок = МассивУдаляемых.Скопировать(СтруктураПоиска);
		бНадоКорректировать = Ложь;
		Для Счетчик = 0 по ВсегоРесурсов-1 Цикл
			ИмяИтога = СписокИтогов[Счетчик];
			ЗначениеИтога =  КопияЭтихСтрок.Итог(ИмяИтога);
			Если ЗначениеИтога <> 0 Тогда
				бНадоКорректировать = Истина;
			КонецЕсли;	
		КонецЦикла;
		Если бНадоКорректировать Тогда
			ЗначениеИтогаДляПротокола = 0;
			ДобавленнаяСтрока = НачТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока,СтрокаУдаляемая);
			Датафиксации = ПолучитьДатуФиксации(СтрокаУдаляемая.Сотрудник);
			Если Датафиксации <= Дата Тогда
				Период = Дата;
			Иначе
				Период = Датафиксации + 1;
			КонецЕсли;
			ДобавленнаяСтрока.Период = Период;			
			Если ЕстьИсточник Тогда
				ДатафиксацииИсточника = ПолучитьДатуФиксации(СтрокаУдаляемая.ИсточникФинансирования);
				Если ДатафиксацииИсточника <= Дата Тогда
					ПериодДляИсточника = Дата;
				Иначе
					ПериодДляИсточника = ДатафиксацииИсточника + 1;
				КонецЕсли;
				ДобавленнаяСтрока.ПериодДляИсточника = ПериодДляИсточника;
			КонецЕсли;				
			Для Счетчик = 0 по ВсегоРесурсов-1 Цикл
				ИмяИтога = СписокИтогов[Счетчик];
				ЗначениеИтога = КопияЭтихСтрок.Итог(ИмяИтога);
				Если Счетчик = 0 Тогда
					ЗначениеИтогаДляПротокола = ЗначениеИтога;
				КонецЕсли;
				ДобавленнаяСтрока[ИмяИтога] = - ЗначениеИтога;
			КонецЦикла;
			ДобавленнаяСтрока.Обработана = Истина;
			ДобавленнаяСтрока.Первоначальная = (Период = Дата И ПериодДляИсточника = Дата);
			//Для протокола
			ДобавленнаяСтрока2 = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока2, ДобавленнаяСтрока);
			ДобавленнаяСтрока2.НачСумма = ЗначениеИтогаДляПротокола;
			ДобавленнаяСтрока2.Разница 	= ДобавленнаяСтрока2.Результат - ЗначениеИтогаДляПротокола;
		КонецЕсли;		
		МассивТакихСтрок = МассивУдаляемых.НайтиСтроки(СтруктураПоиска);
		ВсегоПодобных = МассивТакихСтрок.Количество()-1;
		Для СчетчикОбработанных = 0 по ВсегоПодобных Цикл
			ОбработаннаяСтрока = МассивТакихСтрок[СчетчикОбработанных];
			ОбработаннаяСтрока.Обработана = Истина;
		КонецЦикла;	
	КонецЦикла;	
	Если Результат.Количество() > 0 Тогда
		НачТЧ.Загрузить(НачТаблица);
		БылиРасхождения = Истина;		
		ТабличныйДокумент.Вывести(ОбластьШапки,1);		
		Для каждого СтрокаРасхождения из Результат Цикл
			ОбластьСтроки.Параметры.Заполнить(СтрокаРасхождения);
			ТабличныйДокумент.Вывести(ОбластьСтроки,2);
		КонецЦикла;			
	КонецЕсли;
	Возврат БылиРасхождения;
	
КонецФункции

// Процедура выводит комментарий c переданным уровнем вложенности
