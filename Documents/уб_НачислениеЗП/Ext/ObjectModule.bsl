Перем БылоЗаполнение Экспорт;
Перем ДатыФиксации;

#Если Клиент Тогда 
/////////////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ЗАПОЛНЕНИЯ И ОТРАЖЕНИЯ РАСХОЖДЕНИЙ ДОКУМЕНТА
/////////////////////////////////////////////////////////////////////////////////////////
// Процедура перезаполняет документ согласно переданным параметрам
//
//	СтруктураПараметров = Новый Структура (
//		Начисления              - перезаполнять периодические начисления
//		ВознаграждениеЗаПродажи - перезаполнять вознаграждение отдела продаж
//		ВознаграждениеКурьеров  - перезаполнять вознаграждение курьеров
//		КомментироватьРасчет    - выводить комментарии расчета
//		ВыводитьПротокол        - выводить протокол расхождений
//      Записать                - записать изменения после заполнения
Процедура Перезаполнить(СтруктураПараметров = Неопределено, ДатаСреза = Неопределено, ПротоколРасхождений = Неопределено) Экспорт
		
	//Получение настроек инициализация переменных
	//	НеЗаполнятьОП = ложь;
	Если СтруктураПараметров = Неопределено Тогда
		//Если (ТекущаяДата()- Дата)/(24*60*60)<15 Тогда
		//	НеЗаполнятьОП = Истина;
		//КонецЕсли;
		СтруктураПараметров = Новый Структура ("Начисления,ВознаграждениеЗаПродажи,ВознаграждениеКурьеров,КомментироватьРасчет,ВыводитьПротокол,Записать,ДатаРегистрацииРасчета",
		Истина,Истина,Истина,Ложь,Ложь, Истина,Неопределено);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		СтруктураПараметров.Вставить("Ошибка","Не выбран период расчета заработной платы");
		Возврат;
	Иначе
		Если Дата < Дата(2025,8,1) Тогда
			//Старые правки не изменяем
			СтруктураПараметров.Вставить("ВознаграждениеЗаПродажи",Ложь);
			СтруктураПараметров.Вставить("ВознаграждениеКурьеров",Ложь);
		КонецЕсли;
		Если Дата < Дата(2026,6,1) Тогда
			//Старые правки не изменяем
			СтруктураПараметров.Вставить("ВознаграждениеКурьеров",Ложь);
		КонецЕсли;
	КонецЕсли;	
	Если Дата < Дата(2017,1,1) Тогда
		Возврат;
	КонецЕсли;	
	Если Дата < Дата(2025,1,1) Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация	= ПараметрыСеанса.уб_ОсновнаяОрганизация;
		//СтруктураПараметров.Вставить("Ошибка","Не выбрана организация для расчета заработной платы");
		//Возврат;
	КонецЕсли;	
	
	КомментироватьРасчет = СтруктураПараметров.Свойство("КомментироватьРасчет");
	Если Не КомментироватьРасчет Тогда
		СтруктураПараметров.Вставить("КомментироватьРасчет", КомментироватьРасчет);
	Иначе
		КомментироватьРасчет = СтруктураПараметров.КомментироватьРасчет;	
	КонецЕсли;	
	
	спФиксированнойСуммой = Перечисления.уб_СпособРасчетаНачисления.ФиксированнойСуммой;
	спПроцентом = Перечисления.уб_СпособРасчетаНачисления.Процентом;
	спПоМесячнойТарифнойСтавкеПоДням = Перечисления.уб_СпособРасчетаНачисления.ПоМесячнойТарифнойСтавкеПоДням;
	спПоМесячнойТарифнойСтавкеПоЧасам = Перечисления.уб_СпособРасчетаНачисления.ПоМесячнойТарифнойСтавкеПоЧасам;
	
	//Создание промежуточных таблиц 
	вспНачисления = Начисления.Выгрузить();
	вспНачисления.Очистить();
	//
	вспВознаграждениеЗаПродажи = ВознаграждениеЗаПродажи.Выгрузить();
	вспВознаграждениеЗаПродажи.Очистить();
	//
	вспВознаграждениеЗаПродажиМастер= ВознаграждениеЗаПродажи.Выгрузить();
	вспВознаграждениеЗаПродажиМастер.Очистить();
	//
	вспВознаграждениеКурьеров = ВознаграждениеКурьеров.Выгрузить();
	вспВознаграждениеКурьеров.Очистить();
	//
	вспНачисленияПоДокументам = НачисленияПоДокументам.Выгрузить();
	вспНачисленияПоДокументам.Очистить();
	
	ДатаНачала = НачалоМесяца (Дата);
	ДатаОкончания = КонецМесяца (Дата);
	
	
	Если СтруктураПараметров.Начисления Тогда
		ЗапросДляРасчетаНачислений = Новый Запрос;//("ВЫБРАТЬ
		ЗапросДляРасчетаНачислений.УстановитьПараметр("РасчетныйПериод",Дата);
		ЗапросДляРасчетаНачислений.УстановитьПараметр("Организация",Организация);
		
		//Получение данных по табелю
		Табель = Документы.уб_ТабельУчетаРабочегоВремени.ПолучитьТаблицуТабеля(Дата);
		//Получаем норму времени в днях 
		//Допущение, что все работают по пятидневке
		НормаДней = ПолучитьНормуРабочихДнейПоКалендарю(,НачалоМесяца(Дата),КонецМесяца(Дата));
		
		Если КомментироватьРасчет Тогда
			ВывестиКомментарий ("Найдены данные табеля: "+Табель.Количество());
			
			ВывестиКомментарий ("Полная норма дней = "+НормаДней,0);
		КонецЕсли;	
		
		//Получаем норму времени в часах 
		//может зависить от ставки
		НормаЧасов = НормаДней*8;
		
		Если КомментироватьРасчет Тогда
			ВывестиКомментарий ("Полная норма часов = "+НормаЧасов,0);
		КонецЕсли;
		
		Если Дата > Дата(2025,7,1) Тогда
			ЗапросДляРасчетаНачислений.Текст =  "ВЫБРАТЬ
			                                    |	Вложенные.Период КАК Объект,
			                                    |	Вложенные.СпособРасчета,
			                                    |	Вложенные.Действует,
			                                    |	Вложенные.Показатель,
			                                    |	Вложенные.Комментарий,
			                                    |	Вложенные.Выбытие
			                                    |ИЗ
			                                    |	(ВЫБРАТЬ
			                                    |		НачисленияМесяца.Начисление КАК Начисление,
			                                    |		НачисленияМесяца.Начисление.СпособРасчета КАК СпособРасчета,
			                                    |		НЕ НачисленияМесяца.НеДействует КАК Действует,
			                                    |		НачисленияМесяца.Показатель КАК Показатель,
			                                    |		НачисленияМесяца.Период КАК Период,
			                                    |		НачисленияМесяца.Сотрудник КАК Сотрудник,
			                                    |		НачисленияМесяца.Комментарий КАК Комментарий,
			                                    |		уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие КАК Выбытие
			                                    |	ИЗ
			                                    |		РегистрСведений.уб_ДействующиеНачисленияСотрудников КАК НачисленияМесяца
			                                    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
			                                    |			ПО НачисленияМесяца.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
			                                    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(КОНЕЦПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних2
			                                    |			ПО НачисленияМесяца.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних2.Агент
			                                    |	ГДЕ
			                                    |		НАЧАЛОПЕРИОДА(НачисленияМесяца.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ)
			                                    |		И НачисленияМесяца.Организация = &Организация
			                                    |		И НЕ(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ИСТИНА
			                                    |					И уб_ДвижениеФизлицПоПодразделениямСрезПоследних2.Выбытие = ИСТИНА)
			                                    |	
			                                    |	ОБЪЕДИНИТЬ ВСЕ
			                                    |	
			                                    |	ВЫБРАТЬ
			                                    |		НачисленияНаНачало.Начисление,
			                                    |		НачисленияНаНачало.Начисление.СпособРасчета,
			                                    |		НЕ НачисленияНаНачало.НеДействует,
			                                    |		НачисленияНаНачало.Показатель,
			                                    |		НачисленияНаНачало.Период,
			                                    |		НачисленияНаНачало.Сотрудник,
			                                    |		НачисленияНаНачало.Комментарий,
			                                    |		уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
			                                    |	ИЗ
			                                    |		РегистрСведений.уб_ДействующиеНачисленияСотрудников.СрезПоследних(НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), Организация = &Организация) КАК НачисленияНаНачало
			                                    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
			                                    |			ПО НачисленияНаНачало.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
			                                    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(КОНЕЦПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних2
			                                    |			ПО НачисленияНаНачало.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних2.Агент
			                                    |	ГДЕ
			                                    |		НЕ(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ИСТИНА
			                                    |					И уб_ДвижениеФизлицПоПодразделениямСрезПоследних2.Выбытие = ИСТИНА)) КАК Вложенные
			                                    |
			                                    |УПОРЯДОЧИТЬ ПО
			                                    |	Вложенные.Сотрудник.Наименование,
			                                    |	Вложенные.Начисление,
			                                    |	Объект
			                                    |ИТОГИ
			                                    |	ВЫБОР
			                                    |		КОГДА Вложенные.Начисление ЕСТЬ NULL
			                                    |			ТОГДА Вложенные.Сотрудник
			                                    |		ИНАЧЕ Вложенные.Начисление
			                                    |	КОНЕЦ КАК Объект
			                                    |ПО
			                                    |	Вложенные.Сотрудник,
			                                    |	Вложенные.Начисление";
		Иначе		 
			//Заполнение действующими начислениями из регистра сведений 
			ЗапросДляРасчетаНачислений.Текст = "ВЫБРАТЬ
			|	Вложенные.Период КАК Объект,
			|	Вложенные.СпособРасчета,
			|	Вложенные.Действует,
			|	Вложенные.Показатель,
			|	Вложенные.Комментарий
			|ИЗ
			|	(ВЫБРАТЬ
			|		НачисленияМесяца.Начисление КАК Начисление,
			|		НачисленияМесяца.Начисление.СпособРасчета КАК СпособРасчета,
			|		(НЕ НачисленияМесяца.НеДействует) КАК Действует,
			|		НачисленияМесяца.Показатель КАК Показатель,
			|		НачисленияМесяца.Период КАК Период,
			|		НачисленияМесяца.Сотрудник КАК Сотрудник,
			|		НачисленияМесяца.Комментарий КАК Комментарий
			|	ИЗ
			|		РегистрСведений.уб_ДействующиеНачисленияСотрудников КАК НачисленияМесяца
			|	ГДЕ
			|		НАЧАЛОПЕРИОДА(НачисленияМесяца.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ)
			|		И НачисленияМесяца.Организация = &Организация
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		НачисленияНаНачало.Начисление,
			|		НачисленияНаНачало.Начисление.СпособРасчета,
			|		(НЕ НачисленияНаНачало.НеДействует),
			|		НачисленияНаНачало.Показатель,
			|		НачисленияНаНачало.Период,
			|		НачисленияНаНачало.Сотрудник,
			|		НачисленияНаНачало.Комментарий
			|	ИЗ
			|		РегистрСведений.уб_ДействующиеНачисленияСотрудников.СрезПоследних(НАЧАЛОПЕРИОДА(&РасчетныйПериод, МЕСЯЦ), Организация = &Организация) КАК НачисленияНаНачало) КАК Вложенные
			|
			|УПОРЯДОЧИТЬ ПО
			|	Вложенные.Сотрудник.Наименование,
			|	Вложенные.Начисление,
			|	Объект
			|ИТОГИ
			|	ВЫБОР
			|		КОГДА Вложенные.Начисление ЕСТЬ NULL 
			|			ТОГДА Вложенные.Сотрудник
			|		ИНАЧЕ Вложенные.Начисление
			|	КОНЕЦ КАК Объект
			|ПО
			|	Вложенные.Сотрудник,
			|	Вложенные.Начисление";
		КонецЕсли;
		Состояние("1,2 из 4 - Расчет плановых начислений и удержаний");
		Выборка = ЗапросДляРасчетаНачислений.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);					  
		Пока Выборка.Следующий() Цикл
			//
			Сотрудник = Выборка.Объект;
			
			ВыборкаНачисления = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);					  
			Если КомментироватьРасчет И ВыборкаНачисления.Количество()>0 Тогда
				ВывестиКомментарий ("Сотрудник: "+Сотрудник,0);
			КонецЕсли;
			КомментарийПериода = "";
			Пока ВыборкаНачисления.Следующий() Цикл
				
				Начисление = ВыборкаНачисления.Объект;
				Способ = Начисление.СпособРасчета;
				бФиксСуммой = Способ=спФиксированнойСуммой;
				
				ВыборкаДаты =  ВыборкаНачисления.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);					  
				НачислениеДействует = Ложь;
				ДатаНачалаПодпериода = Неопределено;
				Показатель = 0;
				Пока ВыборкаДаты.Следующий() Цикл
					
					ДатаЗаписи = ВыборкаДаты.Объект;
					
					Если ДатаЗаписи <= НачалоМесяца(Дата) Тогда
						//Изменения до начала, если действуют, то продолжают действовать в периоде
						НачислениеДействует = ВыборкаДаты.Действует;
						Если НачислениеДействует Тогда
							ДатаНачалаПодпериода = НачалоМесяца(Дата);
							Показатель = ВыборкаДаты.Показатель;
							КомментарийПериода = СокрЛП(ВыборкаДаты.Комментарий);
						Иначе
							//Не важно 
						КонецЕсли;	
					Иначе
						//Изменения в периоде
						Если НачислениеДействует Тогда
							
							НачислениеДействует = ВыборкаДаты.Действует; //Новый
							Если НачислениеДействует Тогда
								
								КомментарийПериода = СокрЛП(ВыборкаДаты.Комментарий);
								
								Если Показатель= ВыборкаДаты.Показатель Тогда
									//Действовало и не изменился показатель
								Иначе
									//Действовало и изменился показатель
									Если бФиксСуммой Тогда
										//Поскольку отмены действия нет - это изменения Показателя
										//просто меняем его
										Показатель = ВыборкаДаты.Показатель;
									Иначе	
										ДатаОкончанияПодпериода = НачалоДня(НачалоДня(ВыборкаДаты.Объект)-1); 
										Если ДатаОкончания<НачалоМесяца(Дата) Тогда
											ДатаОкончания = НачалоМесяца(Дата);
										КонецЕсли;	
										РасчитатьПоказатели(Сотрудник,Начисление,КомментарийПериода,ДатаНачалаПодпериода,ДатаОкончанияПодпериода,Показатель,вспНачисления,Табель,НормаЧасов,НормаДней,СтруктураПараметров);
										ДатаНачалаПодпериода = ВыборкаДаты.Объект;
										Показатель = ВыборкаДаты.Показатель;
									Конецесли;
								КонецЕсли;
							Иначе
								//Отмена действия ранее действующего
								ДатаОкончанияПодпериода = НачалоДня(НачалоДня(ВыборкаДаты.Объект)-1); 
								Если ДатаОкончания<НачалоМесяца(Дата) Тогда
									ДатаОкончания = НачалоМесяца(Дата);
								КонецЕсли;	
								РасчитатьПоказатели(Сотрудник,Начисление,КомментарийПериода,ДатаНачалаПодпериода,ДатаОкончанияПодпериода,Показатель,вспНачисления,Табель,НормаЧасов,НормаДней,СтруктураПараметров);
								ДатаНачалаПодпериода = Неопределено;
								Показатель = 0;
							КонецЕсли;	
							
						Иначе
							//Не действовало
							НачислениеДействует = ВыборкаДаты.Действует;
							Если НачислениеДействует Тогда
