// Функция возвращает количество рабочих дней в месяце
Функция ПолучитьНормуРабочихДнейПоКалендарю(Вид="Пятидневка",ДатаНачала,ДатаОкончания)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	&ДатаОкончания,
	|	СУММА(ЕСТЬNULL(РегламентированныйПроизводственныйКалендарь.Пятидневка, 0)) КАК Пятидневка,
	|	СУММА(ЕСТЬNULL(РегламентированныйПроизводственныйКалендарь.Шестидневка, 0)) КАК Шестидневка
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.Год = &Год
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря >= &ДатаНачала
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря <= &ДатаОкончания");
	Запрос.УстановитьПараметр("Год",Год(Дата));
	Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат ?(Выборка[Вид] = NULL, 0, Выборка[Вид]);	
	КонецЦикла;
	Возврат 0;
	
КонецФункции

// Процедура сворачивает табличную часть, удаляет нулевые значения и загружает в источник
Процедура СжатьТаблицу(Таблица,СтрокаСвертки,Ресурсы="Результат",Изменен)
	
	вспТаблица = Таблица.Выгрузить();
	вспТаблица.Свернуть(СтрокаСвертки,Ресурсы);
	//вспНачисления.Индексы.Добавить("Результат");
	Если Ресурсы = "Результат" Тогда
		Если Не вспТаблица.Найти(0,Ресурсы)= Неопределено Тогда 
			//удаляем пустые строки
			КоличествоСтрок = вспТаблица.Количество();
			Для СчетчикСтрок=1 по  КоличествоСтрок Цикл
				ТекСтрока = вспТаблица[КоличествоСтрок-СчетчикСтрок];
				Если ТекСтрока.Результат =0 Тогда
					вспТаблица.Удалить(ТекСтрока);
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
	Иначе
		//Это курьеры
		КоличествоСтрок = вспТаблица.Количество();
		Для СчетчикСтрок=1 по  КоличествоСтрок Цикл
			ТекСтрока = вспТаблица[КоличествоСтрок-СчетчикСтрок];
			Если ТекСтрока.Результат = 0 и ТекСтрока.РезультатДляИсточника=0 Тогда
				вспТаблица.Удалить(ТекСтрока);
			КонецЕсли;	
		КонецЦикла;	
	Конецесли;
	вспТаблица.Сортировать(СтрокаСвертки);
	вспТаблица.Колонки.Добавить("Первоначальная");
	вспТаблица.ЗаполнитьЗначения(Истина,"Первоначальная");
	СтруктураПоиска = Новый Структура(СтрокаСвертки);
	Для Каждого Строка из ВспТаблица Цикл
		Если Не Строка.Первоначальная Тогда
			Продолжить;
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,Строка);
		МассивСтрок = ВспТаблица.найтиСтроки(СтруктураПоиска);
		ВсегоНайдено = МассивСтрок.Количество();
		Если ВсегоНайдено > 1 Тогда
			Для Счетчик = 1 По ВсегоНайдено Цикл
				  МассивСтрок[Счетчик].Первоначальная = Ложь;
			КонецЦикла;	
		Конецесли;	
	КонецЦикла;	
	Если Таблица.Количество()<> вспТаблица.Количество() Тогда
		Таблица.Загрузить(вспТаблица);
		Изменен = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывает сжатие табличных частей, при изменении вызывает проведение
Процедура СжатьПравки(ЕстьПравки = Ложь, Записать = Истина) Экспорт
	
	ЕстьПравки = Ложь;
	Если Проведен Тогда
		СжатьТаблицу(Начисления,				"Сотрудник,Начисление,Период",, ЕстьПравки);
		СжатьТаблицу(НачисленияРазовые,			"Сотрудник,Начисление,Период",, ЕстьПравки);
		СжатьТаблицу(ВознаграждениеЗаПродажи,	"Сотрудник,Начисление,Период",, ЕстьПравки);
		СжатьТаблицу(ВознаграждениеКурьеров,	"Сотрудник,Начисление,Период,ИсточникФинансирования,Заявка,ПериодДляИсточника", "Результат,РезультатДляИсточника", ЕстьПравки);
	КонецЕсли;

КонецПроцедуры	


Процедура ДвижениеПоРегистрам()
	
	//Поле раздел: 
	//Все что до 10 Начисления, 
	//Свыше Удержание, используется при анализе движений
	
	//Отражение периодических начислений
	Для Каждого ТекСтрокаНачисления Из Начисления Цикл
		// регистр уб_РасчетыСФЛПоЗП Приход
		Если ТекСтрокаНачисления.Результат=0 Тогда
			Продолжить;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекСтрокаНачисления.Сотрудник) = Ложь Тогда
			Сообщить(""+ТекСтрокаНачисления.Начисление+" "+ТекСтрокаНачисления.Результат+" пустой сотрудник");
			продолжить;
		КонецЕсли;	
		Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		//Движение.Период = Дата;
		Движение.Период = ТекСтрокаНачисления.Период; 
		Движение.Организация = Организация;
		Движение.ФизическоеЛицо = ТекСтрокаНачисления.Сотрудник;
		Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
		Если ТекСтрокаНачисления.Результат >0 Тогда
			Движение.Сумма 			= ТекСтрокаНачисления.Результат;
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
			Движение.Раздел 		= 1;//Начисление
		Иначе
			Движение.Сумма 			= -ТекСтрокаНачисления.Результат;
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
			Движение.Раздел 		= 11;//Удержание
		КонецЕсли;			
		Движение.РасчетныйПериод = Дата;
		//Движение.ПериодРегистрации = НачалоДня(КонецМесяца(ТекСтрокаНачисления.Период));
		Если ТекСтрокаНачисления.Первоначальная Тогда
			Движение.Описание= ТекСтрокаНачисления.Начисление;
		Иначе
			Попытка 
				Движение.Описание= "Изменение в "+НРЕГ(ТекСтрокаНачисления.Начисление);
			Исключение
			КонецПопытки;	
		КонецЕсли;	
		
	КонецЦикла;
	//Отражаение разовых Начислений
	Для Каждого ТекСтрокаНачисления Из НачисленияРазовые Цикл
		Если ТекСтрокаНачисления.Результат = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтрокаНачисления.Сотрудник) = Ложь Тогда
			Сообщить(""+ТекСтрокаНачисления.Начисление+" "+ТекСтрокаНачисления.Результат+" пустой сотрудник");
			продолжить;
		КонецЕсли;	

		// регистр уб_РасчетыСФЛПоЗП Приход
		Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();		
		Движение.Период 		= ТекСтрокаНачисления.Период; 
		Движение.Организация 	= Организация;
		Движение.ФизическоеЛицо = ТекСтрокаНачисления.Сотрудник;
		Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
		Если ТекСтрокаНачисления.Результат >0 Тогда
			Движение.Сумма 			= ТекСтрокаНачисления.Результат;
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
			Движение.Раздел 		= 4;//Начисление
		Иначе
			Движение.Сумма 			= -ТекСтрокаНачисления.Результат;
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
			Движение.Раздел 		= 14;//Удержание
		КонецЕсли;	
		Движение.РасчетныйПериод = Дата;
		Движение.Описание = ТекСтрокаНачисления.Начисление;
	КонецЦикла;
	//Отражение вознаграждения отдела продаж
	Для Каждого ТекСтрокаНачисления Из ВознаграждениеЗаПродажи Цикл
		// регистр уб_РасчетыСФЛПоЗП Приход
		Если ТекСтрокаНачисления.Результат = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТекСтрокаНачисления.Сотрудник.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
		Движение.Период 			= ТекСтрокаНачисления.Период;
		Движение.Организация 		= Организация;
		Движение.ФизическоеЛицо 	= ТекСтрокаНачисления.Сотрудник;
		Движение.Сумма 				= ТекСтрокаНачисления.Результат;
		Движение.РасчетныйПериод 	= Дата;
		Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
		//Движение.ПериодРегистрации = НачалоДня(КонецМесяца(ТекСтрокаНачисления.Период));
		Если ТекСтрокаНачисления.Первоначальная или ТипЗНЧ(ТекСтрокаНачисления.Начисление) = Тип("Строка") Тогда
			Движение.Описание = ТекСтрокаНачисления.Начисление;
		Иначе
			Движение.Описание = ТекСтрокаНачисления.Начисление.НаименованиеКорректирующейЗаписи;
		КонецЕсли;	
		Движение.Раздел = 2;//Начисление
	КонецЦикла;
	//Отражение вознаграждения курьерской службы
	НеопределенныйАгент = ПараметрыСеанса.уб_Константы.НеопределенАгент;
	Для Каждого ТекСтрокаНачисления Из ВознаграждениеКурьеров Цикл
		// регистр уб_РасчетыСФЛПоЗП Приход
		Если Не ТекСтрокаНачисления.Сотрудник = НеопределенныйАгент Тогда
			
			Если ЗначениеЗаполнено(ТекСтрокаНачисления.Сотрудник) = Ложь Тогда
				Сообщить("Курьерам"+" "+ТекСтрокаНачисления.Результат+" пустой сотрудник");
				продолжить;
			КонецЕсли;	

			// НеопределенныйАгент - удержания за личную заявку
			Если ТекСтрокаНачисления.Результат <> 0 Тогда	
				Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
				Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
				Движение.Период 			= ТекСтрокаНачисления.Период;
				Движение.Организация 		= Организация;
				Движение.ФизическоеЛицо 	= ТекСтрокаНачисления.Сотрудник;
				Движение.Сумма 				= ТекСтрокаНачисления.Результат;
				Движение.РасчетныйПериод 	= Дата;
				Движение.Источник			= ТекСтрокаНачисления.ИсточникФинансирования; 
				//Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
				Если ТекСтрокаНачисления.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ПечатьПолиса Тогда
					Движение.ВидНачисления  = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ПечатьПолиса;
					Движение.Описание = "Заполнение полиса курьером";
				Иначе
					Движение.ВидНачисления  = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознВыезд;
					Если ТекСтрокаНачисления.Первоначальная или ТипЗНЧ(ТекСтрокаНачисления.Начисление) = Тип("Строка") Тогда
						Движение.Описание = "Вознаграждение курьера";
					Иначе
						Движение.Описание = "Изменение в ВК";
					КонецЕсли;		
				КонецЕсли;
				
				Движение.Раздел = 3;//Начисление
			КонецЕсли;
		КонецЕсли;
		Если ТекСтрокаНачисления.РезультатДляИсточника <> 0 Тогда	
			Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
			Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
			Движение.Период 			= ТекСтрокаНачисления.ПериодДляИсточника;
			Движение.Организация 		= Организация;
			Движение.ФизическоеЛицо 	= ТекСтрокаНачисления.ИсточникФинансирования;
			Движение.Сумма 				= ТекСтрокаНачисления.РезультатДляИсточника;
			Движение.РасчетныйПериод 	= Дата;
			Движение.Источник= ТекСтрокаНачисления.Сотрудник; 
			Если ТекСтрокаНачисления.Первоначальная Тогда
				Движение.Описание = "Удержание за курьеров";
			Иначе
				Движение.Описание = "Изменение в удержании за курьера";
			КонецЕсли;
			//Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
			Движение.ВидНачисления  = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.УдВыезд;
			//КонецЕсли;	
			Движение.Раздел = 12;//Удержание
		КонецЕсли;
	КонецЦикла;
	//Удержание по документам
	Для Каждого ТекСтрокаНачисления Из НачисленияПоДокументам Цикл
		// регистр уб_РасчетыСФЛПоЗП Приход
		Если ТекСтрокаНачисления.Результат = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТекСтрокаНачисления.Сотрудник.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.уб_РасчетыСФЛПоЗП.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
		Движение.Период 			= ТекСтрокаНачисления.Период;
		Движение.Организация 		= Организация;
		Движение.ФизическоеЛицо 	= ТекСтрокаНачисления.Сотрудник;
		Движение.Сумма 				= ТекСтрокаНачисления.Результат;
		Движение.РасчетныйПериод 	= Дата;
		Движение.ВидНачисления  = ТекСтрокаНачисления.Начисление;
		//Движение.ПериодРегистрации = НачалоДня(КонецМесяца(ТекСтрокаНачисления.Период));
		Если ТекСтрокаНачисления.Первоначальная или ТипЗНЧ(ТекСтрокаНачисления.Начисление) = Тип("Строка") Тогда
			Движение.Описание = ТекСтрокаНачисления.Начисление ;
		Иначе
			Движение.Описание = ТекСтрокаНачисления.Начисление.НаименованиеКорректирующейЗаписи;
		КонецЕсли;	
		Движение.Описание = Движение.Описание+ " ("+СокрлП(ТекСтрокаНачисления.Документ.Номер)+")";
		Движение.Раздел = 15;//Удержание
	КонецЦикла;

	Если БылоЗаполнение и ЗначениеЗаполнено(Дата) Тогда
		
		//Двигаем актуализацию 
		уб_РасчетыСМенеджерами.ЗарплатныйПериодАктуален(Дата,Новый Структура("Актуален,Объект",Истина,Ссылка));
		
		//МЗ = РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП.СоздатьМенеджерЗаписи();
		//МЗ.Актуален 		= Истина;
		//МЗ.РасчетныйПериод 	= Дата;
		//МЗ.Период 			= ТекущаяДата();
		//МЗ.Объект 			= Ссылка;
		//МЗ.Записать();
	КонецЕсли;	
	БылоЗаполнение = Ложь;
	
КонецПроцедуры

// Процедура обработчик события проведения, выполняет движения по регистрам
Процедура ОбработкаПроведения(Отказ, Режим)
	
	ДвижениеПоРегистрам();
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью", отмечает модификацию, блокирует строки, если документ подписан
Процедура ПередЗаписью(Отказ,РежимЗаписи)
	
	Если ОбменДанными.Загрузка Тогда
		//Без проверок
		ОбменДанными.Загрузка = Ложь;
		Возврат;
	КонецЕсли;	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Если ПометкаУдаления Тогда
			Возврат
		КонецЕсли;	
		Если Ссылка.Пустая() Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		Иначе
			//Изменяется режим проведения
			Если Не ПометкаУдаления Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				#Если Клиент Тогда
				Предупреждение("Помеченный на удаление документ не может быть изменен!",5);
				#КонецЕсли	
				Отказ = Истина;
			КонецЕсли;	
		КонецЕсли;
	Иначе
		//Проводится
		Если ПометкаУдаления Тогда
			#Если Клиент Тогда
			Предупреждение("Помеченный на удаление документ не может быть проведен!",5);
			#КонецЕсли	
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;	
	Если Отказ Тогда
		Возврат;		
	КонецЕсли;	
	УстановитьЗначение(Дата, НачалоМесяца(Дата));
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ИскДокумент = Документы.уб_НачислениеЗП.ПолучитьДокументНачисленияЗаПериод (Дата,Организация);
		Если ИскДокумент <> Неопределено И ИскДокумент.Ссылка <> Ссылка Тогда
			#Если Клиент Тогда
				Предупреждение("Уже есть документ начисления с такими параметрами! "+СИмволы.ПС+Дата+Символы.ПС+Организация,5);
			#КонецЕсли	
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Проведен Тогда
		//Удаление запрещено
		Отказ  = Истина;
		#Если Клиент Тогда
			Предупреждение ("Удаление проведенного документа запрещено");
		#КонецЕсли
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьЗакрытыеВзаиморасчеты()
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ФизическиеЛица.Ссылка
	                      |ИЗ
	                      |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	                      |ГДЕ
	                      |	ФизическиеЛица.ВзаиморасчетыПрекращены = ИСТИНА "+?(Дата<Дата(2018,7,1)," или ФизическиеЛица.Код = ""000051202""",""));
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции	

Функция СобратьПодмены()
	
	Подмены  = Новый Соответствие;
	//Если Дата<Дата(2017,1,1) И Дата > Дата(2016,7,1) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПодразделенияОрганизаций.Ссылка,
		               |	ПодразделенияОрганизаций.АналитикаЗарплаты
		               |ПОМЕСТИТЬ Подразделения
		               |ИЗ
		               |	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
		               |ГДЕ
		               |	НЕ ПодразделенияОрганизаций.АналитикаЗарплаты = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	подразделения.Ссылка КАК Ссылка,
		               |	подразделения.АналитикаЗарплаты,
		               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
		               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
		               |ИЗ
		               |	Подразделения КАК подразделения
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&ДатаСреза, ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		               |		ПО подразделения.Ссылка = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение
		               |
		               |ОБЪЕДИНИТЬ
		               |
		               |ВЫБРАТЬ
		               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение,
		               |	&Мастер,
		               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент,
		               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие
		               |ИЗ
		               |	РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПоследних(&ДатаСреза, ) КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&ДатаСреза, ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
		               |		ПО уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
		               |ГДЕ
		               |	уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра = ""ЭтоМастер""
		               |	И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0";
		Запрос.УстановитьПараметр("ДатаСреза",КонецМесяца(Дата));
		Запрос.УстановитьПараметр("Мастер",Справочники.ФизическиеЛица.НайтиПоНаименованию("_Мастер Сводные"));
		Выборка = Запрос.Выполнить().Выбрать();		   
		Пока Выборка.Следующий() Цикл
			подмены.Вставить(Выборка.Агент,Выборка.АналитикаЗарплаты);
		КонецЦикла;
		
	//КонецЕсли;
	Возврат подмены;
	
КонецФункции
//
Функция отразитьПодмены(_Начисления,_ПодменыСотрудников,ИмяПоля,Исключения = Неопределено)
	флЕстьПравки = Ложь;
	Для Каждого Подмена Из _ПодменыСотрудников Цикл
		СтрокиПоСотруднику = _Начисления.НайтиСтроки(Новый Структура(ИмяПоля,Подмена.Ключ));
		Для Каждого СтрокаН Из СтрокиПоСотруднику  Цикл
			
			Если Не Исключения = Неопределено Тогда
				Если Исключения.Найти(СтрокаН.Начисление)<>Неопределено Тогда
					Продолжить;
				КонецЕсли;						
			КонецЕсли;
			
			СтрокаН[ИмяПоля] = Подмена.Значение;
		КонецЦикла;
		флЕстьПравки = флЕстьПравки = Истина или СтрокиПоСотруднику.Количество()>0;
	КонецЦикла;
	Возврат флЕстьПравки;
КонецФункции

//МАСТЕР
Функция ПолучитьСКВМастер()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",Дата);
	Запрос.УстановитьПараметр("ДатаКонца",Дата);
	Запрос.Текст ="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	              |	НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) КАК ЗарплатныйПериод,
	              |	""СКВ (по отчету Мастер)"" КАК Статья,
	              |	СУММА(ВЫБОР
	              |			КОГДА ОП.ОплаченоФакт - ОП.СкидкаВыплаченаяКлиенту < ВЫБОР
	              |					КОГДА ОП.НачисленнаяСуммаВзноса = 0
	              |						ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	              |					ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	              |				КОНЕЦ - ОП.КВСумма
	              |				ТОГДА 0
	              |			ИНАЧЕ ОП.ОплаченоФакт - ВЫБОР
	              |					КОГДА ОП.НачисленнаяСуммаВзноса = 0
	              |						ТОГДА ОП.ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику
	              |					ИНАЧЕ ОП.НачисленнаяСуммаВзноса
	              |				КОНЕЦ - ОП.СкидкаВыплаченаяКлиенту + ОП.КВСумма - ОП.СуммаДоп
	              |		КОНЕЦ * (100 - ОП.ПроцентСКВ) / 100) КАК Сумма
	              |ИЗ
	              |	Документ.уб_ОплатаПолисов КАК ОП
	              |ГДЕ
	              |	НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) >= &ДатаНачала
	              |	И КОНЕЦПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ) <= КОНЕЦПЕРИОДА(&ДатаКонца, МЕСЯЦ)
	              |	И ОП.ИсключитьИзРасчетаЗП = ЛОЖЬ
	              |	И НЕ ОП.СтраховойПолис.Ссылка = ЗНАЧЕНИЕ(Документ.уб_СтраховойПолис.ПустаяСсылка)
	              |	И ОП.СтраховойПолис.ПометкаУдаления = ЛОЖЬ
	              |	И ОП.ПометкаУдаления = ЛОЖЬ
	              |	И ОП.СхемаРасчетаСМенеджером = ЗНАЧЕНИЕ(ПланВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ)
	              |	И (ОП.Подразделение.Родитель.Наименование = ""ОП-Мастер""
	              |			ИЛИ ОП.Агент В
	              |				(ВЫБРАТЬ
	              |					уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник
	              |				ИЗ
	              |					РегистрСведений.уб_ПараметрыРасчетаЗарплатыСотрудников.СрезПоследних(&ДатаКонца, ) КАК уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних
	              |				ГДЕ
	              |					уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ТипПараметра = ""ЭтоМастер""
	              |					И уб_ПараметрыРасчетаЗарплатыСотрудниковСрезПоследних.ЗначениеПараметра > 0)
	              |			ИЛИ ОП.Подразделение.Наименование = ""Технопарк"")
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	НАЧАЛОПЕРИОДА(ОП.ЗарплатныйПериод, МЕСЯЦ)";
				  
		Выборка = Запрос.Выполнить().Выбрать();	  
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Сумма;	
		Иначе
			Возврат 0;	
		КонецЕсли;
КонецФункции
	
Функция ДопыМастера(Себестоимость)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Себестоимость",Себестоимость);
	Запрос.Текст  = "ВЫБРАТЬ
	|	СУММА(уб_ОплатаПолисовУслугиПоДокументу.Сумма) КАК СКлиента,
	|	СУММА(уб_ОплатаПолисовУслугиПоДокументу.Себестоимость - &Себестоимость) КАК Мастеру,
	|	СУММА(&Себестоимость) КАК Брокеру,
	|	МАКСИМУМ(уб_ОплатаПолисовУслугиПоДокументу.СхемаОплаты) КАК СхемаОплаты,
	|	СУММА(уб_ОплатаПолисовУслугиПоДокументу.ВМ) КАК ВМ,
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Документ.уб_ОплатаПолисов.УслугиПоДокументу КАК уб_ОплатаПолисовУслугиПоДокументу
	|ГДЕ
	|	уб_ОплатаПолисовУслугиПоДокументу.Ссылка.Подразделение В
	|			(ВЫБРАТЬ
	|				Справочник.ПодразделенияОрганизаций.Ссылка
	|			ИЗ
	|				Справочник.ПодразделенияОрганизаций
	|			ГДЕ
	|				Справочник.ПодразделенияОрганизаций.Родитель.Наименование = ""ОП-Мастер"")
	|	И КОНЕЦПЕРИОДА(уб_ОплатаПолисовУслугиПоДокументу.Ссылка.ЗарплатныйПериод, МЕСЯЦ) = КОНЕЦПЕРИОДА(&ЗарплатныйПериод, МЕСЯЦ)
	|	И уб_ОплатаПолисовУслугиПоДокументу.Сумма <> 0";
	Запрос.УстановитьПараметр("ЗарплатныйПериод",Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураДопов = Новый  Структура("СКлиента,Мастеру,Брокеру,ВМ,Количество",0,0,0,0,0);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураДопов,Выборка);
	КонецЕсли;
	
	Возврат СтруктураДопов
	
	
КонецФункции	

//HR

Функция ДополнитьБонусамиHR(ТЧ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1",Дата);
	Запрос.УстановитьПараметр("Дата2",КонецМесяца(Дата));
	Запрос.УстановитьПараметр("ТД",ТекущаяДата());
	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПервых.Агент,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период,
	                |	ЕСТЬNULL(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Период, уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период) КАК Уволен,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие,
	                |	РАЗНОСТЬДАТ(уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период, ВЫБОР
	                |			КОГДА ЕСТЬNULL(уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие, ЛОЖЬ) = ИСТИНА
	                |				ТОГДА уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Период
	                |			ИНАЧЕ &ТД
	                |		КОНЕЦ, ДЕНЬ) КАК ДлительностьРаботы,
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПервых.Подразделение,
	                |	ВЫБОР
	                |		КОГДА ПОДСТРОКА(уб_ДвижениеФизлицПоПодразделениямСрезПервых.Подразделение.Наименование, 1, 4) = ""М-ОП""
	                |			ТОГДА ИСТИНА
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК этоМастер
	                |ПОМЕСТИТЬ Расчет
	                |ИЗ
	                |	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПервых(
	                |			,
	                |			Подразделение.ТипПодразделения = ЗНАЧЕНИЕ(Перечисление.уб_ТипПодразделения.ТочкаПродаж)
	                |				И НЕ Подразделение.Наименование В (""СВС"", ""Операторы БД"", ""Агентская сеть (без оплаты выезда)"", ""Агентская сеть"", ""Дирекция"", ""Отдел маркетинга"", ""Отдел развития"",""Отдел сопровождения договоров страхования"")) КАК уб_ДвижениеФизлицПоПодразделениямСрезПервых
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	                |		ПО уб_ДвижениеФизлицПоПодразделениямСрезПервых.Агент = уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
	                |ГДЕ
	                |	уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период >= ДАТАВРЕМЯ(2016, 10, 1)
	                |	И уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период >= &Дата1
	                |	И уб_ДвижениеФизлицПоПодразделениямСрезПервых.Период <= &Дата2
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Расчет.Агент,
	                |	Расчет.Период,
	                |	Расчет.Уволен,
	                |	Расчет.Выбытие,
	                |	Расчет.ДлительностьРаботы,
	                |	Расчет.Подразделение,
	                |	ВЫБОР
	                |		КОГДА Расчет.ДлительностьРаботы > 14
	                |			ТОГДА 2000
	                |		ИНАЧЕ 0
	                |	КОНЕЦ КАК БонуcЗа14Дней,
	                |	ВЫБОР
	                |		КОГДА Расчет.ДлительностьРаботы > 91
	                |			ТОГДА 3000
	                |		ИНАЧЕ 0
	                |	КОНЕЦ КАК БонуcЗа3Месяца,
	                |	Расчет.этоМастер
	                |ИЗ
	                |	Расчет КАК Расчет
	                |ГДЕ
	                |	Расчет.ДлительностьРаботы > 14
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Расчет.Агент.Наименование";
	HR     = Справочники.ФизическиеЛица.НайтиПоНаименованию("Ященко Екатерина");
	Мастер = Справочники.ФизическиеЛица.НайтиПоНаименованию("_Мастер Сводные");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.БонуcЗа14Дней>0 и ЗначениеЗаполнено(HR) Тогда
			СтрокаН = ТЧ.Добавить();
			СтрокаН.Сотрудник   = HR;
			СтрокаН.Начисление  = "14 дней работы ["+Выборка.Агент+"]"; 
			СтрокаН.Период      = Дата;
			СтрокаН.Результат	= Выборка.БонуcЗа14Дней;
			
			Если Выборка.ЭтоМастер = Истина и ЗначениеЗаполнено(Мастер) Тогда
				СтрокаН = ТЧ.Добавить();
				СтрокаН.Сотрудник   = Мастер;
				СтрокаН.Начисление  = "За 14 дней работы/после обучения  ["+Выборка.Агент+"]"; 
				СтрокаН.Период      = Дата;
				СтрокаН.Результат	= -Выборка.БонуcЗа14Дней;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.БонуcЗа3Месяца>0 Тогда
			СтрокаН = ТЧ.Добавить();
			СтрокаН.Сотрудник   = HR;
			СтрокаН.Начисление  = "3 месяца работы ["+Выборка.Агент+"]"; 
			СтрокаН.Период      = Дата;
			СтрокаН.Результат	= Выборка.БонуcЗа3Месяца;
			
			Если Выборка.ЭтоМастер = Истина Тогда
				СтрокаН = ТЧ.Добавить();
				СтрокаН.Сотрудник   = Мастер;
				СтрокаН.Начисление  = "3 месяца/после обучения ["+Выборка.Агент+"]"; 
				СтрокаН.Период      = Дата;
				СтрокаН.Результат	= -Выборка.БонуcЗа3Месяца;
			КонецЕсли;
			
		КонецЕсли;

		
	КонецЦикла;	
	
КонецФункции

Функция ТекстВъезда()
	Возврат "ВЫБРАТЬ
	|	уб_ЗаявкаНаВъезд.Ссылка,
	|	уб_ЗаявкаНаВъезд.Стоимость,
	|	уб_ЗаявкаНаВъезд.ДатаВъезда,
	|	уб_ЗаявкаНаВъезд.ДатаВыезда,
	|	уб_ЗаявкаНаВъезд.Часов,
	|	уб_ЗаявкаНаВъезд.ТипВъезда,
	|	ВЫБОР
	|		КОГДА уб_ЗаявкаНаВъезд.ДатаВыезда = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(уб_ЗаявкаНаВъезд.ДатаВъезда, ДЕНЬ), ЧАС, 19)
	|		ИНАЧЕ уб_ЗаявкаНаВъезд.ДатаВыезда
	|	КОНЕЦ КАК ДатаВыезда,
	|	РАЗНОСТЬДАТ(уб_ЗаявкаНаВъезд.ДатаВъезда, ВЫБОР
	|			КОГДА уб_ЗаявкаНаВъезд.ДатаВыезда = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(уб_ЗаявкаНаВъезд.ДатаВъезда, ДЕНЬ), ЧАС, 19)
	|			ИНАЧЕ уб_ЗаявкаНаВъезд.ДатаВыезда
	|		КОНЕЦ, МИНУТА) КАК ЧасовФакт,
	|	уб_ЗаявкаНаВъезд.Заказчик,
	|	уб_ЗаявкаНаВъезд.Заказчик.Наименование КАК ЗаказчикСтрока,
	|	уб_ЗаявкаНаВъезд.Страхователь
	|ПОМЕСТИТЬ Выборка
	|ИЗ
	|	Документ.уб_ЗаявкаНаВъезд КАК уб_ЗаявкаНаВъезд
	|ГДЕ
	|	уб_ЗаявкаНаВъезд.ДатаВъезда >= &Дата1
	|	И уб_ЗаявкаНаВъезд.ДатаВъезда <= &Дата2
	|	И уб_ЗаявкаНаВъезд.ПометкаУдаления = ЛОЖЬ
	|	И уб_ЗаявкаНаВъезд.ТипВъезда <> 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Выборка.Ссылка,
	|	Выборка.Стоимость,
	|	Выборка.ДатаВъезда,
	|	Выборка.ДатаВыезда,
	|	Выборка.Часов,
	|	ВЫБОР
	|		КОГДА Выборка.ЧасовФакт <= 125
	|			ТОГДА 2
	|		КОГДА Выборка.ЧасовФакт / 60 - (ВЫРАЗИТЬ(Выборка.ЧасовФакт / 60 КАК ЧИСЛО(10, 0))) > 0.05
	|			ТОГДА (ВЫРАЗИТЬ(Выборка.ЧасовФакт / 60 КАК ЧИСЛО(10, 0))) + 1
	|		ИНАЧЕ ВЫРАЗИТЬ(Выборка.ЧасовФакт / 60 КАК ЧИСЛО(10, 0))
	|	КОНЕЦ КАК ЧасовФакт,
	|	Выборка.ТипВъезда,
	|	Выборка.Заказчик,
	|	Выборка.ЗаказчикСтрока,
	|	Выборка.Страхователь
	|ПОМЕСТИТЬ Выборка2
	|ИЗ
	|	Выборка КАК Выборка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	выборка2.Заказчик,
	|	выборка2.ЗаказчикСтрока,
	|	выборка2.Ссылка,
	|	ВЫБОР
	|		КОГДА выборка2.ЗаказчикСтрока В (""Мельханова А. А."", ""Панасова Юнона"", ""Панасов Виталий"")
	|			ТОГДА 0
	|		ИНАЧЕ 150 + (выборка2.ЧасовФакт - 2) * 100
	|	КОНЕЦ КАК Стоимость
	|ИЗ
	|	Выборка2 КАК выборка2
	|ГДЕ
	|	ВЫБОР
	|			КОГДА выборка2.ЗаказчикСтрока В (""Мельханова А. А."", ""Панасова Юнона"", ""Панасов Виталий"")
	|				ТОГДА 0
	|			ИНАЧЕ 150 + (выборка2.ЧасовФакт - 2) * 100
	|		КОНЕЦ > 0"
КонецФункции

