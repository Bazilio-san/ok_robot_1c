					Зам = Справочники.ФизическиеЛица.ПустаяСсылка();
					ЗамПолучаетВознаграждение = Ложь;
				Иначе
					Зам = МЗ2.Сотрудник;
					ЗамПолучаетВознаграждение = МЗ2.ПолучаетВознаграждениеЗаРуководство;
					
				КонецЕсли;
				Если ЗамПолучаетВознаграждение Тогда
					СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
					Если Дата>=Дата(2024,7,1) Тогда
						СтрокаВознаграждения.Начисление = ""+ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.НайтиПоКоду("ВознРукОП")+" зам.("+СокрЛП(стрПодразделения.Подразделение)+")";
					Иначе	
						СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.НайтиПоКоду("ВознРукОП");
					КонецЕсли;	
					СтрокаВознаграждения.Период = Дата;
					СтрокаВознаграждения.Результат = стрПодразделения.СуммаВознаграждения_ЗамРОП;
					СтрокаВознаграждения.Сотрудник = Зам;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
		//ДРП
		ЗапросДРП = Новый Запрос;
		ЗапросДРП.Текст = "ВЫБРАТЬ
		                  |	уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.Подразделение,
		                  |	уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.Период,
		                  |	уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.НеДействует,
		                  |	уб_РуководителиПодразделенийСрезПоследних.ПолучаетВознаграждениеЗаРуководство,
		                  |	уб_РуководителиПодразделенийСрезПоследних.Сотрудник
		                  |ИЗ
		                  |	РегистрСведений.уб_ЗП_СхемыВознагражденияРуководителейОП.СрезПоследних(&Дата, ) КАК уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних
		                  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_РуководителиПодразделений.СрезПоследних(&Дата, ) КАК уб_РуководителиПодразделенийСрезПоследних
		                  |		ПО уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.Подразделение = уб_РуководителиПодразделенийСрезПоследних.Подразделение
		                  |ГДЕ
		                  |	уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.СхемаВознагражденияРуководителяОП = ЗНАЧЕНИЕ(Перечисление.уб_ЗП_СхемыВознагражденияРуководителейОП.Алгоритм)
		                  |	И уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.НеДействует = ЛОЖЬ
		                  |	И уб_РуководителиПодразделенийСрезПоследних.ПолучаетВознаграждениеЗаРуководство
		                  |	И уб_РуководителиПодразделенийСрезПоследних.Сотрудник <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)";
	   ЗапросДРП.УстановитьПараметр("Дата",ДатаНачала);
	   
	//И уб_ЗП_СхемыВознагражденияРуководителейОПСрезПоследних.Подразделение.Наименование ="ОП-Купиполис"";
		
		РезДРП = ЗапросДРП.Выполнить();
		Если НЕ РезДРП.Пустой() Тогда
			ПараметрыРасчетаЗП = Новый Структура("НачПериода,КонПериода,ВключитьЗаводы,РабочийРежим",ДатаНачала,ДатаОкончания,Ложь,Истина);
			Отчеты.СтатистикаСКВиКВ.РасчитатьЗП(ПараметрыРасчетаЗП);
		КонецЕсли;	
		
		ВыборкаДРП = РезДРП.Выбрать();
		Пока ВыборкаДРП.Следующий() Цикл
			//Сообщить("Премия ДРП "+ПараметрыРасчетаЗП.ЗП_БезОклада);
			//
			Если ПараметрыРасчетаЗП.За_СКВ_До_Планки_По_Моторам<>0 Тогда
			СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
			СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознДРП_Авто;
			СтрокаВознаграждения.Период = Дата;
			СтрокаВознаграждения.Результат = ПараметрыРасчетаЗП.За_СКВ_До_Планки_По_Моторам;
			СтрокаВознаграждения.Сотрудник = ВыборкаДРП.Сотрудник;
			КонецЕсли;
			//
			Если ПараметрыРасчетаЗП.За_СКВ_До_Планки_По_НЕ_Моторам<>0 Тогда
			СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
			СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознДРП_НеАвто;
			СтрокаВознаграждения.Период = Дата;
			СтрокаВознаграждения.Результат = ПараметрыРасчетаЗП.За_СКВ_До_Планки_По_НЕ_Моторам;
			СтрокаВознаграждения.Сотрудник = ВыборкаДРП.Сотрудник;
			КонецЕсли;
			//
			Если ПараметрыРасчетаЗП.За_СКВ_Сверх_Планки_По_Моторам<>0 Тогда
			СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
			СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознДРП_АвтоСверх;
			СтрокаВознаграждения.Период = Дата;
			СтрокаВознаграждения.Результат = ПараметрыРасчетаЗП.За_СКВ_Сверх_Планки_По_Моторам;
			СтрокаВознаграждения.Сотрудник = ВыборкаДРП.Сотрудник;
			КонецЕсли;
			//
			Если ПараметрыРасчетаЗП.За_СКВ_Сверх_Планки_По_НЕ_Моторам<>0 Тогда
			СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
			СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознДРП_НеАвтоСверх;
			СтрокаВознаграждения.Период = Дата;
			СтрокаВознаграждения.Результат = ПараметрыРасчетаЗП.За_СКВ_Сверх_Планки_По_НЕ_Моторам;
			СтрокаВознаграждения.Сотрудник = ВыборкаДРП.Сотрудник;
			КонецЕсли;
			Если Дата >=Дата(2019,8,1) Тогда
				СтрокаВознаграждения = 	вспВознаграждениеЗаПродажи.Добавить();
				СтрокаВознаграждения.Начисление = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ПоИнтервалам;
				СтрокаВознаграждения.Период = Дата;
				СтрокаВознаграждения.Результат = ПараметрыРасчетаЗП.ЗП_БезОклада;
				СтрокаВознаграждения.Сотрудник = ВыборкаДРП.Сотрудник;
			КонецЕсли;	
		КонецЦикла;
	
		
		Состояние("3 из 4 - Расчет зарплаты менеджеров отдела продаж/штрафы");
		вспВознаграждениеЗаПродажи.Свернуть("Начисление,Период,Сотрудник,Первоначальная","Результат");
		
		вспВознаграждениеЗаПродажи.Сортировать("Сотрудник,Начисление,Период");
		
		_Начисление=ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.НайтиПоКоду("ЗаОшибки");
		ТаблицаШтрафовЗаОшибки = РегистрыСведений.уб_Ошибки.ОшибкиПериода(Дата);
		ТаблицаШтрафовЗаОшибки.Свернуть("Сотрудник,Объект","Штраф");//Ошибок может быть несколько для одного документа, но в начислении мы детально не отслеживаем
		
		Для каждого Строка из ТаблицаШтрафовЗаОшибки Цикл
			Если НЕ Строка.Сотрудник.Пустая() Тогда
				СтрокаВознаграждения = 	вспНачисленияПоДокументам.Добавить();
				СтрокаВознаграждения.Начисление = _Начисление;
				СтрокаВознаграждения.Период = Дата;
				СтрокаВознаграждения.Результат = -Строка.Штраф;
				СтрокаВознаграждения.Сотрудник = Строка.Сотрудник;
				СтрокаВознаграждения.Документ = Строка.Объект;
			КонецЕсли;	
		КонецЦикла;	
		
		//Пропуски на въезд
		ЗапросВ = Новый Запрос;
		ЗапросВ.Текст = ТекстВъезда();  
		ЗапросВ.УстановитьПараметр("Дата1",ДатаНачала);
		ЗапросВ.УстановитьПараметр("Дата2",ДатаОкончания);
		_Начисление =ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВычетЗаВъезд;
		Выборка = ЗапросВ.Выполнить().Выбрать(); 
		пока выборка.Следующий() Цикл
			
			СтрокаВознаграждения = 	вспНачисленияПоДокументам.Добавить();
			СтрокаВознаграждения.Начисление = _Начисление;
			СтрокаВознаграждения.Период     = Дата;
			СтрокаВознаграждения.Результат  = - Выборка.Стоимость;
			СтрокаВознаграждения.Сотрудник  = Выборка.Заказчик;
			СтрокаВознаграждения.Документ   = Выборка.Ссылка;
		КонецЦикла;	
		
		Если Дата>=Дата(2024,1,1) Тогда
			
			ЗапросВ = Новый Запрос;
			ЗапросВ.Текст = ТекстРекомендации();  
			ЗапросВ.УстановитьПараметр("ДатаНачала",ДатаНачала);
			ЗапросВ.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
			_Начисление =ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознЗаРекомендацию;
			_НачислениеКлуб =ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВознЗаПовышенныйКВ;
			Выборка = ЗапросВ.Выполнить().Выбрать(); 
			Пока Выборка.Следующий() Цикл
				Если Выборка.Вознаграждение>0 тогда
					СтрокаВознаграждения = 	вспНачисленияПоДокументам.Добавить();
					СтрокаВознаграждения.Начисление = _Начисление;
					СтрокаВознаграждения.Период     = Дата;
					СтрокаВознаграждения.Результат  = Выборка.Вознаграждение;
					СтрокаВознаграждения.Сотрудник  = Выборка.Менеджер;
					СтрокаВознаграждения.Документ   = Выборка.Заявка;
				КонецЕсли;
				Если Выборка.ЗаКлуб30>0 тогда
					СтрокаВознаграждения = 	вспНачисленияПоДокументам.Добавить();
					Если Дата>=Дата(2025,3,1) Тогда
						СтрокаВознаграждения.Начисление = Выборка.Вид;
					Иначе
						СтрокаВознаграждения.Начисление = _НачислениеКлуб;
					КонецЕсли;	
					СтрокаВознаграждения.Период     = Дата;
					СтрокаВознаграждения.Результат  = Выборка.ЗаКлуб30;
					СтрокаВознаграждения.Сотрудник  = Выборка.Менеджер;
					СтрокаВознаграждения.Документ   = Выборка.Заявка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Конецесли;
	
	//Рассчет курьерского вознагражения
	Если СтруктураПараметров.ВознаграждениеКурьеров Тогда
		Если Дата<Дата(2016,8,1) Тогда
			
			ЗапросЗПКурьеров = Новый Запрос(
			"ВЫБРАТЬ
				|	СЗ.Заявка,
				|	СЗ.Статус
				|ПОМЕСТИТЬ ВТ_Статус
				|ИЗ
				|	РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК СЗ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВЫБОР
				|		КОГДА З.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|		ИНАЧЕ З.Менеджер
				|	КОНЕЦ КАК ИсточникФинансирования,
				|	ВЫБОР
				|		КОГДА З.Курьер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|		ИНАЧЕ З.Курьер
				|	КОНЕЦ КАК Сотрудник,
				|	СУММА(З.ВознаграждениеКурьера) КАК Результат,
				|	&РасчетныйПериод КАК Период,
				|	ВЫБОР
				|		КОГДА З.ИсточникФинансирования = ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Менеджер)
				|			ТОГДА СУММА(З.ОплатитьВКассуЗаВыездКурьера)
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК РезультатДляИсточника,
				|	З.Ссылка КАК Заявка
				|ИЗ
				|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК З
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Статус КАК ВТ_Статус
				|		ПО (ВТ_Статус.Заявка = З.Ссылка)
				|ГДЕ
				|	З.Дата >= &ДатаНач
				|	И З.Дата <= &ДатаКон
				|	И З.Проведен
				|	И З.Утверждено
				|	И НЕ З.Самовыезд
				|	И (З.Дата < ДАТАВРЕМЯ(2013, 11, 1, 0, 0, 0)
				|			ИЛИ НЕ ВТ_Статус.Статус В (ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.СтраховкаНеСостоялась), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗапросНаУдаление), ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.Удалена)))
				|
				|СГРУППИРОВАТЬ ПО
				|	З.ОплатитьВКассуЗаВыездКурьера,
				|	З.Ссылка,
				|	ВЫБОР
				|		КОГДА З.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|		ИНАЧЕ З.Менеджер
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА З.Курьер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|		ИНАЧЕ З.Курьер
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА З.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|				ИЛИ З.ИсточникФинансирования <> ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Менеджер)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|		ИНАЧЕ З.Менеджер
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА З.ИсточникФинансирования <> ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Менеджер)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|		ИНАЧЕ ВЫБОР
				|				КОГДА З.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|						ИЛИ З.ИсточникФинансирования <> ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Менеджер)
				|					ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|				ИНАЧЕ З.Менеджер
				|			КОНЕЦ
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА З.ИсточникФинансирования <> ЗНАЧЕНИЕ(Перечисление.уб_ИсточникиФинансирования.Менеджер)
				|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|		ИНАЧЕ ВЫБОР
				|				КОГДА З.Менеджер = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
				|					ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент)
				|				ИНАЧЕ З.Менеджер
				|			КОНЕЦ
				|	КОНЕЦ,
				|	З.ИсточникФинансирования
				|
				|УПОРЯДОЧИТЬ ПО
				|	Сотрудник,
			    |	ИсточникФинансирования");
	Иначе
		ЗапросЗПКурьеров = Новый Запрос;
		//Текст запроса универсальный для отчетов и документа заявки
		ЗапросЗПКурьеров.Текст = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТекстЗапросаВК(Дата)
