			Параметры.Получатели 	= Контакты;
		Иначе
			Параметры.Получатели 	= "+79133616124";
		КонецЕсли;
		
		Параметры.Тема			= "Рассылка СМС";
		//TODO телефон брать из основной организации
		Если ДополнительныеСвойства.Свойство("ТекстСМС") Тогда
		//Попытка
			Параметры.Сообщение		= ДополнительныеСвойства.ТекстСМС;
		Иначе	
		//Исключение
			Параметры.Сообщение		= "На выезд по страховке назначен "+Курьер+", тел. "+Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТелефонКурьера(Курьер);//89067775770";// "Bыeзд на cтpaxoвкy подтвержден. Для оформления КАСКО необх.: чистый Авто, ПТС, 2 ключa, права вод-лей, №ТО.+74952280942";		
		КонецЕсли;//Попытки;
		
		Попытка //TODO Временно добавлена попытка
			Ответ = "";
			
			
			
			уб_ОбменДанными.SendSMS(Параметры,Ответ);
			Если Найти (Ответ,"Ложь") = 0 Тогда
				Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.Сообщение(Параметры.Сообщение,Менеджер,Номер);
				Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.Сообщение("Результат отправки SMS:"+СтрЗаменить(Ответ,"¶",""),Менеджер,Номер,Ложь);
				///КомментарийСлужебный = СокрЛП(КомментарийСлужебный)+"; "+СтрЗаменить(Ответ,"¶","")+Формат(ТекущаяДата(),"ДФ='dd.MM.yyyy HH:mm:ss'");
			Конецесли;	
		Исключение
			
			Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.Сообщение("Ошибка при отправке SMS",Менеджер,Номер,Ложь);
			
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("ПроверитьИОтправитьСМС(). " + " -- " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина, , ,,"СМС-рассылка.Error.Заявка" );	
		КонецПопытки;
	КонецЕсли;	
	
