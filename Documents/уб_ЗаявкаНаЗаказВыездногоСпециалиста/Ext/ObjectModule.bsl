			//Если ПараметрыСеанса.уб_Константы.ПроверкаЗаявокОтделомКонтроля = Истина Тогда
			//	Предупреждение("Для проведения требуется проверка отделом сопровождения договоров");// Документ будет записан, но не проведен");
