	Для каждого СтрокаМотивации  из  врМотивация Цикл
		Если СтрокаМотивации.ЧастьКлиента<>0 Тогда
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ОтКлиентаЗаВыезд;
			СтрокаР.Уточнение     = СтрокаМотивации.ВидМотивации;
			СтрокаР.СуммаКлиент   = СтрокаМотивации.ЧастьКлиента;
			СтрокаР.СуммаМенеджер = 0;
			СтрокаР.СуммаБрокер   = 0;
			СтрокаР.СуммаБрокерВС = 0;
			СтрокаР.УидСтроки = СсылкаДокумента.УникальныйИдентификатор();
		КонецЕсли;
		Если СтрокаМотивации.ЧастьБрокера<>0 Тогда
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ОтБрокераЗаВыезд;
			СтрокаР.Уточнение     = СтрокаМотивации.ВидМотивации;
			СтрокаР.СуммаКлиент   = 0;
			СтрокаР.СуммаМенеджер = 0;
			СтрокаР.СуммаБрокер   = 0;
			СтрокаР.СуммаБрокерВС = СтрокаМотивации.ЧастьБрокера;
			СтрокаР.УидСтроки = СсылкаДокумента.УникальныйИдентификатор();
		КонецЕсли;
		Если СтрокаМотивации.ЧастьМенеджера<>0 Тогда
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ОтМенеджераЗаВыезд;
			СтрокаР.Уточнение     = СтрокаМотивации.ВидМотивации;
			СтрокаР.СуммаКлиент   = 0;
			СтрокаР.СуммаМенеджер = СтрокаМотивации.ЧастьМенеджера;
			СтрокаР.СуммаБрокер   = 0;
			СтрокаР.СуммаБрокерВС = 0;
			СтрокаР.УидСтроки = СсылкаДокумента.УникальныйИдентификатор();
		КонецЕсли;
	КонецЦикла;	
	
	
	Возврат ТаблицаРасчетов;
	
	
