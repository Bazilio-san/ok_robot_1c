	"ВЫБРАТЬ
	|	З.Дата,
	|	З.ВознаграждениеКурьера,
	|	З.Утверждено,
	|	З.Курьер,
	|	З.Менеджер,
	|	З.ПометкаУдаления,
	|	З.Ссылка,
	|	З.Каско,
	|	З.Осаго,
	|	З.НС,
	|	З.ДМС,
	|	З.ДК,
	|	З.Утверждено КАК Утверждено1,
	|	З.ТипВыезда,
	|	З.Номер,
	|	З.Контакты,
	|	З.Курьер.Код как КурьерКод
