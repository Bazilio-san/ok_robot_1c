Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	ТабПФ = уб_ПФ.ПустаяТЗСтруктурыПФ();
	СтрТабПФ = ТабПФ.Добавить();
	СтрТабПФ.КодПФ			= "Макет";
	СтрТабПФ.Наименование	= "Заявка";
	СтрТабПФ.ПоУмолчанию = Истина;
	СтрТабПФ.Действовала = Ложь;
	Возврат ТабПФ;

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

// Процедура обработчик события ПередЗаписью документа
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
