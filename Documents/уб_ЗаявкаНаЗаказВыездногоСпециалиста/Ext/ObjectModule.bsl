#Область Печать

Функция ПечатьМакетов(Кнопка,Параметры = Неопределено) Экспорт

	Если ТипЗнч(Кнопка) = Тип("Строка") Тогда
		ИмяКнопки = Кнопка;
	Иначе	
		ИмяКнопки = Кнопка.Имя;
	КонецЕсли;	
	
	ИмяКнопки = СтрЗаменить(ИмяКнопки,"ВыполнитьКомандуПечати_","");
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;	
	Если ИмяКнопки = "Макет" Тогда
		//Встроенные формы
		 ТабличныйДокумент = документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.Печать(Новый Структура("ПечататьАктПеремещения",ЛОЖЬ),Ссылка);
	Иначе
		ТабличныйДокумент =  Уб_ВызовСервера.ПечатьВнешнейФормы(Ссылка,ИмяКнопки,Параметры);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

Процедура СинхронизацияДатыВремени() Экспорт
	
	Если ВремяВстречиКлиент<>Дата(1,1,1) и НачалоДня(ВремяВстречиКлиент)<> НачалоДня(Дата) Тогда
		_ВремяВстречиКлиент = НачалоДня(Дата)+ (ВремяВстречиКлиент-НачалоДня(ВремяВстречиКлиент));
		Если _ВремяВстречиКлиент<>ВремяВстречиКлиент Тогда
			ВремяВстречиКлиент = _ВремяВстречиКлиент;
		КонецЕсли;
	Иначе
		Дата = ВремяНачало; 
	КонецЕсли;	
	Если ВремяОкончанияКлиент<>Дата(1,1,1) и НачалоДня(ВремяОкончанияКлиент)<> НачалоДня(Дата) Тогда
		_ВремяОкончанияКлиент = НачалоДня(Дата)+ (ВремяОкончанияКлиент-НачалоДня(ВремяОкончанияКлиент));
		Если _ВремяОкончанияКлиент<>ВремяОкончанияКлиент Тогда
			ВремяОкончанияКлиент = _ВремяОкончанияКлиент;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры
	
