Функция РасчетВознагражденияКурьера(ПараметрыСотрудника) Экспорт //Новый регламент с учетом категории курьера
	//ОбновитьПараметры(_Источник) Экспорт
	ПараметрыСВС = уб_РасчетыСМенеджерами.ПараметрыСВС(Курьер,КонецДня(Дата));

	ДополнительныеСвойства.Вставить("СВС",              ПараметрыСВС.СВС);
	ДополнительныеСвойства.Вставить("ТипПодразделения", ПараметрыСВС.ТипПодразделения);
	ДополнительныеСвойства.Вставить("ВнешнееСВС",ПараметрыСВС.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя);
	_Комиссия =0;
	СКВ = РасчетСКВПоЗаявке(_Комиссия);
	ДополнительныеСвойства.Вставить("СКВ",СКВ);	
	ДополнительныеСвойства.Вставить("Комиссия",_Комиссия);	

	Прч = Перечисления.уб_ТипВыезда;
	ПосчитатьПолиса(); //Расчет количества по видам (осаго каско)
	СКВ = 0; //РасчетСКВПоЗаявке();
	
	ДополнительныеСвойства.Вставить("СКВ",СКВ);
	Если Самовыезд 
		ИЛИ Тип = Прч.Административный 
		ИЛИ ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Курьер Тогда
		Если Мотивация.Количество() >0 Тогда
			Мотивация.Очистить();//Возможно есть ситуации, когда это не требуется, но пока очищаем
		КонецЕсли;
		ИтогиМотивацииОбъект(Неопределено,ЛОЖЬ);
		СКВ = РасчетСКВПоЗаявке(_Комиссия);
		ДополнительныеСвойства.Вставить("СКВ",СКВ);
		ДополнительныеСвойства.Вставить("Комиссия",_Комиссия);
		Возврат 0;
	ИначеЕсли Дата>Дата(2018,1,1) 
		и (Адрес ="Офис" 
		или Адрес ="офис"
		или Адрес ="Краснопролетарская ул. 16 стр. 1"
		или Адрес ="Большая Новодмитровская дом 23, корп 6")
		или уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("Оплата курьеру",Курьер,Дата,-1) = 0
		Тогда
		Если Мотивация.Количество() >0 Тогда
			Мотивация.Очистить();//Возможно есть ситуации, когда это не требуется, но пока очищаем
		КонецЕсли;
		Если Не ЗаблокироватьАвторасчет = Истина Тогда
			ЗаблокироватьАвторасчет = Истина;
		КонецЕсли;
		Если ВознаграждениеОтКлиента>0 Тогда 
			#Если Клиент Тогда
				Предупреждение("При адресе ""Офис"" вознаграждение с клиента не учитывается"); 
			#КонецЕсли	
		КонецЕсли;	
		ИтогиМотивацииОбъект(Неопределено,ЛОЖЬ);
		СКВ = РасчетСКВПоЗаявке(_Комиссия);
		ДополнительныеСвойства.Вставить("Комиссия",_Комиссия);
		ДополнительныеСвойства.Вставить("СКВ",СКВ);
	ИначеЕсли уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("Оплата курьеру",Курьер,Дата,-1)<>0 и ЗаблокироватьАвторасчет=Истина Тогда	
		ЗаблокироватьАвторасчет = Ложь;
	КонецЕсли;	
	Если Дата<Дата(2014,10,1) 
		ИЛИ ЗаблокироватьАвторасчет = Истина
		//ИЛИ Утверждено = Истина
		//ИЛИ (НЕ СтатусЗаявки.Пустая() И Перечисления.уб_СтатусыЗаявок.Индекс(СтатусЗаявки) >= 4)
		Тогда
		Возврат 0;
	КонецЕсли;	
	
	//Если Ссылка.УтвержденоДата<>Дата(1,1,1)  Тогда
	//	Если РольДоступна("ПолныеПрава") Тогда
	//		Возврат 0;
	//	КонецЕсли;
	//КонецЕсли;	
	Если ПараметрыСотрудника.НеОплачиваютВыезд = Истина 
		//и НЕ НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная
		и НЕ ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Брокер Тогда
		ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Брокер;
	КонецЕсли;
	Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Брокер  Тогда
		КолонкаИсточника = "ЧастьБрокера";
	ИначеЕсли ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент  Тогда
		КолонкаИсточника = "ЧастьКлиента";	
	Иначе
		КолонкаИсточника = "ЧастьМенеджера";	
	КонецЕсли;	
	
	Категория   = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("Категория",Курьер,Дата,3);
	
	//Сообщить("Категория "+Категория);
	//суммы
	Структура = Новый Структура;
	
	ЧастьМенеджера = 0;
	ЧастьБрокера   = 0;
	ВремМотивация  = Мотивация.Выгрузить();
	ВремМотивация.Очистить();
	//СКВ = РасчетСКВПоЗаявке();
	Если ПоказателиРасчетаЗП = Неопределено Тогда
		ПоказателиРасчетаЗП = уб_РасчетыСМенеджерами.ПоказателиРасчетаЗП(КонецМесяца(Дата));
	КонецЕсли;	
	
	Если Дата < Дата(2016,8,1) Тогда
		ТаблицаМотивации = ТаблицаМотивации(Категория);
		Если Тип = Прч.ОчереднойВзнос Тогда
			Мотивация("Получение второго взноса",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
		ИначеЕсли Тип = Прч.ПервичныйОсмотр ИЛИ Тип = Прч.ПереОсмотр  Тогда
			Мотивация("Фото ТС",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
		Иначе	
			//остальное - СТРАХОВКА зависит от типа полиса	
			
			
			//Сообщить(Выборка.Каско);	
			//Сообщить(Выборка.Осаго);	
			//Сообщить(Выборка.НС);	
			//БАЗОВАЯ ЧАСТЬ
			Если ДополнительныеСвойства.Каско>0 и ДополнительныеСвойства.Осаго>0 Тогда
				Мотивация("Оформление КАСКО+ОСАГО",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
			ИначеЕсли ДополнительныеСвойства.Каско>0 Тогда	
				Мотивация("Оформление КАСКО",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
			ИначеЕсли ДополнительныеСвойства.Осаго>0 Тогда	
				Мотивация("Выезд по оформлению полисов ОСАГО",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
			КонецЕсли;	
			//
			Если ДополнительныеСвойства.НС>0 Тогда	
				Мотивация("НС",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
			КонецЕсли;	
			//ДопКАСКО
			Если ДополнительныеСвойства.Каско > 1 Тогда
				
				Мотивация("Дополнительный полис КАСКО",Категория,ДополнительныеСвойства.Каско-1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
				
			КонецЕсли;	
			//
			
			Если НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная Тогда
				Мотивация("Личная",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
			КонецЕсли;	
		КонецЕсли;		
		Если За10КмОтМКАД Тогда
			Мотивация("За 10 км от МКАД",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
		КонецЕсли;	
		
		_ОплатитьВКассуЗаВыездКурьера = ВремМотивация.Итог("ЧастьМенеджера");
		_ВознаграждениеЧастьКлиента   = ВремМотивация.Итог("ЧастьКлиента");
		_ВознаграждениеЧастьБрокера   = ВремМотивация.Итог("ЧастьБрокера");
		_ВознаграждениеКурьера        = _ОплатитьВКассуЗаВыездКурьера + _ВознаграждениеЧастьКлиента + _ВознаграждениеЧастьБрокера;
		МинималкаКурьер = ПоказателиРасчетаЗП.МинСтоимостьВыездаКурьера;
	Иначе
		//Расчет с 01.08.2016
		Если НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная и ПараметрыСотрудника.НеОплачиваютВыезд = Ложь Тогда
			Мотивация("Личная",Категория,1,ТаблицаМотивации,ВремМотивация,КолонкаИсточника,СКВ);
		КонецЕсли;	
		Если Дата > Дата(2019,3,1) Тогда
			СтрокаП = ВремМотивация.Добавить();
			СтрокаП.ВидМотивации      = "Клиент";
			СтрокаП.ЧастьМенеджера   = ВознаграждениеОтМенеджера; //Внесено руками
		КонецЕсли;	
		//Если Дата > Дата(2019,1,1) и ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
		//	СтрокаП = ВремМотивация.Добавить();
		//	СтрокаП.ВидМотивации      = "Клиент";
		//	СтрокаП.ЧастьКлиента   = ВознаграждениеЧастьКлиента; //Внесено руками
		//КонецЕсли;	
		
		_ОплатитьВКассуЗаВыездКурьера = ВремМотивация.Итог("ЧастьМенеджера");
		_ВознаграждениеЧастьКлиента   = ВремМотивация.Итог("ЧастьКлиента");
		_ВознаграждениеЧастьБрокера   = ВремМотивация.Итог("ЧастьБрокера");
		//_ВознаграждениеКурьера        = _ОплатитьВКассуЗаВыездКурьера + _ВознаграждениеЧастьКлиента + _ВознаграждениеЧастьБрокера;
		
		Если ДополнительныеСвойства.ВнешнееСВС = Истина Тогда
			_ВознаграждениеКурьера = 0;
		Иначе	
			
			Если ЭтоНовый() Тогда
				СсылкаНового = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПолучитьСсылку(Новый УникальныйИдентификатор);
			Иначе	
				СсылкаНового = Ссылка;
			КонецЕсли;	
			//_ВознаграждениеКурьера = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВКОтСтатусаИКоличества(СсылкаНового,Дата);	
			_ВознаграждениеКурьера = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВКОтСтатусаИКоличества(ЭтотОбъект,Дата);	
		КонецЕсли;	
		МинималкаКурьер = 0;//ПоказателиРасчетаЗП.МинСтоимостьВыездаКурьера;//?(ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент,250,ПоказателиРасчетаЗП.МинСтоимостьВыездаКурьера);
		
	КонецЕсли;
	
	//Оценка надбавки
	Если Не ПараметрыСотрудника.НеПроверятьСрочность = Истина 
		И	ДатаСоздания >= Дата(2016,7,7) 
		//И НЕ НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная
		Тогда
		ВидСрочнойМотивации = "Срочный выезд";
		Если Срочная  Тогда//Если скв от 1000 до 3350, за срочность не идет
			Если ДатаСоздания < Дата(2017,4,1) Тогда
				Если НЕ (СКВ >= 1000 и СКВ<=3350) Тогда
					Если  Тип   = Перечисления.уб_ТипВыезда.ОчереднойВзнос 
						или Тип = Перечисления.уб_ТипВыезда.ПервичныйОсмотр
						или Тип = Перечисления.уб_ТипВыезда.Переосмотр
						Тогда
						НадбавкаСрочность = 200;
					ИначеЕсли ДополнительныеСвойства.Каско>0 Тогда
						НадбавкаСрочность = 500;
					Иначе
						НадбавкаСрочность = 200;
					КонецЕсли;	
				Иначе
					НадбавкаСрочность = 0;
				КонецЕсли;
				
			Иначе
				Если Тип = Перечисления.уб_ТипВыезда.ОчереднойВзнос Тогда
					НадбавкаСрочность = 100;
					ВидСрочнойМотивации = "За срочный очередной взнос";
				ИначеЕсли Тип = Перечисления.уб_ТипВыезда.ПервичныйОсмотр и ОплачиваемыйОсмотр Тогда
					ВидСрочнойМотивации = "За оплачиваемый осмотр";
					НадбавкаСрочность = 100;
				ИначеЕсли Каско>0 и Тип <> Перечисления.уб_ТипВыезда.Административный и Тип <> Перечисления.уб_ТипВыезда.Перепись Тогда
					НадбавкаСрочность = 500;	
					ВидСрочнойМотивации = "За срочное КАСКО";
				ИначеЕсли Осаго>0 и Тип <> Перечисления.уб_ТипВыезда.Административный и Тип <> Перечисления.уб_ТипВыезда.Перепись Тогда
					НадбавкаСрочность = 200;		
					ВидСрочнойМотивации = "За срочное ОСАГО";
				ИначеЕсли ДК>0 и Тип <> Перечисления.уб_ТипВыезда.Административный и Тип <> Перечисления.уб_ТипВыезда.Перепись Тогда
					ВидСрочнойМотивации = "За срочную ДК";
					НадбавкаСрочность = 100;			
				Иначе
					НадбавкаСрочность = 0;
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Если Тип = Перечисления.уб_ТипВыезда.ПервичныйОсмотр и ОплачиваемыйОсмотр Тогда
				ВидСрочнойМотивации = "За оплачиваемый осмотр";
				НадбавкаСрочность = 100;
			Иначе		
				НадбавкаСрочность = 0;	
			КонецЕсли;	
		КонецЕсли;
		
	Иначе
		
		//без изменений
		НадбавкаСрочность  = 0; 
	КонецЕсли;

	Если Дата > Дата(2016,8,1) Тогда
		СтрокаМ = ВремМотивация.Добавить();
		СтрокаМ.ВидМотивации = "Вознаграждение курьера";
		Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
			
			Если Дата < Дата(2019,1,1) Тогда
				СтрокаМ.ЧастьКлиента  = ?(НадбавкаСрочность=500,0,250-НадбавкаСрочность);
			Иначе
				Если Дата > Дата(2022,11,1) и ВознаграждениеОтКлиента>0 и ВознаграждениеОтКлиента<=НадбавкаСрочность Тогда
					НадбавкаСрочность = НадбавкаСрочность-ВознаграждениеОтКлиента;
					СтрокаМ.ЧастьКлиента = ВознаграждениеОтКлиента;
				Иначе	
					Если ВознаграждениеОтКлиента>НадбавкаСрочность Тогда
						НадбавкаСрочность = 0;
					КонецЕсли;	
					СтрокаМ.ЧастьКлиента  = ?(НадбавкаСрочность=500,0,ВознаграждениеОтКлиента-НадбавкаСрочность);
				КонецЕсли;	
			КонецЕсли;	
			СтрокаМ.ЧастьБрокера  = _ВознаграждениеКурьера-СтрокаМ.ЧастьКлиента;
		ИначеЕсли ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Менеджер 
			или ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Брокер 
			Тогда
			//расчитано выше
			СтрокаМ.ЧастьБрокера = _ВознаграждениеКурьера;
		КонецЕсли;	
	Иначе	
		//КОНТРОЛЬ МИНИМАЛЬНОГО ВОЗНАГРАЖДЕНИЯ
		Если _ВознаграждениеКурьера < МинималкаКурьер 
			и НЕ ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Курьер 
			и ДополнительныеСвойства.ВнешнееСВС = Ложь
			Тогда
			_ВознаграждениеКурьера = МинималкаКурьер;
			//Распределяется разница
			СтрокаМ = ВремМотивация.Добавить();
			СтрокаМ.ВидМотивации = "Минимальный выезд";
			Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
				Если Дата > Дата(2016,8,1) Тогда
					_ВознаграждениеКурьера      =  250;
				КонецЕсли;
				_ВознаграждениеЧастьБрокера = -(_ВознаграждениеКурьера-МинималкаКурьер);
				
				_ВознаграждениеЧастьКлиента = _ВознаграждениеКурьера-_ВознаграждениеЧастьБрокера-_ОплатитьВКассуЗаВыездКурьера;
				СтрокаМ.ЧастьКлиента  = _ВознаграждениеКурьера;//_ВознаграждениеЧастьКлиента;
				СтрокаМ.ЧастьБрокера  = _ВознаграждениеЧастьБрокера;
			ИначеЕсли ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Менеджер Тогда
				//_ОплатитьВКассуЗаВыездКурьера = _ВознаграждениеКурьера-_ВознаграждениеЧастьБрокера-_ВознаграждениеЧастьКлиента;
				СтрокаМ.ЧастьМенеджера = _ВознаграждениеКурьера;
			ИначеЕсли ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Брокер Тогда
				//_ВознаграждениеЧастьБрокера = _ВознаграждениеКурьера-_ОплатитьВКассуЗаВыездКурьера-_ВознаграждениеЧастьКлиента;	
				СтрокаМ.ЧастьБрокера = _ВознаграждениеКурьера;//_ВознаграждениеЧастьБрокера;
			Конецесли;	
		КонецЕсли;
	КонецЕсли;
	//Коррекция для менеджера в зависимости от времени назначения
	//РазностьУтвержденияИВыезда = Дата-УтвержденоДата;
	//Если УтвержденоДата <>Дата(1,1,1) и (РазностьУтвержденияИВыезда > 0) 
	//	И (ДополнительныеСвойства.Каско>0 или ДополнительныеСвойства.Осаго>0) 
	//	и ДатаСоздания > Дата(2016,6,17)
	//	И НЕ НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная Тогда
	//	
	//	Если (РазностьУтвержденияИВыезда)>(24*3600)  Тогда
	//		СуммаМенеджер = 0;
	//	Иначе
	//		СуммаМенеджер = ?(ДополнительныеСвойства.Каско>0,ПоказателиРасчетаЗП.СтоимостьКАСКОМенеджер,ПоказателиРасчетаЗП.СтоимостьОСАГОМенеджер);//Взять из регистра	
	//	КонецЕсли;
		
	Если НадбавкаСрочность>0 Тогда
		ИтогоСуммаМенеджер = ВремМотивация.Итог("ЧастьМенеджера");
		
		Если Дата > Дата(2016,8,1) Тогда
			//НадбавкаСрочность = НадбавкаСрочность-ВознаграждениеОтКлиента;
			Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Менеджер Тогда
				СтрокаМ = ВремМотивация.Добавить();
				СтрокаМ.ВидМотивации = ВидСрочнойМотивации;		
		        СтрокаМ.ЧастьМенеджера = НадбавкаСрочность;
				//разница уходит брокеру
				СтрокаМ.ЧастьБрокера   = -СтрокаМ.ЧастьМенеджера;
			ИначеЕсли ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
				СтрокаМ = ВремМотивация.Добавить();
				СтрокаМ.ВидМотивации = ВидСрочнойМотивации;		
				СтрокаМ.ЧастьМенеджера  = НадбавкаСрочность;
		        СтрокаМ.ЧастьКлиента = ВознаграждениеОтКлиента;
				//разница уходит брокеру
				СтрокаМ.ЧастьБрокера   = -СтрокаМ.ЧастьКлиента-СтрокаМ.ЧастьМенеджера;
			КонецЕсли;
		Иначе
			//Старый вариант
			Если ИтогоСуммаМенеджер=0 Тогда
				// самовыезд или прочие
				Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
					ИтогоКлиент = ВремМотивация.Итог("ЧастьКлиента");
					НадбавкаСрочность = Макс(ИтогоКлиент,НадбавкаСрочность);
					Если ИтогоКлиент>0 Тогда
						Для Каждого СтрокаМ Из ВремМотивация  Цикл
							БылоЧастьКлиент      = СтрокаМ.ЧастьКлиента;  
							//Делим пропорционально
							СтрокаМ.ЧастьКлиента = НадбавкаСрочность * СтрокаМ.ЧастьКлиента/ИтогоКлиент;
							//разница уходит брокеру
							СтрокаМ.ЧастьБрокера   = СтрокаМ.ЧастьБрокера+ (БылоЧастьКлиент-СтрокаМ.ЧастьКлиента);
						КонецЦикла;		
					КонецЕсли;
				КонецЕсли;
			Иначе
				Для Каждого СтрокаМ Из ВремМотивация  Цикл
					БылоЧастьМенеджер      = СтрокаМ.ЧастьМенеджера;  
					//Делим пропорционально
					СтрокаМ.ЧастьМенеджера = НадбавкаСрочность *СтрокаМ.ЧастьМенеджера/ИтогоСуммаМенеджер;
					//разница уходит брокеру
					СтрокаМ.ЧастьБрокера   = СтрокаМ.ЧастьБрокера+ (БылоЧастьМенеджер-СтрокаМ.ЧастьМенеджера);
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Сумма = ЧастьМенеджера + ЧастьБрокера;
	//Сообщить(ЧастьМенеджера);
	//Сообщить(ЧастьБрокера);
	Если ВремМотивация.Итог(КолонкаИсточника)<> Мотивация.Итог(КолонкаИсточника)
		или ВремМотивация.Итог("ЧастьБрокера")<> Мотивация.Итог("ЧастьБрокера")
		Тогда
		//Кому можно перезаписывать данные
		Мотивация.Загрузить(ВремМотивация);
	КонецЕсли;	
	//Возврат Макс(Сумма, ПоказателиРасчетаЗП.МинСтоимостьВыездаКурьера);
    ИтогиМотивацииОбъект(Неопределено,Ложь);
	СКВ = РасчетСКВПоЗаявке();
	ДополнительныеСвойства.Вставить("СКВ",СКВ);
КонецФункции // РасчетВознагражденияКурьера()


Процедура ПосчитатьПолиса() Экспорт
	ДополнительныеСвойства.Вставить("Каско",0);
	ДополнительныеСвойства.Вставить("Осаго",0);
	ДополнительныеСвойства.Вставить("НС",0);
	ДополнительныеСвойства.Вставить("Прочие",0);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	БСО.НомерСтроки,
		|	БСО.ВидБСО,
		|	БСО.Количество
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЗБСО КАК БСО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.НомерСтроки КАК НомерСтроки,
		|	ВТ_ТЧ.ВидБСО,
		|	ЕСТЬNULL(С.Наименование, ""Вид СП"") КАК Наименование,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ТЧ.ВидБСО) = ТИП(Перечисление.уб_ВидыСтраховыхПродуктов)
		|				ТОГДА ВТ_ТЧ.ВидБСО
		|			ИНАЧЕ ЕСТЬNULL(СП.Ссылка.Вид, ""Прочее"")
		|		КОНЕЦ) КАК Вид,
		|	МАКСИМУМ(ВТ_ТЧ.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Виды
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.уб_СтраховыеПродукты.ВидыБСО КАК СП
		|		ПО ВТ_ТЧ.ВидБСО = СП.ВидБСО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.уб_ВидыБСО КАК С
		|		ПО ВТ_ТЧ.ВидБСО = С.Ссылка
		|ГДЕ
		|	СП.Ссылка есть null или НЕ СП.Ссылка.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТЧ.НомерСтроки,
		|	ВТ_ТЧ.ВидБСО,
		|	ЕСТЬNULL(С.Наименование, ""Вид СП"")
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	99,
		|	ЗНАЧЕНИЕ(Справочник.уб_ВидыБСО.ПустаяСсылка),
		|	""Квитанция"",
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(уб_СтраховойПолис.СтраховойПродукт) = ТИП(Справочник.уб_СтраховыеПродукты)
