		|	ВТ_ТЧ.ПредоставленнаяСкидка,
		|	ВТ_ТЧ.ПредоставленнаяСкидкаПроцент,
		|	ВТ_ТЧ.ЛимитОтветственности,
		|	ВТ_ТЧ.Основной,
		|	ВТ_ТЧ.Расчетчик,
		|	ВТ_ТЧ.ДопСоглашение,
		|	ВТ_ТЧ.ИтогСтраховаяПремия,
		|	ВТ_ТЧ.ИтогПредоставленнаяСкидка,
		|	ВТ_ТЧ.МаркаТС,
		|	ВТ_ТЧ.МодельТС,
		|	ВТ_ТЧ.Франшиза,
		|	ВТ_ТЧ.РассрочкаПлатежа,
		|	ВТ_ТЧ.БезубыточныйПереход,
		|	ВТ_ТЧ.СуммаВзноса,
		|	ВТ_ТЧ.ФормаОплаты,
		|	ВТ_ТЧ.Агрегатная,
		|	ВТ_ТЧ.НомерВзноса,
		|	ВТ_ТЧ.ИтогСуммаВзноса,
		|	ВТ_ТЧ.ДругиеДокументы
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсключаемыеВидыБСО КАК ВТ_ИсключаемыеВидыБСО
		|		ПО ВТ_ТЧ.ВидБСО = ВТ_ИсключаемыеВидыБСО.ВидБСО
		|ГДЕ
		|	ВТ_ТЧ.Количество - ЕСТЬNULL(ВТ_ИсключаемыеВидыБСО.Количество, 0) > 0";
		Запрос.УстановитьПараметр("ДанныеЗаполнения", ДанныеЗаполнения);
		Пакет = Запрос.ВыполнитьПакет();
		Выборка = Пакет[2].Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка,,"Номер, НомерЗаявки, Автор, ДатаСоздания, Модификатор, ДатаИзменения, Проведен");
			ВыборкаТЧБСО = Пакет[4].Выбрать();
			Пока ВыборкаТЧБСО.Следующий() Цикл
				СтрокаТЧ = БСО.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ВыборкаТЧБСО);
			КонецЦикла;
		КонецЕсли;
		ДополнительныеСвойства.Вставить("ЭтоКопировани");
	ИначеЕсли ТипЗнчДанныеЗаполнения = Тип("ДокументСсылка.уб_ЗаявкаНаПечать") Тогда
		//
		Дата = ТекущаяДата();
		Тип = Перечисления.уб_ТипВыезда.Страховка;
		//Если Перечисления.уб_СтатусыЗаявкиНаПечать.Индекс(ДанныеЗаполнения.СтатусЗаявки) < 4 Тогда
		//	ДополнительныеСвойства.Вставить("ЗакрытьФорму",Истина);
		//	#Если Клиент Тогда
		//	Предупреждение("Статус заявки на печать не позволяет создать Заявку на выезд");
		//	#КонецЕсли
		//	Возврат;
		//КонецЕсли;	
		СозданНаОсновании = ДанныеЗаполнения;
		
		ДанныеПоЗаявке  = Документы.уб_ЗаявкаНаПечать.Данные(ДанныеЗаполнения);
		ЗаявкаШапка     = ДанныеПоЗаявке[0].Выбрать();
		ЗаявкаШапка.Следующий();
		ЗаявкаБСО       = ДанныеПоЗаявке[1].Выгрузить();
		ЗаявкаПараметры = ДанныеПоЗаявке[2].Выгрузить();
		
		СК = ЗаявкаШапка.СК;
		
		ЗаявкаОбъект = ДанныеЗаполнения.ПолучитьОбъект();
		ЗаявкаДанные = Неопределено;
		ЗаявкаОбъект.ПодготовитьДанные("НомерСессииНеВажен",ЗаявкаДанные);
		Менеджер  = ЗаявкаШапка.Менеджер;
		Если ЗначениеЗаполнено(Менеджер) = ЛОЖЬ Тогда
			Менеджер = ПараметрыСеанса.уб_ТекущееФизЛицо;
		КонецЕсли;	
		МестоВстречи = "";
		Город = ЗначениеПараметраЗаявки("СтраховательНаселенныйПунктФакт",ЗаявкаДанные);
		Если ПустаяСтрока(Город) Тогда
			Город = ЗначениеПараметраЗаявки("СтраховательГородФакт",ЗаявкаДанные);
		КонецЕсли;	
		Страхователь = ЗначениеПараметраЗаявки("СтраховательПодменаСсылки",ЗаявкаДанные);
		Для каждого СтрокаБСОИсточник из ЗаявкаБСО Цикл
			СтрокаБСО = БСО.Добавить();
			СтрокаБСО.ВидБСО = СтрокаБСОИсточник.ВидБСО; 
			СтрокаБСО.СК     = СтрокаБСОИсточник.СК;
			СтрокаБСО.ВидСП  = ЗаявкаШапка.ВидСП;
			СтрокаБСО.Количество = 1;
			СтрокаБСО.МаркаТС  = ЗначениеПараметраЗаявки("ОбъектСтрахованияМаркаТС",ЗаявкаДанные);
			СтрокаБСО.МодельТС = ЗначениеПараметраЗаявки("ОбъектСтрахованияМодельТС",ЗаявкаДанные);
			СтрокаБСО.СтраховаяПремия  = ЗначениеПараметраЗаявки("СтраховаяПремияВсего",ЗаявкаДанные);
			СтрокаБСО.СуммаВзноса      = СтрокаБСО.СтраховаяПремия;
			СтрокаБСО.ИтогСуммаВзноса  = СтрокаБСО.СтраховаяПремия;
			СтрокаБСО.ИтогСтраховаяПремия = СтрокаБСО.СтраховаяПремия;
			СтрокаБСО.Курс = 1;
			СтрокаБСО.Кратность = 1;
			СтрокаБСО.ЛимитОтветственности = ЗначениеПараметраЗаявки("СтраховаяСумма",ЗаявкаДанные);
			СтрокаБСО.ОрганизацияАгент   = СтрокаБСОИсточник.ОрганизацияАгент;
			//СтрокаБСО
		КонецЦикла;	
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеПараметраЗаявки(ИМЯ,ЗаявкаПараметры)
	нСтроки = ЗаявкаПараметры.НайтиСтроки(Новый Структура("Параметр",Имя));
	Если нСтроки.Количество()= 0 Тогда
		Сообщить("Не найден параметр с именем "+Имя);
	Иначе
		Возврат нСтроки[0].Значение 
	КонецЕсли;	
КонецФункции	


