Функция Мотивация(ВидМотивации, Категория, Количество = 1,ТаблицаМотивации = Неопределено,ПолучательДанных = Неопределено,КолонкаИсточника = "ЧастьМенеджера",СКВ = 0)
	Если ТаблицаМотивации = Неопределено Тогда
		ТаблицаМотивации = ТаблицаМотивации(Категория);
	КонецЕсли;	
	мСтрок = ТаблицаМотивации.НайтиСтроки(Новый Структура("ВидМотивации,Категория",ВидМотивации,Категория));
	Если мСтрок.Количество() = 0 Тогда
		ЧастьМенеджера = 0;
		ЧастьБрокера   = 0;
		Возврат 0;
	Иначе
		//
		Если ДатаСоздания<Дата(2017,4,1) и СКВ >= 1000 и СКВ <= 3350 и (НомерЗаявки <> Перечисления.уб_ВидыЗаявок.Личная и НомерЗаявки <> Перечисления.уб_ВидыЗаявок.Агентская)   Тогда
			//Всё за счет брокера
			ЧастьМенеджера = 0;
			ЧастьБрокера   = мСтрок[0].ЧастьМенеджера; //мСтрок[0].ЧастьБрокера не оплачивается
		Иначе
			ЧастьМенеджера = мСтрок[0].ЧастьМенеджера;
			ЧастьБрокера   = мСтрок[0].ЧастьБрокера;
		КонецЕсли;
		Если НЕ ПолучательДанных = Неопределено Тогда 
			СтрокаП = ПолучательДанных.Добавить();
			СтрокаП.ВидМотивации      = ВидМотивации;
			Если НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная и ВидМотивации = "Личная" Тогда
				СтрокаП["ЧастьМенеджера"] = ЧастьМенеджера*Количество;	
			Иначе
				СтрокаП[КолонкаИсточника] = ЧастьМенеджера*Количество;	
			КонецЕсли;
			
			СтрокаП.ЧастьБрокера      = ЧастьБрокера*Количество;
			Если КолонкаИсточника = "ЧастьКлиента" и не НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная Тогда
				СтрокаП[КолонкаИсточника] = СтрокаП[КолонкаИсточника]+СтрокаП.ЧастьБрокера;
				СтрокаП.ЧастьБрокера = 0;
			КонецЕсли;
		КонецЕсли;	
		Возврат ЧастьМенеджера*Количество+ЧастьБрокера*Количество;
	КонецЕсли;	
КонецФункции

