				Если Каско >0 Тогда
					ДополнительныеСвойства.Вставить("ОтправитьСМС",Истина);
					ДополнительныеСвойства.Вставить("ТекстСМС","На выезд по КАСКО назначен "+Назначен+", тел. "+Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТелефонКурьера(Назначен));
				Иначе
					//Запрос.Текст ="ВЫБРАТЬ
					//			  |	уб_СтраховыеПродукты.Ссылка
					//			  |ИЗ
					//			  |	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК уб_СтраховыеПродукты
					//			  |ГДЕ
					//			  |	уб_СтраховыеПродукты.Ссылка.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО)
					//			  |	И уб_СтраховыеПродукты.ВидБСО.Ссылка В(&СписокБСО)
					//			  |	И уб_СтраховыеПродукты.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОсаго)";
					//ЕстьОсаго = НЕ Запрос.Выполнить().Пустой();
					Если Осаго >0 Тогда
						ДополнительныеСвойства.Вставить("ОтправитьСМС",Истина);
						ДополнительныеСвойства.Вставить("ТекстСМС","На выезд по ОСАГО назначен "+Назначен+", тел. "+Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТелефонКурьера(Назначен));
					Иначе
						ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецПроцедуры	

