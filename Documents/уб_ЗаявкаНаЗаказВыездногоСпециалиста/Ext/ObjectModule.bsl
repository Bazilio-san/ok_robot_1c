Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ДатаСоздания = ТекущаяДата();
	ТипЗнчДанныеЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ТипЗнчДанныеЗаполнения = Неопределено Или ТипЗнчДанныеЗаполнения = Тип("Структура") Тогда
		// стандартно при вводе нового, ничего делать не требуется
	ИначеЕсли ТипЗнчДанныеЗаполнения = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
		Если ДополнительныеСвойства.Свойство("ТипЗаявки") Тогда
			Тип = ДополнительныеСвойства.ТипЗаявки;
		Иначе
			Тип = Перечисления.уб_ТипВыезда.Пролонгация;
		КонецЕсли;
		Если ДополнительныеСвойства.Свойство("Менеджер") Тогда
			Менеджер = ДополнительныеСвойства.Менеджер;
		КонецЕсли;
		Если ДополнительныеСвойства.Свойство("ДатаЗакрытия") Тогда
			ДатаЗакрытия = ДополнительныеСвойства.ДатаЗакрытия;
		КонецЕсли;
		НомерДоговора = ДанныеЗаполнения;
		Самовыезд = Истина;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уб_СтраховойПолис.СК КАК СК,
		|	уб_СтраховойПолис.Страхователь КАК Страхователь,
		|	уб_СтраховойПолис.НомерЗаявки,
		|	уб_СтраховойПолис.НомерКартыСтрахователя,
		|	уб_СтраховойПолис.БСО.(
		|		ВидБСО,
		|		ВидБСО.Тип КАК Тип
		|	)
		|ИЗ
		|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		|ГДЕ
		|	уб_СтраховойПолис.Ссылка = &СтраховойПолис";
		Запрос.УстановитьПараметр("СтраховойПолис", ДанныеЗаполнения);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СК = Выборка.СК;
			Страхователь = Выборка.Страхователь;
			НомерЗаявки = Выборка.НомерЗаявки;
			НомерКартыСтрахователя = Выборка.НомерКартыСтрахователя;
			ВыборкаБСО = Выборка.БСО.Выбрать();
			Пока ВыборкаБСО.Следующий() Цикл
				Если Тип = Перечисления.уб_ТипВыезда.Пролонгация Тогда
					НоваяСтрока = БСО.Добавить();
					НоваяСтрока.СК = Выборка.СК;
					НоваяСтрока.ВидБСО = ВыборкаБСО.ВидБСО;
					НоваяСтрока.Количество = 1;
				Иначе
					Если ВыборкаБСО.Тип = Перечисления.уб_ТипыБСО.Полис или 
						ВыборкаБСО.Тип = Перечисления.уб_ТипыБСО.ПолисОсаго Тогда
						НоваяСтрока = БСО.Добавить();
						НоваяСтрока.СК = Выборка.СК;
						НоваяСтрока.ВидБСО = уб_КЭШируемые.ВидБСОТипаКвА7ДляСК(Выборка.СК).ВидБСО;
						НоваяСтрока.Количество = 1;
						Если ДатаЗакрытия<>Неопределено Тогда
							Запрос.Текст = 
							"ВЫБРАТЬ
							|	уб_СтраховойПолис.Ссылка,
							|	уб_СтраховойПолисПлатежи.Сумма КАК Сумма,
							|	уб_СтраховойПолис.СтраховаяСумма,
							|	уб_СтраховойПолис.СтраховаяПремия
							|ИЗ
							|	Документ.уб_СтраховойПолис.Платежи КАК уб_СтраховойПолисПлатежи
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
							|		ПО уб_СтраховойПолисПлатежи.Ссылка = уб_СтраховойПолис.Ссылка
							|ГДЕ
							|	уб_СтраховойПолисПлатежи.Дата = &Дата
							|	И уб_СтраховойПолис.Ссылка = &СтраховойПолис" ;
							Запрос.УстановитьПараметр("Дата",ДатаЗакрытия);
							ВыборкаПлатеж = Запрос.Выполнить().Выбрать();
							Если ВыборкаПлатеж.Следующий() Тогда 
								НоваяСтрока.СтраховаяПремия = ВыборкаПлатеж.СтраховаяПремия;
								НоваяСтрока.СуммаВзноса = ВыборкаПлатеж.Сумма;
								НоваяСтрока.ИтогСтраховаяПремия = НоваяСтрока.СтраховаяПремия; 
								НоваяСтрока.ИтогСуммаВзноса     = НоваяСтрока.СуммаВзноса;
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнчДанныеЗаполнения = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста") Тогда
