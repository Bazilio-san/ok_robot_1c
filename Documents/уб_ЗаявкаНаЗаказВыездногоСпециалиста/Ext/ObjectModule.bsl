Процедура ПроверитьИОтправитьСМС ()

	ТребуетсяОтправить = Ложь;
	ДополнительныеСвойства.Свойство("ОтправитьСМС",ТребуетсяОтправить);
	Если ТребуетсяОтправить = Истина Тогда
		Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
		//Параметры.Вставить("ИмяСервиса","iqsms.ru");
		//Параметры.Вставить("Режим","REST");
		//Параметры.Вставить("ИмяСервиса","smsc.ru");
		//Параметры.Вставить("Режим","HTTP");
		
		Параметры.Вставить("ИмяСервиса","www.sluice");
		Параметры.Вставить("ИмяСервиса","smsc.ru");
		Параметры.Вставить("Режим","HTTP");
		Параметры.Вставить("ТолькоОдномуПолучателю", Истина);
