Функция ПроверкаПодготовкаСМС2017(ВыборкаСсылки) Экспорт
	
	ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
	Возврат "";//20181010
	
	Утверждается = 	Утверждено = Истина И Утверждено <> ВыборкаСсылки.Утверждено;
	
	ДоВыезда = Окр((Дата-ТекущаяДата())/60);
	МожноОтправить= ТипВыезда <> 2 //Офис
		И Самовыезд = Ложь
		И ПустаяСтрока(Контакты) = Ложь 
		И (Курьер<>Справочники.ФизическиеЛица.ПустойАгент)
		И (Курьер<>Справочники.ФизическиеЛица.ПустаяСсылка())
		И ПометкаУдаления = ЛОЖЬ
		И ДоВыезда>0//Непросрочен
		И (СокрЛП(Курьер)<>"КОРЗИНА")
		И (СокрЛП(Курьер)<>"Е-ОСАГО")
		И (Найти(Курьер,"Пустой")=0)
		И (Найти(Курьер,"Офис")=0)
		;
		
		пРассылка  = Перечисления.уб_ТипыОчереди.Рассылка;
		
	
	
	
	
	ЗаменаКурьера = Курьер<> ВыборкаСсылки.Курьер;
	
	ДеньВДень = НачалоДня(Дата) = НачалоДня(ТекущаяДата());
	
	Если МожноОтправить и Утверждается //Происходит утверждение
		Тогда
		//
		
		Если ДоВыезда < 60 Тогда
			ТипОтправки = "Сразу о курьере";
		ИначеЕсли ДеньВДень = Истина Тогда	
			ТипОтправки = "Полис подготовлен";
		Иначе
			ТипОтправки = "В очередь";
		КонецЕсли;	
			

		//И ДоВыезда >= 0 //прошлые не отправляем
		//И ДоВыезда < 60*60*24*6 // 6 дней

		//Назначен = ?(ТипВыезда = 0,Курьер,Менеджер);
		Если ТипОтправки = "Сразу о курьере" Тогда
			//ТекстСМС = "На доставку полиса назначен "+Назначен+", тел. "+ТелефонКурьера(Назначен);
			ТекстСМС = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТекстSMSоКурьере(ЭтотОбъект);
		ИначеЕсли ТипОтправки = "Полис подготовлен" Тогда
			//сегодня
			ТекстСМС = "Ваш полис страхования на стадии оформления. Доставка назначена на "+Формат(Дата,"ДФ=dd.MM.yy");//+" +74952280942";
			
			//Создаем очередь напоминалки за час
			РегистрыСведений.уб_Очередь.ОбъектВОчереди(Новый Структура("Объект,ТипОчереди,КоличествоПопытокВыполнения",ВыборкаСсылки.Ссылка,пРассылка,0),,Истина);
			
		ИначеЕсли ТипОтправки = "В очередь" Тогда
			//В день
			ТекстСМС = "Ваш полис страхования на стадии оформления. Доставка назначена на "+Формат(Дата,"ДФ=dd.MM.yyyy");
			//Создаем очередь напоминалки за час
			РегистрыСведений.уб_Очередь.ОбъектВОчереди(Новый Структура("Объект,ТипОчереди,КоличествоПопытокВыполнения",ВыборкаСсылки.Ссылка,пРассылка,0),,Истина);
		Иначе
			ТекстСМС = "";
		КонецЕсли;	
		
		Если Не ТекстСМС = "" Тогда
			Если ДополнительныеСвойства.Свойство("ТекстСМС") и ДополнительныеСвойства.ТекстСМС = ТекстСМС Тогда
				ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
			Иначе	
				Последнее = РегистрыСведений.уб_Чат_Сообщения.ПоследнееСообщение("", "З-"+Формат(Номер,"ЧГ="));
				Если Последнее = ТекстСМС Тогда
					ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
				Иначе	
					ДополнительныеСвойства.Вставить("ОтправитьСМС",Истина);
					ДополнительныеСвойства.Вставить("ТекстСМС",ТекстСМС);
				КонецЕсли;	
			КонецЕсли;
		Иначе	
			ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
		КонецЕсли;	
		
		Возврат ТекстСМС;
	ИначеЕсли МожноОтправить и ЗаменаКурьера и Утверждено Тогда
		
		Если ДоВыезда < 60 Тогда
			ТекстСМС = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТекстSMSоКурьере(ЭтотОбъект,"Произошли изменения, на доставку полиса");
		ИначеЕсли ДеньВДень = Истина Тогда
			РегистрыСведений.уб_Очередь.ОбъектВОчереди(Новый Структура("Объект,ТипОчереди,КоличествоПопытокВыполнения",ВыборкаСсылки.Ссылка,пРассылка,100),,Истина);
			//МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
			//МенеджерЗаписи.Объект = ВыборкаСсылки.Ссылка;
			//МенеджерЗаписи.ТипОчереди = пРассылка;
			//МенеджерЗаписи.КоличествоПопытокВыполнения = 100;
			//МенеджерЗаписи.Записать();
		Иначе	
			ТекстСМС = "";
		КонецЕсли;	
		
		Если Не ТекстСМС = "" Тогда
			Последнее = РегистрыСведений.уб_Чат_Сообщения.ПоследнееСообщение("", "З-"+Формат(Номер,"ЧГ="));
			Если Последнее = ТекстСМС Тогда
				ДополнительныеСвойства.Вставить("ОтправитьСМС",Ложь);
			Иначе	
				ДополнительныеСвойства.Вставить("ОтправитьСМС",Истина);
				ДополнительныеСвойства.Вставить("ТекстСМС",ТекстСМС);
			КонецЕсли;	
		КонецЕсли;	
		
	Иначе
		уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(ВыборкаСсылки.Ссылка,пРассылка);
		Возврат "";
	КонецЕсли;	
