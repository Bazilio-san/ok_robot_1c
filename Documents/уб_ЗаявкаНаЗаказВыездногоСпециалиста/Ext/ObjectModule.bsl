Функция РасчетСКВПоЗаявке(Комиссия=0) Экспорт
	Если Дата<Дата(2016,2,11) Тогда
		Возврат 999999;//Заоблачное значение
	КонецЕсли;	
	СКВ = 0;
	Комиссия = 0;
	Для Каждого СтрокаБСО Из БСО Цикл
		Если ТипЗнч(СтрокаБСО.ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
			Если Найти("Техосмотр",Строка(СтрокаБСО.ВидБСО))>0 Тогда
			//Если СтрокаБСО.ВидБСО.Тип = Перечисления.уб_ТипыБСО.ПолисОсаго Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		ТекФормаОплаты = ?(СтрокаБСо.ФормаОплатыСтрока.Пустая(),ФормаОплаты,СтрокаБСо.ФормаОплатыСтрока );
		Если Дата>=Дата(2026,1,1) 
			и ТекФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику 
			и СтрокаБСО.ВидБСО<>Перечисления.уб_ВидыСтраховыхПродуктов.Ипотека 
			и СтрокаБСО.ВидБСО<>Перечисления.уб_ВидыСтраховыхПродуктов.ВЗР Тогда
			дельта = 3;
			
		Иначе
			дельта = 0;
		КонецЕсли;	
		Комиссия = Комиссия+Окр((дельта)*СтрокаБСО.ИтогСтраховаяПремия/100,2);
		СуммаСтроки = Окр((СтрокаБСО.КВБрокераПлан-дельта)*СтрокаБСО.ИтогСтраховаяПремия/100,2)-СтрокаБСО.ИтогПредоставленнаяСкидка;
		СКВ = СКВ+ СуммаСтроки;
	КонецЦикла;	
	//Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
		СКВ = СКВ+ ВознаграждениеЧастьКлиента+ВознаграждениеОтМенеджера-СуммаПоКарте;
		//Комиссия = Комиссия+СуммаПоКарте;
	//КонецЕсли;	
	//Если СКВ >= 1000 и СКВ <= 3350 и  НомерЗаявки <> Перечисления.уб_ВидыЗаявок.Личная Тогда
	//	#Если Клиент тогда
	//	Предупреждение("По данной заявке оплата выезда производится за счет брокера без доплаты за класность выездного специалиста ["+СКВ+"]",10);
	//	#КонецЕсли
	//Иначе
	//	//возврат 999999
	//КонецЕсли;
	
	Возврат СКВ;
КонецФункции

Функция Реквизиты(Знач _Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Проведен,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Утверждено,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Тип,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.СозданНаОсновании,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Оператор,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Куратор
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",_Ссылка);
	Результат = Запрос.Выполнить();
	Ответ = Новый Структура;
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Для каждого Колонка из Результат.Колонки Цикл
			Ответ.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;	
	Иначе
		Для каждого Колонка из Результат.Колонки Цикл
			Ответ.Вставить(Колонка.Имя, _Ссылка[Колонка.Имя]);
		КонецЦикла;	
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

Функция ОбновитьПараметры(_Источник) Экспорт
	ПараметрыСВС = уб_РасчетыСМенеджерами.ПараметрыСВС(_Источник.Курьер,КонецДня(_Источник.Дата));

	ДополнительныеСвойства.Вставить("СВС",              ПараметрыСВС.СВС);
	ДополнительныеСвойства.Вставить("ТипПодразделения", ПараметрыСВС.ТипПодразделения);
	ДополнительныеСвойства.Вставить("ВнешнееСВС",ПараметрыСВС.ТипПодразделения = Перечисления.уб_ТипПодразделения.СлужбаВСВнешняя);
	Комиссия = 0;
	СКВ = РасчетСКВПоЗаявке(Комиссия);
	ДополнительныеСвойства.Вставить("СКВ",СКВ);	
	ДополнительныеСвойства.Вставить("Комиссия",Комиссия);	
КонецФункции	
