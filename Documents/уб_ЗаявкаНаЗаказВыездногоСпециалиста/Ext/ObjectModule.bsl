Функция ЗарегистрироватьРасчеты() Экспорт
	ТаблицаРасчетов = СобратьРасчеты();
	ЕстьИзменения = Ложь;
	
	НовыеРасчеты = уб_Взаиморасчеты.СравнитьСкорректироватьТаблицу(РасчетыПоЗаявке.Выгрузить(),ТаблицаРасчетов,ЕстьИзменения);
	Если ЕстьИзменения = Истина Тогда
		РасчетыПоЗаявке.Загрузить(НовыеРасчеты);
	КонецЕсли;	
	
КонецФункции

Функция СобратьРасчеты() Экспорт
	СсылкаДокумента = ?(ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка);
	Если РасчетыПоЗаявке.Количество()>200 Тогда
		РасчетыПоЗаявке.Очистить();
	КонецЕсли;	
	ТаблицаРасчетов = РасчетыПоЗаявке.Выгрузить();
	ТаблицаРасчетов.Очистить();
	Для каждого СтрокаБСО  из  БСО Цикл
		//
		уб_Взаиморасчеты.ПроверитьСтроку(СтрокаБСО);
		
		ТолькоБрокерскиеРасчеты = ТипЗнч(СтрокаБСО.ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО")	и СтрокаБСО.ВидБСО.Владелец = ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент;
		//Страховая премия
		Если СтрокаБСО.ИтогСтраховаяПремия<>0 Тогда
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ПриемкаОтКлиентаБрокером;//!!!Возможно другой вариант
			СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
			СтрокаР.Уточнение     = СтрокаБСО.ВидБСО;
			СтрокаР.СуммаКлиент   = СтрокаБСО.ИтогСтраховаяПремия;
			СтрокаР.СуммаМенеджер = 0;
			СтрокаР.СуммаБрокер   = ?(ТолькоБрокерскиеРасчеты,0,СтрокаБСО.ИтогСтраховаяПремия);
			СтрокаР.СуммаБрокерВС = 0;
		КонецЕсли;
		Если ТолькоБрокерскиеРасчеты Тогда
			//ПлановаяСтоимость = ?(Найти(ПодразделениеЗаявки,"М-ОП")=1 и СтрокаБСО.ВидБСО.ПлановаяСтоимость>0,200,СтрокаБСО.ВидБСО.ПлановаяСтоимость);
			ДанныеПоБланку = уб_РасчетыСМенеджерами.ПолучитьСхемуИАлгоритмРасчета(СтрокаБСО.ВидБСО,Менеджер,Дата);
			Если не ДанныеПоБланку = Неопределено Тогда
				ПлановаяСтоимость = ДанныеПоБланку.МинимальнаяСумма;
			Иначе	
				ПлановаяСтоимость = 0;
			Конецесли;	
			Разница = СтрокаБСО.ИтогСтраховаяПремия-ПлановаяСтоимость;
			//Если ПлановаяСтоимость >0 Тогда
			//	СтрокаР = ТаблицаРасчетов.Добавить();
			//	СтрокаР.НачислениеВМ  =
			//	СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
			//	СтрокаР.Уточнение     = СтрокаБСО.ВидБСО;
			//	СтрокаР.СуммаКлиент   = 0;
			//	СтрокаР.СуммаМенеджер = 0;
			//	СтрокаР.СуммаБрокер   = 0;//-ПлановаяСтоимость;//Часть брокера
			//КонецЕсли;	
			Если Разница >0 Тогда
				СтрокаР = ТаблицаРасчетов.Добавить();
				СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.НачислениеВМ;
				СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
				СтрокаР.Уточнение     = СтрокаБСО.ВидБСО;
				СтрокаР.СуммаКлиент   = 0;
				СтрокаР.СуммаМенеджер = -Разница;
				СтрокаР.СуммаБрокер   = 0;//СтрокаБСО.ИтогСтраховаяПремия;
				СтрокаР.СуммаБрокерВС = 0;
			КонецЕсли;	
		КонецЕсли;	
			
