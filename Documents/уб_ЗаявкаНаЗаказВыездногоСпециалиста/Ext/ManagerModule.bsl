Функция ЕстьПриемкиПоЗаявке(Ссылка) Экспорт
	Результат = Новый СписокЗначений;
	Если Не Ссылка.Пустая() Тогда
		//добавлен поиск приемок без табличных частей, но с оплатой за выезд клиентом с заявкой в шапке
		Запрос = Новый Запрос;
		СистемаТЧПлатежи = ПараметрыСеанса.уб_Константы.СистемаТЧПлатежейВПриемкеОплат = Истина;
		Если СистемаТЧПлатежи Тогда
			ТекстЗапроса = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	П.Ссылка
			|ИЗ
			|	Документ.уб_ПриемкаОплат.Полисы КАК П
			|ГДЕ
			|	П.Заявка = &Ссылка
			|	И НЕ П.Ссылка.ПометкаУдаления";
			//|
			//|ОБЪЕДИНИТЬ
			//|
			//|ВЫБРАТЬ РАЗЛИЧНЫЕ
			//|	П.Ссылка
			//|ИЗ
			//|	Документ.уб_ПриемкаОплат.Платежи КАК П
			//|ГДЕ
			//|	П.Заявка = &Ссылка
			//|	И НЕ П.Ссылка.ПометкаУдаления"
		Иначе
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	П.Ссылка
			|ИЗ
			|	Документ.уб_ПриемкаОплат.Полисы КАК П
			|ГДЕ
			|	П.Заявка = &Ссылка
			|	И НЕ П.Ссылка.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	П.Ссылка
			|ИЗ
			|	Документ.уб_ПриемкаОплат КАК П
			|ГДЕ
			|	П.Заявка = &Ссылка
			|	И НЕ П.ПометкаУдаления";
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезЗапроса = Запрос.Выполнить();
		Если РезЗапроса.Пустой() = ЛОЖЬ Тогда
			Результат.ЗагрузитьЗначения(РезЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
		КонецЕсли;	
	КонецЕсли;
	Результат = Результат.Количество() > 0;
	Возврат Результат;

КонецФункции // ДоступКИзменениюПриНаличииПриемки()
