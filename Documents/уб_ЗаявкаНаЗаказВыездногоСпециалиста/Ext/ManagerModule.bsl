//заявка ссылка или объект
Функция НетБСОПоЗаявке(Заявка) Экспорт

	НетБСО = Истина;
	ТекЗаявка = Заявка;
	Пока Не ТекЗаявка.Ссылка.Пустая() Цикл
		Если ТекЗаявка.НетБСО и ЗначениеЗаполнено(ТекЗаявка.СозданНаОсновании) Тогда
			ТекЗаявка = ТекЗаявка.СозданНаОсновании;
		Иначе
			НетБСО = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НетБСО;
	
КонецФункции

