Функция НайтиПеремещение(Заявка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ПеремещениеБСОБСО.Ссылка
	               |ИЗ
	               |	Документ.уб_ПеремещениеБСО.БСО КАК уб_ПеремещениеБСОБСО
	               |ГДЕ
	               |	уб_ПеремещениеБСОБСО.Подтверждено = ИСТИНА
	               |	И уб_ПеремещениеБСОБСО.Ссылка.СозданНаОсновании = &Заявка
	               |	И уб_ПеремещениеБСОБСО.Ссылка.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("Заявка",Заявка);
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Документы.уб_ПеремещениеБСО.ПустаяСсылка();
КонецФункции	


Функция ПолучитьОбластьШапки(Макет,ВыборкаСсылки) Экспорт

	Менеджер 	  = ВыборкаСсылки.Менеджер;
	Курьер		  = ВыборкаСсылки.Курьер;
	НомерЗаявкиСК = ВыборкаСсылки.НомерЗаявкиСК;
	Макет = ПолучитьМакет("Макет");
	ЧФ = "ЧЦ=14; ЧДЦ=2; ЧН=0.00";
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ФИОМенеджера				= Менеджер.Наименование;
	ТелефонМенеджера = уб_temp.ДайКонтактнуюИнформациюФизлица(Менеджер, Справочники.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный);
	ТелефонМенеджера2 = уб_temp.ДайКонтактнуюИнформациюФизлица(Менеджер, Справочники.ВидыКонтактнойИнформации.ТелефонФизЛицаМобильный);
	
	Если ТелефонМенеджера2 = ТелефонМенеджера Тогда
		ТелефонМенеджера2 ="";
	КонецЕсли;	
	ОбластьШапка.Параметры.ТелефонМенеджера2	= ТелефонМенеджера2;

	ОбластьШапка.Параметры.ТелефонМенеджера			= ТелефонМенеджера;
	ОбластьШапка.Параметры.ФИОКурьера				= Курьер.Наименование;
	ОбластьШапка.Параметры.ТелефонКурьера			= уб_temp.ДайКонтактнуюИнформациюФизлица(Курьер, Справочники.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный);
	Руководитель = уб_temp.РуководительПодразделенияПоАгенту(ВыборкаСсылки.Менеджер,, "рук");
	ОбластьШапка.Параметры.Руководитель		= Руководитель;
	Если ЗначениеЗаполнено(Руководитель) Тогда
		Если Руководитель = ВыборкаСсылки.Менеджер Тогда
			ТелефонРуководителя = ТелефонМенеджера;
		Иначе
			ТелефонРуководителя = уб_temp.ДайКонтактнуюИнформациюФизлица(Руководитель, Справочники.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный);
		КонецЕсли;
		ОбластьШапка.Параметры.ТелефонРуководителя = ТелефонРуководителя;
	КонецЕсли;
	//ОбластьШапка.Параметры.ВознаграждениеКурьера	= Формат(ВыборкаСсылки.ОплатитьВКассуЗаВыездКурьера, ЧФ);	
	//ОбластьШапка.Параметры.ВознаграждениеКурьера	= Формат(ВыборкаСсылки.ВознаграждениеКурьера, ЧФ);	
	НомерДляВывода = СокрЛП(Строка(ВыборкаСсылки.Номер));
	Если Не (ПустаяСтрока(НомерЗаявкиСК) Или НомерЗаявкиСК = "<нет>") Тогда
		Если Не ПустаяСтрока(НомерЗаявкиСК) Тогда
			НомерДляВывода = НомерДляВывода + " / " + СокрЛП(НомерЗаявкиСК);
		КонецЕсли;
	КонецЕсли;
	ОбластьШапка.Параметры.НомерДокумента = НомерДляВывода;
	ОбластьШапка.Параметры.Подразделение = ?(ВыборкаСсылки.Подразделение="","","/"+ВыборкаСсылки.Подразделение+"/");
	//ВнешняяКомпонента = уб_ШК.ПодключитьВнешнююКомпонентуПечатиШтрихкода();
	//Если Не ВнешняяКомпонента = Неопределено Тогда
	//	ВнешняяКомпонента.АвтоТип = Истина;
	//	ВнешняяКомпонента.АвтоТип = Ложь;
	//	ВнешняяКомпонента.ТипКода = 1; // указан тип EAN13
	//	ВнешняяКомпонента.ВыравниваниеКода = 3;
	//	//ТипКода - число от 0 до 15: 0 - EAN8, 1 - EAN13, 2 - EAN128. Вот полный список типов по порядку:
	//	//EAN8, EAN13, EAN128, Code39, Code128, Code16k, PDF417, Standart (Industrial) 2 of 5, Interleaved 2 of 5, Расширение Code39, Code93, ITF14, RSS14, CodaBar, EAN13 AddOn 2, EAN13 AddOn 5.			
	//	//Кроме типа штрихкода, компонента имеет ряд других свойств, например ВнешняяКомпонента.ОтображатьТекст, ВнешняяКомпонента.РазмерШрифта и прочие, можно посмотреть в свойствах.
	//	ОбластьШапка.Рисунки.Штрихкод.Картинка = уб_ШК.ПолучитьКартинкуШтрихкода(ВнешняяКомпонента, "Z" + Формат(ВыборкаСсылки.Номер,"ЧГ="), ОбластьШапка.Рисунки.Штрихкод.Ширина, ОбластьШапка.Рисунки.Штрихкод.Высота);
	//КонецЕсли;
	ОбластьШапка.Параметры.НомерЗаявкиВБазе	= ВыборкаСсылки.НомерЗаявки;
	Возврат ОбластьШапка;

