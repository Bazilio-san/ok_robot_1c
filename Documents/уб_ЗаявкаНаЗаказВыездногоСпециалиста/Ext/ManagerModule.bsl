	|	ЕСТЬNULL(Организации.ОсновнойБанковскийСчет.Банк.Код, """") КАК БИК,
	|	ЕСТЬNULL(Организации.ОсновнойБанковскийСчет.НомерСчета, """") КАК НомерСчета,
	|	ЕСТЬNULL(Организации.ОсновнойБанковскийСчет.Банк.КоррСчет, """") КАК Кор,
	|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК ФактАдресОрганизации,
	|	ЕСТЬNULL(КонтактнаяИнформация2.Представление, """") КАК ЮрАдресОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО (КонтактнаяИнформация.Объект = Организации.Ссылка)
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресОрганизации))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация2
	|		ПО (КонтактнаяИнформация2.Объект = Организации.Ссылка)
	|			И (КонтактнаяИнформация2.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮРАдресОрганизации))
	|ГДЕ
	|	Организации.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",ТекОрганизация);					  
	Выборка = Запрос.Выполнить().Выбрать();
