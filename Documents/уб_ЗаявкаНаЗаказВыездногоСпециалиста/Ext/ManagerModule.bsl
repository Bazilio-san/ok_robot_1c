Функция СоответствиеВидовДокументовИмениПоля() Экспорт

	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Справочники.уб_ВидыДокументовКПолисам.РасчетныйЛист, 	"Расчетчик");
	Соответствие.Вставить(Справочники.уб_ВидыДокументовКПолисам.ДопСоглашение, 	"ДопСоглашение");
	Соответствие.Вставить(Справочники.уб_ВидыДокументовКПолисам.Прочее,			"ДругиеДокументы");
	Возврат Соответствие

КонецФункции // СоответствиеВидовДокументовИмениПоля()


Функция ПолучитьСтрокуПоУИД(УИД) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УИД",УИД);
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.*
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
	               |ГДЕ
	               |уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.УидСтроки = &УИД";
	Результат = Запрос.Выполнить();			   
	Выборка = Результат.Выбрать();			   
	Если Выборка.Следующий() Тогда
		Структура = Новый Структура;
		Для каждого Колонка Из Результат.Колонки Цикл
			Структура.Вставить(Колонка.Имя);
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(Структура,Выборка);
		Если ЗначениеЗаполнено(Структура.ОбъектСтрахования) = Ложь Тогда
			Структура.Вставить("ОбъектСтрахования", Обработки.ЗагрузкаПолисовИзB2B.НайтиПростойОбъектСтрахования(Строка(Выборка.ВидБСО),Строка(Выборка.ВидБСО)));
		КонецЕсли;		
		Возврат Структура;
	Иначе
		Возврат Новый Структура;	
	КонецЕсли;
КонецФункции


Функция ВКОтСтатусаИКоличества(Знач Заявка = Неопределено,Период, Вариант = 1) Экспорт
	Запрос = Новый Запрос;
	Если Заявка = Неопределено Тогда
		Запрос.УстановитьПараметр("Заявка",Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка());
		Запрос.УстановитьПараметр("Курьер",Справочники.ФизическиеЛица.ПустаяСсылка());
	Иначе                                                                           		
		Запрос.УстановитьПараметр("Заявка",Заявка.Ссылка);
		Запрос.УстановитьПараметр("Курьер",Заявка.Курьер);
		Если Вариант = 1 и (Заявка.Курьер =  Справочники.ФизическиеЛица.ПустаяСсылка()
			или Заявка.Курьер =  Справочники.ФизическиеЛица.ПустойАгент)
			Тогда
			//нет смысла считать для пустого курьера
			Возврат 0;
		Иначе
			//
		КонецЕсли	
	КонецЕсли;	
	
	Нач = НачалоМесяца(Период);
	Запрос.УстановитьПараметр("ДатаНач",Нач);
	Запрос.УстановитьПараметр("ДатаКон",КонецМесяца(Период));
	
	
	
	
	Запрос.УстановитьПараметр("ПросчитыватьСУчетомНепроведенных", Истина);
	Запрос.УстановитьПараметр("ПросчитыватьСУчетомНеподтвержденных", Истина);
	Запрос.УстановитьПараметр("СчитатьВнешних", Ложь);
	Если Нач = Дата(2017,1,1) Тогда
		Запрос.УстановитьПараметр("План250", 75);
		Запрос.УстановитьПараметр("План200", 49);	
	Иначе
		Запрос.УстановитьПараметр("План250", 100);
		Запрос.УстановитьПараметр("План200", 65);	
	КонецЕсли;
	
	
	Запрос.Текст = ТекстЗапросаВК(,ЛОЖЬ) + ДопЗапрос();
	Результаты = Запрос.ВыполнитьПакет();
	Если Вариант = 1 Тогда
		Результат = Результаты[Результаты.Количество()-1].Выгрузить();
		Вк  = Результат.Итог("ВК")+Результат.Итог("ВКБезДенег");
		Возврат ВК;
	Иначе
	  Возврат Результаты[Результаты.Количество()-2].Выгрузить();	
	КонецЕсли;
	
КонецФункции

Функция ТекстЗапросаВК(Дата = Неопределено,Наличный=Истина) экспорт
	Если Дата = Неопределено  или Дата >=Дата(2020,7,1) Тогда
	Иначе
		Возврат ТекстЗапросаВКДо072020();
	КонецЕсли;	
	  
	Если Наличный Тогда
		ТекстНаличный = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Полисы.Заявка,
		|	СУММА(уб_ПриемкаОплатПлатежи.Сумма) КАК Сумма,
		|	Полисы.Заявка.ИтогСуммаВзноса
		|ПОМЕСТИТЬ ЗаявкиНаличные
		|ИЗ
		|	Документ.уб_ПриемкаОплат.Полисы КАК Полисы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_ПриемкаОплат.Платежи КАК уб_ПриемкаОплатПлатежи
		|		ПО Полисы.Ссылка = уб_ПриемкаОплатПлатежи.Ссылка
		|			И (Полисы.НомерСтроки = 1)
		|			И (уб_ПриемкаОплатПлатежи.Ссылка.ОтчетКассира.Подтверждено)
		|			И (уб_ПриемкаОплатПлатежи.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Касса))
		|ГДЕ
		|	Полисы.Заявка.Дата > &ДатаНач
		|	И Полисы.Заявка.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.уб_ФормыОплаты.Терминал)
		|
		|СГРУППИРОВАТЬ ПО
		|	Полисы.Заявка,
		|	Полисы.Заявка.ИтогСуммаВзноса
