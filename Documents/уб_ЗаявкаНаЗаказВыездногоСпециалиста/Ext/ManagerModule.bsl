Функция ОбработчикРассылки(Очередь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ТекДата = ТекущаяДата();
	ТекЧас = Час(ТекДата);
	
	НачалоРассылки = 9;
	КонецРассылки  = 19;
	Если ТекЧас >=НачалоРассылки и ТекЧас<КонецРассылки Тогда
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Если ТекЧас = НачалоРассылки Тогда
		//
		Дата1  = НачалоДня(ТекДата)+ТекЧас*3600;//
		Дата2  = КонецДня(ТекДата);
	Иначе
		Дата1  = ТекДата-15*60;//За 15 минут до тек момента
		Дата2  = ТекДата+3600;//1 час вперед
	КонецЕсли;	
	пРассылка  = Перечисления.уб_ТипыОчереди.Рассылка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Каско,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Осаго,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.НС,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ДМС,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ДК,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Утверждено,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПометкаУдаления,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ТипВыезда,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Контакты,
	               |	уб_Очередь.КоличествоПопытокВыполнения,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_Очередь КАК уб_Очередь
	               |		ПО уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка = уб_Очередь.Объект
	               |			И (уб_Очередь.ТипОчереди = ЗНАЧЕНИЕ(Перечисление.уб_ТипыОчереди.Рассылка))
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка В(&Ссылки)
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= &Дата1
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата <= &Дата2";
	Запрос.УстановитьПараметр("Дата1",Дата1);
	Запрос.УстановитьПараметр("Дата2",Дата2);			   
	Запрос.УстановитьПараметр("Ссылки",Очередь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Утверждено = Ложь Тогда
			уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
			Сообщение("Неутверждено. Удалена из рассылки.",Выборка.Менеджер,Выборка.Номер);
			продолжить;
		ИначеЕсли Выборка.ПометкаУдаления = Истина Тогда	
			уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
			Сообщение("Помечена на удаление. Удалена из рассылки.",Выборка.Менеджер,Выборка.Номер);
			продолжить;
		ИначеЕсли Выборка.ТипВыезда = 2 Тогда	
			//офис
			уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
			Сообщение("Офис. Удалена из рассылки.",Выборка.Менеджер,Выборка.Номер);
			продолжить;	
		ИначеЕсли ПустаяСтрока(Выборка.Контакты) Тогда	
			//не куда сообщать
			уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
			Сообщение("Пустые контакты. Удалена из рассылки.",Выборка.Менеджер,Выборка.Номер);
			продолжить;		
		КонецЕсли;	
		
		Если Выборка.КоличествоПопытокВыполнения = 100 и ТекЧас <> НачалоРассылки Тогда
			ТекстСМС = ТекстSMSоКурьере(Выборка,"Произошли изменения, на доставку полиса");
		Иначе	
			ТекстСМС = ТекстSMSоКурьере(Выборка);
		КонецЕсли;	
		
		Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
		Параметры.Вставить("ИмяСервиса","www.sluice");
		Параметры.Вставить("ИмяСервиса","smsc.ru");
		Параметры.Вставить("Режим","HTTP");
		Параметры.Вставить("ТолькоОдномуПолучателю", Истина);
		Если ПараметрыСеанса.уб_Константы.ЭтоРабочаяБаза = Истина Тогда
			Параметры.Получатели 	= Выборка.Контакты;
		Иначе
			Параметры.Получатели 	= "+79133616124";
		КонецЕсли;
		
		Параметры.Тема			= "Рассылка СМС";
		
		Параметры.Сообщение		= ТекстСМС;
		Попытка //TODO Временно добавлена попытка
			Ответ = "";
			уб_ОбменДанными.SendSMS(Параметры,Ответ);
			Если Найти (Ответ,"Ложь") = 0 Тогда
				Ответ = СтрЗаменить(Ответ,"¶","");
				Сообщение(ТекстСМС+". "+Ответ,Выборка.Менеджер,Выборка.Номер);
				уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
			Иначе
				уб_МодульРегламентныхЗаданий.ОшибкаОчереди(Выборка.Ссылка,пРассылка);
			Конецесли;	
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("ПроверитьИОтправитьСМС(). " + " -- " + ОписаниеОшибки(), "Сообщить", Истина, , ,,"СМС-рассылка.Error.Заявка" );	
		КонецПопытки;
	КонецЦикла;	
	//Зачистка не отработанной очереди
	
	Дата1  = ТекДата-30*60;// за 30 минут до текущего момента
	Запрос.УстановитьПараметр("Дата1",НачалоГода(Дата1));
	Запрос.УстановитьПараметр("Дата2",Дата1);			   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		уб_МодульРегламентныхЗаданий.ЗакрытьОчередь(Выборка.Ссылка,пРассылка);
		Сообщение("Истекла дата. Удалена из рассылки.",Выборка.Менеджер,Выборка.Номер);	
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции

Функция Сообщение(Сообщение,Получатель,Номер,ДублироватьПочтой = Истина) Экспорт
	
	Если ПустаяСтрока(Сообщение) Тогда
		Возврат Ложь;	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Канал = "З-"+Формат(Номер,"ЧГ=");
	МЗ = РегистрыСведений.уб_Чат_Сообщения.СоздатьМенеджерЗаписи(); 
	МЗ.Период      = ТекущаяДата();
	Мз.ИмяКанала   = Канал;
	Мз.Отправитель = ПараметрыСеанса.ТекущийПользователь;
	//Если ПараметрыСеанса.уб_ТекущееФизЛицо = Менеджер Тогда
	//	Если ЗначениеЗаполнено(Оператор) Тогда
	//		МЗ.Получатель =  Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",Оператор);	
	//	Иначе
	//		МЗ.Получатель =  Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",Менеджер);	
	//	КонецЕсли;
	//	
	//Иначе
	Если ТипЗнч(Получатель) = Тип("СправочникСсылка.Пользователи") Тогда
		МЗ.Получатель = Получатель;
	Иначе	
		МЗ.Получатель = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",Получатель);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МЗ.Получатель) = Ложь Тогда
		МЗ.Получатель = Справочники.Пользователи.Robot;
	КонецЕсли;
	
	МЗ.ИДСообщения = Новый УникальныйИдентификатор;
	Мз.Заголовок  = Формат(Номер,"ЧГ=");
	Мз.Сообщение = Сообщение;
	
	Мз.Записать();
	
	_Заявка = Документы.уб_ЗаявкаНаВъезд.НайтиПоНомеру(Номер);
	ТекстHTML ="<body>ЗАЯВКА на выезд: <b>"+Канал+"</b>"
	+"<br>Страхователь: <b>"+_Заявка.Страхователь+"</b>" 
	+"<br><br><div style='    background: #7cd1ef;   color: #fff;  font-size: 16px; padding:15px; font-weight: 600; border-radius: 8px;'>"+Сообщение+"</div><br><br>Отправитель: <b>"+Мз.Отправитель+"</b><br>---  Отвечать на адрес 1c@kupipolis.ru не следует, это никто не прочитает</body>";
	Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
	ОбратныйАдрес = уб_temp.КонтактнаяИнформация(Мз.Отправитель.ФизЛицо, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	//Сообщить(ОбратныйАдрес);
	Если Не ПустаяСтрока(ОбратныйАдрес) Тогда
		Параметры.ОбратныйАдрес = ОбратныйАдрес;
	КонецЕсли;
	
	Если ДублироватьПочтой = Истина Тогда
		МассивПолучателей = Новый Массив;
		Попытка
			МассивПолучателей.Добавить(уб_temp.КонтактнаяИнформация(МЗ.Получатель.ФизЛицо, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
		Исключение
		КонецПопытки;
		
		Если МассивПолучателей.Количество() = 0 Тогда
			Сообщить("Почта получателя не определена");
		Иначе	
			
			Параметры.Получатели					= МассивПолучателей;
			Параметры.Тема							= Мз.Заголовок;// +" - сообщение от "+РегистрСведенийМенеджерЗаписи.Отправитель;
			Параметры.ТекстHTML						= ТекстHTML;
			Параметры.ПисатьВЖурналТемуПриОшибке    = Ложь;
			Параметры.ТипСообщенияПриИсключении		= "Предупреждение";
			//Если Не ПустаяСтрока(ОбратныйАдрес) Тогда
			//	Параметры.ОбратныйАдрес = ОбратныйАдрес
			//КонецЕсли;
			
			ЗаписыватьВРегистр = уб_ОбменДанными.SendMail(Параметры);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции	
	

Функция ТекстSMSоКурьере(Выборка,НачалоСообщения ="") Экспорт
	Если НачалоСообщения = "" Тогда
		НачалоСообщения = "На доставку полиса";
	КонецЕсли;	
	
	Назначен = ?(Выборка.ТипВыезда = 0,Выборка.Курьер,Выборка.Менеджер);
	
	Возврат НачалоСообщения+" назначен "+Назначен+", тел. "+ТелефонКурьера(Назначен);
	
КонецФункции	
	
Функция ТелефонКурьера(Назначен) Экспорт
	//Если Назначен = Неопределено Тогда
	//	Назначен = Курьер;
	//КонецЕсли;
	
	ТелефонКурьера = уб_temp.ДайКонтактнуюИнформациюФизлица(Назначен, Справочники.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный);
	Если ПустаяСтрока(ТелефонКурьера) Тогда
		Возврат "+74952280942";
	Иначе
		Возврат ТелефонКурьера;
	КонецЕсли;

КонецФункции


Функция СписокОператоров(ВставитьТекущееЛицо =Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент
	               |ИЗ
	               |	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(, ) КАК уб_ДвижениеФизлицПоПодразделениямСрезПоследних
	               |ГДЕ
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Выбытие = ЛОЖЬ
	               |	И уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Подразделение В
	               |			(ВЫБРАТЬ
	               |				Подр.Ссылка
	               |			ИЗ
	               |				Справочник.ПодразделенияОрганизаций КАК Подр
	               |			ГДЕ
	               |				(Подр.Наименование = ""Операторы БД""
	               |					ИЛИ Подр.Наименование = ""Отдел сопровождения договоров страхования"" или Подр.Код = ""000000030""))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	уб_ДвижениеФизлицПоПодразделениямСрезПоследних.Агент.Наименование";
				   
	Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Агент");		   
	
	Если ВставитьТекущееЛицо = Истина Тогда
		Если Массив.Найти(ПараметрыСеанса.уб_ТекущееФизЛицо) = Неопределено Тогда
			Массив.Вставить(0,ПараметрыСеанса.уб_ТекущееФизЛицо);			
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Массив;
КонецФункции	

Функция ПроверитьДК(Заявка) Экспорт
	//Возврат Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.НомерБСО,
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ДопНомерБСО
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
	               |ГДЕ
	               |	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка.Ссылка = &Ссылка
	               |	И уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование ПОДОБНО ""ДК%""";
	Запрос.УстановитьПараметр("Ссылка",Заявка);				   
	ЕстьНомерДлиньше6 = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	ЕстьДК = Ложь;
	Пока Выборка.Следующий() Цикл
		ЕстьДк = Истина;
		
		Если СтрДлина(СокрЛП(Выборка.НомерБСО))>= 15 или
			СтрДлина(СокрЛП(Выборка.ДопНомерБСО))>= 15 Тогда
			ЕстьНомерДлиньше6 = Истина;
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;	
	Если ЕстьДк = Ложь Тогда
		Возврат Истина;
	Иначе
		Возврат ЕстьНомерДлиньше6 = Истина;
	КонецЕсли;	
	
КонецФункции

Функция ПроверитьСтроки(Заявка) Экспорт
	
	Если Заявка.Тип = Перечисления.уб_ТипВыезда.Административный
				или Заявка.Тип = Перечисления.уб_ТипВыезда.ПервичныйОсмотр Тогда
		Возврат Истина
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Наименование,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.НомерБСО,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ДопНомерБСО
	|ИЗ
	|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.БСО КАК уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО
	|ГДЕ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Ссылка.Ссылка = &Ссылка
	|	И уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.ВидБСО.Тип В (ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Полис), ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.ПолисОСАГО))
	|	И НЕ уб_ЗаявкаНаЗаказВыездногоСпециалистаБСО.Состояние В (ЗНАЧЕНИЕ(Перечисление.уб_СостояниеОформления.Печать), ЗНАЧЕНИЕ(Перечисление.уб_СостояниеОформления.КомплектОформлен), ЗНАЧЕНИЕ(Перечисление.уб_СостояниеОформления.Отказ))";
	Запрос.УстановитьПараметр("Ссылка",Заявка);				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Ложь
	КонецЦикла;	
	Возврат Истина
КонецФункции


