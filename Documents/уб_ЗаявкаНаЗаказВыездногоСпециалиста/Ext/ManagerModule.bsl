Функция ПечатьДоговораПоддержки(Параметры,СсылкаНаОбъект) Экспорт

	ТабДокумент = Новый ТабличныйДокумент;	
	Если ТипЗНч(СсылкаНаобъект.НомерЗаявки) = ТИп("ПеречислениеСсылка.уб_ВидыЗаявок") Тогда
		Возврат ТабДокумент
	КонецЕсли;	
	ТабДокумент.Вывод = ИспользованиеВывода.Разрешить;//?(УБ_Кэшируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ,ПолныеПрава,уб_ДопРольУправлениеПерсоналом"),ИспользованиеВывода.Разрешить,ИспользованиеВывода.Авто);

	Макет = ПолучитьМакет("ДоговорПоддержки");
	ОбластьШапка = Макет.ПолучитьОбласть("все");	
	
	ТекОрганизация = Справочники.Организации.НайтиПоКоду("000000039");
	
	Если Не ТекОрганизация.Пустая() Тогда
		этоИП = ТекОрганизация.ЭтоИндивидуальныйПредприниматель ИЛИ ТекОрганизация.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ФизЛицо;
		ОбластьШапка.Параметры.ИНН			= ?(этоИП,?(ТекОрганизация.ИндивидуальныйПредприниматель.Пустая(),"",ТекОрганизация.ИндивидуальныйПредприниматель.ИНН),ТекОрганизация.ИНН);
		ОбластьШапка.Параметры.ОГРН			= ТекОрганизация.ОГРН;
	Иначе
		Сообщить("Нельзя распечатать договор, т.к. неопределено место работы!");
		Возврат Неопределено;
	КонецЕсли;	
	Кэш = Новый Соответствие;
	СписокПоказателей = Новый Массив;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Организации.Ссылка,
