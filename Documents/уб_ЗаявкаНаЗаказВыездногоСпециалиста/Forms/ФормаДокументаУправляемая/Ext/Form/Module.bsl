		мСтрок = Новый Массив;
		Для каждого Строка из Объект.БСО Цикл
			Если ЗначениеЗаполнено(Строка.Оператор) = ЛОЖЬ Тогда
				мСтрок.Добавить(строка);
			КонецЕсли;	
		КонецЦикла;	
		Если мСтрок.Количество() >0 Тогда
			//Ответ = Вопрос("Проставить выбранного оператора в незаполненых строках("+мСтрок.Количество()+")?",РежимДиалогаВопрос.ДаНет);
			ПоказатьВопрос(Новый ОписаниеОповещения("ПроставитьОператораЗавершение",ЭтаФорма,Новый Структура("Строки",мСтрок)),"Проставить выбранного оператора в незаполненых строках("+мСтрок.Количество()+")?",РежимДиалогаВопрос.ДаНет);
