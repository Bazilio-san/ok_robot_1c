&НаКлиенте
Процедура НомерДоговораПриИзменении(Элемент)
	Если ТипЗнч(Объект.НомерДоговора) = Тип("ДокументСсылка.уб_СтраховойПолис") Тогда
		
		
		ДанныеСтарогоПолиса = ДанныеСтарогоПолиса(Объект.НомерДоговора);
		Если НЕ ДанныеСтарогоПолиса = Неопределено Тогда
			Если уб_Клиент._УстановитьЗначение(Объект,"СК", ДанныеСтарогоПолиса.СК) Тогда
				СКПриИзменении(Элемент);
			КонецЕсли;	
			Заполнить = Ложь;
			
			Если Объект.Страхователь = Неопределено Тогда
				Заполнить = Истина;
			Иначе
				Заполнить = Истина;
				
			КонецЕсли;
			Если Заполнить Тогда
				Если НЕ Объект.Страхователь =  ДанныеСтарогоПолиса.Страхователь Тогда
					Если ЗначениеЗаполнено(Объект.Страхователь) Тогда
						ТекстВопроса = "Заменить текущего страхователя '" + СокрЛП(Объект.Страхователь) + "' данными из страхового полиса - '" + ДанныеСтарогоПолиса.СтраховательСтрока + "'?";
						
						//Ответ = ?(ТекстВопроса = Неопределено, КодВозвратаДиалога.Да, Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет));
						ПоказатьВопрос(Новый ОписаниеОповещения("ПоказатьВопросЗавершение",ЭтаФорма,ДанныеСтарогоПолиса),ТекстВопроса,РежимДиалогавопрос.ДаНет,,КодВозвратаДиалога.Да);
					Иначе
						Объект.Страхователь =  ДанныеСтарогоПолиса.Страхователь
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросЗавершение(Ответ,ДанныеСтарогоПолиса) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если уб_Клиент._УстановитьЗначение(Объект,"Страхователь", ДанныеСтарогоПолиса.Страхователь) Тогда
			СтраховательПриИзменении(Элементы.Страхователь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры					

&НаКлиенте
Процедура СКПриИзменении(Элемент)
	Если Объект.Тип = ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.Административный") И Объект.ЦельВыезда = "Административный" Тогда
		//для уже зачищенных контактов не нужно ничего делать
		Если Не Объект.Утверждено И ПустаяСтрока(Объект.ПредставлениеСтроки) Тогда
			Если ЗначениеЗаполнено(Объект.СК) И Не ЗначениеЗаполнено(Объект.МестоВстречи) Тогда
				//получаем фактический адрес СК
				_МестоВстречи = уб_ФормыВызовСервера.ДайКонтактнуюИнформациюФизлица(Объект.СК,ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресКонтрагентаФактический"));
			Иначе	
				_МестоВстречи	= Объект.МестоВстречи;
			КонецЕсли;
			Если ЗначениеЗаполнено(Объект.СК) И Не ЗначениеЗаполнено(Объект.КонтактноеЛицо) Тогда
				//получаем основное контактное лицо
				_КонтактноеЛицо  	= Неопределено;
				_Контакты 			= ПолучитьТелефонКонтактногоЛица(Объект.СК,_КонтактноеЛицо);
				
			Иначе
				_КонтактноеЛицо	= Объект.КонтактноеЛицо;
				_Контакты = Объект.Контакты;
			КонецЕсли;
			уб_Клиент._УстановитьЗначение(Объект,"Контакты", 		_Контакты);
			уб_Клиент._УстановитьЗначение(Объект,"КонтактноеЛицо",	_КонтактноеЛицо);
			уб_Клиент._УстановитьЗначение(Объект,"МестоВстречи",	_МестоВстречи);
		КонецЕсли;
	ИначеЕсли Объект.КонтактноеЛицо = Неопределено Или (ТипЗнч(Объект.КонтактноеЛицо) = Тип("СправочникСсылка.КонтактныеЛица") И ЗначениеЗаполнено(Объект.КонтактноеЛицо)= ЛОЖЬ) Тогда
		_Модифицированность = Модифицированность;
		Объект.КонтактноеЛицо = "";
		Если Не _Модифицированность Тогда
			Модифицированность = Ложь
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

