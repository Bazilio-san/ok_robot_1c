	ПодобратьВидОплаты(ЭтаФорма,Объект);
	ОбновитьВидыОплаты(Элементы.ВидОплаты);
	
	
	ПриИзмененииТипа("Не обновлять вознаграждение курьера и удержание менеджера");//ВЫЗЫВАЕТ ИзменитьДоступность(Истина)!;
	
	ПриИзмененииСамовыезд(Истина);
	
	Данныеформы = РеквизитФормыВЗначение("Объект");
	ПараметрыСотрудникаИДокумента = ПолучитьИзВременногоХранилища(АдресПараметровВызова);
	Данныеформы.РасчетВознагражденияКурьера(ПараметрыСотрудникаИДокумента);
	
	
	//	ТекущийЭлемент = Элементы.БСО;
	//БСОПриАктивизацииСтроки(Неопределено);
	
	//Устарело?
	//УстановитьПровереноРуководителем();
	
	
	//пока не удалены типы отдела БСО из перечисления - список выбора и нет редактирования текста
	СЗ = Элементы.Тип.СписокВыбора;
	Прч = Перечисления.уб_ТипВыезда;
	СЗ.Добавить(Прч.Страховка, 			"Страховка");
	СЗ.Добавить(Прч.Пролонгация,		"Пролонгация");
	СЗ.Добавить(Прч.ПервичныйОсмотр,	"Осмотр");
	СЗ.Добавить("Административный",		"Административный");
	
	СЗ.Добавить(Прч.Аддендум,			"Аддендум");
	//СЗ.Добавить("Аддендум ОСАГО",		"Аддендум ОСАГО");
	//СЗ.Добавить("Административный",		"Административный");
	//СЗ.Добавить("Добор документов",		"Добор документов");
	//СЗ.Добавить("Доплата по ошибке",	"Доплата по ошибке");
	//СЗ.Добавить("Доп. соглашение",		"Доп. соглашение");
	СЗ.Добавить(Прч.ОчереднойВзнос,		"Очередной взнос");
	//
	//СЗ.Добавить(Прч.Переосмотр,			"Переосмотр");
	//
	//СЗ.Добавить(Прч.Перепись,			"Перепись");
	//СЗ.Добавить("Перепись ОСАГО",		"Перепись ОСАГО");
	
	
	СЗ  = Элементы.Источник.СписокВыбора;
