	И (Объект.ТребуетсяПроверкаРуководителем = ЛОЖЬ ИЛИ ЗначениеЗаполнено(Объект.УтвердилРуководитель) = Истина)
	//И (Дата<Дата(2018,6,1) ИЛИ ПараметрыСеанса.уб_Константы.ПроверкаЗаявокОтделомКонтроля = ЛОЖЬ)
	И (ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки
	//Или (ПараметрыСеанса.уб_ТекущееФизЛицо = Менеджер И Самовыезд)
	Или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ПравоУтвержденияЗаявки"), Ложь)
	)
	);
	
	
	Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ЗапретПравкиДатыЗаявки"), Ложь) Тогда
		//Если Автор<>ПараметрыСеанса.ТекущийПользователь Тогда
		ЗапретитьПравкуДат();
		//КонецЕсли;	
	ИначеЕсли Объект.Утверждено И НЕ СтруктураДоступности.Утверждено Тогда
		ЗапретитьПравкуДат();		
	Иначе	
		ЗапретитьПравкуДат(ЛОЖЬ);		
	КонецЕсли;	
	
	СтруктураДоступности.Вставить("Курьер", //Право менять курьера
	ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки
	ИЛИ (Не Объект.Утверждено)
	//ИЛИ (Не ТребуетсяПроверкаРуководителем)
	);
	ЭтоКурьер = (Объект.Самовыезд = Ложь И ПараметрыСеанса.уб_ТекущееФизЛицо = Объект.Курьер И НЕ уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")  И НЕ ПараметрыСеанса.уб_ТекущееФизЛицо = Объект.Менеджер);
	СтруктураДоступности.Вставить("Самовыезд", НЕ ПараметрыСотрудникаИДокумента.ЭтоОператор = Истина И (СтруктураДоступности.Курьер 
	или СтатусЗаявки=Перечисления.уб_СтатусыЗаявок.СогласованиеСКлиентом));
	СтруктураДоступности.Вставить("Контакты", 
	уб_КЭШируемые.ДоступностьРоли("ПолныеПрава")//ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки
	ИЛИ уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.КураторВыездных"), Ложь)
	Или 
	ПараметрыСотрудникаИДокумента.СтруктураПоДокументу.РукИлиЗам
	Или ПараметрыСеанса.уб_ТекущееФизЛицо = Объект.Менеджер
	или ЭтоКурьер = Истина
	или ПараметрыСотрудникаИДокумента.ЭтоОператорИлиУправлениеПечатью = Истина
	)
	;
	//Элементы.НеВерный.Доступность = ЭтоКурьер=Истина ИЛИ (уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.КураторВыездных"), Ложь));
	//Элементы.ЕОСАГО.Доступность   = уб_КЭШируемые.ДоступностьРоли("ПолныеПрава,уб_СотрудникОтделаБСО");  
	
	Если ЭтоКурьер Тогда
		//Элементы.СтатусЗаявки.ТолькоПросмотр = Истина;
	КонецЕсли;	
	// расчет ТолькоПросмотр формы
	
	Если ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки Тогда
		СтруктураДоступности.ТолькоПросмотр = ЛОЖЬ;
	Иначе
		СтруктураДоступности.ТолькоПросмотр =
		(ПараметрыСотрудникаИДокумента.ЕстьПриемкиПоЗаявке 
		И НЕ уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ПравоИзмененятьЗаявкуПослеПриемки"), Ложь))
		
		ИЛИ (
		уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ПравоРедактироватьЗаявкиПослеУтверждения"), Ложь) = Ложь
		И ЭтоКурьер = Ложь
		и
		(Объект.Утверждено
		ИЛИ (Объект.ТребуетсяПроверкаРуководителем И ЗначениеЗаполнено(Объект.УтвердилРуководитель) И ПараметрыСотрудникаИДокумента.СтруктураПоДокументу.РукИлиЗам = Ложь)
		ИЛИ (Объект.ТребуетсяУтверждениеАндеррайтера И ЗначениеЗаполнено(Объект.УтвердилАндеррайтер)))
		)
		и СтатусЗаявки<>Перечисления.уб_СтатусыЗаявок.СогласованиеСКлиентом
	КонецЕсли;	
	
	_ТолькоПросмотр = СтруктураДоступности.ТолькоПросмотр;
	
	_ПравкаДанныхОВыезде = НЕ (ПараметрыСотрудникаИДокумента.ЕстьПриемкиПоЗаявке И НЕ уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ПравоИзмененятьЗаявкуПослеПриемки"), Ложь));
	
	Если _ПравкаДанныхОВыезде  И ЭтоКурьер = ЛОЖЬ Тогда
		
		Если СтруктураДоступности.ТолькоПросмотр Тогда
			//	Элементы.АдресС.Видимость = НЕ _ПравкаДанныхОВыезде ИЛИ Объект.Самовыезд;
			Элементы.Адрес.ТолькоПросмотр                    = _ПравкаДанныхОВыезде = ЛОЖЬ;// И не Объект.Самовыезд;	
			Элементы.БСОДерево.ТолькоПросмотр                = Истина;
			Элементы.Страхователь.ТолькоПросмотр             = Истина;
			Элементы.Тип.ТолькоПросмотр                      = Истина;
			Элементы.ВидОплаты.ТолькоПросмотр                = Истина;
			Элементы.СтаршийОператор.ТолькоПросмотр          = Истина;
			Элементы.БСОДеревоТекущийОператор.ТолькоПросмотр = Истина;
		Иначе
			//	Элементы.АдресС.Видимость = Объект.Самовыезд;
			Элементы.Адрес.Видимость  =  НЕ Объект.Самовыезд;	
		КонецЕсли;	
		Элементы.Город.Доступность = Истина;
		Элементы.СтанцияМетро.Доступность = Истина;
		
		
	ИначеЕсли _ТолькоПросмотр Тогда
		ТолькоПросмотр = Истина;
		//Элементы.АдресС.Видимость = _ТолькоПросмотр ИЛИ Объект.Самовыезд;
		Элементы.Адрес.ТолькоПросмотр  = (_ТолькоПросмотр);// И не Объект.Самовыезд;
	Иначе
		//	Элементы.АдресС.Видимость = Объект.Самовыезд;
		Элементы.Адрес.Видимость  =  НЕ Объект.Самовыезд;	
	КонецЕсли;	
	
	
	
	//Элементы.Утверждено.ТолькоПросмотр = Не СтруктураДоступности.Утверждено;
	//Элементы.Утверждено.Картинка		= ?(Объект.Утверждено, БиблиотекаКартинок.уб_ОплатаОК, КартинкаКрасная);
	Элементы.Менеджер.ТолькоПросмотр	= Не СтруктураДоступности.Менеджер;
	Элементы.Курьер.ТолькоПросмотр		= Не СтруктураДоступности.Курьер;
	
	Элементы.ВознаграждениеОтКлиента.ТолькоПросмотр = Не СтруктураДоступности.Курьер;
	//Элементы.ВознаграждениеОтМенеджера.ТолькоПросмотр = Не СтруктураДоступности.Курьер;
	
	
	//Элементы._Самовыезд1.Доступность  = СтруктураДоступности.Самовыезд  ИЛИ _ПравкаДанныхОВыезде;
	//Элементы._Самовыезд.Доступность   = СтруктураДоступности.Самовыезд ИЛИ _ПравкаДанныхОВыезде;
	Элементы.ТипВыезда.Доступность	   = СтруктураДоступности.Самовыезд ИЛИ _ПравкаДанныхОВыезде;
	//Элементы.ТипВыезда1.Доступность   = СтруктураДоступности.Самовыезд ИЛИ _ПравкаДанныхОВыезде;
	
	//Элементы.Офис.Доступность		 = СтруктураДоступности.Самовыезд ИЛИ _ПравкаДанныхОВыезде;
	//Элементы.Офис.Видимость		 = Ложь;
	
	Элементы.Контакты.ТолькоПросмотр	= Не СтруктураДоступности.Контакты;
	Элементы.Контакты.РежимПароля		= Не СтруктураДоступности.Контакты ИЛИ ПараметрыСотрудникаИДокумента.ЭтоОператор;
	Элементы.ПанельИнфоОВстрече.Доступность	= СтруктураДоступности.Контакты ИЛИ _ПравкаДанныхОВыезде;
	Элементы.ГруппаМенеджер.Доступность	= СтруктураДоступности.Контакты;
	//Элементы.УтвердилАндеррайтер.КнопкаОчистки = ЛОЖЬ;//ЗначениеЗаполнено(УтвердилАндеррайтер);
	Элементы.УтвердилАндеррайтер.ТолькоПросмотр = НЕ ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки;
	//Элементы.ОтменитьАндеррайтинг.Доступность = ЛОЖЬ;//ЗначениеЗаполнено(УтвердилАндеррайтер);
	
	Если Не ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки И не ПараметрыСотрудникаИДокумента.РуководительСотрудника = ПараметрыСеанса.уб_ТекущееФизЛицо
		И уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ПравоРедактироватьЗаявкиПослеУтверждения"), Ложь) = Ложь Тогда
		//рядовой менеджер
		Элементы.БСОДерево.ТолькоПросмотр = СтатусЗаявки<>Перечисления.уб_СтатусыЗаявок.СогласованиеСКлиентом
		
		И (Объект.Утверждено = Истина
		ИЛИ (Объект.ТребуетсяПроверкаРуководителем И ЗначениеЗаполнено(Объект.УтвердилРуководитель))
		ИЛИ (Объект.ТребуетсяУтверждениеАндеррайтера И ЗначениеЗаполнено(Объект.УтвердилАндеррайтер))
		);
	КонецЕсли;
	
	Если ЭтоКурьер = Истина Тогда
		Элементы.Тип.ТолькоПросмотр           = Истина;
		Элементы.НомерЗаявки.ТолькоПросмотр   = Истина;
		Элементы.Источник.ТолькоПросмотр      = Истина;
		
		Элементы.ГруппаМенеджер.Доступность    = Ложь;
		Элементы.ПанельОтМенеджера.Доступность = Ложь;
		Элементы.ГруппаМенеджер.Доступность    = Ложь;
		Элементы.ПанельПодвал.Доступность      = Ложь;
		
		Элементы.БСОДерево.ТолькоПросмотр     = Истина;
		Элементы.СтанцияМетро.ТолькоПросмотр  = Истина;
		//Элементы.За10КмОтМКАД.Доступность   = Ложь;
		Элементы.МестоВстречи.ТолькоПросмотр  = Истина;		
		Элементы.Адрес.ТолькоПросмотр         = Истина;
		Элементы.Адрес.Видимость              = Ложь;
		//Элементы.ПризнакСтраховкиКредитная.Доступность = Ложь;
		//Элементы.АдресС.Видимость = Истина;
		
		
	КонецЕсли;	
	
	//ПОДУМАТЬ
	ПравкаВК = уб_КЭШируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ");
	Элементы.ЗаблокироватьАвторасчет.Доступность = ПравкаВК;//ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки;
	Элементы.Мотивация.ТолькоПросмотр            = НЕ ПравкаВК;//Не ПараметрыСотрудникаИДокумента.ЭтоПолныеПраваЗаявки;
	Элементы.Источник.Видимость = НЕ (Объект.НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная ИЛИ Объект.НомерЗаявки = Перечисления.уб_ВидыЗаявок.Агентская) И не (Объект.Тип = Перечисления.уб_ТипВыезда.Пролонгация ИЛИ Объект.Тип = Перечисления.уб_ТипВыезда.ОчереднойВзнос);
	
	//TODO почему именно здесь?
	АдресОтметкаНезаполненного();
	
	//Элементы.ОплачиваемыйОсмотр.Доступность = уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") ИЛИ уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.КураторВыездных"), Ложь);
	
	
КонецПроцедуры	

&НаСервере
Функция НастройкиПоляПровереноРуководителем(МассивИзмененныхВидовБСО,ПараметрыСотрудника)
	
	//МенеджерИспытательныйСрок = Менеджер.ИспытательныйСрок;//TODO обращение через точку
	СтруктураРезультатаПроверки = СтруктураНеобходимостиУтверждений(ПараметрыСотрудника,МассивИзмененныхВидовБСО);
	
	//эуРуководителем = Элементы.ПровереноРуководителем;
	//эуАндеррайтером  = Элементы.ПровереноАндеррайтером;
	//эуАндеррайтером.ТолькоПросмотр = Истина;
	эуРезультатПроверки = Элементы.РезультатПроверки;
	эуРезультатПроверки.ТолькоПросмотр = Истина;
	
	Элементы.УтвердилАндеррайтер.СписокВыбора.ЗагрузитьЗначения(СтруктураРезультатаПроверки.СписокАндеррайтеров.ВыгрузитьЗначения());
	Если Объект.ТребуетсяУтверждениеАндеррайтера = Истина 
		и (СтруктураРезультатаПроверки.ТребуетсяПроверкаАндеррайтером = ЛОЖЬ 
		и СтруктураРезультатаПроверки.ТребуетсяПроверкаСлужбыКонтроля = ЛОЖЬ) Тогда
		уб_ВызовСервера._УстановитьЗначение(Объект,"ТребуетсяУтверждениеАндеррайтера", ЛОЖЬ);//Сброс необходимости андеррайтинга
	КонецЕсли;	
	Элементы.УтвердилАндеррайтер.Заголовок = ?(СтруктураРезультатаПроверки.ТребуетсяПроверкаСлужбыКонтроля = Истина,"Контролёр","Андерайтер");
	Элементы.УтвержденоДата.Заголовок = ?(СтруктураРезультатаПроверки.ТребуетсяПроверкаСлужбыКонтроля = Истина,"Дата","Дата утверждения:");
	ПолныеПраваДляПоля = ЛОЖЬ;
	
	Если Не Объект.Утверждено //При утверждении остальные проверки уже не нужны, но этот эу надо скрыть
		и СтруктураРезультатаПроверки.ТребуетсяПроверкаАндеррайтером = Истина 
		и ЗначениеЗаполнено(Объект.УтвердилАндеррайтер)= ЛОЖЬ Тогда //Еще не проверено
		уб_ВызовСервера._УстановитьЗначение(Объект,"ТребуетсяУтверждениеАндеррайтера", Истина);
		//эуРуководителем.Видимость = Ложь;
		//эуАндеррайтером.Видимость  = Истина;
		//эу = эуАндеррайтером; 
		Картинка =  ПараметрыСотрудника.КартинкаКрасная;
		ЕстьЗапрет			= Истина;
		ТекстНеПроверено	= "Не проверено андеррайтером ";//+СокрЛП(Элементы.УтвердилАндеррайтер.СписокВыбора);
		ТекстПроверено		= "Проверено андеррайтером";
		ПодсказкаДоступного = "Доступно только для андеррайтера И руководителя отдела БСО";
		ПодсказкаНЕДоступного = "Перед утверждением заявка должна быть проверена андеррайтером ИЛИ руководителя отдела БСО";
		
		эуУтвердилАндеррайтер = Элементы.УтвердилАндеррайтер;
		//СтрокаВыделения = "<"+СокрЛП(СтруктураРезультатаПроверки.СписокАндеррайтеров) + ">";
		//нс = 0; нк =0; кс = 0; кк = 0;
		//эуУтвердилАндеррайтер.ПолучитьГраницыВыделения(нс,нк,кс,кк);
		//Попытка
		//	эуУтвердилАндеррайтер.УстановитьГраницыВыделения(нс,нк);//Выделяется, то что уже там есть
		//Исключение
		//КонецПопытки;	
		//эуУтвердилАндеррайтер.ВыделенныйТекст  = СтрокаВыделения;
		ПолныеПраваДляПоля = эуУтвердилАндеррайтер.СписокВыбора.НайтиПоЗначению(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено//; 
		ИЛИ ПараметрыСотрудника.ЭтоПолныеПраваДляЗаявки;  
	ИначеЕсли Не Объект.Утверждено 
		и СтруктураРезультатаПроверки.ТребуетсяПроверкаСлужбыКонтроля = Истина
		и ЗначениеЗаполнено(Объект.УтвердилАндеррайтер)= ЛОЖЬ Тогда
		
		уб_ВызовСервера._УстановитьЗначение(Объект,"ТребуетсяУтверждениеАндеррайтера", ИСТИНА);
		
		//эуРуководителем.Видимость = Ложь;
		//эуАндеррайтером.Видимость  = Истина;
		//эуАндеррайтером.ТолькоПросмотр = Истина;
		
		
		//эу = эуАндеррайтером; 
		Картинка =  ПараметрыСотрудника.КартинкаКрасная;
