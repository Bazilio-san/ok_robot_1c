	//|	
	//|	ВЫБРАТЬ
	//|		МАКСИМУМ(ВЫБОР
	//|				КОГДА СП.Ссылка В (&МассивИзмененныхВидовБСО)
	//|					ТОГДА ИСТИНА
	//|				ИНАЧЕ ЛОЖЬ
	//|			КОНЕЦ)
	//|	ИЗ
	//|		Справочник.уб_СтраховыеПродукты КАК СП
	//|	ГДЕ
	//|		СП.Ссылка В(&МассивВидовСПревышением)
	//|		И (СП.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	//|				ИЛИ СП.ДатаОкончанияДействия > &НаДату)
	//|		И НЕ СП.ПометкаУдаления
	//|	
	//|	ИМЕЮЩИЕ
	//|		ЕСТЬNULL(МАКСИМУМ(ВЫБОР
	//|					КОГДА СП.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО)
	//|						ТОГДА ИСТИНА
	//|					ИНАЧЕ ЛОЖЬ
	//|				КОНЕЦ), ЛОЖЬ) = ИСТИНА
	|) КАК Вложенный
	|
	|ИМЕЮЩИЕ
	|	НЕ МАКСИМУМ(Вложенный.СброситьПроверкуРуководителя) ЕСТЬ NULL ");
	//Запрос.УстановитьПараметр("МассивВидовСПревышением", 			МассивВидовСПревышением);
	Запрос.УстановитьПараметр("МассивИзмененныхВидовБСО", 	МассивИзмененныхВидовБСО);
	Запрос.УстановитьПараметр("ЛимитСкидкиБезУтверждения", 	ПроцентПроверкиКАСКО);//Только для КАСКО
	
	Запрос.УстановитьПараметр("НаДату",						НаДату);
	Запрос.УстановитьПараметр("ТЧ_БСО",ТЧ_БСО );
	МассивРезультатов = Запрос.ВыполнитьПакет();
	РезультатПоПроцентам = МассивРезультатов[3];//
	Если Не РезультатПоПроцентам.Пустой() Тогда
		Результат.ПроцентКАСКОПревышен = Истина и ПараметрыСотрудника.ТребуетсяПроверкаСкидок = Истина;    //ПараметрыСотрудника.ТребуетсяПроверкаСкидок;
		Выборка = РезультатПоПроцентам.Выбрать();
		Выборка.Следующий();
		Результат.СброситьПроверкуРуководителя = Выборка.СброситьПроверкуРуководителя и ПараметрыСотрудника.ТребуетсяПроверкаСкидок;
		
	КонецЕсли;
	
	РезультатПоЛимитамНаСтрахование = МассивРезультатов[2];//
	Если Не РезультатПоЛимитамНаСтрахование.Пустой() и Объект.Тип = Перечисления.уб_ТипВыезда.Страховка Тогда
		//
		Результат.ЕстьЛимитыСтрахования = Истина;
		Выборка = РезультатПоЛимитамНаСтрахование.Выбрать();
		Пока Выборка.следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Андеррайтер) 
				и Результат.СписокАндеррайтеров.НайтиПоЗначению(Выборка.Андеррайтер)= Неопределено Тогда
				Результат.СписокАндеррайтеров.Добавить(Выборка.Андеррайтер);
			КонецЕсли;	
		КонецЦикла;	
	Иначе
		
	КонецЕсли;
	
	//Три причины необходимости проверки руководителем
	Результат.ТребуетсяПроверкаРуководителем = (Результат.ПроцентКАСКОПревышен 
	ИЛИ (Результат.ИспытательныйСрок) 
	ИЛИ Результат.ТребуетсяПроверкаЛичнойЗаявки)
	И НЕ Объект.Тип = Перечисления.уб_ТипВыезда.Административный;
	
	
	Результат.ТребуетсяПроверкаАндеррайтером  = Результат.ЕстьЛимитыСтрахования и ПараметрыСотрудника.НеНуженАндеррайтингЗаявок = Ложь;
	
	
	Возврат Результат;
	
КонецФункции // СтруктураНеобходимостиУтверждений()


&НаСервере
Процедура ЗаполнениеНовогоДокумента()
	
	
	
	
	//уб_СтраховойБрокер.ЗаполнитьШапкуДокументаСтрБрокер(ЭтотОбъект, ПараметрыСеанса.ТекущийПользователь, мВалютаРегламентированногоУчета);
	//чкн
	//Курьер = Справочники.ФизическиеЛица.ПустойАгент;
	//чкн
	тДата = ТекущаяДата();
	Объект.Дата = тДата;
	нДня = НачалоДня(тДата);
	
	пФизлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
	Объект.Менеджер			    = ПараметрыСеанса.уб_ТекущееФизЛицо;
	Объект.УтвердилРуководитель = пФизлицо;
	Объект.УтвердилАндеррайтер  = пФизлицо;
	Объект.УтвержденоДата       = Дата(1,1,1);
	Объект.Утверждено           = Ложь;
	Объект.ТребуетсяПроверкаРуководителем   = ЛОЖЬ;
	Объект.ТребуетсяУтверждениеАндеррайтера = ЛОЖЬ;
	Объект.ФормаОплаты  = Перечисления.уб_ФормыОплаты.ПустаяСсылка();
	Объект.Кошелек      = Справочники.Кошельки.ПустаяСсылка();    
	Объект.ВидОплаты    = "";
	Объект.ВознаграждениеОтКлиента = 0;
	Объект.ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Менеджер;
	
	Объект.Срочная              = Ложь;
	Объект.НетДокументов        = Истина;
	Объект.РезультатПроверки    = Перечисления.уб_РезультатПроверкиЗаявки.ПустаяСсылка();
	
	//НеобходимостьОсмотра = перечисления.НеобходимостьОсмотра.БезОсмотра;
	Объект.ДатаСоздания         = ТекущаяДата();
	Объект.Комментарий          = "";
	
	Если Объект.БСО.Количество()>0  Тогда
		//Это копирование
		Если Параметры.Свойство("НеЗаменятьУИДСтрок") = Ложь Тогда
			//Подмена уид, чтобы они были уникальны во всей системе
			СоотЗамены = Новый Соответствие;
			Для каждого СтрокаБ Из Объект.БСО Цикл
				СтарыйУИД = СтрокаБ.УидСтроки;
				СтрокаБ.УидСтроки = Новый УникальныйИдентификатор;
				Если Не ПустаяСтрока(СтарыйУИД) Тогда
					СоотЗамены.Вставить(СтарыйУИД,СтрокаБ.УидСтроки);
				КонецЕсли;
			КонецЦикла;
			//Производим отдельной выборкой, т.к. возможна некорректная работа вложенного поиска по БСО
			Для каждого элСоот Из СоотЗамены Цикл
				мСтрок = Объект.БСО.НайтиСтроки(Новый Структура("УидРодителя",элСоот.Ключ));
				Для каждого СтрокаПБ Из мСтрок Цикл
					СтрокаПБ.УидРодителя = элСоот.Значение;//.УидСтроки;
				КонецЦикла;
				//мСтрок = СписокФайлов.НайтиСтроки(Новый Структура("УидСтроки",элСоот.Ключ));
				//Для каждого СтрокаПБ Из мСтрок Цикл
				//	СтрокаПБ.УидСтроки = элСоот.Значение;//.УидСтроки;
				//КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		//Зачистка неактульаных данных при копировании
		Для каждого СтрокаБ Из Объект.БСО Цикл
			
			Если НЕ ТипЗнч(СтрокаБ.ВидБСО)  = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
				СтрокаБСО = Строка(СтрокаБ.ВидБСО);
				Если Найти("ЕКАСКО,Е-КАСКО,ЕКаско,е-каско",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО	
				ИначеЕсли Найти("КАСКО,Каско,каско",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО;
				ИначеЕсли Найти("ЕОСАГО,Е-ОСАГО,ЕОсаго,е-осаго",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО	
				ИначеЕсли Найти("ОСАГО,Осаго,Осаго,Осаго-ТТТ,ОСАГО-ТТТ",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО;	
				ИначеЕсли Найти("ВРЗ,Взр,взр",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ВЗР;		
				ИначеЕсли Найти("ИМУЩЕСТВО,Имущество,имущество",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.Имущество;			
				ИначеЕсли Найти("ИПОТЕКА,Ипотека,ипотека",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.Ипотека;				
				ИначеЕсли Найти("НС,Клещ,Нс,КЛЕЩ",СтрокаБСО)>0 Тогда
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.НС;					
				Иначе	
					СтрокаБ.ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ПустаяСсылка();	
				КонецЕсли;	
			КонецЕсли;	
			СтрокаБ.Оператор          = пФизлицо;
			СтрокаБ.Состояние         = Перечисления.уб_СостояниеОформления.ПустаяСсылка();
			СтрокаБ.НомерБСО          = "";
			СтрокаБ.ДопНомерБСО       = "";
			СтрокаБ.ВыполненоРасчетов = 0;
			СтрокаБ.ВыполненоДоделок  = 0;
			СтрокаБ.ОператорДоделал   = пФизлицо;
			//
			СтрокаБ.ПринятыДеньгиАвтор = Справочники.Пользователи.ПустаяСсылка();
			СтрокаБ.ПринятыДеньги      = ЛОЖЬ;    
			СтрокаБ.Кошелек            = Справочники.Кошельки.ПустаяСсылка();    
			СтрокаБ.ФормаОплатыСтрока  = Неопределено; 
			//
			
			СтрокаБ.ДатаДвиженияБСО    = Дата(1,1,1);
			СтрокаБ.ДатаОформления     = Дата(1,1,1);
			СтрокаБ.Взнос2Дата         = Дата(1,1,1);
			СтрокаБ.Взнос3Дата         = Дата(1,1,1);
			СтрокаБ.Взнос4Дата         = Дата(1,1,1);  
			СтрокаБ.ДатаНачала         = Дата(1,1,1);   
			СтрокаБ.ДатаОкончания      = Дата(1,1,1);   
			
			СтрокаБ.ОфициальнаяСкидка  = Ложь;
			СтрокаБ.СтраховаяПремия              = 0;
			СтрокаБ.ПредоставленнаяСкидка        = 0;
			СтрокаБ.ПредоставленнаяСкидкаПроцент = 0;
			СтрокаБ.ЛимитОтветственности      = 0;  
			СтрокаБ.ИтогСтраховаяПремия       = 0;
			СтрокаБ.ИтогПредоставленнаяСкидка = 0;
			СтрокаБ.СуммаВзноса       = 0;
			СтрокаБ.ИтогСуммаВзноса   = 0;   
			СтрокаБ.Стоимость         = 0;
			СтрокаБ.Взнос2Сумма       = 0;
			СтрокаБ.Взнос1Сумма       = 0;
			СтрокаБ.Взнос3Сумма       = 0;  
			СтрокаБ.Взнос4Сумма       = 0;   
			СтрокаБ.Аддендум          = ЛОЖЬ;
			СтрокаБ.Франшиза          = 0;
			СтрокаБ.ОбъектСтрахования = Справочники.уб_ОбъектыСтрахования.ПустаяСсылка();
			
		КонецЦикла;
	КонецЕсли;
	Объект.СписокФайлов.Очистить();
	Объект.РасчетыПоЗаявке.Очистить();
	
	Если ПроверкаЗаявокОтделомКонтроля = Истина И Объект.Дата>Дата(2018,6,1) Тогда
		Объект.ТребуетсяУтверждениеАндеррайтера = Истина;
	КонецЕсли;	
	Объект.ФайловМенеджер            = 0;
	Объект.ФайловКурьер              = 0;
	Объект.ИндексРекомендации        = 0;
	Объект.ИндексЦепочкиРекомендаций = 0;
	Если Параметры.Свойство("СкопированС") = ЛОжь Тогда
		Объект.СтанцияМетро = Справочники.уб_СтанцииМетро.НайтиПоНаименованию("Дмитровская");
		Объект.Адрес     = "";
		//Объект.НеобходимостьОсмотра = Перечисления.НеобходимостьОсмотра.БезОсмотра;
		Объект.ТипВыезда = 1;
		Объект.Самовыезд = Истина;
	Иначе
