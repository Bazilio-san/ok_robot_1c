		Объект.ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Менеджер;
		Объект.ПриоритетЗадачи 		  = Перечисления.уб_ПриоритетЗадачи.Важно;
		//Курьер = Неопределено;
		
		Если Не ЗначениеЗаполнено(Объект.ВремяНачало) ИЛИ нДня = НачалоДня(Объект.ВремяНачало) Тогда
			//создание из формы списка, не из графика
			//Дата = ДатаСоздания+3600*1.5;
			//Округляем до 10 минут и прибавляем полтора часа
			Объект.ВремяНачало      = нДня+Цел((тДата-нДня)/600)*600+1.5*3600;
			Объект.ВремяНачало      = ПодобратьДатуНачала(Новый Структура("ВремяНачало,Курьер",Объект.ВремяНачало,Объект.Курьер));
			//ВремяНачало 	        = КонецЧаса(ТекущаяДата()) + 1 + 30 * 60;
			Объект.Дата			    = Объект.ВремяНачало;
			Объект.ВремяОкончания 	= Объект.ВремяНачало + 30 * 60;
		КонецЕсли;
		
	КонецЕсли;
	
	Объект.ВремяВстречиКлиент   = Дата(Год(нДня),Месяц(нДня),День(нДня),8,0,0);
	Объект.ВремяОкончанияКлиент = Дата(Год(нДня),Месяц(нДня),День(нДня),18,0,0);
	
	//Если Не ЗначениеЗаполнено(НомерЗаявки) Тогда
	//	НомерЗаявки = 0;
	//КонецЕсли;
	
	//УстановитьСсылкуНового(Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПолучитьСсылку());
	//ДополнительныеСвойства.Вставить("ЕстьПриемкиПоЗаявке",ЛОЖЬ);
	
	//СВС+
	//ОбновитьПараметры(ЭтотОбъект);
	//СВС-
	Объект.НомерДоговора   = Документы.уб_СтраховойПолис.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.Страхователь) = ЛОЖЬ Тогда
		Объект.Страхователь = пФизЛицо;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ПостроитьДеревоБСО()
	БСОДерево.ПолучитьЭлементы().Очистить();
	Если Объект.БСО.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для каждого СтрокаБСО Из Объект.БСО Цикл
		СтрокиДерева =  БСОДерево.ПолучитьЭлементы();
		Если ПустаяСтрока(СтрокаБСО.УидРодителя)= Ложь Тогда
			Для каждого СтрокаРодитель из СтрокиДерева Цикл
				Если СтрокаРодитель.УидСтроки = СтрокаБСО.УидРодителя Тогда
					СтрокиДерева = СтрокаРодитель.ПолучитьЭлементы();
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
		Конецесли;	
		СтрокаДерева = СтрокиДерева.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева,СтрокаБСО);
	КонецЦикла;
	//Для каждого СтрокаДерева Из БСОДерево.Строки  Цикл
	//	Элементы.БСОДерево.Развернуть(СтрокаДерева,Истина);
	//КонецЦикла;
	Возврат Истина;
КонецФункции


&НаСервере
Процедура ОбновитьИтоги(Предупреждать = Истина,ПриОткрытии = ЛОЖЬ);
	
	ФС = "ЧДЦ = 2; ЧН = 0";
	//Если Элементы.ПанельИнфоОСтраховке.Страницы.Основная.Доступность Тогда
	
	Для каждого ТекСтрока из Объект.БСО Цикл
		Если ТекСтрока.Количество = 0 Тогда
			ТекСтрока.Количество = 1;
		КонецЕсли;	
		
		Если ТекСтрока.СуммаВзноса = 0 И ТекСтрока.ПредоставленнаяСкидка>0 Тогда
			ТекСтрока.СуммаВзноса = ТекСтрока.СтраховаяПремия;
		КонецЕсли;
		
		Если ТекСтрока.ПредоставленнаяСкидка = 0 И ТекСтрока.ПредоставленнаяСкидка>0 Тогда
			ТекСтрока.ПредоставленнаяСкидка     = ТекСтрока.СуммаВзноса * ТекСтрока.Количество*ТекСтрока.ПредоставленнаяСкидкаПроцент/100;
			ТекСтрока.ИтогПредоставленнаяСкидка = ТекСтрока.ПредоставленнаяСкидка * ТекСтрока.Количество;
		КонецЕсли;
		
