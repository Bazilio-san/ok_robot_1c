Функция БудетСрочная()
	
	Если Объект.УтвержденоДата=Дата(1,1,1) Тогда
		ДатаПроверки = ?(Объект.УтвержденоДата=Дата(1,1,1),ТекущаяДата(),Объект.УтвержденоДата);
		
		Если ДатаПроверки<>Дата(1,1,1) 
			И (Объект.Дата<КонецДня(ДатаПроверки) 
			ИЛИ ( ДатаПроверки>(НачалоДня(ДатаПроверки)+16*3600+45*60)
			И Объект.Дата <(КонецДня(ДатаПроверки)+16*3600+45*60+1)	
			)
			) Тогда
			//
			//Предупреждение("Срочная");
			//Элементы.нСрочная.Видимость = Истина;
		Иначе
			//Элементы.нСрочная.Видимость = Ложь;
		КонецЕсли;
	Иначе
		//Элементы.нСрочная.Видимость = Ложь;
	КонецЕсли;
	
	Если Объект.УтвержденоДата<>Дата(1,1,1) 
		И (Объект.Дата<КонецДня(Объект.УтвержденоДата) 
		ИЛИ ( Объект.УтвержденоДата>(НачалоДня(Объект.УтвержденоДата)+16*3600+45*60)
		И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+16*3600+45*60+1)	
