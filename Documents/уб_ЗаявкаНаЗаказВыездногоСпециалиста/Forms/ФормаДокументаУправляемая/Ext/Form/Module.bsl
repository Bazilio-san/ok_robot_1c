&НаКлиенте
Функция РасчетСКВПоЗаявке(Комиссия) Экспорт
	Если Объект.Дата<Дата(2016,2,11) Тогда
		Возврат 999999;//Заоблачное значение
	КонецЕсли;	
	_СКВ = 0;
	Для Каждого СтрокаБСО Из Объект.БСО Цикл
		Если ТипЗнч(СтрокаБСО.ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
			Если Найти("Техосмотр",Строка(СтрокаБСО.ВидБСО))>0 Тогда
				//Если СтрокаБСО.ВидБСО.Тип = Перечисления.уб_ТипыБСО.ПолисОсаго Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		
		ТекФормаОплаты = СтрокаБСо.ФормаОплатыСтрока;//?(СтрокаБСо.ФормаОплатыСтрока.Пустая(),ФормаОплаты,СтрокаБСо.ФормаОплатыСтрока );
		Если Объект.Дата>=Дата(2026,1,1) 
			и ТекФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Поставщику") 
			и СтрокаБСО.ВидБСО<>ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.Ипотека")
			и СтрокаБСО.ВидБСО<>ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ВЗР") Тогда
			дельта = 3;
			
		Иначе
			дельта = 0;
		КонецЕсли;	
		Комиссия = Комиссия+Окр((дельта)*СтрокаБСО.ИтогСтраховаяПремия/100,2);
		СуммаСтроки = Окр((СтрокаБСО.КВБрокераПлан-дельта)*СтрокаБСО.ИтогСтраховаяПремия/100,2)-СтрокаБСО.ИтогПредоставленнаяСкидка;

		
		
		_СКВ = _СКВ+ СуммаСтроки;
	КонецЦикла;	
	//Если ИсточникФинансирования = Перечисления.уб_ИсточникиФинансирования.Клиент Тогда
	_СКВ = _СКВ+ Объект.ВознаграждениеЧастьКлиента+Объект.ВознаграждениеОтМенеджера-Объект.СуммаПоКарте;
	//КонецЕсли;	
	//Если СКВ >= 1000 И СКВ <= 3350 И  НомерЗаявки <> Перечисления.уб_ВидыЗаявок.Личная Тогда
	//	#Если Клиент тогда
