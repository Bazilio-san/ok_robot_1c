	ИЛИ Объект.НомерЗаявки = ПредопределенноеЗначение("Перечисление.уб_ВидыЗаявок.Агентская")) 
	И не (Объект.Тип = ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.Пролонгация") ИЛИ Объект.Тип = ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.ОчереднойВзнос"));
	
