	Иначе	
		//Если уб_УСЗ.ВыполнитьДействиеПоЗаявке(Объект.Ссылка, СтатусЗаявки, Действие,,, ТекстКоманды,, ЭтаФорма.Объект) Тогда
		Если уб_УСЗ.ВыполнитьДействиеПоЗаявке(Объект.Ссылка, СтатусЗаявки, Действие,,, ТекстКоманды,, ) Тогда
			Если Действие = "УстановитьСтатус_ЗапросНаУдаление" Тогда
				
				//ДополнительныеСвойства.Вставить("ЕстьПриемкиПоЗаявке",Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ЕстьПриемкиПоЗаявке(Объект.Ссылка));
				///уб_temp.УстановитьСтатусДокумента(ЭтаФорма,, ?(ДополнительныеСвойства.ЕстьПриемкиПоЗаявке = ЛОЖЬ, Неопределено, ЧастнаяСтруктураСтатусаДокумента()));
				//уб_СС.ЗаполнитьИнфСтроку(ЭтаФорма);	
