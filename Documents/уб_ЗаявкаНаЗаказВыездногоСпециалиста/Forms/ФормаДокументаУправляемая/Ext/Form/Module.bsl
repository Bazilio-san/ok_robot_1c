&НаКлиенте
Процедура ОтправитьВРеализацию(Команда)
	
	
	Если ПроверитьЗаполнениеРеквизитов() Тогда
		Записать(Новый Структура("РежимЗаписи",РежимЗаписиДокумента.Проведение));
	Иначе
		Возврат;
	КонецЕсли;	
	
	Если Объект.Проведен и Команда<>Неопределено Тогда
		//ОсталосьДоВыезда = Дата-ТекущаяДата();
		ОсталосьДоВыезда = Объект.ВремяВстречиКлиент-ТекущаяДата();
		
		Если ОсталосьДоВыезда <3600  и Объект.ТипВыезда = 0 Тогда
			ПоказатьПредупреждение(,"До выезда менее часа или просрочен. Запрещено");
			Возврат;
		КонецЕсли;	
		СтатусЗаявки = уб_УСЗ.ВернутьСтатусЗаявки(Объект.Ссылка, ТекущаяДата());
		Если СтатусЗаявки = ПредопределенноеЗначение("Перечисление.уб_СтатусыЗаявок.СогласованиеСКлиентом") Тогда
			Если Объект.Тип = ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.Административный")
				или Объект.Тип = ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.ПервичныйОсмотр") Тогда
				Действие = "УстановитьСтатус_НазначениеКурьера";
				СтрокаРеквизитов = Неопределено;
			Иначе	
				Действие = "УстановитьСтатус_ФормированиеКомплектаБСО";
				СтрокаРеквизитов = Неопределено;
			КонецЕсли;	
			
			уб_УСЗ.ВыполнитьДействиеПоЗаявке(Объект.Ссылка, СтатусЗаявки, Действие, СтрокаРеквизитов,,,,);
		КонецЕсли;	
	КонецЕсли;	
	ВидимостьСтатусаЗаявки();
	Закрыть("СохранитьИОтправить");
КонецПроцедуры

