&НаСервере
Процедура ИнициализироватьФорму()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ Тогда
		//!!!
		ЗаполнениеНовогоДокумента();
		//
		ПараметрСтатуса = Неопределено;
		СтатусЗаявки = Перечисления.уб_СтатусЗаявки.ПустаяСсылка();
	Иначе
		Если Объект.Источник = Неопределено Тогда
			Объект.Источник = Справочники.ФизическиеЛица.ПустаяСсылка();	
		КонецЕсли;	
		ПараметрСтатуса = ЧастнаяСтруктураСтатусаДокумента();
		СтатусЗаявки = уб_УСЗ.ВернутьСтатусЗаявки(Объект.Ссылка);
	КонецЕсли;
	
	Если ТипЗнч(Объект.Страхователь) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ТипСтрахователя = "ФИО";
	КонецЕсли;	
	
	ПроверкаЗаявокОтделомКонтроля = ПараметрыСеанса.уб_Константы.ПроверкаЗаявокОтделомКонтроля;
	
