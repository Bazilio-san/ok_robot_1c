&НаСервере
Процедура ПодобратьВидОплаты(Форма,_ЭтотОбъект) Экспорт
	Если Объект.ВидОплаты = "" И ЗначениеЗаполнено(_ЭтотОбъект.ФормаОплаты) Тогда
		
		Если _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Безнал Тогда
			Объект.ВидОплаты = "На р\с в КПП (0%)";
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Тогда
			Объект.ВидОплаты = "Наличными (0%)";
			//ИначеЕсли ФормаОплаты = Перечисления.уб_ФормыОплаты.ВКредит Тогда
			//	ВидОплаты = "В кредит (0%)";	
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.НаКарту Тогда
			Если ЗначениеЗаполнено(_ЭтотОбъект.Кошелек) Тогда
				Объект.ВидОплаты = "На карту "+ СокрЛП(_ЭтотОбъект.Кошелек) +"(0%)";		
			Иначе	
				Объект.ВидОплаты = "На карту (0%)";		
			КонецЕсли;	
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПоСсылкеБрокеру Тогда
			Объект.ВидОплаты = "По ссылке в КПП (3%)";			
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику Тогда
			Объект.ВидОплаты = "В страховую -3%(потерянная сумма)";				
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Терминал Тогда
			Объект.ВидОплаты = "Терминал (3%)";
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПоQR Тогда
			Объект.ВидОплаты = "По QR коду (0%)";		
		КонецЕсли;
		
	КонецЕсли;	
КонецПроцедуры


