&НаСервере
Процедура ПриИзмененииСамовыезд(Предупреждать = Ложь)
	
	Если Объект.ТипВыезда = 1 Тогда
		//Самовыезд
		_Самовыезд = Истина;
		уб_ВызовСервера._УстановитьЗначение(Объект,"Адрес","Офис");
		Объект.СтанцияМетро = Справочники.уб_СтанцииМетро.НайтиПоНаименованию("Дмитровская");
	ИначеЕсли Объект.ТипВыезда = 0 Тогда
		//Курьер
		_Самовыезд = Ложь;
		Если Объект.СтанцияМетро = Справочники.уб_СтанцииМетро.НайтиПоНаименованию("Дмитровская") Тогда
			Объект.СтанцияМетро = Справочники.уб_СтанцииМетро.ПустаяСсылка();
		КонецЕсли;	
	ИначеЕсли Объект.ТипВыезда = 2 Тогда
		//Офис
		_Самовыезд = Истина;
		//Если ПустаяСтрока(Адрес) Тогда
		уб_ВызовСервера._УстановитьЗначение(Объект,"Адрес","Офис");
		Объект.СтанцияМетро = Справочники.уб_СтанцииМетро.НайтиПоНаименованию("Дмитровская");
		//КонецЕсли;
	Иначе
		_Самовыезд = Объект.Самовыезд;
	КонецЕсли;
	
	уб_ВызовСервера._УстановитьЗначение(Объект,"Самовыезд",_Самовыезд);
	
	//КонтрольДатыВыездаЛички(ДатаСоздания);
	
	
	Элементы.Курьер.Видимость 	  = Не Объект.Самовыезд;
	//Элементы.нКурьер.Видимость    = Не Объект.Самовыезд;
	Элементы.ГруппаЗанятость.Видимость = Не Объект.Самовыезд;
	//Элементы.тКурьера.Видимость   = Не Объект.Самовыезд;
	//Элементы._Самовыезд.Заголовок = ?(Объект.СамоВыезд, "Курьер", "Курьер:");
	Если Не Объект.Самовыезд и ЗначениеЗаполнено(Объект.Курьер) = Ложь Тогда
		Объект.Курьер = Справочники.ФизическиеЛица.ПустойАгент;
	КонецЕсли;	
	
	//
	Если Объект.Срочная и Объект.Самовыезд = Истина Тогда
		Объект.ВознаграждениеОтКлиента = Объект.ОплатитьВКассуЗаВыездКурьера;
	КонецЕсли;	
	
КонецПроцедуры


