&НаСервереБезКонтекста
Функция СписокНеТребуемыхДляЗаполненияПолей(Тип,ДатаСоздания)
	
	Список = Новый Массив;
	Прч = Перечисления.уб_ТипВыезда;
	Список.Добавить("СК");

	Если Тип = Прч.Страховка Тогда
		Список.Добавить("ЦельВыезда");
		Список.Добавить("СК");
		Список.Добавить("НомерДоговора");
		Список.Добавить("ЦельВыезда");
	ИначеЕсли Тип = Прч.Пролонгация Тогда
		Список.Добавить("ЦельВыезда");
	ИначеЕсли Тип = Прч.ОчереднойВзнос Тогда
		Список.Добавить("ЦельВыезда");
	ИначеЕсли Тип = Прч.Перепись Тогда
		Список.Добавить("ЦельВыезда");
	ИначеЕсли Тип = Прч.Переосмотр Тогда
		
	ИначеЕсли Тип = Прч.Административный Тогда
		//Если Объект.ЦельВыезда = "Административный" Тогда
		Список.Добавить("НомерЗаявки");
		//Список.Добавить("Банк");
		Список.Добавить("НомерДоговора");
		//КонецЕсли;
		
		Список.Добавить("ВознаграждениеКурьера");
	ИначеЕсли Тип = Прч.Аддендум Тогда
		
		Список.Добавить("ЦельВыезда");
	ИначеЕсли Тип = Прч.ПервичныйОсмотр Тогда
		
		Список.Добавить("СК");
		Список.Добавить("НомерДоговора");
		Список.Добавить("ЦельВыезда");
	КонецЕсли;
	ДатаАктуальна = ЗначениеЗаполнено(ДатаСоздания) И ДатаСоздания >= '20131001';
	Если Не ДатаАктуальна Тогда
		МассивНовыхПолей = Новый Массив;
		МассивНовыхПолей.Добавить("СК");
		МассивНовыхПолей.Добавить("СтанцияМетро");
		МассивНовыхПолей.Добавить("Город");
		МассивНовыхПолей.Добавить("ЦельВыезда");
		МассивНовыхПолей.Добавить("НомерДоговора");
		МассивНовыхПолей.Добавить("КонтактноеЛицо");
		Для Каждого ЭлементМассива Из МассивНовыхПолей Цикл
			Если Список.НайтиПоЗначению(ЭлементМассива) = Неопределено Тогда
				Список.Добавить(ЭлементМассива)
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Список;		
	
КонецФункции

Функция ЧастнаяСтруктураСтатусаДокумента()
	
	Структура = Новый Структура;
	Структура.Вставить("Заголовок", 	"Приняты деньги!");
	Структура.Вставить("ЦветТекста",	ЦветаСтиля.ЦветТекстаПроведен);
	Структура.Вставить("ЦветФона",		ЦветаСтиля.ЦветФонаПроведен);
	Подсказка = "По заявке приняты деньги, изменять заявку нельзя!";
	Структура.Вставить("Подсказка",		Подсказка);
	Структура.Вставить("Пояснение",		Подсказка);
	Возврат Структура;
	
