&НаКлиенте
Процедура ПриИзмененииДата()
	
	Если Объект.Утверждено и Элементы.РезультатПроверки.ТолькоПросмотр = Истина Тогда
		ДатаМакс = Объект.УтвержденоДата+24*3600*7;
		Если Объект.Дата>ДатаМакс Тогда
			Объект.Дата = ДатаМакс;
			ПоказатьПредупреждение(,"Вам запрещено ставить дату позднее 7 дней после утверждения");
		КонецЕсли;	
	КонецЕсли;	
	
	СинхронизироватьДатыВстречи(1);
	ПоказателиРасчетаЗП = уб_РасчетыСМенеджерами.ПоказателиРасчетаЗП(Объект.Дата);
	ПроверкаСрочности(Истина);
	Если ПроверкаЗаявокОтделомКонтроля = Истина и Объект.Дата>Дата(2018,6,1) Тогда
		Объект.ТребуетсяУтверждениеАндеррайтера = Истина;
	КонецЕсли;	 
КонецПроцедуры


