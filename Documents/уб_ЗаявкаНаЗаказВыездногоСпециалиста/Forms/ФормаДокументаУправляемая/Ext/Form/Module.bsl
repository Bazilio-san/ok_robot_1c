&НаКлиенте
Процедура РезультатПроверкиПриИзменении(Элемент)
	ТребуетсяЗапись = Ложь;
	ИзменилсяРезультат = Ложь;
	Если ЗначениеЗаполнено(Объект.РезультатПроверки) Тогда
		//УстановитьЗначение(ТребуетсяУтверждениеАндеррайтера,Ложь);
		//
		уб_Клиент._УстановитьЗначение(ЭтаФорма,"ПровереноАндеррайтером",Истина);
		
		Если уб_ВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Ссылка,"РезультатПроверки")<>Объект.РезультатПроверки Тогда
			ТребуетсяЗапись = Истина;
			ИзменилсяРезультат = Истина;
		КонецЕсли;			
	Иначе	
		//УстановитьЗначение(ТребуетсяУтверждениеАндеррайтера,Истина);
		ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(ЭтаФорма,"ПровереноАндеррайтером",Ложь);
		ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(Объект,"УтвердилАндеррайтер",ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка")) или ТребуетсяЗапись;		 
	КонецЕсли;	
	
	Элементы.СтаршийОператор.Доступность = Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПринятоВРаботу") 
	                                       ИЛИ  Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПринятоСДоработкой");
										   
	Элементы.БСОДеревоТекущийОператор.Доступность = Элементы.СтаршийОператор.Доступность;
	_Причина = "";
	Если Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПринятоВРаботу") Тогда
//		Элементы.РезультатПроверки.ЦветФона = Новый Цвет(150,255,150);
		_Причина = "Заявка "+Объект.Номер+" принята в работу.";
		_ЦветФона = "rgb(150,255,150)";
		
		Если ПроверкаЗаявокОтделомКонтроля = Истина и Объект.Дата>Дата(2018,6,1) Тогда
			ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(ЭтаФорма,"ПровереноРукСВС",Истина) или ТребуетсяЗапись;
			ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(Объект,"Утверждено",Истина) или ТребуетсяЗапись;
			Если Объект.УтвержденоДата = Дата(1,1,1) Тогда
				Объект.УтвержденоДата = ТекущаяДата();	
				//КонтрольДатыВыездаЛички(УтвержденоДата,Ложь);
				ПроверкаСрочности(Ложь);
			КонецЕсли;
		КонецЕсли;	
	Иначе
		
		Если ПроверкаЗаявокОтделомКонтроля = Истина  и Объект.Дата>Дата(2018,6,1) Тогда
			ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(ЭтаФорма,"ПровереноРукСВС",Ложь) ИЛИ ТребуетсяЗапись;
			ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(Объект,"Утверждено",Ложь) ИЛИ ТребуетсяЗапись;
		КонецЕсли;
		
		Если Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПринятоСДоработкой") Тогда 
			
			Элементы.РезультатПроверки.ЦветФона = Новый Цвет(200,200,0);
			Если ТребуетсяЗапись Тогда
				Если ВвестиСтроку(_Причина,"Внесите причину для доработки") Тогда
					Объект.КомментарийСлужебный=Объект.КомментарийСлужебный+Символы.ПС+"Результат проверки: "+_Причина;
				КонецЕсли;	
				_Причина ="Заявка "+Объект.Номер+" принята в работу, но нуждается в доработке: "+?(_Причина="","свяжитесь с отделом ОСД",_Причина);
				_ЦветФона = "rgb(200,200,0)";
			КонецЕсли;	
		ИначеЕсли Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.Отклонено") Тогда 
			
//			Элементы.РезультатПроверки.ЦветФона = Новый Цвет(255,100,100);
			Если ТребуетсяЗапись Тогда
				Если ВвестиСтроку(_Причина,"Внесите причину отклонения") Тогда
					Объект.КомментарийСлужебный=Объект.КомментарийСлужебный+Символы.ПС+"Результат проверки: "+_Причина;
				КонецЕсли;	
				_Причина ="Заявка "+Объект.Номер+" отклонена: "+?(_Причина=""," без указания причины, свяжитесь с отделом ОСД",_Причина);
				_ЦветФона = "rgb(255,100,100)";
			КонецЕсли;	
		Иначе	
			
			//Элементы.РезультатПроверки.ЦветФона = Новый Цвет;
			Если ТребуетсяЗапись Тогда
				_Причина = "Заявка "+Объект.Номер+" снята с проверки";
				_ЦветФона = "rgb(150,150,255)";
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если ИзменилсяРезультат = Истина Тогда
		ОтправитьУведомление(_Причина,_ЦветФона,Новый Структура("Номер,Страхователь,Менеджер",Объект.Номер,Объект.Страхователь,Объект.Менеджер));
	КонецЕсли;	
		
	Если ТребуетсяЗапись = Истина Тогда
		ПровереноАндеррайтеромПриИзменении(Элемент,Истина);
		//Записать();
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПровереноАндеррайтеромПриИзменении(Элемент,ТребуетсяЗапись = Ложь)
	//Пока делаем допущение:
	//если поле доступно, то проверки на права здесь не надо выполнять
	
	Если ЭтаФорма.ПровереноАндеррайтером = Истина Тогда 
		Если ЗначениеЗаполнено(Объект.УтвердилАндеррайтер) = ЛОЖЬ Тогда
			ПолныеПраваДляПоля = Элементы.УтвердилАндеррайтер.СписокВыбора.НайтиПоЗначению(Уб_ВызовСервера.ТекущееФизЛицо())<>Неопределено;//; 
			Если ПолныеПраваДляПоля Тогда
				уб_Клиент._УстановитьЗначение(Объект,"УтвердилАндеррайтер", уб_вызовсервера.ТекущееФизлицо());
			Иначе
				ЭтаФорма.ПровереноАндеррайтером = Ложь;
				Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПустаяСсылка");
			КонецЕсли;	
			
			ТребуетсяЗапись = Истина;			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Объект.РезультатПроверки) = ЛОЖЬ Тогда
			Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПринятоВРаботу");
			ТребуетсяЗапись = Истина;
		КонецЕсли;	
		
		Если ТребуетсяЗапись = Истина Тогда
			//СохранитьИОтправить(Элемент);
			Записать();
		КонецЕсли;	
		
	Иначе
		Если ЗначениеЗаполнено(Объект.РезультатПроверки) = Истина Тогда
			Объект.РезультатПроверки = ПредопределенноеЗначение("Перечисление.уб_РезультатПроверкиЗаявки.ПустаяСсылка");
			ТребуетсяЗапись = Истина;
			Если ПроверкаЗаявокОтделомКонтроля = Истина и Объект.Дата>=Дата(2018,6,1) Тогда
				ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(ЭтаФорма,"ПровереноРукСВС",Ложь) ИЛИ ТребуетсяЗапись;
				ТребуетсяЗапись = уб_Клиент._УстановитьЗначение(Объект,"Утверждено",Ложь) ИЛИ ТребуетсяЗапись;
			КонецЕсли;
		КонецЕсли;	
		Если ТребуетсяЗапись Тогда
			Записать();//Сразу поскольку далее заблокируется кнопка записать
		КонецЕсли;	
	КонецЕсли;	
	
	
		
	ИзменитьДоступность();

КонецПроцедуры


