			ПоказатьВводДаты(Новый ОписаниеОповещения("ПриВводеДатыРождения",ЭтаФорма,ПараметрыСоздания),Дата(1,1,1),"Введите дату рождения",ЧастиДаты.Дата);
			
			//Если ВвестиДату(ДатаРождения,"Введите дату рождения") Тогда
			//	
			//КонецЕсли;	
			//Закрыть(Страхователь);
		Иначе	
			ПоказатьВводСтроки(Новый ОписаниеОповещения("ПриВводеИНН",ЭтаФорма,ПараметрыСоздания),"","Введите ИНН",,ЛОЖЬ);
			//ИНН = "";
			//Если ВвестиСтроку(ИНН,"Введите ИНН") Тогда
			//	
			//КонецЕсли;	
			
			//Закрыть(Страхователь);
		КонецЕсли;
	КонецЕсли;
	//НастройкиНаименования();

КонецПроцедуры

&НаКлиенте
Процедура ПриВводеДатыРождения(ВыбраннаяДата,ПараметрыСоздания) Экспорт
	Если Не ВыбраннаяДата = Неопределено Тогда
		ДатаРождения = ВыбраннаяДата;
		Возраст = цел((ТекущаяДата()-ДатаРождения)/365);
		Если ДатаРождения = Дата(2020,1,1) или ГОД(ДатаРождения) = ГОД(ТекущаяДата())  Тогда
			ДатаРождения = Дата(1,1,1)
		ИначеЕсли Возраст<18 и возраст>99 Тогда
			ДатаРождения = Дата(1,1,1)
		КонецЕсли;	
		Если ДатаРождения = Дата(1,1,1) Тогда
			ПоказатьВводДаты(Новый ОписаниеОповещения("ПриВводеДатыРождения",ЭтаФорма,ПараметрыСоздания),Дата(1,1,1),"Введите дату рождения",ЧастиДаты.Дата);
		КонецЕсли;	
		ПараметрыСоздания.Вставить("ДатаРождения",ВыбраннаяДата);
		Объект.Страхователь = СоздатьСтрахователяНаСервере(ПараметрыСоздания);
		Наименование = Строка(Объект.Страхователь);
		НастройкиНаименования();
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ПриВводеИНН(ВыбраннаяСтрока,ПараметрыСоздания) Экспорт
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	ИНН = ВыбраннаяСтрока;
	
	Если Уб_ВызовСервера.ПроверитьИНН(ИНН) = ЛОЖЬ Тогда
		ПоказатьВводСтроки(Новый ОписаниеОповещения("ПриВводеИНН",ЭтаФорма,ПараметрыСоздания),ИНН,"Введите ИНН",,ЛОЖЬ);
		Возврат;
	КонецЕсли;	

	Если Не ВыбраннаяСтрока = Неопределено и не ПустаяСтрока(ВыбраннаяСтрока) Тогда
		ПараметрыСоздания.Вставить("ИНН",ВыбраннаяСтрока);
		Объект.Страхователь = СоздатьСтрахователяНаСервере(ПараметрыСоздания);
		Наименование = Строка(Объект.Страхователь);
		НастройкиНаименования();
	КонецЕсли;
КонецПроцедуры	

&НаСервереБезКонтекста
Функция СоздатьСтрахователяНаСервере(ПараметрыСоздания)
	Если ПараметрыСоздания.Свойство("ЭтоФизЛицо")и ПараметрыСоздания.ЭтоФизЛицо = Истина Тогда
		_Страхователь = НайтиСтраховователя(ПараметрыСоздания.Наименование,ПараметрыСоздания.ДатаРождения,"ФИО");
		Если ЗначениеЗаполнено(_Страхователь) Тогда
			Страхователь  = _Страхователь;
		Иначе
			ОбСтрахователь = Справочники.ФизическиеЛица.СоздатьЭлемент();
			ОбСтрахователь.УстановитьНовыйКод("");
			ОбСтрахователь.Автор        = ПараметрыСеанса.ТекущийПользователь;
			ОбСтрахователь.Модификатор  = ПараметрыСеанса.ТекущийПользователь;
			ОбСтрахователь.ДатаСоздания = ТекущаяДата();
			ОбСтрахователь.ДатаИзменения = ТекущаяДата();
			ОбСтрахователь.Наименование = ПараметрыСоздания.Наименование;
			ОбСтрахователь.Пол = ?(Найти(ПараметрыСоздания.Наименование,"вна")>0, Перечисления.ПолФизическихЛиц.Женский, Перечисления.ПолФизическихЛиц.Мужской);
			Если ЗначениеЗаполнено(ПараметрыСоздания.ДатаРождения) Тогда
				Попытка
					ОбСтрахователь.ДатаРождения = ПараметрыСоздания.ДатаРождения;
				Исключение
				КонецПопытки;	
			КонецЕсли;
			ОбСтрахователь.ОбменДанными.Загрузка = Истина;
			ОбСтрахователь.Записать();
			
			Страхователь = ОбСтрахователь.Ссылка; 
		КонецЕсли;
	Иначе	
		_Страхователь = НайтиСтраховователя(ПараметрыСоздания.Наименование,ПараметрыСоздания.ИНН,"Организация");
		
		Если ЗначениеЗаполнено(_Страхователь) Тогда
			Страхователь  = _Страхователь;
		Иначе
			ОбСтрахователь = Справочники.Контрагенты.СоздатьЭлемент();
			ОбСтрахователь.УстановитьНовыйКод("");
			ОбСтрахователь.Автор        = ПараметрыСеанса.ТекущийПользователь;
			ОбСтрахователь.Модификатор  = ПараметрыСеанса.ТекущийПользователь;
			ОбСтрахователь.ДатаСоздания = ТекущаяДата();
			ОбСтрахователь.ДатаИзменения = ТекущаяДата();
			ОбСтрахователь.Наименование = ПараметрыСоздания.Наименование;
			ОбСтрахователь.НаименованиеПолное = ПараметрыСоздания.Наименование;
			ОбСтрахователь.НаименованиеКраткое = ПараметрыСоздания.Наименование;
			ОбСтрахователь.ЮрФизЛицо = перечисления.ЮрФизЛицо.ЮрЛицо;
			ОбСтрахователь.ИНН = ПараметрыСоздания.ИНН;
			//ОбСтрахователь.КПП = КПП;
			ОбСтрахователь.ОбменДанными.Загрузка = Истина;
			ОбСтрахователь.Записать();
			
			Страхователь = ОбСтрахователь.Ссылка; 
		КонецЕсли;
	КонецЕсли;
	Возврат Страхователь;
КонецФункции	

&НаСервереБезКонтекста
Функция НайтиСтраховователя(Наименование,ИНН,ТипСтрахователя)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование",Наименование);
	
	Если ТипСтрахователя="ФИО" Тогда
		Запрос.УстановитьПараметр("ДатаРождения",ИНН);
		Запрос.Текст = "ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка,
		|	ФизическиеЛица.Наименование,
		|	ФизическиеЛица.Код КАК Код
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.Наименование ПОДОБНО &Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическиеЛица.ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА ФизическиеЛица.ДатаРождения = &ДатаРождения
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	Код";
		
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(ИНН) и ЗначениеЗаполнено(Выборка.Ссылка.ДатаРождения) Тогда
				Если Выборка.Ссылка.ДатаРождения = ИНН Тогда
					Возврат Выборка.Ссылка;
				Иначе
				КонецЕсли;	
			Иначе	
				Возврат Выборка.Ссылка;
			КонецЕсли;	
				
		КонецЦикла;
		Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	Иначе
		Запрос.УстановитьПараметр("ИНН",ИНН);
		Запрос.Текст = "ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	Контрагенты.Наименование,
		|	Контрагенты.Код КАК Код
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование ПОДОБНО &Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА Контрагенты.ИНН = &ИНН
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	Код";
		
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.Ссылка;
		КонецЦикла;
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	ВыполненПоискСтрахователя = ЗначениеЗаполнено(Объект.Страхователь);
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоЦифры =  ОбщегоНазначения.ТолькоЦифрыВСтроке(Наименование);
	ЭтоФизЛицо = ТипЗНЧ(Объект.Страхователь) = Тип("СправочникСсылка.ФизическиеЛица")  ИЛИ Объект.Страхователь = Неопределено;
	
	Если (НАЙТИ(ВРЕГ(Наименование),"ООО")>0 ИЛИ ЛЕВ(ВРЕГ(Наименование),2) = "АО") И ЭтоФизЛицо
		
		Тогда
		ЭтоФизЛицо = Ложь;
		Объект.Страхователь = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		//ФизЛицоПриИзменении(Элемент);
		Модифицированность = Истина;
	КонецЕсли;
	Если ЭтоФизЛицо = Ложь Тогда//в том числе при открытии старого контрагента
		ТипСтрахователя = "Организация";
	КонецЕсли;	
	
	Если ЭтоФизЛицо Тогда
		ТипСтрахователя = "ФИО";
		НовоеНаименование = НовоеНаименование(Наименование);
		Если НовоеНаименование<>Наименование Тогда
			Наименование = НовоеНаименование;
			Модифицированность = Истина;
		КонецЕсли;			
		Если ЗначениеЗаполнено(Объект.Страхователь) = ЛОЖЬ Тогда
			Страхователи = уб_ВызовСервера.СтрахователиПоНаименованию(Наименование);
			Если Страхователи.Количество()>0 Тогда
				//ТипСтрахователя = "Организация";
				//Страхователь = Страхователи[0];
				Если Страхователи.Количество() = 1 Тогда
					Объект.Страхователь = Страхователи[0];
					Наименование = Строка(Объект.Страхователь);
					ВыполненПоискСтрахователя = Истина;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ЭтоФизЛицо = Ложь Тогда	
		Если ЗначениеЗаполнено(Объект.Страхователь) = ЛОЖЬ Тогда
			Страхователи = уб_ВызовСервера.СтрахователиПоНаименованию(Наименование);
			Если Страхователи.Количество()>0 Тогда
				//ТипСтрахователя = "Организация";
				Объект.Страхователь = Страхователи[0];
				Если Страхователи.Количество() = 1 Тогда
					Наименование = Строка(Объект.Страхователь);
					ВыполненПоискСтрахователя = Истина;
				КонецЕсли;	
			КонецЕсли;		
		КонецЕсли;		
	КонецЕсли;
	Если Модифицированность = Истина Тогда
		ВыполненПоискСтрахователя = Ложь;
		//Изменили, надо очистить
		Если ТипСтрахователя = "ФИО" Тогда
			Объект.Страхователь = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
		Иначе
			Объект.Страхователь = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли;	
	КонецЕсли;	
	
	НастройкиНаименования();
	
КонецПроцедуры


&НаКлиенте
Процедура НаименованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = ЛОЖЬ;
		Попытка
			Наименование        = Строка(ВыбранноеЗначение.Страхователь);
			Объект.Страхователь = ВыбранноеЗначение.Страхователь;
			ВыполненПоискСтрахователя = Истина;
			НастройкиНаименования();
			Модифицированность = Истина;
		Исключение
		КонецПопытки;	
	КонецЕсли;	
	
КонецПроцедуры

