&НаСервере
Процедура ЗаполнитьСпискиГородов()
	Элементы.Город.КнопкаВыпадающегоСписка = Истина;
	Элементы.Город.КнопкаВыбора            = Ложь;
	Элементы.Город.ВысотаСпискаВыбора      = 15;
	
	СписокВыбора 	= Элементы.Город.СписокВыбора;
	СписокВыбора.ЗагрузитьЗначения(уб_КЭШируемые.СписокГородов());
КонецПроцедуры

&НаСервереБезКонтекста
Функция АдресСпискаСтрахователей(Наименование,ТипСтрахователь)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент",ПараметрыСеанса.уб_ТекущееФизЛицо);
	Запрос.УстановитьПараметр("Наименование","%"+Наименование+"%");
	Запрос.УстановитьПараметр("КлючПоиска",уб_ВызовСервера.КлючПоискаНаименования(Наименование));
	Если ТипСтрахователь = Тип("СправочникСсылка.Контрагенты") Тогда
		_Наименование = ""+Наименование;
		_Наименование = СтрЗаменить(_Наименование,"ООО","");
		_Наименование = СтрЗаменить(_Наименование,"""","");
		_Наименование = СтрЗаменить(_Наименование,"«"," ");
		_Наименование = СтрЗаменить(_Наименование,"»"," ");
		_Наименование = СтрЗаменить(_Наименование,"АНОВО","");
		_Наименование = СтрЗаменить(_Наименование,"АНО","");
		_Наименование = СтрЗаменить(_Наименование,"ЗАО","");
		_Наименование = СтрЗаменить(_Наименование,"ПАО","");
		_Наименование = СтрЗаменить(_Наименование,"АО","");		
		 _Наименование = СтрЗаменить(_Наименование,"ФГБНУ","");
		 _Наименование = СтрЗаменить(_Наименование,"ФГУП","");
		 _Наименование = СтрЗаменить(_Наименование,"УФК","");
		// _Наименование = СтрЗаменить(_Наименование,"УФК","");
		_Наименование = СтрЗаменить(_Наименование,"ГУП","");
		_Наименование = СтрЗаменить(_Наименование,"ТСЖ","");
		_Наименование = СтрЗаменить(_Наименование,"ТСН","");
		_Наименование = СтрЗаменить(_Наименование,"ТД ","");
		_Наименование = СтрЗаменить(_Наименование,"СК ","");
		_Наименование = СтрЗаменить(_Наименование,"НПО ","");
		_Наименование = СтрЗаменить(_Наименование,"  "," ");
		_Наименование = СтрЗаменить(_Наименование,"  "," ");
		Запрос.УстановитьПараметр("Наименование","%"+СокрЛП(_Наименование)+"%");
		Запрос.УстановитьПараметр("Мусор",уб_ВызовСервера.КонтрагентыГруппаМусор());
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Контрагенты.Ссылка КАК Ссылка,
		               |	Контрагенты.Наименование КАК Наименование,
		               |	Контрагенты.ИНН КАК ИНН,
		               |	Контрагенты.Комментарий КАК Комментарий
		               |ПОМЕСТИТЬ Контрагенты
		               |ИЗ
		               |	Справочник.Контрагенты КАК Контрагенты
		               |ГДЕ
		               |	(Контрагенты.Наименование ПОДОБНО &Наименование или Контрагенты.ИНН ПОДОБНО &Наименование)
		               |	И Контрагенты.ЭтоГруппа = ЛОЖЬ
		               |	И Контрагенты.ПометкаУдаления = ЛОЖЬ
		               |	И НЕ Контрагенты.Ссылка В ИЕРАРХИИ (&Мусор)
					   |	И НЕ ИНН = """"
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолис.Ссылка) КАК Полисов,
		               |	СУММА(ВЫБОР
		               |			КОГДА уб_СтраховойПолис.Агент = &Агент
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ЗастрахованоВами,
		               |	уб_СтраховойПолис.Страхователь КАК Страхователь
		               |ПОМЕСТИТЬ Статистика
		               |ИЗ
		               |	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		               |ГДЕ
		               |	уб_СтраховойПолис.ПометкаУдаления = ЛОЖЬ
		               |	И НЕ уб_СтраховойПолис.СостояниеПолиса = ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью)
		               |	И НЕ уб_СтраховойПолис.СостояниеПолиса = ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка)
		               |	И уб_СтраховойПолис.Страхователь В
		               |			(ВЫБРАТЬ
		               |				Контрагенты.Ссылка
		               |			ИЗ
		               |				Контрагенты)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	уб_СтраховойПолис.Страхователь
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Страхователь,
		               |	Контрагенты.ИНН КАК ИНН,
		               //|	ПОДСТРОКА(Контрагенты.Комментарий, 1, 10) КАК Комментарий,
		               |	ЕСТЬNULL(Статистика.Полисов, 0) КАК Полисов,
		               |	ЕСТЬNULL(Статистика.ЗастрахованоВами, 0) КАК Ваших
		               |ИЗ
		               |	Контрагенты КАК Контрагенты
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Статистика КАК Статистика
		               |		ПО Контрагенты.Ссылка = Статистика.Страхователь
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Контрагенты.Наименование,
		               |	Статистика.ЗастрахованоВами";

	Иначе
		
		Запрос.УстановитьПараметр("ФизлицаГруппаМусор",уб_ВызовСервера.ФизлицаГруппаМусор());
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФизическиеЛица.Ссылка,
		|	ФизическиеЛица.Наименование КАК Наименование,
		|	ФизическиеЛица.ДатаРождения
		|ПОМЕСТИТЬ ФизическиеЛица
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	(ФизическиеЛица.Наименование ПОДОБНО &Наименование или ФизическиеЛица.КлючПоиска = &КлючПоиска)
		|	И ФизическиеЛица.ЭтоГруппа = ЛОЖЬ
		|	И ФизическиеЛица.ПометкаУдаления = ЛОЖЬ
		|   И НЕ ФизическиеЛица.Ссылка в Иерархии(&ФизлицаГруппаМусор)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_СтраховойПолис.Ссылка) КАК Полисов,
		|	СУММА(ВЫБОР
		|			КОГДА уб_СтраховойПолис.Агент = &Агент
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ЗастрахованоВами,
		|	уб_СтраховойПолис.Страхователь
		|ПОМЕСТИТЬ Статистика
		|ИЗ
		|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		|ГДЕ
		|	уб_СтраховойПолис.ПометкаУдаления = ЛОЖЬ
		|	И НЕ уб_СтраховойПолис.СостояниеПолиса = ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированПолностью)
		|	И НЕ уб_СтраховойПолис.СостояниеПолиса = ЗНАЧЕНИЕ(Перечисление.уб_СостоянияПолиса.АннулированЗаменаБланка)
		|	И уб_СтраховойПолис.Страхователь В
		|			(ВЫБРАТЬ
		|				ФизическиеЛица.Ссылка
		|			ИЗ
		|				ФизическиеЛица)
		|
		|СГРУППИРОВАТЬ ПО
		|	уб_СтраховойПолис.Страхователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка как Страхователь,
		//|	ФизическиеЛица.Наименование КАК Наименование,
		|	ФизическиеЛица.ДатаРождения,
		|	ISNULL(Статистика.Полисов,0) Как Полисов,
		|	ISNULL(Статистика.ЗастрахованоВами,0) КАК Ваших
		|ИЗ
		|	ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОе СОЕДИНЕНИЕ Статистика КАК Статистика
		|		ПО ФизическиеЛица.Ссылка = Статистика.Страхователь
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование,
		|	ЗастрахованоВами";
	КонецЕсли;
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	Если Данные.Количество() = 0 Тогда
		Возврат "";
	Иначе	
		Возврат ПоместитьВоВременноеХранилище(Данные,Новый УникальныйИдентификатор);
	КонецЕсли;	
	
	
КонецФункции	

