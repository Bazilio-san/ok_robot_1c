&НаКлиенте
Процедура ДобавитьВЧат(Команда)
	//Если Номер = 0 Тогда
	
	Если ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ Тогда
		Записать();
	КонецЕсли;	
	НовыйКанал = "З-"+Формат(Объект.Номер,"ЧГ=");
	
	ПараметрыЧата = Новый Структура;
	ПараметрыЧата.Вставить("Период",ТекущаяДата());
	ПараметрыЧата.Вставить("ИмяКанала",НовыйКанал);
	ПараметрыЧата.Вставить("Отправитель", уб_вызовСервера.ТекущийПользователь());
	
	Если ПараметрыЧата.Отправитель = Объект.Менеджер Тогда
		Если ЗначениеЗаполнено(Объект.Оператор) Тогда
			ПараметрыЧата.Вставить("Получатель", Уб_ВызовСервера.ПользовательПоФизлицу(Объект.СтаршийОператор));	
			//Иначе
			//	ПараметрыЧата.Получатель =  Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",Менеджер);	
		КонецЕсли;
		
	Иначе
		ПараметрыЧата.Вставить("Получатель",  Уб_ВызовСервера.ПользовательПоФизлицу(Объект.Менеджер));
	КонецЕсли;
	ПараметрыЧата.Вставить("ИДСообщения",Новый УникальныйИдентификатор);
	ПараметрыЧата.Вставить("Заголовок", "Заявка "+Формат(Объект.Номер,"ЧГ=")+", страхователь: "+Объект.Страхователь);
	
	Форма = ПолучитьФорму("РегистрСведений.уб_Чат_Сообщения.Форма.ФормаЗаписиУправляемая",ПараметрыЧата,Элементы.Сообщения);
	
	Форма.ТекущийЭлемент = Форма.Элементы.Сообщение;
	
	Форма.Открыть();
	
КонецПроцедуры


