&НаКлиенте
Процедура СтраховательОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Тип("Строка") Тогда
		Если ТипЗнч(Объект.Страхователь) <> Тип("Строка") Тогда
			ВыбранноеЗначение = ""
		Иначе
			СтандартнаяОбработка = Ложь
		КонецЕсли;
	ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.ФизическиеЛица") 
		ИЛИ ВыбранноеЗначение = Тип("СправочникОбъект.ФизическиеЛица") Тогда
		СтандартнаяОбработка = Ложь;
		//уб_СС.НачалоВыбораСтрахователяФизЛица(ЭтаФорма, Элемент);
		//уб_СС.ВыборСтрахователя(Элемент, СтандартнаяОбработка, "не Контрагенты");
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",,ЭтаФорма);
	ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.Контрагенты") Тогда
		СтандартнаяОбработка = Ложь;
		//уб_СС.НачалоВыбораКонтрагента(ЭтаФорма, Элемент)
		//уб_СС.ВыборСтрахователя(Элемент, СтандартнаяОбработка, "не ФизическиеЛица");
		//ПараметрыОтбора = Новый Структура("Родитель", ПредопределенноеЗначение("Справочник.Контрагенты..Сотрудники"));
		ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора",,ЭтаФорма);
	Иначе
		Наименование = Строка(ВыбранноеЗначение);
		ВыполненПоискСтрахователя = Истина;
	КонецЕсли;
	уб_СтраховойБрокер.ВыполнитьОтложенноеДействие(ЭтаФорма, "НастройкиНаименования", 0.2);
	
КонецПроцедуры

