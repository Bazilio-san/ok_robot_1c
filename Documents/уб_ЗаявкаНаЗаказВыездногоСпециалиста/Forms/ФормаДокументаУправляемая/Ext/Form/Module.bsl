Функция ПодобратьДатуНачала(Парам)
	
	флНайденаДата = Ложь;
	
	Запрос = Новый Запрос;
	
	ВремяНачало = Парам.ВремяНачало;
	Запрос.УстановитьПараметр("Курьер",Парам.Курьер);
	Пока флНайденаДата = Ложь Цикл
		Запрос.УстановитьПараметр("Дата",ВремяНачало);
		Запрос.Текст = "ВЫБРАТЬ
		               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		               |ГДЕ
		               |	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата = &Дата
		               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер = &Курьер
		               |	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд = ЛОЖЬ";	
		Выборка = Запрос.Выполнить().Выбрать();		   
		Если Выборка.Следующий() Тогда
			ВремяНачало = ВремяНачало+600;//шаг по 10 минут
		Иначе
			флНайденаДата	= Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ВремяНачало;
