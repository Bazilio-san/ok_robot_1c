&НаКлиенте
Функция УдалитьСтрокуБСОПоДереву(тд)
	УидСтроки = тд.УидСтроки;
	Если не ПустаяСтрока(УидСтроки) Тогда
		нСтрока  = Объект.БСО.НайтиСтроки(Новый Структура("УидСтроки",УидСтроки));
	Иначе
		нСтрока  = Объект.БСО.НайтиСтроки(Новый Структура("НомерСтроки",ТД.НомерСтроки));
	КонецЕсли;
	Если нСтрока.Количество()>0 Тогда
		нСтрока = нСтрока[0]
	Иначе
		нСтрока = Неопределено;
	КонецЕсли;	
	
	Если Не нСтрока  = Неопределено Тогда
		КопияСтроки = Новый Структура;
		Для каждого Рекв из уб_ВызовСервера.РеквизитыБСОЗаявки() Цикл
			КопияСтроки.Вставить(Рекв.Имя,нСтрока[Рекв.Имя]);
		КонецЦикла;
		СтрокаКУдалению = "-"+нСтрока.ВидБСО+"/"+Уб_ВызовСервера.ТекущийПользователь()+"; ";
		Объект.БСО.Удалить(нСтрока);
		Отказ = Ложь;
		Для каждого СтрокаБСО из Объект.БСО Цикл 
			
			//Попытка
			//	ПриВыбореВидаБСО = ?(ЗначениеЗаполнено(СтрокаБСО.ВидБСО),СтрокаБСО.ВидБСО.ПриВыбореВидаБСО,"");
			//Исключение
				ПриВыбореВидаБСО = "";
			//КонецПопытки;
			
			Если Не ПустаяСтрока(ПриВыбореВидаБСО) Тогда
				
				СК            = СтрокаБСО.СК;
				ВидБСО        = СтрокаБСО.ВидБСО;
				ВладелецФормы = ЭтаФорма;
				Поставщик     = СтрокаБСО.Поставщик;
				ЭтоЮрлицо     = ТипЗнч(Объект.Страхователь)= Тип("СправочникСсылка.Контрагенты") ИЛИ Найти(Объект.Страхователь,"ООО")>0 ИЛИ Найти(Объект.Страхователь,"Общество")>0;
				Попытка
					Выполнить(ПриВыбореВидаБСО);
					Если Отказ = Истина Тогда
						Прервать;
					КонецЕсли;	
					
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
			КонецЕсли;
		КонецЦикла;	
		Если Отказ = Ложь Тогда
			КомментарийСлужебный = СтрокаКУдалению+КомментарийСлужебный+Символы.ПС;
			Модифицированность   = Истина;
			Возврат Истина;
		Иначе
			ВосстановленнаяСтрока = Объект.БСО.Добавить();
			ЗаполнитьЗначенияСвойств(ВосстановленнаяСтрока,КопияСтроки);
			Возврат Ложь;
		КонецЕсли;	
		
	КонецЕсли;	
КонецФункции	

&НаСервере
Функция ОбновитьОбъектИзСсылки()
	ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
	ЭтаФорма.ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
КонецФункции	

&НаКлиенте
Процедура БСОДеревоОбработкаВыбора(Элемент, СтруктураСтроки, СтандартнаяОбработка)
	Если СтруктураСтроки = Неопределено Тогда
		Возврат
	КонецЕсли;	
	Если СтруктураСтроки.Свойство("ЭтоЗакрытиеБезСохранения") и СтруктураСтроки.ЭтоНоваяСтрока = Истина Тогда
		//Удаляем, это заготовки строк
		СтрокиБСО = Объект.БСо.НайтиСтроки(Новый Структура("УидСтроки",СтруктураСтроки.УидСтроки));	
		Если СтрокиБСО.Количество()>0	 Тогда
			Объект.БСо.Удалить(Объект.БСо.Индекс(СтрокиБСО[0]));
		КонецЕсли;	
		
		СтрокиДерева = БсоДерево.ПолучитьЭлементы() ;
		Для каждого ТекСтрока из СтрокиДерева Цикл
			Если ТекСтрока.УидСтроки = СтруктураСтроки.УидСтроки  Тогда
				СтрокиДерева.Удалить(СтрокиДерева.Индекс(ТекСтрока));
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат
	КонецЕсли;	
	//ОбновитьОбъектИзСсылки();
	//ЭтаФорма.ОбновитьОтображениеДанных();
	Если Объект.БСо.Количество() = 0 Тогда
		СтрокаБСО = Объект.БСо.Добавить();
		СтрокаБСО.УидСтроки = СтруктураСтроки.УидСтроки;
	КонецЕсли;	
	СтрокиБСО = Объект.БСо.НайтиСтроки(Новый Структура("УидСтроки",СтруктураСтроки.УидСтроки));
	Если СтрокиБСО.Количество() = 0 Тогда
		Сообщить("Не найдена строка по УИД!!!");
	Иначе
		ЗаполнитьЗначенияСвойств(СтрокиБСО[0],СтруктураСтроки); 
		СтрокиБСО[0].ФормаОплатыСтрока = СтруктураСтроки.ФормаОплаты;
		Модифицированность = Истина;
		Объект.Техосмотр_АдресТелефон = СтруктураСтроки.Техосмотр_АдресТелефон;
		Объект.Техосмотр_ДатаВремя    = СтруктураСтроки.Техосмотр_ДатаВремя;
		Объект.Техосмотр_Наименование = СтруктураСтроки.Техосмотр_Наименование;
		ФлНайден = Ложь;
		Для каждого СтрокаДерева из БСоДерево.ПолучитьЭлементы() Цикл
			Если СтрокаДерева.УидСтроки = СтруктураСтроки.УидСтроки Тогда
				ЗаполнитьЗначенияСвойств(СтрокаДерева,СтруктураСтроки); 
				СтрокаДерева.ФормаОплатыСтрока = СтруктураСтроки.ФормаОплаты;
				ФлНайден = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		Если ФлНайден = Ложь Тогда
			СтрокаДерева = БСоДерево.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева,СтруктураСтроки); 
		КонецЕсли;	
		
		ОбновитьИтоги(ЛОЖЬ);
	КонецЕсли;	
КонецПроцедуры


