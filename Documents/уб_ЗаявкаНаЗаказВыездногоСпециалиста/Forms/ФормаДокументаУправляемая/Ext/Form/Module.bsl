&НаСервере
Функция ПосчитатьПроцент(Представление2, КакЧисло = Ложь)

	
	ВремВремия = 0;
	Для каждого СтрокаБСО из Объект.БСО Цикл
		Процент = 0;
		Представление = Строка(СтрокаБСО.ФормаОплатыСтрока);
		
		Если Представление = "СБП  (2.4%)" Тогда
			Процент = 2.4;
		ИначеЕсли Представление = "Терминал (3%)" Тогда
			Процент = 3.0;
		ИначеЕсли Представление = "На карту (0%)" Тогда
			Процент = 0.0;	
		ИначеЕсли Представление = "По ссылке в КПП (3%)" Тогда
			Процент = 3.0;	
		КонецЕсли;	
		ВремВремия = ВремВремия+Окр(СтрокаБСО.ИтогСтраховаяПремия* Процент/100,2);
	КонецЦикла;
	
	//ВремВремия = Окр(ИтогСтраховаяПремия* Процент/100,2);
	Если КакЧисло Тогда
		Возврат ВремВремия
	Иначе
		Возврат ""+Представление2+"     ("+Формат(ВремВремия,"ЧН=")+" руб.)";  
	КонецЕсли;	
КонецФункции	


&НаКлиенте
Процедура ЗаполнитьФормуОплатыИКошелек(Форма,_ЭтотОбъект) Экспорт
	
	_ЭтотОбъект.Кошелек = ПредопределенноеЗначение("Справочник.Кошельки.ПустаяСсылка");
	Если Объект.ВидОплаты = "На р\с в КПП (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Безнал");
	ИначеЕсли Объект.ВидОплаты = "Наличными (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Касса");
	ИначеЕсли Объект.ВидОплаты = "В кредит (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ВКредит");	
	ИначеЕсли Объект.ВидОплаты = "На карту (0%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");		
	ИначеЕсли Объект.ВидОплаты = "СБП  (2.4%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");			
	ИначеЕсли Объект.ВидОплаты = "По ссылке в КПП (3%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПоСсылкеБрокеру");			
	ИначеЕсли Объект.ВидОплаты = "В страховую -3%(потерянная сумма)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Поставщику");				
	ИначеЕсли Объект.ВидОплаты = "Терминал (3%)" Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Терминал");
	ИначеЕсли  Объект.ВидОплаты = "По QR коду (0%)" Тогда	
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПоQR");
	ИначеЕсли Найти(Объект.ВидОплаты,"На карту")=1	Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.НаКарту");		
		Для каждого СтрокаКарты из ПолучитьДействующиеКартыПодразделения(ПодразделениеМенеджера,Объект.Менеджер) Цикл
			Если Найти(Объект.ВидОплаты,""+СтрокаКарты.Карта)>0 Тогда
				_ЭтотОбъект.Кошелек = СтрокаКарты.Карта;
				прервать;
			КонецЕсли;		
		КонецЦикла;
	ИначеЕсли ПустаяСтрока(Объект.ВидОплаты) Тогда
		_ЭтотОбъект.ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

