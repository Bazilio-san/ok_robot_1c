&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗакрытьФорму") Тогда
		Отказ = Истина;
	КонецЕсли;	
	
	ИнициализироватьФорму();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполненПоискСтрахователя = ЛОЖЬ;
	Если ЗначениеЗаполнено(Объект.Страхователь) Тогда
		Наименование = Наименование(Объект.Страхователь);
		//НаименованиеПриИзменении(Элементы.Наименование);
		НастройкиНаименования();
	КонецЕсли;	
	
	ПриИзмененииМенеджер();
	
	СтраховательПриИзменении(Элементы.Страхователь, "При открытии");
	
	ВидОплатыПриИзменении(Неопределено);
	
	ВидимостьСтатусаЗаявки();
	
	ВидимостьКнопкиВыбораАдреса();
	
	Элементы.Дата.УстановитьГраницыВыделения(7, 8);
	
	ПроверкаСрочности();
	
	//УстановитьДоступностьПодСтатусов();
	
КонецПроцедуры



&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ОбновитьИтоги(Ложь);
	
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
	    Отказ = Истина;
	Иначе
		СинхронизироватьДатыВстречи();
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Если Объект.Дата > Дата(2017,11,1) Тогда
		Ответ = уб_СЕРВЕРные.СинхронизацияФайловЗаявки(Новый Структура("Номер,Ссылка,Страхователь,Менеджер",Объект.Номер,Объект.Ссылка,Объект.Страхователь,Объект.Менеджер));
		Если не Ответ = Истина и уб_Кэшируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ") тогда
			Сообщить(Ответ);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_ЗаявкаНаЗаказВыездногоСпециалиста",Объект.Ссылка,ЭтаФорма);
