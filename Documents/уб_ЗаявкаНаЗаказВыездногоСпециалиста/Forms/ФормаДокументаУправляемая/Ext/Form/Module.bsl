Процедура ВидимостьСтатусаЗаявки()
	
	Если Объект.Тип <> ПредопределенноеЗначение("Перечисление.уб_ТипВыезда.Административный") И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.СтатусЗаявки.Видимость		= Истина;
	Иначе
		Элементы.СтатусЗаявки.Видимость		= Истина;
	КонецЕсли;
	Элементы.СтатусЗаявки.ТолькоПросмотр = Объект.ПометкаУдаления;// или ЭтоКурьер = Истина;
	
КонецПроцедуры

//СТАТУСЫ

&НаКлиенте
Процедура СтатусЗаявкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если Не Объект.ПометкаУдаления Тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) = Ложь Тогда
			Записать();
		КонецЕсли;	
		СтрокаРеквизитов 	= уб_УСЗ.ПолучитьРеквизитыЗаявки(Объект.Ссылка);
		//список действий основывается на ссылке, а не на объекте
		Если ЭтоКурьер = Истина Тогда
			МассивРолей = Новый Массив;
			МассивРолей.Добавить("Курьер");
			//СписокДействий.Добавить("УстановитьСтатус_БСОНаРукахУКурьера", "Заявка у курьера");
		Иначе	
			МассивРолей			= уб_УСЗ.ПолучитьРольПользователяДляЗаявок(, Истина);
		КонецЕсли;	
		
		//ПолныйСписокДействий 		= уб_УСЗ.ВернутьСписокДействийДляСтатуса(СтатусЗаявки, СтрокаРеквизитов,, МассивРолей);
		ПолныйСписокДействий = Новый СписокЗначений;
		МассивСтруктур = уб_УСЗ.ВернутьСписокДействийДляСтатуса(СтатусЗаявки,СтрокаРеквизитов, ,МассивРолей,,Истина);
		Для каждого Элемент из МассивСтруктур Цикл
			ПолныйСписокДействий.Добавить(Элемент.Значение,Элемент.Представление,,Элемент.Картинка);
		КонецЦикла;
		
		//Роль				= уб_УСЗ.ПолучитьРольПользователяДляЗаявок();
		
		СписокВыбора = Элементы.СтатусЗаявки.СписокВыбора;
		СписокДействий	= Новый СписокЗначений;
		Для Каждого ЭлементСпискаДействий Из ПолныйСписокДействий Цикл
			Для каждого Роль из МассивРолей Цикл
				Если уб_УСЗ.ДействиеДоступноДляРоли(ЭлементСпискаДействий.Значение, Роль) и СписокДействий.НайтиПоЗначению(ЭлементСпискаДействий.Значение)=Неопределено Тогда
					СтрокаСЗ = СписокДействий.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаСЗ, ЭлементСпискаДействий);
					////Дублируем
					//СтрокаСЗ = СписокВыбора.Добавить();
					//ЗаполнитьЗначенияСвойств(СтрокаСЗ, ЭлементСпискаДействий);
					
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если СписокДействий.Количество()>0 Тогда
			ОписаниеОповещения = Новый ОписаниеОПовещения("ПриВыбореСтатуса",ЭтаФорма,Новый Структура());
			ЭтаФорма.ПоказатьВыборИзСписка(ОписаниеОповещения,СписокДействий,Элементы.СтатусЗаявки);
			
		КонецЕсли;	
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореСтатуса(ВыбранноеЗначение,ДопПараметр)  Экспорт
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		СтандартнаяОбработка2 = Ложь;
		СтатусОбработкаВыбора(Элементы.СтатусЗаявки, ВыбранноеЗначение, СтандартнаяОбработка2);
	КонецЕсли;	
КонецПроцедуры

