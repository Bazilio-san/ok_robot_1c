&НаКлиенте
Процедура БСОДеревоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НЕ (ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ И НЕ Записать()) Тогда
		Отказ = Истина;
		Строка = Объект.БСО.Добавить();
		Строка.УидСтроки = Новый УникальныйИдентификатор();
		Если Копирование = Истина Тогда
			
			//Выборочно копируются данные
			ТекущиеДанные = Элемент.ТекущиеДанные;
			Родитель = ТекущиеДанные.ПолучитьРодителя();
			Если ЗначениеЗаполнено(Родитель) Тогда
				//Это подчиненный копирование недопустимо
				  Возврат;
			КонецЕсли;	
			Строка.ВидБСО = ТекущиеДанные.ВидБСО;
			Строка.СК     = ТекущиеДанные.СК;
			//АУДИТ+
