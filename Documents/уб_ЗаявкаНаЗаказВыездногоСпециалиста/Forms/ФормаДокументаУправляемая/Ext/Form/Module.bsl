Функция ПроверкаСрочности(ПересчитатьВознаграждение = Ложь)
	
	ПараметрыСотрудника = ПолучитьИзВременногоХранилища(АдресПараметровВызова);
	
	Если //НЕ ПараметрыСотрудника.ПодразделениеСотрудника = ПараметрыСеанса.уб_Константы.уб_ПодразделениеАгентскойСети или 
		Не ПараметрыСотрудника.НеПроверятьСрочность = Истина
		Тогда
		ЕстьИзменения = Ложь;
		текДата = ТекущаяДата();
		Если Объект.Дата>Дата(2016,7,7) Тогда
			//Если Дата<КонецДня(ДатаСоздания) 
			СнятьСрочность = Ложь;
			Если ПараметрыСотрудника.НеОплачиваютВыезд = Истина Тогда
				Если Объект.Срочная = Истина Тогда
					ПоказатьПредупреждение(,"Подразделение не оплачивает выезд",3);
					Срочная = Ложь;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Объект.Куратор) Тогда
				Если Срочная = Истина Тогда
					ПоказатьПредупреждение(,"Куратор "+Объект.Куратор,3);
					Объект.Срочная = Ложь;
					ЕстьИзменения = Истина 
				КонецЕсли;
			ИначеЕсли текДата>Дата(2018,6,25) Тогда
				Если 
					БудетСрочная()
					//УтвержденоДата<>Дата(1,1,1) 
					//И (Дата<КонецДня(УтвержденоДата) 
					//ИЛИ ( УтвержденоДата>(НачалоДня(УтвержденоДата)+16*3600+45*60)
					//И Дата <(КонецДня(УтвержденоДата)+16*3600+45*60+1)	
					//)
					//)  
					Тогда 	
					Если Объект.Срочная = Истина //или Срочность = Истина  
						Тогда
						ЕстьИзменения = Истина;
					Иначе
						Объект.Срочная = Истина;
						
						Если Объект.УтвержденоДата>(НачалоДня(Объект.УтвержденоДата)+16*3600+45*60) И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+16*3600+45*60+1) Тогда
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+17*3600+1,"ДФ='HH:mm dd MMMM'"));
						Иначе
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+9*3600+1,"ДФ='HH:mm dd MMMM'"));
						КонецЕсли;
						
						ЕстьИзменения = Истина;
						//
					КонецЕсли;
				Иначе
					СнятьСрочность = Истина;	
				КонецЕсли;	
				
			ИначеЕсли текДата>Дата(2017,4,20) Тогда
				Если 
					Объект.УтвержденоДата<>Дата(1,1,1) 
					И (Объект.Дата<КонецДня(Объект.УтвержденоДата) 
					ИЛИ ( Час(Объект.УтвержденоДата)>=17
					И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+17*3600+1)
					)
					)  
					Тогда 	
					Если Объект.Срочная = Истина Тогда
					Иначе
						Объект.Срочная = Истина;
						
						Если Час(Объект.УтвержденоДата)>=17 И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+17*3600+1) Тогда
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+17*3600+1,"ДФ='HH:mm dd MMMM'"));
						Иначе
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+9*3600+1,"ДФ='HH:mm dd MMMM'"));
						КонецЕсли;
						
						ЕстьИзменения = Истина;
					КонецЕсли;
				Иначе
					СнятьСрочность = Истина;
				КонецЕсли;
				
			ИначеЕсли текДата>Дата(2016,12,11) Тогда
				Если
					Объект.УтвержденоДата<>Дата(1,1,1) 
					И (Объект.Дата<КонецДня(Объект.УтвержденоДата) 
					ИЛИ ( Час(Объект.УтвержденоДата)>=16 
					И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+16*3600+1)
					)
					)  
					Тогда 	
					Если Объект.Срочная = Истина Тогда
					Иначе
						Объект.Срочная = Истина;
						//Предупреждение("Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(ДатаСоздания)+9*3600+1,"ДФ='HH:mm dd MMMM'"));	
						Если Час(Объект.УтвержденоДата)>=16 И Объект.Дата <(КонецДня(Объект.УтвержденоДата)+16*3600+1) Тогда
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+16*3600+1,"ДФ='HH:mm dd MMMM'"));
						Иначе
							ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+9*3600+1,"ДФ='HH:mm dd MMMM'"));
						КонецЕсли;
						
						ЕстьИзменения = Истина;
					КонецЕсли;
				Иначе
					СнятьСрочность = Истина;	
				КонецЕсли;
			ИначеЕсли текДата<Дата(2016,12,11) Тогда
				Если Объект.УтвержденоДата<>Дата(1,1,1)и Объект.Дата<КонецДня(Объект.УтвержденоДата) Тогда 
					//И НЕ НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная 
					Если Срочная = Истина Тогда
					Иначе
						Срочная = Истина;
						//Предупреждение("Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(ДатаСоздания)+9*3600+1,"ДФ='HH:mm dd MMMM'"));	
						ПоказатьПредупреждение(,"Автоматически установлена срочная заявка. Либо выезд с "+Формат(КонецДня(Объект.УтвержденоДата)+9*3600+1,"ДФ='HH:mm dd MMMM'"));	
						ЕстьИзменения = Истина;
					КонецЕсли;
				Иначе
					СнятьСрочность = Истина;	
				КонецЕсли;
				//Убрано 2016-08-15
				//ИначеЕсли (ДатаСоздания> НачалоДня(ТекущаяДата())+17*3600) и Дата <=КонецДня(ДатаСоздания)+24*3600 Тогда
				//	Если Срочная = Истина Тогда
				//	Иначе
				//		Предупреждение("Заявка подана после 17:00. Установлена срочная, либо выезд с "+Формат(КонецДня(ДатаСоздания)+33*3600+1,"ДФ='HH:mm dd MMMM'"));	
				//		Срочная = Истина;
				//		ЕстьИзменения = Истина;
				//	КонецЕсли;	
			Иначе
				СнятьСрочность = Истина;
			КонецЕсли;
			
			Если СнятьСрочность = Истина и Объект.Срочная = Истина Тогда
				Объект.Срочная = Ложь;
				ПоказатьПредупреждение(,"Снята срочность"+?(Объект.Утверждено,"",". При утверждении будет проверена срочность. Возможно изменение стоимости выезда."));	
				ЕстьИзменения = Истина;
				Объект.ВознаграждениеОтКлиента  = 0;
				Объект.ОплатитьВКассуЗаВыездКурьера = 0;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		//ПоказатьПредупреждение(,"В подразделение не проверяется срочность",3);
	КонецЕсли;
	Если ПересчитатьВознаграждение = Истина ИЛИ ЕстьИзменения = Истина Тогда
		Если Объект.Срочная и ЕстьИзменения = Истина Тогда
			Объект.ВознаграждениеОтКлиента = Объект.ОплатитьВКассуЗаВыездКурьера;
		КонецЕсли;	
		ПриИзмененииСвязанномСВознаграждением(Неопределено);
	КонецЕсли;
КонецФункции

