&НаКлиенте
Процедура ПроставитьОператораЗавершение(Ответ,ДопПараметры) Экспорт
	Если Ответ= КодВозвратаДиалога.Да Тогда
		Для каждого Строка из ДопПараметры.Строки Цикл
			Строка.Оператор = Объект.СтаршийОператор;
			Для каждого СтрокаД из БСОДерево.ПолучитьЭлементы() цикл
				Если Строка.УидСтроки = СтрокаД.УидСтроки Тогда
					СтрокаД.Оператор = Объект.СтаршийОператор;
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	


&НаКлиенте
Процедура КурьерПриИзменении(Элемент)
	Если ЭтоМенеджер() = Истина Тогда
		тДата = ТекущаяДата();
		нДня = НачалоДня(тДата);
		
		Если ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ И нДня = НачалоДня(Объект.ВремяНачало) Тогда
			Объект.ВремяНачало = нДня+Цел((тДата-нДня)/600)*600+900;	
			Объект.ВремяНачало = ПодобратьДатуНачала(Новый Структура("ВремяНачало,Курьер",Объект.ВремяНачало,Объект.Курьер));
			Объект.ВремяОкончания 	= Объект.ВремяНачало + 30 * 60;
		КонецЕсли;
		
	КонецЕсли;
	
	ПриИзмененииСвязанномСВознаграждением(Элемент);
	
	ПараметрыСВС = уб_РасчетыСМенеджерами.ПараметрыСВС(Объект.Курьер,КонецДня(Объект.Дата));
	
	уб_Клиент._УстановитьЗначение(Объект,"СВС",ПараметрыСВС.СВС);

КонецПроцедуры

&НаКлиенте
Процедура ВремяНачалоПриИзменении(Элемент)
	Если Объект.ВремяНачало >= Объект.ВремяОкончания Тогда
		ПоказатьОповещениеПользователя("Время начала встречи д.б. меньше времени окончания встречи!");
		Объект.ВремяНачало = Макс(Объект.ВремяОкончания - 3600, НачалоДня(Объект.Дата));
	КонецЕсли;
	СинхронизироватьДатыВстречи(2);

КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияПриИзменении(Элемент)
	Если Объект.ВремяНачало >= Объект.ВремяОкончания Тогда
		ПоказатьОповещениеПользователя("Время окончания встречи д.б. больше времени начала встречи!");
		Объект.ВремяОкончания = Мин(Объект.ВремяНачало + 3600, НачалоДня(Объект.Дата) + 86400 - 60); //начало следующего дня минус минута
	КонецЕсли;
	СинхронизироватьДатыВстречи(2);

КонецПроцедуры




