Функция ПолучитьТелефонКонтактногоЛица(СК, КонтактноеЛицо)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.ОсновноеКонтактноеЛицо
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",СК);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КонтактноеЛицо = Выборка.ОсновноеКонтактноеЛицо;
	Иначе	
		КонтактноеЛицо = ПредопределенноеЗначение("Справочник.КонтактныеЛица.ПустаяСсылка");
	КонецЕсли;	
	
	
	Результат = "";
	Если ТипЗнч(КонтактноеЛицо) = Тип("СправочникСсылка.КонтактныеЛица") И Не КонтактноеЛицо.Пустая() Тогда
		Телефон = уб_temp.ДайКонтактнуюИнформациюФизлица(КонтактноеЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаРабочий);
		Если ПустаяСтрока(Телефон) Тогда
			Телефон = уб_temp.ДайКонтактнуюИнформациюФизлица(КонтактноеЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаМобильный)
		КонецЕсли;
		Если Не ПустаяСтрока(Телефон) Тогда
			Результат = "Тел. " + Телефон
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат
	
КонецФункции // ПолучитьТелефонКонтактногоЛица()


