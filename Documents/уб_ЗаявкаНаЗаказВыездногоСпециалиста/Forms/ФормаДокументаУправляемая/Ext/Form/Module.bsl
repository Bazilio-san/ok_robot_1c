Функция ПолучитьСрокОформления(Парам) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(уб_ЗаявкаНаЗаказВыездногоСпециалиста.СрокОформления) КАК СрокОформления
	|ИЗ
	|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	|ГДЕ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.СтаршийОператор = &СтаршийОператор
	|	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Утверждено = ИСТИНА
	|	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("СтаршийОператор",Парам.Оператор);
	Запрос.УстановитьПараметр("Ссылка",Парам.Ссылка);
	
	МинутНаОформление = 45;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.СрокОформления = Дата(1,1,1) или Выборка.СрокОформления = NULL или Выборка.СрокОформления<ТекущаяДата() Тогда
			Возврат ТекущаяДата()+МинутНаОформление*60;
		Иначе	
			
			Возврат Выборка.СрокОформления+МинутНаОформление*60;
		КонецЕсли;	
	Иначе
		Возврат ТекущаяДата()+МинутНаОформление*60;
	КонецЕсли; 
КонецФункции	

