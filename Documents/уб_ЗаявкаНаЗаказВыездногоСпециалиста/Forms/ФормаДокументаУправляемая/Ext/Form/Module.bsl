&НаКлиенте
Процедура КонтактыОчистка(Элемент, СтандартнаяОбработка)
	МассивПодстрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Объект.Контакты, ";");
	МассивПодстрокКоличество = МассивПодстрок.Количество();
	Если МассивПодстрокКоличество > 1 Тогда
		СЗ = Новый СписокЗначений;
		СЗ.ЗагрузитьЗначения(МассивПодстрок);
		ОчиститьВсе = СЗ.Добавить("ОчиститьВсе", "Очистить все");
		СЗ.Сдвинуть(ОчиститьВсе, - МассивПодстрокКоличество);
		СЗ.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПриОчисткеКонтактаЗавершение",ЭтаФорма,Новый Структура("СЗ",СЗ)),"Укажите номер телефона для удаления");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОчисткеКонтактаЗавершение(СтрокаСЗ,ДопПараметры) Экспорт
	
	Если СтрокаСЗ = Неопределено Тогда
		
	Иначе
		СЗ = ДопПараметры.СЗ;
		СЗКоличество 	= СЗ.Количество();
		ИндексСтрокиСЗ 	= СЗ.Индекс(СтрокаСЗ);
		ВыбранноеЗначение = СтрокаСЗ.Значение;
		Если ВыбранноеЗначение = "ОчиститьВсе" Тогда
			Объект.Контакты = "";
			Модифицированность = Истина;
		Иначе
			СтандартнаяОбработка = Ложь;
			Инд = Найти(Объект.Контакты, ВыбранноеЗначение);
			ДлинаСтроки = СтрДлина(ВыбранноеЗначение);
			Если Инд <> 0 Тогда
				Если ИндексСтрокиСЗ > 1 Тогда
					Инд = Инд - 1;
					//ДлинаСтроки = ДлинаСтроки + 1;
				КонецЕсли;
				ДлинаСтроки = ДлинаСтроки + 1;
				До 			= Лев(Объект.Контакты, Инд - 1);
				После   	= Сред(Объект.Контакты, Инд + ДлинаСтроки);
				Объект.Контакты    = До + После;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

