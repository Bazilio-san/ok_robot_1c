	Если Не ТекущиеДанные =  Неопределено Тогда
		//уб_Клиент.ПриНажатииФлажкаРазмещения(Элементы.мСписокФайлов, Колонка.Имя, ДокументСсылка,Новый Структура("УидСтроки",УидСтроки));
		ТекущаяСтрока = СтруктураФайла();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока,ТекущиеДанные);
		//Дополнительные данные для переименования
		ТекущаяСтрока.Вставить("Страхователь",ДокументСтрахователь);
		ТекущаяСтрока.Вставить("ДокументСсылка",ДокументСсылка);
		ТекущаяСтрока.Вставить("Номер",ДокументНомер);
		
		Если Уб_ВызовСервера.ИзменениеВидаДокумента (ТекущаяСтрока) Тогда
			ОбновитьФайлы();
		КонецЕсли;	
	КонецЕсли;
