&НаКлиенте
Процедура СтраховаяПремияПриИзменении(Элемент)
	Если СтраховаяПремия > ЛимитОтветственности Тогда
		СтраховаяПремия = ЛимитОтветственности;
		ПоказатьПредупреждение(,"Премия не может быть больше страховой суммы!");
	КонецЕсли;
	
	Если МинимальнаяСумма > СтраховаяПремия Тогда
		СтраховаяПремия = МинимальнаяСумма;
		ПоказатьПредупреждение(,"Премия не может быть меньше "+МинимальнаяСумма);
	КонецЕсли;
	
	РассрочкаПлатежаПриИзменении(Элемент);
	
	//Если СтраховаяПремия>0 Тогда
	//	КВБрокераПлан = Окр((СтраховаяПремия-МинимальнаяСумма)*100/СтраховаяПремия,4);
	//КонецЕсли;
	НастройкиПолей();

КонецПроцедуры


&НаКлиенте
Процедура РассрочкаПлатежаПриИзменении(Элемент)
	Если РассрочкаПлатежа = 0 Тогда
		РассрочкаПлатежа = 1;
	КонецЕсли;	
	//Элементы.РассрочкаПлатежа.ТриСостояния = Ложь;
	ПолучитьИндексПродуктаИОбновитьНадписьОшибкиВидаБСО();
	Если РассрочкаПлатежа = 1 Тогда
		уб_Клиент._УстановитьЗначение(ЭтаФорма,"СуммаВзноса", СтраховаяПремия);
	КонецЕсли;	
	НастройкиПолей();
	
	Если Не тРасрочки.Количество() = РассрочкаПлатежа 
		ИЛИ Элемент = Элементы.СтраховаяПремия Тогда
		_СуммаВзноса = Окр(СтраховаяПремия/РассрочкаПлатежа,2);
		уб_Клиент._УстановитьЗначение(ЭтаФорма,"СуммаВзноса", _СуммаВзноса);
		Взнос1Сумма = _СуммаВзноса;
		Взнос2Сумма = 0;
		Взнос3Сумма = 0;
		Взнос4Сумма = 0;
		Если РассрочкаПлатежа = 2 Тогда
			Взнос2Сумма = СтраховаяПремия-_СуммаВзноса;
		ИначеЕсли РассрочкаПлатежа>2 Тогда
			Взнос2Сумма = _СуммаВзноса;
		КонецЕсли;	
		Если РассрочкаПлатежа = 3 Тогда
			Взнос3Сумма = СтраховаяПремия-_СуммаВзноса*2;
		ИначеЕсли РассрочкаПлатежа>3 Тогда
			Взнос3Сумма = _СуммаВзноса;
		КонецЕсли;	
		Если РассрочкаПлатежа = 4 Тогда
			Взнос4Сумма = СтраховаяПремия-_СуммаВзноса*3;
			//Иначе
			//	Взнос4Сумма = 0;
		КонецЕсли;	
		Если ДатаОформления = Дата(1,1,1) Тогда
			ДатаОформления = ТекущаяДата();
		КонецЕсли;	  
		Взнос2Дата = Дата(1,1,1);
		Взнос3Дата = Дата(1,1,1);
		Взнос4Дата = Дата(1,1,1);
		Для Счетчик = 2 по РассрочкаПлатежа Цикл
			ЭтаФорма["Взнос"+Счетчик+"Дата"] = ДобавитьМесяц(ДатаОформления,РассрочкаПлатежа-1);
		КонецЦикла;	
		
	КонецЕсли;
	
	ТаблицаРасрочки();

КонецПроцедуры

&НаКлиенте
Процедура фФраншизаПриИзменении(Элемент)
	Элементы.Франшиза.Видимость = фФраншиза;
КонецПроцедуры


&НаКлиенте
Процедура СуммаВзносаПриИзменении(Элемент)
	Если СуммаВзноса > СтраховаяПремия Тогда
		СуммаВзноса = СтраховаяПремия;
		ПоказатьПредупреждение(,"Сумма взноса не может быть больше страховой премии!");
	ИначеЕсли СуммаВзноса < СтраховаяПремия Тогда
		РассрочкаПлатежа = 2
	Иначе
		РассрочкаПлатежа = 1
	КонецЕсли;
	НастройкиПолей(Истина);
	уб_Клиент.ОбновитьВидыОплаты(Элементы.ВидОплаты,СуммаВзноса,ПодразделениеМенеджера,ДокументМенеджер);
КонецПроцедуры

