&НаКлиенте
Процедура мСписокФайловРазмещенПриИзменении(Элемент)
	ТекущиеДанные = Элементы.мСписокФайлов.ТекущиеДанные;
	Если Не ТекущиеДанные =  Неопределено Тогда
		//уб_Клиент.ПриНажатииФлажкаРазмещения(Элементы.мСписокФайлов, Колонка.Имя, ДокументСсылка,Новый Структура("УидСтроки",УидСтроки));
		ТекущаяСтрока = СтруктураФайла();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока,ТекущиеДанные);
		Если уб_вызовСервера.ИзменениеРазмещенияФайла(ТекущаяСтрока,"Размещен",ДокументСсылка,Новый Структура("УидСтроки",УидСтроки)) = Истина Тогда		
			ОбновитьФайлы();
		КонецЕсли;	
		Если ТекущаяСтрока.Свойство("НеобходимоВыбратьКошелек") и ТекущаяСтрока.НеобходимоВыбратьКошелек = Истина Тогда
			//Код вида документа 74
			НеобходимоВыбратьКошелек = Истина;
		КонецЕсли;
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;	
КонецПроцедуры

