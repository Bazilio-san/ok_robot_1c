&НаСервере
Процедура ТаблицаРасрочки()
	
	Пока тРасрочки.Количество() < РассрочкаПлатежа Цикл
		тРасрочки.Добавить();
	КонецЦикла;	
	
	Пока тРасрочки.Количество() > РассрочкаПлатежа Цикл
		тРасрочки.Удалить(тРасрочки.Количество()-1);
	КонецЦикла;
	
	Если РассрочкаПлатежа >=1 Тогда
		тРасрочки[0].Дата = ДатаОформления;
		тРасрочки[0].Сумма = Взнос1Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=2 Тогда
		тРасрочки[1].Дата = Взнос2Дата;
		тРасрочки[1].Сумма = Взнос2Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=3 Тогда
		тРасрочки[2].Дата = Взнос3Дата;
		тРасрочки[2].Сумма = Взнос3Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=4 Тогда
		тРасрочки[3].Дата = Взнос4Дата;
		тРасрочки[3].Сумма = Взнос4Сумма;
	КонецЕсли;	
КонецПроцедуры	


Процедура ОбновитьОтображениеФайлов()
	КартинкаЗеленая = БиблиотекаКартинок.уз_Активирован;
	КартинкаКрасная = БиблиотекаКартинок.уз_НеАктивирован;
	// сразу подговим ТЗ как оно будет потом
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Имя", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(200)));
	ТЗ.Колонки.Добавить("Вид",			Новый ОписаниеТипов("СправочникСсылка.уб_ВидыДокументовКПолисам"));
	ТЗ.Колонки.Добавить("Расширение",   Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	ТЗ.Колонки.Добавить("Картинка",		Новый ОписаниеТипов("Картинка"));
	//признак хранение файлов в регистре
	мХранФайловРег = ЛОЖЬ;
	//
	Если Не ПустаяСтрока(Расчетчик) Тогда
		СтрокаТЗ = ТЗ.Добавить();
		СтрокаТЗ.Имя = Расчетчик;
		СтрокаТЗ.Вид = Справочники.уб_ВидыДокументовКПолисам.РасчетныйЛист;
		мХранФайловРег = ТипЗнч(Расчетчик) = Тип("Строка") ИЛИ мХранФайловРег;
	КонецЕсли;
	Если Не ПустаяСтрока(ДопСоглашение) Тогда
		СтрокаТЗ = ТЗ.Добавить();
		СтрокаТЗ.Имя = ДопСоглашение;
		СтрокаТЗ.Вид = Справочники.уб_ВидыДокументовКПолисам.ДопСоглашение;
		мХранФайловРег = ТипЗнч(Расчетчик) = Тип("Строка") ИЛИ мХранФайловРег;
	КонецЕсли;
	Если Не ПустаяСтрока(ДругиеДокументы) Тогда
		СтрокаТЗ = ТЗ.Добавить();
		СтрокаТЗ.Имя = ДругиеДокументы;
		СтрокаТЗ.Вид = Справочники.уб_ВидыДокументовКПолисам.Прочее;
		мХранФайловРег = ТипЗнч(Расчетчик) = Тип("Строка") ИЛИ мХранФайловРег;
	КонецЕсли;
	Если ТЗ.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Источник.Имя КАК Имя,
		|	Источник.Вид КАК Вид
		|ПОМЕСТИТЬ ВТ_Источник
		|ИЗ
		|	&Источник КАК Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Ф.УИД КАК УИД,
		|	Ф.ФайлИмя КАК ФайлИмя,
		|	Ф.ФайлРасширение КАК ФайлРасширение
		|ИЗ
		|	ВТ_Источник КАК ВТ_Источник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уб_ФайлыКПолисам КАК Ф
		|		ПО ВТ_Источник.Имя = Ф.УИД");
		Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА 
			И НЕ мХранФайловРег тогда
			Запрос.Текст = "ВЫБРАТЬ
			|	Источник.Имя КАК Имя,
			|	Источник.Вид КАК Вид
			|ПОМЕСТИТЬ ВТ_Источник
			|ИЗ
			|	&Источник КАК Источник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	уб_ФайлыКПолисам.Ссылка КАК УИД,
			|	уб_ФайлыКПолисам.ФайлИмя КАК ФайлИмя,
			|	уб_ФайлыКПолисам.ФайлРасширение КАК ФайлРасширение
			|ИЗ
			|	ВТ_Источник КАК ВТ_Источник
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
			|		ПО ВТ_Источник.Имя = уб_ФайлыКПолисам.Ссылка";	
		КонецЕсли;
		Запрос.УстановитьПараметр("Источник", ТЗ);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрокаТЗ = ТЗ.Найти(Выборка.УИД, "Имя");
				СтрокаТЗ.Имя 		= Выборка.ФайлИмя;
				СтрокаТЗ.Расширение = Выборка.ФайлРасширение;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	СоответствиеКартинок = Новый Соответствие;
	СоответствиеКартинок.Вставить("xls", 	БиблиотекаКартинок.ПиктограммаФайла_Excel);
	СоответствиеКартинок.Вставить("xlsx", 	БиблиотекаКартинок.ПиктограммаФайла_Excel);
	СоответствиеКартинок.Вставить("xlsm", 	БиблиотекаКартинок.ПиктограммаФайла_Excel);
	СоответствиеКартинок.Вставить("pdf", 	БиблиотекаКартинок.уб_ПиктограммаФайла_PDF);
	СоответствиеКартинок.Вставить("doc", 	БиблиотекаКартинок.ПиктограммаФайла_Word);
	СоответствиеКартинок.Вставить("docx", 	БиблиотекаКартинок.ПиктограммаФайла_Word);
	// расчетчик
	СтрокаТЗ = ТЗ.Найти(Справочники.уб_ВидыДокументовКПолисам.РасчетныйЛист, "Вид");
	Структура = Новый Структура;
	Структура.Вставить("Картинка");
	Структура.Вставить("Значение");
	Если СтрокаТЗ = Неопределено Тогда
		ВидимостьКнопкиСохранения = Ложь;
		Структура.Картинка = КартинкаКрасная;
		Структура.Значение = "";
	Иначе
		ВидимостьКнопкиСохранения = Истина;
		Если ПустаяСтрока(СтрокаТЗ.Расширение) Тогда
			СтрокаТЗ.Расширение = уб_СЛ.ОпределитьРасширениеФайла(СтрокаТЗ.Имя, Ложь);
		КонецЕсли;
		СтрокаТЗ.Картинка = СоответствиеКартинок.Получить(СтрокаТЗ.Расширение);
		Если Не ЗначениеЗаполнено(СтрокаТЗ.Картинка) Тогда
			СтрокаТЗ.Картинка = КартинкаЗеленая;
		КонецЕсли;
		Структура.Картинка = СтрокаТЗ.Картинка;
		Структура.Значение = СтрокаТЗ.Расширение;
	КонецЕсли;
	//ЗаполнитьЗначенияСвойств(Элементы.СостояниеРасчетчик, Структура);
	//Элементы.СохранитьРасчетчик.Видимость = ВидимостьКнопкиСохранения;
	// доп соглашение
	СтрокаТЗ = ТЗ.Найти(Справочники.уб_ВидыДокументовКПолисам.ДопСоглашение, "Вид");
	Структура = Новый Структура;
	Структура.Вставить("Картинка");
	Структура.Вставить("Значение");
	Если СтрокаТЗ = Неопределено Тогда
		ВидимостьКнопкиСохранения = Ложь;
		Структура.Картинка = КартинкаКрасная;
		Структура.Значение = "";
	Иначе
		ВидимостьКнопкиСохранения = Истина;
		Если ПустаяСтрока(СтрокаТЗ.Расширение) Тогда
			СтрокаТЗ.Расширение = уб_СЛ.ОпределитьРасширениеФайла(СтрокаТЗ.Имя, Ложь);
		КонецЕсли;
		СтрокаТЗ.Картинка = СоответствиеКартинок.Получить(СтрокаТЗ.Расширение);
		Если Не ЗначениеЗаполнено(СтрокаТЗ.Картинка) Тогда
			СтрокаТЗ.Картинка = КартинкаЗеленая;
		КонецЕсли;
		Структура.Картинка = СтрокаТЗ.Картинка;
