&НаКлиенте
Процедура ПринятыДеньгиПриИзменении(Элемент)
	
	Если НЕ Элемент = Неопределено Тогда
		ЕстьМарка =  уб_ВызовСервера.ТребуетсяЗаполнениеМаркиМодели(ВидБСО,ДокументДата);
		Если ЗначениеЗаполнено(ДатаНачала) = ЛОЖЬ или ЗначениеЗаполнено(ДатаОкончания) = ЛОЖЬ Тогда
			ПоказатьПредупреждение(,"Даты полиса!");
			ЭтаФорма.ТекущийЭлемент = Элементы.ДатаНачала;
			ПринятыДеньгиАвтор = Ложь;	
		ИначеЕсли ПустаяСтрока(НомерБСО) Тогда
			ПоказатьПредупреждение(,"Номер БСО!");
			ЭтаФорма.ТекущийЭлемент = Элементы.НомерБСО;
			ПринятыДеньгиАвтор = Ложь;	
		ИначеЕсли ЕстьМарка = Истина и ПустаяСтрока(vin) Тогда
			ПоказатьПредупреждение(,"vin!");
			ЭтаФорма.ТекущийЭлемент = Элементы.Vin;
			ПринятыДеньгиАвтор = Ложь;		
		ИначеЕсли ЕстьМарка = Истина и ЗначениеЗаполнено(ОбъектСтрахования) = ЛОЖЬ Тогда
			ПоказатьПредупреждение(,"Объект не найден!");
			ЭтаФорма.ТекущийЭлемент = Элементы.ОткрытьОбъектСтрахования;
			ПринятыДеньгиАвтор = Ложь;		
		Иначе
			Проверено = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
