&НаКлиенте
Процедура ВидОплатыПриИзменении(Элемент)
	Если ВидОплаты ="В страховую -3%(потерянная сумма)" и Элемент<>Неопределено Тогда
		Предупреждение("Вычет 3% из-за налога НДС для юр лиц. Поменяй способ оплаты!");
	КонецЕсли;	
	уб_Клиент.ЗаполнитьФормуОплатыИКошелек(ВидОплаты,ЭтаФорма,ПодразделениеМенеджера,ДокументМенеджер);
	НастройкиПолей();
КонецПроцедуры

&НаСервере
Процедура ПодобратьВидОплаты(Форма,_ЭтотОбъект) Экспорт
	Если ВидОплаты = "" И ЗначениеЗаполнено(_ЭтотОбъект.ФормаОплаты) Тогда
		
		Если _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Безнал Тогда
			ВидОплаты = "На р\с в КПП (0%)";
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Касса Тогда
			ВидОплаты = "Наличными (0%)";
			//ИначеЕсли ФормаОплаты = Перечисления.уб_ФормыОплаты.ВКредит Тогда
			//	ВидОплаты = "В кредит (0%)";	
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.НаКарту Тогда
			Если ЗначениеЗаполнено(_ЭтотОбъект.Кошелек) Тогда
				ВидОплаты = "На карту "+ СокрЛП(_ЭтотОбъект.Кошелек) +"(0%)";		
			Иначе	
				ВидОплаты = "На карту (0%)";		
			КонецЕсли;	
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПоСсылкеБрокеру Тогда
			ВидОплаты = "По ссылке в КПП (3%)";			
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Поставщику Тогда
			ВидОплаты = "В страховую -3%(потерянная сумма)";				
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.Терминал Тогда
			ВидОплаты = "Терминал (3%)";	
		ИначеЕсли _ЭтотОбъект.ФормаОплаты = Перечисления.уб_ФормыОплаты.ПоQR Тогда
			ВидОплаты = "По QR коду (0%)";		
		КонецЕсли;
		
	КонецЕсли;	
КонецПроцедуры





&НаСервереБезКонтекста
Функция АдресКартинки(ПолноеИмя, ПустотуЕслиНЕТ = Ложь,ПростоФайл = ЛОЖЬ)
	Если ПростоФайл = Истина Тогда
		Картинка = Новый ДвоичныеДанные(ПолноеИмя);
	Иначе	
		тзКартинок = уб_СЛ.СконвертироватьОдинФайл(ПолноеИмя);
		Если тзКартинок.Количество()>0 Тогда
			Картинка = тзКартинок[0].Картинка.ПолучитьДвоичныеДанные(ЛОЖЬ);
			
		Иначе
			Если ПустотуЕслиНЕТ = Истина Тогда
				Возврат "";
			Иначе	
				Картинка= Новый Картинка;
				//Картинка = Картинка.ПолучитьДвоичныеДанные(Истина);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Картинка,Новый УникальныйИдентификатор);
КонецФункции


&НаСервере
Процедура ПроверитьВыполнениеУсловийСвязанныхБСО()
	
	ЕстьСкидка 	= ПредоставленнаяСкидка > 0;
	Личная		= ДокументСсылка.НомерЗаявки = Перечисления.уб_ВидыЗаявок.Личная;
	ПривязанныеКСтроке = ДокументСсылка.БСО.Выгрузить(Новый Структура("УидРодителя",УидСтроки));
	Для Каждого СтрокаТЗ Из СвязанныеБСО Цикл
		Если Найти(СтрокаТЗ.БСО,"Договор")>0 или Найти(СтрокаТЗ.БСО,"Скидка") Тогда
			//ПоказатьОповещениеПользователя("Пропущен бланк "+СтрокаТЗ.БСО);
			Продолжить;
		КонецЕсли;
		нСтроки = ПривязанныеКСтроке.НайтиСтроки(Новый Структура("ВидБСО",СтрокаТЗ.БСО));
		
		Если нСтроки.Количество()>0 Тогда
			//Восстановление
			СтрокаТЗ.Добавить = Истина;
			СтрокаТЗ.ПлановаяСтоимость = нСтроки[0].ИтогСтраховаяПремия;
		КонецЕсли;
		//	//уже есть привязанное
		
		//	
		//Иначе
		
		
		//Если ЭтоНоваяСтрока ИЛИ Модифицированность = Истина  Тогда
		
		//Проверки
		ДолжноПоСкидке = СтрокаТЗ.УсловиеДобавления = "Всегда" 
		ИЛИ (СтрокаТЗ.УсловиеДобавления = "Наличие скидки" И ЕстьСкидка)
		ИЛИ (СтрокаТЗ.УсловиеДобавления = "Отсутствие скидки" И ЕстьСкидка = Ложь)
		ИЛИ (СтрокаТЗ.Добавить = Истина и СтрокаТЗ.УсловиеДобавления = "Вручную");//Добавлено руками. автоматика не работает
		
		ДолжноПоВидуЗаявки = СтрокаТЗ.УсловиеВидаЗаявокЛичная = "Все" 
		ИЛИ ПустаяСтрока(СтрокаТЗ.УсловиеВидаЗаявокЛичная)
		ИЛИ (СтрокаТЗ.УсловиеВидаЗаявокЛичная = "Личные" и Личная = Истина) 
		ИЛИ (СтрокаТЗ.УсловиеВидаЗаявокЛичная = "Не личные" и Личная = ЛОЖЬ); 
		
		Если (ДолжноПоСкидке И ДолжноПоВидуЗаявки) <> СтрокаТЗ.Добавить Тогда
			СтрокаТЗ.Добавить = (ДолжноПоСкидке И ДолжноПоВидуЗаявки);
			Модифицированность = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИнфоПоставщик(Параметры = Неопределено)
	
	Если Параметры = Неопределено Тогда
		Текст = ""
	Иначе
		Если Параметры.Поставщик = СК Тогда
			ДопТекстПоставщик = ""
		Иначе
			ДопТекстПоставщик = "'" + Параметры.ПоставщикСтрока + "' ";
		КонецЕсли;
		Если ПустаяСтрока(параметры.НаименованиеДоговора) Тогда
			ДопТекстДоговор = "";
		Иначе
			ДопТекстДоговор = Параметры.НаименованиеДоговора + ?(ЗначениеЗаполнено(Параметры.ДатаЗаключенияДоговора), " от " + Формат(Параметры.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy") + " г.", "");
		КонецЕсли;
		Текст = ДопТекстПоставщик + ?(ДопТекстДоговор = "", "", ДопТекстДоговор);
	КонецЕсли;
	Элементы.ИнфоПоставщик.Заголовок = Текст;
	
КонецПроцедуры

