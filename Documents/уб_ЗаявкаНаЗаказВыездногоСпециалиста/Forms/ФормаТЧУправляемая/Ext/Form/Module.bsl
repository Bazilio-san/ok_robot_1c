					//	Стр = Новый СообщениеПользователю;
					//	Стр.Текст	= "Не заполнен расчетчик!";
					//	Стр.ПутьКДанным	= "Расчетчик; Стр.Сообщить();
					//КонецЕсли;
					
				КонецЕсли;
				Если МаркаИМодельОбязательна(ВидБСО,ДокументДата) Тогда
					
					Если НЕ уб_Кэшируемые.ДоступностьРоли("уб_МенеджерНаТочке,уб_ЗП_ПолныйДоступ") Тогда
						Если МаркаТС.Пустая() Тогда
							Стр = Новый СообщениеПользователю;
							Стр.Текст	= "Не заполнена марка транспортного средства!";
							Стр.ПутьКДанным	= "МаркаТС";
							Стр.Сообщить();
