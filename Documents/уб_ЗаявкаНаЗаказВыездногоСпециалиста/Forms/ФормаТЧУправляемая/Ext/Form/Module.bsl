		ЭтоБесполисные = ТекВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.Бесполисные");
		
		ЭтоДК = Найти(ТекВидБСО,"дк")>0 или Найти(ТекВидБСО,"техосмотр")>0 или Найти(ТекВидБСО,"приглашение на то")>0;
		
		//ПараметрыВидаБСО.Вставить("ЭтоЕОсаго",ЭтоЕОсаго);
		//ПараметрыВидаБСО.Вставить("ЭтоОСАГО",ЭтоОСАГО);
		//ПараметрыВидаБСО.Вставить("ЭтоКАСКО",ЭтоКАСКО);
		
		Если ЭтоОСАГО или ЭтоЕОсаго или ЭтоБесполисные Тогда
			ЛимитОтветственности = 400000;//ПараметрыСеанса.уб_Константы.уб_СуммаОсаго;

		ИначеЕсли найти(ТекВидБСО,"дк")=1 Тогда	
			ЛимитОтветственности = 10000;
		Иначе
			Элементы.СтраховаяПремия.КнопкаСпискаВыбора = Ложь;
			Если ЭтоКаско Тогда
				ЛимитОтветственностиПриИзменении(Неопределено,ЭтоКаско);
			КонецЕсли;	
		КонецЕсли;
		
		//Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.Страницы.СтраницаСвязанныхБланков;
		
		Если ЭтоЕОсаго = Истина Тогда
			//
			Элементы.КВБрокераПлан.АвтоОтметкаНезаполненного = Ложь;
		КонецЕсли;
		
		//Для курьеров
		//Элементы.Страницы.ТекущаяСтраница = Элементы.Файлы;
		
		СвязанныеБСО.Очистить();
	Иначе
		ЭтоЕОсаго = Ложь;
		ЭтоОСАГО  = Ложь;
		ЭтоКАСКО  = Ложь;
	КонецЕсли;	
	ПолучитьИндексПродуктаИОбновитьНадписьОшибкиВидаБСО();
	
	
		//Если ЗначениеЗаполнено(ОрганизацияАгент)= Ложь Тогда
		ЗаполнитьОргАгента();
		//КонецЕсли;	
	
	
//	Элементы.ДобавитьОбразец.Доступность = ЗначениеЗаполнено(ВидБСО) И ЭтоВидБСО И Не ПустаяСтрока(ВидБСО.ИмяФайлаОбразца);
	
	//Если ЭтоКаско или ЭтоОсаго или ЭтоДК Тогда
	Если уб_ВызовСервера.ТребуетсяЗаполнениеМаркиМодели(ВидБСО,ДокументДата) Тогда
		
		Элементы.ОткрытьОбъектСтрахования.Видимость = Истина;
		НадписьОбъект();
	Иначе
		Элементы.ОткрытьОбъектСтрахования.Видимость = Ложь;
	КонецЕсли;
	Элементы.Техосмотр.Видимость = ЭтоДК = Истина;
	Элементы.фФраншиза.Видимость = ЭтоДК = Ложь;
