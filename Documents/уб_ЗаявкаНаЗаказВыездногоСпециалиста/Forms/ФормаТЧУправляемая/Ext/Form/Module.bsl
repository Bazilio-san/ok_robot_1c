&НаКлиенте
Процедура НастройкиПолей(Знач РассчитыватьСкидку = Ложь)
	
	Если ДокументДата>=Дата(2026,1,1) 
		и ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Поставщику") 
		и ВидБСО<>ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.Ипотека")
		и ВидБСО<>ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ВЗР") Тогда
		дельта = 3;
	ИначеЕсли ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.Терминал")
		или ФормаОплаты = ПредопределенноеЗначение("Перечисление.уб_ФормыОплаты.ПоСсылкеБрокеру") Тогда
		дельта = 3;
	Иначе
		дельта = 0;
	КонецЕсли;	
	ПотеряннаяКомиссия = Окр((дельта)*СуммаВзноса/100,2);
	
	КвитанцияА7 = ПредопределенноеЗначение("Перечисление.уб_ТипыБСО.КвитанцияА7");
	//Прч = Перечисления.уб_ТипыБСО;
	ТипЗнчВидБСОВидБСО = ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО");
	ТипБСОКвитанция = ТипЗнчВидБСОВидБСО И ВидБСО.Тип = КвитанцияА7;
	//Если (РассрочкаПлатежа = 0 Или СуммаВзноса > СтраховаяПремия) И УстановитьЗначение(СуммаВзноса, СтраховаяПремия) Тогда
	РассчитыватьСкидку = Истина;
	//КонецЕсли;
	Если СК.Пустая() И ЗначениеЗаполнено(ВидБСО) Тогда
		Элементы.ВидБСО.ТолькоПросмотр = Ложь;
		Элементы.Колонки.ЦветФона = Новый Цвет(255, 173, 172);
	КонецЕсли;
	Если Количество = 0 Тогда
		Количество = 1;
	КонецЕсли;
	Если ИндексТипаПродукта = -1 Тогда
		ПолучитьИндексПродуктаИОбновитьНадписьОшибкиВидаБСО();
	КонецЕсли;
	МаркаИМодельОбязательна = МаркаИМодельОбязательна(ВидБСО,ДокументДата);
	РасчетчикОбязателен		= ЛОЖЬ;
	
	Если Запрещено Тогда
		// редактировать можно только незаполненные поля расчетчиков
		ЗаполненВидБСО = ЗначениеЗаполнено(ВидБСО) И ТипЗнчВидБСОВидБСО;
		Элементы.СК.ТолькоПросмотр									= Истина;
		Элементы.ВидБСО.ТолькоПросмотр								= Истина;
		Элементы.ОрганизацияАгент.ТолькоПросмотр					= Истина;
		Элементы.ЛимитОтветственности.ТолькоПросмотр				= Истина;
		Элементы.ЛимитОтветственности.ОтметкаНезаполненного		= Ложь;
		Элементы.Агрегатная.Доступность							= Ложь;
		Элементы.СтраховаяПремия.ТолькоПросмотр					= Истина;
		Элементы.СтраховаяПремия.ОтметкаНезаполненного				= Ложь;
		Элементы.фФраншиза.Доступность								= Ложь;
		Элементы.Франшиза.Видимость								= Ложь;
		//Элементы.НадписьПредоставленнаяСкидка.Доступность			= Ложь;
		Элементы.ПредоставленнаяСкидкаПроцент.ТолькоПросмотр		= Истина;
		Элементы.ПредоставленнаяСкидка.ТолькоПросмотр				= Истина;
		//Элементы.БезубыточныйПереход.ТолькоПросмотр				= Истина;
		//Элементы.БезубыточныйПереход.ОтметкаНезаполненного			= Ложь;
		Элементы.ОфициальнаяСкидка.ТолькоПросмотр				    = Истина;
