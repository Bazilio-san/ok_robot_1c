&наКлиенте
Процедура ПолучитьИндексПродуктаИОбновитьНадписьОшибкиВидаБСО()
	
	ОписаниеОшибки = "";
	ИндексТипаПродукта = ИндексТипаПродуктаПоВидуБСОДляНастройкиПолей(ОписаниеОшибки);
	Уб_Клиент._УстановитьЗначение(ЭтаФорма,"ОшибкаВидаБСО", ОписаниеОшибки);
	//ЭлементыФормы.НадписьОшибкаВидаБСО.Видимость = Не ПустаяСтрока(ОшибкаВидаБСО);
	
КонецПроцедуры

//0 - все поля блокированы (не заполнен вид БСО)
//1 - доступно только количество (карточки или квитанции без рассрочки)
//2 - только основные (сумма, премия) - для всех
//3 - + расчетчик (ОСАГО, ДСАГО)
//4 - все поля доступны (КАСКО) или квитанции с рассрочкой
&НаКлиенте
Функция ИндексТипаПродуктаПоВидуБСОДляНастройкиПолей(ОписаниеОшибки = "")
	
	Если Не ЗначениеЗаполнено(ВидБСО) 
		Или ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
		Результат = 0;
		Если ЗначениеЗаполнено(ВидБСО) Тогда
			//выбран страховой продукт
			ОписаниеОшибки = "В поле 'ВидБСО' выбран страховой продукт. Требуется очистить значение поля и выбрать нужный вид БСО.";
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(ВидБСО) 
		Или ТипЗнч(ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда	
		Если  ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО")
			ИЛИ ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ЕКАСКО")
			или ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.КаскоПП")
			Тогда
			Возврат 4;
		ИначеЕсли  ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО")
			ИЛИ ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ЕОСАГО")
			ИЛИ ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ДСАГО")
			или ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.Бесполисные")
			Тогда
			Возврат 3;
		Иначе
			Возврат 2;
		КонецЕсли;
	Иначе
		
		Если Строка(ВидБСО) = "Приглашение на ТО" Тогда
			Возврат 5;
		КонецЕсли;
		Результат = РезультатПоВидуБСО(ВидБСО,РассрочкаПлатежа,ОписаниеОшибки);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // ТипПродуктаПоВидуБСО()


&НаСервереБезКонтекста
Функция РезультатПоВидуБСО(ВидБСО,РассрочкаПлатежа,ОписаниеОшибки)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
		|				КОГДА СП.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.Карточка)
		|						ИЛИ СП.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.СпецзнакОСАГО)
		|					ТОГДА 1
		|				КОГДА СП.ВидБСО.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипыБСО.КвитанцияА7)
		|					ТОГДА ВЫБОР
		|							КОГДА &Рассрочка
		|								ТОГДА 4
		|							ИНАЧЕ 1
		|						КОНЕЦ
		|				КОГДА СП.Ссылка.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО)
		|					ТОГДА 4
		|				КОГДА СП.Ссылка.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО)
		|						ИЛИ СП.Ссылка.Вид = ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ДСАГО)
		|					ТОГДА 3
		|				ИНАЧЕ 2
		|			КОНЕЦ), 0) КАК Индекс
		|ИЗ
		|	Справочник.уб_СтраховыеПродукты.ВидыБСО КАК СП
		|ГДЕ
		|	НЕ СП.Ссылка.ПометкаУдаления
		|	И СП.ВидБСО = &ВидБСО");
		Запрос.УстановитьПараметр("ВидБСО", 	ВидБСО);
		Запрос.УстановитьПараметр("Рассрочка",  НЕ РассрочкаПлатежа = 1);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Результат = 0
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Если Выборка.Индекс = 0 Тогда
				//возможно нет страховых продуктов по БСО
				//тогда определяем индекс по типу
				Прч = Перечисления.уб_ТипыБСО;
				Тип = ВидБСО.Тип;
				ОписаниеОшибкиНетВПродукте = "Вид БСО '" + ВидБСО + "' не включен ни в один страховой продукт!";
				Если Тип.Пустая() Тогда
					Результат = 0;
					ОписаниеОшибки = "Не заполнен тип бланка БСО '" + ВидБСО + "'! (полис, карточка или проч). 
					|" + ОписаниеОшибкиНетВПродукте + "
					|Обратитесь в отдел БСО для исправления ошибки";
				Иначе
					ОписаниеОшибки = ОписаниеОшибкиНетВПродукте + " Обратитесь в отдел БСО для исправления ошибки.";
					//Если Тип = Прч.Полис Или Тип = Прч.ПолисОсаго Тогда
					//	Результат = 3;
					//Иначе
					Если Тип = Прч.КвитанцияА7 Тогда
						Результат = ?(РассрочкаПлатежа > 1, 4, 1);
					Иначе
						Результат = 1
					КонецЕсли;
				КонецЕсли;
			Иначе
				//Если Найти(ВидБСО,"Техосмотр")>0 Тогда
				//	Результат = 1;
				//Иначе	
				Результат = Выборка.Индекс;
				//КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		Возврат Результат
	КонецФункции	



