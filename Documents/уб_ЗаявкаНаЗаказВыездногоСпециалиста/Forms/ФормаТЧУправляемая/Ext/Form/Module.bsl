				КонецЕсли;
			ИначеЕсли ИндексТипаПродукта = 5 Тогда	
				
				Если НЕ уб_Кэшируемые.ДоступностьРоли("уб_МенеджерНаТочке,уб_ЗП_ПолныйДоступ") Тогда
					Если МаркаТС.Пустая() Тогда
						Стр = Новый СообщениеПользователю;
						Стр.Текст	= "Не заполнена марка транспортного средства!";
						Стр.ПутьКДанным	= "МаркаТС";
						Стр.Сообщить();
					КонецЕсли;
					Если МодельТС.Пустая() Тогда
						Стр = Новый СообщениеПользователю;
						Стр.Текст	= "Не заполнена модель транспортного средства!";
						Стр.ПутьКДанным	= "МодельТС";
						Стр.Сообщить();
					КонецЕсли;
				КонецЕсли;
				Если СтраховаяПремия = 0 И СтраховаяПремияДоступность Тогда
					Стр = Новый СообщениеПользователю;
					Стр.Текст 	= "Не заполнена страховая премия!";
					Стр.ПутьКДанным	= "СтраховаяПремия";
					Стр.Сообщить();
				КонецЕсли;
			КонецЕсли;
			Если НЕ уб_Кэшируемые.ДоступностьРоли("уб_МенеджерНаТочке") Тогда
				Если Состояние = ПредопределенноеЗначение("Перечисление.уб_СостояниеОформления.Печать")  Тогда
					Если ПустаяСтрока(НомерБСО) Тогда
						Стр = Новый СообщениеПользователю;
						Стр.Текст 	= "Не заполнен номер бланка полиса!";
						Стр.ПутьКДанным	= "НомерБСО";
						Стр.Сообщить();
					Иначе	
					КонецЕсли;
				КонецЕсли;	
				
				Если Состояние = ПредопределенноеЗначение("Перечисление.уб_СостояниеОформления.КомплектОформлен") 
					ИЛИ Состояние = ПредопределенноеЗначение("Перечисление.уб_СостояниеОформления.Печать") Тогда	
					Если МаркаИМодельОбязательна(ВидБСО,ДокументДата) Тогда
						Если ПустаяСтрока(Vin) Тогда
							Стр = Новый СообщениеПользователю;
							Стр.Текст 	= "Не заполнен Vin!";
							Стр.ПутьКДанным	= "Vin";
							Стр.Сообщить();
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	
	//Если Состояние = Перечисления.уб_СостояниеОформления.КомплектОформлен или Состояние = Перечисления.уб_СостояниеОформления.Печать Тогда	
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнена дата начала полиса!";
		Стр.ПутьКДанным	= "ДатаНачала";
		Стр.Сообщить();
	Иначе	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнена дата окончания полиса!";
		Стр.ПутьКДанным	= "ДатаОкончания";
		Стр.Сообщить();
	Иначе	
	КонецЕсли;
	
	
	ПриведеннаяДатаНачала = ДатаНачала-70*3600*24;
	Если ЗначениеЗаполнено(ДатаОформления) Тогда
		Если ДатаОформления>=ПриведеннаяДатаНачала и ДатаОформления<=ДатаОкончания Тогда
		Иначе
			Стр = Новый СообщениеПользователю;
			Стр.Текст 	= "Дата взноса не входит в период действия полиса!";
			Стр.ПутьКДанным	= "тРасрочки";
			Стр.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
	
	
	Если ЗначениеЗаполнено(Взнос2Дата) Тогда
		Если Взнос2Дата>=ПриведеннаяДатаНачала и Взнос2Дата<=ДатаОкончания Тогда
		Иначе
			Стр = Новый СообщениеПользователю;
			Стр.Текст 	= "Дата второго взноса не входит в период действия полиса!";
			Стр.ПутьКДанным	= "тРасрочки";
			Стр.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Взнос3Дата) Тогда
		Если Взнос3Дата>=ПриведеннаяДатаНачала и Взнос3Дата<=ДатаОкончания Тогда
		Иначе
			Стр = Новый СообщениеПользователю;
			Стр.Текст 	= "Дата третьего взноса не входит в период действия полиса!";
			Стр.ПутьКДанным	= "тРасрочки";
			Стр.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Взнос4Дата) Тогда
		Если Взнос4Дата>=ПриведеннаяДатаНачала и Взнос4Дата<=ДатаОкончания Тогда
		Иначе
			Стр = Новый СообщениеПользователю;
			Стр.Текст 	= "Дата четвертого взноса не входит в период действия полиса!";
			Стр.ПутьКДанным	= "тРасрочки";
			Стр.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
	
	//КонецЕсли;
	
	Если КВБрокераПлан = 0 и ДокументДата >Дата(2015,8,25) и МинимальнаяСумма=0 и ИндексТипаПродукта<>1//ДокументОбъект.Банк <> Справочники.Банки.ПустаяСсылка() 
		Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст	= "Не указано КВ брокера";
		Стр.ПутьКДанным	= "КВБрокераПлан";
		Стр.Сообщить();
		//Предупреждение("Не указано КВ брокера");
		//Возврат
	КонецЕсли;	
	
	ЕстьОшибки = НЕ Стр = Неопределено;
	Возврат ЕстьОшибки = Ложь;
	
КонецФункции // ПроверитьОсновныеРеквизиты()



