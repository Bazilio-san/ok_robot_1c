&НаКлиенте
Процедура OK(Команда)
	
	НомерБСО = уб_ВызовСервера.ПривестиНомерБСО(""+НомерБСО);
	
	Если ЗначениеЗаполнено(Vin) и ЗначениеЗаполнено(ОбъектСтрахования) = Ложь Тогда
		ОбъектСтрахования = уб_ВызовСервера.НайтиОбъектСтрахования(ВидБСО,vin,МаркаТС,МодельТС);
		Модифицированность = Истина;
	КонецЕсли;	
	
	Записать = Истина;
	//Из таблицы в реквизиты
	Если РассрочкаПлатежа >=1 Тогда
		ДатаОформления = тРасрочки[0].Дата;
		Взнос1Сумма = тРасрочки[0].Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=2 Тогда
		Взнос2Дата = тРасрочки[1].Дата;
		Взнос2Сумма = тРасрочки[1].Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=3 Тогда
		Взнос3Дата = тРасрочки[2].Дата;
		Взнос3Сумма = тРасрочки[2].Сумма;
	КонецЕсли;	
	
	Если РассрочкаПлатежа >=4 Тогда
		Взнос4Дата = тРасрочки[3].Дата;
		Взнос4Сумма = тРасрочки[3].Сумма;
	КонецЕсли;	
	
	Если Не фФраншиза Тогда
		уб_Клиент._УстановитьЗначение(ЭтаФорма,"Франшиза", 0);
	КонецЕсли;
	
	
	Если НеобходимоВыбратьКошелек Тогда
		СписокКошельков = Новый СписокЗначений;
		СписокКошельков.ЗагрузитьЗначения(Уб_Серверные.КартыСотрудники().Скопировать(Новый Структура("Сотрудник",ДокументМенеджер)).ВыгрузитьКолонку("Карта"));
		
		ВыбранныйКошелек = СписокКошельков.ВыбратьЭлемент("Выберите карту, по которой прошла оплата");
		
		Если Не ВыбранныйКошелек = Неопределено Тогда
			Кошелек = ВыбранныйКошелек.Значение;
			Записать = Истина;
			Модифицированность = Истина;
		КонецЕсли;	
		
		
	КонецЕсли;	
	
	//Если Не Записать И Модифицированность Тогда
	//	Ответ = Вопрос("Записать измененные данные?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	//	Записать = Ответ = КодВозвратаДиалога.Да;
	//КонецЕсли;
	Если Записать Тогда
		Отказ = Не ПроверитьОсновныеРеквизиты();
		Если Не Отказ Тогда
			Если Не уб_СЕРВЕРные.ПроверкаДат(ДатаНачала,Аддендум) Тогда
				Отказ = Истина;
				Стр = Новый СообщениеПользователю;
				Стр.Текст 	= "Проверьте дату начала";
				Стр.ПутьКДанным	= "ДатаНачала";
				Стр.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
		Если НЕ Отказ = Истина Тогда
			
			
			
			ДанныеСтроки = Новый Структура;
			Для каждого Рекв из уб_ВызовСервера.РеквизитыБСОЗаявки() Цикл
				Попытка
					ДанныеСтроки.Вставить(Рекв.Имя,ЭтаФорма[Рекв.Имя]);
				Исключение
				КонецПопытки;	
			КонецЦикла;
			ДанныеСтроки.Вставить("Техосмотр_ДатаВремя",    ЭтаФорма.Техосмотр_ДатаВремя);
			ДанныеСтроки.Вставить("Техосмотр_Наименование", ЭтаФорма.Техосмотр_Наименование);
			ДанныеСтроки.Вставить("Техосмотр_АдресТелефон", ЭтаФорма.Техосмотр_АдресТелефон);
			ДанныеСтроки.Вставить("БезубыточныйПереход",    ?(ЭтаФорма.БезубыточныйПереход = "Да", Истина, Ложь));
			ДанныеСтроки.Вставить("ОфициальнаяСкидка",      ?(ЭтаФорма.ОфициальнаяСкидка = "Да", Истина, Ложь));
			ДанныеСтроки.Вставить("ФормаОплаты",            ФормаОплаты);
			ДанныеСтроки.Вставить("ВидОплаты",              ВидОплаты);
			ДанныеСтроки.Вставить("ИтогСтраховаяПремия",       СуммаВзноса*1);
			ДанныеСтроки.Вставить("ИтогПредоставленнаяСкидка", ПредоставленнаяСкидка*1);
			ДанныеСтроки.Вставить("ЭтоНоваяСтрока", ЭтоНоваяСтрока);
			ОповеститьОВыборе(ДанныеСтроки);
			ЭтоНоваяСтрока = Ложь;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры



