	//ПравоВАрхив = уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") или ВладелецФормы.СписокОператоров().Найти(ПараметрыСеанса.уб_ТекущееФизЛицо)<>Неопределено или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.КураторВыездных, Ложь);
	//Элементы.кпФайлы.Кнопки.ВАрхив.Доступность = ПравоВАрхив;
	
	Элементы.мСписокФайловВидДокумента.СписокВыбора.ЗагрузитьЗначения(уб_ФормыВызовСервера.ВидыДокументовКПолисам().ВыгрузитьЗначения());
	
	уб_ФормыВызовСервера.ОбновитьСписок(мСписокФайлов,ДанныеОбъекта(),Элементы.мСписокФайлов,Неопределено,ПараметрыОбновления,"уб_ЗаявкаНаЗаказВыездногоСпециалиста","СписокФайлов.УидСтроки ="""+УидСтроки+"""");
	
