Процедура ЗаполнитьОргАгента()
	
	Если Не ВидБСО.Пустая() И ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДК.Наименование,
		|	ДК.ДатаЗаключенияДоговора,
		|	ДК.Организация,
		|	ДК.Владелец,
		|	ДК.ВидСП
		|ПОМЕСТИТЬ ВТ_Договоры
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДК
		|ГДЕ
		|	ДК.РасширениеНазвания <> ""---""
		|	И НЕ ДК.ПометкаУдаления
		|	И (ДК.ДатаОкончанияДействияДоговора = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ ДК.ДатаОкончанияДействияДоговора > &Дата)
		|	И ДК.ДатаЗаключенияДоговора < &Дата
		|	И ДК.ВидСП В (ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.КАСКО))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПБ.Ссылка.ОрганизацияАгент КАК ОрганизацияАгент,
		|	ПБ.Ссылка.Поставщик КАК Поставщик,
		|	ПРЕДСТАВЛЕНИЕ(ПБ.Ссылка.ОрганизацияАгент) КАК ОрганизацияАгентСтрока,
		|	ПРЕДСТАВЛЕНИЕ(ПБ.Ссылка.Поставщик) КАК ПоставщикСтрока,
		|	ЕСТЬNULL(ВТ_Договоры.Наименование, """") КАК НаименованиеДоговора,
		|	ЕСТЬNULL(ВТ_Договоры.ДатаЗаключенияДоговора, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаЗаключенияДоговора,
		|	ЕСТЬNULL(ВТ_Договоры.ВидСП, ЗНАЧЕНИЕ(Перечисление.уб_ВидыСтраховыхПродуктов.ПустаяСсылка)) КАК ВидСП,
		|	ПБ.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.уб_ПоступлениеБСО.БСО КАК ПБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Договоры КАК ВТ_Договоры
		|		ПО ПБ.Ссылка.Поставщик = ВТ_Договоры.Владелец
		|			И ПБ.Ссылка.ОрганизацияАгент = ВТ_Договоры.Организация
		|ГДЕ
		|	ПБ.ВидБСО = &ВидБСО
		|   и ПБ.Ссылка.ОрганизацияАгент.ПометкаУдаления = ЛОЖЬ
		|	И ПБ.Ссылка.Дата >= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ,
		|	ОрганизацияАгент,
		|	Поставщик,
		|	ВидСП УБЫВ");
		Запрос.УстановитьПараметр("ВидБСО", ВидБСО);
		Дата = ?(ЗначениеЗаполнено(ДокументДата), ДокументДата, ТекущаяДата());
		//Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(Дата, -3));
		Запрос.УстановитьПараметр("Дата", Дата(2023,3,1));
		//Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(Дата, -12));
		РезультатЗапроса = Запрос.Выполнить();
		ТЗДоговоров.Очистить();
		Если РезультатЗапроса.Пустой() Тогда
			Элементы.ОрганизацияАгент.КнопкаСпискаВыбора = Ложь;
			//ОрганизацияАгент = Неопределено;
			//ЗаполнитьИнфоПоставщик();
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			СЗОргАгентов = Новый СписокЗначений;
			СзПоставщиков = Новый СписокЗначений;
			//Пока Выборка.СледующийПоЗначениюПоля("ОрганизацияАгент") Цикл
			Пока Выборка.Следующий() Цикл
				Если СЗОргАгентов.НайтиПоЗначению(Выборка.ОрганизацияАгент)  = Неопределено Тогда
					СЗОргАгентов.Добавить(Выборка.ОрганизацияАгент, Выборка.ОрганизацияАгентСтрока);				
				КонецЕсли;	
				СтрокаТЗ = ТЗДоговоров.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
				Если СзПоставщиков.НайтиПоЗначению(Выборка.Поставщик)  = Неопределено Тогда
					СзПоставщиков.Добавить(Выборка.Поставщик);
				КонецЕсли;	
			КонецЦикла;
			СЗОргАгентовКоличество = СЗОргАгентов.Количество();
			Если СЗОргАгентовКоличество = 0 Тогда
				ОрганизацияАгент = Неопределено;
				//ЗаполнитьИнфоПоставщик();
				Элементы.ОрганизацияАгент.КнопкаСпискаВыбора = Истина;	
			ИначеЕсли СЗОргАгентовКоличество = 1 Тогда
				ОрганизацияАгент = Выборка.ОрганизацияАгент;
				//СтрокаТЗ = ТЗДоговоров.НайтиСтроки(Новый Структура(ОрганизацияАгент, "ОрганизацияАгент");
				Элементы.ОрганизацияАгент.КнопкаСпискаВыбора = Ложь;
				//Если СзПоставщиков.Количество() = 1 Тогда
				//	Поставщик = Выборка.Поставщик;
				//КонецЕсли;
			Иначе
				ОрганизацияАгент = СЗОргАгентов[0].Значение;
				//Элементы.ОрганизацияАгент.КнопкаСпискаВыбора = Истина;
				//Если Не ОрганизацияАгент.Пустая() Тогда
				//	СтрокаТЗ = ТЗДоговоров.Найти(ОрганизацияАгент, "ОрганизацияАгент");
				//	Если СтрокаТЗ = Неопределено Тогда
				//		//ОрганизацияАгент = Неопределено;
				//		Сообщить(""+ОрганизацияАгент+" не найдена в действующих договорах по "+СК);
				//		ЗаполнитьИнфоПоставщик();
				//	КонецЕсли;
				//КонецЕсли;
				Элементы.ОрганизацияАгент.СписокВыбора = СЗОргАгентов;
				Элементы.ОрганизацияАгент.КнопкаСпискаВыбора = Истина;	
			КонецЕсли;
			
				//
				ЕстьВопросы = Ложь;
				Для каждого ТекПоставщик из Элементы.Поставщик.СписокВыбора Цикл
					Если  СзПоставщиков.НайтиПоЗначению(ТекПоставщик.Значение)= Неопределено Тогда
						//ТекПоставщик.Картинка = БиблиотекаКартинок.уб_ОплатаВопрос;
						ЕстьВопросы = Истина;
					Иначе
						//ТекПоставщик.Картинка = Новый Картинка;
					КонецЕсли;	
				КонецЦикла;	
				//Если ЕстьВопросы = Истина Тогда
				//	Элементы.Поставщик.Картинка = БиблиотекаКартинок.уб_ОплатаВопрос;
				//Иначе	
				//	Элементы.Поставщик.Картинка = БиблиотекаКартинок.ВыполненоУспешно32;
				//КонецЕсли;	
				
				Если ЗначениеЗаполнено(Поставщик) Тогда
					
					Если СзПоставщиков.НайтиПоЗначению(Поставщик)= Неопределено ТОгда
						//!!!Сообщить("Для выбранного поставщика не найден действующий договор. Либо бланки давно не поступали. Проверьте внимательно",5);
						
					Иначе	
						//Элементы.Поставщик.Картинка = БиблиотекаКартинок.ВыполненоУспешно32;
					КонецЕсли;	
				КонецЕсли;	
			
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВидБСО) = Тип("ПеречислениеСсылка.уб_ВидыСтраховыхПродуктов") Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СК",СК);
		Запрос.УстановитьПараметр("ВидСП",ВидБСО);
		Запрос.Текст = "ВЫБРАТЬ
		|	влож.ОрганизацияАгент,
		|	ПРЕДСТАВЛЕНИЕ(влож.ОрганизацияАгент) КАК ОрганизацияАгентСтрока,
		|	влож.сортировка
		|ИЗ
		|	(ВЫБРАТЬ
		|		КонтрагентыВидыСП.Организация КАК ОрганизацияАгент,
		|		0 КАК сортировка
		|	ИЗ
		|		Справочник.Контрагенты.ВидыСП КАК КонтрагентыВидыСП
		|	ГДЕ
		|		КонтрагентыВидыСП.Ссылка = &СК
		|		И КонтрагентыВидыСП.ВидСП = &ВидСП
		|		И НЕ КонтрагентыВидыСП.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Организации.Ссылка,
		|		1
		|	ИЗ
		|		Справочник.Контрагенты.ВидыСП КАК КонтрагентыВидыСП
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ПО (Организации.ПометкаУдаления = ЛОЖЬ)
		|	ГДЕ
		|		КонтрагентыВидыСП.Ссылка = &СК
		|		И КонтрагентыВидыСП.ВидСП = &ВидСП
		|		И КонтрагентыВидыСП.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Организации.Ссылка,
		|		2
		|	ИЗ
		|		Справочник.Контрагенты КАК Контрагенты
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ВидыСП КАК КонтрагентыВидыСП
		|			ПО (КонтрагентыВидыСП.Ссылка = Контрагенты.Ссылка)
		|				И (КонтрагентыВидыСП.НомерСтроки = 1)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ПО (Организации.ПометкаУдаления = ЛОЖЬ)
		|	ГДЕ
		|		Контрагенты.Ссылка = &СК
		|		И КонтрагентыВидыСП.Ссылка ЕСТЬ NULL) КАК влож
		|
		|УПОРЯДОЧИТЬ ПО
		|	влож.сортировка,
		|	влож.ОрганизацияАгент.Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		СЗОргАгентов = Новый СписокЗначений;
		флЕстьСортировка2или3 = Ложь;
		Пока Выборка.Следующий() Цикл
			Если СЗОргАгентов.НайтиПоЗначению(Выборка.ОрганизацияАгент)  = Неопределено Тогда
				СЗОргАгентов.Добавить(Выборка.ОрганизацияАгент, Выборка.ОрганизацияАгентСтрока);				
				Если Выборка.Сортировка >= 2 Тогда 
					флЕстьСортировка2или3 = Истина;
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;	
		
		СЗОргАгентовКоличество = СЗОргАгентов.Количество();
