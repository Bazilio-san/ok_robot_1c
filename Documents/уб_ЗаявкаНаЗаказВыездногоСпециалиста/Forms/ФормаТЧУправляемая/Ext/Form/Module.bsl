Функция ПроверитьОсновныеРеквизиты()
	ОчиститьСообщения();
	Стр = Неопределено;
	
	ВладелецФормыДата = ДокументДата;
	Если СК.Пустая() Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнена СК!";
		Стр.ПутьКДанным	= "СК";
		Стр.Сообщить();
	КонецЕсли;
	Если Поставщик.Пустая() Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнен Поставщик!";
		Стр.ПутьКДанным	= "Поставщик";
		Стр.Сообщить();
	КонецЕсли;
	
	Если ФормаОплаты.Пустая() Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнена форма оплаты!";
		Стр.ПутьКДанным	= "ВидОплаты";
		Стр.Сообщить();
	КонецЕсли;

	
	Если ОрганизацияАгент.Пустая() Тогда
		//ОрганизацияАгент = ПоследнийОргАгент();
			Стр 			= Новый СообщениеПользователю;
			Стр.Текст 	= "Не указано юрлицо Страхового агенства";
			Стр.ПутьКДанным	= "ОрганизацияАгент";
			Стр.Сообщить();
		//	Отказ = Истина;
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(ВидБСО) = ЛОЖЬ Тогда
		Стр = Новый СообщениеПользователю;
		Стр.Текст 	= "Не заполнен вид БСО!";
		Стр.ПутьКДанным	= "ВидБСО";
		Стр.Сообщить();
	Иначе//Значен ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
		ЛимитОтветственностиДоступность = Не Элементы.ЛимитОтветственности.ТолькоПросмотр;
		СтраховаяПремияДоступность 		= Не Элементы.СтраховаяПремия.ТолькоПросмотр;
		Если ВладелецФормыДата = '00010101000000' Или ВладелецФормыДата > '20130710000000' Тогда//10 июля 2013
			Если ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО") Тогда
				ВидБСОТип = уб_вызовСервера.ЗначениеРеквизитаОбъекта(ВидБСО,"Тип");
			Иначе
				Если ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО") Тогда
					ВидБСОТип = ПредопределенноеЗначение("Перечисление.уб_ТипыБСО.ПолисОсаго")
				Иначе
					ВидБСОТип = ПредопределенноеЗначение("Перечисление.уб_ТипыБСО.Полис")
				КонецЕсли;	
			КонецЕсли;	
			Если (ВидБСОТип = ПредопределенноеЗначение("Перечисление.уб_ТипыБСО.Полис") Или ВидБСОТип = ПредопределенноеЗначение("Перечисление.уб_ТипыБСО.ПолисОсаго")) 
				и Не ИндексТипаПродукта = 5 Тогда
				Если ЛимитОтветственности = 0 И ЛимитОтветственностиДоступность Тогда
					Стр = Новый СообщениеПользователю;
					Стр.Текст 	= "Не заполнен лимит ответственности!";
					Стр.ПутьКДанным	= "ЛимитОтветственности";
					Стр.Сообщить();
				КонецЕсли;
				Если СтраховаяПремия = 0 И СтраховаяПремияДоступность Тогда
					Стр = Новый СообщениеПользователю;
					Стр.Текст 	= "Не заполнена страховая премия!";
					Стр.ПутьКДанным	= "СтраховаяПремия";
					Стр.Сообщить();
				КонецЕсли;
				Если тРасрочки.Итог("Сумма")<>СтраховаяПремия Тогда
					Стр = Новый СообщениеПользователю;
					Стр.Текст	= "Сумма взносов не равна Полной премии!";
					Стр.ПутьКДанным	= "тРасрочки";
					Стр.Сообщить();
				КонецЕсли;	
				
				Если СуммаВзноса = 0  Тогда
					Стр = Новый СообщениеПользователю;
					Стр.Текст	= "Не заполнена сумма взноса!";
					Стр.ПутьКДанным	= "СуммаВзноса";
					Стр.Сообщить();
				Иначе	
					Если тРасрочки.НайтиСтроки(Новый Структура("Сумма",СуммаВзноса)).Количество() = 0  Тогда
						Стр = Новый СообщениеПользователю;
						Стр.Текст	= "Указанная сумма взноса не найдена в таблице рассрочки!";
						Стр.ПутьКДанным	= "СуммаВзноса";
						Стр.Сообщить();
					КонецЕсли;
				КонецЕсли;
				
				
				
				//Если РассрочкаПлатежа = 1 Тогда
					//Если СуммаВзноса = 0 или Взнос2Сумма = 0 Тогда
					//	Стр = Новый СообщениеПользователю;
					//	Стр.Текст	= "Не заполнена сумма взноса!";
					//	Стр.ПутьКДанным	= "СуммаВзноса; Стр.Сообщить();
					//КонецЕсли;	
				//КонецЕсли;	
				
				ПроверятьНовые = ВладелецФормыДата > '20131001'; //1 октября
				Если ПроверятьНовые Тогда
					Если фФраншиза И Франшиза = 0 Тогда
						Стр = Новый СообщениеПользователю;
						Стр.Текст 	= "Не указана сумма франшизы!";
						Стр.ПутьКДанным = "Франшиза";
