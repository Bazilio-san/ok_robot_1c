	КонецЕсли;
	//ЗаполнитьЗначенияСвойств(Элементы.СостояниеДопСоглашение, Структура);
	//Элементы.СохранитьДопСоглашение.Видимость = ВидимостьКнопкиСохранения;
	// другие документы
	СтрокаТЗ = ТЗ.Найти(Справочники.уб_ВидыДокументовКПолисам.Прочее, "Вид");
	Структура = Новый Структура;
	Структура.Вставить("Картинка");
	Структура.Вставить("Значение");
	Если СтрокаТЗ = Неопределено Тогда
		ВидимостьКнопкиСохранения = Ложь;
		Структура.Картинка = КартинкаКрасная;
