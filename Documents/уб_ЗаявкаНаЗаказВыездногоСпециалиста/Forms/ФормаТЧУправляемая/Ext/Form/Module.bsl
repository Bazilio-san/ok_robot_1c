	//Элементы.нОфициальнаяСкидка.Видимость = ЭтоДК = Ложь;
	//Элементы.ОфициальнаяСкидка.Видимость = ЭтоДК = Ложь;
	Элементы.ПредоставленнаяСкидкаПроцент.Видимость = ЭтоДК = Ложь;
//	Элементы.НадписьПредоставленнаяСкидкаПроцент.Видимость = ЭтоДК = Ложь;
	Элементы.ПредоставленнаяСкидка.Видимость = ЭтоДК = Ложь;
	//Элементы.ПанельБсо.Видимость = ЭтоДК = Ложь;
