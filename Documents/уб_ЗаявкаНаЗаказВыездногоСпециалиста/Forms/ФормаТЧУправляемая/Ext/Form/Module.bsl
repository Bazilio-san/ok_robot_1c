&НаКлиенте
Процедура ПриИзмененииВидаБСО()
		
	Если ВидБСО <> Неопределено Тогда
		ЭтоВидБСО = ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО");
		Если ЭтоВидБСО Тогда
			//ОстатокБСО = уб_temp.ПолучитьОстаткиБСО(СК, ВидБСО);
			//Элементы.ОстатокБСО.Значение = ?(ОстатокБСО <> 0, ""+//"Остаток: " +
			//ОстатокБСО + " шт.", "");
			ТекВидБСО = Нрег(Строка(ВидБСО));
			ЭтоОСАГО = Найти(ТекВидБСО, "осаго") <> 0 и Найти(ТекВидБСО, "карта суперосаго") = 0 и Найти(ТекВидБСО, "е-осаго") = 0;
			ЭтоКАСКО = Найти(ТекВидБСО, "каско") <> 0;
			ПриВыбореВидаБСО = ВидБСО.ПриВыбореВидаБСО;
			
			Если Не ПустаяСтрока(ПриВыбореВидаБСО) Тогда
				
				Страхователь = ДокументСтрахователь;
				ЭтоЮрлицо = ТипЗнч(Страхователь)= Тип("СправочникСсылка.Контрагенты") ИЛИ Найти(Страхователь,"ООО")>0 ИЛИ Найти(Страхователь,"Общество")>0;
				Попытка
					Отказ = Ложь;
					
					Выполнить(ПриВыбореВидаБСО);
					
					Если Отказ = Истина Тогда
						Возврат;
					КонецЕсли;	
					
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
			КонецЕсли;	
			ЭтоЕОсаго = ТекВидБСО="е-осаго"; 
		Иначе
			//Элементы.ОстатокБСО.Значение = "";
			ЭтоОСАГО  = ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ОСАГО") или ВидБСО = ПредопределенноеЗначение("Перечисление.уб_ВидыСтраховыхПродуктов.ЕОСАГО");
