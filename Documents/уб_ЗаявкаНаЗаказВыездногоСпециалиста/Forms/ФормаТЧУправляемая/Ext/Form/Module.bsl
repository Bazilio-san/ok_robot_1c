&НаКлиенте
Процедура СКПриИзменении(Элемент)
	Если ПриИзмененииСК() Тогда
		ПриИзмененииВидаБСО();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция  ПриИзмененииСК()
	ОбновилсяВидБСО = ЛОжь;
	
	эфВидБСО = Элементы.ВидБСО;
	Если СК.Пустая() Тогда
		эфВидБСО.ТолькоПросмотр		= Истина;
		эфВидБСО.КнопкаСпискаВыбора = Ложь;
	Иначе
		//Если СтарыйКод Тогда
		//	СВ = уб_СЛ.ПолучитьСписокВидовБСО(СК,,,, Истина);
		//	Если СВ.Количество() > 0 Тогда
		//		эфВидБСО.СписокВыбора 		= СВ;
		//	Иначе
		//		эфВидБСО.КнопкаСпискаВыбора = Ложь;
		//	КонецЕсли;
		//КонецЕсли;
		эфВидБСО.КнопкаСпискаВыбора = Истина;
		эфВидБСО.ТолькоПросмотр		= Ложь;
	КонецЕсли;
	Если СК <> _СК Тогда
		ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов.ПустаяСсылка();//Справочники.уб_ВидыБСО.ПустаяСсылка();
		ОбновилсяВидБСО = Истина;
		//ПриИзмененииВидаБСО();
	ИначеЕсли ТипЗнч(ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО")
		и ЗначениеЗаполнено(ВидБСО)
		и ДокументДата>=Дата(2024,6,1) Тогда
		Попытка
			_ВидБСО = Перечисления.уб_ВидыСтраховыхПродуктов[Строка(ВидБСО)];
			ВидБСО = _ВидБСО;
			ОбновилсяВидБСО = Истина;
		Исключение
		КонецПопытки;	
		
	КонецЕсли;
	_СК = СК;
	
	Элементы.Поставщик.СписокВыбора.ЗагрузитьЗначения(уб_КЭШируемые.СписокПоставщиков(СК));
	
	Если Элементы.Поставщик.СписокВыбора.НайтиПоЗначению(Поставщик) = Неопределено Тогда
		Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	ВсегоПоставщиков = Элементы.Поставщик.СписокВыбора.Количество();
	Если ВсегоПоставщиков=1 Тогда
		
		Если Поставщик.Пустая() Тогда
			Поставщик = Элементы.Поставщик.СписокВыбора[0].Значение;
		Иначе	
			
		КонецЕсли;
	ИначеЕсли ВсегоПоставщиков = 0  Тогда
		Поставщик = СК;
	КонецЕсли;
	//Скрыли поставщика
	Если  ЗначениеЗаполнено(Поставщик) = ЛОЖЬ Тогда
		Поставщик = СК;
	КонецЕсли;	
	ОбновилсяВидБСО = ПоставщикПриИзмененииНаСервере(Элементы.Поставщик) или ОбновилсяВидБСО ;
	
	Элементы.Поставщик.ЦветТекста = ?(Поставщик = СК, Новый Цвет(0,128,0), Новый Цвет(0,0,255)); 
	
	Возврат ОбновилсяВидБСО;
	
КонецФункции

&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)
	Если ПоставщикПриИзмененииНаСервере(Элемент) = Истина Тогда
		ПриИзмененииВидаБСО();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПоставщикПриИзмененииНаСервере(Элемент)
	ОбновилсяВидБСО = ЛОЖЬ;
	УстановитьПривилегированныйРежим(Истина);
			Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СК",СК);
		Запрос.УстановитьПараметр("Поставщик",Поставщик);
		
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	влож.ВидСП,
		               |	влож.ВидСПСтрока,
		               |	влож.ОрганизацияАгент
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		КонтрагентыВидыСП.ВидСП КАК ВидСП,
		               |		ПРЕДСТАВЛЕНИЕ(КонтрагентыВидыСП.ВидСП) КАК ВидСПСтрока,
		               |		КонтрагентыВидыСП.Организация КАК ОрганизацияАгент
		               |	ИЗ
		               |		Справочник.Контрагенты.ВидыСП КАК КонтрагентыВидыСП
		               |	ГДЕ
		               |		КонтрагентыВидыСП.Ссылка = &Поставщик) КАК влож";
		Запрос.УстановитьПараметр("ДатаПроверки",Дата(2023,3,1));//ТекущаяДата()-90*3600*24);
		
		СписокВидовБСО    = Новый Массив;
		СписокОрганизаций = Новый Массив;
		ВидыСП = Запрос.Выполнить().Выгрузить();
		ВидыСП.Сортировать("ВидСПСтрока");
		Для каждого Выборка из ВидыСП Цикл
			Если ЗначениеЗаполнено(Выборка.ОрганизацияАгент) Тогда
				Если СписокОрганизаций.Найти(Выборка.ОрганизацияАгент)= Неопределено Тогда
					СписокОрганизаций.Добавить(Выборка.ОрганизацияАгент);
				КонецЕсли;	
			КонецЕсли;
			//ОрганизацияАгент = Выборка.ОрганизацияАгент;
			Если ЗначениеЗаполнено(Выборка.ВидСП) Тогда
				Если СписокВидовБСО.Найти(Выборка.ВидСП)= Неопределено Тогда
					СписокВидовБСО.Добавить(Выборка.ВидСП);
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
		
		Если СписокВидовБСО.Количество() = 0 Тогда
			Для каждого Значение из Метаданные.Перечисления.уб_ВидыСтраховыхПродуктов.ЗначенияПеречисления Цикл
				НовоеЗначение = Перечисления.уб_ВидыСтраховыхПродуктов[Значение.Имя];
				Если СписокВидовБСО.Найти(НовоеЗначение) = Неопределено Тогда
					СписокВидовБСО.Добавить(НовоеЗначение);
				КонецЕсли;	
			КонецЦикла;				
		КонецЕсли;
		
		//Если СписокВидовБСО.Количество() = 0 Тогда
		//	Предупреждение("Не обнаружено поступления бланков или денег для выбранного поставщика в последние 3 месяца",5);
		//Иначе
		Если СписокВидовБСО.Количество() = 1 Тогда
			ВидБСО = СписокВидовБСО[0];
			ОбновилсяВидБСО = Истина;
			
		КонецЕсли;	
		Элементы.ВидБСО.СписокВыбора.ЗагрузитьЗначения(СписокВидовБСО);
		Если СписокОрганизаций.Количество()>0 Тогда
			Элементы.ОрганизацияАгент.СписокВыбора.ЗагрузитьЗначения(СписокОрганизаций);
		КонецЕсли;	
		Если СписокОрганизаций.Количество()=1 Тогда
			Если ЗначениеЗаполнено(ОрганизацияАгент) = ЛОЖЬ Тогда
				ОрганизацияАгент = СписокОрганизаций[0];
			КонецЕсли;
			Элементы.ОрганизацияАгент.ТолькоПросмотр = Истина;
		Иначе
			Элементы.ОрганизацияАгент.ТолькоПросмотр = ЛОЖЬ;
		КонецЕсли;	
		//Если ЗначениеЗаполнено(ВидБСО) Тогда
		//	Если СписокВидовБСО.Найти(ВидБСО) = Неопределено Тогда
		//		//Предупреждение("Данный вид БСО не приходил от этого поставщика и не было приемок денег в последние 3 месяца",5);
		//		Элементы.ВидБСО.Картинка = БиблиотекаКартинок.уб_ОплатаВопрос;
		//	Иначе
		//		Элементы.ВидБСО.Картинка = Новый Картинка;
		//	КонецЕсли;	
		//Иначе
		//	Элементы.Поставщик.Картинка = Новый Картинка;
		//КонецЕсли;	
		
		
	Элементы.Поставщик.ЦветТекста = ?(Поставщик = СК, Новый Цвет(0,128,0), Новый Цвет(0,0,255)); 
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ОбновилсяВидБСО;
КонецФункции

