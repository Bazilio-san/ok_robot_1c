Процедура ИнициализироватьСписки() 
	
	Элементы.СК.СписокВыбора.ЗагрузитьЗначения(уб_СЛ.ПолучитьСписокСК().ВыгрузитьЗначения());
	
	
	Элементы.ОрганизацияАгент.СписокВыбора.ЗагрузитьЗначения(уб_СЛ.ПолучитьСписокОрганизаций().ВыгрузитьЗначения());
	
	СЗ = Элементы.Состояние.СписокВыбора;
	Для каждого Эл из Перечисления.уб_СостояниеОформления Цикл
		
		
		Если Эл = Перечисления.уб_СостояниеОформления.КомплектОформлен 
			Тогда
			//Если ЭтоОтделБСО Тогда
			//Иначе
			Продолжить;
			//КонецЕсли;			
		ИначеЕсли Эл = Перечисления.уб_СостояниеОформления.Отказ Тогда
			Если уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПравоУстанавливатьОтказВСтрокеЗаявки, Ложь) = ЛОЖЬ Тогда
				Продолжить
			КонецЕсли;	
		Иначе
			//Продолжить;
		КонецЕсли;	
		
		СЗ.Добавить(Эл);
		
	КонецЦикла;	
