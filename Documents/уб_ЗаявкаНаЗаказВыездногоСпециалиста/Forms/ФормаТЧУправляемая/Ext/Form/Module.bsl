Процедура ПредоставленнаяСкидкаПроцентПриИзменении(Элемент)
	РасчетСкидки();
	//ПроверитьВыполнениеУсловийСвязанныхБСО();
	НастройкиПолей(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПредоставленнаяСкидкаПриИзменении(Элемент)
	ФактСуммаВзноса = ?(ОфициальнаяСкидка="Да",СуммаВзноса/(1-ПредоставленнаяСкидкаПроцент/100),СуммаВзноса);
	ПредоставленнаяСкидкаПроцент = ?(ФактСуммаВзноса <> 0, ПредоставленнаяСкидка * 100 / ФактСуммаВзноса, 0);
	ПроверитьВыполнениеУсловийСвязанныхБСО();
	НастройкиПолей();

КонецПроцедуры


&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	Если уб_СЕРВЕРные.ПроверкаДат(ДатаНачала,Аддендум) = ЛОЖЬ Тогда
		Если Аддендум = ЛОЖЬ Тогда
			ДатаНачала = ТекущаяДата();
		КонецЕсли;	
		ПоказатьПредупреждение(,"Проверьте дату начала");
	КонецЕсли;	
	ДатаОкончания = Дата(Год(ДатаНачала)+1,Месяц(ДатаНачала),День(ДатаНачала))-1;

КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	РазностьДней = (ДатаОкончания-ДатаНачала)/(3600*24);
	Если РазностьДней<0 или ДатаОкончания = Дата(1,1,1) 
		или РазностьДней>365
		или РазностьДней<28
		Тогда
		ДатаОкончания = Дата(Год(ДатаНачала)+1,Месяц(ДатаНачала),День(ДатаНачала))-1;
		
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура МаркаТСПриИзменении(Элемент)
	Если уб_ВызовСервера.ЗначениеРеквизитаОбъекта(МодельТС,"Владелец") <> МаркаТС Тогда
