&НаСервере
Процедура Фильтр() Экспорт
	СтруктурыФильтра = Новый Массив;
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Менеджер",          эуПоискМенеджер,           Неопределено, НЕ эуПоискМенеджер.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Курьер",            эуПоискКурьер,             Неопределено, НЕ эуПоискКурьер.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Номер",      _Число(эуПоискНомер),      Неопределено, НЕ ПустаяСтрока(эуПоискНомер)));
	Если ТипЗнч(эуПоискНомерЗаявки) = Тип("Строка") Тогда 
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","НомерЗаявки",_Число(эуПоискНомерЗаявки),Неопределено, НЕ ПустаяСтрока(эуПоискНомерЗаявки)));
	Иначе
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","НомерЗаявки",эуПоискНомерЗаявки,Неопределено, ЗначениеЗаполнено(эуПоискНомерЗаявки)));
	КонецЕсли;	
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","БСО.СК",эуСК,Неопределено,НЕ эуСК.Пустая()));
	
	Если СтрДлина(эуПоискСтрахователь)>=3 Тогда
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  уб_ВызовСервера.СтрахователиПоНаименованию(эуПоискСтрахователь),
		                                                                                                            ВидСравненияКомпоновкиДанных.ВСписке, НЕ ПустаяСтрока(эуПоискСтрахователь)));
		//СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","СтраховательНаименование", эуПоискСтрахователь, ВидСравненияКомпоновкиДанных.Содержит,НЕ ПустаяСтрока(эуПоискСтрахователь)));
	Иначе
		
		//Отключаем
		СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  эуПоискСтрахователь,ВидСравненияКомпоновкиДанных.ВСписке,ЛОЖЬ));
		//СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","СтраховательНаименование",  эуПоискСтрахователь,ВидСравненияКомпоновкиДанных.Содержит,ЛОЖЬ));
	КонецЕсли;	

	//Если СтрДлина(эуПоискСтрахователь)>=3 Тогда
	//	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  уб_ВызовСервера.СтрахователиПоНаименованию(эуПоискСтрахователь),
	//	                                                                                                            ВидСравненияКомпоновкиДанных.ВСписке, НЕ ПустаяСтрока(эуПоискСтрахователь)));
	//Иначе
	//	//Отключаем
	//	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Страхователь",  эуПоискСтрахователь,ВидСравненияКомпоновкиДанных.Равно,ЛОЖЬ));
	//КонецЕсли;	
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","Тип",               эуПоискТипВыезда, Неопределено, НЕ эуПоискТипВыезда.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","БСО.ФормаОплатыСтрока",       эуФормаОплаты,    Неопределено, НЕ эуФормаОплаты.Пустая()));
	СтруктурыФильтра.Добавить(Новый Структура("ИмяПоля,Значение,ВидСравнения,Использование","БСО.ВидБСО",        эуПоискВидСП,     Неопределено, НЕ эуПоискВидСП.Пустая()));
	
	уб_ФормыВызовСервера.УстановитьОтборыСписка(ЭтаФорма.Список,СтруктурыФильтра);
КонецПроцедуры	

