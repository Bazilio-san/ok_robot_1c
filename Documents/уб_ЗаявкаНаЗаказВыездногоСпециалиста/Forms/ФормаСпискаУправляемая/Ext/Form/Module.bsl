		ОбновитьСпискиВыбора();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СтараяФорма(Команда)
	ОткрытьФорму("Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.Форма.ФормаСписка",Новый Структура("РежимВыбора",ЛОЖЬ));
КонецПроцедуры

&НаКлиенте
Процедура эуПоискНомерАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если Найти(Текст,Символы.НПП)>0 Тогда
		Текст = СтрЗаменить(Текст,Символы.НПП,"")
	КонецЕсли;	
	Если Найти(Текст," ")>0 Тогда
		Текст = СтрЗаменить(Текст," ","");
	КонецЕсли;	
	Если СтрДлина(Текст) = 6 Тогда
		эуПоискНомер = Текст;
		Фильтр();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура эуПоискНомерЗаявкиАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 5 Тогда
		эуПоискНомерЗаявки = Текст;
		Фильтр();
	КонецЕсли;	
КонецПроцедуры






