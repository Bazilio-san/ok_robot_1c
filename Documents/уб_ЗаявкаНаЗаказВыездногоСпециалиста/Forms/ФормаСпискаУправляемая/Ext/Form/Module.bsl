&НаСервере
Процедура ИнициализацияФормы()
	ОбновитьСпискиВыбора();
	
	Если Параметры.РежимВыбора Тогда
		ЭтаФорма.ЗакрыватьПриВыборе = Истина;
		//скрываем колонки
		
		Элементы.ВремяНачало.Видимость		= Ложь;
		Элементы.ВремяВстречи.Видимость  	= Ложь;
		Элементы.ВремяОкончания.Видимость   = Ложь;
		Элементы.СтатусЗаявки.Видимость			= Ложь;
	КонецЕсли;
	
	НовыйПараметр = Новый ПараметрВыбора("ЭтоСотрудник", Истина);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы.эуПоискМенеджер.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСпискиВыбора()
	
	Запрос  = Новый Запрос;
	РасчетныйПериод = ТекущаяДата();//НачалоМесяца(ТекущаяДата())-1;
	Запрос.УстановитьПараметр("ДатаНач",НачалоМесяца(РасчетныйПериод));					   
	Запрос.УстановитьПараметр("ДатаКон",КонецМесяца(ТекущаяДата()));					   
	
	ЭтоПолныеПрава = Ложь;
	Если уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") 
		или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.КураторВыездных, Ложь) 
		или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПросмотрВсехПолисовИЗаявок, Ложь) 
