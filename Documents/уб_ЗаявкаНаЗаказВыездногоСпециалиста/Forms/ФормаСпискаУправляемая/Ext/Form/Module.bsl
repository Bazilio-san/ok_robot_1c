		|ГДЕ
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= &ДатаНач
		|	И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата <= &ДатаКон
		|	И (НЕ уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПометкаУдаления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Менеджер.Наименование";
		СписокМенеджеров = Новый СписокЗначений;
		СписокМенеджеров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Менеджер");
	Иначе
		СписокМенеджеров = ПодчиненныеРуководителя.ВыгрузитьЗначения(); 
		///Запрос.Текст = "ВЫБРАТЬ Разрешенные
		//|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка КАК Ссылка
		//|ИЗ
		//|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		//|ГДЕ
		//|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер В(&Менеджер)
		//|   или уб_ЗаявкаНаЗаказВыездногоСпециалиста.Менеджер.Преемник  В(&Менеджер)
		//|	ИЛИ уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер В(&Менеджер)";
		//Запрос.УстановитьПараметр("Менеджер",СписокМенеджеров);
		//ДоступныеЗаявки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		//Если ЭтоПолныеПрава = Ложь Тогда
		//	СтруктурыФильтра = Новый Массив;
