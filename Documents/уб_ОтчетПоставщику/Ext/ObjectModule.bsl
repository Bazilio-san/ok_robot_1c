Перем ПоставщикДляОтчетаПоКарточкам;

Функция ПолучитьИмяРевизитаОтбора(ЗначениеПоставщик) Экспорт
	Возврат ?(ЗначениеПоставщик = ПараметрыСеанса.уб_Константы.ПоставщикДляОтчетаПоКарточкам, "ОтчетПоКарточкам","ОтчетПоставщику")
КонецФункции

Процедура ПодборГраницПериодаОтчета() Экспорт
	
	ТЗОплат = уб_ПФ.ОП_ПолучитьТЗОплат(Новый Структура("Объект", ЭтотОбъект));
	Если НачалоОтчетногоПериода = Дата(1,1,1) Тогда	
		НачалоОтчетногоПериода = ДобавитьМесяц(Дата, -1); 
	КонецЕсли;	
	Если КонецОтчетногоПериода = Дата(1,1,1) Тогда	
		КонецОтчетногоПериода = Дата;
	КонецЕсли;		
	Для Каждого оОплата из ТЗОплат Цикл
		Если оОплата.Дата < НачалоОтчетногоПериода Тогда
			НачалоОтчетногоПериода = оОплата.Дата;
		КонецЕсли;	
		Если оОплата.Дата > КонецОтчетногоПериода Тогда
			КонецОтчетногоПериода = оОплата.Дата;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверкаЗаполнения()
	
	СтатусСооб = СтатусСообщения.Важное;		
	Рез = Истина;
	Если ЗначениеНеЗаполнено(Номер) Тогда 
		УстановитьНовыйНомер();
	КонецЕсли; 
	Если ЗначениеНеЗаполнено(Дата) Тогда 
		Дата = ТекущаяДата();
	КонецЕсли; 
	Если ЗначениеНеЗаполнено(НачалоОтчетногоПериода) ИЛИ ЗначениеНеЗаполнено(КонецОтчетногоПериода) Тогда 
		ПодборГраницПериодаОтчета();
	КонецЕсли; 
	Если ЗначениеНеЗаполнено(ОрганизацияАгент) Тогда 
		Если Не Проведен Тогда
			oАг = уб_СС.ПолучКонтрагентаИлиФизлицоПоПльзователю(ПараметрыСеанса.ТекущийПользователь);
			Если oАг <> Неопределено Тогда
				ОрганизацияАгент = oАг;
			КонецЕсли;
		КонецЕсли; 
		Если ЗначениеНеЗаполнено(ОрганизацияАгент) Тогда 
			Сообщить("Не заполнено поле 'Организация агент'!",СтатусСооб);
			Рез = Ложь;
		КонецЕсли;
	КонецЕсли; 
	//Если ОтветственныйБСО.Пустая() Тогда 
	//	Если Не Проведен Тогда
	//		МОЛпоБСО = уб_КЭШируемые.ПолучитьМОЛпоБСОДляПользователя(ПараметрыСеанса.ТекущийПользователь);
