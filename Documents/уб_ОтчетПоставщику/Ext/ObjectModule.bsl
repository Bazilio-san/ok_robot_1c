// ОБРАБОТЧИКИ СОБЫТИЙ

//SS TODO При проведении проверять, проведены ли квитанции.
// Если не проведены - отказ и уведомление, что надо сначала провести соответствующий страховой полис.

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПравоПроведенияОА = ПравоДоступа("Проведение", Метаданные());
	ДокументОК = ПроверкаЗаполнения();	
	Отказ = НЕ (ДокументОК И ПравоПроведенияОА);	
	Возврат;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Отказ = НЕ ПравоДоступа("ОтменаПроведения", Метаданные());
	Возврат;	

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	#Если Клиент Тогда
		Оповестить("ПриЗаписиОтчетаПоставщику", Проведен, ЭтотОбъект);
	#КонецЕсли	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновитьКоличествоСтрокОплат();
	
	Если ВидОперации.Пустая() Тогда
		ВидОперации = Перечисления.уб_ВидОперацииВзаиморасчетов.ОтчетПоставщику;
	КонецЕсли;	
	
	Если Не Отказ И Не ЭтоНовый() Тогда
		Если ОрганизацияАгент <> Ссылка.ОрганизацияАгент Тогда
			//если изменился орг. агент, то в автооплатах заменить
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	уб_ОплатаПолисов.Ссылка
			|ИЗ
			|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
			|ГДЕ
			|	уб_ОплатаПолисов.ОтчетПоставщику = &ОтчетПоставщику";
			Запрос.УстановитьПараметр("ОтчетПоставщику", Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Массив = Новый Массив;
			Пока Выборка.Следующий() Цикл
				Массив.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			КонецЦикла;	
			ЗапросВзаиморасчетов = Новый Запрос;
			ЗапросВзаиморасчетов.Текст = "ВЫБРАТЬ
			|	уб_ВзаиморасчетСПоставщиком.Ссылка
			|ИЗ
			|	Документ.уб_ВзаиморасчетСПоставщиком КАК уб_ВзаиморасчетСПоставщиком
			|ГДЕ
			|	ВЫРАЗИТЬ(уб_ВзаиморасчетСПоставщиком.IDизБухДок КАК СТРОКА(36)) В (&Массив)";
			ЗапросВзаиморасчетов.УстановитьПараметр("Массив", Массив);
			ВыборкаВзаиморасчетов = ЗапросВзаиморасчетов.Выполнить().Выбрать();
			Пока ВыборкаВзаиморасчетов.Следующий() Цикл
				Объект = ВыборкаВзаиморасчетов.Ссылка.ПолучитьОбъект();
				Объект.ОрганизацияАгент = ОрганизацияАгент;
				Объект.Записать();
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбновитьКоличествоСтрокОплат() Экспорт
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//			   |	КОЛИЧЕСТВО(*) КАК Кол
	//			   |ИЗ
	//			   |	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	//			   |ГДЕ
	//			   |    НЕ уб_ОплатаПолисов.ПометкаУдаления 
	//			   |	И уб_ОплатаПолисов." + ПолучитьИмяРевизитаОтбора(Поставщик) + " = &ОтчетПоставщику";
	//Запрос.УстановитьПараметр("ОтчетПоставщику", ?(ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка));
	//Выборка = Запрос.Выполнить().Выбрать();
	//Выборка.Следующий();
	//Кол = Выборка.Кол;
	//Если КоличествоСтрокОплат <> Кол Тогда
	//	КоличествоСтрокОплат = Кол;
	//КонецЕсли;
	//ПоставщикДляОтчетаПоКарточкам = ПараметрыСеанса.уб_Константы.ПоставщикДляОтчетаПоКарточкам;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Кол
	|ИЗ
	|	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
	|ГДЕ
	|	НЕ уб_ОплатаПолисов.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &Поставщик <> (ВЫРАЗИТЬ(&ПоставщикДляОтчетаПоКарточкам КАК Справочник.Контрагенты))
	|				ТОГДА уб_ОплатаПолисов.ОтчетПоставщику = &ОтчетПоставщику
	|			ИНАЧЕ уб_ОплатаПолисов.ОтчетПоКарточкам = &ОтчетПоставщику
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ОтчетПоставщику", ?(ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка));
	Запрос.УстановитьПараметр("ПоставщикДляОтчетаПоКарточкам",ПоставщикДляОтчетаПоКарточкам);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Кол = Выборка.Кол;
	Если КоличествоСтрокОплат <> Кол Тогда
		КоличествоСтрокОплат = Кол;
	КонецЕсли;
	
КонецПроцедуры

