//СтруктураЗначенийДоИзменения - структура-результат, хранящая прошлые значения реквизитов


Функция ПересчетИтоговМодуль(СтруктураЗначенийДоИзменения = Неопределено,ЕстьИзменения = Ложь) Экспорт

	СтруктураЗначенийДоИзменения = Новый Структура;
	СтруктураЗначенийДоИзменения.Вставить("ИтогОС_НачисленнаяСуммаВзноса",ИтогОС_НачисленнаяСуммаВзноса);
	СтруктураЗначенийДоИзменения.Вставить("ИтогОС_КПеречислениюПоставщику",ИтогОС_КПеречислениюПоставщику);
	СтруктураЗначенийДоИзменения.Вставить("ИтогОС_КВ",ИтогОС_КВ);
	СтруктураЗначенийДоИзменения.Вставить("ИтогОС_КВДоп",ИтогОС_КВДоп);	
	ЕстьИзменения = Ложь;
	Выборка = уб_Взаиморасчеты.ПолучитьСостояниеОтчетаПоставщику(?(ЭтоНовый(), ПолучитьСсылкуНового(), Ссылка),,,Дата, ВидВзаиморасчета, Поставщик);
	Если Выборка.ОтчетПоставщику = Неопределено Тогда//если нет оплат
		//Возврат;
		_ИтогОС_КПеречислениюПоставщику	= 0;
		_ИтогОС_КВСуммаДляОтчета		= 0;
		_ИтогОС_НачисленнаяСуммаВзноса	= 0;
		_ИтогОС_КВДоп		            = 0;
	Иначе
		Если ЗначениеЗаполнено(ДатаСогласования) И Дата < '20130801000000' Тогда
			ЕстьИзменения = Ложь;
			#Если Клиент Тогда
				Предупреждение("Это старый документ, итоги не пересчитываются, пока заполнена дата согласования.");
			#КонецЕсли	
			
			Возврат Выборка;
			//Возврат ПолучитьСостояниеОтчетаПоставщику2(ОтчетПоставщику, ВТ, ИмяВТ, ДатаАктуальностиОтчетов, ВидВзаиморасчетов, Поставщик)
		КонецЕсли;
		_ИтогОС_КПеречислениюПоставщику	= Выборка.Баланс_Брокер_Поставщик;
		_ИтогОС_КВСуммаДляОтчета		= Выборка.КВСуммаДляОтчета;
		_ИтогОС_НачисленнаяСуммаВзноса	= Выборка.НачисленнаяСуммаВзноса;
		_ИтогОС_КВДоп		            = Выборка.ДопКВ;
	КонецЕсли;
	ЗначениеДоИзменения = Неопределено;
	ЕстьИзменения = Макс(УстановитьЗначение(ИтогОС_НачисленнаяСуммаВзноса, _ИтогОС_НачисленнаяСуммаВзноса, ЗначениеДоИзменения), ЕстьИзменения);
	СтруктураЗначенийДоИзменения.ИтогОС_НачисленнаяСуммаВзноса = ЗначениеДоИзменения;
	ЗначениеДоИзменения = Неопределено;
	ЕстьИзменения = Макс(УстановитьЗначение(ИтогОС_КПеречислениюПоставщику, _ИтогОС_КПеречислениюПоставщику, ЗначениеДоИзменения), ЕстьИзменения);
	СтруктураЗначенийДоИзменения.ИтогОС_КПеречислениюПоставщику = ЗначениеДоИзменения;
	ЗначениеДоИзменения = Неопределено;
	ЕстьИзменения = Макс(УстановитьЗначение(ИтогОС_КВ, _ИтогОС_КВСуммаДляОтчета, ЗначениеДоИзменения), ЕстьИзменения);
	СтруктураЗначенийДоИзменения.ИтогОС_КВ = ЗначениеДоИзменения;
	ЗначениеДоИзменения = Неопределено;
	ЕстьИзменения = Макс(УстановитьЗначение(ИтогОС_КВДоп, _ИтогОС_КВДоп, ЗначениеДоИзменения), ЕстьИзменения);
	СтруктураЗначенийДоИзменения.ИтогОС_КВДоп = ЗначениеДоИзменения;
	Возврат Выборка;

КонецФункции

