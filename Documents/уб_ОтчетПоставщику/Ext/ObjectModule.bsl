Функция ПолучитьСтруктуруФормы(ФормаДокумента) Экспорт
	
	СтруктураФормы = Новый Структура("Ссылка",Ссылка);
	Элементы = ФормаДокумента.ЭлементыФормы;
	Для Каждого Элем из Элементы Цикл
		Если ТипЗнч(Элем) = Тип("ПолеВвода") или ТипЗнч(Элем) = Тип("ТабличноеПоле") Тогда
			СтруктураФормы.Вставить(Элем.Имя,Элем.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураФормы;
	
КонецФункции

