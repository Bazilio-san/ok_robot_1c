Функция ПолучитьИтогиВзаиморасчетов(ОтчетыПоставщику) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Взаиморасчет.Ссылка.Поставщик КАК Поставщик,
	               |	Взаиморасчет.Ссылка.ОрганизацияАгент КАК ОргАгент,
	               |	Взаиморасчет.Ссылка.ФормаОплаты КАК ФормаОплаты,
	               |	Взаиморасчет.Ссылка.СуммаДокумента КАК СуммаДокумента,
	               |	Взаиморасчет.Ссылка.НаправлениеРасчетов КАК НаправлениеРасчетов,
	               |	ВЫБОР
	               |		КОГДА Взаиморасчет.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПоступлениеКВОтПоставщика)
	               |			ТОГДА Взаиморасчет.Сумма
	               |	КОНЕЦ КАК СуммаКВ,
	               |	ВЫБОР
	               |		КОГДА Взаиморасчет.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщику)
	               |				ИЛИ Взаиморасчет.Ссылка.НаправлениеРасчетов = ЗНАЧЕНИЕ(Перечисление.уб_ВидОперацииВзаиморасчетов.ПеречислениеПоставщикуСтрахователем)
	               |			ТОГДА Взаиморасчет.Сумма
	               |	КОНЕЦ КАК ЗадолженностьПередПоставщиком,
	               |	Взаиморасчет.Ссылка.ДокументБух,
	               |	Взаиморасчет.Ссылка.НомерВходящегоДокумента КАК ВходящийНомер,
	               |	Взаиморасчет.Ссылка.ДатаВходящегоДокумента КАК ВходящийДата,
	               |	Взаиморасчет.Ссылка КАК ВзаиморасчетСПоставщиком,
	               |	Взаиморасчет.Сумма,
	               |	ВЫБОР
	               |		КОГДА Взаиморасчет.Ссылка.ИсключитьИзВзаиморасчетов
	               |			ТОГДА ИСТИНА
	               |		КОГДА НЕ Взаиморасчет.Ссылка.Проведен
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ИсключитьИзВзаиморасчетов,
	               |	Взаиморасчет.Ссылка.Дата КАК Дата,
	               |	ЕСТЬNULL(Взаиморасчет.Ссылка.Контрагент.ДатаВеденияВзаиморасчётов, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВеденияВзаиморасчётов,
	               |	ВЫБОР
	               |		КОГДА Взаиморасчет.Ссылка.Контрагент.ОсновнойДоговорКонтрагента.ВидВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.СудержаниемКВ)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК СУдержанием,
	               |	Взаиморасчет.ОтчетПоставщику
	               |ИЗ
	               |	Документ.уб_ВзаиморасчетСПоставщиком.Распределение КАК Взаиморасчет
	               |ГДЕ
	               |	Взаиморасчет.ОтчетПоставщику В(&ОтчетыПоставщику)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Взаиморасчет.Ссылка.МоментВремени";
	Запрос.УстановитьПараметр("ОтчетыПоставщику",ОтчетыПоставщику);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	