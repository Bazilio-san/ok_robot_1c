Функция УстановитьНомерВзноса() Экспорт
	
	//В Выборка оплаты расположены в порядке возрастания даты
	ТзОплат = уб_СС.ОП_ПолучитьТзОплат(СтраховойПолис);
	Если ТзОплат.Количество() = 0 Тогда
		Возврат УстЗнч("НомерВзноса", 1);
	КонецЕсли;	
	НомерВзноса_ = 0;
	Для Каждого оОплата из ТзОплат Цикл
		НомерВзноса_ = НомерВзноса_ + 1;
		Если оОплата.Ссылка = Ссылка Тогда
			Прервать;
		КонецЕсли;
		Если лАктуальныйПериод < оОплата.Дата Тогда
			НомерВзноса_ = НомерВзноса_ - 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Возврат УстЗнч("НомерВзноса", НомерВзноса_);
	
КонецФункции

Процедура ОбновитьНачисленнуюСуммуВзноса(Знач БезВопросов = Истина) Экспорт
	
	Если НачисленнаяСуммаВзносаВВалюте = 0 Тогда
		Возврат;	
	КонецЕсли;
	Новая_НачисленнаяСуммаВзноса = Окр(НачисленнаяСуммаВзносаВВалюте * Курс, 2);	
	Если Новая_НачисленнаяСуммаВзноса <> НачисленнаяСуммаВзноса Тогда
		#Если Клиент Тогда
			Заг = "Изменилась сумма взноса в рублях";
			СОО = "Внимание! Новая сумма вноса без скидок в рублях (" + Новая_НачисленнаяСуммаВзноса + "),
			  |расчитанная по курсу на день оплаты отличается от указанной (" + НачисленнаяСуммаВзноса + ").
			  |
			  |Изменить сумму взноса в рублях на расчетную?";
			Если КодВозвратаДиалога.Да = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг) Тогда
				БезВопросов = Истина
			КонецЕсли;
		#КонецЕсли
		Если БезВопросов Тогда
			УстЗнч("НачисленнаяСуммаВзноса", Новая_НачисленнаяСуммаВзноса, , Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьКурс(Знач БезВопросов = Истина) Экспорт
	
	//УстЗнч("Валюта", ?(СтраховойПолис.Пустая(),мВалютаРегл,СтраховойПолис.ВалютаДокумента),, Истина);
	Если мВалютаРегл = Валюта Тогда
		УстЗнч("Курс", 1,, Истина);
	Иначе		
		СтруктураКурса = ОбщегоНазначения.ПолучитьКурсВалюты(Валюта, Дата);
		Новый_Курс = ?(СтруктураКурса.Курс = 0, 1, СтруктураКурса.Курс);
		Если Новый_Курс <> Курс Тогда
			#Если Клиент Тогда
				Заг = "Изменился курс валюты";
				СОО = "Внимание! Новый курс валюты (" + Валюта + "): " + Новый_Курс + ",
					|полученный на день оплаты отличается от текущего (" + Курс + ").
					|
				  	|Обновить курс?";
				Если КодВозвратаДиалога.Да = Вопрос(СОО, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да, Заг) Тогда
					БезВопросов = Истина
				КонецЕсли;
			#КонецЕсли
			Если БезВопросов Тогда
				УстЗнч("Курс", Новый_Курс,, Истина);
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры


Процедура Подсветить(Элемент, бПодсветить, Критичность = 3) Экспорт // Критичность - от 0 до 3
	
	чсл = 255 - (255/3 * Критичность);
	ЦветПодсветки = Новый Цвет(255,255,чсл);
	гЦветАвто = Новый Цвет();
	Если ТипЗнч(Элемент) = Тип("Надпись") Тогда
		Элемент.ЦветФона = ?(бПодсветить,ЦветПодсветки,гЦветАвто);
	ИначеЕсли ТипЗнч(Элемент) = Тип("ПолеВвода") Тогда
		Элемент.ЦветФона = ?(бПодсветить,ЦветПодсветки,гЦветАвто);
		Элемент.ЦветФонаПоля = ?(бПодсветить,ЦветПодсветки,гЦветАвто);
	КонецЕсли;
	Элемент.ЦветТекста = ?(бПодсветить,Новый Цвет(255,0,0),гЦветАвто);
КонецПроцедуры


//++Расчеты
Функция ЗарегистрироватьРасчеты(Выборка =Неопределено) Экспорт
	
	Если Выборка = Неопределено Тогда 
		Выборка = СтраховойПолис;
	КонецЕсли;
	ТаблицаРасчетов = СобратьРасчеты(Выборка);
	ЕстьИзменения = Ложь;
	НовыеРасчеты = уб_Взаиморасчеты.СравнитьСкорректироватьТаблицу(РасчетыПоДокументу.Выгрузить(),ТаблицаРасчетов,ЕстьИзменения,"Вид,УидСтроки,Уточнение");
	Если ЕстьИзменения = Истина Тогда
		РасчетыПоДокументу.Загрузить(НовыеРасчеты);
	КонецЕсли;	
	
КонецФункции

Функция СобратьРасчеты(Выборка)
	СсылкаДокумента = ?(ЭтоНовый(),ПолучитьСсылкуНового(),Ссылка);
	НомерПолиса = СокрЛП(Выборка.Номер);
	ТаблицаРасчетов = РасчетыПоДокументу.Выгрузить();
	ТаблицаРасчетов.Очистить();
	Для каждого СтрокаБСО  из УслугиПоДокументу Цикл
		уб_Взаиморасчеты.ПроверитьСтроку(СтрокаБСО);
		Если СтрокаБСО.СхемаОплаты = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль 
			ИЛИ	СтрокаБСО.СхемаОплаты  = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ
			ИЛИ (СтрокаБСО.СхемаОплаты = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПустаяСсылка() 
			и СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ) Тогда
			ПлановаяСтоимость = СтрокаБСО.Себестоимость;
			Разница = СтрокаБСО.Сумма-ПлановаяСтоимость;
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ОтКлиентаПрочее;
			СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
			СтрокаР.Уточнение     = СтрокаБСО.Вид;
			СтрокаР.СуммаКлиент   = СтрокаБСО.Сумма;
			СтрокаР.СуммаМенеджер = 0;
			СтрокаР.СуммаБрокер   = ПлановаяСтоимость;//Часть брокера   
			
			//++ ОТЛИЧИЕ ++
			Если СтрокаБСО.СхемаОплаты = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ВаловаяПрибыль  Тогда
				_Вид  = Справочники.уб_ВидыРасчетныхОпераций.НачислениеВМ;  //Сразу менеджеру
				ВМ   = Разница;
			Иначе 
				_Вид           = Справочники.уб_ВидыРасчетныхОпераций.НачислениеСКВ; //Часть от СКВ менеджеру
				ВМ   = 0;
			КонецЕсли;	
			УстЗнч("ВМ",ВМ,,,СтрокаБСО);
			
			Если СтрокаБСО.СхемаОплатыРОП= ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПроцентОтСебестоимости Тогда
				_ВидВР  = Справочники.уб_ВидыРасчетныхОпераций.НачислениеРОП; //Руковоодителю
				ПараметрыСотрудника = уб_СС.СтруктураПараметровФункцииПодчиненныеРуководителяПоУмолчанию();
				ПараметрыСотрудника.ВключаяВыбывших		= Истина;
				ПараметрыСотрудника.ТолькоТочкиПродаж		= Истина;
				//ПараметрыСотрудника.СотрудникиПоДокументу = СписокСотрудниковДляДокумента();
				уб_СС.ПодчиненныеРуководителя(Агент,, ПараметрыСотрудника);
				
				РуководительСотрудника = ПараметрыСотрудника.РуководительСотрудника;
				Если ЗначениеЗаполнено(РуководительСотрудника) Тогда
					ПроцентРОП = уб_РасчетыСМенеджерами.ПолучитьПараметрРасчетаЗП("ПроцентРОПСебестоимость"+ПараметрыСотрудника.ПодразделениеСотрудника,РуководительСотрудника,ЗарплатныйПериод,0);
					ВР = Окр(ПлановаяСтоимость*ПроцентРОП/100,2);
				Иначе
					ВР  = 0;	
				КонецЕсли;
				
				
			Иначе 
				_ВидВР           = Справочники.уб_ВидыРасчетныхОпераций.НачислениеСКВ; //Часть от СКВ менеджеру
				ВР  = 0;
				РуководительСотрудника = Справочники.ФизическиеЛица.ПустаяСсылка(); 
			КонецЕсли;	
			УстЗнч("ВР",ВР,,Истина,СтрокаБСО);
			
			//-- ОТЛИЧИЕ --
			Если ВМ >0 Тогда
				СтрокаР = ТаблицаРасчетов.Добавить();
				СтрокаР.Вид = _Вид;
				СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
				СтрокаР.Уточнение     = СтрокаБСО.Вид;
				СтрокаР.СуммаКлиент   = 0;
				СтрокаР.СуммаМенеджер = ВМ;//Разница;
				СтрокаР.СуммаБрокер   = 0;
				СтрокаР.СуммаБрокерВС = 0;
			КонецЕсли;
			
			Если ВР >0 и ЗначениеЗаполнено(РуководительСотрудника) Тогда
				СтрокаР = ТаблицаРасчетов.Добавить();
				СтрокаР.Вид = _ВидВР;
				СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
				СтрокаР.Уточнение     = РуководительСотрудника;
				СтрокаР.СуммаКлиент   = 0;
				СтрокаР.СуммаМенеджер = ВР;//Разница;
				СтрокаР.СуммаБрокер   = ПлановаяСтоимость;
				СтрокаР.СуммаБрокерВС = 0;
			КонецЕсли;

			
		КонецЕсли;
	КонецЦикла;
	Если НачисленнаяСуммаВзноса<>0 Тогда
		СтрокаР = ТаблицаРасчетов.Добавить();
		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.НачислениеСтраховогоВзноса;
		СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
		СтрокаР.Уточнение     = НомерПолиса;
		СтрокаР.СуммаКлиент   = НачисленнаяСуммаВзноса;
		СтрокаР.СуммаМенеджер = 0;
		СтрокаР.СуммаБрокер   = 0;//Часть брокера   
	КонецЕсли;
	ЭтоПоАВ = СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ;//ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ; 
	Если АВилиСкидкаСумма<>0 Тогда
		Если ЭтоПоАВ Тогда
			//Допустимы 3 варианта                                 АВ                    СКИДКА
			//1. Менеджер полностью забрал АВ сразу        АВилиСкидкаСумма                 0
			//2. Менеджер полностью забрал АВ позднее      КВАгента-АВилиСкидкаСумма   АВилиСкидкаСумма
			//3. Эта сумма частично скидка, частично АВ    КВАгента-АВилиСкидкаСумма   АВилиСкидкаСумма
			//4. Менеджеру АВ идет в момент выплаты ЗП     КВАгента-АВилиСкидкаСумма   АВилиСкидкаСумма
			//Расчетная скидка
			АВилиСкидкаСуммаРасчетное = Окр(НачисленнаяСуммаВзноса+СуммаДоп - ОплаченоФакт,2);
			АВСумма  = КВСуммаДляАгента-КВСуммаУдержания-АВилиСкидкаСуммаРасчетное;
			Брокеру  = КВСумма-КВСуммаДляАгента;
			Если АВилиСкидкаСуммаРасчетное<>0 Тогда
				//Недосданная сумма
				//принимаем это всегда скидкой, хотя это может включать АВ
				СтрокаР = ТаблицаРасчетов.Добавить();
				СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.СкидкаКлиентуИзДБ;
				СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
				СтрокаР.Уточнение     = НомерПолиса;
				СтрокаР.СуммаКлиент   = -АВилиСкидкаСуммаРасчетное;
				СтрокаР.СуммаМенеджер = 0;
				СтрокаР.СуммаБрокер   = 0;//Часть брокера   	
			КонецЕсли;	
			Если АВСумма<>0 или Брокеру<>0 Тогда
				//Если АВ < Сданных, удерживается из ВМ
				СтрокаР = ТаблицаРасчетов.Добавить();
				СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ВыплатаМенеджеру;
				СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
				СтрокаР.Уточнение     = НомерПолиса;
				СтрокаР.СуммаКлиент   = 0;
				СтрокаР.СуммаМенеджер = АВСумма;
				СтрокаР.СуммаБрокер   = Брокеру; //часть брокера   	
			КонецЕсли;
			
		Иначе
			//Явная скидка
			СтрокаР = ТаблицаРасчетов.Добавить();
			СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.СкидкаКлиентуИзДБ;
			СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
			СтрокаР.Уточнение     = НомерПолиса;
			СтрокаР.СуммаКлиент   = -АВилиСкидкаСумма;
			СтрокаР.СуммаМенеджер = 0;
			СтрокаР.СуммаБрокер   = 0;//Часть брокера   	
		КонецЕсли;
	КонецЕсли;
	
	Если ОплаченоФакт<>0 Тогда
		СтрокаР = ТаблицаРасчетов.Добавить();
		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ПриемкаОтКлиентаБрокером;
		СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
		СтрокаР.Уточнение     = НомерПолиса;
		СтрокаР.СуммаКлиент   = -ОплаченоФакт;
		СтрокаР.СуммаМенеджер = 0;
		СтрокаР.СуммаБрокер   = 0;//Часть брокера   
	КонецЕсли;
	
	Если СкидкаВыплаченаяКлиенту<>0 и НЕ ЭтоПоАВ Тогда
		СтрокаР = ТаблицаРасчетов.Добавить();
		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ВыплатаКлиенту;
		СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
		СтрокаР.Уточнение     = НомерПолиса;
		СтрокаР.СуммаКлиент   = СкидкаВыплаченаяКлиенту;
		СтрокаР.СуммаМенеджер = 0;
		СтрокаР.СуммаБрокер   = 0;//Часть брокера   
	КонецЕсли;
	
	Если СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ
		ИЛИ СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоИнтерваламСКВ Тогда
		СтрокаР = ТаблицаРасчетов.Добавить();
		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.НачислениеСКВ; //Часть от СКВ менеджеру
		ВМ   = 0;
		
	//	УстЗнч("ВМ",ВМ,,,СтрокаБСО);
		//-- ОТЛИЧИЕ --
		СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
		СтрокаР.Уточнение     = НомерПолиса;
		СтрокаР.СуммаКлиент   = 0;
		СтрокаР.СуммаМенеджер = ?(ОплаченоФакт>0 и (КВСуммаДляАгента-КВСуммаУдержания)>АВилиСкидкаСумма,(КВСуммаДляАгента-КВСуммаУдержания)-АВилиСкидкаСумма,0)*(100-ПроцентСКВ)/100;
		СтрокаР.СуммаБрокер   = 0;
		СтрокаР.СуммаБрокерВС = 0;
	КонецЕсли;
	
	Если СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПланПоСКВ
		ИЛИ СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоИнтерваламСКВ 
		и ПроцентСКВ<>0 Тогда
		СтрокаР = ТаблицаРасчетов.Добавить();
		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.СКВПартнера; //Часть от СКВ менеджеру
		ВМ   = 0;
		
		СтрокаР.УидСтроки     = Ссылка.УникальныйИдентификатор();
		СтрокаР.Уточнение     = Куратор;
		СтрокаР.СуммаКлиент   = 0;
		СтрокаР.СуммаМенеджер = ?(ОплаченоФакт>0 и (КВСуммаДляАгента-КВСуммаУдержания)>АВилиСкидкаСумма,(КВСуммаДляАгента-КВСуммаУдержания)-АВилиСкидкаСумма,0)*ПроцентСКВ/100;
		СтрокаР.СуммаБрокер   = 0;
		СтрокаР.СуммаБрокерВС = 0;
	КонецЕсли;
	

	//	//
	//	//ПроверитьСтрокуБСО(СтрокаБСО);
	//	
	//	ТолькоБрокерскиеРасчеты = ТипЗнч(СтрокаБСО.ВидБСО) = Тип("СправочникСсылка.уб_ВидыБСО")	и СтрокаБСО.ВидБСО.Владелец = ПараметрыСеанса.уб_Константы.уб_СобственныйКонтрагент;
	//	//Страховая премия
	//	Если СтрокаБСО.ИтогСтраховаяПремия<>0 Тогда
	//		СтрокаР = ТаблицаРасчетов.Добавить();
	//		СтрокаР.Вид           = Справочники.уб_ВидыРасчетныхОпераций.ПриемкаОтКлиентаБрокером;//!!!Возможно другой вариант
	//		СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
	//		СтрокаР.Уточнение     = СтрокаБСО.ВидБСО;
	//		СтрокаР.СуммаКлиент   = СтрокаБСО.ИтогСтраховаяПремия;
	//		СтрокаР.СуммаМенеджер = 0;
	//		СтрокаР.СуммаБрокер   = ?(ТолькоБрокерскиеРасчеты,0,СтрокаБСО.ИтогСтраховаяПремия);
	//		СтрокаР.СуммаБрокерВС = 0;
	//	КонецЕсли;
	//	Если ТолькоБрокерскиеРасчеты Тогда
	//		ПлановаяСтоимость = СтрокаБСО.ВидБСО.ПлановаяСтоимость;
	//		Разница = СтрокаБСО.ИтогСтраховаяПремия-ПлановаяСтоимость;
	//		//Если ПлановаяСтоимость >0 Тогда
	//		//	СтрокаР = ТаблицаРасчетов.Добавить();
	//		//	СтрокаР.НачислениеВМ  =
	//		//	СтрокаР.УидСтроки     = СтрокаБСО.УидСтроки;
	//		//	СтрокаР.Уточнение     = СтрокаБСО.ВидБСО;
	//		//	СтрокаР.СуммаКлиент   = 0;
