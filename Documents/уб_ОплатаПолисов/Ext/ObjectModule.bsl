Процедура ПередУдалением(Отказ)
	
	НачатьТранзакцию();
	
	Если уб_СС.УдалитьКвитовки(Неопределено, Ссылка, Неопределено, ЭтотОбъект) Тогда
		ЗафиксироватьТранзакцию();	
	Иначе
		ОтменитьТранзакцию();	
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура обработчик события ПередЗаписью документа
// Проверяются реквизиты затрагивающие период расчета ЗП, изменяется его актуальность
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Проверка изменения значимых реквизитов
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//СДЕЛКА
	//Если НЕ Отказ И ПараметрыСеанса.уб_Константы.уб_ИспользуетсяМеханизмСделок = ИСТИНА И НЕ ЭтоПереустановкаЗПКрупнойСделки=Истина Тогда
	//	ПроверитьНаУчастиеВКрупнойСделке();
	//КонецЕсли;
	
	//Если ВидРасчетаСагентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ Тогда
	//	Если ЗарплатныйПериод<>Дата Тогда
	//		ЗарплатныйПериод = Дата;
	//	КонецЕсли;
	//Иначе
		Если Не ЗначениеЗаполнено(ЗарплатныйПериод) Тогда
			ЗарплатныйПериод = НачалоДня(КонецМесяца(Дата));
		//Иначе
			//Разность = (Макс(Дата,ЗарплатныйПериод)-Мин(Дата,ЗарплатныйПериод))/(60*60*24);
			//Если НЕ ЭтоКрупнаяСделка И Разность>92 И НЕ ЭтоПереустановкаЗПКрупнойСделки Тогда
			//	#Если Клиент Тогда
			//		Предупреждение("Дата оплаты и зарплатный период отличаются более чем на 3 месяца!");
			//		Отказ = Истина;
			//	#КонецЕсли
			//КонецЕсли;
		КонецЕсли;
	//КонецЕсли;

	
	Запрос = Новый Запрос;
	
	Если ЭтоНовый() Тогда
		Запрос.УстановитьПараметр("Ссылка",СтраховойПолис);
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	уб_СтраховойПолис.Ссылка,
		               |	уб_СтраховойПолис.Проведен,
		               |	уб_СтраховойПолис.ПометкаУдаления,
		               |	ДАТАВРЕМЯ(1, 1, 1) КАК ЗарплатныйПериод,
		               |	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Куратор,
		               |	ЗНАЧЕНИЕ(Перечисление.уб_ВидыРасчетовСАгентом.ПустаяСсылка) КАК ВидРасчетаСАгентом,
		               |	ЛОЖЬ КАК ИсключитьИзРасчетаЗП,
		               |	0 КАК ВознаграждениеМенеджера,
		               |	уб_СтраховойПолис.Номер КАК Номер,
		               |	ВЫБОР
		               |		КОГДА ТИПЗНАЧЕНИЯ(уб_СтраховойПолис.СтраховойПродукт) = ТИП(Справочник.уб_СтраховыеПродукты)
		               |			ТОГДА уб_СтраховойПолис.СтраховойПродукт.Вид
		               |		ИНАЧЕ уб_СтраховойПолис.СтраховойПродукт
		               |	КОНЕЦ КАК видСП
		               |ИЗ
		               |	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		               |		ПО уб_СтраховойПолис.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
		               |ГДЕ
		               |	уб_СтраховойПолис.Ссылка = &Ссылка";
				   
		Иначе
		   Запрос.УстановитьПараметр("Полис", СтраховойПолис);
		   Запрос.УстановитьПараметр("Ссылка",Ссылка);
		   
		   Запрос.Текст = "ВЫБРАТЬ
		                  |	уб_СтраховойПолис.Ссылка,
		                  |	уб_СтраховойПолис.Проведен,
		                  |	уб_СтраховойПолис.ПометкаУдаления,
		                  |	ЕСТЬNULL(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Куратор, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Куратор,
		                  |	уб_ОплатаПолисов.ЗарплатныйПериод КАК ЗарплатныйПериод,
		                  |	уб_ОплатаПолисов.ВидРасчетаСАгентом,
		                  |	уб_ОплатаПолисов.ИсключитьИзРасчетаЗП,
		                  |	уб_ОплатаПолисов.ВознаграждениеМенеджера,
		                  |	уб_СтраховойПолис.Номер КАК Номер,
		                  |	ВЫБОР
		                  |		КОГДА ТИПЗНАЧЕНИЯ(уб_СтраховойПолис.СтраховойПродукт) = ТИП(Справочник.уб_СтраховыеПродукты)
		                  |			ТОГДА уб_СтраховойПолис.СтраховойПродукт.Вид
		                  |		ИНАЧЕ уб_СтраховойПолис.СтраховойПродукт
		                  |	КОНЕЦ КАК видСП
		                  |ИЗ
		                  |	Документ.уб_ОплатаПолисов КАК уб_ОплатаПолисов
		                  |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
		                  |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		                  |			ПО уб_СтраховойПолис.Заявка = уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка
		                  |		ПО уб_ОплатаПолисов.СтраховойПолис = уб_СтраховойПолис.Ссылка
		                  |ГДЕ
		                  |	уб_ОплатаПолисов.Ссылка = &Ссылка";
	КонецЕсли;
	
	ВыборкаСсылка = Запрос.Выполнить().Выбрать();
	Если ВыборкаСсылка.Следующий() Тогда
		
	Иначе
		ВыборкаСсылка = ЭтотОбъект;
	КонецЕсли;
	
	УстановитьЗначение(ВидСП, ВыборкаСсылка.ВидСП);
	
	уб_РасчетыСМенеджерами.ПроверитьВидСтрахования(ЭтотОбъект);
	
	Если ВыборкаСсылка.ПометкаУдаления = Ложь и ПометкаУдаления Тогда
		НачатьТранзакцию();
		Если уб_СС.УдалитьКвитовки(Неопределено, Ссылка, Неопределено, ЭтотОбъект) Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(ВыборкаСсылка.Куратор) и не Куратор = ВыборкаСсылка.Куратор и НЕ(СкидкаВыплаченаяКлиенту>0 и ЗначениеЗаполнено(Куратор)) Тогда
		Куратор = ВыборкаСсылка.Куратор;
	КонецЕсли;
	
	УстановитьСхемуРасчета();//В основном для пустой схемы
	
	//Фиксация необходимости перерасчета ЗП по периоду
	ОтключенКонтрольПериодов = Ложь;
	Если ДополнительныеСвойства.Свойство("ОтключенКонтрольПериодов",ОтключенКонтрольПериодов) = Ложь Тогда
		ОтключенКонтрольПериодов = Ложь;
	КонецЕсли;
	
	Если НЕ Отказ и ОтключенКонтрольПериодов = Ложь Тогда
		МассивПериодов = Новый Массив;

		Если ЗарплатныйПериод <> ВыборкаСсылка.ЗарплатныйПериод Тогда
			МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
			МассивПериодов.Добавить(НачалоМесяца(ВыборкаСсылка.ЗарплатныйПериод));
		ИначеЕсли ВидРасчетаСАгентом <> ВыборкаСсылка.ВидРасчетаСАгентом Тогда
			МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
		ИначеЕсли ИсключитьИзРасчетаЗП <> ВыборкаСсылка.ИсключитьИзРасчетаЗП Тогда
			МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
		ИначеЕсли ВознаграждениеМенеджера <> ВыборкаСсылка.ВознаграждениеМенеджера Тогда
			МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
			//СКВ
		Иначе
			СтруктураПолей = уб_РасчетыСМенеджерами.СтруктураПолейДляРасчетаСКВ(ЭтотОбъект);
			_СКВ 	= уб_РасчетыСМенеджерами.ПолучитьСКВ(СтруктураПолей, 	"ДляАгента");
			__СКВ   = уб_РасчетыСМенеджерами.ПолучитьСКВ(Ссылка, 	        "ДляАгента");
			//_СуммаДляСК = НачисленнаяСуммаВзноса - КВСуммаДляАгента;
			//Если (ОплаченоФакт - СкидкаВыплаченаяКлиенту) < _СуммаДляСК Тогда
			//	_СКВ = 0;
			//Иначе
			//	_СКВ = (ОплаченоФакт - СкидкаВыплаченаяКлиенту) - _СуммаДляСК;
			//КонецЕсли;
			//__СуммаДляСК = Ссылка.НачисленнаяСуммаВзноса - Ссылка.КВСуммаДляАгента;
			//Если (Ссылка.ОплаченоФакт - Ссылка.СкидкаВыплаченаяКлиенту) < __СуммаДляСК Тогда
			//	__СКВ = 0;
			//Иначе
			//	__СКВ = (Ссылка.ОплаченоФакт - Ссылка.СкидкаВыплаченаяКлиенту) - __СуммаДляСК;
			//КонецЕсли;
			Если _СКВ <> __СКВ Тогда
				МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
			Иначе
				//Проверка на изменение проведения
				Если Проведен Тогда
					//
					Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
						МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
					ИначеЕсли ПометкаУдаления <> ВыборкаСсылка.ПометкаУдаления Тогда
						МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
					КонецЕсли;
				Иначе
					Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
						МассивПериодов.Добавить(НачалоМесяца(ЗарплатныйПериод));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		
		Для СчетчикПериодов = 0 по МассивПериодов.Количество()-1 Цикл
			ДатаНеактуальности = МассивПериодов[СчетчикПериодов];
			//ТЗ = РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП.СрезПоследних(,Новый Структура("РасчетныйПериод",ДатаНеактуальности));

//			Если ТЗ.Количество() = 0 Тогда
//			Иначе
//				Если Не ТЗ[0].Актуален Тогда
//					Продолжить;
//				КонецЕсли;
//			КонецЕсли;
			Если НЕ уб_РасчетыСМенеджерами.ЗарплатныйПериодАктуален(ДатаНеактуальности,Новый Структура("Актуален,Объект",Ложь,Ссылка)) Тогда
				Продолжить;
			КонецЕсли;
			
			//МЗ = РегистрыСведений.уб_АктуальностьРасчетаПериодовЗП.СоздатьМенеджерЗаписи();
			//МЗ.Актуален = Ложь;
			//МЗ.РасчетныйПериод = ДатаНеактуальности;
			//МЗ.Период = ТекущаяДата();
			//МЗ.Объект = Ссылка;
			//Попытка
			//	МЗ.Записать();
			//Исключение
			//	#Если Клиент  Тогда
			//		Сообщить("Ошибка регистрации неактуальности периода расчета ЗП");
			//	#КонецЕсли
			//КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	//++Расчеты
	ЗарегистрироватьРасчеты(ВыборкаСсылка);
	//--Расчеты
КонецПроцедуры

// Процедура обработчик события ПриЗаписи документа
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//+++Взаиморасчеты
	Если ПараметрыСеанса.уб_Константы.ВестиВзаиморасчетыПоОперациям = Истина И Отказ = Ложь Тогда
		ВыполнитьДвиженияПоВзаиморасчетам();
	КонецЕсли;
	//+++Взаиморасчеты
КонецПроцедуры


