//--- Взаиморасчеты ---
Процедура ВыполнитьДвиженияПоВзаиморасчетам() Экспорт
	
	Если ИДГруппыВзаиморасчетов = Неопределено Тогда
		ИДГруппыВзаиморасчетов = уб_Взаиморасчеты.ПолучитьУИДГруппыПоДокументу(Ссылка);
		Если ИДГруппыВзаиморасчетов = Ложь Тогда
			//Не сгенерируем новый УИД
			ИДГруппыВзаиморасчетов = Строка (Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	ЗапросВзаиморасчеты = уб_Взаиморасчеты.ЗапросПоВзаиморасчетамДокумента(Ссылка);
	СтруктураПараметров = Новый Структура("Дата,Агент,Страхователь,Поставщик,ОрганизацияАгент",Дата,Агент,СтраховойПолис.Страхователь,Поставщик,ОрганизацияАгент,Дата,ЗапросВзаиморасчеты);
	НачатьТранзакцию();
	//--Предварительные цифры
	ПоАВ = СхемаРасчетаСМенеджером=ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ;//ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ;
	ВКассу = ФормаОплаты=Перечисления.уб_ФормыОплаты.Касса;
	_УдержаноМенеджеромИзДСКлиента = ?(ПоАВ, АВилиСкидкаСумма, 0);
	_НачислениеСтраховогоВзноса = ?(ПолисАннулирован И ОплаченоФакт = 0 И АВилиСкидкаСумма<>0 и НеВключатьВОтчетыПоставщикам = ЛОЖЬ и НЕ ПоАВ,
			АВилиСкидкаСумма,НачисленнаяСуммаВзноса);
	 //_НачислениеВМ = ?(ПоАВ,Мин(АВилиСкидкаСумма,КВСумма),ВМРасчетное);//?((ПолисАннулирован И ОплаченоФакт = 0 и НеВключатьВОтчетыПоставщикам=ЛОЖЬ)=ЛОЖЬ И АВилиСкидкаСумма<>0 И (НачисленнаяСуммаВзноса - ОплаченоФакт+СкидкаВыплаченаяКлиенту)<>0,?(ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ,_НачислениеВМ,0),0);	
	 _НачислениеВМ = ?(ПоАВ,Мин(ВМРасчетное,КВСумма),ВМРасчетное);//?((ПолисАннулирован И ОплаченоФакт = 0 и НеВключатьВОтчетыПоставщикам=ЛОЖЬ)=ЛОЖЬ И АВилиСкидкаСумма<>0 И (НачисленнаяСуммаВзноса - ОплаченоФакт+СкидкаВыплаченаяКлиенту)<>0,?(ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ,_НачислениеВМ,0),0);	
	 
	_СкидкаКлиентуИзДБ = ?((ПолисАннулирован И ОплаченоФакт = 0 и НеВключатьВОтчетыПоставщикам=ЛОЖЬ)=ЛОЖЬ И АВилиСкидкаСумма<>0 И (НачисленнаяСуммаВзноса - ОплаченоФакт+СкидкаВыплаченаяКлиенту)<>0,?(ВидРасчетаСАгентом = Перечисления.уб_ВидыРасчетовСАгентом.ПоАВ,0,АВилиСкидкаСумма),0);
	
	//Мин
	//_ДоходБрокера = КВСумма - (АВилиСкидкаСумма - ВычетСАгента);
	//_ДБ = ?(ПоАВ,,0);
	
	
	//---КВ брокера
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("КВСумма",
		Справочники.уб_ВидыРасчетныхОпераций.НачислениеКВБрокера,Ссылка,Ссылка,КВСумма,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	//---КВ штраф менеджеру
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("ВычетСАгента",
	Справочники.уб_ВидыРасчетныхОпераций.УдержаниеИзВМ,Ссылка,Ссылка,ВычетСАгента,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);	
	//---Выплата клиенту
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("СкидкаВыплаченаяКлиенту",
		Справочники.уб_ВидыРасчетныхОпераций.ВыплатаКлиенту,Ссылка,Ссылка,СкидкаВыплаченаяКлиенту,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	//---Начисление ВМ
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("НачислениеВМ",
		Справочники.уб_ВидыРасчетныхОпераций.НачислениеВМ,Ссылка,Ссылка,_НачислениеВМ,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	//---Начисление Страхового взноса
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("НачисленнаяСуммаВзноса",
		Справочники.уб_ВидыРасчетныхОпераций.НачислениеСтраховогоВзноса,Ссылка,Ссылка,_НачислениеСтраховогоВзноса,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	//---Удержано менеджером		
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("УдержаноМенеджеромИзДСКлиента", 
		Справочники.уб_ВидыРасчетныхОпераций.УдержаноМенеджеромИзДСКлиента,Ссылка,Ссылка,_УдержаноМенеджеромИзДСКлиента,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	//---Скидка Клиенту		
	уб_Взаиморасчеты.ОтразитьОперациюВзаиморасчета("СкидкаКлиентуИзДБ",
		Справочники.уб_ВидыРасчетныхОпераций.СкидкаКлиентуИзДБ,Ссылка,Ссылка,_СкидкаКлиентуИзДБ,СтруктураПараметров,ИДГруппыВзаиморасчетов,ЗапросВзаиморасчеты);
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры
	
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УстановитьПривилегированныйРежим(Истина);
	ДвиженияПоРегистрам();
	УстановитьПривилегированныйРежим(Ложь);
		
