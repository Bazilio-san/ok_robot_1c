Функция УстЗнч(ИмяПоляДанных, НовоеЗначение, ПересчСуммы = Ложь, ИгнорироватьБлокировку = Ложь,ОбъектПравки =  Неопределено) Экспорт

	Если Не лРазрешеноРедактирование И Не ИгнорироватьБлокировку Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	НачальноеЗначение = Неопределено;
	
	Если УстЗнач(ИмяПоляДанных, НовоеЗначение,НачальноеЗначение,ОбъектПравки) Тогда
		МассивСтрок = ТЗИзменений.НайтиСтроки(Новый Структура("Реквизит",ИмяПоляДанных));
		Если МассивСтрок.Количество()>0 Тогда
			СтрокаТЗ = МассивСтрок[0];
			НачальноеЗначение = СтрокаТЗ.НачальноеЗначение;//Берем первоначальное значение
		Иначе	
			СтрокаТЗ = ТЗИзменений.Добавить();
		КонецЕсли;	
		СтрокаТЗ.Реквизит 			= ИмяПоляДанных;
		СтрокаТЗ.НачальноеЗначение  = НачальноеЗначение;
		СтрокаТЗ.НовоеЗначение		= ОбъектПравки[ИмяПоляДанных];
		Возврат Истина;
	Иначе
		Возврат Ложь
	КонецЕсли;

КонецФункции // УстЗнч()

Функция ПолучитьАВПоКодуКВ(_КодКВ, Дельта, Агент, СсылкаНаСтрокуКВ = Неопределено, Процент = Неопределено,естьЭксклюзивныеКВ = Истина)
	
	Если СсылкаНаСтрокуКВ = Неопределено Тогда
		СсылкаНаСтрокуКВ = Справочники.уб_КВ.НайтиПоКоду(_КодКВ);
	КонецЕсли;
	Если Процент = Неопределено Тогда
		Процент = СсылкаНаСтрокуКВ.Процент;
	КонецЕсли;
	Если ЗначениеНеЗаполнено(СсылкаНаСтрокуКВ) Тогда
		Возврат 0; 
	КонецЕсли;
	ЗксклюзивАВ =?(естьЭксклюзивныеКВ,НайтиЭксклюзивноеАВ(СсылкаНаСтрокуКВ, Агент),Неопределено);  
	Если ЗксклюзивАВ = Неопределено Тогда
		АВ = ?(Дельта = -1,0,Макс(Процент - Дельта,0)); 
	Иначе
		АВ = ЗксклюзивАВ; 
	КонецЕсли;
	Возврат АВ; 
	
КонецФункции

Функция НайтиЭксклюзивноеАВ(СсылкаНаСтрокуКВ, Знач Агент)
	
	тзАВ = уб_СтраховойБрокер.Получить_АВ(
			Дата
			, СсылкаНаСтрокуКВ
			, Подразделение.Владелец
			, Подразделение
			, Агент);
			
	Если тзАВ.Количество() = 0 Тогда
		Возврат Неопределено; 
	КонецЕсли;
	Возврат тзАВ[0].Процент; 
	
КонецФункции

Процедура ДобавитьВКомментарийУсловие(Знач Условие)
	
	Условие = СокрЛП(Условие);
	Если Условие <> "" И Найти(Комментарий,Условие) > 0 Тогда
		Возврат;	
	КонецЕсли;
	ЛевОграничитель = "{";
	ПравОграничитель = "}";
	Нач = Найти(Комментарий,ЛевОграничитель);
	Кон = Найти(Комментарий,ПравОграничитель);
	Если Нач > 0 И Кон > 0 Тогда
		Комментарий = СокрЛП(Сред(Комментарий,1,Нач-1) + " " + Сред(Комментарий,Кон+1));
	КонецЕсли;
	Если Условие = "" Тогда
		Возврат;	
	Иначе
		Условие = СтрЗаменить(Условие,ЛевОграничитель,"(");
		Условие = СтрЗаменить(Условие,ПравОграничитель,")");
	КонецЕсли;
	Комментарий = ЛевОграничитель + Условие + ПравОграничитель + " " + Комментарий;	
	
КонецПроцедуры

Функция ПодготовитьДеревоКВиАВ(дзКВ, Дельта = -1, ПрошлыйПроцент = Неопределено, Сообщать = Ложь,ДанныеПолиса = неопределено) Экспорт
	Если ДанныеПолиса = неопределено Тогда
		ДанныеПолиса = СтраховойПолис;
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(ДанныеПолиса) Тогда
		#Если Клиент Тогда
			Если Сообщать Тогда
				Сообщить("При получени КВ не хватает данных: не указан Страховой Полис.")
			КонецЕсли;
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;	
	Если НеМенятьКВ И (НеМенятьАВ ИЛИ НЕ РасчетПоАВ) Тогда
		Возврат Ложь;
	КонецЕсли;
	//TODO Ускорить
	Организация			= Подразделение.Владелец; 
	ДатаКВ	 			= ДанныеПолиса.Дата;	
	СП_Поставщик		= ДанныеПолиса.Поставщик;
	СП_ОрганизацияАгент	= ДанныеПолиса.ОрганизацияАгент;
	//Формируем виртуальную таблицу КВ, которая будет включать в себя полную матрицу данных по КВ брокера и Агента
	//актуальных для этого страхового полиса
	//Отталкиваемся от матрицы КВ брокера.
	тзКВ = уб_СтраховойБрокер.Получить_КВ_Брокера(
			ДатаКВ
			, СК
			, СП_Поставщик
			, СП_ОрганизацияАгент
			, ВидСП
			, СтраховойПродукт);
	тзКВ.Свернуть("Процент,Условие,БанкСтрока,ПроцентДляОтчета,Код,Ссылка,ПролонгацияПоПредыдущемуПроценту");
	//Если СтраховойПолис.ЕстьКредитныйДоговор Тогда
	//	//Удаляем не кредитные строки
	//	тзКВ = тзКВ.Скопировать(Новый Структура("Банк",СтраховойПолис.КредитныйБанк.Банк));
	//Иначе
	//	//
	//	тзКВ = тзКВ.Скопировать(Новый Структура("Банк",Справочники.Банки.ПустаяСсылка()));
	//КонецЕсли;	
	// КВ не найдено, тогда сообшаем об ошибке и выходим
	Если тзКВ.Количество() = 0 Тогда
		#Если Клиент  Тогда
			Если Сообщать Тогда
				Сообщить("Не найдено КВ для страхового продукта '" + СтраховойПродукт.Наименование + "', СК: '" + 
					Строка(СК) + "', Поставщик: '" + Строка(СП_Поставщик) + "', ОргАгент: '" + Строка(СП_ОрганизацияАгент) + "'." );
			КонецЕсли;
		#КонецЕсли
		Возврат Ложь;			
	КонецЕсли;
	тзКВ.Сортировать("БанкСтрока,Условие,Процент,ПроцентДляОтчета");//Для оптимизации переход к строковому значению банка
	уб_СС.УдалитьПустыеКолонки(тзКВ,"Процент,ПроцентДляОтчета,Условие,БанкСтрока");
	// найден один или несколько вариантов КВ 
	// Различные вариации КВ: по Условию, Рискам, а так же вид КВ - "Кредитное"
	дзКВ = Новый ДеревоЗначений;
	Для Каждого Колонка ИЗ тзКВ.Колонки Цикл
		дзКВ.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;	
	МассивТипов = Новый Массив;
	//МассивТипов.Добавить(Тип("ПеречислениеСсылка.уб_ВидыКВ"));
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("Число"));
	ОписаниеТипаПроцент = Новый ОписаниеТипов(МассивТипов,Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный),Новый КвалификаторыСтроки(40));
	ОписаниеТипаДельта = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Любой));
	//ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255));	
	дзКВ.Колонки.Добавить("АВ",		ОписаниеТипаПроцент,	"АВ, %",		6);
	дзКВ.Колонки.Добавить("Дельта",	ОписаниеТипаДельта,		"Дельта, %",	6);
	//Находим "Дельту" КВ для данного случая и заполняем колонку АВ соответствующими значениями
	тзДельта = уб_СтраховойБрокер.ПолучитьДельтуКВ(
		ДатаКВ, 
		Перечисления.уб_НазначенияКВ.ДляМенеджера,
		Организация,
		Подразделение,
		Агент, 
		СП_Поставщик, 
		СП_ОрганизацияАгент, 
		СК, 
		ВидСП, 
		СтраховойПродукт 
	);
	Дельта = -1; //Для данного значения Дельта значение АВ везде будет равно 0
	Если тзДельта.Количество() > 0 Тогда
		Дельта = тзДельта[0].Дельта;
	КонецЕсли;	
	//Заполняем дерево значений
	СтрокаКредитныхКВ = Неопределено;
	естьЭксклюзивныеКВ = уб_СтраховойБрокер.ЕстьЭксклюзивноеКВ();
	Для Каждого стрТЗ из тзКВ Цикл
		Если дзКВ.Колонки.Найти("БанкСтрока") <> Неопределено И НЕ ЗначениеНеЗаполнено(стрТЗ.БанкСтрока) Тогда
			Если СтрокаКредитныхКВ = Неопределено Тогда
				СтрокаКредитныхКВ = дзКВ.Строки.Вставить(0); 	
				СтрокаКредитныхКВ.Условие = "<Кредитные КВ>";
				СтрокаКредитныхКВ.БанкСтрока = "<Кредитные КВ>"; 	
				СтрокаКредитныхКВ.АВ = "---";
				СтрокаКредитныхКВ.Процент = "---";
				СтрокаКредитныхКВ.ПроцентДляОтчета = "---"; 	
			КонецЕсли;
			новСтр = СтрокаКредитныхКВ.Строки.Добавить();
		Иначе
			новСтр = дзКВ.Строки.Добавить();
		КонецЕсли;		
		Для Каждого кол из тзКВ.Колонки Цикл
			новСтр[кол.Имя] = стрТЗ[кол.Имя];
		КонецЦикла;
		новСтр.Дельта = Дельта; 		
		новСтр.АВ = ПолучитьАВПоКодуКВ(стрТЗ.Код, Дельта, Агент, стрТЗ.Ссылка,стрТЗ.Процент,естьЭксклюзивныеКВ);
		Если ПрошлыйПроцент <>Неопределено и стрТЗ.ПролонгацияПоПредыдущемуПроценту = Истина Тогда 
			НомерСтроки = дзКВ.Строки.Количество()-1;
			СтрокаПролонгации = дзКВ.Строки.Вставить(НомерСтроки);
			ЗаполнитьЗначенияСвойств(СтрокаПролонгации,новСтр);
			СтрокаПролонгации.Процент = ПрошлыйПроцент;
			СтрокаПролонгации.ПроцентДляОтчета = ПрошлыйПроцент;
			СтрокаПролонгации.Условие = "Это ПРОЛОНГАЦИЯ !!!";
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РасчетСуммыКВ(ДляОтчета = Ложь) Экспорт

	РасчетнаяБаза  = ?(НачисленнаяСуммаВзноса = 0,ПолученнаяСКлиентаСуммаВзносаДляОтчетаПоставщику,НачисленнаяСуммаВзноса);
			
	Возврат уб_РасчетыСменеджерами.уб_Окр(РасчетнаяБаза * ?(ДляОтчета, КВПроцентДляОтчета, КВПроцент) / 100, РазрядностьОкругления,РежимОкругления);

КонецФункции // РасчетСуммыКВ()

