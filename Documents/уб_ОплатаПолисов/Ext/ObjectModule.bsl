//Обработчики формы

Процедура УстановитьКВиАВ(
	Знач НеПереУстанавливатьВыбранноеРанееКВ 	= Ложь, 
	ПроверятьАктуальностьКВ 					= Истина, 
	Параметры
	) Экспорт
	
	ОткрыватьФорму = Параметры.ОткрыватьФормуВыбораКВиАВ;
	Если НеМенятьКВ И (НеМенятьАВ Или НЕ РасчетПоАВ) Тогда
		Возврат;	
	КонецЕсли;	
	ДанныеЗапроса = ОбновитьДанныеИзПолиса(СтраховойПолис, Истина);	
	ЭтоПролонгация = ДанныеЗапроса.ПолисовПоОбъекту;
	ПрошлыйПроцент = ?(ЗначениеЗаполнено(ДанныеЗапроса.КВПроцент),ДанныеЗапроса.КВПроцент,Неопределено);
	//УстановитьПодразделение();
	_КВСумма = РасчетСуммыКВ();
	_КВСуммаДляАгента = Окр(НачисленнаяСуммаВзноса * КВПроцентДляАгента / 100, 2);
	дзКВ = Новый ДеревоЗначений;	
	Дельта = -1;	
	//Сначала подготавливаем тзКВ и тзАВ
	Если ПодготовитьДеревоКВиАВ(дзКВ, Дельта,ПрошлыйПроцент) Тогда   //, бЗадаватьВопросы = Истина
		_КВПроцент			= КВПроцент;
		_КВПроцентДляОтчета	= КВПроцентДляОтчета;
		_АВПроцент	= КВПроцентДляАгента;	
		_Условие = "";
		_КодКВ = КодКВ;
		Если НеПереУстанавливатьВыбранноеРанееКВ И ПроверятьАктуальностьКВ И КодКВ <> 0 Тогда
			НеПереУстанавливатьВыбранноеРанееКВ = НеПереУстанавливатьВыбранноеРанееКВ И (дзКВ.Строки.Найти(КодКВ,"Код",Истина) <> Неопределено);	
		КонецЕсли;
		НеПереУстанавливатьВыбранноеРанееКВ = НеПереУстанавливатьВыбранноеРанееКВ И КодКВ <> 0;
		КВНеВыбирается = НеМенятьКВ Или НеПереУстанавливатьВыбранноеРанееКВ;
		АВНеВыбирается = (НеМенятьАВ Или НЕ РасчетПоАВ);
		Если НеПереУстанавливатьВыбранноеРанееКВ И Параметры.УстанавливатьКВДляАгента Тогда
			Если НеМенятьКВ И _КВПроцент = 0 Тогда
				//Если указано 0-е КВ и оно зафиксировано, то и АВ = 0
				Если НЕ АВНеВыбирается Тогда
					УстЗнч("КВПроцентДляАгента", 0);
					УстЗнч("КВСуммаДляАгента", 0);
				КонецЕсли;
				Возврат;	
			ИначеЕсли _КВПроцент > 0 И КодКВ = 0 Тогда
				//Если указано КВ вручную, то АВ равно КВ - Дельта
				Если НЕ АВНеВыбирается Тогда
					_АВПроцент	= ?(Дельта = -1, 0, Макс(_КВПроцент - Дельта,0));	//(Если Дельта = -1, то АВ = 0; АВ не может быть меньше 0)
					_АВСумма = Окр(НачисленнаяСуммаВзноса * _АВПроцент / 100,2);
					УстЗнч("КВПроцентДляАгента", _АВПроцент);
					УстЗнч("КВСуммаДляАгента", _АВСумма);
				КонецЕсли;
				Возврат;	
			ИначеЕсли _КВПроцент > 0 И КодКВ <> 0 Тогда
				//Если указано КВ из справочника, то находим АВ по коду
				Если НЕ АВНеВыбирается Тогда
					_АВПроцент	= ПолучитьАВПоКодуКВ(КодКВ, Дельта, Агент);	
					_АВСумма = Окр(НачисленнаяСуммаВзноса * _АВПроцент / 100,2);
					УстЗнч("КВПроцентДляАгента", _АВПроцент);
					УстЗнч("КВСуммаДляАгента", _АВСумма);
				КонецЕсли;
				Возврат;	
			КонецЕсли;
		КонецЕсли;	
		//Передаем дзКВ в форму выбора и получаем обратно выбранное значение
		Если ПолучитьВыбранные_КВ_и_АВ(
			_КВПроцент, 
			_КВПроцентДляОтчета, 
			_АВПроцент, 
			_Условие, 
			_КодКВ, 
			дзКВ, 
			КВНеВыбирается, 
			АВНеВыбирается,
			ОткрыватьФорму
			) Тогда
			Если Не КВНеВыбирается Тогда
				УстЗнч("КВПроцент", _КВПроцент);
				//КВДляОтчета не будет меняться, когда не будет менятьсяКВ?
				УстЗнч("КВПроцентДляОтчета", _КВПроцентДляОтчета);
				УстЗнч("КодКВ", _КодКВ);
			КонецЕсли;
			_КВСумма = РасчетСуммыКВ();
			УстЗнч("КВСумма", _КВСумма);
			Если НЕ АВНеВыбирается И Параметры.УстанавливатьКВДляАгента Тогда
				УстЗнч("КВПроцентДляАгента", _АВПроцент);
				_АВСумма = Окр(НачисленнаяСуммаВзноса * _АВПроцент / 100,2);
				УстЗнч("КВСуммаДляАгента", _АВСумма);
			КонецЕсли;
			//УстЗнч("АВилиСкидкаСумма", _АВилиСкидкаСумма);
			ДобавитьВКомментарийУсловие(_Условие);			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВыбранные_КВ_и_АВ(
	КВ, 
	КВДляОтчета, 
	АВ, 
	Условие, 
	_КодКВ, 
	дзКВ, 
	КВНеВыбирается = Ложь, 
	АВНеВыбирается = Ложь,
	ОткрыватьФорму = Истина
	)

	Банк 					= Неопределено;	
	КредитноеКВ				= Неопределено;
	ЕстьДанные 				= Ложь;	
	ВыбраннаяСтрока 		= Неопределено;
	БылаОткрытаФормаВыборКВ = Ложь;
	Если дзКВ.Строки.Количество() = 0 Тогда
		ЕстьДанные = Ложь;	
		#Если Клиент Тогда
			Состояние("НЕТ КВ БРОКЕРА!");
		#КонецЕсли
	ИначеЕсли дзКВ.Строки.Количество() = 1 И НЕ дзКВ.Строки[0].БанкСтрока = "<Кредитные КВ>" Тогда  
		//В наличии единственная строка в дзКВ: выбор КВ однозначен
		ЕстьДанные  = Истина;	
		ВыбраннаяСтрока = дзКВ.Строки[0];
		#Если Клиент Тогда
			Состояние("Единственная строка");
		#КонецЕсли
	ИначеЕсли дзКВ.Строки.Количество() = 1 И дзКВ.Строки[0].Строки.Количество() = 1 Тогда  
		//В наличии единственная строка в дзКВ: <Кредитные КВ>
		//Только Кредитные и единственная строка для этого банка
		ЕстьДанные = Истина;	
		ВыбраннаяСтрока = дзКВ.Строки[0].Строки[0];	
		#Если Клиент Тогда
			Состояние("Единственная строка. КРЕДИТ");
		#КонецЕсли
	ИначеЕсли ОткрыватьФорму Тогда
		//В наличии несколько строк в дзКВ, предоставляем выбор пользователю
		ФормаВыбора = ПолучитьОбщуюФорму("уб_ВыборКВ");
		ФормаВыбора.in_ДЗ 				= дзКВ;
		ФормаВыбора.in_СК 				= СК;
		ФормаВыбора.in_Поставщик 		= СтраховойПолис.Поставщик;
		ФормаВыбора.in_ОрганизацияАгент = СтраховойПолис.ОрганизацияАгент;
		ФормаВыбора.in_СтраховойПродукт = СтраховойПродукт;
		Если ТипЗнч(СтраховойПродукт) = Тип("СправочникСсылка.уб_СтраховыеПродукты") Тогда
			ФормаВыбора.in_ВидСП 			= СтраховойПродукт.Вид;
		КонецЕсли;
		ФормаВыбора.in_Агент 			= Агент;
		ФормаВыбора.in_КВНеВыбирается 	= КВНеВыбирается;
		ФормаВыбора.in_АВНеВыбирается 	= АВНеВыбирается;
		ФормаВыбора.inКредитный         = СтраховойПолис.ЕстьКредитныйДоговор;
		ФормаВыбора.inЛизинговый        = СтраховойПолис.ЕстьЛизинговыйДоговор;
		ФормаВыбора.РежимВыбора 		= Истина;
		ФормаВыбора.МножественныйВыбор	= Ложь;
		ФормаВыбора.ЗакрыватьПриВыборе	= Истина;
		ФормаВыбора.ОткрытьМодально(); 
		ВыбраннаяСтрока = ФормаВыбора.out_Строка;
		ЕстьДанные = (ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаДереваЗначений"));
		БылаОткрытаФормаВыборКВ = Истина;
	КонецЕсли;
	Если ЕстьДанные Тогда
		КВ			= ВыбраннаяСтрока.Процент;
		КВДляОтчета	= ВыбраннаяСтрока.ПроцентДляОтчета;
		АВ			= ВыбраннаяСтрока.АВ;	
		Условие		= СокрЛП(ВыбраннаяСтрока.Условие);
		//
		ПолучатьБанк = Истина;
		Если БылаОткрытаФормаВыборКВ Тогда
			ВладелецСтрокиДЗ = ВыбраннаяСтрока.Владелец();
			Если ВладелецСтрокиДЗ.Колонки.Найти("БанкСтрока") = Неопределено Тогда
				ПолучатьБанк = Ложь
			КонецЕсли;
		КонецЕсли;
		Если ПолучатьБанк Тогда
			Банк = ВыбраннаяСтрока.БанкСтрока;
		КонецЕсли;
		_КодКВ      = ВыбраннаяСтрока.Код;
		Если ЗначениеЗаполнено(Банк) Тогда
			Спр = Справочники.уб_БанкиКредитные; 
			КБ = Спр.НайтиПоРеквизиту("Банк",Банк);
			Наимен = Банк;//?(КБ = Спр.ПустаяСсылка(), Банк.Наименование, КБ.Наименование);	
			Условие = ?(Найти(НРег(Наимен),"банк") = 0,"Банк: ","") + Наимен + ?(Условие = "","","; " + Условие);	
		КонецЕсли;
	КонецЕсли;	
	Возврат ЕстьДанные;	
	
КонецФункции

