Процедура ДвиженияПоРегистрам()
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Движения.уб_РасчетыСПоставщиками.Записывать = Истина;
	Движения.уб_РасчетыСПоставщиками.Очистить();
	Движения.уб_РасчетыСПоставщиками.Загрузить(Документы.уб_ОплатаПолисов.ПолучитьТаблицуДвижений(ЭтотОбъект,Движения.уб_РасчетыСПоставщиками));
	//ЗП
	уб_РасчетыСФЛПоЗП = Движения.уб_РасчетыСФЛПоЗП;
	уб_РасчетыСФЛПоЗП.Записывать = Истина;
	уб_РасчетыСФЛПоЗП.Очистить();
	Если типзнч(Агент) = Тип("СправочникСсылка.ФизическиеЛица") и  СхемаРасчетаСМенеджером = ПланыВидовРасчета.уб_РасчетЗарплатыМенеджерамОП.ПоАВ и (АВилиСкидкаСумма<>0 или СкидкаВыплаченаяКлиенту<>0)Тогда
		ЗаписьПоЗП = уб_РасчетыСФЛПоЗП.Добавить();
		ЗаписьПоЗП.Активность     = Ложь;
		ЗаписьПоЗП.ВидДвижения    = ВидДвиженияНакопления.Приход;
		ЗаписьПоЗП.ВидНачисления  = ПланыВидовРасчета.уб_ОсновныеНачисленияОрганизаций.ВычетПоАВ;
		//ЗаписьПоЗП.Источник = ;
		ЗаписьПоЗП.Сумма          = АВилиСкидкаСумма+СкидкаВыплаченаяКлиенту;
		ЗаписьПоЗП.ФизическоеЛицо = Агент; 
		ЗаписьПоЗП.Организация    = Справочники.Организации.НайтиПоКоду("000000001");
		ЗаписьПоЗП.Период         = Дата;
		ЗаписьПоЗП.Раздел         = 5;//Проверить, но вроде бы не используется
		ЗаписьПоЗП.Описание       = "АВ по полису "+ СтраховойПолис.Номер;
		ЗаписьПоЗП.РасчетныйПериод = ЗарплатныйПериод;
	КонецЕсли;
	
	Движения.Записать();
	
КонецПроцедуры

