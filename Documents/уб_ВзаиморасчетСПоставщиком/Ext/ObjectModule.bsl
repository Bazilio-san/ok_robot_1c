Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НаправлениеРасчетов = Перечисления.уб_ВидОперацииВзаиморасчетов.Корректировка Тогда
	ИначеЕсли НЕ Категория = Перечисления.уб_КатегорияЗадолженности.ОтчетПоставщикуПринят Тогда
		Категория = Перечисления.уб_КатегорияЗадолженности.ОтчетПоставщикуПринят;
	КонецЕсли;
	Разница = СуммаДокумента - Распределение.Итог("Сумма");
	Если НЕ Разница = 0 Тогда
		ОтразитьРазницуВПустоте(Разница);
	КонецЕсли;	
	//Удаление нулевых строк
	МассивСтрок = Распределение.НайтиСтроки(Новый Структура("Сумма",0));
	ВсегоСтрок = МассивСтрок.Количество();
	Для СчетчикСтрок = 1 ПО ВсегоСтрок Цикл
		Распределение.Удалить(МассивСтрок[ВсегоСтрок-1]);
	КонецЦикла;	
	
	СписокПустыхСтрокРаспределения = Распределение.Выгрузить(Новый Структура("ОтчетПоставщику",Документы.уб_ОтчетПоставщику.ПустаяСсылка()), "Сумма");
	НераспределенныйОстаток = СписокПустыхСтрокРаспределения.Итог("Сумма");
	Если СписокПустыхСтрокРаспределения.Количество() > 0 И НераспределенныйОстаток = 0 Тогда
		//Удаление полностью "пустой" строки
		МассивСтрок = Распределение.НайтиСтроки(Новый Структура("ОтчетПоставщику",Документы.уб_ОтчетПоставщику.ПустаяСсылка()));
		ВсегоСтрок = МассивСтрок.Количество();
		Для СчетчикСтрок = 1 ПО ВсегоСтрок Цикл
			Распределение.Удалить(МассивСтрок[ВсегоСтрок-1]);
		КонецЦикла;	
	КонецЕсли;	
	
	
КонецПроцедуры

Процедура ОтразитьРазницуВПустоте(Разница)
	
	Если Разница <> 0 Тогда
		ТЧ = Распределение.Выгрузить();
		Строка = ТЧ.Добавить();
		Строка.ОтчетПоставщику = Документы.уб_ОтчетПоставщику.ПустаяСсылка();
		Строка.Сумма = Разница;
		ТЧ.Свернуть("ОтчетПоставщику,Уточнение","Сумма");
		Распределение.Загрузить(ТЧ);
	Конецесли;
	
КонецПроцедуры	
