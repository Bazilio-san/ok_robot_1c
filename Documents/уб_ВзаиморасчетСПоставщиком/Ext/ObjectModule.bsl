Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Отказ = НЕ ПравоДоступа("ОтменаПроведения", Метаданные());
	Возврат;	
	
КонецПроцедуры

Функция ПроверкаЗаполнения()
	Статус = СтатусСообщения.Важное;	
	
	Рез = Истина;
	
	Если ЗначениеНеЗаполнено(Номер) Тогда 
		УстановитьНовыйНомер();
	КонецЕсли; 
	
	Если ЗначениеНеЗаполнено(Дата) Тогда 
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Если ЗначениеНеЗаполнено(ОрганизацияАгент) Тогда 
		Если Не Проведен Тогда
			oАг = уб_СС.ПолучКонтрагентаИлиФизлицоПоПльзователю(ПараметрыСеанса.ТекущийПользователь);
			Если oАг <> Неопределено Тогда
				Организация = oАг;
			КонецЕсли;
		КонецЕсли; 
		Если ЗначениеНеЗаполнено(ОрганизацияАгент) Тогда 
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не заполнено поле 'Организация'!");
			Рез = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Если Ответственный.Пустая() Тогда 
		Если Не Проведен Тогда
			Ответственный = уб_СС.ПолучитьФИНОтветственного();
		КонецЕсли; 
		Если ЗначениеНеЗаполнено(Ответственный) Тогда 
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Не заполнено поле 'Ответственный'!");
			Рез = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	
	Возврат Рез;	
КонецФункции

