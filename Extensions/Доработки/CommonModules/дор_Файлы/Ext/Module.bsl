// Доступ к файлам хранилищ с сервера 1С. Модуль серверный с вызовом сервера: функции выполняются на
// сервере 1С под его служебной учётной записью, поэтому видят локальные диски сервера и сетевые папки,
// доступные этой учётной записи. Вызов из внешнего соединения: дор_Файлы.ПроверитьПути(Пути).

// Проверяет пути на сервере. Пути — Массив строк. Возвращает Структуру: КомпьютерСервера и Проверки
// (Массив Структур: Путь, Существует, Каталог, Размер, Изменен, ЭлементовВнутри, Первые, Ошибка).
Функция ПроверитьПути(Пути) Экспорт
	Рез = Новый Структура;
	Рез.Вставить("КомпьютерСервера", ИмяКомпьютера());
	Рез.Вставить("КаталогВременныхФайлов", КаталогВременныхФайлов());
	Проверки = Новый Массив;
	Для Каждого П Из Пути Цикл
		С = Новый Структура("Путь", П);
		Попытка
			Ф = Новый Файл(П);
			С.Вставить("Существует", Ф.Существует());
			Если Ф.Существует() Тогда
				С.Вставить("Каталог", Ф.ЭтоКаталог());
				Если Ф.ЭтоКаталог() Тогда
					Эл = НайтиФайлы(П, "*");
					С.Вставить("ЭлементовВнутри", Эл.Количество());
					Имена = Новый Массив;
					Для Каждого Э Из Эл Цикл
						Если Имена.Количество() < 10 Тогда
							Имена.Добавить(Э.Имя + ?(Э.ЭтоКаталог(), "\", ""));
						КонецЕсли;
					КонецЦикла;
					С.Вставить("Первые", Имена);
				Иначе
					С.Вставить("Размер", Ф.Размер());
					С.Вставить("Изменен", Ф.ПолучитьВремяИзменения());
				КонецЕсли;
			КонецЕсли;
		Исключение
			С.Вставить("Ошибка", ОписаниеОшибки());
		КонецПопытки;
		Проверки.Добавить(С);
	КонецЦикла;
	Рез.Вставить("Проверки", Проверки);
	Возврат Рез;
КонецФункции

// Читает файл с сервера и возвращает Структуру: Путь, Размер, Base64 (содержимое) либо Ошибка.
// МаксРазмер — предел в байтах (по умолчанию 20 МБ), больший файл не читается.
Функция ПрочитатьФайл(Путь, МаксРазмер = 20971520) Экспорт
	Рез = Новый Структура("Путь", Путь);
	Попытка
		Ф = Новый Файл(Путь);
		Если Не Ф.Существует() Тогда
			Рез.Вставить("Ошибка", "Файл не найден");
			Возврат Рез;
		КонецЕсли;
		Рез.Вставить("Размер", Ф.Размер());
		Если Ф.Размер() > МаксРазмер Тогда
			Рез.Вставить("Ошибка", "Файл больше предела " + Формат(МаксРазмер, "ЧГ=") + " байт");
			Возврат Рез;
		КонецЕсли;
		ДД = Новый ДвоичныеДанные(Путь);
		Рез.Вставить("Base64", Base64Строка(ДД));
	Исключение
		Рез.Вставить("Ошибка", ОписаниеОшибки());
	КонецПопытки;
	Возврат Рез;
КонецФункции
