// Поиск страхователя по признакам, распознанным с документов клиента: подбор кандидатов и их карточки.
// Модуль только читает данные. Решение, какой кандидат подходит и какие распознанные значения исправить,
// принимает вызывающая сторона по признакам совпадения (matched_by) и карточкам кандидатов.

#Область ПрограммныйИнтерфейс

// Ищет страхователей по признакам запроса и возвращает карточки найденных.
//
// Признаки сравниваются мягко, чтобы ошибка распознавания в одном знаке не мешала найти клиента: паспорт
// и водительское удостоверение ищутся по номеру без серии, физические лица - ещё и по одной дате рождения,
// номера полисов и госномера - во всех сочетаниях похожих кириллических и латинских букв.
//
// Параметры:
//  Критерии - Структура - признаки поиска; все поля необязательные:
//   * last_name, first_name, middle_name - Строка - фамилия, имя, отчество;
//   * birth_date - Строка - дата рождения ГГГГ-ММ-ДД;
//   * passport_series, passport_number - Строка - серия и номер паспорта РФ;
//   * driver_license_series, driver_license_number - Строка - серия и номер водительского удостоверения;
//   * inn - Строка - ИНН физического или юридического лица;
//   * company_name - Строка - наименование организации-страхователя;
//   * policy_numbers - Массив из Строка - номера полисов клиента (серия вместе с номером);
//   * vins - Массив из Строка - VIN машин клиента;
//   * registration_numbers - Массив из Строка - государственные регистрационные знаки;
//   * limit - Число - предел кандидатов по одному признаку, по умолчанию 20;
//   * policies_limit - Число - сколько последних полисов кандидата вернуть, по умолчанию 10.
//
// Возвращаемое значение:
//  Структура:
//   * candidates - Массив из Структура - карточки кандидатов с признаками совпадения matched_by;
//   * truncated - Массив из Строка - признаки, по которым найдено больше предела (остаток не показан);
//   * searched - Массив из Строка - признаки, по которым выполнялся поиск.
//
Функция НайтиСтрахователя(Критерии) Экспорт

	Предел = ЧислоИзКритериев(Критерии, "limit", 20);
	ПределПолисов = ЧислоИзКритериев(Критерии, "policies_limit", 10);

	Найденные = Новый Соответствие;
	Порядок = Новый Массив;
	Обрезанные = Новый Массив;
	Искали = Новый Массив;

	ИскатьПоПаспорту(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоВодительскомуУдостоверению(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоИНН(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоФИО(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоДатеРождения(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоНаименованиюОрганизации(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоНомерамПолисов(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);
	ИскатьПоТранспортнымСредствам(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали);

	Результат = Новый Структура;
	Результат.Вставить("candidates", КарточкиКандидатов(Порядок, Найденные, ПределПолисов));
	Результат.Вставить("truncated", Обрезанные);
	Результат.Вставить("searched", Искали);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Поиск

Процедура ИскатьПоПаспорту(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	Номер = ТолькоЦифры(СтрокаИзКритериев(Критерии, "passport_number"));
	Если ПустаяСтрока(Номер) Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("passport_number");

	// Регистр периодический: ищем по всем записям, а не по срезу, чтобы найти клиента и по прежнему паспорту.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	П.ФизЛицо КАК Ссылка,
	|	П.ДокументСерия КАК Серия,
	|	П.ДокументНомер КАК Номер
	|ИЗ
	|	РегистрСведений.ПаспортныеДанныеФизЛиц КАК П
	|ГДЕ
	|	П.ДокументНомер В (&Номера)
	|	И П.ФизЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Номера", ВариантыНомераСПробелами(Номер));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > Предел Тогда
		Обрезанные.Добавить("passport_number");
	КонецЕсли;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Предел Цикл
		Счетчик = Счетчик + 1;
		ДобавитьСовпадение(Найденные, Порядок, Выборка.Ссылка, "passport_number",
			СокрЛП(Выборка.Серия) + " " + СокрЛП(Выборка.Номер));
	КонецЦикла;

КонецПроцедуры

Процедура ИскатьПоВодительскомуУдостоверению(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	Номер = ТолькоЦифры(СтрокаИзКритериев(Критерии, "driver_license_number"));
	Если ПустаяСтрока(Номер) Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("driver_license_number");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Ф.Ссылка КАК Ссылка,
	|	Ф.ВодительскоеУдостоверениеСерия КАК Серия,
	|	Ф.ВодительскоеУдостоверениеНомер КАК Номер
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Ф
	|ГДЕ
	|	Ф.ВодительскоеУдостоверениеНомер В (&Номера)
	|	И НЕ Ф.ЭтоГруппа");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Номера", ВариантыНомераСПробелами(Номер));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > Предел Тогда
		Обрезанные.Добавить("driver_license_number");
	КонецЕсли;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Предел Цикл
		Счетчик = Счетчик + 1;
		ДобавитьСовпадение(Найденные, Порядок, Выборка.Ссылка, "driver_license_number",
			СокрЛП(Выборка.Серия) + " " + СокрЛП(Выборка.Номер));
	КонецЦикла;

КонецПроцедуры

Процедура ИскатьПоИНН(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	ИНН = ТолькоЦифры(СтрокаИзКритериев(Критерии, "inn"));
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("inn");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	К.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.ИНН = &ИНН
	|	И НЕ К.ЭтоГруппа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Ф.Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Ф
	|ГДЕ
	|	Ф.ИНН = &ИНН
	|	И НЕ Ф.ЭтоГруппа");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("ИНН", ИНН);
	ДобавитьВыборку(Запрос, "inn", ИНН, Предел, Найденные, Порядок, Обрезанные);

КонецПроцедуры

Процедура ИскатьПоФИО(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	Фамилия = ЧастьИмени(СтрокаИзКритериев(Критерии, "last_name"));
	Имя = ЧастьИмени(СтрокаИзКритериев(Критерии, "first_name"));
	Если ПустаяСтрока(Фамилия) Или ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("full_name");

	// Отчество не входит в условие: у части клиентов его нет в наименовании, а в распознанном оно бывает
	// с ошибкой. Его совпадение оценивает вызывающая сторона по карточке.
	Шаблоны = Новый Массив;
	Шаблоны.Добавить(Фамилия + " " + Имя + "%");
	СЕ = СтрЗаменить(Шаблоны[0], "ё", "е");
	Если СЕ <> Шаблоны[0] Тогда
		Шаблоны.Добавить(СЕ);
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Ф.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Ф
	|ГДЕ
	|	(Ф.Наименование ПОДОБНО &Шаблон1 ИЛИ Ф.Наименование ПОДОБНО &Шаблон2)
	|	И НЕ Ф.ЭтоГруппа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	К.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	(К.Наименование ПОДОБНО &Шаблон1 ИЛИ К.Наименование ПОДОБНО &Шаблон2)
	|	И К.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|	И НЕ К.ЭтоГруппа");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Шаблон1", Шаблоны[0]);
	Запрос.УстановитьПараметр("Шаблон2", Шаблоны[Шаблоны.ВГраница()]);
	ДобавитьВыборку(Запрос, "full_name", Фамилия + " " + Имя, Предел, Найденные, Порядок, Обрезанные);

КонецПроцедуры

Процедура ИскатьПоДатеРождения(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	ДатаРождения = ДатаИзСтроки(СтрокаИзКритериев(Критерии, "birth_date"));
	Если ДатаРождения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("birth_date");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Ф.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Ф
	|ГДЕ
	|	Ф.ДатаРождения = &ДатаРождения
	|	И НЕ Ф.ЭтоГруппа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	К.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.ДатаРождения = &ДатаРождения
	|	И НЕ К.ЭтоГруппа");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	ДобавитьВыборку(Запрос, "birth_date", СтрокаДаты(ДатаРождения), Предел, Найденные, Порядок, Обрезанные);

КонецПроцедуры

Процедура ИскатьПоНаименованиюОрганизации(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	Наименование = ЯдроНаименованияОрганизации(СтрокаИзКритериев(Критерии, "company_name"));
	Если СтрДлина(Наименование) < 3 Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("company_name");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	К.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	(К.Наименование ПОДОБНО &Шаблон ИЛИ К.НаименованиеПолное ПОДОБНО &Шаблон)
	|	И НЕ К.ЭтоГруппа");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Шаблон", "%" + Наименование + "%");
	ДобавитьВыборку(Запрос, "company_name", Наименование, Предел, Найденные, Порядок, Обрезанные);

КонецПроцедуры

Процедура ИскатьПоНомерамПолисов(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	Варианты = Новый Массив;
	Для Каждого Номер Из МассивИзКритериев(Критерии, "policy_numbers") Цикл
		Чистый = ЧистыйНомер(Номер);
		Если СтрДлина(Чистый) >= 5 Тогда
			ДобавитьВсе(Варианты, ВариантыАлфавита(Чистый));
		КонецЕсли;
	КонецЦикла;
	Если Варианты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Искали.Добавить("policy_number");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Полис
	|ПОМЕСТИТЬ ВТ_Полисы
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК П
	|ГДЕ
	|	П.Номер В (&Номера)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Б.Ссылка
	|ИЗ
	|	Документ.уб_СтраховойПолис.БСО КАК Б
	|ГДЕ
	|	(Б.НомерПолиса В (&Номера) ИЛИ Б.НомерБСО В (&Номера))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	П.Страхователь КАК Ссылка,
	|	П.Номер КАК Номер
	|ИЗ
	|	ВТ_Полисы КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК П
	|		ПО ВТ.Полис = П.Ссылка
	|ГДЕ
	|	П.Страхователь <> НЕОПРЕДЕЛЕНО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Номера", Варианты);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > Предел Тогда
		Обрезанные.Добавить("policy_number");
	КонецЕсли;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Предел Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Счетчик = Счетчик + 1;
			ДобавитьСовпадение(Найденные, Порядок, Выборка.Ссылка, "policy_number", СокрЛП(Выборка.Номер));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ИскатьПоТранспортнымСредствам(Критерии, Предел, Найденные, Порядок, Обрезанные, Искали)

	VIN = Новый Массив;
	Для Каждого Значение Из МассивИзКритериев(Критерии, "vins") Цикл
		Чистый = ЧистыйНомер(Значение);
		Если СтрДлина(Чистый) >= 9 Тогда
			ДобавитьВсе(VIN, ВариантыАлфавита(Чистый));
		КонецЕсли;
	КонецЦикла;
	Знаки = Новый Массив;
	Для Каждого Значение Из МассивИзКритериев(Критерии, "registration_numbers") Цикл
		Чистый = ЧистыйНомер(Значение);
		Если СтрДлина(Чистый) >= 6 Тогда
			ДобавитьВсе(Знаки, ВариантыАлфавита(Чистый));
		КонецЕсли;
	КонецЦикла;
	Если VIN.Количество() > 0 Тогда
		Искали.Добавить("vin");
		ИскатьПоРегиструТС("ИдентификационныйНомер", VIN, "vin", Предел, Найденные, Порядок, Обрезанные);
	КонецЕсли;
	Если Знаки.Количество() > 0 Тогда
		Искали.Добавить("registration_number");
		ИскатьПоРегиструТС("РегистрационныйЗнак", Знаки, "registration_number", Предел, Найденные, Порядок,
			Обрезанные);
	КонецЕсли;

КонецПроцедуры

// Страхователи последних полисов на машины, у которых реквизит ИмяПоля регистра уб_ТранспортныеСредства
// равен одному из Значений.
Процедура ИскатьПоРегиструТС(ИмяПоля, Значения, Признак, Предел, Найденные, Порядок, Обрезанные)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	Т.ИмяПоля КАК Значение
	|ПОМЕСТИТЬ ВТ_Объекты
	|ИЗ
	|	РегистрСведений.уб_ТранспортныеСредства КАК Т
	|ГДЕ
	|	Т.ИмяПоля В (&Значения)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	П.Страхователь КАК Ссылка,
	|	МАКСИМУМ(ВТ.Значение) КАК Значение,
	|	МАКСИМУМ(П.Дата) КАК Дата
	|ИЗ
	|	ВТ_Объекты КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.уб_СтраховойПолис КАК П
	|		ПО ВТ.Объект = П.ОбъектСтрахования
	|ГДЕ
	|	П.Страхователь <> НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	П.Страхователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяПоля", ИмяПоля);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел + 1, "ЧГ="));
	Запрос.УстановитьПараметр("Значения", Значения);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > Предел Тогда
		Обрезанные.Добавить(Признак);
	КонецЕсли;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Предел Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Счетчик = Счетчик + 1;
			ДобавитьСовпадение(Найденные, Порядок, Выборка.Ссылка, Признак, СокрЛП(Выборка.Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет в найденные все ссылки результата запроса с колонкой Ссылка под одним признаком.
Процедура ДобавитьВыборку(Запрос, Признак, Значение, Предел, Найденные, Порядок, Обрезанные)

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > Предел Тогда
		Обрезанные.Добавить(Признак);
	КонецЕсли;
	Счетчик = 0;
	Пока Выборка.Следующий() И Счетчик < Предел Цикл
		Счетчик = Счетчик + 1;
		ДобавитьСовпадение(Найденные, Порядок, Выборка.Ссылка, Признак, Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСовпадение(Найденные, Порядок, Ссылка, Признак, Значение)

	Совпадения = Найденные.Получить(Ссылка);
	Если Совпадения = Неопределено Тогда
		Совпадения = Новый Массив;
		Найденные.Вставить(Ссылка, Совпадения);
		Порядок.Добавить(Ссылка);
	КонецЕсли;
	Для Каждого Совпадение Из Совпадения Цикл
		Если Совпадение.key = Признак Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Совпадения.Добавить(Новый Структура("key, value", Признак, Значение));

КонецПроцедуры

#КонецОбласти

#Область Карточки

Функция КарточкиКандидатов(Порядок, Найденные, ПределПолисов)

	Физлица = Новый Массив;
	Контрагенты = Новый Массив;
	Для Каждого Ссылка Из Порядок Цикл
		Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Физлица.Добавить(Ссылка);
		ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
			Контрагенты.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Карточки = Новый Соответствие;
	ДобавитьКарточкиФизлиц(Карточки, Физлица);
	ДобавитьКарточкиКонтрагентов(Карточки, Контрагенты);
	ДобавитьКонтакты(Карточки, Порядок);
	ДобавитьЧислоПолисов(Карточки, Порядок);

	Результат = Новый Массив;
	Для Каждого Ссылка Из Порядок Цикл
		Карточка = Карточки.Получить(Ссылка);
		Если Карточка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Карточка.Вставить("matched_by", Найденные.Получить(Ссылка));
		Карточка.Вставить("policies", ПоследниеПолисы(Ссылка, ПределПолисов));
		Результат.Добавить(Карточка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКарточкиФизлиц(Карточки, Физлица)

	Если Физлица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ф.Ссылка КАК Ссылка,
	|	Ф.Наименование КАК Наименование,
	|	Ф.ПометкаУдаления КАК ПометкаУдаления,
	|	Ф.ДатаРождения КАК ДатаРождения,
	|	Ф.Пол КАК Пол,
	|	Ф.МестоРождения КАК МестоРождения,
	|	Ф.ИНН КАК ИНН,
	|	Ф.СтраховойНомерПФР КАК СНИЛС,
	|	Ф.ВодительскоеУдостоверениеСерия КАК ВУСерия,
	|	Ф.ВодительскоеУдостоверениеНомер КАК ВУНомер,
	|	Ф.ВодительскоеУдостоверениеДатаВыдачи КАК ВУДатаВыдачи,
	|	Ф.ВодительскоеУдостоверениеДатаНачалаСтажа КАК ВУДатаНачалаСтажа,
	|	ФИО.Фамилия КАК Фамилия,
	|	ФИО.Имя КАК Имя,
	|	ФИО.Отчество КАК Отчество,
	|	Паспорт.ДокументВид КАК ДокументВид,
	|	Паспорт.ДокументСерия КАК ДокументСерия,
	|	Паспорт.ДокументНомер КАК ДокументНомер,
	|	Паспорт.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	|	Паспорт.ДокументКемВыдан КАК ДокументКемВыдан,
	|	Паспорт.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	Гражданство.Страна КАК Гражданство
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Ф
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних(, ФизЛицо В (&Физлица)) КАК ФИО
	|		ПО (ФИО.ФизЛицо = Ф.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, ФизЛицо В (&Физлица)) КАК Паспорт
	|		ПО (Паспорт.ФизЛицо = Ф.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГражданствоФизЛиц.СрезПоследних(, ФизЛицо В (&Физлица)) КАК Гражданство
	|		ПО (Гражданство.ФизЛицо = Ф.Ссылка)
	|ГДЕ
	|	Ф.Ссылка В(&Физлица)");
	Запрос.УстановитьПараметр("Физлица", Физлица);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка = НоваяКарточка(Выборка.Ссылка, "person", Выборка.Наименование, Выборка.ПометкаУдаления);

		ЧастиИмени = ЧастиНаименования(Выборка.Наименование);
		Карточка.Вставить("last_name", ?(ЗначениеЗаполнено(Выборка.Фамилия), СокрЛП(Выборка.Фамилия), ЧастиИмени[0]));
		Карточка.Вставить("first_name", ?(ЗначениеЗаполнено(Выборка.Имя), СокрЛП(Выборка.Имя), ЧастиИмени[1]));
		Карточка.Вставить("middle_name",
			?(ЗначениеЗаполнено(Выборка.Фамилия), СокрЛП(Выборка.Отчество), ЧастиИмени[2]));
		Карточка.Вставить("birth_date", СтрокаДаты(Выборка.ДатаРождения));
		Карточка.Вставить("sex", ПредставлениеПола(Выборка.Пол));
		Карточка.Вставить("birth_place", СокрЛП(Выборка.МестоРождения));
		Карточка.Вставить("inn", СокрЛП(Выборка.ИНН));
		Карточка.Вставить("snils", СокрЛП(Выборка.СНИЛС));
		Карточка.Вставить("citizenship", СтрокаЗначения(Выборка.Гражданство));

		Если ЗначениеЗаполнено(Выборка.ДокументНомер) Тогда
			Паспорт = Новый Структура;
			Паспорт.Вставить("kind", СтрокаЗначения(Выборка.ДокументВид));
			Паспорт.Вставить("series", СокрЛП(Выборка.ДокументСерия));
			Паспорт.Вставить("number", СокрЛП(Выборка.ДокументНомер));
			Паспорт.Вставить("issue_date", СтрокаДаты(Выборка.ДокументДатаВыдачи));
			Паспорт.Вставить("issued_by", СокрЛП(Выборка.ДокументКемВыдан));
			Паспорт.Вставить("department_code", СокрЛП(Выборка.ДокументКодПодразделения));
			Карточка.Вставить("identity_document", Паспорт);
		Иначе
			Карточка.Вставить("identity_document", Неопределено);
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.ВУНомер) Тогда
			ВУ = Новый Структура;
			ВУ.Вставить("series", СокрЛП(Выборка.ВУСерия));
			ВУ.Вставить("number", СокрЛП(Выборка.ВУНомер));
			ВУ.Вставить("issue_date", СтрокаДаты(Выборка.ВУДатаВыдачи));
			ВУ.Вставить("experience_since", СтрокаДаты(Выборка.ВУДатаНачалаСтажа));
			Карточка.Вставить("driver_license", ВУ);
		Иначе
			Карточка.Вставить("driver_license", Неопределено);
		КонецЕсли;

		Карточки.Вставить(Выборка.Ссылка, Карточка);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКарточкиКонтрагентов(Карточки, Контрагенты)

	Если Контрагенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование,
	|	К.НаименованиеПолное КАК НаименованиеПолное,
	|	К.ПометкаУдаления КАК ПометкаУдаления,
	|	К.ЮрФизЛицо КАК ЮрФизЛицо,
	|	К.ЭтоИндивидуальныйПредприниматель КАК ЭтоИП,
	|	К.ИНН КАК ИНН,
	|	К.КПП КАК КПП,
	|	К.ОГРН КАК ОГРН,
	|	К.ДатаРождения КАК ДатаРождения,
	|	К.ДокументУдостоверяющийЛичность КАК ДокументУдостоверяющийЛичность,
	|	К.Физлицо КАК Физлицо
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Ссылка В(&Контрагенты)");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтоФизлицо = (Выборка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
		Карточка = НоваяКарточка(Выборка.Ссылка, ?(ЭтоФизлицо, "person", "company"), Выборка.Наименование,
			Выборка.ПометкаУдаления);
		Карточка.Вставить("full_name", СокрЛП(Выборка.НаименованиеПолное));
		Карточка.Вставить("is_individual_entrepreneur", Выборка.ЭтоИП);
		Карточка.Вставить("inn", СокрЛП(Выборка.ИНН));
		Карточка.Вставить("kpp", СокрЛП(Выборка.КПП));
		Карточка.Вставить("ogrn", СокрЛП(Выборка.ОГРН));
		Карточка.Вставить("birth_date", СтрокаДаты(Выборка.ДатаРождения));
		Карточка.Вставить("identity_document_text", СокрЛП(Выборка.ДокументУдостоверяющийЛичность));
		Если ЭтоФизлицо Тогда
			ЧастиИмени = ЧастиНаименования(Выборка.Наименование);
			Карточка.Вставить("last_name", ЧастиИмени[0]);
			Карточка.Вставить("first_name", ЧастиИмени[1]);
			Карточка.Вставить("middle_name", ЧастиИмени[2]);
		КонецЕсли;
		Карточка.Вставить("person_ref", ?(ЗначениеЗаполнено(Выборка.Физлицо), ОписаниеСсылки(Выборка.Физлицо),
			Неопределено));
		Карточки.Вставить(Выборка.Ссылка, Карточка);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКонтакты(Карточки, Ссылки)

	Для Каждого Элемент Из Карточки Цикл
		Элемент.Значение.Вставить("contacts", Новый Массив);
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.Объект КАК Объект,
	|	К.Тип КАК Тип,
	|	К.Вид КАК Вид,
	|	К.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК К
	|ГДЕ
	|	К.Объект В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка = Карточки.Получить(Выборка.Объект);
		Если Карточка = Неопределено Или ПустаяСтрока(Выборка.Представление) Тогда
			Продолжить;
		КонецЕсли;
		Контакт = Новый Структура;
		Контакт.Вставить("type", ИмяЗначенияПеречисления(Выборка.Тип));
		Контакт.Вставить("kind", СтрокаЗначения(Выборка.Вид));
		Контакт.Вставить("value", СокрЛП(Выборка.Представление));
		Карточка.contacts.Добавить(Контакт);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЧислоПолисов(Карточки, Ссылки)

	Для Каждого Элемент Из Карточки Цикл
		Элемент.Значение.Вставить("policies_total", 0);
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Страхователь КАК Страхователь,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК П
	|ГДЕ
	|	П.Страхователь В (&Ссылки)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.Страхователь");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка = Карточки.Получить(Выборка.Страхователь);
		Если Карточка <> Неопределено Тогда
			Карточка.policies_total = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПоследниеПолисы(Страхователь, Предел)

	Результат = Новый Массив;
	Если Предел <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	П.Ссылка КАК Ссылка,
	|	П.Номер КАК Номер,
	|	П.Дата КАК Дата,
	|	П.Проведен КАК Проведен,
	|	П.ПометкаУдаления КАК ПометкаУдаления,
	|	П.ДатаНачала КАК ДатаНачала,
	|	П.ДатаОкончания КАК ДатаОкончания,
	|	П.СК КАК СК,
	|	П.СтраховойПродукт КАК СтраховойПродукт,
	|	П.ВидС КАК ВидС,
	|	П.СостояниеПолиса КАК СостояниеПолиса,
	|	П.СтраховаяПремия КАК СтраховаяПремия,
	|	П.Собственник КАК Собственник,
	|	П.ОбъектСтрахования КАК ОбъектСтрахования,
	|	Т.ИдентификационныйНомер КАК VIN,
	|	Т.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	Т.МаркаТС КАК МаркаТС,
	|	Т.МодельТС КАК МодельТС,
	|	Т.ГодВыпуска КАК ГодВыпуска,
	|	Т.ПаспортСерия КАК ПаспортСерия,
	|	Т.ПаспортНомер КАК ПаспортНомер
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ТранспортныеСредства КАК Т
	|		ПО П.ОбъектСтрахования = Т.Объект
	|ГДЕ
	|	П.Страхователь = &Страхователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	П.Дата УБЫВ");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1000", Формат(Предел, "ЧГ="));
	Запрос.УстановитьПараметр("Страхователь", Страхователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Полис = Новый Структура;
		Полис.Вставить("uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Полис.Вставить("number", СокрЛП(Выборка.Номер));
		Полис.Вставить("date", СтрокаДаты(Выборка.Дата));
		Полис.Вставить("posted", Выборка.Проведен);
		Полис.Вставить("deletion_mark", Выборка.ПометкаУдаления);
		Полис.Вставить("start_date", СтрокаДаты(Выборка.ДатаНачала));
		Полис.Вставить("end_date", СтрокаДаты(Выборка.ДатаОкончания));
		Полис.Вставить("insurer", СтрокаЗначения(Выборка.СК));
		Полис.Вставить("product", СтрокаЗначения(Выборка.СтраховойПродукт));
		Полис.Вставить("insurance_kind", СтрокаЗначения(Выборка.ВидС));
		Полис.Вставить("state", СтрокаЗначения(Выборка.СостояниеПолиса));
		Полис.Вставить("premium", Выборка.СтраховаяПремия);
		Полис.Вставить("owner", СтрокаЗначения(Выборка.Собственник));
		Если ЗначениеЗаполнено(Выборка.ОбъектСтрахования) Тогда
			Объект = Новый Структура;
			Объект.Вставить("name", СтрокаЗначения(Выборка.ОбъектСтрахования));
			Объект.Вставить("vin", СокрЛП(Выборка.VIN));
			Объект.Вставить("registration_number", СокрЛП(Выборка.РегистрационныйЗнак));
			Объект.Вставить("make", СтрокаЗначения(Выборка.МаркаТС));
			Объект.Вставить("model", СтрокаЗначения(Выборка.МодельТС));
			Объект.Вставить("year", ?(ЗначениеЗаполнено(Выборка.ГодВыпуска), Выборка.ГодВыпуска, Неопределено));
			Объект.Вставить("vehicle_passport_series", СокрЛП(Выборка.ПаспортСерия));
			Объект.Вставить("vehicle_passport_number", СокрЛП(Выборка.ПаспортНомер));
			Полис.Вставить("insured_object", Объект);
		Иначе
			Полис.Вставить("insured_object", Неопределено);
		КонецЕсли;
		Результат.Добавить(Полис);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоваяКарточка(Ссылка, Вид, Наименование, ПометкаУдаления)

	Карточка = ОписаниеСсылки(Ссылка);
	Карточка.Вставить("kind", Вид);
	Карточка.Вставить("name", СокрЛП(Наименование));
	Карточка.Вставить("deletion_mark", ПометкаУдаления);
	Возврат Карточка;

КонецФункции

Функция ОписаниеСсылки(Ссылка)

	Описание = Новый Структура;
	Описание.Вставить("catalog", Ссылка.Метаданные().Имя);
	Описание.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("presentation", Строка(Ссылка));
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область Нормализация

Функция СтрокаИзКритериев(Критерии, Ключ)

	Значение = Неопределено;
	Если Не Критерии.Свойство(Ключ, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЧислоИзКритериев(Критерии, Ключ, ПоУмолчанию)

	Значение = Неопределено;
	Если Не Критерии.Свойство(Ключ, Значение) Или ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Макс(0, Мин(Цел(Значение), 200));

КонецФункции

Функция МассивИзКритериев(Критерии, Ключ)

	Результат = Новый Массив;
	Значение = Неопределено;
	Если Не Критерии.Свойство(Ключ, Значение) Или Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Строка") И Не ПустаяСтрока(Элемент) Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ТолькоЦифры(Значение)

	Результат = "";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Номер документа в том виде, в каком он записан в базе, и с пробелом в середине: часть записей хранит
// номер с разделителем.
Функция ВариантыНомераСПробелами(Номер)

	Варианты = Новый Массив;
	Варианты.Добавить(Номер);
	Если СтрДлина(Номер) = 4 Тогда
		Варианты.Добавить(Лев(Номер, 2) + " " + Прав(Номер, 2));
	КонецЕсли;
	Возврат Варианты;

КонецФункции

// Номер полиса, VIN или госномер в верхнем регистре без пробелов и знака «№».
Функция ЧистыйНомер(Значение)

	Результат = ВРег(СокрЛП(Значение));
	Для Каждого Лишнее Из СтрРазделить(" ,№,N°," + Символы.НПП + "," + Символы.Таб, ",") Цикл
		Результат = СтрЗаменить(Результат, Лишнее, "");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Все написания значения, в котором каждая буква, одинаково выглядящая в кириллице и латинице, может
// стоять в любом из двух алфавитов: в базе встречаются оба и их смесь. При большом числе таких букв
// возвращаются только исходное, полностью кириллическое и полностью латинское написания.
Функция ВариантыАлфавита(Значение)

	Кириллица = "АВЕКМНОРСТУХ";
	Латиница = "ABEKMHOPCTYX";
	Неоднозначных = 0;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если СтрНайти(Кириллица, Символ) > 0 Или СтрНайти(Латиница, Символ) > 0 Тогда
			Неоднозначных = Неоднозначных + 1;
		КонецЕсли;
	КонецЦикла;

	Варианты = Новый Массив;
	Если Неоднозначных > 6 Тогда
		Варианты.Добавить(Значение);
		ДобавитьБезПовтора(Варианты, Перекодировать(Значение, Латиница, Кириллица));
		ДобавитьБезПовтора(Варианты, Перекодировать(Значение, Кириллица, Латиница));
		Возврат Варианты;
	КонецЕсли;

	Варианты.Добавить("");
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		ПозицияК = СтрНайти(Кириллица, Символ);
		ПозицияЛ = СтрНайти(Латиница, Символ);
		Если ПозицияК = 0 И ПозицияЛ = 0 Тогда
			Для Индекс = 0 По Варианты.ВГраница() Цикл
				Варианты[Индекс] = Варианты[Индекс] + Символ;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Номер = Макс(ПозицияК, ПозицияЛ);
		Новые = Новый Массив;
		Для Каждого Вариант Из Варианты Цикл
			Новые.Добавить(Вариант + Сред(Кириллица, Номер, 1));
			Новые.Добавить(Вариант + Сред(Латиница, Номер, 1));
		КонецЦикла;
		Варианты = Новые;
	КонецЦикла;
	Возврат Варианты;

КонецФункции

Функция Перекодировать(Значение, Откуда, Куда)

	Результат = "";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Номер = СтрНайти(Откуда, Символ);
		Результат = Результат + ?(Номер > 0, Сред(Куда, Номер, 1), Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Часть имени для шаблона ПОДОБНО: без служебных символов шаблона и лишних пробелов.
Функция ЧастьИмени(Значение)

	Результат = СокрЛП(Значение);
	Для Каждого Лишнее Из СтрРазделить("%,_,[,],^,\", ",") Цикл
		Результат = СтрЗаменить(Результат, Лишнее, "");
	КонецЦикла;
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Наименование организации без организационно-правовой формы и кавычек: в базе записи вида «ООО Глобэкс»
// и «ООО "Глобэкс"», а на полисе - «Общество с ограниченной ответственностью «Глобэкс»».
Функция ЯдроНаименованияОрганизации(Значение)

	Результат = ВРег(" " + ЧастьИмени(Значение) + " ");
	Для Каждого Лишнее Из СтрРазделить("""|«|»|“|”|'", "|") Цикл
		Результат = СтрЗаменить(Результат, Лишнее, " ");
	КонецЦикла;
	Формы = СтрРазделить("ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ|ПУБЛИЧНОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО|"
		+ "АКЦИОНЕРНОЕ ОБЩЕСТВО|ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ| ООО | ПАО | АО | ЗАО | ОАО | ИП ", "|");
	Для Каждого Форма Из Формы Цикл
		Результат = СтрЗаменить(Результат, Форма, " ");
	КонецЦикла;
	Возврат ЧастьИмени(Результат);

КонецФункции

Функция ДатаИзСтроки(Значение)

	Цифры = ТолькоЦифры(Значение);
	Если СтрДлина(Цифры) <> 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Принимаются ГГГГ-ММ-ДД и ДД.ММ.ГГГГ.
	Если СтрНайти(Значение, ".") > 0 Тогда
		Цифры = Прав(Цифры, 4) + Сред(Цифры, 3, 2) + Лев(Цифры, 2);
	КонецЕсли;
	Попытка
		Результат = Дата(Число(Лев(Цифры, 4)), Число(Сред(Цифры, 5, 2)), Число(Прав(Цифры, 2)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(Год(Результат) < 1900, Неопределено, Результат);

КонецФункции

Функция СтрокаДаты(Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") Или Год(Значение) < 1900 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");

КонецФункции

Функция СтрокаЗначения(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ИмяЗначенияПеречисления(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Менеджер = Перечисления[Значение.Метаданные().Имя];
	Возврат Значение.Метаданные().ЗначенияПеречисления[Менеджер.Индекс(Значение)].Имя;

КонецФункции

Функция ПредставлениеПола(Пол)

	Если Пол = Перечисления.ПолФизическихЛиц.Мужской Тогда
		Возврат "male";
	ИначеЕсли Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
		Возврат "female";
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Фамилия, имя и отчество из наименования «Фамилия Имя Отчество»; отчество может состоять из нескольких
// слов («Оглы», «Кызы»).
Функция ЧастиНаименования(Наименование)

	Части = Новый Массив;
	Для Каждого Слово Из СтрРазделить(СокрЛП(Наименование), " ", Ложь) Цикл
		Части.Добавить(Слово);
	КонецЦикла;
	Результат = Новый Массив(3);
	Результат[0] = ?(Части.Количество() > 0, Части[0], "");
	Результат[1] = ?(Части.Количество() > 1, Части[1], "");
	Отчество = "";
	Для Индекс = 2 По Части.ВГраница() Цикл
		Отчество = Отчество + ?(Отчество = "", "", " ") + Части[Индекс];
	КонецЦикла;
	Результат[2] = Отчество;
	Возврат Результат;

КонецФункции

Процедура ДобавитьВсе(Приемник, Источник)

	Для Каждого Элемент Из Источник Цикл
		ДобавитьБезПовтора(Приемник, Элемент);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьБезПовтора(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
