// HTTP-сервис поиска страхователя: POST /hs/insurant/search. Тело - объект JSON с признаками клиента,
// ответ - кандидаты из 1С с карточками; состав полей описан у дор_ПоискСтрахователя.НайтиСтрахователя.

Функция ПоискPOST(Запрос)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку("UTF-8"));
		Критерии = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("error",
			"Тело запроса должно быть объектом JSON с латинскими именами полей: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Если ТипЗнч(Критерии) <> Тип("Структура") Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Тело запроса должно быть объектом JSON."));
	КонецЕсли;

	Попытка
		Результат = дор_ПоискСтрахователя.НайтиСтрахователя(Критерии);
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("дор_Страхователи.search", УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Возврат ОтветJSON(500, Новый Структура("error", Подробно));
	КонецПопытки;
	Возврат ОтветJSON(200, Результат);

КонецФункции

Функция ОтветJSON(Код, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции
