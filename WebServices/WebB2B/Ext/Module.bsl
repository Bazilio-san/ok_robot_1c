Функция ДайПятыйУровеньДерева(СП, ВидФайла)
	СтруктураФайлов = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	уб_ФайлыКПолисам.ФайлИмя КАК name,
	                      |	ВЫБОР
	                      |		КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	                      |			ТОГДА уб_ФайлыКПолисам.ДатаПубликации
	                      |		ИНАЧЕ ЕСТЬNULL(уб_ФайлыКПолисам.ВидДокумента.Наименование, """")
	                      |	КОНЕЦ КАК name_short,
	                      |	уб_ФайлыКПолисам.УИД КАК id,
	                      |	уб_ФайлыКПолисам.ФайлРазмер КАК size,
	                      |	уб_ФайлыКПолисам.ФайлРасширение КАК elem_type,
	                      |	ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.ДатаПубликации) КАК date
	                      |ИЗ
	                      |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	                      |ГДЕ
	                      |	ВЫБОР
	                      |			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
	                      |				ТОГДА ИСТИНА
	                      |			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	                      |		КОНЕЦ
	                      |	И ВЫБОР
	                      |			КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	                      |				ТОГДА ПОДСТРОКА(уб_ФайлыКПолисам.УИД, 1, 8) = &Параметр
	                      |			ИНАЧЕ уб_ФайлыКПолисам.ВидФайлаB2B = &Параметр
	                      |		КОНЕЦ
						  |	И (уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис
						  |	//РТ+
	                      |			ИЛИ уб_ФайлыКПолисам.СтраховойПолис В
	                      |				(ВЫБРАТЬ
	                      |					СП.Заявка
	                      |				ИЗ
	                      |					документ.уб_СтраховойПолис как СП
	                      |				ГДЕ
	                      |					СП.Ссылка = &СтраховойПолис
	                      |					И НЕ СП.Заявка = ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)))
						  |//РТ-
	                      |	И уб_ФайлыКПолисам.Размещен = ИСТИНА
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	name");
	Запрос.УстановитьПараметр("СтраховойПолис",СП);
	
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
	
	ЭтоОтчетПоставщика = ТипЗнч(СП) = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	Если ЭтоОтчетПоставщика Тогда
		ЗначениеПараметра = ВидФайла;
	Иначе
		ЗначениеПараметра = Перечисления.уб_ВидыФайловB2B[СтрЗаменить(ВидФайла, " ", "_")];
	КонецЕсли;
	Запрос.УстановитьПараметр("Параметр", ЗначениеПараметра);
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросПятыйУровеньДерева();
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выгрузить();
	Если ЭтоОтчетПоставщика Тогда
		Для Каждого СтрокаТЗ Из Выборка Цикл
			ДатаПубликации = СтрокаТЗ.name_short;
			СтрокаТЗ.name_short = Формат(ДатаПубликации, "ДФ=дд.ММ.гг");//+ " " + Формат(ДатаПубликации, "ДФ=ЧЧ-мм-сс")
		КонецЦикла;
	КонецЕсли;
	
	//For i = 0 to Выборка.Количество()-1 Do
	//	Структура3Влож = Новый Структура("name, name_short, id, size, elem_type, date",
	//									Выборка[i].name,
	//									Выборка[i].name_short,
	//									Выборка[i].id,
	//									Выборка[i].size,
	//									Выборка[i].elem_type,
	//									Строка(Выборка[i].date));
	//	СтруктураФайлов.Вставить("f"+i,Структура3Влож);
	//КонецЦикла;
	//
	//Возврат СтруктураФайлов;
	Возврат Выборка;
КонецФункции

