Функция RecoverPassword(mail)
	
	User = Справочники.уб_ПользователиB2B.НайтиПоРеквизиту("mail", mail);
	Если ЗначениеЗаполнено(User) Тогда
		ТС = "Ваш пароль: " + user.Пароль;
		Параметры = уб_ОбменДанными.ПараметрыСообщенияEMailПоУмолчанию();
		Параметры.Получатели 	= mail;
		Параметры.Тема			= "Восстановление пароля B2B";
		Параметры.Сообщение		= ТС;
		ОбратныйАдрес = уб_temp.КонтактнаяИнформация(ПараметрыСеанса.уб_ТекущееФизЛицо, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		Если Не ПустаяСтрока(ОбратныйАдрес) Тогда
			Параметры.ОбратныйАдрес = ОбратныйАдрес;
		КонецЕсли;
		Отправлено = уб_ОбменДанными.SendMail(Параметры);
		Если Отправлено Тогда
			Возврат уб_B2B.JSON(Новый Структура("status", "ok"));
		Иначе
			Возврат уб_B2B.JSON(Новый Структура("status, msg", "error", "При восстановлении пароля возникла ошибка, обратитесь к администратору"));
		КонецЕсли;
	Иначе
		Возврат уб_B2B.JSON(Новый Структура("status, msg", "error", "Пользователь с адресом электронной почты '" + mail + "' в базе не найден, обратитесь к администратору"));	
	КонецЕсли;
	
КонецФункции

