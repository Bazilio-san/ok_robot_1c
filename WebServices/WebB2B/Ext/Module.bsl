//Страховой полис
Функция ДайТретийУровеньДерева(ДатаНачала, ОргАгент, Поставщик)
	СтруктураФайлов = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уб_ФайлыКПолисам.СтраховойПолис КАК СП,
	|	ВЫБОР
	|		КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	|			ТОГДА ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.НомерОтчетаПоставщику, """")
	|		ИНАЧЕ ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Страхователь.Наименование, """")
	|	КОНЕЦ КАК Страхователь,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.УИД) КАК amountFile,
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Номер, """") КАК Номер,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.СтраховойПолис.ВидСП), """") КАК ВидСП
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	|		КОНЕЦ
	|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.Код = &ОрганизацияАгент
	|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик.Код = &Поставщик
	|	И уб_ФайлыКПолисам.СтраховойПолис.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И уб_ФайлыКПолисам.Размещен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	уб_ФайлыКПолисам.СтраховойПолис,
	|	ВЫБОР
	|		КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	|			ТОГДА ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.НомерОтчетаПоставщику, """")
	|		ИНАЧЕ ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Страхователь.Наименование, """")
	|	КОНЕЦ,
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Номер, """"),
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.СтраховойПолис.ВидСП), """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Страхователь");
	Запрос.УстановитьПараметр("ДатаНач",ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон",КонецМесяца(ДатаНачала));
	Запрос.УстановитьПараметр("ОрганизацияАгент",ОргАгент);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросТретийУровеньДерева();
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выгрузить();	
	
	For i = 0 to Выборка.Количество()-1 Do
		
		Если ТипЗнч(Выборка[i].СП) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
			title = уб_B2B.УбратьСимволы(Выборка[i].Страхователь) + " " + Выборка[i].ВидСП + " (" + Строка(Выборка[i].Номер) + ")";
		Иначе
			title = уб_B2B.УбратьСимволы(Выборка[i].Страхователь);
		КонецЕсли;
		
		amountFile = Выборка[i].amountFile;
		
		СтруктураФайлов.Вставить("f"+i, Новый Структура("cleaf, title, id, parent, amountFile",
		1,
		title,
		Выборка[i].СП.УникальныйИдентификатор(),
		Формат(ДатаНачала, "ДФ=""ггММ"""),
		amountFile));
		
	КонецЦикла;
	
	Возврат СтруктураФайлов;
КонецФункции

