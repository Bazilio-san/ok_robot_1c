	//|	ВидФайлаB2B");
	Запрос = Новый Запрос;   //РТ+ Новый Запрос
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	               |			ТОГДА ПОДСТРОКА(уб_ФайлыКПолисам.УИД, 1, 8)
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.ВидФайлаB2B)
	               |	КОНЕЦ КАК ВидФайлаB2B,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.УИД) КАК amountFile
	               |ИЗ
	               |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	               |		КОНЕЦ
	               |	И (уб_ФайлыКПолисам.СтраховойПолис = &СтраховойПолис
	               |			ИЛИ уб_ФайлыКПолисам.СтраховойПолис В
	               |				(ВЫБРАТЬ
	               |					СП.Заявка
	               |				ИЗ
	               |					документ.уб_СтраховойПолис как СП
	               |				ГДЕ
	               |					СП.Ссылка = &СтраховойПолис
	               |					И НЕ СП.Заявка = ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)))
