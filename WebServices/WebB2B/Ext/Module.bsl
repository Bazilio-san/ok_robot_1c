//ггММ для Incoming
Функция ДайТретийУровеньДереваIncoming(ОргАгент, Поставщик)
	СтруктураФайлов = Новый Структура;
	
	ЗапросIncoming = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	ПРЕДСТАВЛЕНИЕ(ГОД(уб_ФайлыКПолисамВходящие.ДатаРазмещения)) КАК Год,
	                              |	ПРЕДСТАВЛЕНИЕ(МЕСЯЦ(уб_ФайлыКПолисамВходящие.ДатаРазмещения)) КАК Месяц,
	                              |	уб_ФайлыКПолисамВходящие.ДатаРазмещения,
	                              |	уб_ФайлыКПолисамВходящие.ДатаРазмещения КАК ДатаРазмещения1
	                              |ИЗ
	                              |	РегистрСведений.уб_ФайлыКПолисамВходящие КАК уб_ФайлыКПолисамВходящие
	                              |ГДЕ
	                              |	уб_ФайлыКПолисамВходящие.Размещен = ИСТИНА
	                              |	И уб_ФайлыКПолисамВходящие.Поставщик.Код = &Поставщик
	                              |	И уб_ФайлыКПолисамВходящие.ОргАгент.Код = &ОрганизацияАгент");
	ЗапросIncoming.УстановитьПараметр("ОрганизацияАгент",ОргАгент);
	ЗапросIncoming.УстановитьПараметр("Поставщик",Поставщик);
	ВыборкаIncoming = ЗапросIncoming.Выполнить().Выгрузить();	
	For i = 0 to ВыборкаIncoming.Количество()-1 Do
		id = ?(СтрДлина(ВыборкаIncoming[i].Месяц)=1,
		Прав(ВыборкаIncoming[i].Год, 2) + "0" + ВыборкаIncoming[i].Месяц,
		Прав(ВыборкаIncoming[i].Год, 2) + ВыборкаIncoming[i].Месяц);
		МесяцП = Число(ВыборкаIncoming[i].Месяц);
		СтруктураФайлов.Вставить("f"+i,Новый Структура("cleaf, title, id, parent",
		0,
		МесяцПропписьюB2B(МесяцП) + " " + ВыборкаIncoming[i].Год + "г.",
		id,
		"INCOMING"));
	КонецЦикла;
	
	Возврат СтруктураФайлов;
КонецФункции

//Файлы
Функция ДайЧетвертыйУровеньДереваINCOMING(ДатаНачала, ОргАгент, Поставщик)
	СтруктураФайлов = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уб_ФайлыКПолисамВходящие.ИмяФайла КАК name,
	|	уб_ФайлыКПолисамВходящие.ИмяФайла КАК name_short,
	|	уб_ФайлыКПолисамВходящие.УИД КАК id,
	|	уб_ФайлыКПолисамВходящие.РазмерФайла КАК size,
	|	уб_ФайлыКПолисамВходящие.РасширениеФайла КАК elem_type,
	|	ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисамВходящие.ДатаРазмещения) КАК date,
	|	уб_ФайлыКПолисамВходящие.Комментарий КАК comment
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисамВходящие КАК уб_ФайлыКПолисамВходящие
	|ГДЕ
	|	уб_ФайлыКПолисамВходящие.Размещен = ИСТИНА
	|	И уб_ФайлыКПолисамВходящие.Поставщик.Код = &Поставщик
	|	И уб_ФайлыКПолисамВходящие.ОргАгент.Код = &ОргАгент
	|	И уб_ФайлыКПолисамВходящие.ДатаРазмещения МЕЖДУ &ДатаНач И &ДатаКон
	|
	|УПОРЯДОЧИТЬ ПО
	|	name");
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	Запрос.УстановитьПараметр("ОргАгент",ОргАгент);
	Запрос.УстановитьПараметр("ДатаНач",НачалоМесяца(ДатаНачала));
