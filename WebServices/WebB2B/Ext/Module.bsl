//Добавляем документ
Функция AddFile(sid, filename, comment)
	
	СтруктураПользователя = ДайДанныеПоSid(sid);
	
	NewFile = Новый Файл(filename);
	
	НовыйФайл = РегистрыСведений.уб_ФайлыКПолисамВходящие.СоздатьМенеджерЗаписи();
	НовыйФайл.ИмяФайла = NewFile.Имя;
	НовыйФайл.УИД = Строка(Новый УникальныйИдентификатор);
	НовыйФайл.РасширениеФайла = НРег(Прав(NewFile.Расширение, СтрДлина(NewFile.Расширение)-1));
	НовыйФайл.РазмерФайла = NewFile.Размер();
	НовыйФайл.Поставщик = СтруктураПользователя.Поставщик;
	НовыйФайл.ОргАгент = СтруктураПользователя.ОргАгент;
	НовыйФайл.Хранилище = Справочники.уб_ХранилищаФайловБ2Б.INCOMING;
	tempПуть = Прав(NewFile.Путь,СтрДлина(NewFile.Путь)-СтрДлина(Справочники.уб_ХранилищаФайловБ2Б.INCOMING.Путь)-1);
	НовыйФайл.ПутьКПапке = Лев(tempПуть, СтрДлина(tempПуть) - 1);
	НовыйФайл.Размещен = Истина;
	НовыйФайл.Комментарий = comment;
	НовыйФайл.Автор = СтруктураПользователя.Пользователь.ФизЛицо;
	НовыйФайл.ДатаРазмещения = ТекущаяДата();
	НовыйФайл.Записать(Истина);
	
	Возврат уб_B2B.JSON(Новый Структура("status", "ok"));
	
КонецФункции



Функция GetSavePath(sid)
	СтруктураПользователя = ДайДанныеПоSid(sid);
	
	Папка = "" + СтруктураПользователя.Поставщик.Folder + " - [" +СтруктураПользователя.ОргАгент.Folder + "]\" + Формат(ТекущаяДата(), "ДФ=""ггММ""") + "\";
	
	ПутьДоПапки = Новый Файл(Справочники.уб_ХранилищаФайловБ2Б.INCOMING.Путь + "\" + Папка);
	Если НЕ ПутьДоПапки.Существует() Тогда
		СоздатьКаталог(ПутьДоПапки.ПолноеИмя);
	КонецЕсли;
	
	Возврат уб_B2B.JSON(Новый Структура("status, data",
	"ok",
	Новый Структура("path", ПутьДоПапки.ПолноеИмя)))
КонецФункции


