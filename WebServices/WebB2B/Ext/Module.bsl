	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	               |			ТОГДА ПОДСТРОКА(уб_ФайлыКПолисам.УИД, 1, 8)
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.ВидФайлаB2B)
	               |	КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидФайлаB2B";
	Запрос.УстановитьПараметр("СтраховойПолис",СП);
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросЧетвертыйУровеньДерева();
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выгрузить();	
	ЭтоОтчетПоставщику = ТипЗнч(СП) = Тип("ДокументСсылка.уб_ОтчетПоставщику");
	Выборка.Колонки.Добавить("title");
	
	Для Каждого СтрокаТЗ Из Выборка Цикл
		Если ЭтоОтчетПоставщику Тогда
			СтрокаТЗ.title = Справочники.уб_ПечатныеФормы.НайтиПоКоду(Число(Сред(СтрокаТЗ.ВидФайлаB2B,3))).Наименование;
		Иначе
			СтрокаТЗ.title = СтрокаТЗ.ВидФайлаB2B;
		КонецЕсли;
	КонецЦикла;
	Выборка.Сортировать("title");
	For i = 0 to Выборка.Количество()-1 Do
		amountFile = Выборка[i].amountFile;
		СтруктураФайлов.Вставить("f"+i, Новый Структура("cleaf, title, id, parent, amountFile",
		0,
		Выборка[i].title,
		Выборка[i].ВидФайлаB2B,
		Строка(СП.УникальныйИдентификатор()),
		amountFile));
	КонецЦикла;
	
	Возврат СтруктураФайлов;
КонецФункции

