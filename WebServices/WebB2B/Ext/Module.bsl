//Функция создает нового страхователя ФизическиеЛица
// familija, imja, otchestvo - ФИО, задается отдельно
// birthday - дата рождения (YYYY-MM-DD)
// sex - пол.
//   male-мужской
//   female - женский
// Проверка на заполнение всех полей, дату на корректность
// Проверка на дубликаты. Ищет запросом по ФИО(Наименование), ДатаРождения, Пол
Функция CreateStrahovatelF(familija, imja, otchestvo, birthday, sex)
	error = "";
	Если familija = "" Или  imja = "" Или otchestvo = "" Или birthday = "" Или sex = "" Тогда 
		Если familija = "" Тогда error = error + "фамилия "; КонецЕсли;
		Если imja = "" Тогда error = error + "имя "; КонецЕсли;
		Если otchestvo = "" Тогда error = error + "отчество "; КонецЕсли;
		Если birthday = "" Тогда error = error + "дату рождения "; КонецЕсли;
		Если sex = "" Тогда error = error + "пол "; КонецЕсли;
		Возврат "[{ ""code"":""0"", ""name"":""Заполните следующие поля:"+error+" }]"
	КонецЕсли;	
	Попытка
		birthday = СтрЗаменить(birthday, "-", "");
		birthday = Дата(birthday);
	Исключение 
		Возврат "[{ ""code"":""0"", ""name"":""Некорректно заполнено поле Дата рождения"" }]"
	КонецПопытки;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ФизическиеЛица.Код КАК code,
	|	ФизическиеЛица.Наименование КАК name
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Наименование = &Наименование
	|	И ФизическиеЛица.ДатаРождения = &ДатаРождения
	|	И ФизическиеЛица.Пол = &Пол";
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Familija) + " " + СокрЛП(Imja) + " " + СокрЛП(Otchestvo));
	Запрос.УстановитьПараметр("ДатаРождения", birthday);
	Если sex = "male" Тогда
		Запрос.УстановитьПараметр("Пол", Перечисления.ПолФизическихЛиц.Мужской);
	ИначеЕсли sex = "female" Тогда
		Запрос.УстановитьПараметр("Пол", Перечисления.ПолФизическихЛиц.Женский);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		Возврат уб_B2B.JSON(Запрос.Выполнить().Выгрузить());
	КонецЕсли;
	
	НовыйСтрахователь = Справочники.ФизическиеЛица.СоздатьЭлемент();
	НовыйСтрахователь.Наименование = СокрЛП(Familija) + " " + СокрЛП(Imja) + " " + СокрЛП(Otchestvo);
	НовыйСтрахователь.Родитель = ПараметрыСеанса.уб_Константы.уб_ГруппаСтрахователейФизЛиц;
	НовыйСтрахователь.Автор = Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	ТекДата = ТекущаяДата();
	НовыйСтрахователь.ДатаСоздания = ТекДата;
	НовыйСтрахователь.ДатаИзменения = ТекДата;
	НовыйСтрахователь.Модификатор = НовыйСтрахователь.Автор;
	НовыйСтрахователь.Комментарий = "B2B";
	Если sex = "male" Тогда
		НовыйСтрахователь.Пол = Перечисления.ПолФизическихЛиц.Мужской;
	ИначеЕсли sex = "female" Тогда
		НовыйСтрахователь.Пол = Перечисления.ПолФизическихЛиц.Женский;
	КонецЕсли;
	НовыйСтрахователь.ДатаРождения = birthday;
	НовыйСтрахователь.Записать();
	МенеджерЗаписи = РегистрыСведений.ФИОФизЛиц.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ФизЛицо = НовыйСтрахователь.Ссылка;
	МенеджерЗаписи.Падеж = Перечисления.Падежи.Именительный;
	МенеджерЗаписи.Период = '19000101';
	МенеджерЗаписи.Фамилия = СокрЛП(Familija);
	МенеджерЗаписи.Имя = СокрЛП(Imja);
	МенеджерЗаписи.Отчество = СокрЛП(Otchestvo);
	МенеджерЗаписи.Записать(Истина);
	Возврат "[{ ""code"":""" + НовыйСтрахователь.Код + """, ""name"":""" + НовыйСтрахователь.Наименование + """ }]";
КонецФункции

//Функция возвращает список
//
Функция CreateStrahovatelU(name)
	Если name<>"" Тогда
		НайденныйКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(Name);
		Если НайденныйКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
			НовыйСтрахователь = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйСтрахователь.Наименование = name;
			НовыйСтрахователь.Родитель = ПараметрыСеанса.уб_Константы.уб_ГруппаСтрахователейЮрЛиц;
			НовыйСтрахователь.Автор = Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
			НовыйСтрахователь.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			НовыйСтрахователь.НаименованиеПолное = name;
			НовыйСтрахователь.НаименованиеКраткое = name;
			ТекДата = ТекущаяДата();
			НовыйСтрахователь.ДатаСоздания = ТекДата;
			НовыйСтрахователь.ДатаИзменения = ТекДата;
			НовыйСтрахователь.Модификатор = НовыйСтрахователь.Автор;
			НовыйСтрахователь.Комментарий = "B2B";
			НовыйСтрахователь.Записать();
			НовыйСтрахователь.ГоловнойКонтрагент = НовыйСтрахователь.Ссылка;
			НовыйСтрахователь.Записать();
			Возврат "[{ ""code"":""" + НовыйСтрахователь.Код + """, ""name"":""" + НовыйСтрахователь.Наименование + """ }]"
		Иначе
			Возврат "[{ ""code"":""" + НайденныйКонтрагент.Код + """, ""name"":""" + НайденныйКонтрагент.Наименование + """ }]"
		КонецЕсли;
		
	Иначе
		Возврат "[{ ""code"":""0"", ""name"":""Введите имя!+" + ПользователиИнформационнойБазы.ТекущийПользователь().Имя + "  "" }]"
	КонецЕсли;
КонецФункции

