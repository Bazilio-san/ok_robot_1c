//Поставщик, ОргАгент
Функция ДайПервыйУровеньДерева(ОргАгент, Поставщик)
	
	//СсылкаОргАгент	= Справочники.Организации.НайтиПоКоду(ОргАгент);
	//СсылкаПоставщик	= Справочники.Контрагенты.НайтиПоКоду(Поставщик);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.folder, """") КАК ОрганизацияАгентFolder,
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Поставщик.folder, """") КАК ПоставщикFolder,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.УИД) КАК amountFile
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	|		КОНЕЦ
	|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.Код = &ОрганизацияАгент
	|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик.Код = &Поставщик
	|	И уб_ФайлыКПолисам.Размещен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	уб_ФайлыКПолисам.СтраховойПолис.Поставщик,
	|	уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент,
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.folder, """"),
	|	ЕСТЬNULL(уб_ФайлыКПолисам.СтраховойПолис.Поставщик.folder, """")");
	
	Запрос.УстановитьПараметр("ОрганизацияАгент",ОргАгент);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА тогда
		Запрос.Текст = ЗапросПервыйУровеньДерева();
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выгрузить();
	
	amountFile = Выборка[0].amountFile;
	
	Возврат	Новый Структура("f0",
	Новый Структура("cleaf, title, id, amountFile",
	1,
	Выборка[0].ПоставщикFolder + " - [" + Выборка[0].ОрганизацияАгентFolder + "]",
	Поставщик + "," + ОргАгент,
	amountFile));
КонецФункции

