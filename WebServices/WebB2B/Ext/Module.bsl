//Функция возвращает список Страхователей
// param - код СтраховойКомпании
// date - примерная дата СтраховогоПолюса
// от этой даты +/- 14 дней (1209600 в секундах)
// требует доработки на вывод созданных через сайт
Функция GetStrahovatel(param, date)
	Попытка
		date = СтрЗаменить(date, "-", "");
		date = Дата(date);
	Исключение 
		Возврат "[{ ""code"":""0"", ""name"":""Некорректно заполнено поле Дата"" }]"
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА уб_СтраховойПолис.Страхователь.Родитель = &ГруппаЮрЛиц
	|			ТОГДА ""U"" + ЕстьNULL(уб_СтраховойПолис.Страхователь.Код, """")
	|		ИНАЧЕ ""F"" + ЕстьNULL(уб_СтраховойПолис.Страхователь.Код, """")
	|	КОНЕЦ КАК code,
	|	ЕстьNULL(уб_СтраховойПолис.Страхователь.Наименование, """") КАК name,
	|	ВЫБОР
	|		КОГДА уб_СтраховойПолис.Страхователь.Родитель = &ГруппаЮрЛиц
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК isindividual
	|ИЗ
	|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
	|ГДЕ
	|	уб_СтраховойПолис.СК = &СК
	|	И уб_СтраховойПолис.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	""U"" + Контрагенты.Код,
	|	Контрагенты.Наименование,
	|	0
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Родитель = &ГруппаЮрЛиц
	|	И Контрагенты.Автор = &Автор
	|	И Контрагенты.ДатаСоздания > &ДатаСоздания
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	""F"" + ЕстьNULL(ФизическиеЛица.Код, """"),
	|	ФИОФизЛицСрезПоследних.Фамилия + "" "" + (ВЫРАЗИТЬ(ФИОФизЛицСрезПоследних.Имя КАК СТРОКА(1))) + "" "" + (ВЫРАЗИТЬ(ФИОФизЛицСрезПоследних.Отчество КАК СТРОКА(1))),
	|	1
	|ИЗ
	|	РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО ФИОФизЛицСрезПоследних.ФизЛицо = ФизическиеЛица.Ссылка
	|ГДЕ
	|	ФизическиеЛица.Автор = &Автор
	|	И ФизическиеЛица.ДатаСоздания > &ДатаСоздания
	|
	|УПОРЯДОЧИТЬ ПО
	|	name";
	//
	Запрос.УстановитьПараметр("СК",Справочники.Контрагенты.НайтиПоКоду(param));
	Запрос.УстановитьПараметр("ГруппаЮрЛиц", ПараметрыСеанса.уб_Константы.уб_ГруппаСтрахователейЮрЛиц);
	Запрос.УстановитьПараметр("ГруппаФизЛиц", ПараметрыСеанса.уб_Константы.уб_ГруппаСтрахователейЮрЛиц);
	Запрос.УстановитьПараметр("ДатаНач", date - 1209600);// минус 2 недели
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(date + 1209600));// плюс 2 недели
	Запрос.УстановитьПараметр("ДатаСоздания", ТекущаяДата() - 2419200);//минус месяц
	Запрос.УстановитьПараметр("Автор", Справочники.Пользователи.НайтиПоКоду("ws"));
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		ob = уб_B2B.JSON(Запрос.Выполнить().Выгрузить());
	Иначе ob = "[]";
	КонецЕсли;
	Возврат ob;
КонецФункции

