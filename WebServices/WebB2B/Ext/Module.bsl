// запрос для справочника файлов
Функция ЗапросGetSearchResult(СтруктураПользователя, name, number, car_mark, car_model, product, date_begin, date_end)
	
	Доп = "";
	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлИмя КАК ФайлИмя,
	        |	уб_СтраховойПолисСписокФайлов.СсылкаСправочника.Код КАК УИД,
	        |	уб_СтраховойПолисСписокФайлов.ДатаПубликации КАК date,
	        |	ПРЕДСТАВЛЕНИЕ(уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ВидДокумента) КАК ВидДокумента,
	        |	уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлРасширение КАК ФайлРасширение,
	        |	уб_СтраховойПолисСписокФайлов.СсылкаСправочника.ФайлРазмер КАК ФайлРазмер
	        |ИЗ
	        |	Документ.уб_СтраховойПолис.СписокФайлов КАК уб_СтраховойПолисСписокФайлов
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
	        |		ПО уб_СтраховойПолисСписокФайлов.Ссылка.ОбъектСтрахования = уб_ТранспортныеСредства.Объект
	        |ГДЕ
	        |	уб_СтраховойПолисСписокФайлов.Ссылка.ОрганизацияАгент = &ОрганизацияАгент
	        |	И уб_СтраховойПолисСписокФайлов.Ссылка.Поставщик = &Поставщик
	        |	И уб_СтраховойПолисСписокФайлов.Опубликован = ИСТИНА";
	
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Если ПубликоватьОтчетыПоставщику <> Истина Тогда
		Доп = доп + Символы.ПС + "И Не уб_СтраховойПолисСписокФайлов.Ссылка Ссылка Документ.уб_ОтчетПоставщику";
	КонецЕсли;
	
	//Ищем по Страхователю
	Если ЗначениеЗаполнено(name) Тогда
		Доп = доп + Символы.ПС + "И уб_СтраховойПолисСписокФайлов.Ссылка.Страхователь.Наименование ПОДОБНО &Наименование";
	КонецЕсли;
	
	//Ищем по Номеру Страхового полиса
	Если ЗначениеЗаполнено(number) Тогда
		Доп = доп + Символы.ПС + "И уб_СтраховойПолисСписокФайлов.Ссылка.Номер ПОДОБНО &Номер";
	КонецЕсли;
	
	//Ищем по Страховому продукту
	Если ЗначениеЗаполнено(product) Тогда
		Доп = доп + Символы.ПС + "И уб_СтраховойПолисСписокФайлов.Ссылка.ВидС = &ВидСП";
	КонецЕсли;
	
	//Ищем за дате оформления Страхового полиса (ДатаНач)
	Если ЗначениеЗаполнено(date_begin) Тогда
		Доп = доп + Символы.ПС + "И уб_СтраховойПолисСписокФайлов.Ссылка.Дата >= &ДатаНач";
	КонецЕсли;
	
	//Ищем за дате оформления Страхового полиса (ДатаКон)
	Если ЗначениеЗаполнено(date_end) Тогда
		Доп = доп + Символы.ПС + "И уб_СтраховойПолисСписокФайлов.Ссылка.Дата <= &ДатаКон";
	КонецЕсли;
	
	//Ищем по Марке транспортного средства
	Если ЗначениеЗаполнено(car_mark) Тогда
		Доп = доп + Символы.ПС + "И уб_ТранспортныеСредства.МаркаТС.Код = &МаркаТС";
	КонецЕсли;
	
	//Ищем по Моделе транспортного средства
	Если ЗначениеЗаполнено(car_model) Тогда
		Доп = доп + Символы.ПС + "И уб_ТранспортныеСредства.МодельТС.Код = &МодельТС";
	КонецЕсли;
	
	Текст = Текст + доп;
	
	Возврат  Текст;
	
КонецФункции
