//Функция проверки ХЭШ суммы
Функция CheckKey(key)
	Если уб_B2B.ПолучитьПрочитатьKey(key) Тогда
		Возврат(уб_B2B.JSON(Новый Структура("status","ok")));
	Иначе
		Возврат(уб_B2B.JSON(Новый Структура("status","error")));
	КонецЕсли;
КонецФункции

//Получает данныe пользователя по Сессионному ключу
//Если активного ключа нет, запрашиваем данные с сервера В2В
Функция ДайДанныеПоSid(sid)
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	уб_СессионныеКлючиB2B.СрокЖизни КАК СрокЖизни,
	|	уб_СессионныеКлючиB2B.Ключ КАК Ключ,
	|	уб_СессионныеКлючиB2B.Поставщик КАК Поставщик,
	|	уб_СессионныеКлючиB2B.ОргАгент КАК ОргАгент,
	|	уб_СессионныеКлючиB2B.ПользовательB2B как Пользователь
	|ИЗ
	|	РегистрСведений.уб_СессионныеКлючиB2B КАК уб_СессионныеКлючиB2B
	|ГДЕ
	|	уб_СессионныеКлючиB2B.СрокЖизни >= &ТекущаяДата
	|	И уб_СессионныеКлючиB2B.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ",sid);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Выборка = Запрос.Выполнить().Выгрузить();
	
	//Если найден активный ключ и группа опеределена
	Если Выборка.Количество() <> 0 И НЕ Выборка[0].Поставщик.Пустая() И НЕ Выборка[0].ОргАгент.Пустая() Тогда
		СтруктураПользователя = Новый Структура("Пользователь, Поставщик, ОргАгент",
		Выборка[0].Пользователь,
		Выборка[0].Поставщик,
		Выборка[0].ОргАгент);
	Иначе
		//Запрашиваем данные пользователя по сессионному ключу у В2В
		ОтветСервера = уб_B2B.ОтправитьPOSTЗапросНаСервер("{""stask"":""getjuid"",""data"":{""sid"":"""+sid+"""}}");
		Если ОтветСервера.Получить("status") = "error" Тогда
			уб_B2B.ЗаписатьОшибкуИСообщить(ОтветСервера.Получить("msg"), ,Истина, УровеньЖурналаРегистрации.Ошибка);
		Иначе
			СтруктураПользователя = Новый Структура("Пользователь, Поставщик, ОргАгент", 
			Справочники.уб_ПользователиB2B.НайтиПоРеквизиту("JoomlaID",ОтветСервера.Получить("juid")),
			Справочники.Контрагенты.НайтиПоКоду(ОтветСервера.Получить("post")),
			Справочники.Организации.НайтиПоКоду(ОтветСервера.Получить("org")));
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уб_СессионныеКлючиB2B.ПользовательB2B,
		|	уб_СессионныеКлючиB2B.Поставщик,
		|	уб_СессионныеКлючиB2B.ОргАгент
		|ИЗ
		|	РегистрСведений.уб_СессионныеКлючиB2B КАК уб_СессионныеКлючиB2B
		|ГДЕ
		|	уб_СессионныеКлючиB2B.ПользовательB2B = &ПользовательB2B";
		
		Запрос.УстановитьПараметр("ПользовательB2B", СтруктураПользователя.Пользователь);
		НайденныйКлюч = Запрос.Выполнить().Выбрать();
		//Если ключ еще не создан, создаем
		Если НайденныйКлюч.Количество()=0 Тогда
			НовыйКлюч = РегистрыСведений.уб_СессионныеКлючиB2B.СоздатьМенеджерЗаписи(); 
			НовыйКлюч.ПользовательB2B = СтруктураПользователя.Пользователь; 
			НовыйКлюч.Поставщик = СтруктураПользователя.Поставщик; 
			НовыйКлюч.ОргАгент = СтруктураПользователя.ОргАгент; 
			НовыйКлюч.Ключ = sid;
			ОшибкаЗаписи = Истина;
			ДобавкаСекунд = 0;
			КоличествоЦиклов = 0;
			Пока ОшибкаЗаписи Цикл
				Попытка
					НовыйКлюч.СрокЖизни = ТекущаяДата() + 60*60 + ДобавкаСекунд; // + час + секунды
					НовыйКлюч.Записать(); 			
					ОшибкаЗаписи = Ложь;
				Исключение
					ДобавкаСекунд = ДобавкаСекунд + 1;
				КонецПопытки;
				КоличествоЦиклов = КоличествоЦиклов + 1;
				Если КоличествоЦиклов = 5 Тогда
					уб_B2B.ЗаписатьОшибкуИСообщить("Ошибка записи срока жизни ключа!" + СтруктураПользователя.Пользователь.ПолучитьОбъект(),, Истина, УровеньЖурналаРегистрации.Ошибка, , , "" + ОписаниеОшибки(), СтатусСообщения.Важное);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтруктураПользователя;
	
КонецФункции

//Получает данныe пользователя по Сессионному ключу
//Если активного ключа нет, запрашиваем данные с сервера В2В
Функция ДайДанныеПоSid_Старая(sid)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ПользователиB2BСессионыеКлючи.Ссылка КАК Пользователь,
	|	уб_ПользователиB2BСессионыеКлючи.Поставщик КАК Поставщик,
	|	уб_ПользователиB2BСессионыеКлючи.ОргАгент КАК ОргАгент
	|ИЗ
	|	Справочник.уб_ПользователиB2B.СессионыеКлючи КАК уб_ПользователиB2BСессионыеКлючи
	|ГДЕ
	|	уб_ПользователиB2BСессионыеКлючи.Ключ = &Ключ
	
	|	И уб_ПользователиB2BСессионыеКлючи.СрокЖизни >= &ТекущаяДата");
	
	Запрос.УстановитьПараметр("Ключ",sid);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Выборка = Запрос.Выполнить().Выгрузить();
	
	//Если найден активный ключ и группа опеределна
	Если Выборка.Количество() <> 0 И НЕ Выборка[0].Поставщик.Пустая() И НЕ Выборка[0].ОргАгент.Пустая() Тогда
		СтруктураПользователя = Новый Структура("Пользователь, Поставщик, ОргАгент",
		Выборка[0].Пользователь,
		Выборка[0].Поставщик,
		Выборка[0].ОргАгент);
	Иначе
		//Запрашиваем данные пользователя по сессионному ключу у В2В
		ОтветСервера = уб_B2B.ОтправитьPOSTЗапросНаСервер("{""stask"":""getjuid"",""data"":{""sid"":"""+sid+"""}}");
		Если ОтветСервера.Получить("status") = "error" Тогда
			уб_B2B.ЗаписатьОшибкуИСообщить(ОтветСервера.Получить("msg"), ,Истина, УровеньЖурналаРегистрации.Ошибка);
		Иначе
			СтруктураПользователя = Новый Структура("Пользователь, Поставщик, ОргАгент", 
			Справочники.уб_ПользователиB2B.НайтиПоРеквизиту("JoomlaID",ОтветСервера.Получить("juid")),
			Справочники.Контрагенты.НайтиПоКоду(ОтветСервера.Получить("post")),
			Справочники.Организации.НайтиПоКоду(ОтветСервера.Получить("org")));
		КонецЕсли;
		
		Пользователь = СтруктураПользователя.Пользователь.ПолучитьОбъект();
		НайденныйКлюч = Пользователь.СессионыеКлючи.Найти(sid, "Ключ");
		//Если ключ еще не создан, создаем
		Если НайденныйКлюч = Неопределено Тогда
			НовыйКлюч = Пользователь.СессионыеКлючи.Добавить();
			НовыйКлюч.Ключ = sid;
			НовыйКлюч.Поставщик = СтруктураПользователя.Поставщик;
			НовыйКлюч.ОргАгент = СтруктураПользователя.ОргАгент;
			НовыйКлюч.СрокЖизни = ТекущаяДата() + 60*60;// + час
		Иначе
			НайденныйКлюч.Поставщик = СтруктураПользователя.Поставщик;
			НайденныйКлюч.ОргАгент = СтруктураПользователя.ОргАгент;
		КонецЕсли;	
		Попытка 
			Пользователь.Записать();
		Исключение
			уб_B2B.ЗаписатьОшибкуИСообщить("Ошибка записи пользователя!" + Пользователь,, Истина, УровеньЖурналаРегистрации.Ошибка, , , "" + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
	КонецЕсли;
	
	Возврат СтруктураПользователя;
	
КонецФункции


//Возвращает список ГруппДоговоров для текущего пользователя
//
Функция GetGroups(sid)
	СтруктураПользователя = ДайДанныеПоSid(sid);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕСТЬNULL(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров.Наименование, """") КАК name,
	|	ЕСТЬNULL(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров.Поставщик.Код, """") + "","" + ЕСТЬNULL(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров.ОргАгент.Код, """") КАК id,
	|	ЕСТЬNULL(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров.ОргАгент.folder, """") КАК name_agent,
	|	ЕСТЬNULL(уб_СвязкаВ2ВПользователиГруппы.ГруппаДоговоров.Поставщик.folder, """") КАК name_provider
	|ИЗ
	|	РегистрСведений.уб_СвязкаВ2ВПользователиГруппы КАК уб_СвязкаВ2ВПользователиГруппы
	|ГДЕ
	|	уб_СвязкаВ2ВПользователиГруппы.Пользователь = &Пользователь");
	
	Запрос.УстановитьПараметр("Пользователь", СтруктураПользователя.Пользователь);
	ВыборкаГрупп = Запрос.Выполнить().Выгрузить();
	
	Если ВыборкаГрупп.Количество() <> 0 Тогда
		Структура = Новый Структура("status, group",
		"ok",
		ВыборкаГрупп);
	Иначе
		Структура = Новый Структура("status, msg",
		"error",
		?(СтруктураПользователя.Пользователь.Пустая(),
		"Пользователь в базе не найден, обратитесь к администратору!",
		"Групп для пользователя не определено, обратитесь к администратору!"));
	КонецЕсли;
	
	Возврат уб_B2B.JSON(Структура)
	
КонецФункции

//Возвращает следующий уровень дерева	//Переделать INCOMING
//
Функция GetFolderData(sid, id)
	
	СтруктураПользователя = ДайДанныеПоSid(sid);
	СтруктураФайлов = Новый Структура;
	
	//Разбиваем полученную строку на массив
	ПолученныйМассив = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(id, "/");
	КоличествоЭлементовМассива = ПолученныйМассив.Количество();
	
	//Если до 2ого уровня ищем по параметрам
	Если КоличествоЭлементовМассива >= 1 и КоличествоЭлементовМассива < 3 Тогда
		МассивПоставщикОргАгент = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ПолученныйМассив[0]);
		ПараметрПоставщик	= МассивПоставщикОргАгент[0];
		ПараметрОргАгент	= МассивПоставщикОргАгент[1];
		Если КоличествоЭлементовМассива = 2 Тогда
			Если ПолученныйМассив[1] <> "INCOMING" Тогда
				ПараметрДатаНачала = Дата("20" + ПолученныйМассив[1] + "01");
				ПараметрINCOMING = 0;
			Иначе
				ПараметрINCOMING = 1;
			КонецЕсли;
		КонецЕсли;
		//Если 3ого уровня ищем по Страховому полису
	ИначеЕсли КоличествоЭлементовМассива >= 3 Тогда
		Если ПолученныйМассив[1] <> "INCOMING" Тогда
			НовыйУИД = Новый УникальныйИдентификатор(ПолученныйМассив[2]);
			ПараметрСП	= Документы.уб_СтраховойПолис.ПолучитьСсылку(НовыйУИД);
			Если Не ЗначениеЗаполнено(ПараметрСП.Дата) Тогда
				ПараметрСП	= Документы.уб_ОтчетПоставщику.ПолучитьСсылку(НовыйУИД);
			КонецЕсли;
			Если КоличествоЭлементовМассива > 3 Тогда
				ПараметрВидФайла = ПолученныйМассив[3];
			КонецЕсли;
		Иначе
			ПараметрINCOMING = 1;
			МассивПоставщикОргАгент = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ПолученныйМассив[0]);
			ПараметрПоставщик	= МассивПоставщикОргАгент[0];
			ПараметрОргАгент	= МассивПоставщикОргАгент[1];
			ПараметрДатаINCOMING = Дата("20" + ПолученныйМассив[2] + "01");
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрСП) Тогда
		Если НЕ ЗначениеЗаполнено(ПараметрДатаНачала) Тогда
			
			Если ПараметрINCOMING = 1 Тогда
				Если НЕ ЗначениеЗаполнено(ПараметрДатаINCOMING) Тогда
					СтруктураУровень3INCOMING = ДайТретийУровеньДереваIncoming(ПараметрОргАгент, ПараметрПоставщик);
					
					Структура = Новый Структура("status, folder",
					"ok",
					СтруктураУровень3INCOMING);
				Иначе
					СтруктураУровень4INCOMING = ДайЧетвертыйУровеньДереваIncoming(ПараметрДатаINCOMING, ПараметрОргАгент, ПараметрПоставщик);
					
					Структура = Новый Структура("status, content",
					"ok",
					СтруктураУровень4INCOMING);
				КонецЕсли;
			Иначе
				
				СтуктураУровень2 = ДайВторойУровеньДерева(ПараметрОргАгент, ПараметрПоставщик);
				
				Структура = Новый Структура("status, folder",
				"ok",
				СтуктураУровень2);
			КонецЕсли;
		Иначе
			
			СтруктураУровень3 = ДайТретийУровеньДерева(ПараметрДатаНачала, ПараметрОргАгент, ПараметрПоставщик);
			
			Структура = Новый Структура("status, folder",
			"ok",
			СтруктураУровень3);
			
		КонецЕсли;
	Иначе
		Если ТипЗнч(ПараметрСП) = Тип("ДокументСсылка.уб_ОтчетПоставщику") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	уб_ОтчетПоставщику.НомерОтчетаПоставщику,
			|	уб_ОтчетПоставщику.Номер,
			|	ЕСТЬNULL(уб_ОтчетПоставщику.Поставщик.НаименованиеПолное, """") КАК ПоставщикНаименованиеПолное,
			|	ЕСТЬNULL(уб_ОтчетПоставщику.ОрганизацияАгент.НаименованиеДляДоговоровИПлатежныхДокументов, """") КАК ОрганизацияАгентНаименование,
			|	уб_ОтчетПоставщику.НачалоОтчетногоПериода,
			|	уб_ОтчетПоставщику.КонецОтчетногоПериода,
			|	ПРЕДСТАВЛЕНИЕ(уб_ОтчетПоставщику.ВидСП) КАК ВидСП,
			|	уб_ОтчетПоставщику.ИтогОС_НачисленнаяСуммаВзноса,
			|	уб_ОтчетПоставщику.ИтогОС_КВ,
			|	уб_ОтчетПоставщику.ИтогОС_КВДоп,
			|	уб_ОтчетПоставщику.КоличествоСтрокОплат,
			|	уб_ОтчетПоставщику.ДатаСогласования
			|ИЗ
			|	Документ.уб_ОтчетПоставщику КАК уб_ОтчетПоставщику
			|ГДЕ
			|	уб_ОтчетПоставщику.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", ПараметрСП);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				FolderComment = 
				"Отчет поставщику <span>№ " + Выборка.НомерОтчетаПоставщику + " (" + Выборка.Номер + ")" + "</span><br/>" +
				" Поставщик: <span>" + Выборка.ПоставщикНаименованиеПолное + "</span><br/>" +
				" Организация агент: <span>" + Выборка.ОрганизацияАгентНаименование + "</span><br/>" +
				" Отчетный период: <span>с " + Формат(Выборка.НачалоОтчетногоПериода, "ДФ=""дд ММММ гггг 'г.'""") + " по " + Формат(Выборка.КонецОтчетногоПериода, "ДФ=""дд ММММ гггг 'г.'""") + "</span><br/>" +
				" Вид страхового продукта: <span>" + Выборка.ВидСП + "</span><br/>" +
				" Итог взносов: <span>" +  Формат(Выборка.ИтогОС_НачисленнаяСуммаВзноса, "ЧЦ=15; ЧДЦ=2; ЧН=0") + "</span><br/>" +
				" Итог КВ: <span>" + Формат(Выборка.ИтогОС_КВ, "ЧЦ=15; ЧДЦ=2; ЧН=0") + "</span><br/>" +
				" Итог КВ Доп.: <span>" + Формат(Выборка.ИтогОС_КВДоп, "ЧЦ=15; ЧДЦ=2; ЧН=0") + "</span><br/>" +
				" Количество строк оплат: <span>" + Выборка.КоличествоСтрокОплат + "</span>";
				Если ЗначениеЗаполнено(Выборка.ДатаСогласования) Тогда
					FolderComment = FolderComment +	"<br/>" + 
					" Дата согласования: <span> " + Формат(Выборка.ДатаСогласования, "ДФ=""дд ММММ гггг 'г.'""") + "</span>";
				КонецЕсли;
			Иначе
				FolderComment = "Отчет поставщику не найден."
			КонецЕсли;
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	уб_СтраховойПолис.Номер,
			|	ЕСТЬNULL(уб_СтраховойПолис.ОбъектСтрахования.Наименование, """") КАК ОбъектСтрахованияНаименование,
			|	ЕСТЬNULL(уб_СтраховойПолис.Страхователь.Наименование, """") КАК СтраховательНаименование,
			|	ЕСТЬNULL(уб_СтраховойПолис.СК.НаименованиеПолное, """") КАК СКНаименованиеПолное,
			|	ЕСТЬNULL(уб_СтраховойПолис.ОрганизацияАгент.НаименованиеДляДоговоровИПлатежныхДокументов, """") КАК ОрганизацияАгентНаименование,
			|	уб_СтраховойПолис.ДатаНачала,
			|	уб_СтраховойПолис.ДатаОкончания,
			|	ЕСТЬNULL(уб_СтраховойПолис.Агент.Наименование, """") КАК АгентНаименование,
			|	ЕСТЬNULL(уб_СтраховойПолис.СтраховойПродукт.Наименование, """") КАК СтраховойПродуктНаименование,
			|	уб_СтраховойПолис.Курьер,
			|	ЕСТЬNULL(уб_СтраховойПолис.Курьер.Наименование, """") КАК КурьерНаименование
			|ИЗ
			|	Документ.уб_СтраховойПолис КАК уб_СтраховойПолис
			|ГДЕ
			|	уб_СтраховойПолис.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", ПараметрСП);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				FolderComment = 
				"Страховой полис <span>№ " + Выборка.Номер + "</span><br/>" +
				" Объект страхования: <span>" + Выборка.ОбъектСтрахованияНаименование + "</span><br/>" +
				" Страхователь: <span>" + Выборка.СтраховательНаименование + "</span><br/>" +
				" Страховая компания: <span>" + Выборка.СКНаименованиеПолное+ "</span><br/>" +
				" Организация агент: <span>" + Выборка.ОрганизацияАгентНаименование + "</span><br/>" +
				" Срок страхования: <span>с " + Формат(Выборка.ДатаНачала, "ДФ=""дд ММММ гггг 'г.'""") + " по " + Формат(Выборка.ДатаОкончания, "ДФ=""дд ММММ гггг 'г.'""") + "</span><br/>" +
				" Агент: <span>" + Выборка.АгентНаименование + "</span><br/>" +
				" Вид страхового продукта: <span>" + Выборка.СтраховойПродуктНаименование + "</span>" +
				?(НЕ ЗначениеЗаполнено(Выборка.Курьер), "" , "<br/>" + "Курьер: <span>" + Выборка.КурьерНаименование + "</span>");
			Иначе
				FolderComment = "Страховой полис не найден."
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПараметрВидФайла) Тогда
			
			СтруктураУровень4 = ДайЧетвертыйУровеньДерева(ПараметрСП);
			
			Структура = Новый Структура("status, folder, comment",
			"ok",
			СтруктураУровень4,
			СтрЗаменить(FolderComment, """", ""));
		Иначе
			
			Структура5Уровня = ДайПятыйУровеньДерева(ПараметрСП, ПараметрВидФайла);
			
			Структура = Новый Структура("status, content, comment",
			"ok",
			Структура5Уровня,
			СтрЗаменить(FolderComment, """", ""));
		КонецЕсли;
	КонецЕсли;
	
	Возврат уб_B2B.JSON(Структура);
КонецФункции

Функция GetTree(sid, id)
	СтруктураПользователя = ДайДанныеПоSid(sid);
	СтруктураСтруктур = Новый Структура;
	
	//Разбиваем полученную строку на массив
	СтруктураПараметров = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(id, "/");
	КоличествоПараметров = СтруктураПараметров.Количество();
	
	Если КоличествоПараметров >= 1 Тогда
		МассивПоставщикОргАгент = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтруктураПараметров[0]);
		ПараметрПоставщик	= МассивПоставщикОргАгент[0];
		ПараметрОргАгент	= МассивПоставщикОргАгент[1];
		
		Структура1Уровня = ДайПервыйУровеньДерева(ПараметрОргАгент, ПараметрПоставщик);
		
		СтруктураСтруктур.Вставить("folder1",Структура1Уровня);
		
		Структура2Уровня = ДайВторойУровеньДерева(ПараметрОргАгент, ПараметрПоставщик);
		
		СтруктураСтруктур.Вставить("folder2",Структура2Уровня);
	КонецЕсли;
	
	
	Если КоличествоПараметров >= 2 Тогда
		Если СтруктураПараметров[1] <> "INCOMING" Тогда
			ПараметрДатаНачала = Дата("20" + СтруктураПараметров[1] + "01");
			Структура3Уровня = ДайТретийУровеньДерева(ПараметрДатаНачала, ПараметрОргАгент, ПараметрПоставщик);
		Иначе
			Структура3Уровня = ДайТретийУровеньДереваIncoming(ПараметрОргАгент, ПараметрПоставщик);
		КонецЕсли;
		
		СтруктураСтруктур.Вставить("folder3", Структура3Уровня);
	КонецЕсли;
	
	Если КоличествоПараметров >= 3 И СтруктураПараметров[1] <> "INCOMING" Тогда
		НовыйУИД = Новый УникальныйИдентификатор(СтруктураПараметров[2]);
		ПараметрСП	= Документы.уб_СтраховойПолис.ПолучитьСсылку(НовыйУИД);
		Если Не ЗначениеЗаполнено(ПараметрСП.Дата) Тогда
			ПараметрСП	= Документы.уб_ОтчетПоставщику.ПолучитьСсылку(НовыйУИД);
		КонецЕсли;
		
		Структура4Уровня = ДайЧетвертыйУровеньДерева(ПараметрСП);
		
		СтруктураСтруктур.Вставить("folder4",Структура4Уровня);
	КонецЕсли;
	
	СтруктураСтруктурСтруктур = Новый Структура("status, content",
	"ok",
	СтруктураСтруктур);
	Возврат(уб_B2B.JSON(СтруктураСтруктурСтруктур));
КонецФункции

//Возвращает список файлов, соотвествующего критериям поиска
Функция GetSearchResult(sid, name, number, car_mark, car_model, product, date_begin, date_end)
	СтруктураПользователя = ДайДанныеПоSid(sid);
	СтруктураФайлов = Новый Структура;
	Запрос = Новый Запрос;
	Доп = "";
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уб_ФайлыКПолисам.ФайлИмя КАК ФайлИмя,
	|	уб_ФайлыКПолисам.УИД КАК УИД,
	|	уб_ФайлыКПолисам.ДатаПубликации КАК date,
	|	Представление(уб_ФайлыКПолисам.ВидДокумента) КАК ВидДокумента,
	|	уб_ФайлыКПолисам.ФайлРасширение КАК ФайлРасширение,
	|	уб_ФайлыКПолисам.ФайлРазмер КАК ФайлРазмер
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
	|		ПО уб_ФайлыКПолисам.СтраховойПолис.ОбъектСтрахования = уб_ТранспортныеСредства.Объект
	|ГДЕ
	|	уб_ФайлыКПолисам.Размещен = ИСТИНА
	|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент = &ОрганизацияАгент
	|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик = &Поставщик");
	Запрос.УстановитьПараметр("ОрганизацияАгент", СтруктураПользователя.ОргАгент);
	Запрос.УстановитьПараметр("Поставщик", СтруктураПользователя.Поставщик);
	
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Если ПубликоватьОтчетыПоставщику <> Истина Тогда
		Доп = доп + Символы.ПС + "И Не уб_ФайлыКПолисам.СтраховойПолис Ссылка Документ.уб_ОтчетПоставщику";
	КонецЕсли;
	
	//Ищем по Страхователю
	Если ЗначениеЗаполнено(name) Тогда
		Доп = доп + Символы.ПС + "И уб_ФайлыКПолисам.СтраховойПолис.Страхователь.Наименование ПОДОБНО &Наименование";
		Запрос.УстановитьПараметр("Наименование", "%"+name+"%");
	КонецЕсли;
	
	//Ищем по Номеру Страхового полиса
	Если ЗначениеЗаполнено(number) Тогда
		Доп = доп + Символы.ПС + "И уб_ФайлыКПолисам.СтраховойПолис.Номер ПОДОБНО &Номер";
		Запрос.УстановитьПараметр("Номер", "%"+number+"%");
	КонецЕсли;
	
	//Ищем по Страховому продукту
	Если ЗначениеЗаполнено(product) Тогда
		Доп = доп + Символы.ПС + "И уб_ФайлыКПолисам.СтраховойПолис.ВидС = &ВидСП";
		Запрос.УстановитьПараметр("ВидСП", Перечисления.уб_ВидыСтрахования[product]);
	КонецЕсли;
	
	//Ищем за дате оформления Страхового полиса (ДатаНач)
	Если ЗначениеЗаполнено(date_begin) Тогда
		Доп = доп + Символы.ПС + "И уб_ФайлыКПолисам.СтраховойПолис.Дата >= &ДатаНач";
		Запрос.УстановитьПараметр("ДатаНач", Дата(СтрЗаменить(date_begin, ".","")));
	КонецЕсли;
	
	//Ищем за дате оформления Страхового полиса (ДатаКон)
	Если ЗначениеЗаполнено(date_end) Тогда
		Доп = доп + Символы.ПС + "И уб_ФайлыКПолисам.СтраховойПолис.Дата <= &ДатаКон";
		Запрос.УстановитьПараметр("ДатаКон", Дата(СтрЗаменить(date_end, ".","")));
	КонецЕсли;
	
	//Ищем по Марке транспортного средства
	Если ЗначениеЗаполнено(car_mark) Тогда
		Доп = доп + Символы.ПС + "И уб_ТранспортныеСредства.МаркаТС.Код = &МаркаТС";
		Запрос.УстановитьПараметр("МаркаТС", Число(car_mark));
	КонецЕсли;
	
	//Ищем по Моделе транспортного средства
	Если ЗначениеЗаполнено(car_model) Тогда
		Доп = доп + Символы.ПС + "И уб_ТранспортныеСредства.МодельТС.Код = &МодельТС";
		Запрос.УстановитьПараметр("МодельТС", Число(car_model));
	КонецЕсли;
	
	//чкн
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросGetSearchResult(СтруктураПользователя, name, number, car_mark, car_model, product, date_begin, date_end);
	Иначе
		Запрос.Текст = Запрос.Текст + доп;
	КонецЕсли;
	//чкн
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество()=0 Тогда 
		Структура = Новый Структура;
		Структура.Вставить("status","error");
		Структура.Вставить("msg","Не найдено ни одного документа, соответствующего запросу! Убедитесь, что все слова написаны без ошибок");	
		Возврат(уб_B2B.JSON(Структура));
		//Перевести в констанкты	
	ИначеЕсли Выборка.Количество()>300 Тогда
		Структура = Новый Структура;
		Структура.Вставить("status","error");
		Структура.Вставить("msg","Количество найденых документов превышает допустимое! Уточните поиск");	
		Возврат(уб_B2B.JSON(Структура));
	КонецЕсли;
	
	For i = 0 to Выборка.Количество()-1 Do
		Структура3Влож = Новый Структура;
		Структура3Влож.Вставить("name", Выборка[i].ФайлИмя);
		Структура3Влож.Вставить("name_short", Выборка[i].ВидДокумента);
		Структура3Влож.Вставить("id", Выборка[i].УИД);
		Структура3Влож.Вставить("size", Выборка[i].ФайлРазмер);
		Структура3Влож.Вставить("elem_type", Выборка[i].ФайлРасширение);
		Структура3Влож.Вставить("date", Строка(Выборка[i].date));
		
		СтруктураФайлов.Вставить("f"+i,Структура3Влож);
	КонецЦикла;
	
	Структура = Новый Структура;
	Структура.Вставить("status","ok");
	Структура.Вставить("content",СтруктураФайлов);	
	
	Возврат(уб_B2B.JSON(Структура));
КонецФункции

