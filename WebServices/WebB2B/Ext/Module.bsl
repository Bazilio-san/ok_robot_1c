Функция GetFilePath(sid, id)
	//Вставить проверку если id > 36 символом ошибку!
	СтруктураПользователя = ДайДанныеПоSid(sid);
	НЗфайлы = РегистрыСведений.уб_ФайлыКПолисам.СоздатьНаборЗаписей();
	НЗфайлы.Отбор.УИД.Значение      = id;
	НЗфайлы.Отбор.УИД.Использование = Истина;
	НЗфайлы.Отбор.УИД.ВидСравнения 	= ВидСравнения.Равно;
	НЗфайлы.Прочитать();
	//КоличествоЗаписей = НЗфайлы.Выгрузить().Количество();
	КоличествоЗаписей = НЗфайлы.Количество();
	Если КоличествоЗаписей = 0 Тогда
		НЗфайлы = РегистрыСведений.уб_ФайлыКПолисамВходящие.СоздатьНаборЗаписей();
		НЗфайлы.Отбор.УИД.Значение      = id;
		НЗфайлы.Отбор.УИД.Использование = Истина;
		НЗфайлы.Отбор.УИД.ВидСравнения 	= ВидСравнения.Равно;
		НЗфайлы.Прочитать();
		Incoming = Истина;
	Иначе
		Incoming = Ложь;
	КонецЕсли;
	
	ПутьКХранилищу = ?(СокрЛП(НЗфайлы[0].Хранилище.Путь) = "","",НЗфайлы[0].Хранилище.Путь + "\");
	ПолныйПуть = ПутьКХранилищу + НЗфайлы[0].ПутьКПапке + "\" + ?(КоличествоЗаписей = 0, НЗфайлы[0].ИмяФайла, НЗфайлы[0].ФайлИмя);
	ПолныйПуть = СтрЗаменить(ПолныйПуть, "\", "\\");
	Структура = Новый Структура("status, path, sk, ggmm, type",
	"ok",
	ПолныйПуть,
	?(Incoming, СтруктураПользователя.Поставщик.Код ,НЗфайлы[0].СтраховойПолис.Поставщик.Код),
	?(Incoming, Формат(НЗфайлы[0].ДатаРазмещения, "ДФ=""ггММ""") ,Формат(НЗфайлы[0].СтраховойПолис.Дата, "ДФ=""ггММ""")),
	НЗфайлы[0].Хранилище);
	Возврат уб_B2B.JSON(Структура);
КонецФункции

