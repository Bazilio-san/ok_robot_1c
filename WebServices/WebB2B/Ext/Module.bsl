//ггММ
Функция ДайВторойУровеньДерева(ОргАгент, Поставщик)
	СтруктураФайлов = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.ГодПолиса) КАК Год,
	|	ПРЕДСТАВЛЕНИЕ(уб_ФайлыКПолисам.МесяцПолиса) КАК Месяц,
	|	уб_ФайлыКПолисам.ГодПолиса КАК Год2,
	|	уб_ФайлыКПолисам.МесяцПолиса КАК Месяц2,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ уб_ФайлыКПолисам.УИД) КАК amountFile
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПубликоватьОтчетыПоставщику = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ уб_ФайлыКПолисам.СтраховойПолис ССЫЛКА Документ.уб_ОтчетПоставщику
	|		КОНЕЦ
	|	И уб_ФайлыКПолисам.СтраховойПолис.ОрганизацияАгент.Код = &ОрганизацияАгент
	|	И уб_ФайлыКПолисам.СтраховойПолис.Поставщик.Код = &Поставщик
	|	И уб_ФайлыКПолисам.Размещен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	уб_ФайлыКПолисам.ГодПолиса,
	|	уб_ФайлыКПолисам.МесяцПолиса
	|
	|УПОРЯДОЧИТЬ ПО
	|	Год2 УБЫВ,
	|	Месяц2 УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПРЕДСТАВЛЕНИЕ(ГОД(уб_ФайлыКПолисамВходящие.ДатаРазмещения)) КАК Год,
	|	ПРЕДСТАВЛЕНИЕ(МЕСЯЦ(уб_ФайлыКПолисамВходящие.ДатаРазмещения)) КАК Месяц,
	|	ГОД(уб_ФайлыКПолисамВходящие.ДатаРазмещения) КАК Год2,
	|	МЕСЯЦ(уб_ФайлыКПолисамВходящие.ДатаРазмещения) КАК Месяц2
	|ИЗ
	|	РегистрСведений.уб_ФайлыКПолисамВходящие КАК уб_ФайлыКПолисамВходящие
	|ГДЕ
	|	уб_ФайлыКПолисамВходящие.Поставщик.Код = &Поставщик
	|	И уб_ФайлыКПолисамВходящие.ОргАгент.Код = &ОрганизацияАгент
	|	И уб_ФайлыКПолисамВходящие.Размещен = ИСТИНА");
	Запрос.УстановитьПараметр("ОрганизацияАгент",ОргАгент);
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	
	ПубликоватьОтчетыПоставщику = ПараметрыСеанса.уб_Константы.уб_ПубликоватьОтчетыПоставщикуПаb2b;
	Запрос.УстановитьПараметр("ПубликоватьОтчетыПоставщику", ПубликоватьОтчетыПоставщику = Истина);
	
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросВторойУровеньДерева();
	КонецЕсли;

	Результат = Запрос.ВыполнитьПакет();
	Выборка = Результат[0].Выгрузить();
	ВыборкаIncoming = Результат[1].Выбрать();
	
	Если ВыборкаIncoming.Количество() <> 0 Тогда
		СтруктураФайлов.Вставить("f"+Выборка.Количество(),Новый Структура("cleaf, title, id, parent",
		1,
		"INCOMING",
		"INCOMING",
		Поставщик + "," + ОргАгент));
	КонецЕсли;
	
	For i = 0 to Выборка.Количество()-1 Do
		id = ?(СтрДлина(Выборка[i].Месяц)=1,
		Прав(Выборка[i].Год, 2) + "0" + Выборка[i].Месяц,
		Прав(Выборка[i].Год, 2) + Выборка[i].Месяц);
		
		МесяцП = Выборка[i].Месяц2;
		
		amountFile = Выборка[i].amountFile;

		СтруктураФайлов.Вставить("f"+i,Новый Структура("cleaf, title, id, parent, amountFile",
		1,
		//Формат(Дата("0001"+Выборка[i].Месяц+"01000000"),"ДФ=ММММ") + " 2" + Прав(Выборка[i].Год, 3) + "г.",
		МесяцПропписьюB2B(МесяцП) + " 2" + Прав(Выборка[i].Год, 3) + "г.",
		id,
		Поставщик + "," + ОргАгент,
		amountFile));
	КонецЦикла;
	
	Возврат СтруктураФайлов;
КонецФункции

