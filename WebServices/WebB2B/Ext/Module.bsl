//Функция возвращает список СтраховыхПродуктов по параметру
// param - код СтраховойКомпании
// isauto - признак СтраховогоПродукта для авто
// isauto = 1, если ОСАГО, КАСКО, ДСАГО
// Справочник.уб_СтраховыеПродукты
Функция GetSP(param)
	Структура = Новый Структура;
	Запрос=Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Представление(уб_СтраховыеПродукты.Вид) КАК code,
	|	Представление(уб_СтраховыеПродукты.Вид) КАК name,
	|	ВЫБОР
	|		КОГДА уб_СтраховыеПродукты.Вид В (&СписокСП)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК isauto
	|ИЗ
	|	Справочник.уб_СтраховыеПродукты КАК уб_СтраховыеПродукты";
	Если param <> "-1" Тогда 
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	уб_СтраховыеПродукты.Владелец.Код = &СК";
		Запрос.УстановитьПараметр("СК",Строка(param));
	КонецЕсли;
	
	СписокСП = Новый СписокЗначений; //Виды для СП для машин
	СписокСП.Добавить(Перечисления.уб_ВидыСтраховыхПродуктов.ДСАГО);
	СписокСП.Добавить(Перечисления.уб_ВидыСтраховыхПродуктов.ОСАГО);
	СписокСП.Добавить(Перечисления.уб_ВидыСтраховыхПродуктов.КАСКО);
	СписокСП.Добавить(Перечисления.уб_ВидыСтраховыхПродуктов.ЕОСАГО);
	СписокСП.Добавить(Перечисления.уб_ВидыСтраховыхПродуктов.ЕКАСКО);
	
	Запрос.УстановитьПараметр("СписокСП",СписокСП);
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		Структура.Вставить("status", "ok");
		Структура.Вставить("data", Выборка);
	Иначе 
		Структура.Вставить("status", "error");
		Структура.Вставить("msg", "Пустой запрос!");
	КонецЕсли;
	возврат уб_B2B.JSON(Структура)
КонецФункции

