Функция GetFilesPath(sid, id)
	СтруктураПользователя = ДайДанныеПоSid(sid);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА ЕСТЬNULL(уб_ФайлыКПолисам.Хранилище.Путь, """") = """"
	                      |			ТОГДА """"
	                      |		ИНАЧЕ уб_ФайлыКПолисам.Хранилище.Путь + ""\""
	                      |	КОНЕЦ + уб_ФайлыКПолисам.ПутьКПапке + ""\"" + уб_ФайлыКПолисам.ФайлИмя КАК path
	                      |ИЗ
	                      |	РегистрСведений.уб_ФайлыКПолисам КАК уб_ФайлыКПолисам
	                      |ГДЕ
	                      |	уб_ФайлыКПолисам.УИД В(&УИДы)
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(уб_ФайлыКПолисамВходящие.Хранилище.Путь, """") + ""\"" + уб_ФайлыКПолисамВходящие.ПутьКПапке + ""\"" + уб_ФайлыКПолисамВходящие.ИмяФайла
	                      |ИЗ
	                      |	РегистрСведений.уб_ФайлыКПолисамВходящие КАК уб_ФайлыКПолисамВходящие
	                      |ГДЕ
	                      |	уб_ФайлыКПолисамВходящие.УИД В(&УИДы)");
	Запрос.УстановитьПараметр("УИДы", уб_B2B.UnJSON(id));
	Если ПараметрыСеанса.уб_Константы.ИспользоватьДляФайловПолисовСправочник = ИСТИНА Тогда 
		Запрос.Текст = ЗапросGetFilesPath();
	КонецЕсли;
	Рез = Запрос.Выполнить().Выгрузить();
	Возврат уб_B2B.JSON(Рез);
КонецФункции

