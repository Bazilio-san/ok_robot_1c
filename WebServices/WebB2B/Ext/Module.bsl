//Функция возвращает список Поставщиков и страховых компаний
// broker - принадлежность к группе поставщиков
// Справочник.Контрагенты, папки Поставщики и СтрахованыеКомпании
Функция GetPostavwik()
	Запрос=Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.Код КАК code,
	|	Контрагенты.Наименование КАК name,
	|	ВЫБОР
	|		КОГДА Контрагенты.Родитель.Ссылка = &ГруппаПоставщиков
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК broker
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ЭтоГруппа = ЛОЖЬ
	|	И (Контрагенты.Родитель.Ссылка = &ГруппаПоставщиков
	|			ИЛИ Контрагенты.Родитель.Ссылка = &ГруппаСК)
	|
	|УПОРЯДОЧИТЬ ПО
	|	name";
	Запрос.УстановитьПараметр("ГруппаПоставщиков",ПараметрыСеанса.уб_Константы.уб_ГруппаПоставщиков);
	Запрос.УстановитьПараметр("ГруппаСК",ПараметрыСеанса.уб_Константы.уб_ГруппаСК);
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		ob = уб_B2B.JSON(Запрос.Выполнить().Выгрузить());
	Иначе ob = "[]";
	КонецЕсли;
	Возврат ob;
КонецФункции

