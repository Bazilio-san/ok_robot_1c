//Описание:
//	date		- день (date)
//	dow			- Дата прописью (string)
//	isHoliday	- Признак выходной (boolean)
//	worker		- Выездной специалист (элемент worker)
Функция ПолучитьЭлементDay(Дата)
	day = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "day"));
	day.date		= Дата;
	day.dow			= ПолучитьИмяДняНедели(Дата);
	day.isHoliday	= РегистрыСведений.РегламентированныйПроизводственныйКалендарь.Получить(Новый Структура("ДатаКалендаря, Год", Дата, Год(Дата))).ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий;
	
	Возврат day;
КонецФункции

//Описание:
//	workerId			- id сотрудника
//	deleted				- Признак удален (boolean)
//	name				- ФИО сотрудника (string)
//	isOnDuty			- Признак дежурный (boolean)
//	isAdministrative	- Признак административный (boolean)
//	task				- Таск (элемент task)
Функция ПолучитьЭлементWorker(id, name, deleted)
	
	worker = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "worker"));
	worker.workerId	= id;
	worker.name = name;
	worker.deleted = deleted;
	
	Возврат worker;
	
КонецФункции

//Описание:
//	taskId			- id таска
//	deleted			- Признак удален (boolean)
//	workerID		- id сотрудника (string)
//	timeBegin		- Время начала
//	timeMeet		- Время встречи
//	timeEnd			- Время окончания
//  isAvailable		- Признак задача доступности работника
//  isConfirmed		- Признак задача подтверждена
//  isOnDuty		- Признак задача дежурства
//  isAdministrative- Признак задача административная
//	isPerformed		- Признак страховка состоялась
Функция ПолучитьЭлементTask(Выборка)
	
	task = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "task"));
	task.taskId = Выборка.taskId;
	task.deleted = Выборка.deleted;
	//task.workerID = ?(Выборка.Ссылка.Самовыезд, "000009119",Выборка.workerId);
	task.workerID = ?(Выборка.Самовыезд, "000000000",Выборка.workerId);
	task.timeBegin = Выборка.timeBegin;
	task.timeMeet = Выборка.timeMeet;
	task.timeEnd = Выборка.timeEnd;
	task.isAvailable = Выборка.isAvailable;
	task.isConfirmed = Выборка.isConfirmed;
	task.isOnDuty = Выборка.isOnDuty;
	task.isAdministrative = Выборка.isAdministrative;
	task.isPerformed = Выборка.isPerformed;
	
	//task.new = ?(argument.comm.id = "01"?, 1, 0);
	
	autor = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "managerType"));
	autor.id = Выборка.КодАвтора;
	autor.name = Выборка.НаименованиеАвтора;
	task.autor = autor;
	
	manager = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "managerType"));
	manager.id = Выборка.КодМенеджера;
	manager.name = Выборка.НаименованиеМенеджера;
