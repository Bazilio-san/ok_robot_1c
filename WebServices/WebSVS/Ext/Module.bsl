Функция GetMessage(beginData, lastTimeUpdate, АвторЗ)
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_Чат_Сообщения.ИДСообщения КАК id,
	|	уб_Чат_Сообщения.Период КАК date,
	|	уб_Чат_Сообщения.Отправитель,
	|	уб_Чат_Сообщения.Получатель,
	|	уб_Чат_Сообщения.Заголовок КАК title,
	|	уб_Чат_Сообщения.Сообщение КАК text,
	|	уб_Чат_Сообщения.НеОтображатьНаWeb КАК deleted,
	|	ВЫБОР
	|		КОГДА уб_Чат_НепрочитанныеСообщения.ИДСообщения ЕСТЬ NULL 
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК isRead
	|ИЗ
	|	РегистрСведений.уб_Чат_Сообщения КАК уб_Чат_Сообщения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_Чат_НепрочитанныеСообщения КАК уб_Чат_НепрочитанныеСообщения
	|		ПО уб_Чат_Сообщения.ИДСообщения = уб_Чат_НепрочитанныеСообщения.ИДСообщения
	|ГДЕ
	|	(НЕ уб_Чат_Сообщения.НеОтображатьНаWeb)
	|	И уб_Чат_Сообщения.Период >= &lastTimeUpdate
	|	И уб_Чат_Сообщения.Получатель = &Получатель");
	Запрос.УстановитьПараметр("lastTimeUpdate", lastTimeUpdate);
	АвторЗапроса = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду(АвторЗ));
	Запрос.УстановитьПараметр("Получатель", АвторЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	
	messageList = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "messageList"));
	
	Пока Выборка.Следующий() Цикл
		message = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "message"));
		message.id = Выборка.id;
		message.date = Выборка.date;
		message.isRead = Выборка.isRead;
		message.deleted = Выборка.deleted;
		message.title = Выборка.title;
		message.text = Выборка.text;
		
		messageList.message.Добавить(message);
	КонецЦикла;
	
	beginData.messageList = messageList;
	
КонецФункции

Функция GetActiveTask(beginData, argument)
	
	ТекущийМенеджер = Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId);
	Если ТекущийМенеджер.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер,
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор
	|ИЗ
	|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
	|ГДЕ
	|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор = &Блокиратор");
	Запрос.УстановитьПараметр("Блокиратор", ТекущийМенеджер);
	//Если НЕ ЗначениеНеЗаполнено(argument.comm.datainc.sessionId) Тогда
	Выборка = Запрос.Выполнить().Выбрать();
	//КонецЕсли;
	
	
	Если Выборка.Следующий() Тогда
		activeTask = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "taskBlock"));
		activeTask.taskId = Выборка.Номер;
		
		beginData.activeTask = activeTask;
	Иначе
		
	КонецЕсли;
КонецФункции

Функция FindRequest(СтруктураЗапроса)
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Заявки.Ссылка,
	               |	Заявки.Номер КАК taskId,
	               |	Заявки.Дата КАК date,
	               |	Заявки.ВремяНачало КАК beginTime,
	               |	Заявки.Дата КАК meetTime,
	               |	Заявки.ВремяОкончания КАК endTime,
	               |	ЕСТЬNULL(Заявки.ВремяВстречиКлиент, """") КАК ВремяВстречиКлиент,
	               |	ЕСТЬNULL(Заявки.ВремяОкончанияКлиент, """") КАК ВремяОкончанияКлиент,
	               |	ЕСТЬNULL(Заявки.Менеджер.Код, """") КАК workerId,
	               |	ВЫБОР
	               |		КОГДА Заявки.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок
	               |			ТОГДА -1
	               |		ИНАЧЕ Заявки.НомерЗаявки
	               |	КОНЕЦ КАК requestNum,
	               |	Заявки.МестоВстречи КАК placeMeet,
	               |	ЕСТЬNULL(Заявки.СтанцияМетро, """") КАК СтанцияМетро,
	               |	ВЫРАЗИТЬ(Заявки.Страхователь КАК СТРОКА) КАК contactName,
	               |	ВЫРАЗИТЬ(Заявки.Комментарий КАК СТРОКА) КАК comment,
	               |	Заявки.БСО.(
	               |		Ссылка,
	               |		СК,
	               |		ВидБСО,
	               |		Оператор,
	               |		Состояние,
	               |		НомерБСО
	               |	) КАК БСО,
	               |	ЕСТЬNULL(Заявки.ПроцентГотовности, 0) КАК ПроцентГотовности,
	               |	ЕСТЬNULL(Заявки.Состояния, """") КАК Состояния,
	               |	ЕСТЬNULL(Заявки.Оператор, """") КАК Оператор
	               |ИЗ
	               |	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК Заявки
	               |ГДЕ
	               |	1 = 1
	               |	И НЕ Заявки.Самовыезд";
	Условия = СтруктураЗапроса.ПолучитьСписок("items");
	ДопУсловие="";
	Для каждого Условие из Условия Цикл
		Если ЗначениеЗаполнено (Условие.Value) Тогда
		Иначе
			Продолжить;
		КонецЕсли;
		Если Условие.Key = "taskId" Тогда
			Попытка
				Запрос.УстановитьПараметр("Номер",Число(Условие.Value));
				ДопУсловие = ДопУсловие+" И Заявки.Номер = &Номер";
			Исключение
			КонецПопытки;
		ИначеЕсли Условие.Key = "requestNum" Тогда
			
			Попытка
				Запрос.УстановитьПараметр("НомерЗаявки",Число(Условие.Value));
				ДопУсловие = ДопУсловие+" И Заявки.НомерЗаявки = &НомерЗаявки";
			Исключение
			КонецПопытки;
		ИначеЕсли Условие.Key = "contactName" Тогда	
			ДопУсловие = ДопУсловие+" И Выразить(Заявки.Страхователь КАК СТРОКА) ПОДОБНО (&ИмяСтрахователя)";
			Запрос.УстановитьПараметр("ИмяСтрахователя","%"+СокрЛП(Условие.Value)+"%");
		ИначеЕсли Условие.Key = "placeMeet" Тогда	
			ДопУсловие = ДопУсловие+" И Выразить(Заявки.МестоВстречи КАК СТРОКА) ПОДОБНО (&МестоВстречи)";
			Запрос.УстановитьПараметр("МестоВстречи","%"+СокрЛП(Условие.Value)+"%");
		ИначеЕсли Условие.Key = "comment" Тогда	
			ДопУсловие = ДопУсловие+" И Выразить(Заявки.Комментарий КАК СТРОКА) ПОДОБНО (&Комментарий)";
			Запрос.УстановитьПараметр("Комментарий","%"+СокрЛП(Условие.Value)+"%");
		ИначеЕсли Условие.Key = "startDate" Тогда		
			Попытка 
				Value2 = Условие.Value;
				Если Найти(Value2,"-")= 5 Тогда
					Год	  = ЧИсло(Лев(Value2,4));
					Месяц = ЧИсло(Сред(Value2,6,2));
					День  = ЧИсло(Сред(Value2,9,2));
					Дата1 = Дата (Год, Месяц,День);
				Иначе
					Дата1 = Дата(Value2);
				КонецЕсли;
				Запрос.УстановитьПараметр("НачДата",НачалоДня(Дата1));
				ДопУсловие = ДопУсловие+" И Заявки.Дата >= &НачДата";
			Исключение
			КонецПопытки;
		ИначеЕсли Условие.Key = "endDate" Тогда		
			Попытка 
				Value2 = Условие.Value;
				Если Найти(Value2,"-")= 5 Тогда
					Год   = ЧИсло(Лев(Value2,4));
					Месяц = ЧИсло(Сред(Value2,6,2));
					День  = ЧИсло(Сред(Value2,9,2));
					Дата2 = Дата (Год, Месяц,День);
				Иначе
					Дата2 = Дата(Value2);
				КонецЕсли;
				Запрос.УстановитьПараметр("КонДата",КонецДня(Дата2));
				ДопУсловие = ДопУсловие+" И Заявки.Дата <= &КонДата";
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	//И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата >= &НачДата 
	//И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата <= &КонДата;
	Запрос.Текст = ТекстЗапроса + ДопУсловие;
	//Запрос.УстановитьПараметр("НомерЗаявки",250605);
	//Запрос.УстановитьПараметр("НачДата",Период.startDate);
	//Запрос.УстановитьПараметр("КонДата",Период.endDate);
	Выборка = Запрос.Выполнить().Выбрать();
	result = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "findResult"));
	task_ = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "tasks"));
	task_.error="";
	Всего = Выборка.Количество();
	Если Всего > 0 Тогда
		Если Всего > 10 Тогда
			task_.error = "Количество заявок в результате поиска превысило 10("+Всего+")! ";
		Иначе	
			Пока Выборка.Следующий() Цикл
				taskDetail = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "taskDetail"));
				
				taskDetail.taskId      = Выборка.taskId;
				//	taskDetail.date        = Выборка.date     ;
				//	taskDetail.beginTime   = Выборка.beginTime;
				taskDetail.meetTime    = Выборка.meetTime;
				//	taskDetail.endTime     = Выборка.endTime  ;
				//	taskDetail.workerId    = Выборка.workerId ;
				taskDetail.requestNum  = Выборка.requestNum;
				taskDetail.placeMeet   = Выборка.placeMeet;
				taskDetail.contactName = СокрЛП(Выборка.contactName);
				taskDetail.comment     = СокрЛП(Выборка.comment) ;
				task_.task.Добавить(taskDetail);
			КонецЦикла;
		Конецесли;
	Иначе
		task_.error ="Ничего не найдено!";
	Конецесли;
	result.result = task_;
	Возврат result;
	
КонецФункции

Функция GetAction(session_id, task_id) Экспорт
	
	СтрокаРеквизитов = уб_УСЗ.ПолучитьРеквизитыЗаявки(Число(task_id),Истина);
	
	
	ТекСтатус = СтрокаРеквизитов.Статус;//уб_УСЗ.ВернутьСтатусЗаявки (СтрокаРеквизитов.Ссылка,ТекущаяДата(),ВыборкаСтатуса);
	
	МассивРолей = ПолучитьРоли_УСЗ(session_id,СтрокаРеквизитов.Курьер);
	Интерактивные = Ложь;
	ВыводитьСообщения = Ложь;
	СписокВозможныхДействий = уб_УСЗ.ВернутьСписокДействийДляСтатуса(ТекСтатус,СтрокаРеквизитов,ВыводитьСообщения,МассивРолей,Интерактивные);
	
	actions = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "actions"));
	
	Для каждого Значение из СписокВозможныхДействий Цикл
		action = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "action"));
		action.name=Значение.Значение;
		action.descr = Значение.Представление;
		actions.actions.Добавить(action);
	КонецЦикла;
	
	Возврат actions;
	
КонецФункции

Функция SetState(session_id, task_id, state_name)
	
	СтрокаРеквизитов = уб_УСЗ.ПолучитьРеквизитыЗаявки(Число(task_id),Истина);	
	ТекСтатус = СтрокаРеквизитов.Статус;//уб_УСЗ.ВернутьСтатусЗаявки (СтрокаРеквизитов.Ссылка,ТекущаяДата(),ВыборкаСтатуса);
	МассивРолей = ПолучитьРоли_УСЗ(session_id,СтрокаРеквизитов.Курьер);
	Попытка
		Результат = уб_УСЗ.ВыполнитьДействиеПоЗаявке(СтрокаРеквизитов.Ссылка,ТекСтатус,state_name,СтрокаРеквизитов,МассивРолей);
		//СообщениеНеИсполнения = "Действие: "+state_name+" не выполнено!";
		//не является ошибкой. Если не меняется статус, то возвращает ложь
		СообщениеНеИсполнения = "Статусы не изменены";
	Исключение
		Результат = Ложь;
		СообщениеНеИсполнения = "Действие: "+state_name+" не выполнено из-за ошибки! "+ОписаниеОшибки();
	КонецПопытки;
	response = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "response"));
	response.id = ?(Результат = Истина,0,1);
	response.descr = ?(Результат = Истина, "ok", СообщениеНеИсполнения);
	Возврат response;
КонецФункции

Функция ПолучитьРоли_УСЗ(session_id,Курьер)
	
	МассивРолей = Новый Массив;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Пользователи.Ссылка,
	|	Пользователи.ФизЛицо.Ссылка Как Физлицо,
	|	Пользователи.Код
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизЛицо.Код = &Код
	|
	|СГРУППИРОВАТЬ ПО
	|	Пользователи.ФизЛицо,
	|	Пользователи.Ссылка");
	Запрос.УстановитьПараметр("Код",session_id);
	ВыборкаП = Запрос.Выполнить().Выбрать();
	Если ВыборкаП.Следующий() Тогда
		Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени (СокрЛП(ВыборкаП.Код));
		Если Пользователь <> Неопределено Тогда
			Роли = Пользователь.Роли;
			РольСтаршегоМенеджера = Метаданные.Роли.Найти("уб_СтаршийМенеджерНаТочке");
			Если Роли.Содержит(Метаданные.Роли.уб_МенеджерНаТочке) 
				Или (РольСтаршегоМенеджера <> Неопределено И Роли.Содержит(РольСтаршегоМенеджера))
				Тогда
				МассивРолей.Добавить("Менеджер");
				Параметры = Неопределено;
				уб_СС.ПодчиненныеРуководителя(ВыборкаП.ФизЛицо,, Параметры);
				Если Параметры.ЭтоРуководитель Тогда
					МассивРолей.Добавить("СтаршийМенеджер")
				КонецЕсли;
			КонецЕсли;
			//Если Роли.Содержит(Метаданные.Роли.уб_МенеджерНаТочке) Тогда;
			//	МассивРолей.Добавить("Менеджер");
			//КонецЕсли;
			//Если Роли.Содержит(Метаданные.Роли.уб_СтаршийМенеджерНаТочке) Тогда;
			//	МассивРолей.Добавить("Менеджер");//добавляем базовую роль
			//	МассивРолей.Добавить("СтаршийМенеджер");
			//КонецЕсли;
			Если ВыборкаП.ФизЛицо = уб_УСЗ.ПолучитьРуководителяСВС(Курьер) Тогда
				МассивРолей.Добавить("РСВС");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат МассивРолей;
	
КонецФункции	

Функция ПолучитьИмяДняНедели(Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		НомерДняДенели = ДеньНедели(ТекущаяДата());
	Иначе
		НомерДняДенели = ДеньНедели(Дата);
    КонецЕсли;
	
	Если НомерДняДенели = 1 Тогда
		Возврат "Понедельник";
	ИначеЕсли НомерДняДенели = 2 Тогда
		Возврат "Вторник";
	ИначеЕсли НомерДняДенели = 3 Тогда
		Возврат "Среда";
	ИначеЕсли НомерДняДенели = 4 Тогда
		Возврат "Четверг";
	ИначеЕсли НомерДняДенели = 5 Тогда
		Возврат "Пятница";
	ИначеЕсли НомерДняДенели = 6 Тогда
		Возврат "Суббота";
	Иначе
		Возврат "Воскресенье";
	КонецЕсли;
	
КонецФункции

Функция Zapros(text, parametr)
	Запрос = Новый Запрос;
	Запрос.Текст  = text;
	Попытка
	Структура = ЗначениеизСтрокиВнутр(parametr);
	Для каждого Элемент из Структура Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ,Элемент.Значение);
	КонецЦикла;	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ЗначениеВСтрокуВнутр(ТЗ);	
Исключение
	Возврат ОписаниеОшибки();
	КонецПопытки;
	
