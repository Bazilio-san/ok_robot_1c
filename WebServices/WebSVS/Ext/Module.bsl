
//Функция изменение таска
//	Параметры:
Функция UpdateTask(argument)
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВремяНачало,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Дата,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.ВремяОкончания,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд,
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор,
		|	ВЫБОР
		|		КОГДА уб_ЗаявкаНаЗаказВыездногоСпециалиста.Самовыезд = ЛОЖЬ
		|				И уб_ЗаявкаНаЗаказВыездногоСпециалиста.Курьер.Наименование ПОДОБНО ""%Пустой%""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Пустой
		|ИЗ
		|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
		|ГДЕ
		|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &Номер");
		Запрос.УстановитьПараметр("Номер", argument.task.taskId);
		
		ЗаявкаВС = Запрос.Выполнить().Выбрать();
		Если ЗаявкаВС.Следующий() Тогда
			ТекущийМенеджер = Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId);
			ТекПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", ТекущийМенеджер);
			ПараметрыСеанса.ТекущийПользователь = ТекПользователь;
			Попытка
				пол = ПользователиИнформационнойБазы.НайтиПоИмени(Сокрлп(ТекПользователь.Код));
				ПараметрыСеанса.уб_ЭтоМенеджер = пол.Роли.Содержит(Метаданные.Роли.уб_МенеджерНаТочке) и пол.Роли.Содержит(Метаданные.Роли.ПолныеПрава) = Ложь;
			Исключение
			КонецПопытки;	
			//ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо",ЗаявкаВС.Блокиратор);
			IDКурьера = argument.task.workerId;
			//ЗаявкаВС = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.НайтиПоНомеру(argument.task.taskId).ПолучитьОбъект();
			СсылкаКурьер = Справочники.ФизическиеЛица.НайтиПоКоду(IDКурьера);
			
			//+проверка занятости
			ЗапросЗанятости = Новый Запрос;
			ЗапросЗанятости.Текст = "ВЫБРАТЬ
			|	уб_ЗанятостьВС.Агент,
			|	уб_ЗанятостьВС.ДатаНачала,
			|	уб_ЗанятостьВС.ДатаОкончания
			|ИЗ
			|	РегистрСведений.уб_ЗанятостьВС КАК уб_ЗанятостьВС
			|ГДЕ
			|	уб_ЗанятостьВС.Агент = &Агент
			|	И НЕ(уб_ЗанятостьВС.ДатаНачала <= &ДатаНачала
			|					И уб_ЗанятостьВС.ДатаОкончания <= &ДатаНачала
			|				ИЛИ уб_ЗанятостьВС.ДатаНачала >= &ДатаОкончания
			|					И уб_ЗанятостьВС.ДатаОкончания >= &ДатаОкончания)";
			ЗапросЗанятости.УстановитьПараметр("Агент", СсылкаКурьер);
			ЗапросЗанятости.УстановитьПараметр("ДатаНачала", ЗаявкаВС.ВремяНачало);
			ЗапросЗанятости.УстановитьПараметр("ДатаОкончания", ЗаявкаВС.ВремяОкончания);
			Если IDКурьера = "000000000"  
				ИЛИ Не ЗапросЗанятости.Выполнить().Пустой() Тогда
				//Записываем для корректного обновления графика
				Объект = ЗаявкаВС.Ссылка.ПолучитьОбъект();
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.ДатаИзменения		= Истина;
				Объект.Модификатор          = ПараметрыСеанса.ТекущийПользователь;
				Попытка
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS 000000000", "Сообщить", Истина);
					Объект.Записать();
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS UpdateTask(): " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
				КонецПопытки;
				Возврат Неопределено;
			КонецЕсли;
			//-проверка занятости	
			НовыйКурьер = ?(IDКурьера = "000000000", Справочники.ФизическиеЛица.ПустаяСсылка(), СсылкаКурьер);
			Если Дата(argument.task.beginTime)	  <> ЗаявкаВС.ВремяНачало
				ИЛИ Дата(argument.task.beginTime) <> ЗаявкаВС.Дата
				ИЛИ Дата(argument.task.meetTime)  <> ЗаявкаВС.meetTime
				ИЛИ Дата(argument.task.endTime)	  <> ЗаявкаВС.ВремяОкончания
				//ИЛИ ?(IDКурьера = "000009119",Справочники.ФизическиеЛица.ПустаяСсылка(),СсылкаКурьер) <> ЗаявкаВС.Курьер
				//ИЛИ ?(IDКурьера = "000009119",ИСТИНА,ЛОЖЬ)<>ЗаявкаВС.Самовыезд Тогда
				ИЛИ  НовыйКурьер<> ЗаявкаВС.Курьер
				ИЛИ ?(IDКурьера = "000000000", ИСТИНА, ЛОЖЬ) <> ЗаявкаВС.Самовыезд Тогда
				//Что-то поменялось
				БылПустой = ЗаявкаВС.Пустой;
				ЭтоПустой = (IDКурьера="000081966" или IDКурьера="000081967" или IDКурьера="000081969" или IDКурьера="000081970"); //или IDКурьера="000081966" //или IDКурьера="000081966"
				ЗаявкаВС = ЗаявкаВС.Ссылка.ПолучитьОбъект();
				ЗаявкаВС.ВремяНачало	= argument.task.beginTime;
				ЗаявкаВС.Дата			= argument.task.meetTime;
				//ЗаявкаВС.ВремяВстречи	= argument.task.meetTime;
				ЗаявкаВС.ВремяОкончания	= argument.task.endTime;
				//ЗаявкаВС.Курьер = ?(IDКурьера = "000009119",Справочники.ФизическиеЛица.ПустаяСсылка(), СсылкаКурьер);
				//ЗаявкаВС.Самовыезд = ?(IDКурьера = "000009119",ИСТИНА,ЛОЖЬ);
				
				ЗаявкаВС.Курьер    = НовыйКурьер;
				ЗаявкаВС.Самовыезд = ?(IDКурьера = "000000000", ИСТИНА, ЛОЖЬ);
				//Если ЗаявкаВС.Курьер <> Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка() Тогда//?Какое-то странное условие?
				//Если Не (ЗаявкаВС.Самовыезд И ЗаявкаВС.Курьер = Справочники.ФизическиеЛица.ПустаяСсылка()) Тогда
				
				Если Не ЗаявкаВС.Самовыезд Тогда
					
					//Новый вариант МОТИВАЦИЯ+
					Попытка
						ЗаявкаВС.ПоказателиРасчетаЗП = уб_РасчетыСМенеджерами.ПоказателиРасчетаЗП(ЗаявкаВС.Дата);
						ЗаявкаВС.РасчетВознагражденияКурьера();
	 				Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("При расчете вознаграждения курьера. "+ОписаниеОшибки(), "Сообщить", Истина);
					КонецПопытки;
					//МОТИВАЦИЯ -
					
					ЗаявкаВС.ОбменДанными.Загрузка = Истина;
					ЗаявкаВС.Модификатор   = ПараметрыСеанса.ТекущийПользователь;
					ЗаявкаВС.ДатаИзменения = ТекущаяДата();
					Попытка
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS модификатор", "Сообщить", Истина);
						ЗаявкаВС.Записать();
						//Очередь статуса
						УстановитьПривилегированныйРежим(Истина);
						Если ЗаявкаВс.Самовыезд = Ложь и БылПустой и ЭтоПустой = Ложь Тогда
							ТекСтатус = уб_УСЗ.ВернутьСтатусЗаявки(ЗаявкаВс.Ссылка, ТекущаяДата());
							Если// ТекСтатус = Перечисления.уб_СтатусыЗаявок.ЗаявкаВПечати
								//или
								ТекСтатус = Перечисления.уб_СтатусыЗаявок.НазначениеКурьера Тогда
								МенеджерЗаписи = РегистрыСведений.уб_Очередь.СоздатьМенеджерЗаписи();
								МенеджерЗаписи.Объект = ЗаявкаВС.Ссылка;
								МенеджерЗаписи.ТипОчереди = Перечисления.уб_ТипыОчереди.ДвижениеСтатусов;
								МенеджерЗаписи.Параметр   = "УстановитьСтатус_БСОНаРукахУКурьера";
								МенеджерЗаписи.Записать();
							ИначеЕсли ТекСтатус = Перечисления.уб_СтатусыЗаявок.ЗаявкаВПечати Тогда
								МассивПеремещений  = уб_УСЗ.ВернутьСвязанныеСЗаявкойПеремещения(ЗаявкаВС.Ссылка,Истина);
								ВсегоПеремещений = МассивПеремещений.Количество();
								Для Счетчик = 1 по ВсегоПеремещений Цикл
									СсылкаПеремещения = МассивПеремещений[Счетчик - 1];
									Если Не СсылкаПеремещения.Проведен Тогда
										Об = СсылкаПеремещения.ПолучитьОбъект();
										Попытка
											Об.Записать(РежимЗаписиДокумента.Проведение);
											уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Проведено перемещение: " + СсылкаПеремещения);
										Исключение
											уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Ошибка проведения перемещения " + уб_УСЗ.РасшифроватьПричину(ОписаниеОшибки()), "Сообщить");
											ФлЕстьОшибки = Истина;
											Прервать;
										КонецПопытки;	
									КонецЕсли;	
								КонецЦикла;

							КонецЕсли;
						КонецЕсли;
						УстановитьПривилегированныйРежим(Ложь);
						//Конец очереди
						НастройкиДокумента = Справочники.уб_СписокОбъектовИстории.НайтиПоКоду("уб_ЗаявкаНаЗаказВыездногоСпециалиста");		
						Если ЗначениеЗаполнено(НастройкиДокумента) Тогда
							уб_ИсторияИзмененияОбъектов.ЗаписатьНовуюВерсиюИсторииОбъекта(ЗаявкаВС.Ссылка, "Автоматическая регистрация изменений", НастройкиДокумента.ФиксироватьАвтоматически,,Ложь);
						КонецЕсли;
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS UpdateTask()3: " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS UpdateTask()2: " + ОписаниеОшибки(),, Истина);
	КонецПопытки
КонецФункции

//Функция изменение статуса таска
//	Параметры:
Функция UpdateTaskStatus(argument)
	
	Попытка
		ЗаявкаВС = Документы.уб_ЗаявкаНаЗаказВыездногоСпециалиста.НайтиПоНомеру(argument.comm.datainc.setStatus.taskId).ПолучитьОбъект();
		СтарыйСтатус = ЗаявкаВС.Статус;
		actionId = argument.comm.datainc.setStatus.actionId;
		Если actionId = -1 Тогда
			НовыйСтатус = Перечисления.уб_СтатусЗаявки.Неопределено;
		Иначе
			НовыйСтатус = Перечисления.уб_СтатусЗаявки[actionId];
		КонецЕсли;
		Если Не ЗаявкаВС.Статус = НовыйСтатус Тогда
			ЗаявкаВС.Статус = НовыйСтатус;
			ЗаявкаВС.ОбменДанными.Загрузка = Истина;
			ЗаявкаВС.Модификатор   = ПараметрыСеанса.ТекущийПользователь;
			ЗаявкаВС.ДатаИзменения = ТекущаяДата();
			Попытка
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS статус", "Сообщить", Истина);
				ЗаявкаВС.Записать();
			Исключение
				уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS UpdateTaskStatus(): " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
			КонецПопытки;
			ИДСообщения = Новый УникальныйИдентификатор();
			ТекущийМенеджер = Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId);
			Если ТекущийМенеджер.Пустая() Тогда
				Возврат Ложь ;
			Иначе	
			
			АвторЗапроса = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", ТекущийМенеджер);
			НовоеСообщение = РегистрыСведений.уб_Чат_Сообщения.СоздатьМенеджерЗаписи();
			НовоеСообщение.Период = ТекущаяДата();
			НовоеСообщение.Отправитель = АвторЗапроса;
			//Если Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", ЗаявкаВС.Менеджер) = АвторЗапроса Тогда
			//	Получатель = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду("000008514"));
			//Иначе
				Получатель = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", ЗаявкаВС.Менеджер);
			//КонецЕсли;
			Если СтарыйСтатус = Перечисления.уб_СтатусЗаявки.Неопределено Тогда
				Если НовыйСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаИзменение Тогда
					Заголовок = "Заявка №" + ЗаявкаВС.Номер + " Запрос на изменение";
				ИначеЕсли НовыйСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление Тогда
					Заголовок = "Заявка №" + ЗаявкаВС.Номер + " Запрос на удаление";
				ИначеЕсли НовыйСтатус = Перечисления.уб_СтатусЗаявки.ЗаявкаУдалена Тогда
					Заголовок = "Заявка №" + ЗаявкаВС.Номер + " удалена";
				КонецЕсли;
			ИначеЕсли СтарыйСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаИзменение Тогда
				Если НовыйСтатус = Перечисления.уб_СтатусЗаявки.Неопределено Тогда
					Если argument.comm.datainc.setStatus.allow Тогда
						Заголовок = "Заявка №" + ЗаявкаВС.Номер + " запрос на изменение подтвежден";
					Иначе
						Заголовок = "Заявка №" + ЗаявкаВС.Номер + " запрос на изменение отклонен";
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли СтарыйСтатус = Перечисления.уб_СтатусЗаявки.ЗапросНаУдаление Тогда
				Если НовыйСтатус = Перечисления.уб_СтатусЗаявки.Неопределено Тогда
					Если argument.comm.datainc.setStatus.allow Тогда
						Заголовок = "Заявка №" + ЗаявкаВС.Номер + " запрос удаление подтвержден";
					Иначе
						Заголовок = "Заявка №" + ЗаявкаВС.Номер + " запрос удаление отклонен";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НовоеСообщение.Получатель = Получатель;
			НовоеСообщение.ИДСообщения = ИДСообщения;
			НовоеСообщение.Заголовок = ?(ЗначениеНеЗаполнено(Заголовок), "Заявка №" + ЗаявкаВС.Номер + " Установлен статус: " + НовыйСтатус, Заголовок);
			НовоеСообщение.Сообщение = "Заявка № " + ЗаявкаВС.Номер + " от " + Формат(ЗаявкаВС.Дата, "ДЛФ=ДД") + " курьер: " + ЗаявкаВС.Курьер + Символы.ПС + argument.comm.datainc.setStatus.text;
			НовоеСообщение.ДатаОбновления = ТекущаяДата();
			НовоеСообщение.Записать();
			
			НовоеСообщение = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьМенеджерЗаписи();
			НовоеСообщение.Период = ТекущаяДата();
			НовоеСообщение.Отправитель = АвторЗапроса;
			НовоеСообщение.Пользователь = Получатель;
			НовоеСообщение.ИДСообщения = ИДСообщения;
			НовоеСообщение.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
		
	КонецПопытки
КонецФункции

Функция UpdateMsgStatus(argument)
	Попытка
		Если argument.comm.datainc.msgStatus.isRead Тогда
			Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
			Набор.Отбор.ИДСообщения.Установить(argument.comm.datainc.msgStatus.msgId);
			Набор.Записать();
		КонецЕсли;
		
		Если argument.comm.datainc.msgStatus.delete Тогда
			Набор = РегистрыСведений.уб_Чат_НепрочитанныеСообщения.СоздатьНаборЗаписей();
			Набор.Отбор.ИДСообщения.Установить(argument.comm.datainc.msgStatus.msgId);
			Набор.Записать();
			
			Набор = РегистрыСведений.уб_Чат_Сообщения.СоздатьНаборЗаписей();
			Набор.Отбор.ИДСообщения.Установить(argument.comm.datainc.msgStatus.msgId);
			Набор.Прочитать();
			Если Набор.Количество() <> 0 Тогда
				Набор[0].НеОтображатьНаWeb = Истина;
				Набор.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
		
	КонецПопытки;
КонецФункции

//Функция изменение таска
//	Параметры:
//
// Запрос: {"commId":"12", "taskId":"2", "sessionId":"123", "setBlock":"false", "isGraphicChange":"true"}
//
// Ответ: 
//
//<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
//	<soap:Header/>	<soap:Body>
//		<m:GetDataResponse xmlns:m="http://www.sample-package.org">
//			<m:return xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:
//				type="m:beginData" error="0" msg="">
//				<m:activeTask taskId="2"/>
//			</m:return>
//		</m:GetDataResponse></soap:Body>
//</soap:Envelope>
Функция BlockTask(argument)
	
	Попытка
		activeTask = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "taskBlock"));
		
		taskId	   = argument.comm.datainc.activeTask.taskId;
		//без блокировок+
		activeTask.taskId = taskId;
		Возврат activeTask;
		//без блокировок-
		
		ТекущийМенеджер = Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId);
		Если ТекущийМенеджер.Пустая() Тогда
			Возврат activeTask;
			//Возврат Ложь;
		КонецЕсли;
		Блокировка = argument.comm.datainc.activeTask.setBlock;
		Если Блокировка Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор,
			|	ЕстьNull(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор.Код, """") КАК КодБлокиратора,
			|	ЕстьNull(уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор.Наименование, """") КАК ИмяБлокиратора,
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер Как Номер 
			|ИЗ
			|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
			|ГДЕ
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Номер = &taskId");
			Запрос.УстановитьПараметр("taskId", taskId);
			ВыборкаТек = Запрос.Выполнить().Выбрать();
			Если ВыборкаТек.Следующий() Тогда
				Если НЕ ВыборкаТек.Блокиратор.Пустая() Тогда
					
					taskBlock = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "task-block"));
					activeTask.taskBlock = taskBlock;
					taskBlock.session_id = ВыборкаТек.КодБлокиратора;

					//taskBlock.computer_name = "TAU";
					ИмяБазы = уб_temp.ПолучитьИмяБазыДанных(Истина);
					Разделитель = Найти(ИмяБазы,"/");
					ИмяСервера = Лев(ИмяБазы,Разделитель-1);
					Если Найти(ИмяСервера,"/") = 0 Тогда
						taskBlock.computer_name = ИмяСервера;
					Иначе
						taskBlock.computer_name = ИмяБазы;//файловая база
					КонецЕсли;

					taskBlock.blocked_till = ТекущаяДата()+60*20;
					taskBlock.message = "Задача заблокирована менеджером: " + ВыборкаТек.Блокиратор;
					managerType = ФабрикаXDTO.Тип("http://www.sample-package.org", "managerType");
					managerType.id = ВыборкаТек.КодБлокиратора;
					managerType.name = ВыборкаТек.ИмяБлокиратора;
					taskBlock.manager = managerType;
				Иначе
					ОбъектДокумента = ВыборкаТек.Ссылка.ПолучитьОбъект();
					ОбъектДокумента.Блокиратор = ТекущийМенеджер;
					ОбъектДокумента.ОбменДанными.Загрузка = Истина;
					Попытка
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS Блокиратор", "Сообщить", Истина);
						ОбъектДокумента.Записать();
					Исключение
						уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS BlockTask() (1): " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
					КонецПопытки;
					activeTask.taskId = ВыборкаТек.Номер;
				КонецЕсли;
			КонецЕсли;
		Иначе
			//Снимаем у всех, связанных с блокиратором
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Ссылка,
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор
			|ИЗ
			|	Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК уб_ЗаявкаНаЗаказВыездногоСпециалиста
			|ГДЕ
			|	уб_ЗаявкаНаЗаказВыездногоСпециалиста.Блокиратор = &Блокиратор");
			Запрос.УстановитьПараметр("Блокиратор", ТекущийМенеджер);
			ВыборкаБлок = Запрос.Выполнить().Выбрать();
			ПустаяСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();
			Пока ВыборкаБлок.Следующий() Цикл
				Заявка = ВыборкаБлок.Ссылка.ПолучитьОбъект();
				Заявка.Блокиратор = ПустаяСсылка;
				Заявка.ОбменДанными.Загрузка = Истина;
				Попытка
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS блокиратор 2 "+ТекущийМенеджер, "Сообщить", Истина);
					Заявка.Записать();
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS блокиратор "+ЗначениеВСтрокуВнутр(argument), "Сообщить", Истина);
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("WEBSVS BlockTask() (2): " + ОписаниеОшибки(), ?(ПараметрыСеанса.уб_РежимОтладки > 0, "Сообщить", "НеСообщать"), Истина);
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		Возврат activeTask;
	Исключение
		Возврат activeTask;
	КонецПопытки
	
КонецФункции

Функция GetBeginUpdateData(argument, Режим)
	
	RPstartDate = Дата(argument.comm.datainc.requestedPeriod.startDate);
	RPdayAdd	= argument.comm.datainc.requestedPeriod.dayAdd;
	
	Если Режим = 1 Тогда//update
		CPstartDate		= Дата(argument.comm.datainc.currentPeriod.startDate);
		CPendDate		= Дата(argument.comm.datainc.currentPeriod.endDate);
		CPlastTimeUpdate= Дата(argument.comm.datainc.currentPeriod.lastTimeUpdate);
	КонецЕсли;
	
	ТаблицаДней = Новый ТаблицаЗначений();
	ТаблицаДней.Колонки.Добавить("date");
	Если Режим = 1 Тогда
		ТаблицаДней.Колонки.Добавить("lastTimeUpdate");
	КонецЕсли;
	Для i = 0 По RPdayAdd Цикл
		НоваяСтр = ТаблицаДней.Добавить();
		НоваяСтр.date = RPstartDate + 60*60*24*i;
		Если Режим = 1 Тогда
			СчДата = НачалоДня(CPstartDate);
			Пока СчДата <= НачалоДня(CPendDate) Цикл
				Если НоваяСтр.date = СчДата Тогда 
					НоваяСтр.lastTimeUpdate = CPlastTimeUpdate;
				КонецЕсли;
				СчДата = СчДата + 60*60*24;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	period = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "period"));
	Если Режим = 0 Тогда
		period.startDate = RPstartDate;
		period.endDate = RPstartDate + 60*60*24*RPdayAdd;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаДней Цикл
		
		Дата = Строка.date;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сотрудники.Агент,
		|	Сотрудники.Агент.Код КАК АгентКод,
		|	Сотрудники.Агент.Наименование КАК АгентНаименование,
		|	Сотрудники.Подразделение КАК Подразделение,
		|	Сотрудники.Выбытие
		|ПОМЕСТИТЬ уб_ДвижениеФизлицПоПодразделениям
		|ИЗ
		|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(&ДатаДвиженияФизЛиц, ) КАК Сотрудники
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустойАгент),
		|	""000000000"",
		|	""-- Не выбран курьер--"",
		|	""СВС"",
		|	ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(Заявки.Ссылка, ЗНАЧЕНИЕ(Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста.ПустаяСсылка)) КАК Ссылка,
		|	ЕСТЬNULL(Сотрудники.АгентКод, """") КАК workerId,
		|	ЕСТЬNULL(Сотрудники.АгентНаименование, """") КАК name,
		|	ЕСТЬNULL(Заявки.Номер, 0) КАК taskId,
		|	ВЫБОР
		|		КОГДА Заявки.Статус.Порядок = 1
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК deleted,
		|	ЕСТЬNULL(Заявки.ВремяНачало, """") КАК timeBegin,
		|	ЕСТЬNULL(Заявки.Дата, """") КАК timeMeet,
		|	ЕСТЬNULL(Заявки.ВремяОкончания, """") КАК timeEnd,
		|	ЕСТЬNULL(Заявки.ВремяВстречиКлиент, """") КАК ВремяВстречиКлиент,
		|	ЕСТЬNULL(Заявки.ВремяОкончанияКлиент, """") КАК ВремяОкончанияКлиент,
		|	ИСТИНА КАК isAvailable,
		|	ЕСТЬNULL(Заявки.Утверждено, ЛОЖЬ) КАК isConfirmed,
		|	ЛОЖЬ КАК isOnDuty,
		|	ЛОЖЬ КАК isAdministrative,
		|	2 КАК isPerformed,
		|	ЕСТЬNULL(Заявки.Менеджер, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК manager,
		|	ЕСТЬNULL(Заявки.Автор, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК autor,
		|	Сотрудники.Выбытие КАК workerDeleted,
		|	ЕСТЬNULL(Заявки.Статус, ЗНАЧЕНИЕ(Перечисление.уб_СтатусЗаявки.Неопределено)) КАК Статус,
		|	ЕСТЬNULL(Заявки.Комментарий, """") КАК Комментарий,
		|	ЕСТЬNULL(Заявки.Самовыезд, ЛОЖЬ) КАК Самовыезд,
		|	ЕСТЬNULL(Заявки.Автор.ФизЛицо.Код, """") КАК КодАвтора,
		|	ЕСТЬNULL(Заявки.Автор.ФизЛицо.Наименование, """") КАК НаименованиеАвтора,
		|	ЕСТЬNULL(Заявки.Менеджер.Код, """") КАК КодМенеджера,
		|	ЕСТЬNULL(Заявки.Менеджер.Наименование, """") КАК НаименованиеМенеджера,
		|	Заявки.БСО.(
		|		Ссылка,
		|		СК,
		|		ВидБСО,
		|		Оператор,
		|		Состояние,
		|		НомерБСО
		|	) КАК БСО, ЕСТЬNULL(Заявки.ПроцентГотовности, 0) КАК ПроцентГотовности, ЕСТЬNULL(Заявки.Состояния,"""") как Состояния,
		|   ЕСТЬNULL(Заявки.Оператор, """") КАК Оператор,
		|	ВЫБОР
		|		КОГДА Заявки.ПриоритетЗадачи = ЗНАЧЕНИЕ(Перечисление.уб_ПриоритетЗадачи.ПустаяСсылка)
		|			ТОГДА 2
		|		ИНАЧЕ ЕСТЬNULL(Заявки.ПриоритетЗадачи.Порядок, 2)
		|	КОНЕЦ КАК ИндексПриоритета,
		|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Заявки.ПриоритетЗадачи), """") КАК ПриоритетЗадачи,
		|	ЕСТЬNULL(Заявки.МестоВстречи, """") КАК МестоВстречи,
		|	ЕСТЬNULL(Заявки.СтанцияМетро, """") КАК СтанцияМетро,
		|	ВЫБОР
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Арбатско-Покровская""
		|			ТОГДА ""8492FF""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Бутовская""
		|			ТОГДА ""B2D4FF""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Замоскворецкая""
		|			ТОГДА ""42C442""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Калининская""
		|			ТОГДА ""FFFA72""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Калужско-Рижская""
		|			ТОГДА ""FF9B59""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Каховская""
		|			ТОГДА ""609199""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Кольцевая""
		|			ТОГДА ""995F38""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Люблинско-Дмитровская""
		|			ТОГДА ""8BB743""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Серпуховско-Тимирязевская""
		|			ТОГДА ""C0C0C0""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Сокольническая""
		|			ТОГДА ""FF706D""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Таганско-Краснопресненская""
		|			ТОГДА ""974A99""
		|		КОГДА Заявки.СтанцияМетро.Линия = ""Филевская""
		|			ТОГДА ""AFFCFF""
		|		ИНАЧЕ ""fff""
		|	КОНЕЦ КАК background,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Заявки.Страхователь КАК СТРОКА), """") КАК Страхователь,
		|	ВЫБОР
		|		КОГДА Заявки.Тип = ЗНАЧЕНИЕ(Перечисление.уб_ТипВыезда.ПустаяСсылка)
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(Заявки.Тип.Порядок, 0)
		|	КОНЕЦ КАК ИндексТипа,
		|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Заявки.Тип), """") КАК Тип,
		|	ВЫБОР
		|		КОГДА Заявки.Статус = ЗНАЧЕНИЕ(Перечисление.уб_СтатусЗаявки.ПустаяСсылка)
		|			ТОГДА -1
		|		ИНАЧЕ ЕСТЬNULL(Заявки.Статус.Порядок, -1)
		|	КОНЕЦ КАК ИндексСтатуса,
		|	ВЫБОР
		|		КОГДА Заявки.НомерЗаявки ССЫЛКА Перечисление.уб_ВидыЗаявок
		|				ИЛИ Заявки.НомерЗаявки = НЕОПРЕДЕЛЕНО
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(Заявки.НомерЗаявки, 0)
		|	КОНЕЦ КАК НомерЗаявки,
		|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус, """")) КАК СостояниеСтрока,
		|	ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.ТребуетсяВозвратБСО, ЛОЖЬ) КАК ТребуетсяВозвратБСО,
		|	ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус.Порядок, -1) КАК ИндексСостояния,
		|	ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ПустаяСсылка)) КАК Состояние
		|ИЗ
		|	уб_ДвижениеФизлицПоПодразделениям КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.уб_ЗаявкаНаЗаказВыездногоСпециалиста КАК Заявки
		|		ПО (&УсловиеСвязиПоКурьеру)
		|			И (Заявки.Дата МЕЖДУ &НачалоДня И &КонецДня)
		|			И (&УсловияДатаИзменения)
		|			И (Заявки.Проведен = ИСТИНА)
		|			И (&УсловиеКонтроля)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ИсторияСтатусовЗаявок.СрезПоследних КАК уб_ИсторияСтатусовЗаявокСрезПоследних
		|		ПО (Заявки.Ссылка = уб_ИсторияСтатусовЗаявокСрезПоследних.Заявка)
		|ГДЕ 
		|	1 = 1
		//|	и  ЕСТЬNULL(уб_ИсторияСтатусовЗаявокСрезПоследних.Статус, 0) в (0,ЗНАЧЕНИЕ(Перечисление.уб_СтатусыЗаявок.ЗаявкаВпечати))
		|
		|УПОРЯДОЧИТЬ ПО
		|	name,
		|	timeBegin,
		|	timeEnd");
		
		Если Режим = 1 Тогда
			Запрос.УстановитьПараметр("ДатаДвиженияФизЛиц", '00010101');
			ТекстУсловияДатаИзменения = "Заявки.ДатаИзменения >= &ДатаИзменения";
			ДатаИзменения_ = Строка.lastTimeUpdate;
			Запрос.УстановитьПараметр("ДатаИзменения", ДатаИзменения_);
		Иначе
			Запрос.УстановитьПараметр("ДатаДвиженияФизЛиц", КонецДня(Дата));
			ТекстУсловияДатаИзменения = "Истина";
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияДатаИзменения", ТекстУсловияДатаИзменения);
		
		
		Если ПараметрыСеанса.уб_Константы.ПроверкаЗаявокОтделомКонтроля = Истина Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтроля", 
