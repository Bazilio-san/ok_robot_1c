Функция ПолучитьЭлементEmployment(Занятость)
	
	employment = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "employment"));
	employment.id = Занятость.id;
	employment.timeBegin = Занятость.timeBegin;
	employment.timeEnd = Занятость.timeEnd;
	employment.deleted = Занятость.deleted;
	employment.comment = Занятость.comment;
	Если не ПустаяСтрока(Занятость.name) Тогда
		employment.name = Занятость.name;
		employment.type = Занятость.type;
		employment.color = "rgb(" + Занятость.color + ")";
	Иначе
		employment.name = "Не заполнена занятость";
		employment.type = "нет";
		employment.color = "rgb(255,100,100)";
	КонецЕсли;
	
	Возврат employment;
	
КонецФункции

