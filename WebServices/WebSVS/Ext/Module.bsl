Функция GetData(argument)
	
	beginData = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.sample-package.org", "beginData"));
	beginData.error = "000";
	beginData.msg = "";
	
	//beginData.error = "вапвапра орпроп";
	//Возврат "434534534";
	
	Попытка//?нужна ли попытка? всегда есть sessionId?
		КодФизЛица = argument.comm.datainc.sessionId;
	Исключение
		КодФизЛица = Неопределено;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(КодФизЛица) Тогда
		//уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("SVS."+КодФизЛица,,Истина, УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при удалении заявки", ,,);
		ТекПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду(КодФизЛица));
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			ПараметрыСеанса.ТекущийПользователь = ТекПользователь;
			Попытка
				пол = ПользователиИнформационнойБазы.НайтиПоИмени(Сокрлп(ТекПользователь.Код));
				ПараметрыСеанса.уб_ЭтоМенеджер = пол.Роли.Содержит(Метаданные.Роли.уб_МенеджерНаТочке) и пол.Роли.Содержит(Метаданные.Роли.ПолныеПрава) = Ложь;
			Исключение
			КонецПопытки;	
		КонецЕсли;
	Иначе
		Возврат beginData;	
	КонецЕсли;
	
	Если argument.comm.id = "01" Тогда
		beginData.period		= GetBeginData(argument);
		GetMessage(beginData, Дата('00010101'), argument.comm.datainc.sessionId);
		GetActiveTask(beginData, argument);
	ИначеЕсли argument.comm.id = "02" Тогда
		beginData.period = GetUpdateData(argument);
		GetMessage(beginData, Дата(argument.comm.datainc.currentPeriod.lastTimeUpdate), argument.comm.datainc.sessionId);
		GetActiveTask(beginData, argument);
	ИначеЕсли argument.comm.id = "13" Тогда
		//ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId));
		UpdateTask(argument.comm.datainc);
	ИначеЕсли argument.comm.id = "12" Тогда
		//ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId));
		beginData.activeTask = BlockTask(argument);
	ИначеЕсли argument.comm.id = "20" Тогда
		//ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизЛицо", Справочники.ФизическиеЛица.НайтиПоКоду(argument.comm.datainc.sessionId));
		UpdateTaskStatus(argument);
	ИначеЕсли argument.comm.id = "30" Тогда
		UpdateMsgStatus(argument);
	ИначеЕсли argument.comm.id = "40" Тогда
		//SetWorkerStatus(argument);
	КонецЕсли;
	
	Возврат beginData;
КонецФункции

