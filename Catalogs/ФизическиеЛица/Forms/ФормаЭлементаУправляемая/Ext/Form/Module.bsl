&НаСервере
Процедура ДобавитьФотоНаСервере(СтруктураФайла)
	//ДД
	Фото = ПолучитьИзВременногоХранилища(СтруктураФайла.АдресФайла);
	//Массив
	Фотографии = ПолучитьИзВременногоХранилища(АдресХранилищаФотографий);
	ИндексКартинки = 0;
	Фотографии.Вставить(ИндексКартинки,Новый Структура("Фото,Расширение",Фото,СтруктураФайла.Расширение));
	ТекущаяФотография = ПоместитьВоВременноеХранилище(Фотографии[ИндексКартинки].Фото,Новый УникальныйИдентификатор);
	АдресХранилищаФотографий = ПоместитьВоВременноеХранилище(Фотографии,Новый УникальныйИдентификатор);
	Модифицированность  = Истина;
КонецПроцедуры

