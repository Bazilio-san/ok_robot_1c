#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьФорму()
	
	ЭтоНовый = ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ;
	Если ЭтоНовый Тогда
		Объект.Наименование      = "";
		Объект.tg_name           = "";
		Объект.tg_id             = "";
		Объект.СтраховойНомерПФР = "";
	КонецЕсли;
	
	ПравоУправлениеПерсоналом =  (уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") или уб_temp.ПолучитьПредопределеннуюНастройкуПользователя("УправлениеПерсоналом", Ложь)); 
	
	Параметры.Свойство("ЭтоСотрудник",ЭтоСотрудник);
	Если ЭтоСотрудник = ЛОЖЬ и ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтоСотрудник = уб_ВызовСервера.ЭтоНашСотрудник(Объект.Ссылка) или Объект.Ссылка.ПринадлежитЭлементу(Справочники.ФизическиеЛица.Сотрудники);
	КонецЕсли;	
	ПрочитатьМестоРождения();
	ПрочитатьПаспортныеДанные();
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ПоследниеДанныеФИО(Объект.Ссылка),"Фамилия,Имя,Отчество");
	
	ВидимостьКонтактнойИнформации = 2;
	уб_ФормыВызовСервера.ДобавитьКонтактнуюИнформацию(ЭтаФорма,Объект.Ссылка,"Объект",Элементы.КонтактнаяИнформация,ВидимостьКонтактнойИнформации);
	уб_ФормыВызовСервера.ДобавитьОбщиеРеквизиты(ЭтаФорма,Объект.Ссылка);	
	
	уб_ФормыВызовСервера.УстановитьОтборСписка(ЭтаФорма.ДвижениеПоПодразделениям,"Агент",Объект.Ссылка,,ИСТИНА);
	
	уб_ФормыВызовСервера.УстановитьКнопкиПечати(ЭтаФорма,,Ложь);
	#Область ВидимостьИДоступность
	//ПравоИзменения = ПравоДоступа("Изменение",Метаданные.Справочники.ФизическиеЛица);
	//Если ПравоИзменения = ЛОЖЬ Тогда
	//КонецЕсли;	
	
	Элементы.Сотрудники.Видимость                         = ЭтоСотрудник и ПравоУправлениеПерсоналом;
	Элементы.СотрудникиИнтеграция.Видимость               = ЭтоСотрудник и ПравоУправлениеПерсоналом;
	Элементы.СотрудникиНастройкиВыплатыЗарплаты.Видимость = ЭтоСотрудник и ПравоУправлениеПерсоналом;
	//Элементы.ПраваяКолонка.Видимость                      = ЭтоСотрудник и ПравоУправлениеПерсоналом;
	Элементы.СтраховойНомерПФР.Видимость                  = ЭтоСотрудник и ПравоУправлениеПерсоналом;

	Элементы.ГруппаИзмененияФото.Доступность = ПравоУправлениеПерсоналом;
	
	Если ЭтоСотрудник или уб_ВызовСервера.ЭтоНашСотрудник(Объект.Ссылка) Тогда
		//Удостоверение
		Элементы.ГруппаУдостоверениеЛичности.Видимость = ПравоУправлениеПерсоналом;
		Если НЕ  ПравоУправлениеПерсоналом Тогда
			Элементы.Страницы.ТолькоПросмотр    = Истина;
			Элементы.Комментарий.ТолькоПросмотр = Истина;
		КонецЕсли;	
	Иначе
		Если уб_КЭШируемые.ДоступностьРоли("ПолныеПрава,уб_СотрудникОтделаБСО") = ЛОЖЬ Тогда
			Элементы.ГруппаУдостоверениеЛичности.Видимость = Истина;
			Элементы.ГруппаНаименованиеКод.ТолькоПросмотр = Истина;
			Элементы.ФИО.ТолькоПросмотр                   = Истина;
			Элементы.Имя.ТолькоПросмотр                   = Истина;
			Элементы.Отчество.ТолькоПросмотр              = Истина;
			Элементы.Наименование.ТолькоПросмотр          = Истина;
			//Элементы.ДатаРождения.ТолькоПросмотр          = ЗначениеЗаполнено(Объект.ДатаРождения);
			Элементы.Пол.ТолькоПросмотр                   = ЗначениеЗаполнено(Объект.Пол);
			Элементы.Родитель.ТолькоПросмотр              = Истина;			
			
		КонецЕсли;
		
	КонецЕсли;
	#КонецОбласти
	Если уб_КЭШируемые.ДоступностьРоли("ПолныеПрава,уб_СотрудникОтделаБСО") = ЛОЖЬ Тогда
		Элементы.ВнешнийУИД.ТолькоПросмотр            = Истина;
	КонецЕсли;	

КонецПроцедуры

