&НаСервереБезКонтекста
Функция СК()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка КАК Ссылка,
	               |	Контрагенты.Наименование КАК SK,
	               |	Контрагенты.ВидыСП.(
	               |		Ссылка КАК Ссылка,
	               |		НомерСтроки КАК НомерСтроки,
	               |		ПРЕДСТАВЛЕНИЕ(Контрагенты.ВидыСП.ВидСП) КАК ВидСП,
	               |		Организация КАК Организация
	               |	) КАК ВидыСП,
	               |	ПРЕДСТАВЛЕНИЕ(Контрагенты.Андеррайтер) КАК Андеррайтер,
	               |	Контрагенты.Андеррайтер.tg_id КАК Андеррайтерtg_id,
	               |	Контрагенты.Андеррайтер.tg_name КАК Андеррайтерtg_name
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ЭтоГруппа = ЛОЖЬ
	               |	И Контрагенты.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.Контрагенты.СтраховыеКомпании))
	               |	И НЕ Контрагенты.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.Контрагенты.НЕАКТИВНЫЕ))
	               |	И НЕ Контрагенты.Наименование = ""--КупиПолис--""
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Контрагенты.Наименование";
	Ответ = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокБСО = Новый Массив;
		Для Каждого БСо Из Выборка.ВидыСп.Выгрузить()  Цикл
			Если СписокБСО.Найти(БСО.ВидСп) = Неопределено Тогда
				СписокБСО.Добавить(БСО.ВидСп);
			КонецЕсли;
		КонецЦикла;
		Соответствие = Новый Структура;
		Соответствие.Вставить("sk",Выборка.sk);
		Если СписокБСО.Количество()>0 Тогда
			Соответствие.Вставить("bso",СписокБСО);
		КонецЕсли;
		
		Соответствие.Вставить("owner",Выборка.Андеррайтер);
		Соответствие.Вставить("owner_id",Выборка.Андеррайтерtg_id);
		Соответствие.Вставить("owner_name",Выборка.Андеррайтерtg_name);
		Ответ.Добавить(Соответствие);
		
	КонецЦикла;	
	Возврат Ответ;
КонецФункции

