&НаКлиенте
Процедура ЗавершениеПомещениеФайлаНаСервер(ОписанияПомещенногоФайла, СтруктураЗаполнения) Экспорт
	//Сообщить("Отладка 1");
	Если ОписанияПомещенногоФайла = Неопределено Тогда
		//Сообщить("Отладка 2");
		Возврат
	КонецЕсли;
	ЕстьИзменения = ЛОжь;
	Для каждого ОписаниеПомещенногоФайла из ОписанияПомещенногоФайла Цикл
		Попытка
			ИмяФайла = ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя;
			//Сообщить(ИмяФайла);
			//ИмяФайлаПолное = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
			
			СтруктураЗаполнения.Вставить("АдресФайла",ОписаниеПомещенногоФайла.Адрес);
			СтруктураЗаполнения.Вставить("Расширение",ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение);
			СтруктураЗаполнения.Вставить("Имя",ИмяФайла);
			//СтруктураЗаполнения.Вставить("ПолноеИмяФайла",ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.Имя);
			
			ДобавитьФотоНаСервере(СтруктураЗаполнения);
		Исключение
			Сообщить(ОписаниеОшибки());
			//Сообщить(ТипЗнч(ОписаниеПомещенногоФайла.СсылкаНаФайл));
		КонецПопытки;	

	КонецЦикла;
КонецПроцедуры	  



&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Фотографии = ТекущийОбъект.Фотография.Получить();
	Если Фотографии = Неопределено Тогда
		Фотографии = Новый Массив;
	КонецЕсли;	
	АдресХранилищаФотографий = ПоместитьВоВременноеХранилище(Фотографии,Новый УникальныйИдентификатор);
	ИндексКартинки = -1;
	Для Счетчик = 0 по Фотографии.Количество()-1 Цикл
		ИндексКартинки  = Счетчик;
		Попытка
			ТекущаяФотография = ПоместитьВоВременноеХранилище(Фотографии[ИндексКартинки].Фото,Новый УникальныйИдентификатор);
		Исключение
			ТекущаяФотография = ПоместитьВоВременноеХранилище(Фотографии[ИндексКартинки],Новый УникальныйИдентификатор);
		КонецПопытки;	
		Прервать;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция УстановитьФотоПоИндексу(Индекс)
	Фотографии = ПолучитьИзВременногоХранилища(АдресХранилищаФотографий);
	ИндексКартинки = Мин(Фотографии.Количество()-1,ИндексКартинки);
	ТекущаяФотография = ПоместитьВоВременноеХранилище(Фотографии[ИндексКартинки].Фото,Новый УникальныйИдентификатор);
	
КонецФункции	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЭтоАдресВременногоХранилища(АдресХранилищаФотографий) Тогда
		Фотографии = ПолучитьИзВременногоХранилища(АдресХранилищаФотографий);
		ТекущийОбъект.Фотография = Новый ХранилищеЗначения(Фотографии);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФото(Команда)
	УдалитьФотоНаСервере();
КонецПроцедуры
&НаСервере
Процедура УдалитьФотоНаСервере()
	//Массив
	Фотографии = ПолучитьИзВременногоХранилища(АдресХранилищаФотографий);
	Фотографии.Удалить(ИндексКартинки);
	ИндексКартинки = Макс(Фотографии.Количество()-1,-1);
	Если ИндексКартинки<>-1 Тогда
		ТекущаяФотография = ПоместитьВоВременноеХранилище(Фотографии[ИндексКартинки].Фот,Новый УникальныйИдентификатор);
	Иначе
		ТекущаяФотография = "";
	КонецЕсли;	
	АдресХранилищаФотографий = ПоместитьВоВременноеХранилище(Фотографии,Новый УникальныйИдентификатор);
	Модифицированность  = Истина;
КонецПроцедуры




