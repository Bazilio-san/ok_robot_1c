   	ПараметрыДиалога.Фильтр = уб_temp.ПолучитьФильтрКартинок();
	
    ЗавершениеОбратныйВызов = Новый ОписаниеОповещения("ЗавершениеПомещениеФайлаНаСервер", ЭтотОбъект,Новый Структура);
	//ПрогрессОбратныйВызов = Новый ОписаниеОповещения("ПрогрессОбратныйВызов", ЭтотОбъект);
	//ПередНачаломОбратныйВызов = Новый ОписаниеОповещения("ПередНачаломОбратныйВызов", ЭтотОбъект);
    НачатьПомещениеФайловНаСервер(ЗавершениеОбратныйВызов,,,,УникальныйИдентификатор);

