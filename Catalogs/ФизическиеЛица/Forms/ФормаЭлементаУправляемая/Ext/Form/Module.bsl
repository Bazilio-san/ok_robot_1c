&НаКлиенте
Функция ИнициализироватьФормуДвижения(Режим,ТаблицаРезультатов)
	ФормаВвода = ПолучитьФорму("РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.Форма.ФормаЗаписиУправляемая",,ЭтаФорма);
	ФормаВвода.Параметры.ФормаОткрытаИзФормыФизлица = Истина;
	
	ФормаВвода.Запись.Агент = Объект.Ссылка;	
	
	ЭлементыЗаписи = ФормаВвода.Элементы;
	
	ЭлементыЗаписи.Агент.Доступность = Ложь;
	Если Режим = "Перемещение" или Режим = "Прием" Тогда
		ФормаВвода.Запись.Период = НачалоДня(ТекущаяДата());
		ФормаВвода.Запись.Организация = уб_ВызовСервера.ПолучитьЗначениеКонстанты("ОсновнаяОрганизация");//ТаблицаРезультатов[0].Организация;
		Если Режим = "Перемещение" Тогда
			ФормаВвода.Запись.Должность = ТаблицаРезультатов[0].Должность;
			ФормаВвода.Элементы.ФормаЗаписатьИЗакрыть.Заголовок = "Переместить и закрыть";
			ФормаВвода.ТекущийЭлемент = ЭлементыЗаписи.Подразделение
		Иначе
			ФормаВвода.Элементы.ФормаЗаписатьИЗакрыть.Заголовок = "Принять и закрыть";
			ФормаВвода.ТекущийЭлемент = ЭлементыЗаписи.Период;
		КонецЕсли;	
		ФормаВвода.Запись.Выбытие = Ложь;
		ЭлементыЗаписи.Подразделение.Доступность = Истина;
		ЭлементыЗаписи.Выбытие.Видимость = Ложь;
	ИначеЕсли Режим = "Выбытие" Тогда	
		ФормаВвода.Запись.Период = КонецДня(ТекущаяДата());
		ФормаВвода.Запись.Выбытие = Истина;
		ФормаВвода.Запись.Организация = ТаблицаРезультатов[0].Организация;
		ФормаВвода.Запись.Подразделение = ТаблицаРезультатов[0].Подразделение;
		ЭлементыЗаписи.Выбытие.Доступность = Ложь;
		//Эл.Организация.Доступность = Ложь;//Скрыто
		ЭлементыЗаписи.Подразделение.Доступность = Ложь;
		ЭлементыЗаписи.Должность.Доступность = Ложь;
		ЭлементыЗаписи.Выбытие.Видимость = Истина;
		ФормаВвода.Элементы.ФормаЗаписатьИЗакрыть.Заголовок = "Уволить и закрыть";
	КонецЕсли;
	
	Возврат ФормаВвода;
	
КонецФункции	

