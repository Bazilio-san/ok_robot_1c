&НаКлиенте
Процедура ВыполнитьКомандуПечати(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.ЗагрузитьЗначения(уб_СЛ.СписокДоступныхОрганизаций());
	
	Описание = новый ОписаниеОповещения("ПослеВыбораОрганизации",ЭтаФорма,Новый Структура("Команда",Команда));
	
	ПоказатьВыборИзСписка(Описание,СписокВыбора);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеВыбораОрганизации(РезультатВыбора,ДополнительныеПараметры) Экспорт
	Если РезультатВыбора = Неопределено Тогда
		ПараметрыПечати = Неопределено;
	Иначе
		ПараметрыПечати = Новый Структура("Организация",РезультатВыбора.Значение);
	КонецЕсли;	
	Уб_Клиент.ПечатьПоКнопке(ЭтаФорма,ДополнительныеПараметры.Команда,ПараметрыПечати);
КонецПроцедуры

&НаКлиенте
Процедура ПринятьСотрудника(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Сначала создайте физлицо и запишите объект!", 10);
		Возврат;
	КонецЕсли;	
	
	ТаблицаРезультатов  = СобратьДанные(Объект.Ссылка);
	Если ТаблицаРезультатов.Количество()>0 Тогда 
		Если ТаблицаРезультатов[0].Выбытие=Ложь Тогда
			ПоказатьПредупреждение(,"Сотрудник уже работает!", 10);
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	ФормаВвода = ИнициализироватьФормуДвижения("Прием",ТаблицаРезультатов);	
	ФормаВвода.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиСотрудника(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Сначала создайте физлицо и запишите объект!", 10);
		Возврат;
	КонецЕсли;
	//
	ТаблицаРезультатов  = СобратьДанные(Объект.Ссылка);
	
	Если ТаблицаРезультатов.Количество()>0 Тогда 
		Если ТаблицаРезультатов[0].Выбытие=Истина Тогда
			ПоказатьПредупреждение(,"Сотрудник уже уволен! Его можно только принять", 10);
			Возврат;
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Сотрудник еще не принят!", 10);
		Возврат;
	КонецЕсли;
	
	ФормаВвода = ИнициализироватьФормуДвижения("Перемещение",ТаблицаРезультатов);	
	
	ФормаВвода.Открыть(); 

КонецПроцедуры

&НаКлиенте
Процедура УволитьСотрудника(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Сначала создайте физлицо и запишите объект!", 10);
		Возврат;
	КонецЕсли;
	
	ТаблицаРезультатов  = СобратьДанные(Объект.Ссылка);
	Если ТаблицаРезультатов.Количество()>0 Тогда 
		Если ТаблицаРезультатов[0].Выбытие=Истина Тогда
			ПоказатьПредупреждение(,"Сотрудник уже уволен! Его можно только принять", 10);
			Возврат;
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Сотрудник еще не принят!", 10);
		Возврат;
	КонецЕсли; 
	
	
	ФормаВвода = ИнициализироватьФормуДвижения("Выбытие",ТаблицаРезультатов);	
	ФормаВвода.Открыть();
КонецПроцедуры

