&НаСервереБезКонтекста
Функция ПоследниеДанныеФИО(Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФИОФизЛицСрезПоследних.Фамилия,
	               |	ФИОФизЛицСрезПоследних.Имя,
	               |	ФИОФизЛицСрезПоследних.Отчество,
	               |	ФИОФизЛицСрезПоследних.Период
	               |ИЗ
	               |	РегистрСведений.ФИОФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ФИОФизЛицСрезПоследних";
	Запрос.УстановитьПараметр("ФизЛицо",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		_Фамилия    = Выборка.Фамилия;
	    _Имя        = Выборка.Имя;
	    _Отчество   = Выборка.Отчество;
	    _Период     = Выборка.Период;
	Иначе
		ДанныеФио = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Ссылка.Наименование," ");
		Если ДанныеФио.Количество()>0 Тогда
			_Фамилия = ДанныеФио[0];
		КонецЕсли;	
		Если ДанныеФио.Количество()>1 Тогда
			_Имя = ДанныеФио[1];
		КонецЕсли;	
		Если ДанныеФио.Количество()>2 Тогда
			_Отчество = ДанныеФио[2];
		КонецЕсли;	
		_Период = Ссылка.ДатаРождения;
		Если _Период = Дата(1,1,1) Тогда
			_Период = Дата(2000,1,1);
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Новый Структура("Период,Фамилия,Имя,Отчество",_Период,_Фамилия,_Имя,_Отчество);
КонецФункции	



