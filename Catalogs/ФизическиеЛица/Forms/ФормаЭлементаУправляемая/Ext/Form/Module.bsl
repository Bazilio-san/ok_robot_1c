#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	

	Если Найти(ИсточникВыбора.Заголовок, "Место рожд")>0 Тогда
		//Представление места рождения
		МестоРожденияФизЛица = РегламентированнаяОтчетность.ПредставлениеМестаРождения(ВыбранноеЗначение);
		
		Объект.МестоРождения = МестоРожденияФизЛица;
	ИначеЕсли ВыбранноеЗначение = Объект.Ссылка и Найти(ИсточникВыбора.Заголовок, "Паспортные данные физического лица")>0 Тогда
		ПрочитатьПаспортныеДанные();	
	ИначеЕсли Найти(ИсточникВыбора.Заголовок, "Фамилия, имя, отчество")>0 Тогда	
		Данные  = ПоследниеДанныеФИО(Объект.Ссылка);
		ЗаполнитьЗначенияСвойств(ЭтаФорма,Данные,"Фамилия,Имя,Отчество");
		Объект.Наименование = ВыбранноеЗначение;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ЭтоНовый Тогда
		уб_ФормыВызовСервера.ЗаписатьКонтактнуюИнформацию(ЭтаФорма,"Объект",Отказ);	
	КонецЕсли	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтоНовый Тогда
		Отказ = ЛОжь;
		уб_ФормыВызовСервера.ЗаписатьКонтактнуюИнформацию(ЭтаФорма,"Объект",Отказ);	
	КонецЕсли;	
	уб_ФормыВызовСервера.УстановитьОтборСписка(ЭтаФорма.ДвижениеПоПодразделениям,"Агент",ТекущийОбъект.Ссылка,,ИСТИНА);
	
	ЭтоНовый = ЗначениеЗаполнено(Объект.Ссылка) = ЛОЖЬ;
	Если Не ПустаяСтрока (ДокументСерия) или ПустаяСтрока (ДокументНомер) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПаспортныеДанныеФизЛицСрезПоследних.*
		|ИЗ
		|	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ПаспортныеДанныеФизЛицСрезПоследних";
		Запрос.УстановитьПараметр("ФизЛицо",Объект.Ссылка);
		
		Паспорт = Запрос.Выполнить().Выбрать();
		Если Паспорт.Следующий() Тогда		
			Если не ДокументДатаВыдачи = Паспорт.ДокументДатаВыдачи
				или НЕ	ДокументНомер = Паспорт.ДокументНомер
				или НЕ	ДокументСерия = Паспорт.ДокументСерия Тогда
				НоваяЗапись = Истина;
			КонецЕсли;	
		Иначе
			НоваяЗапись = Истина;
		КонецЕсли;	
		Если НоваяЗапись = Истина Тогда
			МЗ = РегистрыСведений.ПаспортныеДанныеФизЛиц.СоздатьМенеджерЗаписи();	
			МЗ.ДокументВид = Справочники.ДокументыУдостоверяющиеЛичность.ИМНС21;
			МЗ.ФизЛицо = Объект.Ссылка;
			МЗ.ДокументДатаВыдачи = ДокументДатаВыдачи;
			МЗ.ДокументНомер = ДокументНомер;
			МЗ.ДокументСерия = ДокументСерия;
			МЗ.Период = ТекущаяДата();
			МЗ.Записать();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если ЭтоСотрудник и ПустаяСтрока(Объект.tg_name) Тогда
		Объект.tg_name = Объект.Наименование; 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СписокВозможныхНаименований = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Фамилия) Тогда
		СписокВозможныхНаименований.Добавить(Фамилия);
		Если ЗначениеЗаполнено(Имя) Тогда
			СписокВозможныхНаименований.Добавить(СокрЛП(Фамилия) + " " + СокрЛП(Имя));
			СписокВозможныхНаименований.Добавить(СокрЛП(Фамилия) + " " + Лев(Имя,1) + ".");
			Если ЗначениеЗаполнено(Отчество) Тогда
				СписокВозможныхНаименований.Добавить(СокрЛП(Фамилия) + " " + СокрЛП(Имя) + " " + СокрЛП(Отчество));
				СписокВозможныхНаименований.Добавить(СокрЛП(Фамилия) + " " + Лев(Имя,1) + ". " + Лев(Отчество,1)+ ".");
 			КонецЕсли;
		 КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Имя) Тогда
			СписокВозможныхНаименований.Добавить(Имя);
			Если ЗначениеЗаполнено(Отчество) Тогда
				СписокВозможныхНаименований.Добавить(СокрЛП(Имя) + " " + СокрЛП(Отчество));
				СписокВозможныхНаименований.Добавить(СокрЛП(Имя) + ". " + Лев(Отчество,1)+ ".");
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Отчество) Тогда
				СписокВозможныхНаименований.Добавить(Отчество);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
    ЭтаФорма.ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПриВыбореНаименования",ЭтаФорма,Новый Структура),СписокВозможныхНаименований,Элемент);
	
КонецПроцедуры

