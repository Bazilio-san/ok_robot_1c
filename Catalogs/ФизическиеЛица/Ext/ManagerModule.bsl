Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Если Параметры.Свойство("ЭтоСотрудник") и Параметры.ЭтоСотрудник = Истина и не пустаяСтрока(Параметры.СтрокаПоиска) Тогда
		ДанныеВыбора = Новый СписокЗначений;
		СтандартнаяОбработка = Ложь;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	влож.Агент КАК Агент,
		               |	влож.Наименование КАК Наименование
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент КАК Агент,
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент.Наименование КАК Наименование
		               |	ИЗ
		               |		РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПоследних(, ) КАК уб_ДвижениеФизлицПоПодразделениям
		               |	ГДЕ
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент.Наименование ПОДОБНО &Наименование
		               |		И уб_ДвижениеФизлицПоПодразделениям.Выбытие = ЛОЖЬ
		               |	
		               |	ОБЪЕДИНИТЬ
		               |	
		               |	ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент,
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент.Наименование
		               |	ИЗ
		               |		РегистрСведений.уб_ДвижениеФизлицПоПодразделениям КАК уб_ДвижениеФизлицПоПодразделениям
		               |	ГДЕ
		               |		уб_ДвижениеФизлицПоПодразделениям.Агент.Наименование ПОДОБНО &Наименование
		               |		И уб_ДвижениеФизлицПоПодразделениям.Период > &год) КАК влож
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	влож.Наименование";
					   Запрос.УстановитьПараметр("год",ТекущаяДата()-365*3600*24);
		Запрос.УстановитьПараметр("Наименование","%"+Параметры.СтрокаПоиска+"%");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеВыбора.Добавить(Выборка.Агент,Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

