Функция НовоеНаименование(Наименование) Экспорт
	МассивСлов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтрЗаменить(СтрЗаменить(Наименование,"  "," "),"  "," ")," ");
		НовоеНаименование = "";
		Для каждого Слово из МассивСлов Цикл
			НовоеНаименование = НовоеНаименование+?(НовоеНаименование="",""," ")+ВРЕГ(ЛЕВ(Слово,1))
			+ НРЕГ(СРЕД(Слово,2));
		КонецЦикла;	
		СтрокаБукв = "аеёиоуыэюябвгджзйклмнпрстфхцчшщiъь- ";
		СтрокаБукв = СтрокаБукв+Врег(СтрокаБукв);
		длина = СтрДлина(НовоеНаименование);
		естьОшибка = Ложь;
		МассивКривых = Новый Массив;
		Для СчетчикБукв =1 по длина Цикл
			ТекБуква = Сред(НовоеНаименование,СчетчикБукв,1);
			Если Найти(СтрокаБукв,ТекБуква) = 0 Тогда
				естьОшибка =Истина;
				МассивКривых.Добавить(ТекБуква);
			КонецЕсли;	
		КонецЦикла;	
		
		НовоеНаименование = СтрЗаменить(НовоеНаименование,Символы.Таб," ");
		НовоеНаименование = СтрЗаменить(НовоеНаименование,Символы.ПС," ");
		НовоеНаименование = СтрЗаменить(НовоеНаименование,Символы.ВК," ");
		НовоеНаименование = СтрЗаменить(НовоеНаименование,"  "," ");
		НовоеНаименование = СтрЗаменить(НовоеНаименование,"  "," ");
		
		Если естьОшибка = Истина Тогда
			СтрокаКривых ="";
			Для каждого буква из МассивКривых Цикл
				НовоеНаименование = СтрЗаменить(НовоеНаименование,буква,"");
				СтрокаКривых = СтрокаКривых+буква;
			КонецЦикла;
			Сообщить("Обнаружены и УДАЛЕНЫ ошибочные символы в наименовании "+СтрокаКривых);
			
		КонецЕсли;	
	Возврат НовоеНаименование	
КонецФункции

