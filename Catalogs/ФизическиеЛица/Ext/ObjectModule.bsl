	ОбластьШапка.Параметры.ОрганизацияАгент_НаименованиеПолное	= ТекОрганизация.НаименованиеПолное;
	ОбластьШапка.Параметры.ФИОПолностью = уб_Кэшируемые.ФИОФизлицаСтрокой(Ссылка, ТекДатаПриема, Ложь, Перечисления.Падежи.Родительный);
	Если НЕ НачалоМесяца(ТекущаяДата()) = НачалоМесяца(ТекДатаПриема) Тогда
		ТекДатаПриема = ТекущаяДата();
	КонецЕсли;	
	ОбластьШапка.Параметры.ДатаДоговора = Формат(ТекДатаПриема, "ДЛФ=ДД");
	
	//ОбластьШапка.Параметры.ОрганизацияНаименование = ВыборкаОрг.НаименованиеДляДоговоровИПлатежныхДокументов; 
