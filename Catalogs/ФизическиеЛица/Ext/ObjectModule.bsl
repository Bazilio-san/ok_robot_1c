	ОбластьШапка.Параметры.ОснованиеДействия_РП			= ФункцииРасширения.Должность_Склонение(уб_ПФ.ОснованиеДействияОтветственногоЛица(ТекРук, Ложь), Перечисления.Падежи.Родительный);	
	
	ОбластьТело = Макет.ПолучитьОбласть("Тело");
