	//ОбластьШапка.Параметры.НомерДоговора			= Прав(ТекНомерПаспорта, 4);
	ОбластьШапка.Параметры.НомерДоговора						= "" + Формат(ТекДатаПриема, "ДФ= гг/ММ/дд") + "-" + Прав(ТекНомерПаспорта,4);
	ОбластьШапка.Параметры.ТекДатаПриема 			= Формат(ТекДатаПриема, "ДФ= гг/ММ/дд");
	Если НачалоМесяца(ТекущаяДата()) = НачалоМесяца(ТекДатаПриема) Тогда
		ОбластьШапка.Параметры.ТекДата 				= Формат(ТекДатаПриема, "ДФ=dd.MM.yyyy");
	Иначе	
		ОбластьШапка.Параметры.ТекДата 					= Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	КонецЕсли;	
	ОбластьШапка.Параметры.ОрганизацияАгент			= ТекОрганизация.НаименованиеДляДоговоровИПлатежныхДокументов;
	ОбластьШапка.Параметры.ФИОФизЛицоПолное			= уб_Кэшируемые.ФИОФизлицаСтрокой(Ссылка, ТекДатаПриема, Ложь, Перечисления.Падежи.Именительный);
	ОбластьШапка.Параметры.ФИОФизЛицоКраткое		= уб_Кэшируемые.ФИОФизлицаСтрокой(Ссылка, ТекДатаПриема, Истина, Перечисления.Падежи.Именительный);
	ОбластьШапка.Параметры.ФИОРуководительПолноеРП	= уб_ПФ.ДайФИОРуководителя(ТекОрганизация, ТекДатаПриема, Ложь, Перечисления.Падежи.Родительный);
	ОбластьШапка.Параметры.ФИОРуководительКраткое	= уб_ПФ.ДайФИОРуководителя(ТекОрганизация, ТекДатаПриема, Истина, Перечисления.Падежи.Именительный);	
	ОбластьШапка.Параметры.ТекКемВыдан = ТекКемВыдан;
	ОбластьШапка.Параметры.ТекПаспортФЛ = ТекПаспортФЛ;
	ОбластьШапка.Параметры.КодПодразделения = КодПодразделения;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	ТекАдресРегистрацииФЛ = ТЗ.Найти(Справочники.ВидыКонтактнойИнформации.АдресФизЛицаПоПрописке ,"Вид");
	ТекФактАдресФЛ = ТЗ.Найти(Справочники.ВидыКонтактнойИнформации.АдресФизЛицаПроживания ,"Вид");
	Если ТекАдресРегистрацииФЛ <> Неопределено Тогда
		ОбластьШапка.Параметры.АдресРегистрацииФЛ = ТекАдресРегистрацииФЛ.Представление;
	Иначе
		Если ТекФактАдресФЛ <> Неопределено Тогда
			ОбластьШапка.Параметры.АдресРегистрацииФЛ = ТекФактАдресФЛ.Представление;
		КонецЕсли;	
	КонецЕсли;	
	Если ТекФактАдресФЛ <> Неопределено Тогда
		ОбластьШапка.Параметры.АдресПроживанияФЛ = ТекФактАдресФЛ.Представление;
	Иначе
