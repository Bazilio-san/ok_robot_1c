Функция ДоговорМОЛ(Кнопка,Параметры = Неопределено) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;	
	Макет = ПолучитьМакет("ДоговорМОЛ");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	С.Период,
	|	С.Агент,
	|	С.Выбытие,
	|	С.Подразделение,
	|	С.Организация
	|ИЗ
	|	РегистрСведений.уб_ДвижениеФизлицПоПодразделениям.СрезПервых КАК С
	|ГДЕ
	|	С.Агент = &Агент";	
	Запрос.УстановитьПараметр("Агент", Ссылка);	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();	
	Если Выборка.Следующий() Тогда
		ТекДатаПриема	= Выборка.Период;
		ТекОрганизация	= Выборка.Организация;
	Иначе	
		Сообщить("Нельзя распечатать договор, т.к. сотрудник нигде не работает!");
		Возврат Новый ТабличныйДокумент;
	КонецЕсли;	
	Если Не Параметры = Неопределено Тогда
		Если Параметры.Свойство("Организация") Тогда
			ТекОрганизация = Параметры.Организация;
		КонецЕсли;
	КонецЕсли;	
	//паспортные данные ФЛ
	ДанныеФизЛица = уб_ПФ.ДайПаспортныеДанныеФизлица(Ссылка, Истина);
	Если ДанныеФизЛица = Неопределено Тогда
		#Если Клиент Тогда
		Предупреждение("По физическому лицу нет паспортных данных!");
		#КонецЕсли
		Возврат Неопределено;
	КонецЕсли;
	ТекНомерПаспорта	= ДанныеФизЛица.ДокументНомер;
	ТекПаспортФЛ		= ДанныеФизЛица.ДокументСерия + " " + ДанныеФизЛица.ДокументНомер;
	ТекДатаВыдачи		= Формат(ДанныеФизЛица.ДокументДатаВыдачи, "ДЛФ=Д");
	ТекКемВыдан			= ДанныеФизЛица.ДокументКемВыдан;	
	ОбластьШапка.Параметры.НомерДоговора			= "" + Формат(ТекДатаПриема, "ДФ= гг/ММ/дд") + "-" + Прав(ТекНомерПаспорта,5);
	ОбластьШапка.Параметры.ОрганизацияАгент			= ТекОрганизация.НаименованиеДляДоговоровИПлатежныхДокументов;
	ОбластьШапка.Параметры.ФИОФизЛицоПолное			= уб_Кэшируемые.ФИОФизлицаСтрокой(Ссылка, ТекДатаПриема, Ложь, Перечисления.Падежи.Родительный);
	ОбластьШапка.Параметры.ФИОРуководительПолноеРП	= уб_ПФ.ДайФИОРуководителя(ТекОрганизация, ТекДатаПриема, Ложь, Перечисления.Падежи.Родительный);
	//
	ТабДокумент.Вывести(ОбластьШапка);
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	//
	ОбластьПодвал.Параметры.ОрганизацияАгент	= ТекОрганизация.НаименованиеДляДоговоровИПлатежныхДокументов;
	ОбластьПодвал.Параметры.ДатаДоговора		= Формат(ТекДатаПриема, "ДЛФ=Д") + " г.";
	ОбластьПодвал.Параметры.ФИОФизЛицоКратко	= уб_Кэшируемые.ФИОФизлицаСтрокой(Ссылка, ТекДатаПриема, Истина);	
	ТабДокумент.Вывести(ОбластьПодвал);
	ТабДокумент.АвтоМасштаб 		= Истина;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.ОтображатьСетку 	= Ложь;
	//ТабДокумент.Показать("Договор о материальной ответственности");
	ТабДокумент.Вывод = ?(Уб_Кэшируемые.ДоступностьРоли("ПолныеПрава,уб_ДопРольУправлениеПерсоналом"),ИспользованиеВывода.Разрешить,ИспользованиеВывода.авто);
	Возврат ТабДокумент;

	
	Возврат ТабДокумент
КонецФункции


Функция ДопДоговор(Кнопка,Параметры = Неопределено) Экспорт
	
	Макет = ПолучитьМакет("ДоговорСубагентскийДС");

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Вывод = ?(УБ_Кэшируемые.ДоступностьРоли("уб_ЗП_ПолныйДоступ,ПолныеПрава,уб_ДопРольУправлениеПерсоналом"),ИспользованиеВывода.Разрешить,ИспользованиеВывода.Авто);
	
	

