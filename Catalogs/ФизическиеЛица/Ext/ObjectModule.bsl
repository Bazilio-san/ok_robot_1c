			ОбластьШапка.Параметры.АдресПроживанияФЛ = ТекАдресРегистрацииФЛ.Представление;
		КонецЕсли;	
	КонецЕсли;	
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.АвтоМасштаб 		= Истина;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.ОтображатьСетку 	= Ложь;
	//ТабДокумент.Показать("Соглашение о неразглашении");
	Возврат ТабДокумент;

	
