

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РольДоступна("уб_ЗП_ПолныйДоступ") Тогда
		Отказ = Истина;
		Сообщить("Вам запрещено создавать риски");
	КонецЕсли;	

	Если НЕ ЭтоГруппа Тогда
		уб_СС.ОтметитьФактМодификации(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры
