Функция ПолучитьМаркуАвтоПоVINНомеру(VINНомер, КакМассив = Ложь) Экспорт
	
	WMI = СокрЛП(VINНомер);
	
	Если СтрДлина(WMI) >= 3 Тогда
		
		WMI = Лев(WMI, 3);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	уб_ТранспортныеСредства.МаркаТС КАК МаркаТС
		|ИЗ
		|	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
		|ГДЕ
		|	ПОДСТРОКА(уб_ТранспортныеСредства.ИдентификационныйНомер, 1, 3) = &WMI
		|
		|УПОРЯДОЧИТЬ ПО
		|	МаркаТС";
		
		Запрос.УстановитьПараметр("WMI", WMI);

		МассивМарокАвто = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("МаркаТС");
	Иначе
		МассивМарокАвто = Новый Массив;
	КонецЕсли;
	
	Если КакМассив Тогда
		Результат = МассивМарокАвто;
	Иначе	
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(МассивМарокАвто);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьМодельныйГодАвтоПоVINНомеру(VINНомер, КакМассив = Ложь) Экспорт
	
	МодельныйГод = СокрЛП(VINНомер);
	
	Если СтрДлина(МодельныйГод) >= 10 Тогда
		
		МодельныйГод = Сред(МодельныйГод, 10, 1);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	уб_ТранспортныеСредства.ГодВыпуска КАК ГодВыпуска
		|ИЗ
		|	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
		|ГДЕ
		|	уб_ТранспортныеСредства.ГодВыпуска > 1900
		|	И ПОДСТРОКА(уб_ТранспортныеСредства.ИдентификационныйНомер, 10, 1) = &МодельныйГод
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГодВыпуска";
		
		Запрос.УстановитьПараметр("МодельныйГод", МодельныйГод);

		МассивГодВыпускаАвто = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГодВыпуска");
	Иначе
		МассивГодВыпускаАвто = Новый Массив;
	КонецЕсли;
	
	Если КакМассив Тогда
		Результат = МассивГодВыпускаАвто;
	Иначе	
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(МассивГодВыпускаАвто);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции
