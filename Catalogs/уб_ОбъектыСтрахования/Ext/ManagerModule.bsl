Функция ПолучитьДанные(Объект, Прочерки = Истина) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТС.РегистрационныйЗнак КАК ОбъектСтрахованияРегистрационныйЗнак,
	|	ТС.ИдентификационныйНомер КАК ОбъектСтрахованияИдентификационныйНомер,
	|	ТС.МаркаТС КАК ОбъектСтрахованияМаркаТС,
	|	ТС.МодельТС КАК ОбъектСтрахованияМодельТС,
	|	ТС.ТипТС КАК ОбъектСтрахованияТипТС,
	|	ТС.Категория КАК ОбъектСтрахованияКатегория,
	|	ТС.ГодВыпуска КАК ОбъектСтрахованияГодВыпуска,
	|	ТС.ДвигательНомер КАК ОбъектСтрахованияДвигательНомер,
	|	ТС.ШассиНомер КАК ОбъектСтрахованияШассиНомер,
	|	ТС.КузовНомер КАК ОбъектСтрахованияКузовНомер,
	|	ТС.Цвет КАК ОбъектСтрахованияЦвет,
	|	ТС.МощностьДвигателя КАК ОбъектСтрахованияМощностьДвигателя,
	|	ТС.МаксМасса КАК ОбъектСтрахованияМаксМасса,
	|	ТС.КолПассажирскихМест КАК ОбъектСтрахованияКолПассажирскихМест,
	|	ТС.Грузоподъемность КАК ОбъектСтрахованияГрузоподъемность,
	|	ТС.ПротивоугоннаяСистема КАК ОбъектСтрахованияПротивоугоннаяСистема,
	|	ТС.ПаспортСерия КАК ОбъектСтрахованияПаспортСерия,
	|	ТС.ПаспортНомер КАК ОбъектСтрахованияПаспортНомер,
	|	ТС.ПаспортДатаВыдачи КАК ОбъектСтрахованияПаспортДатаВыдачи
	|ИЗ
	|	РегистрСведений.уб_ТранспортныеСредства КАК ТС
	|ГДЕ
	|	ТС.Объект = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	Данные = Новый Структура; //TODO начальная структура в зависимости от типа объекта страхования
	Если Выборка.Следующий() Тогда
		Данные.Вставить("ОбъектСтрахованияРегистрационныйЗнак",     Выборка.ОбъектСтрахованияРегистрационныйЗнак);
		Данные.Вставить("ОбъектСтрахованияИдентификационныйНомер",  Выборка.ОбъектСтрахованияИдентификационныйНомер);
		Данные.Вставить("ОбъектСтрахованияМаркаТС",     			Выборка.ОбъектСтрахованияМаркаТС);
		Данные.Вставить("ОбъектСтрахованияМодельТС",     			Выборка.ОбъектСтрахованияМодельТС);
		Данные.Вставить("ОбъектСтрахованияТипТС",     				Выборка.ОбъектСтрахованияТипТС);
		Данные.Вставить("ОбъектСтрахованияКатегория",     			Выборка.ОбъектСтрахованияКатегория);
		Данные.Вставить("ОбъектСтрахованияГодВыпуска",     			Выборка.ОбъектСтрахованияГодВыпуска);
		Данные.Вставить("ОбъектСтрахованияДвигательНомер",    		Выборка.ОбъектСтрахованияДвигательНомер);
		Данные.Вставить("ОбъектСтрахованияШассиНомер",     			Выборка.ОбъектСтрахованияШассиНомер);
		Данные.Вставить("ОбъектСтрахованияКузовНомер",     			Выборка.ОбъектСтрахованияКузовНомер);
		Данные.Вставить("ОбъектСтрахованияЦвет",     				Выборка.ОбъектСтрахованияЦвет);
		Данные.Вставить("ОбъектСтрахованияМощностьДвигателя",     	Выборка.ОбъектСтрахованияМощностьДвигателя);
		Данные.Вставить("ОбъектСтрахованияМаксМасса",     			Выборка.ОбъектСтрахованияМаксМасса);
		Данные.Вставить("ОбъектСтрахованияКолПассажирскихМест",     Выборка.ОбъектСтрахованияКолПассажирскихМест);
		Данные.Вставить("ОбъектСтрахованияГрузоподъемность",     	Выборка.ОбъектСтрахованияГрузоподъемность);
		Данные.Вставить("ОбъектСтрахованияПротивоугоннаяСистема",   Выборка.ОбъектСтрахованияПротивоугоннаяСистема);
		Данные.Вставить("ОбъектСтрахованияПаспортСерия",    	 	Выборка.ОбъектСтрахованияПаспортСерия);
		Данные.Вставить("ОбъектСтрахованияПаспортНомер",     		Выборка.ОбъектСтрахованияПаспортНомер);
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачи",     	Выборка.ОбъектСтрахованияПаспортДатаВыдачи);
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиДень",	Выборка.ОбъектСтрахованияПаспортДатаВыдачи);
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиМесяц",	Выборка.ОбъектСтрахованияПаспортДатаВыдачи);
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиГод",	Выборка.ОбъектСтрахованияПаспортДатаВыдачи);
		Данные.Вставить("ОбъектСтрахованияПредставление",			СокрЛП(Строка(Выборка.ОбъектСтрахованияМаркаТС) + " " + Выборка.ОбъектСтрахованияМодельТС));
	Иначе
		Данные.Вставить("ОбъектСтрахованияРегистрационныйЗнак",     "");
		Данные.Вставить("ОбъектСтрахованияИдентификационныйНомер",  "");
		Данные.Вставить("ОбъектСтрахованияМаркаТС",     			"");
		Данные.Вставить("ОбъектСтрахованияМодельТС",     			"");
		Данные.Вставить("ОбъектСтрахованияТипТС",     				"");
		Данные.Вставить("ОбъектСтрахованияКатегория",     			"");
		Данные.Вставить("ОбъектСтрахованияГодВыпуска",     			0);
		Данные.Вставить("ОбъектСтрахованияДвигательНомер",    		"");
		Данные.Вставить("ОбъектСтрахованияШассиНомер",     			"");
		Данные.Вставить("ОбъектСтрахованияКузовНомер",     			"");
		Данные.Вставить("ОбъектСтрахованияЦвет",     				"");
		Данные.Вставить("ОбъектСтрахованияМощностьДвигателя",     	0);
		Данные.Вставить("ОбъектСтрахованияМаксМасса",     			0);
		Данные.Вставить("ОбъектСтрахованияКолПассажирскихМест",     0);
		Данные.Вставить("ОбъектСтрахованияГрузоподъемность",     	0);
		Данные.Вставить("ОбъектСтрахованияПротивоугоннаяСистема",   "");
		Данные.Вставить("ОбъектСтрахованияПаспортСерия",    	 	"");
		Данные.Вставить("ОбъектСтрахованияПаспортНомер",     		"");
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачи",     	Дата(1,1,1));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиДень",	Дата(1,1,1));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиМесяц",	Дата(1,1,1));
		Данные.Вставить("ОбъектСтрахованияПаспортДатаВыдачиГод",	Дата(1,1,1));
		Данные.Вставить("ОбъектСтрахованияПредставление",			"Не указано");
	КонецЕсли;
	Возврат Данные;
	
КонецФункции	



