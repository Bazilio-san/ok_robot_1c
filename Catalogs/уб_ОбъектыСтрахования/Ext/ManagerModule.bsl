//ППС 31-07-2014
Функция ПолучитьМощностьДвигателя(МаркаТС, МодельТС, кВт = Ложь, КакМассив = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(МаркаТС) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ";
		
		Если кВт Тогда
			Запрос.Текст = Запрос.Текст + "	Выразить(уб_ТранспортныеСредства.МощностьДвигателя * 0.7355 КАК Число(10, 2)) КАК МощностьДвигателя ";
		Иначе
			Запрос.Текст = Запрос.Текст + "	уб_ТранспортныеСредства.МощностьДвигателя КАК МощностьДвигателя ";
		КонецЕсли;
	
	    Запрос.Текст = Запрос.Текст +
		" ИЗ
		|	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
		| ГДЕ
		|	уб_ТранспортныеСредства.МаркаТС = &МаркаТС ";
		
		Если ЗначениеЗаполнено(МодельТС) Тогда
			Запрос.Текст = Запрос.Текст + " И уб_ТранспортныеСредства.МодельТС = &МодельТС ";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + 
		"	И МощностьДвигателя > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	МощностьДвигателя";
		
		Запрос.УстановитьПараметр("МаркаТС", МаркаТС);
		
		Если ЗначениеЗаполнено(МодельТС) Тогда
			Запрос.УстановитьПараметр("МодельТС", МодельТС);
		КонецЕсли;
		
		МассивМощностьДвигателя = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("МощностьДвигателя");
	Иначе
		МассивМощностьДвигателя = Новый Массив;
	КонецЕсли;
	
	Если КакМассив Тогда
		Результат = МассивМощностьДвигателя;
	Иначе	
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(МассивМощностьДвигателя);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
Функция ПолучитьМаксимальнуюМассу(МаркаТС, МодельТС, КакМассив = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(МаркаТС) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	уб_ТранспортныеСредства.МаксМасса КАК МаксимальнаяМасса
		|ИЗ
		|	РегистрСведений.уб_ТранспортныеСредства КАК уб_ТранспортныеСредства
		|ГДЕ
		|	уб_ТранспортныеСредства.МаркаТС = &МаркаТС ";
		
		Если ЗначениеЗаполнено(МодельТС) Тогда
			Запрос.Текст = Запрос.Текст + " И уб_ТранспортныеСредства.МодельТС = &МодельТС ";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + 
		"	И уб_ТранспортныеСредства.МаксМасса > 0
		|
		|УПОРЯДОЧИТЬ ПО
