Функция ЗаполнитьПараметрыСтраховойКомпании(СК, Наименование, ДатаВеденияВзаиморасчетов, КонтактнаяИнформацияСК,ТабличныйДокумент,СтруктураПараметров)
	
	ОбластьСК = СтруктураПараметров.Макет.ПолучитьОбласть("СК");
	//++Кожевников С.А.
	//ОбластьСК.Параметры.СК 			= Строка(СК);
	ОбластьСК.Параметры.СК 			= Наименование;
	//--Кожевников С.А.
	ОбластьСК.Параметры.СКСсылка 	= СК;	
	// для установки примечаний с датой взаиморасчета для СК
	ОбластьСКСК = ОбластьСК.Область(1,1,3,1);
	Примечание  = ПолучитьПримечание(ДатаВеденияВзаиморасчетов);
	ОбластьСКСК.Примечание.Текст = Примечание;
	//контактная информация СК	
	Если КонтактнаяИнформацияСК <> Неопределено Тогда
		Поиск = Новый Структура("СК");
		Поиск.СК = СК;
		КонтактнаяИнформацияСК.Сбросить();
		Если КонтактнаяИнформацияСК.НайтиСледующий(Поиск) Тогда			
			СтрокаКИ = КонтактнаяИнформацияСК.Выбрать();
			Пока СтрокаКИ.Следующий() Цикл
				Если СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресКонтрагентаФактический Тогда
					ОбластьСК.Параметры.АдресФактический = СтрокаКИ.Представление;
				ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента Тогда
					ОбластьСК.Параметры.Телефон = СтрокаКИ.Представление;
				КонецЕсли;
			КонецЦикла;
		Конецесли;	
	КонецЕсли;
	ТабличныйДокумент.Вывести(ОбластьСК, 1, "СК");
	
КонецФункции

Процедура ЗаполнитьДоговора(СтрокаТЗ,ТабличныйДокумент,СтруктураПараметров)
	
	Если СтрокаТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	ТекущаяДата = ТекущаяДата();
	//Выводим заголовок Договора
	ОбластьДоговор = СтруктураПараметров.Макет.ПолучитьОбласть("Договор");
	ТабличныйДокумент.Вывести(ОбластьДоговор, 2, "Договор");		
	Пока СтрокаТЗ.Следующий() Цикл
		//Выводим строки Договора
		//Для Каждого СтрокаТЗ Из ВыборкаДоговоров Цикл
		ОбластьСтрокаДоговор = СтруктураПараметров.Макет.ПолучитьОбласть("СтрокаДоговор");		
		ОбластьСтрокаДоговор.Параметры.СК 					= СтрокаТЗ.СКНаименование;
		ОбластьСтрокаДоговор.Параметры.ОргАгент 			= СокрЛП(СтрокаТЗ.ОргАгентНаименование);				
		ОбластьСтрокаДоговор.Параметры.НомерДоговора 		= СокрЛП(СтрокаТЗ.НомерДоговора);
		ОбластьСтрокаДоговор.Параметры.ДатаЗаключения 		= Формат(СтрокаТЗ.ДатаЗаключения, "ДФ='dd.MM.yyyy'");
		ОбластьСтрокаДоговор.Параметры.ДатаОкончания 		= ?(Не ЗначениеЗаполнено(СтрокаТЗ.ДатаОкончания), "Бессрочный", Формат(СтрокаТЗ.ДатаОкончания, "ДФ='dd.MM.yyyy'"));
		ОбластьСтрокаДоговор.Параметры.ДопХарактеристика 	= СокрЛП(СтрокаТЗ.ДопХарактеристика);
		ОбластьСтрокаДоговор.Параметры.ДоговорСсылка 		= СтрокаТЗ.Ссылка;		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ДатаОкончания) Тогда
			ОбластьСтрокаДоговор.ТекущаяОбласть.ЦветФона = Новый Цвет(255, 255, 185);
		ИначеЕсли СтрокаТЗ.ДатаОкончания < ТекущаяДата() Тогда
			ОбластьСтрокаДоговор.ТекущаяОбласть.ЦветФона = Новый Цвет(255, 140, 140);
		ИначеЕсли СтрокаТЗ.ДатаОкончания - 604800 < ТекущаяДата() Тогда //60*60*24*7
			ОбластьСтрокаДоговор.ТекущаяОбласть.ЦветФона = Новый Цвет(255, 220, 220);	
		КонецЕсли;		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДоговор, 3, "СтрокаДоговор", ?(СтруктураПараметров.ДоговораРазвернуто, Истина, Ложь));
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыДиО(Строка, СК,ТабличныйДокумент,СтруктураПараметров);
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//Выводим заголовок Параметры договоров и отчетов
	ОбластьПараметрыДиО = СтруктураПараметров.Макет.ПолучитьОбласть("ПараметрыДиО");
	ОбластьПараметрыДиО.Параметры.РасшифровкаПараметров = СК;
	ТабличныйДокумент.Вывести(ОбластьПараметрыДиО, 2, "ПараметрыДиО"); 	
	//Выводим строку Параметров договоров и отчетов
	Область = СтруктураПараметров.Макет.ПолучитьОбласть("СтрокаПараметрыДиО");
	ПараметрДиО = "";	
	Индекс 		= 0;
	ПараметрДиО = "";
	Если Строка.Следующий() Тогда		
		ФИО = СокрЛП(Строка.Фамилия + " " + Строка.Имя + " " + Строка.Отчество);
		Если ПустаяСтрока(ФИО) Тогда
			ФИО = СокрЛП(Строка.НаименованиеКонтактногоЛица);
		КонецЕсли;
		Если Не ПустаяСтрока(ФИО) Тогда
			ПараметрДиО = ПараметрДиО + "ФИО: " + ФИО;
			ПараметрДиО = ПараметрДиО + ?(Прав(ПараметрДиО,1) = "."," ",". ");
		КонецЕсли;
		Если Не ПустаяСтрока(Строка.Должность) Тогда
			ПараметрДиО = ПараметрДиО + "Должность: " + СокрЛП(Строка.Должность);
			ПараметрДиО = ПараметрДиО + ?(Прав(ПараметрДиО,1) = "."," ",". ");
		КонецЕсли;
		Если Не ПустаяСтрока(Строка.ОснованиеДействия) Тогда
			ПараметрДиО = ПараметрДиО + "Основание действия: " + СокрЛП(Строка.ОснованиеДействия);
			ПараметрДиО = ПараметрДиО + ?(Прав(ПараметрДиО,1) = "."," ",". ");
		КонецЕсли;
		Если Не ПустаяСтрока(Строка.Доверенность) Тогда
			ПараметрДиО = ПараметрДиО + "Доверенность агента: " + СокрЛП(Строка.Доверенность);
			ПараметрДиО = ПараметрДиО + ?(Прав(ПараметрДиО,1) = ".","",".");
		КонецЕсли;
	КонецЕсли;
	ПараметрДиО = СокрЛП(ПараметрДиО);
	Область.Параметры.ПараметрДиО = ПараметрДиО;
	Область.Параметры.РасшифровкаПараметров = СК;
	ТабличныйДокумент.Вывести(Область, 3, "СтрокаПараметрыДиО", ?(СтруктураПараметров.ДиОРазвернуто, Истина, Ложь));
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыСтроки(СтрокаТЗ, КонтактнаяИнформацияКЛ, СК,ТабличныйДокумент,СтруктураПараметров)
	
	ДоступККонтактам = Не ПараметрыСеанса.уб_ЭтоМенеджер;
	Если СтрокаТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;		
	//Выводим заголовок Контактные лица
	ОбластьКонтактныеЛица = СтруктураПараметров.Макет.ПолучитьОбласть("КонтактныеЛица");
	ОбластьКонтактныеЛица.Параметры.КонтактныеЛицаРасшифровка = СК;
	ТабличныйДокумент.Вывести(ОбластьКонтактныеЛица, 2, "КонтактныеЛица");		
	//Выводим строки Контактных лиц	
	Пока СтрокаТЗ.Следующий() Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.ОсновноеКонтактноеЛицо) И СтрокаТЗ.ОсновноеКонтактноеЛицо = СтрокаТЗ.Ссылка Тогда
			//ОбластьСтрока.Области.Строка.Шрифт = Новый Шрифт(ОбластьСтрока.Области.Строка.Шрифт,,,Истина);
			//ОбластьСтрока.Область(1,3).Шрифт = Новый Шрифт(ОбластьСтрока.Области.Строка.Шрифт,,,Истина);
			ОбластьСтрока = СтруктураПараметров.Макет.ПолучитьОбласть("СтрокаОсновногоКонтактногоЛица");
		Иначе
			ОбластьСтрока = СтруктураПараметров.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.КонтактноеЛицоДляПечатныхФорм) И СтрокаТЗ.КонтактноеЛицоДляПечатныхФорм = СтрокаТЗ.Ссылка Тогда
			ОбластьСтрока.Рисунки[0].Картинка = БиблиотекаКартинок.Печать;
			ОбластьСтрока.Параметры.ФИО 	= "     " + СтрокаТЗ.ФИО;
		Иначе
			ОбластьСтрока.Рисунки.Удалить(ОбластьСтрока.Рисунки[0]);
			ОбластьСтрока.Параметры.ФИО 	= СтрокаТЗ.ФИО;
		КонецЕсли;
		//ОбластьСтрока.Параметры.СК 			= СтрокаТЗ.СК;
		ОбластьСтрока.Параметры.СК 			= СтрокаТЗ.СКНаименование;
		ОбластьСтрока.Параметры.Должность 	= СтрокаТЗ.Должность;		
		//ОбластьСтрока.Параметры.СК	= СтрокаТЗ.СК;
		ОбластьСтрока.Параметры.СКСсылка	= СтрокаТЗ.СК;		
		ОбластьСтрока.Параметры.ФИОСсылка 	= СтрокаТЗ.Ссылка;
		//ВыводитьКонтакты = ?(ДоступККонтактам = Ложь И СтрокаТЗ.Ссылка.СкрытьКонтактыДляОграниченныхПрав, Ложь, Истина);
		ВыводитьКонтакты = ?(ДоступККонтактам = Ложь И СтрокаТЗ.СсылкаСкрытьКонтактыДляОграниченныхПрав, Ложь, Истина);				
		Если КонтактнаяИнформацияКЛ <> Неопределено Тогда
			Поиск = Новый Структура("Ссылка");
			Поиск.Ссылка = СтрокаТЗ.Ссылка;
			КонтактнаяИнформацияКЛ.Сбросить();
			Если КонтактнаяИнформацияКЛ.НайтиСледующий(Поиск) Тогда			
				СтрокаКИ = КонтактнаяИнформацияКЛ.Выбрать();
				Пока СтрокаКИ.Следующий() Цикл
					Если СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаРабочий Тогда
						ОбластьСтрока.Параметры.НомерТелефонаРабочий = ?(ВыводитьКонтакты,СтрокаКИ.Представление,"**********");
					ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтактногоЛица Тогда
						ОбластьСтрока.Параметры.АдресЭлектроннойПочты = СтрокаКИ.Представление;	
					ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаМобильный Тогда
						ОбластьСтрока.Параметры.НомерТелефонаМобильный = ?(ВыводитьКонтакты,СтрокаКИ.Представление,"**********");
					ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресКонтактногоЛица Тогда
						ОбластьСтрока.Параметры.Адрес = ?(ВыводитьКонтакты,СтрокаКИ.Представление,"**********");
					КонецЕсли;
				КонецЦикла;
			Конецесли;	
		КонецЕсли;		
		ТабличныйДокумент.Вывести(ОбластьСтрока, 3, "Строка");
	КонецЦикла;
	
КонецПроцедуры


Функция ПолучитьПримечание(Дата)

	Если Дата <> '00010101' Тогда
		Возврат "Дата начала взаиморасчетов: " + Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;

КонецФункции // ПолучитьНачалоВзаиморасчетов()



Функция ПолучитьТекстЗапросаКонтактныхЛиц()
	
	Возврат 
	"ВЫБРАТЬ
	|	КонтактныеЛица.Наименование КАК НаименованиеКонтактногоЛица,
	|	КонтактныеЛица.Ссылка КАК Ссылка,
	|	СК_БезПовторяющихся.СК КАК СК,
	|	СК_БезПовторяющихся.Наименование КАК СКНаименование,
	|	КонтактныеЛица.Ссылка.СкрытьКонтактыДляОграниченныхПрав КАК СсылкаСкрытьКонтактыДляОграниченныхПрав,
	|	КонтактныеЛица.Должность КАК Должность,
	|	КонтактныеЛица.Представление КАК ФИО,
	|	Контрагенты.ОсновноеКонтактноеЛицо КАК ОсновноеКонтактноеЛицо,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОсновноеКонтактноеЛицо = КонтактныеЛица.Ссылка
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ОснЛицо,
	|	уб_ПараметрыДоговоровИОтчетовСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицоДляПечатныхФорм
	|ПОМЕСТИТЬ КонтактныеЛица
	|ИЗ
	|	Справочник.КонтактныеЛица КАК КонтактныеЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СК_БезПовторяющихся КАК СК_БезПовторяющихся
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ПараметрыДоговоровИОтчетов.СрезПоследних(
	|					&Дата,
	|					ОрганизацияАгент = &ОсновнаяОрганизация
	|						И Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК уб_ПараметрыДоговоровИОтчетовСрезПоследних
	|			ПО (уб_ПараметрыДоговоровИОтчетовСрезПоследних.Поставщик = СК_БезПовторяющихся.СК)
	|		ПО КонтактныеЛица.ОбъектВладелец = СК_БезПовторяющихся.СК
	|			И (КонтактныеЛица.Роль <> &Роль)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО КонтактныеЛица.ОбъектВладелец = Контрагенты.Ссылка
	|			И (НЕ КонтактныеЛица.ПометкаУдаления)
	|ГДЕ
	|	НЕ КонтактныеЛица.ПометкаУдаления
	|	И (&ЕстьПравоПросмотраОграниченных
	|			ИЛИ НЕ КонтактныеЛица.СкрытьКонтактыДляОграниченныхПрав)
	|	И (&ЕстьПравоОтображатьТолькоДляУполномоченных
	|			ИЛИ НЕ КонтактныеЛица.ОтображатьТолькоДляУполномоченных)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактныеЛица.НаименованиеКонтактногоЛица КАК НаименованиеКонтактногоЛица,
	|	КонтактныеЛица.Ссылка КАК Ссылка,
	|	КонтактныеЛица.СК КАК СК,
	|	КонтактныеЛица.СКНаименование КАК СКНаименование,
	|	КонтактныеЛица.СсылкаСкрытьКонтактыДляОграниченныхПрав,
	|	КонтактныеЛица.Должность КАК Должность,
	|	КонтактныеЛица.ФИО КАК ФИО,
	|	КонтактныеЛица.ОсновноеКонтактноеЛицо,
	|	КонтактныеЛица.ОснЛицо КАК ОснЛицо,
	|	КонтактныеЛица.КонтактноеЛицоДляПечатныхФорм
	|ИЗ
	|	КонтактныеЛица КАК КонтактныеЛица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОснЛицо,
	|	НаименованиеКонтактногоЛица,
	|	ФИО,
	|	КонтактныеЛица.СК,
	|	Ссылка,
	|	Должность
	|ИТОГИ ПО
	|	СК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактныеЛица.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтактныеЛица КАК КонтактныеЛица
	|		ПО КонтактнаяИнформация.Объект = КонтактныеЛица.Ссылка
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаРабочий)
	|				ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтактногоЛица)
	|				ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛицаМобильный)
	|				ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресКонтактногоЛица))
	|ИТОГИ ПО
	|	Ссылка";
	
КонецФункции	

Функция ПолучитьТекстЗапросаДоговоры()
	
	Возврат 
	"ВЫБРАТЬ
	|	ДК.Ссылка,
	|	СК_БезПовторяющихся.СК КАК СК,
	|	СК_БезПовторяющихся.Наименование КАК СКНаименование,
	|	ДК.Организация.Наименование КАК ОргАгентНаименование,
	|	ДК.Организация КАК ОргАгент,
	|	ДК.Наименование КАК НомерДоговора,
	|	ДК.ДатаЗаключенияДоговора КАК ДатаЗаключения,
	|	ДК.ДатаОкончанияДействияДоговора КАК ДатаОкончания,
	|	ДК.ДопХарактеристика
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СК_БезПовторяющихся КАК СК_БезПовторяющихся
	|		ПО ДК.Владелец = СК_БезПовторяющихся.СК
	|			И (НЕ ДК.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СКНаименование,
	|	ДК.Организация.Наименование,
	|	ДатаЗаключения
	|ИТОГИ ПО
	|	СК";
					
КонецФункции

Функция ПолучитьТекстЗапросаПараметрыДиО()
	
	Возврат 
	"ВЫБРАТЬ
	|	ПД.Период КАК Период,
	|	ПД.Поставщик КАК СК,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.Фамилия, """") КАК Фамилия,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.Имя, """") КАК Имя,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.Отчество, """") КАК Отчество,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.Наименование, """") КАК НаименованиеКонтактногоЛица,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.Должность, """") КАК Должность,
	|	ЕСТЬNULL(ПД.КонтактноеЛицо.ОснованиеДействия, """") КАК ОснованиеДействия,
	|	ЕСТЬNULL(ПД.Поставщик.Доверенность, """") КАК Доверенность,
	|	ПД.КонтактноеЛицо КАК КонтактноеЛицо
	|ИЗ
	|	РегистрСведений.уб_ПараметрыДоговоровИОтчетов.СрезПоследних(
	|			,
	|			Поставщик В
	|				(ВЫБРАТЬ
	|					Т.СК
	|				ИЗ
	|					СК_БезПовторяющихся КАК Т)) КАК ПД
	|ГДЕ
	|	НЕ ПД.КонтактноеЛицо.ПометкаУдаления
	|ИТОГИ ПО
	|	СК";
	
КонецФункции	

