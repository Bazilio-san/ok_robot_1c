
Функция Сформировать(СтруктураПараметров,СоздатьСписок = Истина) Экспорт
	
	СтруктураПараметров.Вставить("Макет", Справочники.КонтактныеЛица.ПолучитьМакет("Макет"));

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Очистить();
	ТабличныйДокумент.Вывести(СтруктураПараметров.Макет.ПолучитьОбласть("ШапкаТаб"));
	ТабличныйДокумент.ФиксацияСверху = 1;
	
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();	
	//
	//ВыборкаКонтактныеЛица = Неопределено;    
	//ВыборкаДоговоров = Неопределено;
	//ВыборкаПараметровДиО = Неопределено;
	//КонтактнаяИнформацияСК = Неопределено;//страховых компаний
	//КонтактнаяИнформацияКЛ = Неопределено;//контактных лиц
	//Для Каждого СтрокаСК Из ДайСписокСК(СоздатьСписок) Цикл
//	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВыборкаКонтактныеЛица", Неопределено);
	СтруктураПараметров.Вставить("ВыборкаДоговоров", Неопределено);
	СтруктураПараметров.Вставить("ВыборкаПараметровДиО", Неопределено);
	СтруктураПараметров.Вставить("КонтактнаяИнформацияСК", Неопределено);
	СтруктураПараметров.Вставить("КонтактнаяИнформацияКЛ", Неопределено);
	СтруктураПараметров.Вставить("ЛимитыСтрахования", Неопределено);
	
	Для Каждого СтрокаСК Из ДайСписокСК(Ложь, СтруктураПараметров) Цикл	
		ВыводитьСК 			= Истина;
		ЕстьДоговора 		= Ложь;
		ЕстьКонтЛица 		= Ложь;
		ЕстьПараметрыДиО    = Ложь;		
		ЕстьЛимиты          = ЛОЖЬ;
		
		//выборка договоров
		ВыборкаДоговоровПоСК = Неопределено;
		Если СтруктураПараметров.ВыборкаДоговоров <> Неопределено Тогда
			Поиск = Новый Структура("СК");
			Поиск.СК = СтрокаСК.СК;
			СтруктураПараметров.ВыборкаДоговоров.Сбросить();
			Если СтруктураПараметров.ВыборкаДоговоров.НайтиСледующий(Поиск) Тогда
				ЕстьДоговора = Истина;
				ВыборкаДоговоровПоСК = СтруктураПараметров.ВыборкаДоговоров.Выбрать();
			Конецесли;	
		КонецЕсли;	
		//выборка контактных лиц
		ВыборкаКонтактныеЛицаПоСК = Неопределено;
		Если СтруктураПараметров.ВыборкаКонтактныеЛица <> Неопределено Тогда
			Поиск = Новый Структура("СК");
			Поиск.СК = СтрокаСК.СК;
			СтруктураПараметров.ВыборкаКонтактныеЛица.Сбросить();
			Если СтруктураПараметров.ВыборкаКонтактныеЛица.НайтиСледующий(Поиск) Тогда
				ЕстьКонтЛица = Истина;
				ВыборкаКонтактныеЛицаПоСК = СтруктураПараметров.ВыборкаКонтактныеЛица.Выбрать();
			Конецесли;	
		КонецЕсли;
		//выборка параметры ДиО
		ВыборкаПараметрыДиОПоСК = Неопределено;
		Если СтруктураПараметров.ВыборкаПараметровДиО <> Неопределено Тогда
			Поиск = Новый Структура("СК");
			Поиск.СК = СтрокаСК.СК;
			СтруктураПараметров.ВыборкаПараметровДиО.Сбросить();
			Если СтруктураПараметров.ВыборкаПараметровДиО.НайтиСледующий(Поиск) Тогда
				ЕстьПараметрыДиО = Истина;
				ВыборкаПараметрыДиОПоСК = СтруктураПараметров.ВыборкаПараметровДиО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Конецесли;	
		КонецЕсли;
		
		//выборка лимиты страхования
		ЛимитыСтрахованияПоСК = Неопределено;
		Если СтруктураПараметров.ЛимитыСтрахования <> Неопределено Тогда
			Поиск = Новый Структура("СК");
			Поиск.СК = СтрокаСК.СК;
			СтруктураПараметров.ЛимитыСтрахования.Сбросить();
			Если СтруктураПараметров.ЛимитыСтрахования.НайтиСледующий(Поиск) Тогда
				ЕстьЛимиты = Истина;
				ЛимитыСтрахованияПоСК = СтруктураПараметров.ЛимитыСтрахования.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Конецесли;	
		КонецЕсли;
		
		Если ЕстьДоговора Или ЕстьКонтЛица Тогда			
			ЗаполнитьПараметрыСтраховойКомпании(СтрокаСК.СК, СтрокаСК.Наименование, СтрокаСК.ДатаВеденияВзаиморасчётов, СтруктураПараметров.КонтактнаяИнформацияСК,ТабличныйДокумент,СтруктураПараметров);
		КонецЕсли;
		
		Если ЕстьДоговора Тогда
			ЗаполнитьДоговора(ВыборкаДоговоровПоСК,ТабличныйДокумент,СтруктураПараметров);						
		КонецЕсли;	
		Если ЕстьПараметрыДиО Тогда
			ЗаполнитьПараметрыДиО(ВыборкаПараметрыДиОПоСК, СтрокаСК.СК,ТабличныйДокумент,СтруктураПараметров);						
		КонецЕсли;
		Если ЕстьКонтЛица Тогда
			ЗаполнитьПараметрыСтроки(ВыборкаКонтактныеЛицаПоСК, СтруктураПараметров.КонтактнаяИнформацияКЛ, СтрокаСК.СК,ТабличныйДокумент,СтруктураПараметров);
		КонецЕсли;	
		Если ЕстьЛимиты Тогда
			ЗаполнитьПараметрыСтрокиЛимиты(ЛимитыСтрахованияПоСК, СтруктураПараметров.ЛимитыСтрахования, СтрокаСК.СК,ТабличныйДокумент,СтруктураПараметров);
		КонецЕсли;	
		
	КонецЦикла;
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат ТабличныйДокумент
КонецФункции
Функция ПолучитьТекстЗапросаЛимитыСтрахования()
	Возврат "ВЫБРАТЬ
	        |	СК_БезПовторяющихся.СК КАК СК,
	        |	СК_БезПовторяющихся.Наименование КАК СКНаименование,
	        |	уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.УсловиеПрименения,
	        |	уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.ТипЛимита,
	        |	уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.Лимит,
	        |	уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.Комментарий,
	        |	уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.СК.Андеррайтер
	        |ИЗ
	        |	СК_БезПовторяющихся КАК СК_БезПовторяющихся
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уб_ЛимитыРазрешенийНаСтрахование.СрезПоследних(&Дата, ) КАК уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних
	        |		ПО СК_БезПовторяющихся.СК = уб_ЛимитыРазрешенийНаСтрахованиеСрезПоследних.СК
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	СКНаименование
	        |ИТОГИ ПО
	        |	СК"; 
КонецФункции
		
Процедура ЗаполнитьПараметрыСтрокиЛимиты(СтрокаТЗ, ВыборкаЛимитыСтрахования, СК,ТабличныйДокумент,СтруктураПараметров)
		
	Если СтрокаТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЗ.Следующий();
    Андеррайтер = СтрокаТЗ.СКАндеррайтер;
	Если СтрокаТЗ.ТипЛимита = NULL Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокаТЗ.Сбросить();
	
	//Выводим заголовок лимиты страхования	
	ОбластьЛимитыСтрахования = СтруктураПараметров.Макет.ПолучитьОбласть("ЛимитыСтрахования");
	ОбластьЛимитыСтрахования.Параметры.СКСсылка = СК;
	ОбластьЛимитыСтрахования.Параметры.Андеррайтер = Андеррайтер;
	ТабличныйДокумент.Вывести(ОбластьЛимитыСтрахования, 2, "ЛимитыСтрахования");		
	//Выводим строки лимиты страхования	
	Пока СтрокаТЗ.Следующий() Цикл
		ОбластьСтрока = СтруктураПараметров.Макет.ПолучитьОбласть("СтрокаЛимиты");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТЗ);
		ОбластьСтрока.Параметры.СКСсылка = СК;
		ТабличныйДокумент.Вывести(ОбластьСтрока, 3, "СтрокаЛимиты");
	КонецЦикла;
	
КонецПроцедуры


Функция ДайСписокСК(СоздатьСписок,СтруктураПараметров)
	
	НомераПакетов = Новый Структура;	
	//эуСК_Текст = СокрЛП(ЭлементыФормы.эуСК.text);
	//эуСК_Текст = ?(СтрДлина(эуСК_Текст) > 2, эуСК_Текст, "");
	ЗапросСК = Новый Запрос;
	ЗапросСК.Текст = "ВЫБРАТЬ
	|	КонтактныеЛица.ОбъектВладелец КАК СК,
	|	КонтактныеЛица.ОбъектВладелец.Наименование КАК Наименование,
	|	isnull(КонтактныеЛица.ОбъектВладелец.ДатаВеденияВзаиморасчётов,ДатаВремя(1,1,1)) Как ДатаВеденияВзаиморасчётов
	|ПОМЕСТИТЬ СтраховыеКомпании
	|ИЗ
	|	Справочник.КонтактныеЛица КАК КонтактныеЛица
	|ГДЕ
	|	КонтактныеЛица.ОбъектВладелец.Родитель.Наименование <> ""НЕ АКТИВНЫЕ""
	|	И НЕ КонтактныеЛица.ПометкаУдаления
	|	"+ ?(Не ЗначениеЗаполнено(СтруктураПараметров.СК), "", " И КонтактныеЛица.ОбъектВладелец =  &СКСсылка ") +"
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Владелец,
	|	ДоговорыКонтрагентов.Владелец.Наименование,
	|	ДоговорыКонтрагентов.Владелец.ДатаВеденияВзаиморасчётов
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Наименование <> ""Основной договор""
	|	И Не ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.Наименование <> ""---""
	|	И ДоговорыКонтрагентов.Владелец.Родитель.Наименование <> ""НЕ АКТИВНЫЕ""
	//|	"+ ?(Не ЗначениеЗаполнено(эуСК_Текст) Или ТипЗнч(ВыбранноеСК) = Тип("СправочникСсылка.Контрагенты"), "", "И (ДоговорыКонтрагентов.Владелец.Наименование ПОДОБНО &СК ИЛИ ДоговорыКонтрагентов.Владелец.Наименование ПОДОБНО &СКПеревод)") +"
	|	"+ ?(Не ЗначениеЗаполнено(СтруктураПараметров.СК), "", " И ДоговорыКонтрагентов.Владелец = &СКСсылка ") +	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтраховыеКомпании.СК,
	|	СтраховыеКомпании.Наименование,
	|	СтраховыеКомпании.ДатаВеденияВзаиморасчётов
	|ПОМЕСТИТЬ СК_БезПовторяющихся
	|ИЗ
	|	СтраховыеКомпании КАК СтраховыеКомпании ГДЕ  СтраховыеКомпании.СК В ИЕРАРХИИ(Значение(Справочник.Контрагенты.СтраховыеКомпании)) или СтраховыеКомпании.СК В(Значение(Справочник.Контрагенты.СтраховыеКомпании))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СК_БезПовторяющихся.СК,
	|	СК_БезПовторяющихся.Наименование,
	|	СК_БезПовторяющихся.ДатаВеденияВзаиморасчётов
	|ИЗ
	|	СК_БезПовторяющихся КАК СК_БезПовторяющихся
	|УПОРЯДОЧИТЬ ПО
	|	Наименование
	|;	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	СК_БезПовторяющихся.СК
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СК_БезПовторяющихся КАК СК_БезПовторяющихся
	|		ПО КонтактнаяИнформация.Объект = СК_БезПовторяющихся.СК
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресКонтрагентаФактический)
	|				ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
	|ИТОГИ ПО
	|	СК";		
	Если ТипЗнч(СтруктураПараметров.СК) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЗапросСК.УстановитьПараметр("СКСсылка", СтруктураПараметров.СК);
	//ИначеЕсли ЗначениеЗаполнено(эуСК_Текст) Тогда
	//	ЗапросСК.УстановитьПараметр("СК", "%" + эуСК_Текст + "%");
	//	ЗапросСК.УстановитьПараметр("СКПеревод", "%" + уб_Фильтры.ПеревестиСтроку(эуСК_Текст) + "%");
	КонецЕсли;
	СчетчикПакетов = 3;
	Если СтруктураПараметров.ПоказыватьКонтЛица Тогда
		ЗапросСК.Текст = ЗапросСК.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + ПолучитьТекстЗапросаКонтактныхЛиц();
		ЗапросСК.УстановитьПараметр("Роль", 										Справочники.РолиКонтактныхЛиц.НеРаботает);
		ЗапросСК.УстановитьПараметр("ЕстьПравоПросмотраОграниченных",				Не ПараметрыСеанса.уб_ЭтоМенеджер);
		ЗапросСК.УстановитьПараметр("ЕстьПравоОтображатьТолькоДляУполномоченных",   уб_temp.ПолучитьПредопределеннуюНастройкуПользователя(ПланыВидовХарактеристик.НастройкиПользователей.ПравоПросмотраСкрытыхКонтактов, Ложь));
		СчетчикПакетов = СчетчикПакетов + 2;
		НомераПакетов.Вставить("ВыборкаКонтактныеЛица",СчетчикПакетов);
						
		СчетчикПакетов = СчетчикПакетов + 1;
		НомераПакетов.Вставить("КонтактнаяИнформацияКЛ",СчетчикПакетов);
		
	КонецЕсли;
	
	Если СтруктураПараметров.ПоказыватьДоговора Тогда
		ЗапросСК.Текст = ЗапросСК.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + ПолучитьТекстЗапросаДоговоры();
		СчетчикПакетов = СчетчикПакетов + 1;
		НомераПакетов.Вставить("ВыборкаДоговоров", СчетчикПакетов);				
	КонецЕсли;
	
	Если СтруктураПараметров.ПоказыватьПараметрыДиО Тогда
		ЗапросСК.Текст = ЗапросСК.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + ПолучитьТекстЗапросаПараметрыДиО();
		СчетчикПакетов = СчетчикПакетов + 1;
		НомераПакетов.Вставить("ВыборкаПараметровДиО",СчетчикПакетов);				
	КонецЕсли;
	
	//чкн
	Если СтруктураПараметров.ПоказыватьЛимиты Тогда
		ЗапросСК.Текст = ЗапросСК.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + ПолучитьТекстЗапросаЛимитыСтрахования();
		СчетчикПакетов = СчетчикПакетов + 1;
		НомераПакетов.Вставить("ЛимитыСтрахования", СчетчикПакетов);				
	КонецЕсли;
	//чкн
	ЗапросСК.УстановитьПараметр("ОсновнаяОрганизация", ПараметрыСеанса.уб_ОсновнаяОрганизация);
	ЗапросСК.УстановитьПараметр("Дата", ТекущаяДата());
	Пакет = ЗапросСК.ВыполнитьПакет();
	ВыборкаСК = Пакет[2].Выгрузить();
	СтруктураПараметров.КонтактнаяИнформацияСК = Пакет[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если СтруктураПараметров.ПоказыватьКонтЛица Тогда 
		СтруктураПараметров.ВыборкаКонтактныеЛица = Пакет[НомераПакетов.ВыборкаКонтактныеЛица].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		СтруктураПараметров.КонтактнаяИнформацияКЛ = Пакет[НомераПакетов.КонтактнаяИнформацияКЛ].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;	
	
	Если СтруктураПараметров.ПоказыватьДоговора Тогда
		СтруктураПараметров.ВыборкаДоговоров = Пакет[НомераПакетов.ВыборкаДоговоров].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	Если СтруктураПараметров.ПоказыватьПараметрыДиО Тогда
