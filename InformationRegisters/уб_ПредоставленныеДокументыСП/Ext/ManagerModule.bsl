Процедура ПредоставленныеДокументыПередНачаломИзменения(Элемент, Отказ, Форма = Неопределено) Экспорт
	
	Если Форма <> Неопределено Тогда
		Если Форма.Модифицированность() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Документ модифицирован. Перед изменением предоставленных документов необходимо записать документ.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Элемент.ТекущаяКолонка.Имя = "ВидДокумента" И Не Элемент.ТекущаяСтрока["ВидДокумента"].Пустая() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПредоставленныеДокументыПередУдалением(Элемент, Отказ) Экспорт
	
	Отказ = Истина;
	
КонецПроцедуры

Процедура ПредоставленныеДокументыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование, стрДокументы) Экспорт
	
	//Сохраняем данные для ручной обработки модификации
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		стрДокументы = Новый Структура;
		стрДокументы.Вставить("Комментарий",		ТекДанные.Комментарий);
		стрДокументы.Вставить("Используется",   	ТекДанные.Используется);
		стрДокументы.Вставить("Предоставлен",   	ТекДанные.Предоставлен);
		стрДокументы.Вставить("ВидДокумента",		ТекДанные.ВидДокумента);
		стрДокументы.Вставить("ТипПодразделения",	ТекДанные.ТипПодразделения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПредоставленныеДокументыПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки) Экспорт
	
	Если Не ДанныеСтроки.Используется Тогда
		ОформлениеСтроки.ЦветТекста = WebЦвета.Серый;
	КонецЕсли;
	
КонецПроцедуры

