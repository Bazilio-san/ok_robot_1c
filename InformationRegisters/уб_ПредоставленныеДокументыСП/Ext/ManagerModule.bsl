
Функция СоздатьПустуюТЗДляВидовДокументов(Реквизит = Неопределено, Значение = Неопределено) Экспорт

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Реквизит");
	ТЗ.Колонки.Добавить("Значение");
	Если Реквизит <> Неопределено Тогда
		СтрокаТЗ = ТЗ.Добавить();
		СтрокаТЗ.Реквизит = Реквизит;
		СтрокаТЗ.Значение = Значение;
	КонецЕсли;
	Возврат ТЗ;

КонецФункции // СоздатьПустуюТЗДляВидовДокументов()

Процедура ЗаписатьСтрокуРСВидовДокументов(Ссылка, ВидДокумента, ТЗ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПД.Объект,
	|	ПД.ВидДокумента,
	|	ПД.Используется,
	|	ПД.Предоставлен,
	|	ПД.Комментарий,
	|	ПД.Автор,
	|	ПД.ДатаСоздания,
	|	ПД.ТипПодразделения
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
	|ГДЕ
	|	ПД.ВидДокумента = &ВидДокумента
	|	И ПД.Объект = &Ссылка";
	Запрос.УстановитьПараметр("ВидДокумента", 	ВидДокумента);
	Запрос.УстановитьПараметр("Ссылка",			Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 1 Тогда
		Строка = Результат[0];
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			Строка[СтрокаТЗ.Реквизит] = СтрокаТЗ.Значение;
		КонецЦикла;
		Запись = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		Запись.Модификатор 		= ПараметрыСеанса.ТекущийПользователь;
		Запись.ДатаИзменения    = ТекущаяДата();
		Попытка
			Запись.Записать();
		Исключение
			уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСтрокуТЗРегистраВидовДокументов(Ссылка, ВидДокумента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПД.Используется,
	|	ПД.Предоставлен,
	|	ПД.Комментарий,
	|	ПД.Автор,
	|	ПД.ДатаСоздания
	|ИЗ
	|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
	|ГДЕ
	|	ПД.ВидДокумента = &ВидДокумента
	|	И ПД.Объект = &Ссылка";
	Запрос.УстановитьПараметр("ВидДокумента", 	ВидДокумента);
	Запрос.УстановитьПараметр("Ссылка",			Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		Возврат ТЗ[0];
	КонецЕсли;

КонецФункции // ПолучитьСтрокуТЗРегистраВидовДокументов()

Функция МассивНедобавленныхДокументов(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВД.Ссылка,
	|	ВД.ТипПодразделения
	|ИЗ
	|	Справочник.уб_ВидыДокументовКПолисам КАК ВД
	|ГДЕ
	|	НЕ ВД.Ссылка В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ПД.ВидДокумента
	|				ИЗ
	|					РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
	|				ГДЕ
	|					ПД.Объект = &Ссылка)
	|	И НЕ ВД.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // СписокНедобавленныхДокументов()

Процедура ЗаполнитьПредоставленныеДокументыПоЗаявке(Ссылка, Заявка) Экспорт

	Если Не Ссылка.Пустая()
		И ТипЗнч(Заявка) = Тип("ДокументСсылка.уб_ЗаявкаНаЗаказВыездногоСпециалиста")
		И Не Заявка.Пустая() 
		Тогда
		//заполняем
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПД.ВидДокумента,
		|	ПД.Используется,
		|	ПД.Предоставлен,
		|	ПД.Комментарий,
		|	ПД.ТипПодразделения
		|ИЗ
		|	РегистрСведений.уб_ПредоставленныеДокументыСП КАК ПД
		|ГДЕ
		|	ПД.Объект = &Заявка
		|	И НЕ ПД.Объект.НетДокументов");
		Запрос.УстановитьПараметр("Заявка", Заявка);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Набор = СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			текПользователь 	= ПараметрыСеанса.ТекущийПользователь;
			ДатаЗаписиНабора 	= ТекущаяДата();
			Пока Выборка.Следующий() Цикл
				Запись = Набор.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Объект			= Ссылка;
				Запись.Автор 			= текПользователь;
				Запись.Модификатор  	= текПользователь;
				Запись.ДатаСоздания 	= ДатаЗаписиНабора;
				Запись.ДатаИзменения    = ДатаЗаписиНабора;
			КонецЦикла;
			Если Набор.Количество() > 0 Тогда
				Попытка
					Набор.Записать();
				Исключение
					уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

