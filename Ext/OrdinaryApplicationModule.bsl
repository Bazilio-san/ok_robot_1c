Процедура ПередНачаломРаботыСистемы(Отказ)
	
	ПервыйЗапуск = (Константы.НомерВерсииКонфигурации.Получить()="");
	Если Не уб_КЭШируемые.ДоступностьРоли("ПолныеПрава") И ПервыйЗапуск Тогда
		уб_СтраховойБрокер.ЗаписатьОшибкуИСообщить("Для первого запуска системы и настройки начальных параметров
										|надо обладать Полными правами!", "Предупреждение", Ложь);
		Отказ = Истина;
	КонецЕсли;
	ПараметрыСеанса.уб_РежимОтладки = 0;
	Уб_temp.ПередНачаломРаботыСистемы();
КонецПроцедуры

